# Ruta relativa: las peticiones pasan por el proxy del dev server (vite.config.ts).
# Así funciona igual en localhost que detrás de un túnel HTTPS (ngrok).
VITE_API_BASE_URL=/api/v1
# Destino real del backend al que el proxy reenvía.
VITE_API_PROXY_TARGET=http://207.180.235.134:4000
VITE_TENANT_SLUG=tenant1

# DSN de GlitchTip (self-hosted, compatible con el SDK de Sentry) — errores, performance y logs
# del frontend. Vacío = tracking desactivado (ver src/lib/sentry.ts).
VITE_GLITCHTIP_DSN=http://57f8c190070f47e39cf074a62078cea4@207.180.235.134:8001/4
