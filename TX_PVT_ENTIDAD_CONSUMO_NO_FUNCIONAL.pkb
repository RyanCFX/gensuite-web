create PACKAGE BODY tx_pvt_entidad_consumo
IS
    --CVE: 19/07/2024, 30/07/2024, 17/10/2024, 23/01/2024, 10/04/2025, 20/06/2025.
    FUNCTION get_action_so_prv (pi_cod_servicio IN VARCHAR2, pi_tecnologia IN VARCHAR2)
        RETURN VARCHAR2
    IS
        v_dummy                       NUMBER;
    BEGIN
        SELECT COUNT (1)
          INTO v_dummy
          FROM cnf_configuracion_especial ce, bm_servicio s
         WHERE ce.nombre_tabla = 'BM_SERVICIO'
           AND ce.tipo = 'DATA_ILIMITADO'
           AND ce.cod_registro = s.cod_servicio
           AND s.cod_servicio = pi_cod_servicio
           AND s.c1_offer_id IS NOT NULL
           AND s.se_provisiona = '1';

        IF v_dummy = 1 THEN
            IF pi_tecnologia = 'GSM' THEN
                RETURN '377';
            ELSIF pi_tecnologia = 'CDMA' THEN
                RETURN '378';
            END IF;
        ELSE
            IF pi_tecnologia = 'GSM' THEN
                RETURN '375';
            ELSIF pi_tecnologia = 'CDMA' THEN
                RETURN '376';
            END IF;
        END IF;
    END get_action_so_prv;

    FUNCTION es_servcio_esp_data( pi_cod_servicio  bm_servicio.cod_tipo_servicio%TYPE )
        RETURN VARCHAR2
    IS
        v_dummy     NUMBER;
    BEGIN

        SELECT COUNT(1)
            INTO v_dummy
        FROM cnf_configuracion_especial
        WHERE nombre_tabla = 'BM_SERVICIO'
        AND cod_registro =  pi_cod_servicio
        AND tipo = 'DATA_ESP';

        IF v_dummy = 0 THEN
            RETURN c_falso;
        ELSE
            RETURN c_verdadero;
        END IF;

    END;

    FUNCTION tiene_servicio_suspension(pi_id_entidad_consumo IN cl_entidad_consumo.id_entidad_consumo%TYPE, pi_cod_servicio IN VARCHAR2)
        RETURN VARCHAR2
    IS
          v_service_exists                  VARCHAR2 (1);
    BEGIN
        SELECT CASE
                   WHEN EXISTS (SELECT 1
                                  FROM cl_servicio_entidad_consumo
                                 WHERE  id_entidad_consumo = pi_id_entidad_consumo
                                   AND cod_servicio = pi_cod_servicio
                                   AND estado = c_estado_activo
                                   AND fch_fin = c_fecha_fin
                                   AND ultimo_registro = c_registro_ultimo) THEN '1'
                   ELSE '0'
               END AS service_exists
          INTO v_service_exists
          FROM DUAL;

          RETURN v_service_exists;

    END tiene_servicio_suspension;


    PROCEDURE toggle_wap6 (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_sub_operation          IN       VARCHAR2,
        pi_cod_transaccion        IN       VARCHAR2,
        pi_cod_usuario            IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        -- Output parameters
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
    BEGIN
        po_cod_err    := 'OK';
        po_msj_err    := NULL;

        -- verificar si existe un servicio de data Ilimitado
        FOR has_ilimitado IN (SELECT ec.identificador_entidad,
                                     ec.cod_forma_consumo
                                FROM cl_servicio_entidad_consumo sec INNER JOIN cl_entidad_consumo ec
                                     ON ec.id_entidad_consumo = sec.id_entidad_consumo
                                   AND ec.estado = 'A'
                                   AND ec.cod_tecnologia = 'GSM'
                               WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                                 AND sec.cod_servicio IN (
                                         SELECT cod_registro
                                           FROM cnf_configuracion_especial ce
                                          WHERE ce.nombre_tabla = 'BM_SERVICIO'
                                            AND ce.tipo = 'DATA_ILIMITADO'
                                            AND ce.parametro_2 = '1')
                                 AND sec.estado = 'A'
                                 AND SYSDATE BETWEEN sec.fch_inicio AND sec.fch_fin
                                 AND ROWNUM = 1)
        LOOP
            IF has_ilimitado.cod_forma_consumo = 'CCOPOS' THEN
                -- reemplaza WAP3 -> WAP6
                v_id_accion_prv_ext    := 368;
            ELSE
                -- reemplaza WAP3 -> WAP6, activar CAML3 para evitar roaming de datos que no podemos cobrar
                v_id_accion_prv_ext    := 367;
            END IF;

            prv_dispatcher.execute_oas (pi_subscriber_id               => pi_id_entidad_consumo,
                                        pi_cod_transaccion             => pi_cod_transaccion,
                                        pi_id_action                   => v_id_accion_prv_ext,
                                        pi_sub_operation               => pi_sub_operation,
                                        pi_p1                          => has_ilimitado.identificador_entidad,
                                        pi_p6                          => 'APNWAP6',
                                        pi_specific_user               => c_falso,
                                        pi_cod_usuario                 => pi_cod_usuario,
                                        pi_master                      => c_falso,
                                        pi_id_tran                     => pi_id_tran,
                                        pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                        pi_fch_tran                    => pi_fch_tran,
                                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                        po_cod_err                     => po_cod_err,
                                        po_msj_err                     => po_msj_err
                                       );
        END LOOP;
    END toggle_wap6;


    PROCEDURE generar_orden_cambio_plan (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_plan_ant           IN       VARCHAR2,
        pi_cod_plan_nuevo         IN       VARCHAR2,
        pi_fch_inicio_vigencia    in       DATE,
        pi_cod_transaccion        IN       VARCHAR2,
        pi_cod_usuario            IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        -- Output parameters
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        v_id_comando                NUMBER;
        v_id_orden                  NUMBER;
        v_id_tran                   tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran          tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                  tx_historico_transaccion.fch_tran%TYPE;
        v_reg_plan_anterior         bm_plan%ROWTYPE;
        v_reg_plan_nuevo            bm_plan%ROWTYPE;
        v_main_offer                bm_plan_param.valor%TYPE;
        err_app                       EXCEPTION;
        v_imsi                      cl_entidad_consumo.imsi%TYPE;
        v_sim                       cl_entidad_consumo.sim%TYPE;
        v_mismo_rate_plan           NUMBER;
        v_main_offer_ant            bm_plan_param.valor%TYPE;
        v_identificador_entidad     cl_entidad_consumo.identificador_entidad%TYPE;
        v_dummy                     NUMBER;

    BEGIN

        v_id_tran           :=  pi_id_tran;
        v_cod_gestion_tran  :=  pi_cod_gestion_tran;
        v_fch_tran          :=  pi_fch_tran;


        --OBTENCION DE DATOS DE PLANES ACTUAL Y NUEVO
        po_cod_err := 'PVT-5149';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el grupo de plan anterior.

        SELECT *
          INTO v_reg_plan_anterior
          FROM bm_plan b
         WHERE b.cod_plan = pi_cod_plan_ant;

         po_cod_err := 'PVT-5150';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar forma de consumo del plan nuevo.

        SELECT *
          INTO v_reg_plan_nuevo
          FROM bm_plan b
         WHERE b.cod_plan = pi_cod_plan_nuevo;


        --Genera ordenes de cambio de plan entre planes legacy hacia nuevos 4g

        --Distinguir si es una migracion de legacy a 4g ya que llevan ordenes diferentes
        IF tx_pvt_entidad_consumo.es_plan_4g(pi_cod_plan_ant) = c_falso
            AND tx_pvt_entidad_consumo.es_plan_4g(pi_cod_plan_nuevo) = c_verdadero THEN

            /* ORDEN DE GENERACION
                1- Eliminar PAM legacy actual
                2- Eliminar Offer actual
                3- Hacer Switch de Service Class
                4- Agregar Nuevo Offer (en caso de llevar para el caso de prepagos)
                5- Agregar PAM para facturacion solo Hibrido y Postpago (Se hace en cambio de ciclo, si es necesario)
            */

            IF v_reg_plan_anterior.cod_forma_consumo IN ('CCOPRE','CCOCCO') THEN

                --1- Eliminar PAM legacy actual
                po_cod_err := 'PVT-5151';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                SELECT tx_vpg_util.get_comando('PAM', v_reg_plan_anterior.cod_forma_consumo, 'DEL')
                    INTO v_id_comando
                FROM DUAL;

                po_cod_err := 'PVT-5152';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => pi_id_entidad_consumo,
                            pi_fch_programada       => pi_fch_inicio_vigencia,
                            pi_cod_transaccion      => pi_cod_transaccion,
                            pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                            pi_p2                   => pi_id_entidad_consumo,
                            pi_p3                   => '1', -- PAM SERVICE ID , por default en 1 plan legacy [Si lo migraron bien :)]
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => pi_id_tran,
                            pi_cod_gestion_tran     => pi_cod_gestion_tran,
                            pi_fch_tran             => pi_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;


                --2- Eliminar MAIN Offer actual
                po_cod_err := 'PVT-5153';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_plan_anterior.cod_forma_consumo, 'SET')
                    INTO v_id_comando
                FROM DUAL;

                po_cod_err := 'PVT-5154';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => pi_id_entidad_consumo,
                            pi_fch_programada       => pi_fch_inicio_vigencia,
                            pi_cod_transaccion      => pi_cod_transaccion,
                            pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                            pi_p2                   => pi_id_entidad_consumo,
                            pi_p3                   => tx_vpg_util.get_plan_param_value(v_reg_plan_anterior.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF'), -- OFFER ID
                            pi_p4                   => 'D',
                            pi_p5                   => NULL, --Fecha Vigencia
                            pi_p6                   => NULL, --Fecha Expiracion
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => pi_id_tran,
                            pi_cod_gestion_tran     => pi_cod_gestion_tran,
                            pi_fch_tran             => pi_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;


                --3- Switch Service Class
                po_cod_err := 'PVT-5155';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                SELECT tx_vpg_util.get_comando('SC_SWITCH', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                    INTO v_id_comando
                FROM DUAL;

                po_cod_err := 'PVT-5156';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => pi_id_entidad_consumo,
                            pi_fch_programada       => pi_fch_inicio_vigencia,
                            pi_cod_transaccion      => pi_cod_transaccion,
                            pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                            pi_p2                   => pi_id_entidad_consumo,
                            pi_p3                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'RATE_PLAN_ID', 'VPG_CNF'), -- NEW SEVICE CLASS
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => pi_id_tran,
                            pi_cod_gestion_tran     => pi_cod_gestion_tran,
                            pi_fch_tran             => pi_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                --4- Add main Offer, si lleva
                v_main_offer    :=  tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF');

                IF v_main_offer <> c_falso AND v_main_offer IS NOT NULL THEN

                    po_cod_err := 'PVT-5157';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                    SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                        INTO v_id_comando
                    FROM DUAL;

                    po_cod_err := 'PVT-5158';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_inicio_vigencia,
                                pi_cod_transaccion      => pi_cod_transaccion,
                                pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => v_main_offer, -- OFFER ID
                                pi_p4                   => 'A',
                                pi_p5                   => NULL, --Fecha Vigencia
                                pi_p6                   => NULL, --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => pi_id_tran,
                                pi_cod_gestion_tran     => pi_cod_gestion_tran,
                                pi_fch_tran             => pi_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                END IF;

            ELSE
                 --Plan viejo es Pospago

                --Flag control pospago legacy en CS por SMS roaming
                SELECT COUNT(1)
                    INTO v_dummy
                FROM omega.vpg_orden
                WHERE id_entidad_consumo = pi_id_entidad_consumo
                 AND cod_transaccion = 'TX_TRAN_CREACION_POS_DUMMY';

                IF v_dummy = c_falso THEN
                     -- 1- Crear en CS

                    po_cod_err := 'PVT-5159';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                    SELECT tx_vpg_util.get_comando('ADD_CS', v_reg_plan_nuevo.cod_forma_consumo, 'ADD')
                        INTO v_id_comando
                    FROM DUAL;

                    po_cod_err := 'PVT-5160';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el imsi del numero.
                    SELECT imsi, sim, identificador_entidad
                        INTO v_imsi, v_sim, v_identificador_entidad
                    FROM cl_entidad_consumo
                    WHERE id_entidad_consumo = pi_id_entidad_consumo;

                    po_cod_err := 'PVT-5161';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_inicio_vigencia,
                                pi_cod_transaccion      => pi_cod_transaccion,
                                pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                                pi_p2                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan,'CONTRACT_TEMPLATE_ID', 'VPG_CNF'),
                                pi_p3                   => pi_id_entidad_consumo,
                                pi_p4                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan,'CONTRACT_TYPE_ID', 'VPG_CNF'),
                                pi_p5                   => tx_vpg_util.vpg_getIdSdp(v_identificador_entidad),
                                pi_p6                   => v_imsi,
                                pi_p7                   => v_sim,
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => pi_id_tran,
                                pi_cod_gestion_tran     => pi_cod_gestion_tran,
                                pi_fch_tran             => pi_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                ELSE

                    -- 1- Cambio Service Class en CS
                    po_cod_err := 'PVT-5155';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                    SELECT tx_vpg_util.get_comando('SC_SWITCH', 'CCOPRE', 'SET')
                        INTO v_id_comando
                    FROM DUAL;

                    po_cod_err := 'PVT-5156';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_inicio_vigencia,
                                pi_cod_transaccion      => pi_cod_transaccion,
                                pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'RATE_PLAN_ID', 'VPG_CNF'), -- NEW SEVICE CLASS
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => pi_id_tran,
                                pi_cod_gestion_tran     => pi_cod_gestion_tran,
                                pi_fch_tran             => pi_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;


                END IF;

                -- 2 - Activar Linea --
                IF v_reg_plan_nuevo.cod_forma_consumo = 'CCOPOS' THEN

                    po_cod_err := 'PVT-5155';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                    SELECT tx_vpg_util.get_comando('CMB_CICLO_VIDA', 'CCOPRE', 'SET')
                        INTO v_id_comando
                    FROM DUAL;

                    po_cod_err := 'PVT-5156';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_inicio_vigencia,
                                pi_cod_transaccion      => pi_cod_transaccion,
                                pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => c_fecha_fin_ecms, -- Supervision Period
                                pi_p4                   => c_fecha_fin_ecms, --Service fee Expire Date
                                pi_p5                   => NULL, --Credit clearance Expire Date
                                pi_p6                   => NULL, --Service removal Expire Date
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => pi_id_tran,
                                pi_cod_gestion_tran     => pi_cod_gestion_tran,
                                pi_fch_tran             => pi_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                END IF;

                -- 3- Add Main Offer
                v_main_offer    :=  tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF');

                IF v_main_offer <> c_falso AND v_main_offer IS NOT NULL THEN

                    po_cod_err := 'PVT-5162';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                    SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                        INTO v_id_comando
                    FROM DUAL;

                    po_cod_err := 'PVT-5163';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_inicio_vigencia,
                                pi_cod_transaccion      => pi_cod_transaccion,
                                pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => v_main_offer, -- OFFER ID
                                pi_p4                   => 'A',
                                pi_p5                   => NULL, --Fecha Vigencia
                                pi_p6                   => NULL, --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => pi_id_tran,
                                pi_cod_gestion_tran     => pi_cod_gestion_tran,
                                pi_fch_tran             => pi_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                END IF;

            END IF;

        ELSE

            --Cambio entre planes 4g

            --Eliminar offer actual, si tiene
            v_main_offer_ant    :=  tx_vpg_util.get_plan_param_value(v_reg_plan_anterior.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF');

            IF v_main_offer_ant <> c_falso AND v_main_offer_ant IS NOT NULL THEN

                po_cod_err := 'PVT-5164';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_plan_anterior.cod_forma_consumo, 'SET')
                    INTO v_id_comando
                FROM DUAL;

                po_cod_err := 'PVT-5165';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => pi_id_entidad_consumo,
                            pi_fch_programada       => pi_fch_inicio_vigencia,
                            pi_cod_transaccion      => pi_cod_transaccion,
                            pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                            pi_p2                   => pi_id_entidad_consumo,
                            pi_p3                   => v_main_offer_ant, -- OFFER ID
                            pi_p4                   => 'D',
                            pi_p5                   => NULL, --Fecha Vigencia
                            pi_p6                   => NULL, --Fecha Expiracion
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => pi_id_tran,
                            pi_cod_gestion_tran     => pi_cod_gestion_tran,
                            pi_fch_tran             => pi_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;

            --Validar si el nuevo plan y anterior estan dentro del mismo Service Class (SC), de ser asi solo cambio de Main Offer.
            v_mismo_rate_plan   :=  tx_vpg_util.es_mismo_rate_plan(v_reg_plan_anterior.cod_plan, v_reg_plan_nuevo.cod_plan);

            IF v_mismo_rate_plan =  c_falso THEN

                po_cod_err := 'PVT-5166';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                SELECT tx_vpg_util.get_comando('SC_SWITCH', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                    INTO v_id_comando
                FROM DUAL;

                po_cod_err := 'PVT-5167';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => pi_id_entidad_consumo,
                            pi_fch_programada       => pi_fch_inicio_vigencia,
                            pi_cod_transaccion      => pi_cod_transaccion,
                            pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                            pi_p2                   => pi_id_entidad_consumo,
                            pi_p3                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'RATE_PLAN_ID', 'VPG_CNF'), -- NEW SEVICE CLASS
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => pi_id_tran,
                            pi_cod_gestion_tran     => pi_cod_gestion_tran,
                            pi_fch_tran             => pi_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;

            --Agregar Nuevo main Offer, si lleva.
            v_main_offer    :=  tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF');

            IF v_main_offer <> c_falso AND v_main_offer IS NOT NULL THEN

                po_cod_err := 'PVT-5168';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al recuperar el id comando.
                SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                    INTO v_id_comando
                FROM DUAL;

                po_cod_err := 'PVT-5169';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => pi_id_entidad_consumo,
                            pi_fch_programada       => pi_fch_inicio_vigencia,
                            pi_cod_transaccion      => pi_cod_transaccion,
                            pi_p1                   => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                            pi_p2                   => pi_id_entidad_consumo,
                            pi_p3                   => v_main_offer, -- OFFER ID
                            pi_p4                   => 'A',
                            pi_p5                   => NULL, --Fecha Vigencia
                            pi_p6                   => NULL, --Fecha Expiracion
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => pi_id_tran,
                            pi_cod_gestion_tran     => pi_cod_gestion_tran,
                            pi_fch_tran             => pi_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;


        END IF;

        po_cod_err  :=  'OK';
        po_msj_err  :=  '';

    EXCEPTION
        WHEN err_app THEN
            po_msj_err    := get_error (po_cod_err);
        WHEN OTHERS THEN
            po_msj_err    := get_sys_error (po_cod_err, SQLERRM);
    END generar_orden_cambio_plan;


    PROCEDURE descontar_cambio_plan_prepago (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_plan               IN       cl_entidad_consumo.cod_plan%TYPE,
        pi_cod_plan_nuevo         IN       cl_entidad_consumo.cod_plan%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                          := tx_cnf_constante.get_constante ('TRANS_DESCONTAR_CAMBIO_PLAN_PREPAGO');
        c_monto_descontar    CONSTANT NUMBER (15, 2)
                    := TO_NUMBER (tx_cnf_constante.get_constante ('PENALIDAD_CAMBIO_PLAN_PREPAGO'));
        c_fch_ini_penalidad  CONSTANT DATE
            := TO_DATE (tx_cnf_constante.get_constante ('FCH_INI_PENALIDAD_CAMBIO_PREPAGO'),
                        'YYYYMMDD');
        c_tiempo_permitido   CONSTANT NUMBER
                  := TO_NUMBER (tx_cnf_constante.get_constante ('TIEMPO_PERMITIDO_CAMBIO_PREPAGO'));
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_monto_core_balance          NUMBER (15, 2);
        v_fch_vigencia                DATE;
        v_dummy                       NUMBER;
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        err_app                       EXCEPTION;
    BEGIN
        SELECT COUNT (1)
          INTO v_dummy
          FROM bm_plan p
         WHERE p.cod_plan IN (pi_cod_plan, pi_cod_plan_nuevo)
           AND p.estado = c_estado_activo
           AND EXISTS (SELECT 1
                         FROM bm_grupo_plan gp
                        WHERE gp.cod_grupo_plan = p.cod_grupo_plan
                          AND gp.estado = c_estado_activo
                          AND gp.cod_linea_negocio IN (c_linea_negocio_prepago, 'EXTERN'));

        -- Que ambos planes pertenezcan a la linea de negocio prepago.
        IF v_dummy = 2 THEN
            SELECT COUNT (1)
              INTO v_dummy
              FROM tr_cambio_plan_historico h
             WHERE h.id_entidad_consumo = pi_id_entidad_consumo
               AND h.fch_fin = c_fecha_fin
               AND (   h.fch_inicio < c_fch_ini_penalidad   -- apartir de esta fecha.
                    OR (TRUNC (SYSDATE) - TRUNC (h.fch_inicio)) > c_tiempo_permitido   -- 365
                    OR EXISTS (SELECT 1
                                 FROM cl_entidad_consumo
                                WHERE id_entidad_consumo = h.id_entidad_consumo
                                  AND fch_creacion = h.fch_inicio)
                    OR NOT EXISTS (SELECT 1
                                     FROM (SELECT   *
                                               FROM tr_cambio_plan_historico
                                              WHERE id_entidad_consumo = pi_id_entidad_consumo
                                           ORDER BY fch_inicio)
                                    WHERE ROWNUM <= 2 AND cod_plan <> pi_cod_plan)
                   );

            IF     v_dummy = 0
               AND pi_cod_plan_nuevo NOT IN ('PREPAGO_E',
                                             'PREPAGO_V',
                                             'PREPAGO_NP',
                                             'PREPAGO_P',
                                             'PREPAGO_TU',
                                             'PREPAGO_DS',
                                             'PREVIVA_TU',
                                             'PREPAG_TU2',
                                             'PREPAGO_T'
                                            ) THEN   -- CAMBIO DE PLAN A PREPAGO EXTRA NO TIENE PENALIDAD.
                --LA ENTIDAD DE CONSUMO NO DEBE ESTAR INACTIVA
                validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                         po_msj_err);

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-2146';   --TX_PVT_ENTIDAD_CONSUMO.DESCONTAR_CAMBIO_PLAN_PREPAGO: Error al obtener el balance principal.
                tx_ecms.get_datos_balance (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                           pi_balance_id                  => tx_ecms.c_bal_core_balance,
                                           po_monto                       => v_monto_core_balance,
                                           po_fecha                       => v_fch_vigencia,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                IF v_monto_core_balance < c_monto_descontar THEN
                    po_cod_err := 'PVT-2147';   --TX_PVT_ENTIDAD_CONSUMO.DESCONTAR_CAMBIO_PLAN_PREPAGO: El suscriptor no tiene suficiente balance para realizar el cambio de plan, se requiere de un minimo de RD$50 en el core balance.
                    RAISE err_app;
                END IF;

                IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
                    v_id_accion_prv_ext    := c_prv_accion_recarga;
                ELSE
                    v_id_accion_prv_ext    := 239;
                END IF;

                po_cod_err := 'PVT-2148';   --TX_PVT_ENTIDAD_CONSUMO.DESCONTAR_CAMBIO_PLAN_PREPAGO: Error al invocar al proc. de descuento de credito del suscriptor.
                prv_dispatcher.execute_oas (pi_subscriber_id               => pi_id_entidad_consumo,   --C1 OK
                                            pi_cod_transaccion             => c_tipo_transaccion,
                                            pi_id_action                   => v_id_accion_prv_ext,
                                            pi_sub_operation               => c_tipo_operacion_del,
                                            pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                                            pi_p5                          => c_monto_descontar,   --v_core_balance_descontar,
                                            pi_p6                          => tx_ecms.c_bal_core_balance,
                                            pi_p7                          => 'CAMBIO PLAN PREPAGO',
                                            pi_p8                          => 0,
                                            pi_specific_user               => c_falso,
                                            pi_cod_usuario                 => pi_cod_usuario,
                                            pi_master                      => c_falso,
                                            pi_id_tran                     => pi_id_tran,
                                            pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                            pi_fch_tran                    => pi_fch_tran,
                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        po_cod_err    := 'OK';
        po_msj_err    := NULL;
    EXCEPTION
        WHEN err_app THEN
            po_msj_err    := get_error (po_cod_err);
        WHEN OTHERS THEN
            po_msj_err    := get_sys_error (po_cod_err, SQLERRM);
    END descontar_cambio_plan_prepago;

    FUNCTION tiene_orden_diferida (pi_id_entidad_consumo IN cl_orden_prv.id_entidad_consumo%TYPE)
        RETURN VARCHAR2
    IS
        v_dummy                       PLS_INTEGER;
    BEGIN
        SELECT COUNT (*)
          INTO v_dummy
          FROM cl_orden_prv o
         WHERE o.id_entidad_consumo = TO_CHAR (pi_id_entidad_consumo)
           AND o.estado = c_estado_activo
           AND o.cod_transaccion <> 'TX_BL_ESPEJO.GENERAR'
           AND o.fch_programada > SYSDATE
           AND o.id_action IN (SELECT c.id_action
                                 FROM prv_command c
                                WHERE c.id_device = 3
                                  AND (   c.translation LIKE '%CreateSubscriber%'
                                       OR c.translation LIKE '%DeleteSubscriber%'
                                      ));

        IF v_dummy > 0 THEN
            RETURN c_verdadero;
        ELSE
            RETURN c_falso;
        END IF;
    END;

    FUNCTION get_accion_prv (
        pi_cod_enlace             IN       bm_enlace_oas.cod_enlace%TYPE,
        pi_cod_tecnologia         IN       bm_enlace_oas.cod_tecnologia%TYPE,
        pi_cod_forma_consumo      IN       bm_enlace_oas.cod_forma_consumo%TYPE
    )
        RETURN bm_enlace_oas.id_accion_prv_ext%TYPE
    IS
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
    BEGIN
        SELECT eo.id_accion_prv_ext
          INTO v_id_accion_prv_ext
          FROM bm_enlace_oas eo
         WHERE eo.cod_enlace = pi_cod_enlace
           AND eo.cod_tecnologia = pi_cod_tecnologia
           AND eo.cod_forma_consumo = pi_cod_forma_consumo
           AND eo.estado <> c_estado_inactivo
           AND eo.fch_fin = c_fecha_fin;

        RETURN v_id_accion_prv_ext;
    END;

    PROCEDURE validar_entidad_consumo (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        po_reg_entidad_consumo    OUT      cl_entidad_consumo%ROWTYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
    BEGIN
        SELECT *
          INTO po_reg_entidad_consumo
          FROM cl_entidad_consumo ec
         WHERE ec.id_entidad_consumo = pi_id_entidad_consumo
           AND estado NOT IN (c_estado_inactivo,c_estado_terminado,'POST');

        po_cod_err    := 'OK';
        po_msj_err    := NULL;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            po_cod_err := 'PVT-2149';   --TX_PVT_ENTIDAD_CONSUMO.VALIDAR_ENTIDAD_CONSUMO: El suscriptor no esta activo o no existe.
            po_msj_err    := get_error (po_cod_err);
        WHEN OTHERS THEN
            po_cod_err := 'PVT-2150';   --TX_PVT_ENTIDAD_CONSUMO.VALIDAR_ENTIDAD_CONSUMO: Error al recuperar los datos del suscriptor.
            po_msj_err    := get_sys_error (po_cod_err, SQLERRM);
    END;

    FUNCTION plan_preg (pi_tipo IN cnf_configuracion_especial.tipo%TYPE,
                        pi_plan IN bm_plan.cod_plan%TYPE)
        RETURN VARCHAR2
    IS
        v_tipo                         cnf_configuracion_especial.tipo%TYPE;
        v_nombre_tabla                 cnf_configuracion_especial.nombre_tabla%TYPE;
        v_estado                       cnf_configuracion_especial.parametro_2%TYPE;
        v_cod_plan                     cnf_configuracion_especial.parametro_1%TYPE;
        v_existe                       varchar2 (10);
    BEGIN
        v_tipo := pi_tipo; -- origen o destino
        v_cod_plan := pi_plan;
        v_nombre_tabla := 'cnf_cambio_plan_dealer';
        v_estado := 'A';

 select count(1)
   into v_existe
   from cnf_configuracion_especial
  where nombre_tabla = v_nombre_tabla
    and tipo = v_tipo
    and parametro_1 = v_cod_plan
    and parametro_2 = v_estado;


    IF  v_tipo = 'origen' or v_tipo = 'destino'  THEN
       IF v_existe > 0 THEN
            RETURN v_existe;
        ELSE
            RETURN 0;
        END IF;
    end if;

    END;


    FUNCTION excepcion_cambio_sim (pi_id_entidad_consumo IN cl_entidad_consumo.id_entidad_consumo%TYPE)
        RETURN number
    IS

        v_estado                       vta_excepcion.estado %TYPE;
        v_existe                       number:=0;

    BEGIN

    select count(1)
      into v_existe
      from vta_excepcion
     where cod_tipo_excepcion = 'TEXECS'
       and estado = 'A'
       and id_entidad_consumo =pi_id_entidad_consumo
       and trunc(fch_inicio) = trunc(sysdate)
       and fch_fin > sysdate;


       IF v_existe > 0 THEN
            RETURN v_existe;
        ELSE
            RETURN 0;
        END IF;


    END;



    FUNCTION suscriptor_tiene_suspension (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE
    )
        RETURN VARCHAR2
    IS
        v_servicios                   PLS_INTEGER;
        v_estado_entidad              VARCHAR2(10);
    BEGIN
        SELECT COUNT (*)
          INTO v_servicios
          FROM cl_servicio_entidad_consumo sec, bm_servicio s
         WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
           AND sec.estado <> c_estado_inactivo
           AND sec.fch_fin = c_fecha_fin
           AND sec.cod_servicio = s.cod_servicio
           AND s.cod_tipo_servicio = c_tipo_serv_estado
           AND s.cod_servicio not in ('SS07','SS11','SS12');

        IF v_servicios > 0 THEN
            RETURN c_verdadero;
        ELSE
            RETURN c_falso;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN
            RETURN c_falso;
    END;

    PROCEDURE get_estado_entidad_consumo (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        po_estado                 OUT      bm_servicio_suspension.estado_asociado%TYPE,
        po_customer_group         OUT      bm_servicio_suspension.grupo_cliente%TYPE,
        po_salientes              OUT      bm_servicio_suspension.susp_salientes%TYPE,
        po_entrantes              OUT      bm_servicio_suspension.susp_entrantes%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        v_id_entificador_entidad      cl_entidad_consumo.identificador_entidad%TYPE;
    BEGIN
        BEGIN
            po_cod_err := 'PVT-2151';   --TX_PVT_ENTIDAD_CONSUMO.GET_ESTADO_ENTIDAD_CONSUMO: Error al determinar el estado del suscriptor.

            SELECT estado_asociado,
                   grupo_cliente,
                   susp_salientes,
                   susp_entrantes
              INTO po_estado,
                   po_customer_group,
                   po_salientes,
                   po_entrantes
              FROM (SELECT sec.cod_servicio,
                           s.prioridad,
                           MIN (s.prioridad) OVER () min_prioridad,
                           sec.fch_inicio,
                           MAX (sec.fch_inicio) OVER (PARTITION BY s.prioridad) max_fch_inicio,
                           s.estado_asociado,
                           s.grupo_cliente,
                           SUM (s.susp_salientes) OVER () susp_salientes,
                           SUM (s.susp_entrantes) OVER () susp_entrantes
                      FROM cl_servicio_entidad_consumo sec, bm_servicio_suspension s
                     WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                       AND sec.estado <> c_estado_inactivo
                       AND sec.fch_fin = c_fecha_fin
                       AND sec.cod_servicio = s.cod_servicio
                       AND s.estado <> c_estado_inactivo
                       AND s.fch_fin = c_fecha_fin)
             WHERE prioridad = min_prioridad AND fch_inicio = max_fch_inicio AND ROWNUM = 1;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                po_estado       := c_estado_activo;
                po_salientes    := 0;
                po_entrantes    := 0;
                po_cod_err := 'PVT-2152';   --TX_PVT_ENTIDAD_CONSUMO.GET_ESTADO_ENTIDAD_CONSUMO: Error al recuperar el customer group del plan del suscriptor.

                SELECT p.customer_group
                  INTO po_customer_group
                  FROM bm_plan p
                 WHERE p.cod_plan = (SELECT ec.cod_plan
                                       FROM cl_entidad_consumo ec
                                      WHERE ec.id_entidad_consumo = pi_id_entidad_consumo);

                po_cod_err := 'PVT-2153';   --TX_PVT_ENTIDAD_CONSUMO.GET_ESTADO_ENTIDAD_CONSUMO: Error al recuperar el identificador de entidad

                SELECT identificador_entidad
                  INTO v_id_entificador_entidad
                  FROM cl_entidad_consumo
                 WHERE id_entidad_consumo = pi_id_entidad_consumo;

                IF tx_por_utiles.get_customer_group_rango (v_id_entificador_entidad) IS NOT NULL THEN
                    po_customer_group    :=
                                  tx_por_utiles.get_customer_group_rango (v_id_entificador_entidad);
                END IF;
        END;

        po_cod_err    := 'OK';
        po_msj_err    := NULL;
    EXCEPTION
        WHEN OTHERS THEN
            po_msj_err    := get_sys_error (po_cod_err, SQLERRM);
    END;

    FUNCTION get_tipo_numero (
        pi_identificador_entidad  IN       cl_entidad_consumo.identificador_entidad%TYPE
    )
        RETURN VARCHAR2
    IS
        v_estado                      cl_numero_telefonico.estado%TYPE;
    BEGIN
        SELECT estado
          INTO v_estado
          FROM cl_numero_telefonico t
         WHERE t.numero_telefonico = pi_identificador_entidad;

        RETURN v_estado;
    EXCEPTION
        WHEN OTHERS THEN
            RETURN NULL;
    END;

    FUNCTION get_min (pi_cod_plan IN bm_plan.cod_plan%TYPE)
        RETURN VARCHAR2
    IS
        v_min                         cl_numero_telefonico.numero_telefonico%TYPE;
        v_cod_segmento                cl_rangos.cod_segmento%TYPE;
        v_cod_linea_negocio           bm_linea_negocio.cod_linea_negocio%TYPE;
    BEGIN
        v_cod_linea_negocio    := get_linea_negocio (pi_cod_plan);

        IF es_fija (pi_cod_plan) = '1' THEN
            v_cod_segmento    := 'FIJO';
        ELSIF v_cod_linea_negocio IN ('VOIP', 'INTER', 'T1VOZ') THEN
            v_cod_segmento    := v_cod_linea_negocio;
        ELSE
            v_cod_segmento    := 'MOVIL';
        END IF;

        SELECT t.numero_telefonico
          INTO v_min
          FROM cl_rangos r, cl_numero_telefonico t
         WHERE r.cod_segmento = v_cod_segmento
           AND SUBSTR (t.numero_telefonico, 1, 6) = r.rango
           AND t.estado_numero = '1'
           AND t.estado = c_tipo_numero_viva
           AND t.numero_telefonico NOT LIKE '82930699%'
           AND t.numero_telefonico NOT LIKE '82930799%'
           AND t.numero_telefonico NOT LIKE '829414999%'
           AND t.numero_telefonico NOT LIKE '8294155%'
           AND t.numero_telefonico NOT LIKE '8094179%'
           AND t.numero_telefonico NOT LIKE '82930689%'
           AND t.numero_telefonico NOT LIKE '82930655%'
           AND t.numero_telefonico NOT LIKE '809503%'
           -- solo null o CDMA aplican para MINs
           AND NVL (r.cod_tecnologia, 'CDMA') = 'CDMA'
           AND ROWNUM = 1;

        RETURN v_min;
    END;

    FUNCTION get_min_suscriptor (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE
    )
        RETURN VARCHAR2
    IS
        v_min                         cl_numero_telefonico.numero_telefonico%TYPE;
    BEGIN
        SELECT eca.identificador_entidad_afin
          INTO v_min
          FROM cl_entidad_consumo_afin eca
         WHERE eca.id_entidad_consumo = pi_id_entidad_consumo
           AND eca.cod_tipo_afinidad = 'TAMIN'
           AND eca.estado = c_estado_activo
           AND eca.fch_fin = c_fecha_fin;

        RETURN v_min;
    END;

    PROCEDURE get_ultimo_contrato (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        po_id_contrato            OUT      cl_contrato_entidad_consumo.id_contrato%TYPE,
        po_cod_origen             OUT      cl_contrato_entidad_consumo.cod_origen%TYPE,
        po_fecha_contrato         OUT      cl_contrato_entidad_consumo.fch_inicio%TYPE,
        po_id_prospecto           OUT      cl_contrato_entidad_consumo.id_prospecto%TYPE,
        po_cod_articulo           OUT      vta_articulo_prospecto.cod_articulo%TYPE,
        po_precio_venta           OUT      vta_articulo_prospecto.precio_venta%TYPE,
        po_procedencia_articulo   OUT      vta_articulo_prospecto.procedencia_articulo%TYPE,
        po_cod_err                OUT      VARCHAR2
    )
    IS
    BEGIN
        po_cod_err := 'PVT-2154';   --TX_PVT_ENTIDAD_CONSUMO.GET_ULTIMO_CONTRATO: Error al recuperar el contrato

        BEGIN
            SELECT fch_inicio,
                   id_contrato,
                   cod_origen,
                   id_prospecto
              INTO po_fecha_contrato,
                   po_id_contrato,
                   po_cod_origen,
                   po_id_prospecto
              FROM cl_contrato_entidad_consumo c
             WHERE id_entidad_consumo = pi_id_entidad_consumo AND fch_fin = c_fecha_fin;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                po_fecha_contrato    := NULL;
                po_id_contrato       := NULL;
        END;

        IF po_id_contrato IS NOT NULL AND po_id_prospecto IS NOT NULL THEN
            BEGIN
                IF po_cod_origen = 'CONCAT' THEN
                    po_cod_err := 'PVT-2155';   --TX_PVT_ENTIDAD_CONSUMO.GET_ULTIMO_CONTRATO: Error al recuperar datos del prospecto de venta

                    SELECT vta.cod_articulo,
                           vta.precio_venta,
                           vta.procedencia_articulo
                      INTO po_cod_articulo,
                           po_precio_venta,
                           po_procedencia_articulo
                      FROM vta_entidad_consumo v, vta_articulo_prospecto vta
                     WHERE v.id_prospecto_ec = po_id_prospecto
                       AND vta.id_prospecto_ec = v.id_prospecto_ec
                       AND vta.cod_rubro_articulo IN ('TACDMA', 'TAGSM');
                ELSE
                    po_cod_err := 'PVT-2156';   --TX_PVT_ENTIDAD_CONSUMO.GET_ULTIMO_CONTRATO: Error al recuperar datos del prospecto de venta

                    SELECT vta.cod_articulo,
                           vta.precio_venta,
                           vta.procedencia_articulo
                      INTO po_cod_articulo,
                           po_precio_venta,
                           po_procedencia_articulo
                      FROM vta_articulo_prospecto vta
                     WHERE vta.id_prospecto = po_id_prospecto
                       AND vta.cod_rubro_articulo IN ('TACDMA', 'TAGSM');
                END IF;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    po_cod_articulo            := NULL;
                    po_precio_venta            := NULL;
                    po_procedencia_articulo    := NULL;
            END;
        END IF;

        po_cod_err    := 'OK';
    END;

    PROCEDURE cambio_plan (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_ciclo_facturacion  IN       cl_comunidad.cod_ciclo_facturacion%TYPE DEFAULT NULL,
        pi_cod_plan               IN       cl_entidad_consumo.cod_plan%TYPE,
        pi_es_pago_diferido       IN       vta_cambio_plan.es_pago_diferido%TYPE,
        pi_es_x_retencion         IN       vta_cambio_plan.es_x_retencion%TYPE DEFAULT NULL,
        pi_con_contrato           IN       VARCHAR2 DEFAULT '0',
        pi_id_entidad_venta       IN       vta_venta_entidad.id_venta_entidad%TYPE,
        pi_cod_usuario_asignado   IN       vta_venta_entidad.cod_usuario_asignado%TYPE,
        pi_id_prospecto_mig       IN       vta_cambio_plan.es_pago_diferido%TYPE,
        pi_id_venta_mig           IN       vta_venta_prospecto.id_venta%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                      := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_PLAN');
        c_tipo_tran_zonificacion_fh CONSTANT VARCHAR2 (50)
                          := tx_cnf_constante.get_constante ('TRANSACCION_ASIGNAR_ZONA_FULL_HOGAR');
        c_limite_credito     CONSTANT VARCHAR2 (50)
                                               := tx_cnf_constante.get_constante ('LIMITE_CREDITO');
        c_srv_prepago        CONSTANT VARCHAR2 (50)
                              := tx_cnf_constante.get_constante ('PENALIDAD_CAMBIO_MIGRACION_PLAN');
        c_motivo_prepago     CONSTANT VARCHAR2 (50)
                                := tx_cnf_constante.get_constante ('CAMBIO_MIGRACION_PLAN_PREPAGO');
        c_deuda_minima                cnf_constante.valor%TYPE
                           := tx_cnf_constante.get_constante ('DEUDA_MINIMA_CAMBIO_PLAN_MIGRACION');
        c_require_firma     cnf_constante.valor%TYPE := tx_cnf_constante.get_constante ('FIRMA_CAMBIO_PLAN');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.CAMBIO_PLAN';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_reg_servicio                bm_servicio%ROWTYPE;
        v_reg_plan_anterior           bm_plan%ROWTYPE;
        v_reg_plan_nuevo              bm_plan%ROWTYPE;
        v_cod_servicio                bm_servicio.cod_servicio%TYPE;
        v_cod_servicio_bb             bm_servicio.cod_servicio%TYPE;
        v_cod_servicio_pi             bm_servicio.cod_servicio%TYPE;
        v_cod_linea_negocio_anterior  cl_comunidad.cod_linea_negocio%TYPE;
        v_cod_linea_negocio_nuevo     cl_comunidad.cod_linea_negocio%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_permiso                     VARCHAR2 (10);
        v_principales                 PLS_INTEGER;
        v_reg_comunidad               cl_comunidad%ROWTYPE;
        v_puede_cambiar_plan          VARCHAR2 (1);
        v_precio_venta                inv_precio_articulo.precio%TYPE := 0;
        v_precio_venta_con_imp        inv_precio_articulo.precio%TYPE := 0;
        v_precio_venta_sin_imp        inv_precio_articulo.precio%TYPE := 0;
        v_dummy                       PLS_INTEGER;
        v_id_prospecto                vta_cambio_plan.id_prospecto%TYPE;
        v_id_venta_entidad            vta_venta_entidad.id_venta_entidad%TYPE;
        v_id_venta_main               vta_venta_prospecto.id_venta%TYPE;
        v_id_prospecto_main           vta_venta_prospecto.id_prospecto%TYPE;
        v_nombre_factura              VARCHAR2 (200);
        v_rnc_factura                 cl_persona.nit%TYPE;
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_cod_tipo_entidad_venta_p    inv_entidad_venta.cod_tipo%TYPE;
        v_cod_categoria_documento     bl_dosificacion.cod_categoria_documento%TYPE;
        v_tipo_documento              cnf_cta_tipo_documento.cod_tipo_documento%TYPE;
        v_id_cargo_impuesto           NUMBER;
        v_cod_servicio_bb_new         bm_servicio.cod_servicio%TYPE;
        v_reg_periodo_facturacion     tr_periodo_facturacion%ROWTYPE;
        v_cod_ciclo_anterior          cl_comunidad.cod_ciclo_facturacion%TYPE;
        v_cod_ciclo_nuevo             cl_comunidad.cod_ciclo_facturacion%TYPE;
        v_id_cuenta_corriente         cl_comunidad.id_cuenta_corriente%TYPE;
        v_deuda_cuenta                cta_doc_cuenta_corriente.valor%TYPE;
        v_prorrateo_impuestos         NUMBER := 0;
        v_factura_atraso              NUMBER;
        v_es_empleado                 NUMBER;
        v_monto                       NUMBER := 0;
        v_monto_con_imp               NUMBER := 0;
        v_prorrateo_con_imp           NUMBER := 0;
        v_prorrateo                   NUMBER := 0;
        v_estado_pps                  VARCHAR2 (50);
        v_bb_control_empresarial      PLS_INTEGER;
        v_tiene_bb_prepago            PLS_INTEGER;
        v_descuento_plan              NUMBER (15, 2);
        v_id_prospecto_detalle        vta_venta_prospecto_detalle.id_prospecto_detalle%TYPE;
        v_nro_documento               cl_persona.nro_documento%TYPE;
        v_nombre_cliente              VARCHAR2 (150);
        v_cod_tipo_documento          cl_persona.cod_tipo_documento%TYPE;
        v_dual_sim                    PLS_INTEGER;
        v_tmp_result                  VARCHAR2(20);
        v_penalidad_bb                NUMBER := 0;
        v_id_subsidio                 NUMBER := 0;
        v_count_subsidio              NUMBER := 0;
        v_id_subsidio_equipo          NUMBER := 0;
        v_id_subsidio_equipo2         NUMBER := 0;
        v_count_equipo                NUMBER := 0;
        v_count_equipo2               NUMBER := 0;
        v_identificador_entidad       VARCHAR2(50);
        v_cod_tipo_documento_ars      VARCHAR2 (10);
        v_cod_segmento_nuevo          VARCHAR2(25);
        v_es_mig_prepag_t             NUMBER;
        v_descuento_empleado          NUMBER;
    	v_cnf_descuento_id 			  NUMBER;
    	v_codigo_descuento 			  VARCHAR2(50);
   		v_registro_descuento 		  cl_descuento_entidad_consumo%ROWTYPE;
   		v_cod_plan_entidad 			  cl_entidad_consumo.cod_plan%TYPE;


        v_seg_rol_usuario_count       INTEGER;
        v_id_persona                  INTEGER := 0;
        v_mail_cliente                VARCHAR2(150) := NULL;
        v_mail_upg_cambio             VARCHAR2(4000);
        v_cod_segmento_origen         v_plan_segmento.cod_segmento%TYPE;
        v_cod_segmento_destino        v_plan_segmento.cod_segmento%TYPE;
        v_name_plan_origen            v_plan_segmento.plan%TYPE;
        v_name_plan_destino           v_plan_segmento.plan%TYPE;
        v_reg_camb_plan_sms           cl_entidad_consumo%ROWTYPE;
        v_id_mensaje                  sms_despachador.id_sms%TYPE;
        v_sms_mensaje                 VARCHAR2(255);
        v_id_archivo                  cl_archivo.id_archivo%TYPE;
        v_nombre_usuario              seg_personal.nombres%TYPE;

        v_plan_migracion_prepag       INTEGER;
        v_monto_recarga               FLOAT(126);
        v_core_balance_monto          FLOAT(126);
        v_core_balance_fch_vigencia   DATE;
        v_bolsillos_cs                tx_ecms.type_ecms_bolsilos;
        v_cod_ciclo                   cl_comunidad.cod_ciclo_facturacion%TYPE;
        v_deuda_vigente                       PLS_INTEGER;


        TYPE t_penalidad IS RECORD (
            cod_tipo_documento  cnf_cta_tipo_documento.cod_tipo_documento%TYPE,
            id_cargo            NUMBER(15,5),
            valor_simp          NUMBER(15,5),
            valor_cimp          NUMBER(15,5)
        );
        TYPE t_docs_penalidad IS TABLE OF t_penalidad INDEX BY BINARY_INTEGER;

        v_docs_penalidad              t_docs_penalidad;
        v_penalidad                   t_penalidad;

        v_doc                         VARCHAR2 (8);

        TYPE t_subsidio IS VARRAY (3) OF NUMBER (15, 5);

        TYPE t_subsidios IS TABLE OF t_subsidio
            INDEX BY BINARY_INTEGER;

        v_subsidios                   t_subsidios;
        v_subs                        NUMBER (15, 0);
        v_con_contrato                VARCHAR2 (50);
        v_monto_deposito              NUMBER;
        v_monto_deposito_tmp          NUMBER;
        v_monto_descuento             NUMBER;
        v_impuestos                   NUMBER;
        v_id_registro_dpt             NUMBER;
        po_fch_tran                   DATE;
        v_monto_descuento_imp         NUMBER;
        v_balances_pps                tx_air.air_balance_instances;
        -- Excepciones
        err_app                       EXCEPTION;
        v_prepag_ant                  NUMBER;
        v_segmento_no_requiere_firma  NUMBER;
        v_id_entidad_venta_padre      NUMBER;

    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_plan:'
            || pi_cod_plan
            || '|'
            || 'pi_es_pago_diferido:'
            || pi_es_pago_diferido
            || '|'
            || 'pi_es_x_retencion:'
            || pi_es_x_retencion
            || '|'
            || 'pi_id_entidad_venta:'
            || pi_id_entidad_venta
            || '|'
            || 'pi_cod_usuario_asignado:'
            || pi_cod_usuario_asignado
            || '|'
            || 'pi_id_prospecto_mig:'
            || pi_id_prospecto_mig
            || '|'
            || 'pi_id_venta_mig:'
            || pi_id_venta_mig
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_plan IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2157';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2158';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2159';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                := v_id_tran;
        po_cod_gestion_tran       := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        --EL SUSCRIPTOR NO DEBE TENER NINGUNA SUSPENSION NI DESCONEXION
        IF     suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero
           AND es_fija_prepago(pi_cod_plan) = '0' THEN
            po_cod_err := 'PVT-2160';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --EL SUSCRIPTOR NO DEBE ESTAR INACTIVO
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --EL PLAN NUEVO DEBE SER DISTINTO AL ACTUAL
        IF v_reg_entidad_consumo.cod_plan = pi_cod_plan THEN
            po_cod_err := 'PVT-2161';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: El plan actual y el nuevo son iguales.
            RAISE err_app;
        END IF;


        SELECT
            COUNT(1)
        INTO v_es_empleado
        FROM cl_base_empleados cee
            JOIN cl_persona p ON cee.nro_documento = p.nro_documento
                AND cee.estado = 'A'
            JOIN cl_entidad_consumo clen ON p.id_persona = clen.id_persona
        WHERE clen.cod_plan = 'PREPAG_4G'
            AND cee.cod_empresa = 'EMPVIV'
            AND clen.estado = 'A'
            AND clen.id_entidad_consumo = pi_id_entidad_consumo;
        ---FIN

        --OBTENCION DE DATOS DE PLANES ACTUAL Y NUEVO
        po_cod_err := 'PVT-2164';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al recuperar el grupo de plan anterior.
        SELECT *
          INTO v_reg_plan_anterior
          FROM bm_plan b
         WHERE b.cod_plan = v_reg_entidad_consumo.cod_plan;

        po_cod_err := 'PVT-2165';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al recuperar forma de consumo del plan nuevo.
        SELECT *
          INTO v_reg_plan_nuevo
          FROM bm_plan b
         WHERE b.cod_plan = pi_cod_plan;

        --CVE: nuevas reglas planes especiales y prepago_4g.
        CASE
            WHEN  v_reg_entidad_consumo.cod_plan = 'HIBESPXS' THEN
                IF pi_cod_plan IN ('HIBESP14','HIBESP299','HIBPLESP24','PREPAG_4G') OR (NVL(v_reg_plan_nuevo.tarifa_basica, 0) > NVL(v_reg_plan_anterior.tarifa_basica, 0)) THEN
                    po_cod_err := 'OK';
                ELSE
                    po_cod_err := 'PVT-6180';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.
                    po_msj_err  :=  'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan por regla planes especiales.';
                    RAISE err_app;
                END IF;

            WHEN  v_reg_entidad_consumo.cod_plan in ('HIBESP14','HIBESP299') THEN
                IF pi_cod_plan IN ('HIBPLESP24','PREPAG_4G') OR (NVL(v_reg_plan_nuevo.tarifa_basica, 0) > NVL(v_reg_plan_anterior.tarifa_basica, 0)) THEN
                    po_cod_err := 'OK';
                ELSE
                    po_cod_err := 'PVT-6181';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.
                    po_msj_err  :=  'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan por regla planes especiales.';
                    RAISE err_app;
                END IF;

            WHEN  v_reg_entidad_consumo.cod_plan = 'HIBPLESP24' THEN
                IF pi_cod_plan = 'PREPAG_4G' OR (NVL(v_reg_plan_nuevo.tarifa_basica, 0) > NVL(v_reg_plan_anterior.tarifa_basica, 0)) THEN
                    po_cod_err := 'OK';
                ELSE
                    po_cod_err := 'PVT-6182';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.
                    po_msj_err  :=  'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan por regla planes especiales.';
                    RAISE err_app;
                END IF;

            WHEN  v_reg_entidad_consumo.cod_plan = 'PREPAG_4G' THEN
                IF pi_cod_plan IN ('HIBESP14','HIBESP299','HIBPLESP24') OR (NVL(v_reg_plan_nuevo.tarifa_basica, 0) >= NVL(v_reg_plan_anterior.tarifa_basica, 0)) THEN
                    po_cod_err := 'OK';
                ELSE
                    po_cod_err := 'PVT-6183';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.
                    po_msj_err  :=  'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan por regla planes especiales.';
                    RAISE err_app;
                END IF;

            WHEN  v_reg_entidad_consumo.cod_plan NOT IN ('HIBESPXS', 'HIBESP14', 'HIBESP299','HIBPLESP24', 'PREPAG_4G') THEN
                IF pi_cod_plan NOT IN ('HIBESPXS','HIBESP14','HIBPLESP24','HIBESP299')  THEN
                    po_cod_err := 'OK';
                ELSE
                    po_cod_err := 'PVT-6184';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.
                    po_msj_err  :=  'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan por regla planes especiales.';
                    RAISE err_app;
                END IF;

            ELSE
                    po_cod_err := 'OK';
        END CASE;

        IF v_reg_entidad_consumo.cod_plan = 'HIBESPXS' THEN
                 --NO PERMITIR MIGRACION HACIA ESTE PLAN    --CVE: se quita el plan 'HIBPLESP24' de esta regla, ya que debe permitirlo.
            IF get_segmento(pi_cod_plan) IN ('PREPAGOTRY') OR pi_cod_plan IN ('HIBESPXS','HIBESPS','HIBESPM','HIBESPXS20','HIBPLES3','HIBPLES4', 'HIBPLU20','HIBESP299') THEN
                po_cod_err := 'PVT-5202';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.
                po_msj_err  :=  'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.';
                RAISE err_app;
            END IF;

        ELSE

             IF v_es_empleado = 0 THEN  --CVE: se quita los planes 'HIBPLESP24' y 'HIBESP14' de esta regla, ya que debe permitirlo.
                IF get_segmento(pi_cod_plan) IN ('PREPAGOTRY') OR pi_cod_plan IN ('HIBESPXS','HIBESPS','HIBESPM','HIBESPXS20','HIBPLES3','HIBPLES4','HIBPLU20','HIBESP299') THEN
                    po_cod_err := 'PVT-5202';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.
                    po_msj_err := 'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.';
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        IF tiene_orden_diferida (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2162';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: La transaccion debe realizarse a fin de ciclo puesto que el suscriptor tiene ordenes diferidas.
            RAISE err_app;
        END IF;

        --- RECUPERAR LA ENTIDAD DE VENTA PADRE
        po_cod_err := 'PVT-2163';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El equipo que desea cambiar esta fuera del tiempo de garantia.

        SELECT vv.cod_tipo, v.id_entidad_venta_padre
          INTO v_cod_tipo_entidad_venta_p, v_id_entidad_venta_padre
          FROM inv_entidad_venta v, inv_entidad_venta vv
         WHERE v.id_entidad_venta = pi_id_entidad_venta
           AND vv.id_entidad_venta = v.id_entidad_venta_padre;

        IF     v_reg_plan_nuevo.cod_plan IN ('PREPAGO_TT', 'PREPAGO_DS')
           AND pi_cod_usuario NOT IN ('ADMOMEGA', 'OMEGA') THEN
            po_cod_err := 'PVT-2166';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta autorizado a realizar este cambio de plan
            RAISE err_app;
        END IF;

        IF     v_reg_plan_anterior.cod_plan IN ('PREPAGO_TT', 'PREPAGO_DS')
           AND v_reg_plan_nuevo.cod_grupo_plan IN ('PREANU', 'PRESEG')
           AND pi_cod_usuario != 'ADMOMEGA' THEN
            po_cod_err := 'PVT-2167';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta autorizado a realizar el cambio de plan.
            RAISE err_app;
        END IF;

        IF (get_segmento(v_reg_plan_anterior.cod_plan) IN ('INTENEGHIB')) AND (get_segmento(v_reg_plan_anterior.cod_plan) != get_segmento(v_reg_plan_nuevo.cod_plan))   THEN
            po_cod_err := 'PVT-5202';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.
            po_msj_err  :=  'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan';
            RAISE err_app;
        END IF;

        IF  ( v_reg_plan_anterior.cod_plan IN ('INTRESHIGN') AND v_reg_plan_nuevo.cod_plan <> 'INTFULGN' ) OR v_reg_plan_nuevo.cod_plan IN ('INTRESHIGN')   THEN
            po_cod_err := 'PVT-6073';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio hacia este plan.
            po_msj_err  :=  'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido el cambio desde o hacia este plan';
            RAISE err_app;
        END IF;

        IF v_reg_plan_nuevo.tecnologia_aplicable NOT LIKE
                                                  '%' || v_reg_entidad_consumo.cod_tecnologia || '%' THEN
            po_cod_err := 'PVT-2168';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: El plan nuevo no es aplicable a la tecnologia del suscriptor.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2169';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al validar si se tiene un prospecto pendiente

        SELECT COUNT (1)
          INTO v_dummy
          FROM vta_cambio_plan v
         WHERE id_entidad_consumo = pi_id_entidad_consumo
           AND estado = c_estado_activo
           AND v.fch_fin = c_fecha_fin;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2170';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: El suscriptor tiene un prospecto de cambio de plan pendiente a ser pagado en caja.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2171';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al determinar si renta

        SELECT bg.se_renta
          INTO v_puede_cambiar_plan
          FROM bm_grupo_plan bg, bm_plan p
         WHERE p.cod_plan = v_reg_entidad_consumo.cod_plan AND bg.cod_grupo_plan = p.cod_grupo_plan;

        IF v_puede_cambiar_plan = c_verdadero THEN
            po_cod_err := 'PVT-2172';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: El suscriptor no puede cambiar a ese plan
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2173';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al detmrminar la linea de negocio del plan actual.

        SELECT gp.cod_linea_negocio
          INTO v_cod_linea_negocio_anterior
          FROM bm_grupo_plan gp
         WHERE gp.cod_grupo_plan = v_reg_plan_anterior.cod_grupo_plan;

        po_cod_err := 'PVT-2174';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al determinar la linea de negocio del plan nuevo.

        SELECT gp.cod_linea_negocio
          INTO v_cod_linea_negocio_nuevo
          FROM bm_grupo_plan gp
         WHERE gp.cod_grupo_plan = v_reg_plan_nuevo.cod_grupo_plan;

        IF es_fija (v_reg_plan_anterior.cod_plan) = '0' AND es_fija (v_reg_plan_nuevo.cod_plan) =
                                                                                                 '1' THEN
            po_cod_err := 'PVT-5000'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitida la migracion hacia la linea de negocio de Telefonia Fija.
            RAISE err_app;
        END IF;

        IF ((v_cod_linea_negocio_anterior <> c_linea_negocio_mifi AND v_cod_linea_negocio_nuevo = c_linea_negocio_mifi)
           OR (v_cod_linea_negocio_anterior = c_linea_negocio_mifi AND v_cod_linea_negocio_nuevo <> c_linea_negocio_mifi))
           AND (v_reg_plan_anterior.cod_plan NOT IN ('RLCP','RLCPM') AND v_reg_plan_nuevo.cod_plan NOT IN ('INTSOC1'))
        THEN
              po_cod_err := 'PVT-5209'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan.
              RAISE err_app;
        END IF;

         -- 4524259 - Mejoras Planes MIFI PYME
         IF get_segmento(v_reg_plan_nuevo.cod_plan) = 'INTENEGHIB' THEN

            SELECT p.nro_documento,
                   p.cod_tipo_documento
                INTO   v_nro_documento,
                       v_cod_tipo_documento
            FROM cl_persona p
             WHERE p.id_persona = v_reg_entidad_consumo.id_persona;

            SELECT COUNT(1)
                INTO v_dummy
            FROM cl_rnc
            WHERE estado = 'A'
                AND rnc = v_nro_documento
                AND fch_tran_fin = utl_verificacion.get_end_date;

            IF v_dummy != c_falso THEN
                po_cod_err := 'PVT-6108'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Este numero documento no aparece en los registros de la DGII.
                RAISE err_app;
            END IF;

            SELECT  COUNT (1)
                  INTO   v_dummy
             FROM   vta_excepcion e
             WHERE  e.nro_documento = v_nro_documento
                 AND e.cod_tipo_doc = v_cod_tipo_documento
                 AND e.cod_plan = v_reg_plan_nuevo.cod_plan
                 AND e.cod_tipo_excepcion = c_tipo_excepcion_cambio_plan;

            IF v_cod_tipo_documento = 'CI' THEN
                 IF v_dummy = c_falso THEN
                    po_cod_err := 'PVT-6109'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Lo sentimos, para activar planes PYMES debe tener una excepcion. Favor contactar a  soporteplanespymes@viva.com.do.
                    RAISE err_app;
                END IF;
            END IF;

            IF v_cod_tipo_documento = 'RNC' AND v_reg_plan_nuevo.cod_plan = 'INTPYME10' THEN
                IF v_dummy = c_falso THEN
                    po_cod_err := 'PVT-6110'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Lo sentimos, para activar planes PYMES debe tener una excepcion. Favor contactar a  soporteplanespymes@viva.com.do.
                    RAISE err_app;
                END IF;
            END IF;

         END IF;

         -- END 4524259 - Mejoras Planes MIFI PYME
          --VALIDACION CAMBIO HACIA ESTE PLAN rqx 4534649
        IF v_reg_plan_nuevo.cod_plan = 'INTRESH101' THEN
            IF pi_cod_plan  IN('INTRASTER1, INTRASTER2, INTRESHI51, INTRESHIGN') THEN
                po_cod_err := 'PVT-6046'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan para este cliente.
                RAISE err_app;
            END IF;
        END IF;

        IF pi_cod_plan = 'INTRESH101' THEN
            --El plan actual no debe ser INTRASTER1, INTRASTER2, INTRESHI51, INTRESHIGN
            IF v_reg_entidad_consumo.cod_plan NOT IN('INTRESHIB5') THEN
                po_cod_err := 'PVT-6046'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan para este cliente.
                RAISE err_app;
            END IF;

            --El segmento del cliente debe ser Oro, Plantino, Plata
            SELECT COUNT(1)
                INTO v_dummy
            FROM cl_entidad_clasif
            WHERE id_entidad = TO_CHAR(v_reg_entidad_consumo.id_entidad_consumo)
            AND cod_entidad = 'CL_ENTIDAD_CONSUMO'
            AND cod_tipo_clasificacion IN ('A','B','C','AA')
            AND FCH_FIN > SYSDATE;

            IF v_dummy = c_falso THEN
                po_cod_err := 'PVT-6048'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambiar a este plan el cliente debe ser Oro, Plata o Platino.
                RAISE err_app;
            END IF;

             --viene de prepago
            WITH
                base
                AS
                    (SELECT cod_plan,
                            fch_inicio,
                            ROW_NUMBER ()
                            OVER (PARTITION BY id_entidad_consumo
                                  ORDER BY fch_inicio DESC)
                                AS num
                     FROM tr_cambio_plan_historico
                     WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo)
            SELECT COUNT(1)
                INTO v_prepag_ant
            FROM base
            WHERE cod_plan = 'INTERPRE'
            AND num = 2;

               --Permanencia de 3 meses
            WITH
                base
                AS
                    (SELECT cod_plan,
                            fch_inicio,
                            ROW_NUMBER ()
                            OVER (PARTITION BY id_entidad_consumo
                                  ORDER BY fch_inicio DESC)
                                AS num
                     FROM tr_cambio_plan_historico
                     WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo)
            SELECT COUNT(1)
                INTO v_dummy
            FROM base
            WHERE num = 1
            AND TRUNC (MONTHS_BETWEEN (SYSDATE, fch_inicio)) >= 3;

            IF v_dummy = c_falso AND v_prepag_ant = c_falso THEN
                po_cod_err := 'PVT-6049'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambiar a este plan el cliente debe tener 3 meses con su plan actual.
                RAISE err_app;
            END IF;

        END IF;

        --VALIDACION CAMBIO HACIA ESTE PLAN rqx 458597
        IF pi_cod_plan = 'INTRESHI51' THEN

            --El plan actual debe ser un Mifi 3MB
            IF v_reg_entidad_consumo.cod_plan <> 'INTRESHIB3' THEN
                po_cod_err := 'PVT-6046'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan para este cliente.
                RAISE err_app;
            END IF;

            --El segmento del cliente debe ser Oro, Plantino, Plata
            SELECT COUNT(1)
                INTO v_dummy
            FROM cl_entidad_clasif
            WHERE id_entidad = TO_CHAR(v_reg_entidad_consumo.id_entidad_consumo)
            AND cod_entidad = 'CL_ENTIDAD_CONSUMO'
            AND cod_tipo_clasificacion IN ('A','B','C','AA')
            AND FCH_FIN > SYSDATE;

            IF v_dummy = c_falso THEN
                po_cod_err := 'PVT-6048'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambiar a este plan el cliente debe ser Oro, Plata o Platino.
                RAISE err_app;
            END IF;

            --viene de prepago
            WITH
                base
                AS
                    (SELECT cod_plan,
                            fch_inicio,
                            ROW_NUMBER ()
                            OVER (PARTITION BY id_entidad_consumo
                                  ORDER BY fch_inicio DESC)
                                AS num
                     FROM tr_cambio_plan_historico
                     WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo)
            SELECT COUNT(1)
                INTO v_prepag_ant
            FROM base
            WHERE cod_plan = 'INTERPRE'
            AND num = 2;

            --Permanencia de 3 meses
            WITH
                base
                AS
                    (SELECT cod_plan,
                            fch_inicio,
                            ROW_NUMBER ()
                            OVER (PARTITION BY id_entidad_consumo
                                  ORDER BY fch_inicio DESC)
                                AS num
                     FROM tr_cambio_plan_historico
                     WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo)
            SELECT COUNT(1)
                INTO v_dummy
            FROM base
            WHERE num = 1
            AND TRUNC (MONTHS_BETWEEN (SYSDATE, fch_inicio)) >= 3;

            IF v_dummy = c_falso AND v_prepag_ant = c_falso THEN
                po_cod_err := 'PVT-6049'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambiar a este plan el cliente debe tener 3 meses con su plan actual.
                RAISE err_app;
            END IF;

        END IF;

        --------------------------------------------------------
        -- INCICO - R-015015 -- Híbrido infinito Plus (Upgrade) ---
        --------------------------------------------------------

        IF pi_cod_plan = 'HIBPLUS485' THEN

            --El plan actual debe estar entre los planes :
            IF v_reg_entidad_consumo.cod_plan NOT IN (
                   'HIBESPXS',
                   'HIBESP299',
                   'HIBESP14',
                   'HIBPLUST1'
               ) THEN

                po_cod_err := 'PVT-6060'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitido este cambio de plan para este cliente.
                RAISE err_app;

            END IF;

            --El segmento del cliente debe ser Oro, Plantino, Plata
            SELECT COUNT(1)
                INTO v_dummy
            FROM cl_entidad_clasif
            WHERE id_entidad = TO_CHAR(v_reg_entidad_consumo.id_entidad_consumo)
            AND cod_entidad = 'CL_ENTIDAD_CONSUMO'
            AND cod_tipo_clasificacion IN ('A','B','C','AA','D')
            AND FCH_FIN > SYSDATE;

            IF v_dummy = c_falso THEN
                po_cod_err := 'PVT-6061'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambiar a este plan el cliente debe ser Oro, Plata o Platino.
                RAISE err_app;
            END IF;

        END IF;
       -- FIN - R-015015 -- Híbrido infinito Plus (Upgrade)

        IF v_cod_linea_negocio_anterior = c_linea_negocio_mifi
        THEN
             IF pi_id_prospecto_mig IS NOT NULL THEN
                IF v_reg_plan_anterior.cod_grupo_plan = v_reg_plan_nuevo.cod_grupo_plan
                THEN
                    po_cod_err := 'PVT-5207'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitida la migracion hacia el mismo grupo de plan.
                    RAISE err_app;
                END IF;
             END IF;
        END IF;

        IF v_cod_linea_negocio_anterior != c_linea_negocio_full
           AND v_reg_plan_nuevo.cod_grupo_plan IN (c_linea_negocio_full,
                                                   c_linea_negocio_hibrid_prepag
                                                  ) THEN
            po_cod_err := 'PVT-2176';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta permitida la migracion hacia la linea de negocio FULL.
            RAISE err_app;
        END IF;

        IF     (   v_cod_linea_negocio_anterior IN (c_linea_negocio_prepago, 'EXTERN')
                OR v_reg_plan_anterior.cod_grupo_plan = 'VEXPAN'
               )
           AND v_cod_linea_negocio_nuevo IN (c_linea_negocio_poscon,
                                             c_linea_negocio_hibrid_prepag,
                                             c_linea_negocio_fija
                                            ) THEN

            po_cod_err := 'PVT-5001'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al intentar buscar los datos del suscriptor en ciclo de vida.
            SELECT current_state
              INTO v_estado_pps
              FROM TABLE(tx_cl_lifecycle.get_subscriber_data(v_reg_entidad_consumo.id_entidad_consumo));

            IF v_estado_pps != '2' THEN
                po_cod_err := 'PVT-2177';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: el cliente debe estar en estatus activo en la plataforma prepago para poder migrar.
                RAISE err_app;
            END IF;
        END IF;

        -- MVNO
        IF    entidad_venta_valida (pi_id_entidad_venta, v_cod_linea_negocio_nuevo) = c_falso
           OR entidad_venta_valida (pi_id_entidad_venta, v_cod_linea_negocio_anterior) = c_falso THEN
            po_cod_err := 'PVT-2178';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN:  Su entidad de venta no puede realizar esta transaccion para esta linea de negocio
            RAISE err_app;
        END IF;

        IF es_entidad_venta_externa (pi_id_entidad_venta) = c_verdadero THEN
            po_cod_err := 'PVT-2179';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN:  Su entidad de venta no puede realizar esta transaccion
            RAISE err_app;
        END IF;

        --- MVNO

        -- inicio blackberry PHC
        -- VALIDACION DEL SERVICIO BB: EL NUEVO PLAN TIENE QUE TENER EL SERVICIO DISPONIBLE, CASO CONTRARIO 1RO TERMINAR EL SERVICIO,
        -- LUEGO REALIZAR EL CAMBIO DE PLAN.
        v_dummy                   := 0;

        BEGIN
            SELECT sec.cod_servicio
              INTO v_cod_servicio_bb
              FROM cl_servicio_entidad_consumo sec, bm_servicio bs
             WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
               AND sec.cod_servicio = bs.cod_servicio
               AND sec.estado = c_estado_activo
               AND v_fch_tran BETWEEN sec.fch_inicio AND sec.fch_fin
               AND bs.cod_tipo_servicio = 'BBDAT';

            v_dummy    := 1;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_dummy    := 0;
        END;

        -- estos servicios deben terminarse manualmente si no estan disponibles en el nuevo plan
        -- a menos que el nuevo plan sea un combo bb
        IF     v_dummy <> 0
           AND v_cod_servicio_bb IN ('BBPOS',
                                     'BBCOR',
                                     'BBHIB',
                                     'BBPOSN',
                                     'BBCORN',
                                     'BBHIBN',
                                     'BBPRE'
                                    ) THEN
            SELECT COUNT (*)
              INTO v_dummy
              FROM bm_plan_servicio ps
             WHERE ps.cod_plan = pi_cod_plan
               AND ps.cod_servicio IN (v_cod_servicio_bb, 'BBPLA', 'BBPLASOC')
               AND ps.fch_fin = c_fecha_fin
               AND ps.estado = c_estado_activo;

            IF v_dummy = 0 THEN
                po_cod_err := 'PVT-2180';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambiarse de un plan con servicio blackberry a otro que no tiene, primero debe terminar el servicio.
                RAISE err_app;
            END IF;
        END IF;

        -- verificar si tiene bb prepago
        SELECT COUNT (1)
          INTO v_tiene_bb_prepago
          FROM cl_entidad_consumo_bb
         WHERE cod_servicio = 'BBPRE'
           AND estado_bb IN ('A', 'S')
           AND fch_fin = c_fecha_fin
           AND id_entidad_consumo = pi_id_entidad_consumo;

        IF v_tiene_bb_prepago > 0 THEN
            -- migra hacia un plan que soporta el servicio prepago
            SELECT COUNT (*)
              INTO v_dummy
              FROM bm_plan_servicio ps
             WHERE ps.cod_plan = pi_cod_plan
               AND ps.cod_servicio = 'BBPRE'
               AND ps.fch_fin = c_fecha_fin
               AND ps.estado = c_estado_activo;

            IF v_dummy = 0 THEN
                po_cod_err := 'PVT-2181';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambiarse de un plan con servicio blackberry a otro que no tiene, primero debe terminar el servicio.
                RAISE err_app;
            END IF;
        END IF;

        -- final blackberry PHC

        -- INICIO: CAMBIO DE PLAN - PAQUETES ILIMITADOS
        -- Validacion del servicio paquetes ilimitados
        FOR ilim IN (SELECT sec.cod_servicio
                       --INTO v_cod_servicio_pi
                     FROM   cl_servicio_entidad_consumo sec, bm_servicio bs
                      WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                        AND sec.cod_servicio = bs.cod_servicio
                        AND sec.estado = c_estado_activo
                        AND v_fch_tran BETWEEN sec.fch_inicio AND sec.fch_fin
                        AND bs.cod_tipo_servicio = 'TSILI')
        LOOP
            IF v_cod_linea_negocio_nuevo <> v_cod_linea_negocio_anterior THEN
                po_cod_err := 'PVT-2182';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambio de plan o migracion, primero debe terminar el servicio de paquetes ilimitados.
                RAISE err_app;
            END IF;

            SELECT COUNT (*)
              INTO v_dummy
              FROM bm_plan_servicio ps
             WHERE ps.cod_plan = v_reg_plan_nuevo.cod_plan
               AND ps.cod_servicio = ilim.cod_servicio
               AND ps.fch_fin = c_fecha_fin
               AND ps.estado = c_estado_activo;


            SELECT COUNT(1)
                INTO v_es_mig_prepag_t
            FROM cnf_configuracion_especial
            WHERE NOMBRE_TABLA = 'BM_PLAN'
            AND TIPO = 'PLANES_MIGRACION_A_PREPAG_T'
            AND parametro_1 = 'A'
            AND cod_registro = v_reg_entidad_consumo.cod_plan  --plan actual
            AND parametro_2 = v_reg_plan_nuevo.cod_plan;

            IF v_dummy = 0 AND v_es_mig_prepag_t = c_falso THEN
                po_cod_err := 'PVT-2183';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambiarse de un plan con servicio de Paquetes Ilimitados a otro que no tiene, primero debe terminar el servicio.
                RAISE err_app;
            END IF;
        END LOOP;


        po_cod_err := 'PVT-6077'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No se pudo obtener el segmento de origen
        --Segmento origen
        SELECT seg_origen.cod_segmento, seg_origen.plan
        INTO v_cod_segmento_origen, v_name_plan_origen
        FROM omega.v_plan_segmento seg_origen
        WHERE seg_origen.cod_plan = v_reg_plan_anterior.cod_plan;
        po_cod_err := 'PVT-6078'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No se pudo obtener el segmento de destino
        --Segmento destino
        SELECT seg_destino.cod_segmento, seg_destino.plan
        INTO v_cod_segmento_destino, v_name_plan_destino
        FROM omega.v_plan_segmento seg_destino
        WHERE seg_destino.cod_plan = v_reg_plan_nuevo.cod_plan;

/*
        v_dummy := 0;
         BEGIN
             SELECT sec.cod_servicio
               INTO v_cod_servicio_pi
               FROM cl_servicio_entidad_consumo sec, bm_servicio bs
              WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                AND sec.cod_servicio = bs.cod_servicio
                AND sec.estado = c_estado_activo
                AND v_fch_tran BETWEEN sec.fch_inicio AND sec.fch_fin
                AND bs.cod_tipo_servicio = 'TSILI';

         EXCEPTION
             WHEN NO_DATA_FOUND THEN
                 v_cod_servicio_pi := NULL;
         END;

         -- Si se tiene el servicio activado
         IF v_cod_servicio_pi IS NOT NULL THEN
             IF v_cod_linea_negocio_nuevo <> v_cod_linea_negocio_anterior THEN
                 po_cod_err := 'PVT-2184';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambio de plan o migracion, primero debe terminar el servicio de paquetes ilimitados.
                 RAISE err_app;
             END IF;

             SELECT COUNT (*)
               INTO v_dummy
               FROM bm_plan_servicio ps
              WHERE ps.cod_plan = v_reg_plan_nuevo.cod_plan
                AND ps.cod_servicio = v_cod_servicio_pi
                AND ps.fch_fin = c_fecha_fin
                AND ps.estado = c_estado_activo;

             IF v_dummy = 0 THEN
                 po_cod_err := 'PVT-2185';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Para cambiarse de un plan con servicio de Paquetes Ilimitados a otro que no tiene, primero debe terminar el servicio.
                 RAISE err_app;
             END IF;
         END IF;
*/       -- FIN: CAMBIO DE PLAN - PAQUETES ILIMITADOS

        --VALIDACION PARA ENTIDADES DEALERS
        IF v_cod_tipo_entidad_venta_p IN ('TEVDLR', 'TEVMDL') THEN
            IF     v_cod_linea_negocio_anterior NOT IN
                                                    ('FIJA', 'FULL', 'POSCON', 'PREPAG', 'HIBRID','INTERM')
               AND v_cod_linea_negocio_nuevo NOT IN ('FIJA', 'FULL', 'POSCON', 'PREPAG', 'HIBRID','INTERM') THEN
                po_cod_err := 'PVT-2186';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: La transaccion no esta permitida para su entidad de venta
                RAISE err_app;
            ELSIF     v_cod_linea_negocio_anterior IN ('PREPAG', 'EXTERN')
                  AND v_cod_linea_negocio_nuevo IN ('PREPAG', 'EXTERN')
                  -- AND v_reg_plan_nuevo.cod_plan NOT IN ('PREPAGO_TU')
                  --  AND v_reg_plan_nuevo.cod_plan NOT IN ('PREPAGO_TU','PREPAGO_TU2','PREVIVA_TU')
                  AND plan_preg('origen', v_reg_plan_anterior.cod_plan) <> 1
                  AND plan_preg('destino', v_reg_plan_nuevo.cod_plan ) <> 1
                  THEN
                po_cod_err := 'PVT-2187';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: La transaccion de cambio plan entre prepagos no esta permitida para su entidad de venta
                RAISE err_app;
            ELSIF    v_reg_plan_anterior.cod_grupo_plan = 'POSDAT'
                  OR v_reg_plan_nuevo.cod_grupo_plan = 'POSDAT' THEN
                po_cod_err := 'PVT-2188';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: La transaccion de cambio plan a ese grupo plan no esta permitido
                RAISE err_app;
            END IF;
        END IF;

        IF     pi_master = c_verdadero
           AND pi_cod_plan LIKE 'FFA%'
           AND v_reg_plan_nuevo.es_principal = c_verdadero THEN
            SELECT COUNT (*)
              INTO v_principales
              FROM cl_entidad_consumo ec, bm_plan p
             WHERE ec.id_comunidad_facturante = v_reg_entidad_consumo.id_comunidad_facturante
               AND ec.cod_plan = p.cod_plan
               AND p.cod_grupo_plan LIKE 'FFA%'
               AND p.es_principal = c_verdadero
               AND ec.id_entidad_consumo != pi_id_entidad_consumo
               AND ec.estado NOT IN (c_estado_inactivo, 'TER');

            IF v_principales > 1 THEN
                po_cod_err := 'PVT-2189';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No puede existir mas de un plan principal en la cuenta.
                RAISE err_app;
            END IF;
        END IF;

        IF TRUNC (MONTHS_BETWEEN (v_fch_tran, v_reg_entidad_consumo.fch_creacion)) < 1
           AND v_reg_plan_anterior.cod_forma_consumo != c_forma_consumo_prepago
           AND v_reg_plan_anterior.cod_plan NOT IN('HIBESPXS','HIBESPS','HIBESPM','HIBESPXS20','HIBPLES3','HIBPLES4','HIBPLESP24')THEN
            po_cod_err := 'PVT-2190';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: el cliente debe tener minimo 1 mes para poder solicitar este cambio.
            RAISE err_app;
        END IF;

        -- verificar que no existan facturas en atraso (excepto en prepagos pues no hay facturas)
        IF v_cod_linea_negocio_anterior NOT IN (c_linea_negocio_prepago, 'EXTERN') THEN
            po_cod_err := 'PVT-2191';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: error al obtener los datos de la comunidad.

            SELECT c.cod_ciclo_facturacion,
                   c.id_cuenta_corriente
              INTO v_cod_ciclo_anterior,
                   v_id_cuenta_corriente
              FROM cl_entidad_consumo ec, cl_comunidad c
             WHERE ec.id_entidad_consumo = pi_id_entidad_consumo
               AND ec.id_comunidad_facturante = c.id_comunidad
               AND c.estado NOT IN (c_estado_inactivo, c_estado_terminado)
               AND ec.estado NOT IN (c_estado_inactivo, c_estado_terminado);

            po_cod_err := 'PVT-2192';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: error al obtener el periodo de facturacion vigente.
            v_reg_periodo_facturacion    :=
                                tx_tr_periodo_facturacion.get_periodo_vigente (v_cod_ciclo_anterior);
            po_cod_err := 'PVT-2193';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: error al obtener la factura pendiente.

            SELECT NVL (SUM (saldo), 0)
              INTO v_factura_atraso
              FROM cta_doc_cuenta_corriente a, cnf_cta_tipo_documento b
             WHERE a.id_cuenta_corriente = v_id_cuenta_corriente
               AND a.estado = c_edo_abierto
               AND a.saldo > 0
               AND a.fch_creacion < TRUNC (v_reg_periodo_facturacion.periodo_inicio)
               AND a.signo = '-1'
               AND a.cod_tipo_documento = b.cod_tipo_documento
               AND b.afecta_automatico = '1';

            IF v_factura_atraso > TO_NUMBER (c_deuda_minima) THEN
                po_cod_err := 'PVT-2194';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: el cliente solo puede tener una factura pendiente.
                RAISE err_app;
            END IF;
        END IF;

        IF NVL (v_reg_plan_nuevo.tarifa_basica, 0) > NVL (v_reg_plan_anterior.tarifa_basica, 0) THEN
            po_cod_err := 'PVT-2195';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al informacion del cliente.

            BEGIN
                SELECT p.nro_documento,
                       p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno as nombre_completo,
                       cod_tipo_documento
                  INTO v_nro_documento,
                       v_nombre_cliente,
                       v_cod_tipo_documento
                  FROM cl_datos_facturacion df, cl_persona p
                 WHERE df.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                   AND df.estado <> c_estado_inactivo
                   AND df.fch_fin = c_fecha_fin
                   AND p.id_persona = df.id_persona;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    SELECT p.nro_documento,
                           p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno as nombre_completo,
                           cod_tipo_documento
                      INTO v_nro_documento,
                           v_nombre_cliente,
                           v_cod_tipo_documento
                      FROM cl_cliente c, cl_persona p
                     WHERE c.id_cliente = get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante)
                       AND p.id_persona = c.id_persona;
                WHEN OTHERS THEN
                    v_nro_documento         := NULL;
                    v_cod_tipo_documento    := NULL;
            END;

            po_cod_err := 'PVT-2196';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al validar las cuentas del cliente en la empresa.
            tx_cl_cicla.valida_cuentas (pi_tipo_documento              => v_cod_tipo_documento,
                                        pi_nro_documento               => v_nro_documento,
                                        pi_cod_usuario                 => pi_cod_usuario,
                                        pi_id_tran                     => v_id_tran,
                                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                                        pi_fch_tran                    => v_fch_tran,
                                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                        po_cod_err                     => po_cod_err,
                                        po_msj_err                     => po_msj_err
                                       );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- para migrar hacia la linea de negocio hibrido prepago, el cliente debe tener balance cero
        --CVE: se agrega la linea de negocio FIJA.
        IF v_cod_linea_negocio_nuevo = c_linea_negocio_hibrid_prepag  OR v_cod_linea_negocio_nuevo = c_linea_negocio_fija THEN
            po_cod_err := 'PVT-2197';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: error al determinar la deuda de la cuenta.
            v_deuda_cuenta    := tx_cta_cuenta_corriente.get_deuda_total (v_id_cuenta_corriente);

            IF v_deuda_cuenta > TO_NUMBER (c_deuda_minima) THEN
                po_cod_err := 'PVT-2198';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: la cuenta tiene deuda pendiente.
                RAISE err_app;
            END IF;
        END IF;

        IF v_cod_segmento_origen = 'HIBRIDPRE'
        THEN
            tx_bl_facturador_individual.calcular_deuda_hibrido
            (pi_id_comunidad => v_reg_entidad_consumo.id_comunidad_facturante,
             pi_cod_usuario => pi_cod_usuario,
             pi_master => c_falso,
             pi_id_tran => v_id_tran,
             pi_cod_gestion_tran => v_cod_gestion_tran,
             pi_fch_tran => v_fch_tran,
             pi_cod_unidad_negocio => pi_cod_unidad_negocio,
             po_monto_vigente => v_dummy,
             po_saldo_vigente => v_deuda_vigente,
             po_cod_periodo_vigente => v_dummy,
             po_monto_futuro => v_dummy,
             po_saldo_futuro => v_dummy,
             po_cod_periodo_futuro => v_dummy,
             po_cod_err => po_cod_err,
             po_msj_err => po_msj_err
            );

            IF v_deuda_vigente > TO_NUMBER (c_deuda_minima) THEN
                po_cod_err := 'PVT-6232';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: la cuenta tiene deuda pendiente.
                RAISE err_app;
            END IF;
        END IF;

        v_con_contrato            := tx_subsidio.destino_tendra_contrato (pi_cod_plan,pi_con_contrato);

        IF NVL (pi_es_x_retencion, c_falso) = c_verdadero
        AND v_reg_plan_nuevo.cod_grupo_plan = c_grupo_plan_expansion THEN
            --Viva Mi Casa Prepago, Viva Mi Casa Prepago Lime (penalidad = 0)
            v_penalidad                             := NULL;
            v_penalidad.cod_tipo_documento          := c_tipo_doc_penalidad_plan;
            v_penalidad.id_cargo                    := c_id_cargo_penalidad_plan;
            v_penalidad.valor_simp                  := 0;
            v_penalidad.valor_cimp                  := 0;
            v_docs_penalidad (1)                    := v_penalidad;
        ELSIF v_reg_plan_nuevo.cod_grupo_plan IN ('PREPOR','PREPORC') THEN
            -- Portabilidad PostPago y Corporativo se factura en su proximo ciclo.
            v_penalidad                             := NULL;
            v_penalidad.cod_tipo_documento          := c_tipo_doc_penalidad_plan;
            v_penalidad.id_cargo                    := c_id_cargo_penalidad_plan;
            v_penalidad.valor_simp                  := 0;
            v_penalidad.valor_cimp                  := 0;
            v_docs_penalidad (1)                    := v_penalidad;
        ELSIF pi_cod_plan = 'HIBPLUS485' THEN
            -- R-015015 -- Híbrido infinito Plus (Upgrade)
            v_penalidad                             := NULL;
            v_penalidad.cod_tipo_documento          := c_tipo_doc_penalidad_plan;
            v_penalidad.id_cargo                    := c_id_cargo_penalidad_plan;
            v_penalidad.valor_simp                  := 0;
            v_penalidad.valor_cimp                  := 0;
            v_docs_penalidad (1)                    := v_penalidad;
        ELSE
            po_cod_err := 'PVT-2199';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al invocar al procedimiento TX_PVT_POLITICAS.SET_DEUDA_PENDIENTE.
            tx_pvt_politicas.set_deuda_pendiente
            (
                pi_cod_transaccion          => 'TX_TRAN_MIGRACION',
                pi_id_comunidad             => v_reg_entidad_consumo.id_comunidad_facturante,
                pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
                pi_cod_servicio             => c_srv_prepago,
                pi_cod_motivo               => NULL,
                pi_cod_segmento_destino     => NULL,
                pi_cod_plan_destino         => pi_cod_plan,
                po_cod_err                  => po_cod_err,
                po_msj_err                  => po_msj_err
            );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            IF pi_id_prospecto_mig IS NOT NULL THEN
                v_monto_deposito    := 0;
                BEGIN
                    SELECT SUM(NVL(t.valor_cimp,0))*(-1),NVL(t.po_cod_err,'OK')
                    INTO v_monto_deposito,po_cod_err
                    FROM vta_deuda_pendiente t
                    WHERE t.facturacion = 'CAJA'
                    AND t.tipo_registro = 'DEPOSITO_INICIAL'
                    AND t.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                    GROUP BY t.id_comunidad,t.po_cod_err;
                EXCEPTION
                    WHEN OTHERS THEN
                        v_monto_deposito    := 0;
                        po_cod_err          := 'OK';
                END;

                IF po_cod_err <> 'OK' THEN
                    po_cod_err := 'PVT-2200';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error durante el calculo del deposito.
                    RAISE err_app;
                END IF;
            ELSE
                v_monto_deposito    := 0;
            END IF;

            po_cod_err := 'PVT-2201';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al obtener la deuda pendiente del suscriptor.
            FOR c_deuda IN (SELECT t.tipo_registro
                                ,t.id_registro
                                ,t.cod_tipo_documento
                                ,c.id_cargo
                                ,t.valor_simp
                                ,t.valor_cimp
                                ,t.facturacion
                                ,t.po_cod_err
                                ,t.po_msj_err
                            FROM vta_deuda_pendiente t
                                LEFT JOIN cnf_cta_tipo_documento_cargo c
                                ON t.cod_tipo_documento = c.cod_tipo_documento
                                AND c.estado = c_estado_activo
                            WHERE t.facturacion NOT IN ('PROXIMO_CICLO','INFORMATIVO')
                            AND t.tipo_registro NOT IN ('CARGO_MORA')
                            AND t.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                            AND t.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                            )
            LOOP
                IF c_deuda.tipo_registro = 'PENALIDAD' THEN
                    v_subsidios(c_deuda.id_registro)    := t_subsidio(c_deuda.valor_simp,NULL,NULL);
                END IF;

                po_cod_err := 'PVT-2202';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al definir las penalidades.
                v_penalidad                             := NULL;
                v_penalidad.cod_tipo_documento          := c_deuda.cod_tipo_documento;
                v_penalidad.id_cargo                    := c_deuda.id_cargo;
                v_penalidad.valor_simp                  := ROUND(c_deuda.valor_simp,2);
                v_penalidad.valor_cimp                  := ROUND(c_deuda.valor_cimp,2);
                v_docs_penalidad (c_deuda.id_registro)  := v_penalidad;
            END LOOP;

            -- No existe penalidades (penalidad = 0).
            IF v_docs_penalidad.first IS NULL THEN
                v_penalidad                             := NULL;
                v_penalidad.cod_tipo_documento          := c_tipo_doc_penalidad_plan;
                v_penalidad.id_cargo                    := c_id_cargo_penalidad_plan;
                v_penalidad.valor_simp                  := 0;
                v_penalidad.valor_cimp                  := 0;
                v_docs_penalidad (1)                    := v_penalidad;
            END IF;
        END IF;

        --Puntos de Venta, Dealers
        IF (   (    v_cod_linea_negocio_nuevo NOT IN
                        (c_linea_negocio_poscon, c_linea_negocio_full,
                         c_linea_negocio_hibrid_prepag, 'INTERF')
                AND v_reg_plan_nuevo.cod_grupo_plan != c_grupo_plan_full_hogar
               )
            OR (    v_cod_tipo_entidad_venta_p IN ('TEVDLR', 'TEVMDL')
                AND v_reg_plan_nuevo.cod_grupo_plan NOT IN ('PRMBB', 'HIBRBB')
               )
           ) THEN
            IF (    (pi_master = c_verdadero OR v_cod_tipo_entidad_venta_p IN ('TEVDLR', 'TEVMDL')
                    )
                AND NVL (v_reg_plan_nuevo.tarifa_basica, 0) <
                                                          NVL (v_reg_plan_anterior.tarifa_basica, 0)
               ) THEN
                tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                           pi_cod_entidad                 => 'ESP_CAMBIO_PLAN_INFERIOR',
                                           pi_cod_usuario_tran            => pi_cod_usuario,
                                           po_permiso                     => v_permiso,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                IF v_permiso = c_falso THEN
                    po_cod_err := 'PVT-2203';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Permisos insuficientes.
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        -- prorrateo de la renta basica planes hibrido prepago y combos bb corporativo
        SELECT COUNT (1)
          INTO v_bb_control_empresarial
          FROM cnf_configuracion_especial cne, bm_plan p, bm_grupo_plan gp
         WHERE cne.nombre_tabla = 'BM_PLAN'
           AND cne.tipo = 'PLANES_BB_CONTROL'
           AND p.cod_plan IN (SELECT *
                                FROM TABLE (SELECT tx_utiles.SPLIT (cne.parametro_1)
                                              FROM DUAL))
           AND p.cod_grupo_plan = gp.cod_grupo_plan
           AND p.cod_plan = pi_cod_plan;

        IF    (v_cod_linea_negocio_nuevo IN (c_linea_negocio_hibrid_prepag, c_linea_negocio_full,c_linea_negocio_mifi) AND get_segmento(v_reg_plan_nuevo.cod_plan) NOT IN ('INTENEGHIB','INTNEGFULL'))
           OR v_bb_control_empresarial > 0 THEN
            po_cod_err := 'PVT-2204';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: error al obtener el nuevo ciclo de facturacion.

            IF pi_id_prospecto_mig IS NULL THEN
                SELECT c.cod_ciclo_facturacion
                  INTO v_cod_ciclo_nuevo
                  FROM cl_entidad_consumo ec, cl_comunidad c
                 WHERE ec.id_comunidad_facturante = c.id_comunidad
                   AND ec.id_entidad_consumo = pi_id_entidad_consumo
                   AND c.estado NOT IN (c_estado_inactivo, c_estado_terminado)
                   AND ec.estado NOT IN (c_estado_inactivo, c_estado_terminado);
            ELSE
                SELECT mc.cod_ciclo
                  INTO v_cod_ciclo_nuevo
                  FROM vta_migracion_comunidad mc
                 WHERE mc.id_prospecto = pi_id_prospecto_mig;
            END IF;

            BEGIN
                SELECT SUM (NVL (monto, 0))
                  INTO v_prorrateo_con_imp
                  FROM TABLE (tx_pvt_ccs.get_prorrateo_cambio_plan (pi_cod_plan, v_cod_ciclo_nuevo,
                                                                    v_reg_entidad_consumo.cod_plan));

            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_prorrateo_con_imp    := 0;
            END;


             IF FUNC_ES_EMPLEADO(v_reg_entidad_consumo.id_persona) = 1 THEN
               v_descuento_empleado := v_prorrateo_con_imp * tx_cnf_constante.get_constante('DESC_EMP_TELEMICRO');
               v_prorrateo_con_imp := v_prorrateo_con_imp - v_descuento_empleado;

             END IF;

        END IF;

        --INICIO
        --459835 Upgrade de Planes Vía Telefónica

         po_cod_err := 'PVT-6079'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No se pudo obtener el rol usuario
         --verificando si el usuario esta dentro de lrango de rol Supervisor Reclamaciones ( RLSURE01 ) y Represéntate Retención (RLRERE0)
         SELECT COUNT(1)
         INTO v_seg_rol_usuario_count
         FROM omega.seg_rol_usuario
         WHERE estado = 'A' AND
         cod_usuario = pi_cod_usuario AND
         cod_rol IN ( SELECT descripcion
            FROM cnf_catalogo
            WHERE cod_entidad = 'MAIL_MOD' );


         IF ( v_cod_segmento_origen = v_cod_segmento_destino AND
         v_cod_segmento_origen IN ('INTERESHIB','TVCABLEPOS') )
         AND es_upgrade_plan(v_reg_plan_anterior.cod_plan, v_reg_plan_nuevo.cod_plan) = 1
         AND v_seg_rol_usuario_count > 0
         THEN

            po_cod_err := 'PVT-6080'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo obtener el mensaje para el correo
            --Mensaje de mail
            SELECT descipcion
            INTO v_mail_upg_cambio
            FROM omega.cnf_configuracion_especial
            WHERE nombre_tabla = 'MAIL_MENSAJE_DISPATCHER'
            AND cod_registro = 'NOTFMAILUPPL';

            po_cod_err := 'PVT-6081'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo obtener el mensaje para el sms
            --INICIO: Enviando SMS
            SELECT descipcion
            INTO v_sms_mensaje
            FROM omega.cnf_configuracion_especial
            WHERE nombre_tabla = 'MAIL_MENSAJE_DISPATCHER'
            AND tipo = 'TEXT_SMS_UPG_PLAN'
            AND cod_registro = 'NOTFSMSUPPL';

            po_cod_err := 'PVT-6082'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo setear los valores para el sms
            --Remplazando textto de sms
            v_sms_mensaje := REPLACE(v_sms_mensaje, '{name_plan_origen}', v_name_plan_origen ); --nombre cliente
            v_sms_mensaje := REPLACE(v_sms_mensaje, '{name_plan_destino}', v_name_plan_destino ); --cedula
            v_sms_mensaje := REPLACE(v_sms_mensaje, '{fecha}', TO_CHAR( v_fch_tran, 'DD/MM/YY') ); --fecha de activacion
            v_sms_mensaje := REPLACE(v_sms_mensaje, '{nuevo_tarifa_basica}', v_reg_plan_nuevo.tarifa_basica ); --fecha de solicitud

            FOR sms IN (
             SELECT ec.identificador_entidad,
                    p.id_persona
            FROM omega.cl_entidad_consumo ec
            INNER JOIN omega.cl_persona p ON p.id_persona = ec.id_persona
            AND p.nro_documento = v_nro_documento
            AND p.cod_tipo_documento = 'CI'
            WHERE ec.estado not in ('I','TER','POST'))
            LOOP

                po_cod_err := 'PVT-6083'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo enviar el sms
                --Enviar SMS
                tx_sms.alta (pi_origen                      => 23,
                             pi_destino                     => sms.identificador_entidad,
                             pi_texto                       => v_sms_mensaje,
                             pi_prioridad                   => 1,
                             pi_programado                  => v_fch_tran,
                             pi_id_tran                     => v_id_tran,
                             pi_fch_tran                    => v_fch_tran,
                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                             pi_cod_usuario                 => pi_cod_usuario,
                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                             pi_master                      => c_falso,
                             po_id_sms                      => v_id_mensaje,
                             po_cod_err                     => po_cod_err,
                             po_msj_err                     => po_msj_err);

                    IF po_cod_err != 'OK' THEN
                        RAISE err_app;
                    END IF;

            END LOOP;

            --Enviar Mail

            BEGIN

                --Obteniendo el mail del cliente
                --po_cod_err := 'PVT-6084'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo obtener el correo del cliente
                SELECT cp.valor
                INTO v_mail_cliente
                FROM cl_datos_facturacion fc
                INNER JOIN omega.cl_persona_dato cp ON cp.id_persona = fc.id_persona
                AND cp.cod_tipo_dato = 'TDCELE'
                AND cp.estado = 'A'
                AND cp.fch_fin > sysdate
                WHERE fc.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                AND ROWNUM <= 1;

            EXCEPTION
                WHEN OTHERS THEN

                v_mail_cliente := null;

            END;

            --obteniendo el nombre del usuario que esta realizando la transaccion
            po_cod_err := 'PVT-6085'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo obtener el nombre del cliente
            SELECT sp.nombres
            INTO v_nombre_usuario
            FROM seg_usuario su
            INNER JOIN seg_personal sp on sp.cod_personal = su.cod_personal
            WHERE su.cod_usuario = pi_cod_usuario
            AND su.estado = 'A';

            po_cod_err := 'PVT-6086'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo setear los valores para el mail
            --Cambiando los metadatos del correo
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{nombre_cliente}', v_nombre_cliente ); --nombre cliente
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{cedula}', v_nro_documento ); --cedula
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{fecha_activacion}', TO_CHAR( v_reg_entidad_consumo.fch_creacion, 'DD/MM/YY') ); --fecha de activacion
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{fecha_solicitud}', TO_CHAR( v_fch_tran, 'DD/MM/YY') ); --fecha de solicitud
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{numero_cuenta}', v_reg_entidad_consumo.id_comunidad_facturante  ); --numero de cuenta
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{numero}', v_reg_entidad_consumo.identificador_entidad ); --numero
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{plan_anterior}', v_name_plan_origen ); --plan anterior
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{renta_anterior}', v_reg_plan_anterior.tarifa_basica ); --renta anterior
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{nuevo_plan}', v_name_plan_destino ); --nuevo plan
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{nueva_renta}', v_reg_plan_nuevo.tarifa_basica ); --nueva renta
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{penalidad_cargos}', 0 ); --penalidad cargo
            v_mail_upg_cambio := REPLACE(v_mail_upg_cambio, '{nombre_usuario}', v_nombre_usuario ); --nombre del representante

            v_mail_upg_cambio := substr(v_mail_upg_cambio, 1, 2000); --limitando v_mail_upg_cambio a 2000 caracteres porque la funcion utl_i18n.string_to_raw soporta maximo 2000 caracteres.

            po_cod_err := 'PVT-6087'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo dar de alta al documento
            --Dando de alta al archivo
            tx_cl_documentos.alta_documento (
                -- Input parameters
                pi_id_comunidad           => v_reg_entidad_consumo.id_comunidad_facturante,
                pi_content_type           => 'text/html',
                pi_nombre                 => 'CP_' || v_reg_plan_anterior.cod_plan || '_' || v_reg_plan_nuevo.cod_plan || '.html',
                pi_tamano                 => LENGTH(v_mail_upg_cambio),
                pi_estado                 => 'A',
                pi_cod_usuario            => pi_cod_usuario,
                pi_master                 => c_falso,
                pi_id_tran                => v_id_tran,
                pi_cod_gestion_tran       => v_cod_gestion_tran,
                pi_fch_tran               => v_fch_tran,
                pi_cod_unidad_negocio     => pi_cod_unidad_negocio,
                -- Output parameters
                po_id_archivo             => v_id_archivo,
                po_cod_err                => po_cod_err,
                po_msj_err                => po_msj_err
            );

             IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-6088'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo actualizar el archivo
            UPDATE cl_archivo SET archivo = utl_i18n.string_to_raw( v_mail_upg_cambio )
            WHERE id_archivo = v_id_archivo;

            IF v_mail_cliente IS NOT NULL THEN

                po_cod_err := 'PVT-6089'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: no se pudo enviar el mail
                tx_mail_mensaje.alta (pi_id_origen   => NULL,
                      pi_id_documento                => NULL,
                      pi_to                          => v_mail_cliente,
                      pi_subject                     => 'Solicitud de Cambio de Plan',
                      pi_body                        => v_mail_upg_cambio,
                      pi_attach_file                 => NULL,
                      pi_fecha_programado            => v_fch_tran,
                      pi_cod_usuario                 => pi_cod_usuario,
                      pi_master                      => c_falso,
                      pi_id_tran                     => v_id_tran,
                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                      pi_fch_tran                    => v_fch_tran,
                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                      po_id_mail                     => v_id_mensaje,
                      po_cod_err                     => po_cod_err,
                      po_msj_err                     => po_msj_err
                     );

                IF po_cod_err != 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;

            ----FIN Enviar Mail


         --Seteando el prorrateo 0
         v_prorrateo_con_imp    := 0;

         ELSIF ( v_cod_segmento_origen = v_cod_segmento_destino AND
         v_cod_segmento_origen IN ('INTERESHIB','TVCABLEPOS') )
         AND es_upgrade_plan(v_reg_plan_anterior.cod_plan, v_reg_plan_nuevo.cod_plan) = 0
         AND v_seg_rol_usuario_count > 0 THEN

            po_cod_err := 'PVT-6090'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: El Rol no tienen permitido hacer éste cambio de plan.

            RAISE err_app;


         END IF;

         --459835 Upgrade de Planes Vía Telefónica
         --FIN

        -- EN este punto tenemos v_prorrateo_con_imp y v_precio_venta_con_imp
        po_cod_err := 'PVT-2205';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al registrar la entidad de venta relacionada.
        cc_vta_venta_entidad.alta (pio_id_prospecto               => v_id_prospecto,
                                   pi_cod_tipo_venta              => 'TV_CAMBIO_PLAN',
                                   pi_id_entidad_venta            => pi_id_entidad_venta,
                                   pi_cod_usuario_asignado        => pi_cod_usuario_asignado,
                                   pi_cod_usuario_digitador       => pi_cod_usuario,
                                   pi_fch_venta                   => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_id_venta_entidad            => v_id_venta_entidad,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        IF pi_id_prospecto_mig IS NULL THEN
            po_cod_err := 'PVT-2206';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al obtener un id_venta

            SELECT sq_vta_venta_pros.NEXTVAL
              INTO v_id_venta
              FROM DUAL;

            v_id_prospecto_main    := v_id_prospecto;
            v_id_venta_main        := v_id_venta;
        ELSE
            v_id_prospecto_main    := pi_id_prospecto_mig;
            v_id_venta_main        := pi_id_venta_mig;
        END IF;

        v_monto                   := 0;
        v_monto_con_imp           := 0;
        -- registrar la afectacion de subsidios
        v_subs                    := v_subsidios.FIRST;

        WHILE v_subs IS NOT NULL
        LOOP
            po_cod_err := 'PVT-2207';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al registrar el detalle de subsidios
            tx_subsidio.registrar_pago_subsidio (pi_id_prospecto                => v_id_prospecto_main,
                                                 pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                 pi_id_subsidio                 => v_subs,
                                                 pi_monto                       => v_subsidios
                                                                                             (v_subs)
                                                                                                 (1),   -- penalidad
                                                 pi_nuevo_subsidio              => v_subsidios
                                                                                             (v_subs)
                                                                                                 (2),
                                                 pi_nueva_vigencia              => v_subsidios
                                                                                             (v_subs)
                                                                                                 (3),
                                                 pi_id_prospecto_cp             => v_id_prospecto,
                                                 pi_cod_usuario                 => pi_cod_usuario,
                                                 pi_master                      => c_falso,
                                                 pi_id_tran                     => v_id_tran,
                                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                 pi_fch_tran                    => v_fch_tran,
                                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                 po_cod_err                     => po_cod_err,
                                                 po_msj_err                     => po_msj_err
                                                );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            v_subs        := v_subsidios.NEXT (v_subs);
        END LOOP;

        -- registramos detalles de penalidad
        v_doc                     := v_docs_penalidad.first;

        po_cod_err := 'PVT-2208';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al obtener el segmento del plan.
        v_cod_segmento_nuevo      := get_segmento(pi_cod_plan);

        IF pi_id_prospecto_mig IS NOT NULL AND v_cod_segmento_nuevo IN ('PREPAGO','CASPRE') THEN
            v_monto_deposito    :=  NVL(tx_pvt_comunidad.get_deposito_pendiente(v_reg_entidad_consumo.id_comunidad_facturante),0);

            IF v_monto_deposito > 0 THEN

                po_cod_err := 'PVT-5251';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: error al determinar la deuda de la cuenta.
                v_id_cuenta_corriente   :=  get_id_cc(v_reg_entidad_consumo.id_comunidad_facturante);
                v_deuda_cuenta          :=  tx_cta_cuenta_corriente.get_deuda_total (v_id_cuenta_corriente);
                v_monto_deposito        :=  ROUND (v_monto_deposito -  v_deuda_cuenta,2);
            END IF;

        ELSE
            v_monto_deposito    :=  0;
        END IF;

        WHILE v_doc IS NOT NULL
        LOOP
            v_precio_venta_sin_imp  := v_docs_penalidad (v_doc).valor_simp;
            v_monto_descuento       := 0;
            v_monto_descuento_imp   := 0;

            IF v_monto_deposito > 0 THEN
                BEGIN
                    BEGIN
                        SELECT (1+(NVL(SUM(i.valor_porcentual),0)/100))
                        INTO v_impuestos
                        FROM bl_cargo_impuesto ci
                            ,bl_impuesto i
                        WHERE ci.id_cargo_impuesto = v_docs_penalidad (v_doc).id_cargo
                        AND i.cod_impuesto = ci.cod_impuesto
                        AND ci.estado = 'A';
                    EXCEPTION
                        WHEN OTHERS THEN
                            v_impuestos := 1.18;
                    END;

                    SELECT NVL(SUM(deposito_simp),0)*v_impuestos
                        INTO v_monto_descuento
                    FROM vta_prospecto_deposito
                    WHERE id_prospecto = v_id_prospecto_main;

                    v_monto_deposito_tmp    := v_monto_deposito - v_monto_descuento;
                    IF v_monto_deposito_tmp < 0.99 THEN
                        v_monto_descuento       := 0;
                        v_monto_descuento_imp   := 0;
                    ELSE
                       IF v_monto_deposito_tmp >= v_docs_penalidad (v_doc).valor_cimp THEN
                           v_monto_descuento       := v_precio_venta_sin_imp;
                           v_monto_descuento_imp   := v_precio_venta_sin_imp*v_impuestos;
                       ELSE
                           v_monto_descuento       := v_monto_deposito_tmp/v_impuestos;
                           v_monto_descuento_imp   := v_monto_deposito_tmp;
                       END IF;
                    END IF;
                EXCEPTION
                    WHEN OTHERS THEN
                        v_monto_descuento       := 0;
                        v_monto_descuento_imp   := 0;
                END;
            END IF;


            po_cod_err := 'PVT-2209';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al registrar el detalle de penalidad
            tx_pvt_ccs.alta_venta_detalle (pio_id_venta                   => v_id_venta_main,
                                           pi_id_prospecto                => v_id_prospecto_main,
                                           pi_id_cargo                    => v_docs_penalidad (v_doc).id_cargo,
                                           pi_cod_tipo_documento          => v_docs_penalidad (v_doc).cod_tipo_documento,
                                           pi_valor_venta                 => v_precio_venta_sin_imp,
                                           pi_valor_descuento             => 0,--v_monto_descuento,
                                           pi_id_prospecto_ec             => v_id_prospecto,
                                           pi_cod_tipo                    => 'C',
                                           pi_estado                      => c_estado_activo,
                                           pi_cod_usuario                 => pi_cod_usuario,
                                           pi_master                      => c_falso,
                                           pi_id_tran                     => v_id_tran,
                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                           pi_fch_tran                    => v_fch_tran,
                                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                           po_valor                       => v_precio_venta_con_imp,
                                           po_id_prospecto_detalle        => v_id_prospecto_detalle,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            IF v_monto_descuento > 0 THEN
                 po_cod_err := 'PVT-2210';   --TX_PVT_ENTIDAD.SUSPENSION_ENTIDAD: Error al registrar el descuento por deposito.
                 tx_vta_prospecto_deposito.alta(
                     pi_id_prospecto             => v_id_prospecto_main,
                     pi_id_prospecto_detalle     => v_id_prospecto_detalle,
                     pi_valor_simp               => v_precio_venta_sin_imp,
                     pi_deposito_simp            => v_monto_descuento,
                     pi_valor_cimp               => v_precio_venta_con_imp,
                     pi_deposito_cimp            => v_monto_descuento_imp,
                     pi_cod_usuario              => pi_cod_usuario,
                     pi_master                   => c_falso,
                     pi_id_tran                  => v_id_tran,
                     pi_fch_tran                 => v_fch_tran,
                     pi_cod_gestion_tran         => v_cod_gestion_tran,
                     pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                     po_id_registro              => v_id_registro_dpt,
                     po_id_tran                  => po_id_tran,
                     po_fch_tran                 => po_fch_tran,
                     po_cod_err                  => po_cod_err,
                     po_msj_err                  => po_msj_err
                 );

                 IF po_cod_err != 'OK' THEN
                     RAISE err_app;
                 END IF;
             END IF;
            v_doc                     := v_docs_penalidad.NEXT (v_doc);
        END LOOP;

        IF v_prorrateo_con_imp > 0 OR pi_cod_plan = 'HIBPLUS485' THEN
            po_cod_err := 'PVT-2211';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al registrar el detalle del prorateo del plan
            tx_pvt_ccs.alta_venta_detalle (pio_id_venta                   => v_id_venta_main,
                                           pi_id_prospecto                => v_id_prospecto_main,
                                           pi_id_cargo                    => c_id_cargo_prorrateo_plan,
                                           pi_cod_tipo_documento          => c_tipo_doc_prorrateo_plan,
                                           pi_valor                       => v_prorrateo_con_imp,
                                           pi_id_prospecto_ec             => v_id_prospecto,
                                           pi_cod_tipo                    => 'C',
                                           pi_estado                      => c_estado_activo,
                                           pi_cod_usuario                 => pi_cod_usuario,
                                           pi_master                      => c_falso,
                                           pi_id_tran                     => v_id_tran,
                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                           pi_fch_tran                    => v_fch_tran,
                                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                           po_valor                       => v_prorrateo_con_imp,
                                           po_id_prospecto_detalle        => v_id_prospecto_detalle,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        IF pi_id_prospecto_mig IS NULL THEN
            --CREACION DEL PROSPECTO DE VENTA DEL ARTICULO ---------------------------------------------------
            BEGIN
                po_cod_err := 'PVT-2212';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al recuperar el RNC y nombre a facturar.

                SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                       p.nit
                  INTO v_nombre_factura,
                       v_rnc_factura
                  FROM cl_persona p, cl_datos_facturacion df
                 WHERE df.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                   AND df.id_persona = p.id_persona
                   AND df.estado <> c_estado_inactivo
                   AND df.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    NULL;
            END;

            po_cod_err := 'PVT-2213';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al invocar al procedimiento TX_BL_DOSIFICACION.GET_COD_CATEGORIA_DOCUMENTO.
            tx_bl_dosificacion.get_cod_categoria_documento
                                  (pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   po_cod_categoria_documento     => v_cod_categoria_documento,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err);

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2214';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al invocar al procedimiento de registro del prospecto de venta.
            tx_pvt_ccs.alta_venta (pi_id_prospecto                => v_id_prospecto,
                                   pi_nombre_factura              => v_nombre_factura,
                                   pi_nit                         => v_rnc_factura,
                                   pi_cod_categoria_documento     => v_cod_categoria_documento,
                                   pi_estado                      => c_estado_activo,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_master                      => c_falso,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_valor                       => v_monto_con_imp,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2215';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al recuperar el monto de venta sin impuestos

            SELECT valor
              INTO v_monto
              FROM vta_venta_prospecto
             WHERE id_prospecto = v_id_prospecto;
        ELSE
            po_cod_err := 'PVT-2216';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al sumarizar el detalle de venta

            SELECT ROUND (SUM (valor_venta), 2),
                   ROUND (SUM (valor), 2)
              INTO v_monto,
                   v_monto_con_imp
              FROM vta_venta_prospecto_detalle
             WHERE id_prospecto = v_id_prospecto_main AND id_prospecto_ec = v_id_prospecto;


             SELECT ROUND (SUM (valor_venta), 2),
                   ROUND (SUM (valor), 2)
              INTO v_monto,
                   v_monto_con_imp
              FROM vta_venta_prospecto_detalle
             WHERE id_prospecto = v_id_prospecto_main AND id_prospecto_ec = v_id_prospecto;
        END IF;

        --RQx - 458931: Cambio de Plan prepago se queda ciclo 0 - INICIO--
        IF v_cod_segmento_nuevo NOT IN ('PREPAGO','CASPRE','INTERMVPRE') AND pi_cod_ciclo_facturacion IS NOT NULL THEN
            --Cambiar ciclo de prepago si el nuevo plan es facturable
            po_cod_err := 'PVT-6074';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al establecer el ciclo de facturacion.
            SELECT cod_ciclo_facturacion
            INTO v_cod_ciclo
            FROM cl_comunidad
            WHERE id_comunidad=v_reg_entidad_consumo.id_comunidad_facturante;

            --Contar entidades prepago, si tiene entidades prepago en la comunidad debe realizar split de cuenta
            po_cod_err := 'PVT-6076';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: La cuenta del cliente presenta otras entidades prepago, debe de realizar un split de cuenta para cambiar de plan.
            SELECT COUNT(1)
            INTO v_dummy
            FROM cl_entidad_consumo ec, v_plan_segmento ps
            WHERE ec.cod_plan=ps.cod_plan
            AND ec.id_comunidad_facturante=v_reg_entidad_consumo.id_comunidad_facturante
            AND ec.estado NOT IN ('I','TER','POST')
            AND ps.cod_segmento IN ('PREPAGO','CASPRE','INTERMVPRE');

            IF v_dummy > 1 THEN
                RAISE err_app;
            END IF;

            IF v_cod_ciclo = '0' AND pi_cod_ciclo_facturacion <> v_cod_ciclo AND v_dummy = 1  THEN
                po_cod_err := 'PVT-6075';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al realizar cambio de ciclo.
                tx_pvt_comunidad.cambio_ciclo_facturacion
                                  (pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_cod_ciclo_facturacion       => pi_cod_ciclo_facturacion,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_master                      => c_falso,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran, --v_fch_inicio_vigencia,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_id_tran                     => po_id_tran,
                                   po_cod_gestion_tran            => po_cod_gestion_tran,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;
        --RQx - 458931: Cambio de Plan prepago se queda ciclo 0 - FIN--

        po_cod_err := 'PVT-2217';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al invocar a CC_VTA_CAMBIO_PLAN.ALTA
        cc_vta_cambio_plan.alta (pi_id_prospecto_mig            => pi_id_prospecto_mig,
                                 pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                 pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                 pi_cod_plan                    => pi_cod_plan,
                                 pi_cod_plan_anterior           => v_reg_entidad_consumo.cod_plan,
                                 pi_precio_venta                => v_monto,
                                 pi_es_pago_diferido            => pi_es_pago_diferido,
                                 pi_es_x_retencion              => pi_es_x_retencion,
                                 pi_con_contrato                => v_con_contrato,
                                 pi_id_entidad_venta            => pi_id_entidad_venta,
                                 pi_cod_usuario_asignado        => pi_cod_usuario_asignado,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 pio_id_prospecto               => v_id_prospecto,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;
   --------------------------------------------------------------------------------------------------------
-- RQx #3091. Promo Navidad para Internet Movil (EVDO-InterJet).
-- Oleksandr Ktravets fue lo agrego 25/10/2011 4:00pm.
-- conservacion los numeros validos para el promo
        BEGIN
            rqx3091_validacion_migrantes
                           (p_cod_plan_act                 => v_reg_entidad_consumo.cod_plan,
                            p_cod_plan_nuevo               => pi_cod_plan,
                            p_id_entidad_consumo           => pi_id_entidad_consumo,
                            p_identificador_entidad        => v_reg_entidad_consumo.identificador_entidad,
                            pi_id_tran                     => pi_id_tran,
                            pi_fch_tran                    => pi_fch_tran,
                            pi_cod_gestion_tran            => pi_cod_gestion_tran,
                            pi_cod_usuario                 => pi_cod_usuario,
                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                            pi_master                      => pi_master,
                            po_cod_err                     => po_cod_err,
                            po_msj_err                     => po_msj_err
                           );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END;

--INICIO 459835

-- End of RQx #3091.
--------------------------------------------------------------------------------------------------------
        IF pi_id_prospecto_mig IS NULL AND (v_monto_con_imp = 0 OR NVL (pi_es_pago_diferido, c_falso) = c_verdadero OR pi_cod_plan = 'HIBPLUS485') THEN


       --- esto planes no deben pasar por caja
        SELECT COUNT(1)
         INTO v_segmento_no_requiere_firma
          FROM cnf_configuracion_especial
          WHERE nombre_tabla = 'VTA_CAMBIO_PLAN'
          AND tipo = 'FIRMADOCUMENTO'
          AND nombre_1 = 'SEGMENTO'
          AND (parametro_1 = get_segmento(v_reg_plan_anterior.cod_plan)
           OR parametro_2 = v_reg_plan_anterior.cod_plan);


           IF v_segmento_no_requiere_firma > 0 OR v_id_entidad_venta_padre = 94  OR v_id_entidad_venta_padre = 42950 OR v_id_entidad_venta_padre = 23384 OR pi_cod_plan = 'HIBPLUS485' THEN
             po_cod_err := 'PVT-2218';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al invocar al proc. de consolidacion de venta de equipo con monto 0.
             tx_int_cliente_caja.consolidar_venta_prospecto
                                                    (pi_id_venta                    => v_id_venta,
                                                     pi_ncf                         => NULL,
                                                     pi_nro_pag_ext                 => NULL,
                                                     pi_cod_usuario                 => pi_cod_usuario,
                                                     pi_master                      => c_falso,
                                                     pi_id_tran                     => v_id_tran,
                                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                     pi_fch_tran                    => v_fch_tran,
                                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                     po_id_tran                     => po_id_tran,
                                                     po_cod_gestion_tran            => po_cod_gestion_tran,
                                                     po_cod_err                     => po_cod_err,
                                                     po_msj_err                     => po_msj_err
                                                    );

             IF po_cod_err <> 'OK' THEN
                 RAISE err_app;
             END IF;
         END IF;

            --RQX 454244 - Cambio políticas cambio y migración de plan - algunas tareas de migración se traen al cambio de plan - INICIO
            IF v_cod_segmento_nuevo in ('PREPAGO','CASPRE','INTERMVPRE') THEN --solo si se migra hacia prepago o fijo prepago, o internet prepago

                po_cod_err := 'PVT-6037';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al establecer el ciclo de facturacion.
                --Cambiar de ciclo a prepago si no lo es
                SELECT cod_ciclo_facturacion
                INTO v_cod_ciclo
                FROM cl_comunidad
                WHERE id_comunidad=v_reg_entidad_consumo.id_comunidad_facturante;

                --Contar entidades no prepago, si todos son prepago cambiar de ciclo
                SELECT COUNT(1) INTO v_dummy
                FROM cl_entidad_consumo ec, v_plan_segmento ps
                WHERE ec.cod_plan=ps.cod_plan
                AND ec.id_comunidad_facturante=v_reg_entidad_consumo.id_comunidad_facturante
                AND ec.id_entidad_consumo<>pi_id_entidad_consumo
                AND ec.estado NOT IN ('I','TER','POST')
                AND ps.cod_segmento NOT IN ('PREPAGO','CASPRE','INTERMVPRE');

                IF v_cod_ciclo<>'0' AND v_dummy=0 THEN
                    po_cod_err := 'PVT-6038';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al realizar cambio de ciclo.
                    tx_pvt_comunidad.cambio_ciclo_facturacion
                                      (pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                       pi_cod_ciclo_facturacion       => '0', --ciclo prepago
                                       pi_cod_usuario                 => pi_cod_usuario,
                                       pi_master                      => c_falso,
                                       pi_id_tran                     => v_id_tran,
                                       pi_cod_gestion_tran            => v_cod_gestion_tran,
                                       pi_fch_tran                    => v_fch_tran, --v_fch_inicio_vigencia,
                                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                       po_id_tran                     => po_id_tran,
                                       po_cod_gestion_tran            => po_cod_gestion_tran,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );
                    IF (po_cod_err <> 'OK') THEN
                        RAISE err_app;
                    END IF;
                END IF;

                /* COMENZANDO RQX 5009*/
                -- viendo si aplica para entrar al rqx 5009 -- cambio automatico de fondo del corebalance a otro bolsillo
                po_cod_err := 'PVT-6039';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al intentar validar si el numero aplica para cambio automatico de fondo de bolsillo.
                SELECT COUNT(1)
                  INTO v_plan_migracion_prepag
                  FROM cnf_configuracion_especial
                 WHERE cod_registro = v_reg_entidad_consumo.cod_plan
                   AND nombre_1 = 'COD_PLAN'
                   AND parametro_1 = v_reg_entidad_consumo.cod_plan
                   AND nombre_2 = 'ESTADO'
                   AND parametro_2 = 'A'
                   AND nombre_3 = 'SEGMENTO_CAMBIO_PLAN'
                   AND parametro_3 = (SELECT cod_segmento
                                       FROM bm_plan_segmento
                                      WHERE cod_plan = pi_cod_plan
                                        AND estado = 'A');

                IF v_plan_migracion_prepag >= 1 THEN -- validacion si plan esta dentro de los hibrid o full y si migra a un prepago.

                    -- validacion de recarga de 100
                    po_cod_err := 'PVT-6040';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error el cliente debe tener una recarga de 100 o mas el dia de hoy para hacer el cambio de plan.
                    SELECT NVL(MAX(monto),0)
                      INTO v_monto_recarga
                      FROM air_recarga
                     WHERE id_entidad_consumo  =  v_reg_entidad_consumo.id_entidad_consumo
                       AND estado = c_estado_activo
                       AND fch_recarga >= TRUNC(SYSDATE);

                    IF v_monto_recarga < 100 THEN -- validacion si el numero tiene una recarga de 100 o mayor.
                        po_cod_err := 'PVT-6041';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error el cliente debe tener una recarga de 100 o mas el dia de hoy para hacer el cambio de plan.
                        RAISE err_app;
                    END IF;

                    FOR bolsillos IN (SELECT parametro_4 AS bolsillo_id , parametro_5 AS monto_tarifa_x_migracion, parametro_6 AS tipo_unidad
                                        FROM cnf_configuracion_especial
                                       WHERE tipo = 'PLANES_MIGRACION_A_PREPAGO'
                                         AND nombre_1 = 'COD_PLAN'
                                         AND parametro_1 = v_reg_entidad_consumo.cod_plan
                                         AND nombre_2 = 'ESTADO'
                                         AND parametro_2 = 'A'
                                      )
                    LOOP
                        IF bolsillos.bolsillo_id IS NULL THEN
                            po_cod_err := 'PVT-6042';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error el obtener bolsillo para cambio de plan.
                            RAISE err_app;
                        END IF;

                        --Obteniendo bolsillo de Ericsson
                        v_bolsillos_cs := tx_ecms.get_C1toEcms(bolsillos.bolsillo_id);

                        /*po_cod_err := 'PVT-6043';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al obtener el balance de la TX_ECMS.GET_DATOS_BALANCE.
                        tx_ecms.get_datos_balance (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                                   pi_balance_id                  => v_bolsillos_cs.cod_bolsillo_ecms,
                                                   po_monto                       => v_core_balance_monto,
                                                   po_fecha                       => v_core_balance_fch_vigencia,
                                                   po_cod_err                     => po_cod_err,
                                                   po_msj_err                     => po_msj_err
                                                  );
                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;*/
                        po_cod_err := 'PVT-6043';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al obtener el balance de la TX_ECMS.GET_DATOS_BALANCE.
                        tx_air.getsubscriberbalance(
                                    pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
                                    pi_balanceid                => bolsillos.bolsillo_id,
                                    po_balance                  => v_core_balance_monto,
                                    po_expiraction_date         => v_core_balance_fch_vigencia,
                                    po_balance_info             => v_balances_pps,
                                    po_cod_err                  => po_cod_err,
                                    po_msj_err                  => po_msj_err);

                        IF po_cod_err NOT IN ('OK','AIR-0047') THEN
                            RAISE err_app;
                        END IF;
                        v_core_balance_monto    :=  NVL(v_core_balance_monto,0);
                        IF bolsillos.monto_tarifa_x_migracion IS NOT NULL AND bolsillos.tipo_unidad = 'SEGUNDO' THEN
                            v_core_balance_monto:= v_core_balance_monto * bolsillos.monto_tarifa_x_migracion;
                        ELSIF bolsillos.tipo_unidad = 'SEGUNDO' AND bolsillos.monto_tarifa_x_migracion IS NULL THEN
                            po_cod_err := 'PVT-6044';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error si el bolsillo esta en segundos debe colocar el monto de la tarifa en segundos.
                            RAISE err_app;
                        END IF;

                        po_cod_err := 'PVT-6045';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al insertar el historico de migracion
                        INSERT INTO cl_migracion_historico
                        ("PLAN_ACTUAL","PLAN_NUEVO","ID_ENTIDAD_CONSUMO","IDENTIFICADOR_ENTIDAD","BALANCE","PRECIO_TARIFA","ID_BOLSILLO","ESTADO","ID_TRAN","FCH_TRAN","COD_GESTION_TRAN","COD_UNIDAD_NEGOCIO","COD_USUARIO","MONTO")
                        VALUES
                        (v_reg_entidad_consumo.cod_plan,pi_cod_plan,v_reg_entidad_consumo.id_entidad_consumo,v_reg_entidad_consumo.identificador_entidad,v_core_balance_monto,bolsillos.monto_tarifa_x_migracion,v_bolsillos_cs.cod_bolsillo_ecms,c_estado_activo,v_id_tran,v_fch_tran,pi_cod_unidad_negocio,v_cod_gestion_tran,pi_cod_usuario,v_monto_recarga);
                    END LOOP;

                END IF;
                /* FINALIZANDO RQX 5009*/
            END IF;
            --RQX 454244 - Cambio políticas cambio y migración de plan - algunas tareas de migración se traen al cambio de plan - FIN

        END IF;

        -- < ECN    20090217   RQX-954 Validar que si tiene inclusiones tenga por lo menos un principal.
        IF pi_master = c_verdadero THEN
            tx_pvt_ccs.validar_si_tiene_principal (v_reg_entidad_consumo.id_comunidad_facturante,
                                                   po_cod_err, po_msj_err);

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- ECN    20090217   RQX-954 Validar que si tiene inclusiones tenga por lo menos un principal. >

        -- < ECN    20100921    RQX-2419    Verificar si el suscriptor pertenece a un plan que puede tener dependientes y si lo tiene.
        IF pi_id_prospecto_mig IS NOT NULL THEN
            IF v_reg_plan_anterior.cod_grupo_plan <> v_reg_plan_nuevo.cod_grupo_plan THEN
                tx_pvt_ccs.tiene_planes_dependientes (pi_id_entidad_consumo, pi_id_prospecto_mig,
                                                      po_cod_err, po_msj_err);

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;
--------------------------------------------------------------------------------------------------------------------
    --4567835 - Descuento SeNaSa
    --VALIDACION DEL DESCUENTO ACTIVO PARA ACTUALIZACION DEL MISMO, SI EL PLAN APLICA
    --po_cod_err := 'OK';

    -- BEGIN
    --     SELECT cldec.*
    --     INTO v_registro_descuento
    --     FROM cl_descuento_entidad_consumo cldec
    --     WHERE cldec.id_entidad_consumo = pi_id_entidad_consumo
    --         AND cldec.ESTADO = 'A'
    --         AND cldec.FCH_FIN > SYSDATE
    --         AND ROWNUM = 1;

    -- EXCEPTION
    --     WHEN NO_DATA_FOUND THEN
    --         v_registro_descuento := NULL;
    -- END;

    -- IF v_registro_descuento.id_registro IS NOT NULL THEN
	-- BEGIN
    -- 	SELECT cdec.id_cnf_descuento, cdec.cod_descuento
    --     INTO v_cnf_descuento_id, v_codigo_descuento
    --     FROM cnf_descuento_entidad_consumo cdec, JSON_TABLE (cdec.planes, '$.planes[*]' COLUMNS (cod_plan VARCHAR2 (50) PATH '$.cod_plan')) jt
    --     WHERE   cdec.id_cnf_empresa IN (SELECT TO_NUMBER (parametro_1)
    --                                     FROM cnf_configuracion_especial
    --                                     WHERE nombre_tabla = 'CNF_DESCUENTO_EMPRESA' AND tipo = 'DESCUENTO_EMPRESA_CAMBIO_PLAN')
    --         AND jt.cod_plan = pi_cod_plan
    --         AND ROWNUM = 1;

	-- 	TX_CL_DESCUENTO_ENTIDAD_CONSUMO.MODIFICACION(
    --         pi_id_registro              =>      v_registro_descuento.id_registro,
	-- 	    pi_id_entidad_consumo       =>      v_reg_entidad_consumo.id_entidad_consumo,
	-- 	    pi_id_cnf_descuento         =>      v_cnf_descuento_id,
	-- 	    pi_cod_usuario              =>      pi_cod_usuario,
	-- 	    pi_master                   =>      c_falso,
	-- 	    pi_id_tran                  =>      v_id_tran,
	-- 	    pi_fch_tran                 =>      v_fch_tran,
	-- 	    pi_cod_gestion_tran         =>      v_cod_gestion_tran,
	-- 	    pi_cod_unidad_negocio       =>      pi_cod_unidad_negocio,
	-- 	    po_id_tran                  =>      po_id_tran,
	-- 	    po_fch_tran                 =>      v_fch_tran,
	-- 	    po_cod_err                  => 		po_cod_err,
    --         po_msj_err                  => 		po_msj_err
    --         );

    -- EXCEPTION
    -- 	WHEN NO_DATA_FOUND THEN
    --     TX_CL_DESCUENTO_ENTIDAD_CONSUMO.baja (
	-- 		pi_id_registro         	  =>       v_registro_descuento.id_registro,
	-- 		pi_cod_usuario            =>       pi_cod_usuario,
	-- 		pi_master                 =>       c_falso,
	-- 		pi_id_tran                =>       v_id_tran,
	-- 		pi_fch_tran               =>       v_fch_tran,
	-- 		pi_cod_gestion_tran       =>       v_cod_gestion_tran,
	-- 		pi_cod_unidad_negocio     =>       pi_cod_unidad_negocio,
	-- 		po_id_tran                =>      po_id_tran,
	-- 		po_fch_tran               =>      v_fch_tran,
	-- 		po_cod_err                =>      po_cod_err,
	-- 		po_msj_err                =>      po_msj_err
	-- 		);
    -- 	END;

    -- 	IF po_cod_err <> 'OK' THEN
    --        RAISE err_app;
    --     END IF;
    -- END IF;
--------------------------------------------------------------------------------------------------------------------
        -- ECN    20100921    RQX-2419    Verificar si el suscriptor pertenece a un plan que puede tener dependientes y si lo tiene. >

                -- club preferencial
        -- inicio validacion plan para club preferencial empleado (cambio plan)
            /*          --Ticket 109662
          -- inicio club preferencial test01
            -- si el antiguo plan era de empleados y el de ahora no pues realizar una baja en el club preferencial
            IF TX_CLUB_PREFERENCIAL.es_empleado(v_reg_plan_anterior.cod_plan) = '1' AND TX_CLUB_PREFERENCIAL.es_empleado(v_reg_plan_nuevo.cod_plan) = '0' THEN

               TX_CLUB_PREFERENCIAL.afiliado_baja(v_reg_entidad_consumo.identificador_entidad,
                                                    'POSTVENTA',
                                                    v_id_tran,
                                                    v_fch_tran,
                                                    v_cod_gestion_tran,
                                                    pi_cod_usuario,
                                                    pi_cod_unidad_negocio,
                                                    c_falso,
                                                    po_cod_err,
                                                    po_msj_err);
               IF po_cod_err <> 'OK' THEN --Ticket 106563
                    RAISE err_app;
                END IF;
            END IF;

            IF TX_CLUB_PREFERENCIAL.es_empleado(v_reg_plan_nuevo.cod_plan) = '1' THEN

                 --Ticket 106563 Se agrega validacion para que solo de alta cuando el cliente no tenga suscrito el servicio.
                  SELECT count(1)
                      INTO v_dummy
                    FROM club_entidad_afiliado
                     WHERE id_entidad_consumo=v_reg_entidad_consumo.id_entidad_consumo
                        AND estado=c_estado_activo;

                  IF v_dummy = 0 then

                po_msj_err := 'PVT-2880';  -- TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al llamar el procedure TX_CLUB_PREFERENCIAL.afiliado_alta

                TX_CLUB_PREFERENCIAL.afiliado_alta(
                                                v_reg_entidad_consumo.identificador_entidad,
                                                'POSTVENTA',
                                                v_id_tran,
                                                v_fch_tran,
                                                v_cod_gestion_tran,
                                                pi_cod_usuario,
                                                pi_cod_unidad_negocio,
                                                c_falso,
                                                v_tmp_result, -- dummy
                                                po_cod_err,
                                                po_msj_err);

              IF po_cod_err <> 'OK' THEN --Ticket 106563
                    RAISE err_app;
                END IF;
                 END IF;
            END IF;

        -- fin club preferencial
        -- fin validacion club preferencial empleado (cambio plan)
*/ --Ticket 109662 Fin


        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                := 'OK';
        po_msj_err                := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out               :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END cambio_plan;



   --**Notifica Limite de Credito disponible para clientes postpago consumidor o corporativo cuando  aumenten o disminuyan los limites
   --por medio de migracion, cambio de plan y asignacion de limite de credito directo a la cuenta.
   --Creado Por: Alicia Acevedo 7/7/2014  5:36 PM.

  PROCEDURE notifica_credito(

       pi_id_prospecto_cambio_plan     IN       vta_cambio_plan.id_prospecto%TYPE,
       --Transaccionales
       pi_id_tran                      IN       tx_historico_transaccion.id_tran%TYPE,
       pi_fch_tran                     IN       tx_historico_transaccion.fch_tran%TYPE,
       pi_cod_gestion_tran             IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
       pi_cod_usuario                  IN       VARCHAR2,
       pi_cod_unidad_negocio           IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
       pi_master                       IN       VARCHAR2,
        -- Parametros de salida
       po_id_sms                       OUT      sms_despachador.id_sms%TYPE,
       po_cod_err                      OUT      VARCHAR2,
       po_msj_err                      OUT      VARCHAR2

    )
    IS
      v_cod_linea_negocio_nuevo       cl_comunidad.cod_linea_negocio%TYPE;
      v_cod_linea_negocio_anterior    cl_comunidad.cod_linea_negocio%TYPE;
      v_tarifa_plan_nuevo             VARCHAR2(50);
      v_tarifa_plan_anterior          VARCHAR2(50);
      v_credito                       number;
      v_dummy                         number;
      v_identificador_entidad         VARCHAR2 (100);
      v_msj                           varchar2(500);
      v_id_mensaje                    sms_despachador.id_sms%TYPE;
      -- Variables obligatorias de seguridad y logs
      v_cod_tran                    VARCHAR2 (100) := v_cod_ent || '.NOTIFICA_CREDITO';
      v_reg_entidad                 cnf_entidad%ROWTYPE;
      v_rowid_entidad               ROWID;
      v_nombre_tabla                VARCHAR2 (50) := NULL;
      v_trama_in                    VARCHAR2 (4000);
      v_trama_out                   VARCHAR2 (2000);
      v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
      v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
      v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
      err_app                       EXCEPTION;
      v_seq                         VARCHAR (25);
      v_timestamp                   VARCHAR (25);
    BEGIN
          -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in     :=
                             ---------- parametros variables ------------------
                           'pi_id_prospecto_cambio_plan:'
                          || pi_id_prospecto_cambio_plan
                          || '|'
                          ---------- parametros obligatorios ---------------
                          || 'pi_id_tran:'
                          || pi_id_tran
                          || '|'
                          || 'pi_fch_tran:'
                          || pi_fch_tran
                          || '|'
                          || 'pi_cod_gestion_tran:'
                          || pi_cod_gestion_tran
                          || '|'
                          || 'pi_cod_usuario:'
                          || pi_cod_usuario
                          || '|'
                          || 'pi_cod_unidad_negocio:'
                          || pi_cod_unidad_negocio
                          || '|'
                          || 'pi_master:'
                          || pi_master
                          || '|'
                          || 'usuario:'
                          || USER;

        -- Validar parametros de entrada obligatorios
        IF   pi_id_prospecto_cambio_plan IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2219';   --TX_PVT_ENTIDAD_CONSUMO.NOTIFICA_CREDITO:  Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =                                                                                            c_falso THEN
                po_cod_err := 'PVT-2220';   --TX_PVT_ENTIDAD_CONSUMO.NOTIFICA_CREDITO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2221';   --TX_PVT_ENTIDAD_CONSUMO.NOTIFICA_CREDITOA: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        ------------------------------ Logica del procedimiento -------------------------
        po_cod_err := 'PVT-2222';   --TX_PVT_ENTIDAD_CONSUMO.NOTIFICA_CREDITO: Error al optener limites de credito
        BEGIN
            select
              ec.identificador_entidad
             ,pn.tarifa_basica tarifa_basica_nueva
             , pa.tarifa_basica tarifa_basica_anterior
             , gpn.cod_linea_negocio cod_linea_negocio_nuevo
             into v_identificador_entidad
             ,v_tarifa_plan_nuevo
             ,v_tarifa_plan_anterior
             , v_cod_linea_negocio_nuevo
             from vta_cambio_plan cp
             inner join cl_entidad_consumo ec on cp.id_entidad_consumo = ec.id_entidad_consumo and ec.estado='A'
             inner join bm_plan pn on cp.cod_plan = pn.cod_plan
             inner join bm_grupo_plan gpn on pn.cod_grupo_plan = gpn.cod_grupo_plan
                                         and case
                                              when gpn.cod_linea_negocio = 'POSCON' and gpn.cod_grupo_plan not in ('POSDAT') THEN 1
                                              when gpn.cod_linea_negocio = 'POSCOR' and gpn.cod_grupo_plan not in ('DATCOR','INTEMP') THEN 1
                                              else 0
                                             end = 1
             inner join bm_plan pa on cp.cod_plan_anterior = pa.cod_plan
             inner join bm_grupo_plan gpa on pa.cod_grupo_plan = gpa.cod_grupo_plan
                                         and case
                                              when gpa.cod_linea_negocio = 'POSCON' and gpa.cod_grupo_plan not in ('POSDAT') THEN 1
                                              when gpa.cod_linea_negocio = 'POSCOR' and gpa.cod_grupo_plan not in ('DATCOR','INTEMP') THEN 1
                                              else 0
                                             end = 1
             where cp.id_prospecto = pi_id_prospecto_cambio_plan
             and cp.estado = 'P';

             v_credito :=0;
             IF v_cod_linea_negocio_nuevo = 'POSCOR' THEN
                  v_credito := NVL (v_tarifa_plan_nuevo, 0) * 4;
             ELSIF v_cod_linea_negocio_nuevo = 'POSCON' THEN
                  v_credito := NVL (v_tarifa_plan_nuevo, 0)  * 3;
             END IF;

             IF NVL (v_tarifa_plan_nuevo, 0) <> NVL (v_tarifa_plan_anterior, 0) THEN
                 IF  NVL (v_tarifa_plan_nuevo, 0) > NVL(v_tarifa_plan_anterior, 0) then
                     v_msj :='Tu limite de credito en este numero ha sido aumentado a RD$ '||v_credito || ' VIVA, estamos de tu lado';
                 ELSIF  NVL (v_tarifa_plan_nuevo, 0) < NVL(v_tarifa_plan_anterior, 0) then
                     v_msj :='Tu limite de credito en este numero ha sido disminuido a RD$ '||v_credito || ' VIVA, estamos de tu lado';
                 END IF;

                 po_cod_err := 'PVT-2223';   --TX_PVT_ENTIDAD_CONSUMO.NOTIFICA_CREDITO: Error al Enviar msj de limite  de credito.
                 tx_sms.alta (pi_origen                      => 'VIVA',
                              pi_destino                     => v_identificador_entidad,
                              pi_texto                       => v_msj,
                              pi_prioridad                   => '2',
                              pi_id_tran                     => v_id_tran,
                              pi_fch_tran                    => v_fch_tran,
                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                              pi_cod_usuario                 => pi_cod_usuario,
                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                              pi_master                      => c_falso,
                              po_id_sms                      => v_id_mensaje,
                              po_cod_err                     => po_cod_err,
                              po_msj_err                     => po_msj_err
                             );
                  IF po_cod_err != 'OK' THEN
                       RAISE err_app;
                  END IF;
              END IF;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                  NULL;
        END;
        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err     := 'OK';
        po_msj_err     := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out    :=
                          ---------- parametros obligatorios ---------------
                          'po_cod_err:' || po_cod_err || '|' || 'po_msj_err:' || po_msj_err;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_verdadero,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- Registro de log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             NULL,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=
                              ---------- parametros obligatorios ---------------
                              'po_cod_err:' || po_cod_err || '|' || 'po_msj_err:' || po_msj_err;
            -- Registro de log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 NULL,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);

            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=
                              ---------- parametros obligatorios ---------------
                              'po_cod_err:' || po_cod_err || '|' || 'po_msj_err:' || po_msj_err;
            -- Registro de log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 NULL,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );

    END notifica_credito;


    PROCEDURE cambio_plan_consolidacion (
        -- Input parameters
        pi_id_prospecto           IN       vta_cambio_plan.id_prospecto%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                      := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_PLAN');
        c_tipo_tran_zonificacion_fh CONSTANT VARCHAR2 (50)
                          := tx_cnf_constante.get_constante ('TRANSACCION_ASIGNAR_ZONA_FULL_HOGAR');
        c_limite_credito     CONSTANT VARCHAR2 (50)
                                               := tx_cnf_constante.get_constante ('LIMITE_CREDITO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.CAMBIO_PLAN';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_reg_servicio                bm_servicio%ROWTYPE;
        v_reg_plan_anterior           bm_plan%ROWTYPE;
        v_reg_plan_nuevo              bm_plan%ROWTYPE;
        v_cod_servicio                bm_servicio.cod_servicio%TYPE;
        v_monto                       bm_plan.tarifa_basica%TYPE;
        v_impuesto_1                  bm_plan.tarifa_basica%TYPE;
        v_impuesto_2                  bm_plan.tarifa_basica%TYPE;
        v_impuesto_3                  bm_plan.tarifa_basica%TYPE;
        v_cod_linea_negocio_anterior  cl_comunidad.cod_linea_negocio%TYPE;
        v_cod_linea_negocio_nuevo     cl_comunidad.cod_linea_negocio%TYPE;
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_cod_ciclo                   cl_comunidad.cod_ciclo_facturacion%TYPE;
        v_tipo_operacion              prv_command.sub_operation%TYPE;
        v_reg_periodo                 tr_periodo_facturacion%ROWTYPE;
        v_customer_group_nuevo        bm_plan.customer_group%TYPE;
        v_fch_inicio_vigencia         tr_cambio_plan_historico.fch_inicio%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_id_orden                    cl_orden_prv.id_orden%TYPE;
        v_tiene_lc                    PLS_INTEGER;
        v_permiso                     VARCHAR2 (10);
        v_provisionar_inmediato       VARCHAR2 (10);
        v_esn_hex                     cl_entidad_consumo.imsi%TYPE;
        v_id_registro                 cl_servicio_entidad_consumo.id_registro%TYPE;
        v_principales                 PLS_INTEGER;
        v_reg_comunidad               cl_comunidad%ROWTYPE;
        v_deuda_cuenta                cta_doc_cuenta_corriente.valor%TYPE;
        v_reg_cambio_plan             vta_cambio_plan%ROWTYPE;
        v_id_documento                vta_venta_prospecto.id_venta%TYPE;
        v_tiene_ri                    PLS_INTEGER;
        v_accion                      NUMBER;
        v_bolsillos                   cnf_configuracion_especial.parametro_1%TYPE;
        v_cod_observacion             cnf_nota_transaccion.cod_observacion%TYPE;
        v_descripcion_observacion     cnf_nota_transaccion.descripcion%TYPE;
        v_existe                      PLS_INTEGER;
        v_cod_tipo_afinidad           cnf_configuracion_especial.parametro_1%TYPE;
        v_monto_tarifas_basicas       NUMBER (15, 2) := 0;
        v_reg_cnf_especial            cnf_configuracion_especial%ROWTYPE;
        v_fecha_prov                  DATE;
        v_prorrateo                   NUMBER := 0;
        v_valor_venta                 NUMBER := 0;
        v_vigencia_fin_pps            VARCHAR2 (100);
        v_cod_transaccion             VARCHAR2 (100);
        v_comentario                  VARCHAR2 (100);
        v_id_contrato                 cl_contrato_entidad_consumo.id_contrato%TYPE;
        v_bb_empresarial              NUMBER := 0;
        v_bb_control_empresarial      PLS_INTEGER;
        v_es_prorrateo                PLS_INTEGER;
        v_evdoco_conf                 tx_bm_plan.type_evdo_control_conf;
        v_se_creo_cargo_prorrateo     NUMBER := 0;
        v_mog_id                      VARCHAR2 (50);
        v_cnftu                       tx_bm_plan.type_rgst_tu_conf;
        v_prv_monto                   NUMBER := 0;
        v_prv_bolsillo                PLS_INTEGER;
        v_segmento_actual             bm_plan_segmento.cod_segmento%TYPE;
        v_segmento_anterior           bm_plan_segmento.cod_segmento%TYPE;
        v_id_paquete                  cl_paquete.id_paquete%TYPE;
        v_dummy                       PLS_INTEGER;
        v_dual_sim                    PLS_INTEGER;
        v_tmp_result                  VARCHAR2(20);
        v_aplica_migracion_bolsillo    NUMBER;
        v_balance_nuevo                varchar2(15);
        v_bolsillo_antiguo             NUMBER;
        v_monto_recarga                FLOAT(126):=0;
        v_expiration_date              NUMBER;
        v_id_acction                   NUMBER;
        v_cod_grupo_plan               VARCHAR2(20);
        v_id_tran_orden_prv            NUMBER;
        v_id_mensaje                   VARCHAR2(500);
        v_msisdn        varchar2(100);
        v_old_cos       varchar2(100);
        v_old_supcos    varchar2(100);
        v_new_cos       varchar2(100);
        v_new_supcos    varchar2(100);
        v_cod_action    varchar2(100);
        v_p1    varchar2(100);
        v_p2    varchar2(100);
        v_id_subsidio   cl_subsidio_ec.id_subsidio%TYPE;
        v_promo_llamadota   PLS_INTEGER;
        v_cod_segmento_nuevo VARCHAR2(200);
        v_aplica_ciclo_vida  PLS_INTEGER;
        v_plan_migracion_prepag PLS_INTEGER;
        v_balance_expiration_date  DATE;
        v_transaction_reason cl_lifecycle.transaction_reason%TYPE;
        c_dias_vigencia_nuevo_pospago   CONSTANT VARCHAR2 (50)
                                      := tx_cnf_constante.get_constante ('DIAS_VIGENCIA_NUEVO_POSPAGO');
        v_fch_expiracion   DATE;
        v_old_profile_id   bm_plan_param.valor%TYPE;
        v_new_profile_id   bm_plan_param.valor%TYPE;
        v_command_id       vpg_cnf_comando.id_comando%TYPE;
        v_po_id_orden      vpg_orden.id_orden%TYPE;
        v_po_id_tran       tx_historico_transaccion.id_tran%TYPE;
        v_po_fch_tran      tx_historico_transaccion.fch_tran%TYPE;
        v_nuevo_rate_plan  bm_plan_param.valor%TYPE;
        v_es_mismo_rp      PLS_INTEGER;
        v_es_mismo_mo      PLS_INTEGER;
        v_bolsillos_cs     tx_ecms.type_ecms_bolsilos;
        v_bolsillo_ecms    tx_ecms.type_ecms_bolsilos;
        v_offer_plan        bm_plan_param.valor%TYPE;
        po_fch_tran         DATE;
        v_apn_id            vpg_orden_param.valor%TYPE;
        v_eqos_id           vpg_orden_param.valor%TYPE;
        v_refill_profile_id           cnf_vigencia_carga.refill_profile_id%TYPE;
        v_monto_recarga_prv           cnf_vigencia_carga.desde_monto%TYPE;
        v_balance_recarga             NUMBER(18, 6) := 0;
        v_pdpcp_id                      vpg_orden_param.valor%TYPE;
        v_cod_enlace                    VARCHAR2(100);
        v_csp_id                   bm_plan_param.valor%TYPE;
        v_schar                    bm_plan_param.valor%TYPE;
        v_eps_profile_id            bm_plan_param.valor%TYPE;
        v_main_offer                bm_plan_param.valor%TYPE;
        v_old_sc                    bm_plan_param.valor%TYPE;
        v_new_sc                    bm_plan_param.valor%TYPE;
        v_offer_id                  bm_plan_param.valor%TYPE;
        v_id_comando                VARCHAR2(100);

        -- Cursores
        CURSOR curservicios_desasignar (
            pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
            pi_cod_plan_nuevo         IN       cl_entidad_consumo.cod_plan%TYPE
        )
        IS
            SELECT DISTINCT sec.cod_servicio
                       FROM cl_servicio_entidad_consumo sec, bm_servicio s
                      WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                        AND sec.cod_servicio = s.cod_servicio
                        AND sec.estado <> c_estado_inactivo
                        AND sec.fch_fin = c_fecha_fin
                        AND s.cod_tipo_servicio <> 'TSEDO'
            MINUS
            (SELECT ps.cod_servicio
               FROM bm_plan_servicio ps
              WHERE ps.cod_plan = pi_cod_plan_nuevo
                AND ps.estado <> c_estado_inactivo
                AND ps.fch_fin = c_fecha_fin
             UNION ALL
             SELECT sp.cod_servicio
               FROM bm_plan_servicio ps, bm_servicio_paquete sp
              WHERE ps.cod_plan = pi_cod_plan_nuevo
                AND ps.cod_servicio = sp.cod_servicio_paquete
                AND ps.estado <> c_estado_inactivo
                AND ps.fch_fin = c_fecha_fin
                AND sp.estado <> c_estado_inactivo
                AND sp.fch_fin = c_fecha_fin);

        CURSOR curservicios_asignar (
            pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
            pi_cod_plan_nuevo         IN       cl_entidad_consumo.cod_plan%TYPE
        )
        IS
            SELECT ps.cod_servicio
              FROM bm_plan_servicio ps
             WHERE ps.cod_plan = pi_cod_plan_nuevo
               AND ps.es_por_defecto = c_verdadero
               AND ps.estado <> c_estado_inactivo
               AND ps.fch_fin = c_fecha_fin
            MINUS
            SELECT DISTINCT sec.cod_servicio
                       FROM cl_servicio_entidad_consumo sec, bm_plan_servicio ps
                      WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                        AND sec.cod_servicio = ps.cod_servicio
                        AND sec.estado <> c_estado_inactivo
                        AND sec.fch_fin = c_fecha_fin
                        AND ps.fch_fin = c_fecha_fin;

        -- Excepciones
        err_app                       EXCEPTION;
        --RQx #3091
        c_cnf_promo_id       CONSTANT VARCHAR2 (50)
                                      := tx_cnf_constante.get_constante ('RQX_3091_ID_CNF_PROMO_3G');
        buffer                        NUMBER;
        v_remplazar_subsidio_plan       VARCHAR2(1);
        v_migrar_subsidio_plan          VARCHAR2(1);
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_prospecto'
            || pi_id_prospecto
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_prospecto IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2224';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2225';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2226';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        po_cod_err := 'PVT-2227';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar el prospecto de cambio de plan.

        SELECT *
          INTO v_reg_cambio_plan
          FROM vta_cambio_plan cp
         WHERE cp.id_prospecto = pi_id_prospecto AND estado = c_estado_activo;

        --EL SUSCRIPTOR NO DEBE TENER NINGUNA SUSPENSION NI DESCONEXION
        IF     pi_master = c_verdadero
           AND suscriptor_tiene_suspension (v_reg_cambio_plan.id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2228';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --EL SUSCRIPTOR NO DEBE ESTAR INACTIVO
        validar_entidad_consumo (v_reg_cambio_plan.id_entidad_consumo, v_reg_entidad_consumo,
                                 po_cod_err, po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --EL PLAN NUEVO DEBE SER DISTINTO AL ACTUAL
        IF v_reg_entidad_consumo.cod_plan = v_reg_cambio_plan.cod_plan THEN
            po_cod_err := 'PVT-2229';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: El plan actual y el nuevo son iguales.
            RAISE err_app;
        END IF;

        IF tx_subsidio.es_plan_bb_poscor(v_reg_entidad_consumo.id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2230';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al procedimiento para elimnar penalidad SBEQUP.
            tx_subsidio.eliminar_subsidio_equipo(
                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_cod_usuario          => pi_cod_usuario,
                        pi_master               => c_falso,
                        pi_id_tran              => v_id_tran,
                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                        pi_fch_tran             => v_fch_tran,
                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                        po_cod_err              => po_cod_err,
                        po_msj_err              => po_msj_err
                        );
            IF po_cod_err <> 'OK' THEN
                po_cod_err := 'PVT-2231';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Erro al eliminar la penalidad de SBEQUP.
                RAISE err_app;
            END IF;
        END IF;

        --OBTENCION DE DATOS DE PLANES ACTUAL Y NUEVO
        po_cod_err := 'PVT-2232';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar el grupo de plan anterior.

        SELECT *
          INTO v_reg_plan_anterior
          FROM bm_plan b
         WHERE b.cod_plan = v_reg_entidad_consumo.cod_plan;

        po_cod_err := 'PVT-2233';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar el customer_group anterior

        IF tx_por_utiles.get_customer_group_rango (v_reg_entidad_consumo.identificador_entidad) IS NOT NULL THEN
            v_reg_plan_anterior.customer_group    :=
                tx_por_utiles.get_customer_group_rango (v_reg_entidad_consumo.identificador_entidad);
        END IF;

        po_cod_err := 'PVT-2234';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar forma de consumo del plan nuevo.

        SELECT *
          INTO v_reg_plan_nuevo
          FROM bm_plan b
         WHERE b.cod_plan = v_reg_cambio_plan.cod_plan;

        po_cod_err := 'PVT-2235';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar el customer_group nuevo

        IF tx_por_utiles.get_customer_group_rango (v_reg_entidad_consumo.identificador_entidad) IS NOT NULL THEN
            v_reg_plan_nuevo.customer_group    :=
                tx_por_utiles.get_customer_group_rango (v_reg_entidad_consumo.identificador_entidad);
        END IF;

        IF     v_reg_plan_nuevo.cod_plan IN ('PREPAGO_DS')
           AND pi_cod_usuario NOT IN ('ADMOMEGA', 'OMEGA') THEN
            po_cod_err := 'PVT-2236';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta autorizado a realizar este cambio de plan
            RAISE err_app;
        END IF;

        IF     v_reg_plan_anterior.cod_plan IN ('PREPAGO_DS')
           AND v_reg_plan_nuevo.cod_grupo_plan IN ('PREANU', 'PRESEG')
           AND pi_cod_usuario NOT IN ('ADMOMEGA', 'OMEGA') THEN
            po_cod_err := 'PVT-2237';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: No esta autorizado a realizar este cambio de plan
            RAISE err_app;
        END IF;

        IF v_reg_plan_nuevo.tecnologia_aplicable NOT LIKE
                                                  '%' || v_reg_entidad_consumo.cod_tecnologia || '%' THEN
            po_cod_err := 'PVT-2238';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: El plan nuevo no es aplicable a la tecnologia del suscriptor.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2239';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al determinar la linea de negocio del plan actual.

        SELECT gp.cod_linea_negocio
          INTO v_cod_linea_negocio_anterior
          FROM bm_grupo_plan gp
         WHERE gp.cod_grupo_plan = v_reg_plan_anterior.cod_grupo_plan;

        po_cod_err := 'PVT-2240';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al determinar la linea de negocio del plan nuevo.

        SELECT gp.cod_linea_negocio
          INTO v_cod_linea_negocio_nuevo
          FROM bm_grupo_plan gp
         WHERE gp.cod_grupo_plan = v_reg_plan_nuevo.cod_grupo_plan;

        po_cod_err := 'PVT-2241';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al determinar el codigo segmento del plan nuevo.

        SELECT ps.cod_segmento
          INTO v_cod_segmento_nuevo
        FROM v_plan_segmento ps
         WHERE ps.cod_plan = v_reg_plan_nuevo.cod_plan;

        po_cod_err := 'PVT-2242';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al determinar el ciclo de facturacion de la comunidad.

        SELECT cod_ciclo_facturacion
          INTO v_cod_ciclo
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        po_cod_err := 'PVT-2243';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al determinar la fecha final del periodo de facturacion vigente.
        v_reg_periodo          := tx_tr_periodo_facturacion.get_periodo_vigente (v_cod_ciclo);

        -- verificar si es un blackberry corporativo
        SELECT COUNT (1)
          INTO v_bb_empresarial
          FROM cnf_configuracion_especial cne, bm_plan p, bm_grupo_plan gp
         WHERE cne.nombre_tabla = 'BM_PLAN'
           AND cne.tipo IN ('PLANES_BB_CONTROL', 'PLANES_BB_ABIERTOS')
           AND p.cod_plan IN (SELECT *
                                FROM TABLE (SELECT tx_utiles.SPLIT (cne.parametro_1)
                                              FROM DUAL))
           AND p.cod_grupo_plan = gp.cod_grupo_plan
           AND p.cod_plan = v_reg_cambio_plan.cod_plan;

        IF    (v_cod_linea_negocio_nuevo IN (c_linea_negocio_poscon,
                                             c_linea_negocio_hibrid_prepag,
                                             c_linea_negocio_full,
                                             c_linea_negocio_prepago,
                                             c_linea_negocio_mifi,
                                             'EXTERN'
                                            ) and v_reg_entidad_consumo.cod_tecnologia !='SAAS'
              )
           OR (v_cod_linea_negocio_nuevo = c_linea_negocio_postpago_cor AND v_bb_empresarial > 0)
           OR (    v_cod_linea_negocio_nuevo = c_linea_negocio_fija
               AND v_reg_plan_nuevo.cod_grupo_plan = c_grupo_plan_expansion
              )
           OR v_reg_plan_nuevo.cod_grupo_plan = 'PREPRC'
           OR v_cod_segmento_nuevo = 'TVCABLEPRE' THEN
            -- El cambio es efectivo de inmediato
            -- hacia: la linea consumidor, hibrido prepago, perfectos antiguos, prepago,
            -- los grupos planes bb empresariales, viva mi casa prepago y prepago portabilidad
            v_fch_inicio_vigencia    := v_fch_tran;
        ELSE
            -- El cambio es efectivo al corte de facturacion
            v_fch_inicio_vigencia    := v_reg_periodo.periodo_fin + INTERVAL '1' SECOND;
        END IF;

        po_cod_err := 'PVT-2245';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar el identificador del cliente
        v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        --CAMBIO DE PLAN DE LA ENTIDAD DE CONSUMO
        po_cod_err := 'PVT-2246';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar a CC_CL_ENTIDAD_CONSUMO.MODIFICACION
        cc_cl_entidad_consumo.modificacion
               (pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                pi_descripcion                 => v_reg_entidad_consumo.descripcion,
                pi_identificador_entidad       => v_reg_entidad_consumo.identificador_entidad,
                pi_puk                         => v_reg_entidad_consumo.puk,
                pi_imsi                        => v_reg_entidad_consumo.imsi,
                pi_sim                         => v_reg_entidad_consumo.sim,
                pi_cod_plan                    => v_reg_cambio_plan.cod_plan,
                pi_tiempo_obligatorio_contrato => v_reg_entidad_consumo.tiempo_obligatorio_contrato,
                pi_id_comunidad_facturante     => v_reg_entidad_consumo.id_comunidad_facturante,
                pi_cod_forma_consumo           => v_reg_plan_nuevo.cod_forma_consumo,
                pi_id_persona                  => v_reg_entidad_consumo.id_persona,
                pi_id_entidad_consumo_ref      => v_reg_entidad_consumo.id_entidad_consumo_referidor,
                pi_id_entidad_consumo_vpn      => v_reg_entidad_consumo.id_entidad_consumo_vpn,
                pi_id_cliente_fs               => v_reg_entidad_consumo.id_cliente_fs,
                pi_id_suscriptor_fs            => v_reg_entidad_consumo.id_suscriptor_fs,
                pi_es_facturable               => v_reg_entidad_consumo.es_facturable,
                pi_id_proc_ems                 => v_reg_entidad_consumo.id_proc_ems,
                pi_id_orig_proc_ems            => v_reg_entidad_consumo.id_orig_proc_ems,
                pi_id_form_ems                 => v_reg_entidad_consumo.id_form_ems,
                pi_id_orig_form_ems            => v_reg_entidad_consumo.id_orig_form_ems,
                pi_cod_usuario                 => pi_cod_usuario,
                pi_id_tran                     => v_id_tran,
                pi_cod_gestion_tran            => v_cod_gestion_tran,
                pi_fch_tran                    => v_fch_inicio_vigencia,
                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                pi_fch_efectiva                => v_fch_inicio_vigencia,
                po_cod_err                     => po_cod_err,
                po_msj_err                     => po_msj_err
               );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;


        ----------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------
        --Validar si el hlr_profile_id del plan anterior es diferente al del nuevo, en caso de ser asi se envia orden para cambio
        v_old_profile_id := tx_vpg_util.get_plan_param_value(v_reg_plan_anterior.cod_plan, 'HLR_PROFILE_ID', 'VPG_CNF');
        v_new_profile_id := tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'HLR_PROFILE_ID', 'VPG_CNF');

        IF NVL(v_old_profile_id,0) != v_new_profile_id THEN

            po_cod_err := 'PVT-5014'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al buscar el enlace del comando para cambio de perfil en HLR.
            SELECT tx_vpg_util.get_comando('CHG_HLR_PRF', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
              INTO v_command_id
            FROM DUAL;

            po_cod_err := 'PVT-5170'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al buscar el perfil de CAMEL.
            v_csp_id := tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'CSP', 'VPG_CNF');

            po_cod_err := 'PVT-5171'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al buscar el perfil de SCHAR.
            v_schar := tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'SCHAR', 'VPG_CNF');

            po_cod_err := 'PVT-5015'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Eror al dar de alta la orden para cambio de perfil en HLR.
            mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_inicio_vigencia,
                    pi_cod_transaccion      => v_cod_tran,
                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_p2                   => v_new_profile_id,
                    pi_p3                   => v_csp_id,
                    pi_p4                   => v_schar,
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => '0',
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_po_id_orden,
                    po_id_tran              => v_po_id_tran,
                    po_fch_tran             => v_po_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

        END IF;

       ----------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------

        --REGISTRAR LA ORDEN DIFERIDA DE CAMBIO DE PLAN
        --EN CASO QUE AMBOS ESTEN EN PPS, SIMPLEMENTE SE HACE CAMBIO DE COSNAME

        v_new_sc    :=  tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'RATE_PLAN_ID', 'VPG_CNF');
        v_old_sc    :=  tx_vpg_util.get_plan_param_value(v_reg_plan_anterior.cod_plan, 'RATE_PLAN_ID', 'VPG_CNF');

        IF (v_reg_plan_anterior.c1_offer_id IS NOT NULL AND v_reg_plan_nuevo.c1_offer_id IS NOT NULL)
        OR (v_old_sc IS NOT NULL AND v_new_sc IS NOT NULL ) THEN

         --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------

            v_command_id := NULL;
            --Validamos si el Rate Plan actual y el nuevo, en caso de ser iguales se debe hacer otro comando
            v_es_mismo_rp := tx_vpg_util.es_mismo_rate_plan(v_reg_plan_anterior.cod_plan, v_reg_plan_nuevo.cod_plan);

            IF v_es_mismo_rp = 1 THEN

                --Validamos si ambos planes tienen el mismo Main Offer. Solo se provisiona si el resultado es CERO (no son iguales)
                v_es_mismo_mo := tx_vpg_util.es_mismo_main_offer(v_reg_plan_anterior.cod_plan, v_reg_plan_nuevo.cod_plan);

                IF v_es_mismo_mo = 0 THEN
                    po_cod_err := 'PVT-2248';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
                    SELECT tx_vpg_util.get_comando('CHG_MAIN_OFFER', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                      INTO v_command_id
                    FROM DUAL;
                END IF;

                --Ponemos en NULL, Just in case :)
                v_nuevo_rate_plan := NULL;
            ELSE

                v_main_offer    :=  tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF');

                IF (v_main_offer = c_falso OR v_main_offer IS NULL ) THEN
                    v_cod_enlace    :=  'CHG_SC_2GTO4G'; -- Plan sin Offer Principal, solo cambio de service class.
                ELSE
                    v_cod_enlace    :=  'CHG_SC';
                END IF;

                po_cod_err := 'PVT-2248';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
                SELECT tx_vpg_util.get_comando(v_cod_enlace, v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                  INTO v_command_id
                FROM DUAL;

                --Obtenemos el nuevo Rate Plan a provisionar
                v_nuevo_rate_plan := tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'RATE_PLAN_ID', 'VPG_CNF');
            END IF;

            IF (tx_pvt_entidad_consumo.es_plan_4g(v_reg_plan_nuevo.cod_plan) = c_verdadero
                OR tx_pvt_entidad_consumo.es_plan_4g(v_reg_plan_anterior.cod_plan) = c_verdadero)
                AND tx_pvt_entidad_consumo.es_plan_4g(v_reg_plan_nuevo.cod_plan) = c_verdadero THEN

                generar_orden_cambio_plan (
                        pi_id_entidad_consumo     => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_cod_plan_ant           => v_reg_plan_anterior.cod_plan,
                        pi_cod_plan_nuevo         => v_reg_plan_nuevo.cod_plan,
                        pi_fch_inicio_vigencia    => v_fch_inicio_vigencia,
                        pi_cod_transaccion        => v_cod_tran,
                        pi_cod_usuario            => pi_cod_usuario,
                        pi_id_tran                => v_id_tran,
                        pi_cod_gestion_tran       => v_cod_gestion_tran,
                        pi_fch_tran               => v_fch_tran,
                        pi_cod_unidad_negocio     => pi_cod_unidad_negocio,
                        po_cod_err                => po_cod_err,
                        po_msj_err                => po_msj_err
                );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            ELSIF es_fija(v_reg_plan_anterior.cod_plan) = 1 THEN

                -- 1 Validar Service Class
                IF v_new_sc <> v_old_sc THEN

                    SELECT tx_vpg_util.get_comando('SC_SWITCH', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                      INTO v_command_id
                    FROM DUAL;

                    v_nuevo_rate_plan := tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'RATE_PLAN_ID', 'VPG_CNF');

                    po_cod_err := 'PVT-5213'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta la orden para cambio de oferta.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_inicio_vigencia,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_nuevo_rate_plan,
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;


                END IF;


                -- 2 Cambio de offer principal

                v_main_offer    :=  tx_vpg_util.get_plan_param_value(v_reg_plan_anterior.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF');
                IF v_main_offer <> 0
                OR v_main_offer IS NOT NULL
                THEN

                    SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_plan_anterior.cod_forma_consumo, 'SET')
                        INTO v_id_comando
                    FROM DUAL;

                    po_cod_err := 'PVT-5214';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                               pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_fch_programada       => v_fch_inicio_vigencia,
                                pi_cod_transaccion      => v_cod_tran,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_p3                   => v_main_offer, -- OFFER ID
                                pi_p4                   => 'D',
                                pi_p5                   => NULL, --Fecha Vigencia
                                pi_p6                   => NULL, --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => pi_id_tran,
                                pi_cod_gestion_tran     => pi_cod_gestion_tran,
                                pi_fch_tran             => pi_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;

                 v_main_offer    :=  tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF');
                IF v_main_offer <> 0
                OR v_main_offer IS NOT NULL
                 THEN

                    SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_plan_anterior.cod_forma_consumo, 'SET')
                        INTO v_id_comando
                    FROM DUAL;

                    po_cod_err := 'PVT-5215';   --TX_PVT_ENTIDAD_CONSUMO.GENERAR_ORDEN_CAMBIO_PLAN: Error al generar la orden.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                               pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_fch_programada       => v_fch_inicio_vigencia,
                                pi_cod_transaccion      => v_cod_tran,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_p3                   => v_main_offer, -- OFFER ID
                                pi_p4                   => 'C',
                                pi_p5                   => NULL, --Fecha Vigencia
                                pi_p6                   => NULL, --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => pi_id_tran,
                                pi_cod_gestion_tran     => pi_cod_gestion_tran,
                                pi_fch_tran             => pi_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;


               -- 3 extension ciclo vida para pospagos
                IF v_reg_plan_anterior.cod_forma_consumo = 'CCOPRE'
                AND v_reg_plan_nuevo.cod_forma_consumo = 'CCOPOS'
                    THEN

                    tx_cl_lifecycle.DELETE_ROW(
                                pi_internal_id          => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_transaction_reason   => 'FIXED_POSTPAID_MIGRATION',
                                pi_master               => c_falso,
                                pi_tran_id              => v_id_tran,
                                pi_tran_date            => v_fch_tran,
                                pi_tran_user            => pi_cod_usuario,
                                pi_tran_period          => v_cod_gestion_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;


            ELSIF v_command_id IS NOT NULL THEN
                --Migraciones entre planes legacy

                po_cod_err := 'PVT-5002'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta la orden para cambio de oferta.
                mt_vpg.alta_orden(
                        pi_id_comando           => v_command_id,
                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_fch_programada       => v_fch_inicio_vigencia,
                        pi_cod_transaccion      => v_cod_tran,
                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                        pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_p3                   => tx_vpg_util.get_plan_param_value(v_reg_plan_anterior.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF'),
                        pi_p4                   => NULL, --PAM Service ID Actual
                        pi_p5                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF'),
                        pi_p6                   => NULL, --offer_action
                        pi_p7                   => NULL, --offer_start_date
                        pi_p8                   => NULL, --offer_expiry_date
                        pi_p9                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'PAM_CLASS_ID', 'VPG_CNF'),
                        pi_p10                  => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'PAM_SCHEDULE_ID', 'VPG_CNF'),
                        pi_p11                  => NULL, --pam_action
                        pi_p12                  => NULL, --new_pam_service_id
                        pi_p13                  => v_nuevo_rate_plan,
                        pi_cod_usuario          => pi_cod_usuario,
                        pi_master               => '0',
                        pi_id_tran              => v_id_tran,
                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                        pi_fch_tran             => v_fch_tran,
                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                        po_id_orden             => v_po_id_orden,
                        po_id_tran              => v_po_id_tran,
                        po_fch_tran             => v_po_fch_tran,
                        po_cod_err              => po_cod_err,
                        po_msj_err              => po_msj_err
                        );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;


            END IF;

            --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------


        -- RQX 5009 - Creacion de Bolsillo Migracion - INICIO
        po_cod_err := 'PVT-2250';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al verificar si el cambio aplica para migracion de fondo de bolsillo.
        SELECT COUNT(1)
          INTO v_aplica_migracion_bolsillo
          FROM cl_migracion_historico
         WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
           AND estado = 'A'
           AND fch_tran >= TRUNC(SYSDATE);


        IF v_aplica_migracion_bolsillo >= 1 THEN

             --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
                po_cod_err := 'PVT-5003'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
                SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                   INTO v_command_id
                FROM DUAL;

               po_cod_err := 'PVT-2251';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al obtener el nuevo balance para bolsillo de migracion.
                FOR bolsillos IN (SELECT balance, id_bolsillo, monto
                                    FROM cl_migracion_historico
                                   WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                                     AND estado = 'A'
                                  )
                LOOP

                    --Para cambio hacia el nuevo prepago 4g no es necesario borrar el balance, hacer cambio de service class se eliminan
                   IF v_reg_cambio_plan.cod_plan <> 'PREPAG_4G'  THEN
                       v_bolsillo_ecms := tx_ecms.get_info_bolsillo(bolsillos.id_bolsillo);

                        po_cod_err := 'PVT-5004'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al limpiar los balances en cambio de plan.
                        mt_vpg.alta_orden(
                                pi_id_comando           => v_command_id,
                                pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_fch_programada       => v_fch_inicio_vigencia,
                                pi_cod_transaccion      => v_cod_tran,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_p3                   => v_bolsillo_ecms.cod_bolsillo_ecms,
                                pi_p4                   => 0,
                                pi_p5                   => 'SET TO 0 BALANCES NA',
                                pi_p6                   => v_bolsillo_ecms.cod_unidad_medida,
                                pi_p7                   => 'M', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                                pi_p8                   => NULL, --balance_start_date
                                pi_p9                   => NULL, --balance_expiry_date
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => '0',
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_po_id_orden,
                                po_id_tran              => v_po_id_tran,
                                po_fch_tran             => v_po_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;
                    END IF;

                   --Sumamos los montos para luego hacer el ajuste total en el bolsillo de migracion
                   v_monto_recarga   := v_monto_recarga + bolsillos.monto;
                   v_balance_recarga := v_balance_recarga + bolsillos.balance;

               END LOOP;



                --Obtenemos la vigencia de la recarga
                po_cod_err := 'PVT-2255';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al obtener grupo plan del plan nuevo en migracion de bolsillo.
                SELECT cod_grupo_plan
                  INTO v_cod_grupo_plan
                  FROM bm_plan
                 WHERE cod_plan = v_reg_cambio_plan.cod_plan
                   AND estado = 'A';

                --Obtenemos el ID de bolsillo equivalente en Charging System
                IF v_reg_cambio_plan.cod_plan = 'PREPAG_4G' THEN
                    v_bolsillos_cs := tx_ecms.get_C1toEcms(c_id_bolsillo_mig_new);
                ELSE
                    v_bolsillos_cs := tx_ecms.get_C1toEcms('53'); --53 = ID Bolsillo Migracion en C1
                END IF;

                po_cod_err := 'PVT-2256';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al obtener vigencia de recarga.
                v_expiration_date := tx_cnf_vigencia_carga.get_vigencia (v_cod_grupo_plan,v_monto_recarga);
                v_balance_expiration_date := (v_fch_tran + v_expiration_date);

                po_cod_err := 'PVT-5005'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta la orden para migracion de balance.

               --VPG-
                po_cod_err := 'PVT-5172'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta la orden para migracion de balance.
                v_command_id    :=  tx_vpg_util.get_comando('SET_DA_BALANCE',v_reg_entidad_consumo.cod_forma_consumo,'SET',v_reg_entidad_consumo.cod_tecnologia);

                IF v_bolsillos_cs.cod_unidad_medida IN ('MONEY') THEN
                    v_balance_recarga :=  tx_vpg_util.number2cs(NVL(v_balance_recarga,0));
                END IF;

                mt_vpg.alta_orden(
                        pi_id_comando               => v_command_id,
                        pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_fch_programada           => v_fch_inicio_vigencia,
                        pi_cod_transaccion          => v_cod_tran,
                        pi_p1                       => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                        pi_p2                       => tx_air.get_transactionID,
                        pi_p3                       => tx_vpg_util.date2iso(v_fch_tran),
                        pi_p4                       => v_bolsillos_cs.cod_bolsillo_c1,
                        pi_p5                       => v_balance_recarga,
                        pi_p6                       => v_bolsillos_cs.cod_unidad_medida_air,
                        pi_p7                       => tx_vpg_util.date2iso( v_fch_tran + 30 ),
                        pi_p8                       => 'MOVIMIENTO SALDO MIGRACION',
                        pi_cod_usuario              => pi_cod_usuario,
                        pi_master                   => '0',
                        pi_id_tran                  => v_id_tran,
                        pi_cod_gestion_tran         => v_cod_gestion_tran,
                        pi_fch_tran                 => v_fch_tran,
                        pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                        po_id_orden                 => v_po_id_orden,
                        po_id_tran                  => v_po_id_tran,
                        po_fch_tran                 => v_po_fch_tran,
                        po_cod_err                  => po_cod_err,
                        po_msj_err                  => po_msj_err);

                IF (po_cod_err != 'OK') THEN
                    RAISE err_app;
                END IF;

                /*
                --Cambiamos la fecha del Supervision Period, acorde a la vigencia del balance pasado al bolsillo de migracion
                po_cod_err := 'PVT-5006'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al buscar el enlace del comando para cambio de fecha.
                SELECT tx_vpg_util.get_comando('CMB_CICLO_VIDA', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                  INTO v_command_id
                FROM DUAL;

                po_cod_err := 'PVT-5007'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al enviar comando para cambio de fecha supervision period.
                mt_vpg.alta_orden(
                        pi_id_comando           => v_command_id,
                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_fch_programada       => v_fch_inicio_vigencia,
                        pi_cod_transaccion      => v_cod_tran,
                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                        pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_p3                   => TO_CHAR(v_balance_expiration_date, 'YYYY-MM-DD'),
                        pi_p4                   => NULL, --Service fee Expire Date
                        pi_p5                   => NULL, --Credit clearance Expire Date
                        pi_p6                   => NULL, --Service removal Expire Date
                        pi_cod_usuario          => pi_cod_usuario,
                        pi_master               => '0',
                        pi_id_tran              => v_id_tran,
                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                        pi_fch_tran             => v_fch_tran,
                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                        po_id_orden             => v_po_id_orden,
                        po_id_tran              => v_po_id_tran,
                        po_fch_tran             => v_po_fch_tran,
                        po_cod_err              => po_cod_err,
                        po_msj_err              => po_msj_err
                        );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;*/
             --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
            po_cod_err := 'PVT-2260';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al cambiar de estado la solicitu de cambio de servicio.
            UPDATE cl_migracion_historico
               SET estado = 'P' -- procesado
             WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND estado = 'A';

        END IF;
        -- RQX 5009 - Creacion de Bolsillo Migracion - FIN


            --LIMPIAR BOLSILLOS QUE NO APLICAN AL NUEVO C1_OFFER_ID
            BEGIN
                po_cod_err := 'PVT-2261';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al determinar los bolsillos del nuevo plan a resetear.

                SELECT ce.parametro_1
                  INTO v_bolsillos
                  FROM cnf_configuracion_especial ce
                 WHERE ce.nombre_tabla = 'BM_PLAN'
                   AND ce.tipo = 'BOLSILLOS_NA'
                   AND ce.cod_registro = v_reg_plan_nuevo.cod_plan;

                IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
                    v_id_accion_prv_ext    := 285;
                ELSE
                    v_id_accion_prv_ext    := 286;
                END IF;

                FOR cur IN (SELECT valor
                              FROM TABLE (tx_utiles.SPLIT (v_bolsillos, ',')))
                LOOP

                   --Obtenemos el ID de bolsillo equivalente en Charging System
                   v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_ecms.balancename2id (cur.valor));

                    po_cod_err := 'PVT-2262';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al resetear el bolsillo del nuevo plan.
                    tx_cl_orden_prv.alta   -- C1 OK
                                (pi_id_action                   => v_id_accion_prv_ext,
                                 pi_cod_transaccion             => c_tipo_transaccion,
                                 pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_sub_operacion               => c_tipo_operacion_add,
                                 pi_fch_programada              => v_fch_inicio_vigencia,
                                 pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                                 pi_p5                          => 0,
                                 pi_p6                          => v_bolsillos_cs.cod_bolsillo_c1,
                                 pi_p7                          => 'SET TO 0 BALANCES NA',
                                 pi_p8                          => TO_CHAR (v_fch_inicio_vigencia
                                                                            + 1,
                                                                            'yyyy-mm-dd'),
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_id_orden                    => v_id_orden,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

                    IF (po_cod_err <> 'OK') THEN
                        RAISE err_app;
                    END IF;

                    --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------
                    po_cod_err := 'PVT-5008'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar comando SET_BALANCE.
                    SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                       INTO v_command_id
                    FROM DUAL;

                    po_cod_err := 'PVT-5009'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al limpiar los balances en cambio de plan.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_inicio_vigencia,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                            pi_p4                   => 0,
                            pi_p5                   => 'SET TO 0 BALANCES NA',
                            pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                            pi_p7                   => 'M', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                            pi_p8                   => NULL, --balance_start_date
                            pi_p9                   => TO_CHAR (v_fch_inicio_vigencia + 1, 'YYYY-MM-DD'), --balance_expiry_date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                    --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------

                END LOOP;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    NULL;
            END;
        ELSIF    (v_old_sc IS NULL AND v_new_sc IS NOT NULL )
                OR (v_old_sc IS NOT NULL AND v_new_sc IS NULL )  THEN
            --EN CASO QUE PASE DE UN POSTPAGO A UN PREPAGO O FULL ANADIR EL SUSCRIPTOR EN LA PPS
            --EN CASO QUE PASE DE UN PREPAGO O FULL A POSTPAGO ELIMINAR EL SUSCRIPTOR DE LA PPS
            v_id_accion_prv_ext    := c_prv_action_add_del_pps;

            IF v_old_sc IS NULL AND v_new_sc IS NOT NULL THEN
                v_tipo_operacion    := c_tipo_operacion_add;
                v_transaction_reason := 'POSTPAID_OFFER_MIGRATION';

                IF v_reg_plan_nuevo.creacion_pps = c_verdadero THEN
                    tx_pvt_ccs.get_impuestos (v_reg_plan_nuevo.tarifa_basica,
                                              c_cargo_tbm,
                                              v_monto,
                                              v_impuesto_1,
                                              v_impuesto_2,
                                              v_impuesto_3
                                             );

                    IF (po_cod_err <> 'OK') THEN
                        RAISE err_app;
                    END IF;
                ELSE
                    v_monto    := 0;
                END IF;
            ELSIF     v_old_sc IS NOT NULL
                  AND v_new_sc IS NULL THEN
                v_tipo_operacion    := c_tipo_operacion_del;
                v_transaction_reason := 'OFFER_MIGRACION_ERASE';
            END IF;


            --Cambios en ciclo de vida (CL_LIFECYCLE)
            IF v_transaction_reason = 'POSTPAID_OFFER_MIGRATION' THEN

                ----------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------
                /*VPG - Creacion de numero en Charging System*/

                IF (tx_pvt_entidad_consumo.es_plan_4g(v_reg_plan_nuevo.cod_plan) = c_verdadero
                    OR tx_pvt_entidad_consumo.es_plan_4g(v_reg_plan_anterior.cod_plan) = c_verdadero)
                    AND tx_pvt_entidad_consumo.es_plan_4g(v_reg_plan_nuevo.cod_plan) = c_verdadero  THEN

                    generar_orden_cambio_plan (
                            pi_id_entidad_consumo     => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_cod_plan_ant           => v_reg_plan_anterior.cod_plan,
                            pi_cod_plan_nuevo         => v_reg_plan_nuevo.cod_plan,
                            pi_fch_inicio_vigencia    => v_fch_inicio_vigencia,
                            pi_cod_transaccion        => v_cod_tran,
                            pi_cod_usuario            => pi_cod_usuario,
                            pi_id_tran                => v_id_tran,
                            pi_cod_gestion_tran       => v_cod_gestion_tran,
                            pi_fch_tran               => v_fch_tran,
                            pi_cod_unidad_negocio     => pi_cod_unidad_negocio,
                            po_cod_err                => po_cod_err,
                            po_msj_err                => po_msj_err
                    );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                ELSE

                    po_cod_err := 'PVT-5010'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al buscar el enlace del comando.
                    SELECT tx_vpg_util.get_comando('MIG_PLANES_POSTPAGO', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                      INTO v_command_id
                    FROM DUAL;

                    po_cod_err := 'PVT-5011'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Eror al dar de alta la orden para creacion de numero en CS.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_inicio_vigencia,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.imsi,
                            pi_p3                   => v_reg_entidad_consumo.sim,
                            pi_p4                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'HLR_PROFILE_ID', 'VPG_CNF'),
                            pi_p5                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'CONTRACT_TEMPLATE_ID', 'VPG_CNF'),
                            pi_p6                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p7                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'CONTRACT_TYPE_ID', 'VPG_CNF'),
                            pi_p8                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'MAIN_OFFER_ID', 'VPG_CNF'),
                            pi_p9                   => NULL, --offer_action
                            pi_p10                  => NULL, --offer_start_date
                            pi_p11                  => NULL, --offer_expiry_date
                            pi_p12                  => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'PAM_CLASS_ID', 'VPG_CNF'),
                            pi_p13                  => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan, 'PAM_SCHEDULE_ID', 'VPG_CNF'),
                            pi_p14                  => NULL, --pam_action
                            pi_p15                  => NULL, --pam_service_id
                            pi_p16                  => tx_vpg_util.vpg_getIdSdp(v_reg_entidad_consumo.identificador_entidad), --sdp_id
                            pi_p17                  => TO_CHAR((v_fch_tran + TO_NUMBER(c_dias_vigencia_nuevo_pospago)), 'YYYY-MM-DD'),
                            pi_p18                  => tx_cnf_constante.get_constante ('VIGENCIA_FIN_ECMS'), --Service fee Expire Date
                            pi_p19                  => NULL, --Credit clearance Expire Date
                            pi_p20                  => NULL, --Service removal Expire Date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
                ----------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------

                --DAR DE ALTA EN CICLO DE VIDA (CL_LIFECYLE)
                SELECT COUNT(1)
                  INTO v_aplica_ciclo_vida
                FROM bm_plan_param pp
                WHERE pp.cod_plan = v_reg_plan_nuevo.cod_plan
                  AND pp.fch_tran_fin IS NULL;

                IF v_aplica_ciclo_vida != 0 THEN
                    po_cod_err := 'PVT-4979'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al intentar registrar el nuevo suscriptor en control ciclo de vida.
                    tx_cl_lifecycle.generate_subscriber_dates( pi_internal_id        => v_reg_entidad_consumo.id_entidad_consumo,
                                                               pi_expiration_date    => (v_fch_tran + TO_NUMBER(c_dias_vigencia_nuevo_pospago)),
                                                               pi_transaction_reason => v_transaction_reason,
                                                               pi_master             => c_falso,
                                                               pi_tran_id            => v_id_tran,
                                                               pi_tran_date          => v_fch_tran,
                                                               pi_tran_user          => pi_cod_usuario,
                                                               pi_tran_period        => v_cod_gestion_tran,
                                                               po_cod_err            => po_cod_err,
                                                               po_msj_err            => po_msj_err
                                                              );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
            ELSIF v_transaction_reason = 'OFFER_MIGRACION_ERASE' THEN
                po_cod_err := 'PVT-4980'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error dar de baja el registro actual para control de ciclo de vida
                tx_cl_lifecycle.delete_row(pi_internal_id        => v_reg_entidad_consumo.id_entidad_consumo,
                                           pi_transaction_reason => v_transaction_reason,
                                           pi_master             => c_falso,
                                           pi_tran_id            => v_id_tran,
                                           pi_tran_date          => v_fch_tran,
                                           pi_tran_user          => pi_cod_usuario,
                                           pi_tran_period        => v_cod_gestion_tran,
                                           po_cod_err            => po_cod_err,
                                           po_msj_err            => po_msj_err);
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                ----------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------


                IF (tx_pvt_entidad_consumo.es_plan_4g(v_reg_plan_nuevo.cod_plan) = c_verdadero
                    OR tx_pvt_entidad_consumo.es_plan_4g(v_reg_plan_anterior.cod_plan) = c_verdadero)
                AND tx_pvt_entidad_consumo.es_plan_4g(v_reg_plan_nuevo.cod_plan) = c_verdadero THEN

                    generar_orden_cambio_plan (
                            pi_id_entidad_consumo     => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_cod_plan_ant           => v_reg_plan_anterior.cod_plan,
                            pi_cod_plan_nuevo         => v_reg_plan_nuevo.cod_plan,
                            pi_fch_inicio_vigencia    => v_fch_inicio_vigencia,
                            pi_cod_transaccion        => v_cod_tran,
                            pi_cod_usuario            => pi_cod_usuario,
                            pi_id_tran                => v_id_tran,
                            pi_cod_gestion_tran       => v_cod_gestion_tran,
                            pi_fch_tran               => v_fch_tran,
                            pi_cod_unidad_negocio     => pi_cod_unidad_negocio,
                            po_cod_err                => po_cod_err,
                            po_msj_err                => po_msj_err
                    );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                ELSE

                    /*VPG - Eliminar de numero en Charging System*/
                    po_cod_err := 'PVT-5012'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al buscar el enlace del comando para eliminacion de suscriptor.
                    SELECT tx_vpg_util.get_comando('DEL_CS', v_reg_plan_anterior.cod_forma_consumo, 'ADD')
                      INTO v_command_id
                    FROM DUAL;

                    po_cod_err := 'PVT-5013'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Eror al dar de alta la orden para eliminar numero en CS.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_inicio_vigencia,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
                ----------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------

            END IF;

        END IF;


        --SI CAMBIA DE UN PLAN CON LIMITE DE CREDITO A UNO SIN LIMITE, DESASIGNAR EL LIMITE
        IF     v_reg_plan_anterior.es_sujeto_limite_credito = c_verdadero
           AND v_reg_plan_nuevo.es_sujeto_limite_credito = c_falso THEN
            BEGIN
                po_cod_err := 'PVT-2270';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al obtener el limite de credito de la entidad de consumo.

                SELECT 1
                  INTO v_tiene_lc
                  FROM cl_limite_credito_ent_cons lc
                 WHERE lc.id_entidad_consumo = v_reg_cambio_plan.id_entidad_consumo
                   AND lc.estado <> c_estado_inactivo
                   AND lc.fch_fin = c_fecha_fin
                   AND cod_limite = c_limite_credito;

                po_cod_err := 'PVT-2271';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc. de desasignacion de limite de credito.
                cc_cl_limite_credito_ent_cons.desasignar
                                     (pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                                      pi_cod_limite                  => c_limite_credito,
                                      pi_id_proc_ems                 => NULL,
                                      pi_id_orig_proc_ems            => NULL,
                                      pi_id_form_ems                 => NULL,
                                      pi_id_orig_form_ems            => NULL,
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_inicio_vigencia,
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      pi_fch_efectiva                => v_fch_inicio_vigencia,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    NULL;
            END;
        END IF;

        --SI CAMBIA DE PLAN DE FULL HOGAR A OTRO, SE DEBE QUITAR EL SERVICIO DE ZONIFICACION
        IF     v_reg_plan_anterior.cod_grupo_plan = c_grupo_plan_full_hogar
           AND v_reg_plan_nuevo.cod_grupo_plan <> c_grupo_plan_full_hogar THEN
            BEGIN
                po_cod_err := 'PVT-2272';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al determinar la zona asociada al suscriptor Full Hogar.

                SELECT sec.cod_servicio
                  INTO v_cod_servicio
                  FROM cl_servicio_entidad_consumo sec, bm_servicio s
                 WHERE sec.id_entidad_consumo = v_reg_cambio_plan.id_entidad_consumo
                   AND sec.estado <> c_estado_inactivo
                   AND sec.fch_fin = c_fecha_fin
                   AND sec.cod_servicio = s.cod_servicio
                   AND s.cod_tipo_servicio = c_tipo_serv_fullhogar;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_cod_servicio    := NULL;
            END;

            IF v_cod_servicio IS NOT NULL THEN
                po_cod_err := 'PVT-2273';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc. de deshabilitacion del servicio full hogar.
                cc_cl_servicio_entidad_consumo.desasignar
                                    (pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                                     pi_cod_servicio                => v_cod_servicio,
                                     pi_cod_usuario                 => pi_cod_usuario,
                                     pi_id_tran                     => v_id_tran,
                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                     pi_fch_tran                    => v_fch_inicio_vigencia,
                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                     pi_fch_efectiva                => v_fch_inicio_vigencia,
                                     po_cod_err                     => po_cod_err,
                                     po_msj_err                     => po_msj_err
                                    );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;
            END IF;

            -- 2017-02-21 GAC-Ericsson - Se cambia envio de orden al PRV2 - INICIO
            IF (tx_cnf_constante.get_constante('ERS_ZONIFICACION') IN ('0','2')) THEN
            po_cod_err := 'PVT-2274';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
            v_id_accion_prv_ext    := get_accion_prv (c_tipo_tran_zonificacion_fh,
                                                      v_reg_entidad_consumo.cod_tecnologia,
                                                      v_reg_entidad_consumo.cod_forma_consumo);
            po_cod_err := 'PVT-2275';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc. de provisionamiento en dispositivos.
            tx_cl_orden_prv.alta (pi_id_action                   => v_id_accion_prv_ext,   -- C1 OK
                                  pi_cod_transaccion             => c_tipo_transaccion,
                                  pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                                  pi_sub_operacion               => c_tipo_operacion_del,
                                  pi_fch_programada              => v_fch_inicio_vigencia,
                                  pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_orden                    => v_id_orden,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
            END IF;

            IF (tx_cnf_constante.get_constante('ERS_ZONIFICACION') IN ('1','2')) THEN
                -- Obtener comando del PRV2 y validar que group_id no sea nulo
                po_cod_err := 'PVT-2274';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
                v_command_id    :=  tx_vpg_util.get_comando(
                                    pi_cod_enlace       => c_tipo_tran_zonificacion_fh, --TX_TRAN_ASIGNAR_ZONA_FULL_HOGAR
                                    pi_cod_forma_consumo=> v_reg_entidad_consumo.cod_forma_consumo,
                                    pi_cod_operacion    => 'SET' --c_tipo_operacion_add
                                    );
                IF v_command_id IS NULL THEN
                    po_cod_err := 'PVT-2274';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
                    RAISE err_app;
                END IF;

                --Obtener msisdn para crear la orden
                v_msisdn := tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad);

                --Obtener el OfferId
                v_offer_plan := tx_vpg_util.vpg_getvalor(v_reg_entidad_consumo.cod_plan,'OFFER_HOME_ZONE');

                po_cod_err := 'PVT-2275';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc. de provisionamiento en dispositivos.
                mt_vpg.alta_orden(  pi_id_comando           => v_command_id,
                                    pi_id_entidad_consumo   => v_reg_cambio_plan.id_entidad_consumo,
                                    pi_fch_programada       => v_fch_inicio_vigencia,
                                    pi_cod_transaccion      => c_tipo_transaccion,
                                    pi_p1                   => v_msisdn,
                                    pi_p2                   => v_reg_cambio_plan.id_entidad_consumo,
                                    pi_p3                   => v_offer_plan, --OFFER ID
                                    --pi_p7                  => 'S', --Accion sobre atributo A:Agregar S:Actualizar D:Eliminar
                                    pi_cod_usuario          => pi_cod_usuario,
                                    pi_master               => c_falso,
                                    pi_id_tran              => v_id_tran,
                                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                                    pi_fch_tran             => v_fch_tran,
                                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                    po_id_orden             => v_po_id_orden,
                                    po_id_tran              => v_po_id_tran,
                                    po_fch_tran             => v_po_fch_tran,
                                    po_cod_err              => po_cod_err,
                                    po_msj_err              => po_msj_err
                                    );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
            -- 2017-02-21 GAC-Ericsson - Se cambia envio de orden al PRV2 - FIN

        END IF;

        --Validamos si es un cambio a una linea de negocio que debe existir en la PPS.
        IF (( get_linea_negocio(v_reg_plan_anterior.cod_plan) IN (c_linea_negocio_prepago, 'EXTERN')
             OR v_reg_plan_anterior.cod_grupo_plan = 'VEXPAN' OR get_segmento(v_reg_plan_anterior.cod_plan) = 'INTERMVPRE'
           )
           AND ( get_linea_negocio(v_reg_plan_nuevo.cod_plan) IN (c_linea_negocio_poscon,
                                                                c_linea_negocio_hibrid_prepag,
                                                                c_linea_negocio_fija)
                OR get_segmento(v_reg_plan_nuevo.cod_plan) IN ('INTERESHIB','INTERMVHIB') )
           )
           OR  v_reg_plan_anterior.cod_grupo_plan = 'PREANU' THEN


            IF v_reg_plan_anterior.cod_grupo_plan = 'PREANU' THEN

                po_cod_err := 'PVT-5016'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al obtener el la vigencia de recarga para renovar fechas.
                SELECT supervision_period
                  INTO v_fch_expiracion
                FROM cl_lifecycle
                WHERE internal_id = v_reg_entidad_consumo.id_entidad_consumo;

                po_cod_err := 'PVT-5017'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta el registro con nuevo ciclo de vida (Prepago Anual).
                tx_cl_lifecycle.generate_subscriber_dates(
                                                           pi_internal_id        => v_reg_entidad_consumo.id_entidad_consumo,
                                                           pi_expiration_date    => v_fch_expiracion,
                                                           pi_transaction_reason => 'PREPAID_OFFER_MIGRATION',
                                                           pi_master             => c_falso,
                                                           pi_tran_id            => v_id_tran,
                                                           pi_tran_date          => v_fch_tran,
                                                           pi_tran_user          => pi_cod_usuario,
                                                           pi_tran_period        => v_cod_gestion_tran,
                                                           po_cod_err            => po_cod_err,
                                                           po_msj_err            => po_msj_err
                                                        );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;


           ELSE
                po_cod_err := 'PVT-5018'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta el registro con nuevo ciclo de vida.
                tx_cl_lifecycle.register_event (pi_internal_id          => v_reg_cambio_plan.id_entidad_consumo,
                                                pi_external_id          => NULL,
                                                pi_transaction_reason   => 'PREPAID_OFFER_MIGRATION',
                                                pi_master               => c_falso,
                                                pi_tran_id              => pi_id_tran,
                                                pi_tran_date            => pi_fch_tran,
                                                pi_tran_user            => pi_cod_usuario,
                                                pi_tran_period          => pi_cod_gestion_tran,
                                                po_cod_err              => po_cod_err,
                                                po_msj_err              => po_msj_err);

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
           END IF;

        ELSIF ((get_linea_negocio(v_reg_plan_anterior.cod_plan) IN (c_linea_negocio_poscon, c_linea_negocio_hibrid_prepag, c_linea_negocio_fija, c_linea_negocio_postpago)
                    OR get_segmento(v_reg_plan_anterior.cod_plan) IN ('INTERESHIB','INTERMVHIB','CASFULL','CASPOS'))
                AND  (get_linea_negocio(v_reg_plan_nuevo.cod_plan) IN (c_linea_negocio_prepago, 'EXTERN')
                    OR get_segmento(v_reg_plan_nuevo.cod_plan) IN ( 'INTERMVPRE','CASPRE')) ) THEN

               --DAR DE ALTA EN CICLO DE VIDA (CL_LIFECYLE)
            SELECT COUNT(1)
              INTO v_aplica_ciclo_vida
            FROM bm_plan_param pp
            WHERE pp.cod_plan = v_reg_plan_nuevo.cod_plan
              AND pp.cod_tipo_parametro = 'LIFE_CYCLE'
              AND pp.fch_tran_fin IS NULL;

            IF v_aplica_ciclo_vida != 0 THEN
                --REGISTRAR EN CL_LIFECYLE
                po_cod_err := 'PVT-4978'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta el nuevo registro para control ciclo de vida (HIBRIDOS)

                IF  v_monto_recarga = 0 THEN
                     v_balance_expiration_date := (v_fch_tran + 30);
                END IF;

                tx_cl_lifecycle.generate_subscriber_dates( pi_internal_id        => v_reg_entidad_consumo.id_entidad_consumo,
                                                           pi_expiration_date    => v_balance_expiration_date,
                                                           pi_transaction_reason => 'HYBRID_OFFER_MIGRATION',
                                                           pi_master             => c_falso,
                                                           pi_tran_id            => v_id_tran,
                                                           pi_tran_date          => v_fch_tran,
                                                           pi_tran_user          => pi_cod_usuario,
                                                           pi_tran_period        => v_cod_gestion_tran,
                                                           po_cod_err            => po_cod_err,
                                                           po_msj_err            => po_msj_err
                                                          );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        --RQX 4119 BUNDLE FASE 1 (Eliseo Reyes)
        --si el segmento del nuevo plan es diferente al segmento del plan anterior se debe terminar los paquetes bundle
        IF get_segmento (v_reg_plan_anterior.cod_plan) <> get_segmento (v_reg_plan_nuevo.cod_plan) THEN
            SELECT COUNT (1)
              INTO v_dummy
              FROM cl_paquete_entidad_consumo cpe
             WHERE cpe.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND cpe.fch_tran_fin = utl_verificacion.get_end_date
               AND cpe.estado = 'A';

            IF v_dummy > c_falso THEN
                po_cod_err := 'PVT-2276';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar el bundle

                BEGIN
                    SELECT cpec.id_paquete
                      INTO v_id_paquete
                      FROM cl_paquete_entidad_consumo cpec
                     WHERE cpec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                       AND cpec.fch_tran_fin = utl_verificacion.get_end_date
                       AND cpec.estado = 'A';
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        v_id_paquete    := NULL;
                END;

                IF v_id_paquete IS NOT NULL THEN
                    po_cod_err := 'PVT-2277';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION : Error al dar de baja al bundle
                    tx_cl_paquete.baja_paquete (pi_id_paquete                  => v_id_paquete,
                                                pi_id_tran                     => v_id_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                pi_master                      => c_falso,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
            END IF;
        END IF;

        --END RQX 4119

        --DESASIGNAR SERVICIO FAVORITO MOCHILERO

        FOR mochilero IN ( SELECT ec.id_entidad_consumo,
                                      ec.identificador_entidad,
                                   cnf.cod_catalogo as tipo_afinidad,
                                   se.cod_servicio
                             FROM cl_entidad_consumo ec,  cnf_catalogo cnf,  cl_servicio_entidad_consumo se,
                                  (SELECT id_persona
                                     FROM cl_entidad_consumo
                                    WHERE id_entidad_consumo = v_reg_cambio_plan.id_entidad_consumo) entidad
                            WHERE ec.id_persona = entidad.id_persona
                              AND ec.cod_plan in ('PREVIVA_TU','VMCP')
                              AND se.id_entidad_consumo = ec.id_entidad_consumo
                              AND se.cod_servicio IN ('NFVIVM','NFVMCM')
                              AND cnf.abreviatura = se.cod_servicio
                              AND se.fch_fin = c_fecha_fin
                              AND se.estado = c_estado_activo)
        LOOP

            tx_pvt_entidad_consumo.actualizar_numero_afin
                             (pi_id_entidad_consumo          => mochilero.id_entidad_consumo,
                              pi_cod_tipo_afinidad           => mochilero.tipo_afinidad,
                              pi_numeros_afines              => NULL,
                              pi_descontar                   => c_falso,
                              pi_cod_usuario                 => pi_cod_usuario,
                              pi_master                      => c_falso,
                              pi_id_tran                     => v_id_tran,
                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                              pi_fch_tran                    => v_fch_inicio_vigencia, --Para en caso de diferirse la orden, suceda lo mismo en favoritos
                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                              po_id_tran                     => v_id_tran,
                              po_cod_gestion_tran            => v_cod_gestion_tran,
                              po_cod_err                     => po_cod_err,
                              po_msj_err                     => po_msj_err
                             );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;


            po_cod_err := 'PVT-2280';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc. de desasignacion de servicios.
            cc_cl_servicio_entidad_consumo.desasignar
                                 (pi_id_entidad_consumo          => mochilero.id_entidad_consumo,
                                  pi_cod_servicio                => mochilero.cod_servicio,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  pi_fch_efectiva                => v_fch_tran,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

        END LOOP;
        -- FIN EVDO CONTROLADO
        IF v_reg_cambio_plan.cod_plan <> v_reg_entidad_consumo.cod_plan THEN
            FOR cdesasig IN curservicios_desasignar (v_reg_cambio_plan.id_entidad_consumo,
                                                     v_reg_cambio_plan.cod_plan)
            LOOP

                po_cod_err := 'PVT-2281';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al obtener los datos del servicio.

                SELECT *
                  INTO v_reg_servicio
                  FROM bm_servicio s
                 WHERE s.cod_servicio = cdesasig.cod_servicio;

                IF v_reg_servicio.cod_tipo_servicio = c_tipo_serv_numfav THEN
                    po_cod_err := 'PVT-2282';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al determinar el tipo de afinidad.

                    SELECT ce.parametro_1
                      INTO v_cod_tipo_afinidad
                      FROM cnf_configuracion_especial ce
                     WHERE ce.tipo = 'NUMEROS_FAVORITOS' AND ce.cod_registro = cdesasig.cod_servicio;

                    tx_pvt_entidad_consumo.actualizar_numero_afin
                                     (pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                                      pi_cod_tipo_afinidad           => v_cod_tipo_afinidad,
                                      pi_numeros_afines              => NULL,
                                      pi_descontar                   => c_falso,
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_master                      => c_falso,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_inicio_vigencia, --Fix para que la orden se envie cuando corresponda
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      po_id_tran                     => v_id_tran,
                                      po_cod_gestion_tran            => v_cod_gestion_tran,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;

                po_cod_err := 'PVT-2283';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc. de desasignacion de servicios.
                cc_cl_servicio_entidad_consumo.desasignar
                                     (pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                                      pi_cod_servicio                => cdesasig.cod_servicio,
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_tran,
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      pi_fch_efectiva                => v_fch_inicio_vigencia,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;


                --PROVISIONAR EL SERVICIO SI ES PROVISIONABLE

                SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_plan_anterior.cod_plan, 'OFFER_ID', 'VPG_CNF')
                  INTO v_offer_id
                FROM DUAL;

                IF v_reg_servicio.se_provisiona = c_verdadero AND v_offer_id IS NULL THEN
                    IF v_reg_servicio.cod_tipo_servicio IN
                                                  (c_tipo_serv_basico, c_tipo_serv_datos, 'BBDAT') THEN
                        po_cod_err := 'PVT-2284';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.

                        --VPG--

                        v_cod_enlace    := cdesasig.cod_servicio;

                        po_cod_err := 'PVT-5047';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: No existe la Accion al PRV para el servicio.
                        SELECT tx_vpg_util.get_comando(v_cod_enlace, v_reg_entidad_consumo.cod_forma_consumo, 'DEL')
                          INTO v_command_id
                        FROM DUAL;

                        IF cdesasig.cod_servicio = 'SUS4G' THEN

                            IF es_plan_4g(v_reg_cambio_plan.cod_plan) = c_verdadero THEN
                                -- AL QUITAR EL SERVICIO DE SUSPENCION 4G, DEBE PROVISIONARSE DE NUEVO EL HSS EL NUMERO.
                                po_cod_err := 'PVT-5048';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta la orden en el PRV.
                                mt_vpg.alta_orden(
                                            pi_id_comando           => v_command_id,
                                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                            pi_fch_programada       => v_fch_tran,
                                            pi_cod_transaccion      => c_tipo_transaccion,
                                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                            pi_p2                   => tx_vpg_util.get_servicio_param_value('DAT4G', v_reg_entidad_consumo.cod_plan, 'PDPCP', 'VPG_CNF'),
                                            pi_p3                   => v_reg_entidad_consumo.imsi,
                                            pi_p4                   => tx_vpg_util.get_servicio_param_value('DAT4G', v_reg_entidad_consumo.cod_plan, 'EPS_PROFILE_ID', 'VPG_CNF'),
                                            pi_cod_usuario          => pi_cod_usuario,
                                            pi_master               => c_falso,
                                            pi_id_tran              => pi_id_tran,
                                            pi_cod_gestion_tran     => pi_cod_gestion_tran,
                                            pi_fch_tran             => pi_fch_tran,
                                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                            po_id_orden             => v_id_orden,
                                            po_id_tran              => po_id_tran,
                                            po_fch_tran             => po_fch_tran,
                                            po_cod_err              => po_cod_err,
                                            po_msj_err              => po_msj_err
                                            );

                                IF po_cod_err <> 'OK' THEN
                                    RAISE err_app;
                                END IF;
                            END IF;

                        ELSE

                            po_cod_err := 'PVT-5048';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta la orden en el PRV.
                            mt_vpg.alta_orden(
                                        pi_id_comando           => v_command_id,
                                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                        pi_fch_programada       => v_fch_tran,
                                        pi_cod_transaccion      => c_tipo_transaccion,
                                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                        pi_p2                   => CASE WHEN cdesasig.cod_servicio IN ('DAT4G','APNDATA','APNDAT2') THEN v_reg_entidad_consumo.imsi ELSE v_reg_entidad_consumo.id_entidad_consumo END,
                                        pi_cod_usuario          => pi_cod_usuario,
                                        pi_master               => c_falso,
                                        pi_id_tran              => pi_id_tran,
                                        pi_cod_gestion_tran     => pi_cod_gestion_tran,
                                        pi_fch_tran             => pi_fch_tran,
                                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                        po_id_orden             => v_id_orden,
                                        po_id_tran              => po_id_tran,
                                        po_fch_tran             => po_fch_tran,
                                        po_cod_err              => po_cod_err,
                                        po_msj_err              => po_msj_err
                                        );

                            IF po_cod_err <> 'OK' THEN
                                RAISE err_app;
                            END IF;
                        END IF;



                    END IF;

                ELSIF v_offer_id IS NOT NULL THEN

                    po_cod_err := 'PVT-5173';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: No existe la Accion al PRV para el servicio.
                    SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                      INTO v_command_id
                    FROM DUAL;

                    mt_vpg.alta_orden(
                                pi_id_comando           => v_command_id,
                                pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_fch_programada       => v_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_p3                   => v_offer_id,
                                pi_p4                   => 'D',
                                pi_p5                   => NULL, --Fecha Vigencia
                                pi_p6                   => NULL, --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;


                END IF;

            END LOOP;

            po_cod_err := 'PVT-2289';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al convertir el esn a hexadecimal.
            v_esn_hex     := tx_cl_serial_robado.dec_to_hex (v_reg_entidad_consumo.imsi);

            IF    v_reg_cambio_plan.cod_plan NOT IN ('PREPAGO_P', 'PREPAGO_DS', 'PREPAGO_TU','PREVIVA_TU')
               OR pi_cod_usuario <> 'OMEGA' THEN   -- ugly hack migracion PREPAGO_P
                --evitar asignar servicios por defecto al nuevo plan PREPAGO_NP
                FOR casig IN curservicios_asignar (v_reg_cambio_plan.id_entidad_consumo,
                                                   v_reg_cambio_plan.cod_plan)
                    LOOP
                    po_cod_err := 'PVT-2290';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc. de asignacion de servicios.
                    tx_pvt_entidad_consumo.asignar_servicio
                                         (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                          pi_cod_servicio                => casig.cod_servicio,
                                          pi_complemento                 => v_reg_entidad_consumo.identificador_entidad,
                                          pi_cod_usuario                 => pi_cod_usuario,
                                          pi_master                      => c_falso,
                                          pi_id_tran                     => v_id_tran,
                                          pi_cod_gestion_tran            => v_cod_gestion_tran,
                                          pi_fch_tran                    => v_fch_tran,
                                          pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                          po_id_tran                     => v_id_tran,
                                          po_cod_gestion_tran            => v_cod_gestion_tran,
                                          po_cod_err                     => po_cod_err,
                                          po_msj_err                     => po_msj_err
                                         );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END LOOP;
            END IF;   -- END ugly hack migracion PREPAGO_NP
        END IF;

        IF v_reg_plan_nuevo.es_empleado = c_verdadero AND v_reg_plan_nuevo.cod_forma_consumo = 'CCOPRE' THEN

            po_cod_err := 'PVT-2248';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
            SELECT tx_vpg_util.get_comando('PAM', v_reg_plan_nuevo.cod_forma_consumo, 'ADD')
              INTO v_command_id
            FROM DUAL;

            po_cod_err := 'PVT-5203';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
            mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_cod_transaccion      => v_cod_tran,
                    pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                    pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_p3                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan,'PAM_CLASS_ID_EMP', 'VPG_CNF'),
                    pi_p4                   => tx_vpg_util.get_plan_param_value(v_reg_plan_nuevo.cod_plan,'PAM_SCHEDULE_ID_EMP', 'VPG_CNF'),
                    pi_p6                   => '2',
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => pi_id_tran,
                    pi_cod_gestion_tran     => pi_cod_gestion_tran,
                    pi_fch_tran             => pi_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_id_orden,
                    po_id_tran              => v_id_tran,
                    po_fch_tran             => v_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;


        END IF;

        -- SUBSIDIOS
        -- Anular subsidios afectados
        po_cod_err := 'PVT-2296';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar anular subsidios
        tx_subsidio.consolidar_prospecto_subsidios
                                              (pi_id_prospecto_cp             => v_reg_cambio_plan.id_prospecto,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_master                      => c_falso,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        v_remplazar_subsidio_plan := c_falso;
        v_migrar_subsidio_plan    := c_falso;
        SELECT COUNT(1)
        INTO v_dummy
        FROM cnf_configuracion_especial ce
            ,TABLE(tx_utiles.split(ce.parametro_8)) t
        WHERE ce.tipo = 'CARGOS_X_COBRAR'
        AND ce.cod_registro = 'TX_TRAN_MIGRACION'
        AND ce.nombre_8 = 'EXCEPCION_PLAN'
        AND ce.parametro_8 IS NOT NULL
        AND t.valor = v_reg_plan_nuevo.cod_plan;

        IF v_dummy > 0 THEN
            FOR c_subsidio_bb IN (  SELECT *
                                    FROM cl_subsidio_ec
                                    WHERE concepto = tx_subsidio.c_subs_bb
                                    AND id_entidad_consumo = v_reg_cambio_plan.id_entidad_consumo
                                    AND estado = c_estado_activo
                                    AND ADD_MONTHS(fch_ini_vigencia,vigencia) > v_fch_tran
                                )
            LOOP
                po_cod_err := 'PVT-2297';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al procedimiento TX_SUBSIDIO.BAJA.
                tx_subsidio.baja
                (
                    pi_id_subsidio          => c_subsidio_bb.id_subsidio,
                    pi_estado               => c_estado_inactivo,
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END LOOP;

            IF v_cod_linea_negocio_anterior = v_cod_linea_negocio_nuevo THEN
                SELECT COUNT(1)
                INTO v_dummy
                FROM cnf_configuracion_especial ce
                    ,TABLE(tx_utiles.split(ce.parametro_8)) t
                WHERE ce.tipo = 'CARGOS_X_COBRAR'
                AND ce.cod_registro = 'TX_TRAN_MIGRACION'
                AND ce.nombre_8 = 'EXCEPCION_PLAN'
                AND ce.parametro_8 IS NOT NULL
                AND t.valor = v_reg_plan_anterior.cod_plan;

                IF v_dummy = 0 THEN
                    v_remplazar_subsidio_plan := c_verdadero;
                ELSE
                    IF v_reg_plan_anterior.tarifa_basica < v_reg_plan_nuevo.tarifa_basica THEN
                        IF v_cod_linea_negocio_nuevo = 'POSCON' THEN
                            v_remplazar_subsidio_plan := c_verdadero;
                        ELSIF v_cod_linea_negocio_nuevo = 'HIBRID' THEN
                            v_remplazar_subsidio_plan := c_verdadero;
                            v_migrar_subsidio_plan    := c_verdadero;
                        END IF;
                    END IF;
                END IF;
            END IF;
        END IF;

        IF v_migrar_subsidio_plan = c_verdadero THEN
            po_cod_err := 'PVT-2298';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al buscar la penalidad por subsidio de plan.
            FOR c_subsidio_plan IN (SELECT s.id_subsidio,s.meses_incumplimiento-DECODE(s.meses_vigencia,18,6,0) AS meses_incumplimiento, s.monto_penalidad_simp
                                    FROM TABLE(tx_subsidio.get_subsidios(v_reg_cambio_plan.id_entidad_consumo)) s
                                    WHERE s.concepto = tx_subsidio.c_subs_plan
                                    )
            LOOP
                po_cod_err := 'PVT-2299';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al procedimiento TX_SUBSIDIO.BAJA.
                tx_subsidio.baja
                (
                    pi_id_subsidio          => c_subsidio_plan.id_subsidio,
                    pi_estado               => 'M',
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-2300';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al procedimiento TX_SUBSIDIO.ALTA.
                tx_subsidio.alta
                (
                    pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                    pi_cod_tipo_documento          => 'PENDES',
                    pi_concepto                    => tx_subsidio.c_subs_plan_mig,
                    pi_vigencia                    => c_subsidio_plan.meses_incumplimiento,
                    pi_monto                       => c_subsidio_plan.monto_penalidad_simp,
                    pi_fch_ini_vigencia            => v_fch_tran + INTERVAL '1' SECOND,   -- 1 segundo para evitar colisiones con los anteriores subsidios
                    pi_cod_origen                  => 'CONCPL',
                    pi_id_prospecto                => v_reg_cambio_plan.id_prospecto,
                    pi_id_prospecto_ec             => NULL,
                    pi_id_prospecto_art            => NULL,
                    pi_reemplazar                  => c_falso,
                    pi_cod_usuario                 => pi_cod_usuario,
                    pi_master                      => c_falso,
                    pi_id_tran                     => pi_id_tran,
                    pi_cod_gestion_tran            => pi_cod_gestion_tran,
                    pi_fch_tran                    => pi_fch_tran,
                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                    po_id_subsidio                 => v_id_subsidio,
                    po_cod_err                     => po_cod_err,
                    po_msj_err                     => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END LOOP;
        END IF;

        IF v_cod_linea_negocio_anterior = 'HIBRID' THEN
            FOR c_subsidios IN (SELECT *
                                FROM cl_subsidio_ec s
                                WHERE s.id_entidad_consumo = v_reg_cambio_plan.id_entidad_consumo
                                AND s.estado = c_estado_activo
                                AND s.fch_fin = c_fecha_fin
                                AND s.concepto = tx_subsidio.c_subs_plan
                                AND ADD_MONTHS(s.fch_ini_vigencia,s.vigencia) >= v_fch_tran
                                AND NOT EXISTS (SELECT 1
                                                FROM TABLE(tx_subsidio.get_subsidios(s.id_entidad_consumo)) p
                                                WHERE p.concepto = s.concepto
                                                )
                                )
            LOOP
                po_cod_err := 'PVT-2301';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al procedimiento TX_SUBSIDIO.BAJA.
                tx_subsidio.baja
                (
                    pi_id_subsidio          => c_subsidios.id_subsidio,
                    pi_estado               => 'E',
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END LOOP;
        END IF;

        -- migraciones a planes Tarifa Unica deben registrar el subsidio del plan
        v_cnftu                := tx_bm_plan.get_rgst_tu_config (v_reg_cambio_plan.cod_plan);

        IF     v_cnftu.cod_plan IS NOT NULL
           AND v_cnftu.subsidio > 0
           AND (v_cnftu.cod_servicio_opt IS NULL OR v_reg_cambio_plan.con_contrato = c_verdadero) THEN
            po_cod_err := 'PVT-2302';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error registrar subsidio de plan
            tx_subsidio.alta
                (pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                 pi_cod_tipo_documento          => 'PENDES',
                 pi_concepto                    => tx_subsidio.c_subs_plan,
                 pi_vigencia                    => v_cnftu.vigencia,
                 pi_monto                       => v_cnftu.subsidio * v_cnftu.vigencia,
                 pi_fch_ini_vigencia            => v_fch_tran + INTERVAL '1' SECOND,   -- 1 segundo para evitar colisiones con los anteriores subsidios
                 pi_cod_origen                  => 'CONCPL',
                 pi_id_prospecto                => v_reg_cambio_plan.id_prospecto,
                 pi_id_prospecto_ec             => NULL,
                 pi_id_prospecto_art            => NULL,
                 pi_reemplazar                  => v_remplazar_subsidio_plan,
                 pi_cod_usuario                 => pi_cod_usuario,
                 pi_master                      => c_falso,
                 pi_id_tran                     => pi_id_tran,
                 pi_cod_gestion_tran            => pi_cod_gestion_tran,
                 pi_fch_tran                    => pi_fch_tran,
                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                 po_id_subsidio                 => v_id_subsidio,
                 po_cod_err                     => po_cod_err,
                 po_msj_err                     => po_msj_err
                );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- END SUBSIDIOS

        --SI ES PAGO DIFERIDO SE DEBE GENERAR EL CARGO PARA LA SIGUIENTE FACTURA
        IF v_reg_cambio_plan.es_pago_diferido = c_verdadero THEN
            FOR c_cargos IN (   SELECT *
                                FROM vta_venta_prospecto_detalle vvpd
                                WHERE vvpd.id_prospecto = v_reg_cambio_plan.id_prospecto
                                AND vvpd.valor_venta > 0
                            )
            LOOP
                IF c_cargos.id_cargo = c_id_cargo_prorrateo_plan THEN
                    v_se_creo_cargo_prorrateo    := c_verdadero;
                END IF;

                po_cod_err := 'PVT-2303';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al procedimiento TX_PVT_CCS.ASIGNAR_CARGO.
                tx_pvt_ccs.asignar_cargo
                (
                    pi_id_cliente                  => v_id_cliente,
                    pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                    pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_cod_local                   => NULL,
                    pi_cod_tipo_documento          => NULL,
                    pi_id_cargo                    => c_cargos.id_cargo,        -- c_id_cargo_prorrateo_plan,
                    pi_monto                       => c_cargos.valor_venta,     -- v_reg_cambio_plan.precio_venta,
                    pi_es_diferido                 => c_verdadero,
                    pi_cod_usuario                 => pi_cod_usuario,
                    pi_master                      => c_falso,
                    pi_id_tran                     => v_id_tran,
                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                    pi_fch_tran                    => v_fch_tran,
                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                    po_id_documento                => v_id_documento,
                    po_id_tran                     => v_id_tran,
                    po_cod_gestion_tran            => v_cod_gestion_tran,
                    po_cod_err                     => po_cod_err,
                    po_msj_err                     => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END LOOP;
        END IF;

        IF v_cod_linea_negocio_nuevo IN (c_linea_negocio_poscon,
                                         c_linea_negocio_postpago,
                                         c_linea_negocio_postpago_cor
                                        ) THEN
            IF v_reg_cambio_plan.id_prospecto_mig IS NULL THEN
                v_monto_tarifas_basicas    :=
                               tx_pvt_comunidad.get_limite_credito (v_reg_cambio_plan.id_comunidad);
                -- Limite de credito de la comunidad facturante
                po_cod_err := 'PVT-2304';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar a CC_CL_LIMITE_CREDITO_COMUNIDAD.ASIGNAR
                cc_cl_limite_credito_comunidad.asignar
                                              (pi_id_comunidad                => v_reg_cambio_plan.id_comunidad,
                                               pi_cod_tipo_limite_credito     => c_tipo_limite_credito,
                                               pi_limite_credito              => v_monto_tarifas_basicas,
                                               pi_limite_actual               => NULL,
                                               pi_id_proc_ems                 => NULL,
                                               pi_id_orig_proc_ems            => NULL,
                                               pi_id_form_ems                 => NULL,
                                               pi_id_orig_form_ems            => NULL,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               pi_fch_efectiva                => NULL,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

               SELECT COUNT(1)
                    INTO v_dummy
               FROM cl_entidad_consumo ec, v_plan_segmento ps
               WHERE ec.id_comunidad_facturante = v_reg_cambio_plan.id_comunidad
               AND ec.estado NOT IN ('I','TER','POST')
               AND ps.cod_plan = ec.cod_plan
               AND ps.cod_grupo_plan IN ('POSINF');

               --CREAR CUENTA COMPARTIDAD PARA LIMITE DE CREDITO EN CS
               IF v_dummy <> c_falso THEN

                    tx_cl_cta_compartida.alta_relacion(
                        pi_id_comunidad             => v_reg_cambio_plan.id_comunidad,
                        pi_cod_tipo_enlace          => c_tipo_limite_credito,
                        pi_cod_usuario              => pi_cod_usuario,
                        pi_master                   => c_falso,
                        pi_id_tran                  => v_id_tran,
                        pi_fch_tran                 => v_fch_tran,
                        pi_cod_gestion_tran         => v_cod_gestion_tran,
                        pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                        po_id_cuenta                => v_dummy,
                        po_id_tran                  => v_id_tran,
                        po_fch_tran                 => v_fch_tran,
                        po_cod_err                  => po_cod_err,
                        po_msj_err                  => po_msj_err);


                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

               END IF;


            END IF;
        END IF;

        --Ordenes de cammbio de plan diferidas
        IF v_fch_inicio_vigencia > SYSDATE THEN
            po_cod_err := 'PVT-6030';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al actualizar la orden.
            UPDATE vpg_app.sys_order_list o
                SET o.order_status_code = 'D',
                    o.scheduled_date = v_fch_inicio_vigencia
            WHERE o.consumer_entity_id = v_reg_cambio_plan.id_entidad_consumo
                AND o.tran_id = v_id_tran
                AND o.order_status_code = 'PEN';
        END IF;

        --CAMBIO DE ESTADO DEL PROSPECTO DE VENTA A PAGADO
        po_cod_err := 'PVT-2305';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al procedimiento CC_VTA_CAMBIO_PLAN.CAMBIA_ESTADO
        cc_vta_cambio_plan.cambia_estado (pi_id_prospecto                => pi_id_prospecto,
                                          pi_estado                      => c_estado_pagado,
                                          pi_cod_usuario                 => pi_cod_usuario,
                                          pi_id_tran                     => v_id_tran,
                                          pi_cod_gestion_tran            => v_cod_gestion_tran,
                                          pi_fch_tran                    => v_fch_tran,
                                          pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                          po_cod_err                     => po_cod_err,
                                          po_msj_err                     => po_msj_err
                                         );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

       --Inicio notifica_credito. RQX 5113 Notificacion de aumento o disminucion de credito a clientes postpagos
       --Alicia Acevedo   7/7/2014 10:50 AM.
        po_cod_err := 'PVT-2306';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al enviar msj de de cambio de limite de credito.
        notifica_credito(
                           pi_id_prospecto_cambio_plan    => pi_id_prospecto,
                           --Transaccionales
                           pi_id_tran                     => v_id_tran,
                           pi_fch_tran                    => v_fch_tran,
                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                           pi_cod_usuario                 => pi_cod_usuario,
                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                           pi_master                      => c_falso,
                           -- Parametros de salida
                           po_id_sms                      => v_id_mensaje,
                           po_cod_err                     => po_cod_err,
                           po_msj_err                     => po_msj_err
                         );
        IF po_cod_err <> 'OK' THEN
           RAISE err_app;
        END IF;
         -- Fin Notifica Credito

        IF     v_reg_plan_nuevo.es_tarifable = c_verdadero
           AND v_reg_plan_anterior.es_tarifable = c_verdadero THEN
            po_cod_err := 'PVT-2307';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc TX_TR_TARIFADOR_INDIVIDUAL.RETARIFAR_MINUTOS_LIBRES
            tx_tr_tarifador_individual.retarifar_minutos_libres
                                    (pi_id_cliente                  => v_id_cliente,
                                     pi_id_comunidad                => v_reg_cambio_plan.id_comunidad,
                                     pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                                     pi_cod_plan_antig              => v_reg_plan_anterior.cod_plan,
                                     pi_cod_plan_nuevo              => v_reg_plan_nuevo.cod_plan,
                                     pi_cod_usuario                 => pi_cod_usuario,
                                     pi_master                      => c_falso,
                                     pi_id_tran                     => v_id_tran,
                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                     pi_fch_tran                    => v_fch_tran,
                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                     po_id_tran                     => v_id_tran,
                                     po_cod_gestion_tran            => v_cod_gestion_tran,
                                     po_cod_err                     => po_cod_err,
                                     po_msj_err                     => po_msj_err
                                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;


        --ENVIAR ORDENES AL PRV SI SON INMEDIATAS
        po_cod_err := 'PVT-2308';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al enviar las ordenes al provisionador.
        tx_cl_orden_prv.procesar (pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        BEGIN
            SELECT COUNT (*)
              INTO v_existe
              FROM bm_plan_cambio_plan
             WHERE cod_plan_hijo IN (v_reg_plan_nuevo.cod_plan)
               AND cod_plan_padre IN (v_reg_plan_anterior.cod_plan);

            v_cod_observacion            := 'CPME';
            v_descripcion_observacion    := 'CAMBIO DE PLAN';
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                NULL;
        END;

        IF (    (   v_cod_linea_negocio_anterior IN (c_linea_negocio_full, c_linea_negocio_hibrid_prepag)
                 OR v_cod_linea_negocio_anterior = c_linea_negocio_postpago
                )
            AND (v_cod_linea_negocio_nuevo IN (c_linea_negocio_prepago, 'EXTERN'))
           ) THEN
            v_cod_observacion            := 'CPPP';
            v_descripcion_observacion    := 'CAMBIO DE PLAN';
        END IF;

        IF (    (   v_cod_linea_negocio_anterior IN (c_linea_negocio_full, c_linea_negocio_hibrid_prepag)
                 OR v_cod_linea_negocio_anterior IN (c_linea_negocio_prepago, 'EXTERN')
                )
            AND (v_cod_linea_negocio_nuevo = c_linea_negocio_postpago)
           ) THEN
            v_cod_observacion            := 'CPPO';
            v_descripcion_observacion    := 'CAMBIO DE PLAN';
        END IF;

        po_cod_err := 'PVT-2309';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al determinar el id del cliente.
        v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        po_cod_err := 'PVT-2310';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar forma de consumo del plan anterior
        v_trama_anterior_pv    :=    'Codigo:'
                                  || v_reg_entidad_consumo.cod_plan
                                  || '|'
                                  || 'Descripcion:'
                                  || v_reg_plan_anterior.descripcion;
        v_trama_nuevo_pv       :=    'Codigo:'
                                  || v_reg_cambio_plan.cod_plan
                                  || '|'
                                  || 'Descripcion:'
                                  || v_reg_plan_nuevo.descripcion
                                  || '|'
                                  || 'Contrato:'
                                  || v_reg_cambio_plan.con_contrato;
        --- Registrar transaccion
        po_cod_err := 'PVT-2311';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
        cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => v_reg_cambio_plan.id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => v_cod_observacion,
                                   pi_descripcion_observacion     => v_descripcion_observacion,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        -- <ECN 20081202    RQX 841 - 100 Minutos ONNET Gratis.
        IF     v_reg_plan_nuevo.creacion_pps = 2
           AND v_reg_plan_nuevo.cod_plan = 'VMCP'
           AND NVL (v_reg_plan_nuevo.pps_free_seconds, 0) > 0 THEN


            --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
            po_cod_err := 'PVT-5056'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
            SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
               INTO v_command_id
            FROM DUAL;

            v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_promotional_balance_1);

            po_cod_err := 'PVT-5057'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al provisionar la recarga de los bolsillos en CS.
            mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_inicio_vigencia,
                    pi_cod_transaccion      => v_cod_tran,
                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                    pi_p4                   => NVL (v_reg_plan_nuevo.pps_free_seconds, 0),
                    pi_p5                   => 'RECARGA EN MIGRACION',
                    pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                    pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                    pi_p8                   => NULL, --balance_start_date
                    pi_p9                   => TO_CHAR (SYSDATE + 30, 'YYYY-MM-DD'), --balance_expiry_date
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => '0',
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_po_id_orden,
                    po_id_tran              => v_po_id_tran,
                    po_fch_tran             => v_po_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
            --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------
        END IF;

        -- ECN 20081202    RQX 841 - 100 Minutos ONNET Gratis.>

        -- carga minutos prorrateados
        IF v_reg_plan_nuevo.cod_grupo_plan = 'HIBRBB' THEN
            IF v_cod_linea_negocio_anterior IN ('PREPAG', 'EXTERN') THEN
                v_prorrateo    := ROUND (calcular_recarga_hibrbb (v_reg_cambio_plan.cod_plan));
            ELSE
                --hibridos blackberry reciben de recarga el monto de su plan menos el costo del feature de blackberry
                v_prorrateo    :=
                    ROUND
                        (tx_cl_activacion.get_valor_prorateo
                                   (pi_cod_ciclo                   => v_cod_ciclo,
                                    pi_valor                       => calcular_recarga_hibrbb
                                                                          (v_reg_cambio_plan.cod_plan)));
            END IF;
        ELSE
            BEGIN
                SELECT vpd.valor,
                       vpd.valor_venta
                  INTO v_prorrateo,
                       v_valor_venta
                  FROM vta_cambio_plan cp, vta_venta_prospecto_detalle vpd
                 WHERE cp.estado = c_estado_pagado
                   AND NVL (cp.id_prospecto_mig, cp.id_prospecto) = vpd.id_prospecto
                   AND cp.id_prospecto = pi_id_prospecto
                   AND vpd.cod_tipo_documento = c_tipo_doc_prorrateo_plan
                   AND vpd.id_prospecto_ec = v_reg_cambio_plan.id_prospecto;
            EXCEPTION
                WHEN OTHERS THEN
                    v_prorrateo    := 0;
            END;
        END IF;

        -- si no se encontró prorrateo en prospecto (migración), calcularlo directamente
        IF v_prorrateo = 0 THEN
            BEGIN
                SELECT SUM(NVL(monto, 0))
                  INTO v_prorrateo
                  FROM TABLE(tx_pvt_ccs.get_prorrateo_cambio_plan(
                      v_reg_cambio_plan.cod_plan,
                      v_cod_ciclo,
                      v_reg_entidad_consumo.cod_plan
                  ));
            EXCEPTION
                WHEN OTHERS THEN
                    v_prorrateo := 0;
            END;
            v_valor_venta := v_prorrateo;
        END IF;

        -- determinar si es un combos bb corporativo
        SELECT COUNT (1)
          INTO v_bb_control_empresarial
          FROM cnf_configuracion_especial cne, bm_plan p, bm_grupo_plan gp
         WHERE cne.nombre_tabla = 'BM_PLAN'
           AND cne.tipo = 'PLANES_BB_CONTROL'
           AND p.cod_plan IN (SELECT *
                                FROM TABLE (SELECT tx_utiles.SPLIT (cne.parametro_1)
                                              FROM DUAL))
           AND p.cod_grupo_plan = gp.cod_grupo_plan
           AND p.cod_plan = v_reg_cambio_plan.cod_plan;

        IF v_prorrateo > 0 AND v_valor_venta > 0 AND v_se_creo_cargo_prorrateo = c_falso THEN
            po_cod_err := 'PVT-2313';
            tx_pvt_ccs.asignar_cargo
                            (pi_id_cliente                  => v_id_cliente,
                             pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                             pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                             pi_cod_local                   => NULL,
                             pi_cod_tipo_documento          => NULL,
                             pi_id_cargo                    => c_id_cargo_prorrateo_plan,
                             pi_monto                       => v_valor_venta,
                             pi_es_diferido                 => c_verdadero,
                             pi_cod_usuario                 => pi_cod_usuario,
                             pi_master                      => c_falso,
                             pi_id_tran                     => v_id_tran,
                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                             pi_fch_tran                    => v_fch_tran,
                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                             po_id_documento                => v_id_documento,
                             po_id_tran                     => v_id_tran,
                             po_cod_gestion_tran            => v_cod_gestion_tran,
                             po_cod_err                     => po_cod_err,
                             po_msj_err                     => po_msj_err
                            );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- aplicar recarga prorrateada a combos bb corporativo
        IF v_prorrateo > 0 AND v_bb_control_empresarial > 0 THEN
            IF v_se_creo_cargo_prorrateo = c_falso THEN
                po_cod_err := 'PVT-2313';
                tx_pvt_ccs.asignar_cargo
                                (pi_id_cliente                  => v_id_cliente,
                                 pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                 pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_cod_local                   => NULL,
                                 pi_cod_tipo_documento          => NULL,
                                 pi_id_cargo                    => c_id_cargo_prorrateo_plan,
                                 pi_monto                       => v_valor_venta,
                                 pi_es_diferido                 => c_verdadero,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_id_documento                => v_id_documento,
                                 po_id_tran                     => v_id_tran,
                                 po_cod_gestion_tran            => v_cod_gestion_tran,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;

            IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_gsm THEN
                v_accion    := 334;   --GSM C1CreditAccount
            ELSE
                v_accion    := 335;   --C1CreditAccount
            END IF;

            v_reg_periodo         := tx_tr_periodo_facturacion.get_periodo_vigente (v_cod_ciclo);
            v_cod_transaccion     := 'TX_TRAN_CAMBIO_PLAN';
            v_vigencia_fin_pps    := TO_CHAR (v_reg_periodo.periodo_fin, 'YYYY-MM-DD') || 'T' || TO_CHAR (v_reg_periodo.periodo_fin, 'HH24:MI:SS')
                                     || '-04:00';
            v_comentario          := 'RECARGA EN CAMBIO/MIGRACION PLAN';

            IF NVL (v_reg_plan_nuevo.pps_free_seconds, 0) > 0 THEN

                v_monto_recarga_prv := ROUND(tx_cl_activacion.get_valor_prorateo(v_cod_ciclo,v_reg_plan_nuevo.pps_free_seconds));

                --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
                po_cod_err := 'PVT-5058'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
                SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                   INTO v_command_id
                FROM DUAL;

                v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_free_seconds_balance);

                po_cod_err := 'PVT-5059'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al provisionar la recarga de los bolsillos en CS.
                mt_vpg.alta_orden(
                        pi_id_comando           => v_command_id,
                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_fch_programada       => v_fch_inicio_vigencia,
                        pi_cod_transaccion      => v_cod_transaccion,
                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                        pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                        pi_p4                   => NVL(v_monto_recarga_prv, 0),
                        pi_p5                   => v_comentario,
                        pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                        pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                        pi_p8                   => NULL, --balance_start_date
                        pi_p9                   => SUBSTR(v_vigencia_fin_pps, 1, 10), --balance_expiry_date
                        pi_cod_usuario          => pi_cod_usuario,
                        pi_master               => '0',
                        pi_id_tran              => v_id_tran,
                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                        pi_fch_tran             => v_fch_tran,
                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                        po_id_orden             => v_po_id_orden,
                        po_id_tran              => v_po_id_tran,
                        po_fch_tran             => v_po_fch_tran,
                        po_cod_err              => po_cod_err,
                        po_msj_err              => po_msj_err
                        );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
                --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------

            END IF;
        END IF;

        IF v_prorrateo > 0 AND v_bb_control_empresarial = 0 AND es_plan_4g(v_reg_plan_nuevo.cod_plan) = c_falso THEN
            po_cod_err := 'PVT-2314';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: error al cargar los minutos prorrateados.

            IF v_reg_cambio_plan.cod_plan LIKE 'FFA%' THEN

                --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------

                po_cod_err := 'PVT-5060'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error obtener el refill profile id.
                v_refill_profile_id := tx_cnf_vigencia_carga.get_refill_profile_id(v_reg_plan_nuevo.cod_grupo_plan, v_prorrateo);

                IF  v_refill_profile_id IS NULL THEN
                    po_cod_err := 'PVT-5061'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: El monto no tiene configurado un refill profile id.
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-5062'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el VPG a invocar.
                SELECT tx_vpg_util.get_comando('RECARGA_NV', v_reg_plan_nuevo.cod_forma_consumo, 'ADD')
                   INTO v_command_id
                FROM DUAL;

                po_cod_err := 'PVT-5063'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al dar de alta orden para carga de balance.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_inicio_vigencia,
                            pi_cod_transaccion      => 'TX_TRAN_CAMBIO_PLAN',
                            pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                            pi_p2                   => 'ADM',
                            pi_p3                   => 'RECARGA EN CAMBIO/MIGRACION PLAN',
                            pi_p4                   => v_id_tran,
                            pi_p5                   => tx_vpg_util.date2iso(v_fch_tran),
                            pi_p6                   => tx_vpg_util.number2cs(v_prorrateo),
                            pi_p7                   => v_refill_profile_id,
                            pi_p8                   => NULL, --External Data 1
                            pi_p9                   => NULL, --External Data 2
                            pi_p10                  => NULL, --External Data 3
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------

            ELSE
                IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_gsm THEN
                    v_accion    := 334;
                ELSE
                    v_accion    := 335;
                END IF;

                IF v_cnftu.cod_plan IS NOT NULL THEN
                    --planes con tarifa unica deben proratear la recarga de segundos
                    -- aplicamos regla de 3 para obtener el monto de segundos correspondiente al monto prorateado
                    IF v_cod_linea_negocio_anterior IN ('PREPAG', 'EXTERN') THEN
                        v_prv_monto    := v_cnftu.recarga;
                    ELSE
                        v_prv_monto    :=
                            ROUND (tx_cl_activacion.get_valor_prorateo (v_cod_ciclo,
                                                                        v_cnftu.recarga));
                    END IF;

                    v_prv_bolsillo    := 32;
                ELSE
                    v_prv_monto       := v_prorrateo;
                    v_prv_bolsillo    := tx_sapi.c_bal_promotional_balance_1;
                END IF;

                v_reg_periodo         := tx_tr_periodo_facturacion.get_periodo_vigente (v_cod_ciclo);
                v_cod_transaccion     := 'TX_TRAN_CAMBIO_PLAN';
                v_vigencia_fin_pps    :=    TO_CHAR (v_reg_periodo.periodo_fin, 'YYYY-MM-DD')
                                         || 'T'
                                         || TO_CHAR (v_reg_periodo.periodo_fin, 'HH24:MI:SS')
                                         || '-04:00';
                v_comentario          := 'RECARGA EN CAMBIO/MIGRACION PLAN';

                --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
                po_cod_err := 'PVT-5064'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al recuperar la accion para el VPG a invocar.
                SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
                   INTO v_command_id
                FROM DUAL;

                v_bolsillos_cs := tx_ecms.get_C1toEcms(v_prv_bolsillo);

                po_cod_err := 'PVT-5065'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al provisionar la recarga de los bolsillos en CS.
                mt_vpg.alta_orden(
                        pi_id_comando           => v_command_id,
                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_fch_programada       => v_fch_inicio_vigencia,
                        pi_cod_transaccion      => v_cod_transaccion,
                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                        pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                        pi_p4                   => NVL(v_prv_monto, 0),
                        pi_p5                   => v_comentario,
                        pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                        pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                        pi_p8                   => NULL, --balance_start_date
                        pi_p9                   => tx_cnf_constante.get_constante ('VIGENCIA_FIN_ECMS'), --balance_expiry_date
                        pi_cod_usuario          => pi_cod_usuario,
                        pi_master               => '0',
                        pi_id_tran              => v_id_tran,
                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                        pi_fch_tran             => v_fch_tran,
                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                        po_id_orden             => v_po_id_orden,
                        po_id_tran              => v_po_id_tran,
                        po_fch_tran             => v_po_fch_tran,
                        po_cod_err              => po_cod_err,
                        po_msj_err              => po_msj_err
                        );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
                --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------

                v_monto_recarga_prv := ROUND(tx_cl_activacion.get_valor_prorateo(v_cod_ciclo, v_reg_plan_nuevo.pps_free_seconds));

                IF NVL (v_reg_plan_nuevo.pps_free_seconds, 0) > 0 THEN

                    --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
                    v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_free_seconds_balance);

                    po_cod_err := 'PVT-5066'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al provisionar la recarga de free seconds en CS.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_inicio_vigencia,
                            pi_cod_transaccion      => v_cod_transaccion,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                            pi_p4                   => NVL(v_monto_recarga_prv, 0),
                            pi_p5                   => v_comentario,
                            pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                            pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                            pi_p8                   => NULL, --balance_start_date
                            pi_p9                   => SUBSTR(v_vigencia_fin_pps, 1, 10), --balance_expiry_date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                    --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------

                END IF;

                IF NVL (v_reg_plan_nuevo.pps_promo_balance_2, 0) > 0 THEN

                    v_monto_recarga_prv := ROUND(tx_cl_activacion.get_valor_prorateo(v_cod_ciclo, v_reg_plan_nuevo.pps_promo_balance_2));

                    --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
                    v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_promotional_balance_2);

                    po_cod_err := 'PVT-5067'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al provisionar la recarga de promo balance 2 en CS.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_inicio_vigencia,
                            pi_cod_transaccion      => v_cod_transaccion,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                            pi_p4                   => NVL(v_monto_recarga_prv, 0),
                            pi_p5                   => v_comentario,
                            pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                            pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                            pi_p8                   => NULL, --balance_start_date
                            pi_p9                   => SUBSTR(v_vigencia_fin_pps, 1, 10), --balance_expiry_date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                    --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------
                END IF;

                IF NVL (v_reg_plan_nuevo.pps_sms_balance, 0) > 0 THEN

                    v_monto_recarga_prv := ROUND(tx_cl_activacion.get_valor_prorateo(v_cod_ciclo, v_reg_plan_nuevo.pps_sms_balance));


                    --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
                    v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_sms_balance);

                    po_cod_err := 'PVT-5068'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al provisionar la recarga de promo balance 2 en CS.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_inicio_vigencia,
                            pi_cod_transaccion      => v_cod_transaccion,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                            pi_p4                   => NVL(v_monto_recarga_prv, 0),
                            pi_p5                   => v_comentario,
                            pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                            pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                            pi_p8                   => NULL, --balance_start_date
                            pi_p9                   => SUBSTR(v_vigencia_fin_pps, 1, 10), --balance_expiry_date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                    --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------
                END IF;

                IF NVL (v_reg_plan_nuevo.pps_kbytes, 0) > 0 THEN

                    v_monto_recarga_prv := ROUND(tx_cl_activacion.get_valor_prorateo(v_cod_ciclo,v_reg_plan_nuevo.pps_kbytes));

                    --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
                    v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_kbytes);

                    po_cod_err := 'PVT-5069'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al provisionar la recarga de promo balance 2 en CS.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_inicio_vigencia,
                            pi_cod_transaccion      => v_cod_transaccion,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                            pi_p4                   => NVL(v_monto_recarga_prv, 0),
                            pi_p5                   => v_comentario,
                            pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                            pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                            pi_p8                   => NULL, --balance_start_date
                            pi_p9                   => SUBSTR(v_vigencia_fin_pps, 1, 10), --balance_expiry_date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                    --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------
                END IF;
            END IF;
        END IF;

        --Validamos si es cliente HIBRIDO y en caso de ser asi, le mandamos a poner fecha infinita en CS
        SELECT COUNT(1)
          INTO v_dummy
        FROM bm_plan_param pp
        WHERE pp.cod_plan = v_reg_plan_nuevo.cod_plan
          AND pp.cod_tipo_parametro = 'LIFE_CYCLE'
          AND pp.fch_tran_fin IS NULL
          AND pp.cod_parametro = '0';

        IF v_dummy = 1 THEN
            --Cambiamos la fecha del Supervision Period, acorde a la vigencia del balance pasado al bolsillo de migracion
            po_cod_err := 'PVT-5070'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al buscar el enlace del comando para cambio de fecha.
            SELECT tx_vpg_util.get_comando('CMB_CICLO_VIDA', v_reg_plan_nuevo.cod_forma_consumo, 'SET')
              INTO v_command_id
            FROM DUAL;

            po_cod_err := 'PVT-5071'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al enviar comando para cambio de fecha supervision period.
            mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_inicio_vigencia,
                    pi_cod_transaccion      => v_cod_tran,
                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_p3                   => tx_cnf_constante.get_constante ('VIGENCIA_FIN_ECMS'),
                    pi_p4                   => tx_cnf_constante.get_constante ('VIGENCIA_FIN_ECMS'), --Service fee Expire Date
                    pi_p5                   => NULL, --Credit clearance Expire Date
                    pi_p6                   => NULL, --Service removal Expire Date
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => '0',
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_po_id_orden,
                    po_id_tran              => v_po_id_tran,
                    po_fch_tran             => v_po_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
         --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------

        END IF;


        -- inicio club preferencial (cambio plan consolidacion)
        -- si el antiguo plan era de empleados y el de ahora no pues realizar una baja en el club preferencial
            po_cod_err := 'PVT-2318';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al validar si es empleado.
           --  po_cod_err      :='error por nuevo: ' ||v_reg_plan_nuevo.cod_plan ||' - anterior:'||v_reg_plan_anterior.cod_plan;
            IF TX_CLUB_PREFERENCIAL.es_empleado(v_reg_plan_anterior.cod_plan) = '1' AND TX_CLUB_PREFERENCIAL.es_empleado(v_reg_plan_nuevo.cod_plan) = '0' THEN

               po_cod_err := 'PVT-2319';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al llamar el procedure TX_CLUB_PREFERENCIAL.afiliado_alta
               TX_CLUB_PREFERENCIAL.afiliado_baja(v_reg_entidad_consumo.identificador_entidad,
                                                    'POSTVENTA',
                                                    v_id_tran,
                                                    v_fch_tran,
                                                    v_cod_gestion_tran,
                                                    pi_cod_usuario,
                                                    pi_cod_unidad_negocio,
                                                    c_falso,
                                                    po_cod_err,
                                                    po_msj_err);
               IF po_cod_err <> 'OK' THEN --Ticket 106563
                    RAISE err_app;
                END IF;
            END IF;

            po_cod_err := 'PVT-2320';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al validar si es empleado.
            IF TX_CLUB_PREFERENCIAL.es_empleado(v_reg_plan_nuevo.cod_plan) = '1' THEN
                --Ticket 106563 Se agrega validacion para que solo de alta cuando el cliente no tenga suscrito el servicio.
                SELECT count(1)
                     INTO v_dummy
                    FROM club_entidad_afiliado
                     WHERE id_entidad_consumo=v_reg_entidad_consumo.id_entidad_consumo
                        AND estado=c_estado_activo;

                  IF v_dummy = 0 then

                po_cod_err := 'PVT-2321';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al llamar el procedure TX_CLUB_PREFERENCIAL.afiliado_alta
                TX_CLUB_PREFERENCIAL.afiliado_alta(
                                                v_reg_entidad_consumo.identificador_entidad,
                                                'POSTVENTA',
                                                v_id_tran,
                                                v_fch_tran,
                                                v_cod_gestion_tran,
                                                pi_cod_usuario,
                                                pi_cod_unidad_negocio,
                                                c_falso,
                                                v_tmp_result, -- dummy
                                                po_cod_err,
                                                po_msj_err);

              IF po_cod_err <> 'OK' THEN --Ticket 106563
                    RAISE err_app;
                END IF;
                 END IF;
            END IF;
        -- fin club preferencial (cambio plan consolidacion)

        ---Dar baja a los servicios de Universal Para cambios de planes a lineas de negocio no prepago. Ticket: 92969
        FOR servicio_seg IN (SELECT *
                               FROM cl_suscripcion_servicio cs
                              WHERE cs.id_entidad_consumo = v_reg_cambio_plan.id_entidad_consumo
                                AND cs.estado = c_estado_activo
                                AND cs.fch_efectiva_fin = c_fecha_fin
                                AND NOT EXISTS (SELECT 1
                                                  FROM v_plan_segmento
                                                 WHERE cod_forma_consumo = 'CCOPRE'
                                                   AND cod_plan = v_reg_cambio_plan.cod_plan)
                            )
        LOOP
            po_cod_err := 'PVT-2322';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Erro al invocar procedimiento para dar debaja suscripcion de seguro.
            tx_cl_suscripcion_servicio.baja(pi_id_contrato          => servicio_seg.id_contrato,
                                            pi_motivo_terminacion   => 'MTSMIG',
                                            pi_id_tran              => v_id_tran,
                                            pi_fch_tran             => v_fch_tran,
                                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                                            pi_cod_usuario          => pi_cod_usuario,
                                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                            pi_master               => c_falso,
                                            po_cod_err              => po_cod_err,
                                            po_msj_err              => po_msj_err
                                            );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END LOOP;

        IF tx_cl_suscripcion_servicio.tiene_servicio_sf_empleado(v_reg_cambio_plan.id_entidad_consumo) = c_verdadero THEN

            IF get_segmento(v_reg_cambio_plan.cod_plan) <> 'EMPL' THEN

                FOR servicio_seg IN (SELECT cs.id_contrato
                                       FROM cl_suscripcion_servicio cs,
                                            cnf_suscripcion_segmentos seg
                                      WHERE cs.id_entidad_consumo = v_reg_cambio_plan.id_entidad_consumo
                                        AND cs.estado = c_estado_activo
                                        AND cs.fch_efectiva_fin = c_fecha_fin
                                        AND seg.cod_servicio_suscripcion = cs.cod_servicio_suscripcion
                                        AND seg.cod_segmento = get_segmento(v_reg_entidad_consumo.cod_plan)
                                    )
                LOOP
                    po_cod_err := 'PVT-2323';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Erro al invocar procedimiento para dar debaja suscripcion de seguro.
                    tx_cl_suscripcion_servicio.baja(pi_id_contrato          => servicio_seg.id_contrato,
                                                    pi_motivo_terminacion   => 'MTSMIG',
                                                    pi_id_tran              => v_id_tran,
                                                    pi_fch_tran             => v_fch_tran,
                                                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                                                    pi_cod_usuario          => pi_cod_usuario,
                                                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                                    pi_master               => c_falso,
                                                    po_cod_err              => po_cod_err,
                                                    po_msj_err              => po_msj_err
                                                    );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END LOOP;
            END IF;

        END IF;


        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE venta_minutos (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_local              IN       vta_venta_prospecto.cod_local%TYPE,
        pi_monto                  IN       vta_venta_prospecto.valor%TYPE,
        pi_cod_tipo_venta         IN       vta_venta_minutos.cod_tipo_venta%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_venta               OUT      vta_venta_prospecto.id_venta%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                    := tx_cnf_constante.get_constante ('TRANSACCION_VENTA_MINUTOS');
        c_tipo_doc_venta_rec CONSTANT VARCHAR2 (50)
                                 := tx_cnf_constante.get_constante ('DOC_VENTA_MINUTOS_RECURRENTE');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.VENTA_MINUTOS';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'VTA_VENTA_PROSPECTO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_prospecto                vta_articulo_prospecto.id_prospecto%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_cod_tipo_documento          cnf_cta_tipo_documento.cod_tipo_documento%TYPE;
        v_id_cargo                    tr_cargo.id_cargo%TYPE;
        v_cod_linea_negocio           bm_linea_negocio.cod_linea_negocio%TYPE;
        v_impuestos                   NUMBER;
        v_monto                       NUMBER;
        v_es_estafeta                 VARCHAR2(1);
        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_local:'
            || pi_cod_local
            || '|'
            || 'pi_monto:'
            || pi_monto
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_monto IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2324';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-5019'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2326';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF v_reg_entidad_consumo.estado <> 'SBI' THEN
            --LA ENTIDAD DE CONSUMO NO TIENE QUE TENER NINGUNA SUSPENSION NI DESCONEXION
            IF suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero THEN
                po_cod_err := 'PVT-2327';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: El suscriptor esta suspendido.
                RAISE err_app;
            END IF;
        END IF;

        ---- MVNO
        po_cod_err := 'PVT-2328';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: Error al recuperar la linea de negocio

        SELECT cod_linea_negocio
          INTO v_cod_linea_negocio
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        /*
          IF v_cod_linea_negocio = 'EXTERN' THEN
              po_cod_err := 'PVT-2329';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS:  La linea de negocio no puede tener venta de minutos
              RAISE err_app;
          END IF;
          */

        ---- MVNO

        --NO SE VENDEN MINUTOS A POSTPAGO
        IF v_reg_entidad_consumo.cod_forma_consumo = c_forma_consumo_postpago THEN
            po_cod_err := 'PVT-2330';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: La venta de minutos no esta disponible para suscriptores postpago.
            RAISE err_app;
        END IF;

        --VALIDAR EL MONTO MINIMO PARA LA VENTA DE MINUTOS
        IF pi_monto < c_monto_minimo_venta_minutos THEN
            po_cod_err := 'PVT-2331';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: El monto ingresado es menor al minimo definido.
            RAISE err_app;
        END IF;

        BEGIN
         SELECT es_estafeta
           INTO v_es_estafeta
          FROM cnf_vta_entidad_venta
        WHERE cod_tipo_venta = pi_cod_tipo_venta;
        EXCEPTION
         WHEN OTHERS THEN
            v_es_estafeta := '0';
        END;

        IF pi_cod_tipo_venta = 'VMINOR' THEN
            v_cod_tipo_documento    := c_tipo_doc_venta_minutos;
            v_id_cargo              := c_cargo_venta_minutos;
        ELSIF pi_cod_tipo_venta = 'VMIREC' THEN
            v_cod_tipo_documento    := c_tipo_doc_venta_rec;
            v_id_cargo              := c_cargo_venta_minutos;
        ELSIF pi_cod_tipo_venta = 'VMINAN' THEN
            v_cod_tipo_documento    := c_tipo_doc_venta_min_plan_anu;
            v_id_cargo              := c_cod_cargo_renovacion_plan;
        ELSIF v_es_estafeta = c_verdadero THEN
            v_cod_tipo_documento    := c_tipo_doc_venta_minutos;
            v_id_cargo              := c_cargo_venta_minutos;
        ELSE
            po_cod_err := 'PVT-2332';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: Tipo de venta no implementado
            RAISE err_app;
        END IF;

        v_monto                := pi_monto;
        --CREAR EL CARGO POR LA VENTA DE MINUTOS
        po_cod_err := 'PVT-2333';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: Error al obtener el id del cliente.
        v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        po_cod_err := 'PVT-2334';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: Error al invocar al proc. de creacion de cargo por venta de minutos.
        tx_pvt_ccs.asignar_cargo
                               (
                                  pi_id_cliente                  => v_id_cliente,
                                  pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                  pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                  pi_cod_local                   => pi_cod_local,
                                  pi_cod_tipo_documento          => v_cod_tipo_documento,
                                  pi_id_cargo                    => v_id_cargo,
                                  pi_monto                       => v_monto,
                                  pi_monto_antes_imp             => c_falso,
                                  pi_es_diferido                 => c_falso,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_documento                => po_id_venta,
                                  po_id_tran                     => v_id_tran,
                                  po_cod_gestion_tran            => v_cod_gestion_tran,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2335';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: Error al recuperar el identificador de prospecto de la venta

        SELECT id_prospecto
          INTO v_id_prospecto
          FROM vta_venta_prospecto
         WHERE id_venta = po_id_venta;

        --- DIFERENCIAR LA VENTA DE MINUTOS
        po_cod_err := 'PVT-2336';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS: Error al invocar al proc. de creacion de prospecto de venta minutos
        tx_vta_venta_minutos.alta (pi_id_prospecto                => v_id_prospecto,
                                   pi_id_venta                    => po_id_venta,
                                   pi_cod_tipo_venta              => pi_cod_tipo_venta,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_master                      => c_falso,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE venta_minutos_consolidacion (
        -- Input parameters
        pi_id_prospecto           IN       vta_articulo_prospecto.id_prospecto%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                    := tx_cnf_constante.get_constante ('TRANSACCION_VENTA_MINUTOS');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.VENTA_MINUTOS_CONSOLIDACION';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := '';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_monto_pps                   NUMBER (10, 2);
        v_vigencia_pps                DATE;
        v_dias_vigencia               cnf_vigencia_carga.dias_vigencia%TYPE;
        v_cod_grupo_plan              bm_plan.cod_grupo_plan%TYPE;
        v_vigencia_nueva              DATE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_reg_cargo_prospecto         vta_cargo_prospecto%ROWTYPE;
        v_cod_local                   vta_venta_prospecto.cod_local%TYPE;
        v_tarifa_basica               bm_plan.tarifa_basica%TYPE;
        v_monto                       bm_plan.tarifa_basica%TYPE;
        v_impuesto_1                  bm_plan.tarifa_basica%TYPE;
        v_impuesto_2                  bm_plan.tarifa_basica%TYPE;
        v_impuesto_3                  bm_plan.tarifa_basica%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_reg_vta_venta_minutos       vta_venta_minutos%ROWTYPE;
        v_status                      VARCHAR2 (4000);
        v_cod_grupo_grupo_plan        bm_grupo_plan.cod_grupo_plan%TYPE;
        v_accion                      bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_monto_recarga               vta_venta_prospecto.valor%TYPE;
        v_diferir_carga               BOOLEAN := FALSE;
        v_fch_expiracion              DATE;
        v_command_id                  vpg_cnf_comando.id_comando%TYPE;
        v_po_id_orden                 vpg_orden.id_orden%TYPE;
        v_po_id_tran                  tx_historico_transaccion.id_tran%TYPE;
        v_po_fch_tran                 tx_historico_transaccion.fch_tran%TYPE;
        v_bolsillos_cs                tx_ecms.type_ecms_bolsilos;
        v_refill_profile_id           cnf_vigencia_carga.refill_profile_id%TYPE;
        v_monto_recarga_parcial       NUMBER (15, 2);
        v_balances_pps                tx_air.air_balance_instances;
        v_id_sms                      NUMBER (15, 2);


        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_prospecto:'
            || pi_id_prospecto
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_prospecto IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2337';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2338';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2339';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        --OBTENCION DEL PROSPECTO DE VENTA DE MINUTOS
        po_cod_err := 'PVT-2340';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al recuperar el prospecto de la venta de minutos.

        SELECT *
          INTO v_reg_cargo_prospecto
          FROM vta_cargo_prospecto p
         WHERE p.id_prospecto = pi_id_prospecto AND p.estado = c_estado_activo;

        --OBTENCION DEL PROSPECTO DE VENTA DE MINUTOS
        po_cod_err := 'PVT-2341';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al recuperar el prospecto de la venta de minutos

        SELECT *
          INTO v_reg_vta_venta_minutos
          FROM vta_venta_minutos p
         WHERE p.id_prospecto = pi_id_prospecto;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (v_reg_cargo_prospecto.id_entidad_consumo, v_reg_entidad_consumo,
                                 po_cod_err, po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        SELECT cod_grupo_plan
          INTO v_cod_grupo_plan
        FROM bm_plan
        WHERE cod_plan = v_reg_entidad_consumo.cod_plan;

        IF v_reg_vta_venta_minutos.cod_tipo_venta = 'VMINOR' THEN
            po_cod_err := 'PVT-2342';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al recuperar datos del balance
            /*tx_ecms.get_datos_balance (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                       pi_balance_id                  => tx_ecms.c_bal_core_balance,
                                       po_monto                       => v_monto_pps,
                                       po_fecha                       => v_vigencia_pps,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );*/

            tx_air.getsubscriberbalance(
                        pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_balanceid                => 'CSGMA',
                        po_balance                  => v_monto_pps,
                        po_expiraction_date         => v_vigencia_pps,
                        po_balance_info             => v_balances_pps,
                        po_cod_err                  => po_cod_err,
                        po_msj_err                  => po_msj_err);

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            IF v_cod_grupo_plan != 'G62PRE' THEN
                v_dias_vigencia    :=
                    tx_cnf_vigencia_carga.get_vigencia (pi_cod_grupo_plan              => v_cod_grupo_plan,
                                                        pi_monto                       => v_reg_cargo_prospecto.monto);

                --BALANCE BREAKAGE SE SUMA A LA COMPRA ACTUAL SI COMPRA
                IF v_cod_grupo_plan = 'GPCLUB' THEN
                    SELECT p.tarifa_basica
                      INTO v_tarifa_basica
                      FROM bm_plan p
                     WHERE p.cod_plan = v_reg_entidad_consumo.cod_plan;

                    tx_pvt_ccs.get_impuestos (v_tarifa_basica,
                                              c_cargo_tbm,
                                              v_monto,
                                              v_impuesto_1,
                                              v_impuesto_2,
                                              v_impuesto_3
                                             );

                    IF v_reg_cargo_prospecto.monto >= v_monto THEN
                        v_dias_vigencia    := 30;
                    ELSE
                        v_dias_vigencia    := 0;
                    END IF;
                END IF;

                SELECT GREATEST (v_fch_tran + v_dias_vigencia,
                                 NVL (v_vigencia_pps, v_fch_tran + v_dias_vigencia))
                  INTO v_vigencia_nueva
                FROM DUAL;

                po_cod_err := 'PVT-5105'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error obtener el refill profile id.
                v_refill_profile_id := tx_cnf_vigencia_carga.get_refill_profile_id(v_cod_grupo_plan, v_reg_cargo_prospecto.monto);

                IF  v_refill_profile_id IS NULL THEN
                    po_cod_err := 'PVT-5106'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: El monto no tiene configurado un refill profile id.
                    RAISE err_app;
                END IF;

                --CARGAMOS LOS MINUTOS AL SUSCRIPTOR MEDIANTE EL PROVISIONADOR
                po_cod_err := 'PVT-2343';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al invocar al proc. de registro de ordenes del PRV.
                tx_pvt_entidad_consumo.carga_balance
                                 (pi_id_entidad_consumo          => v_reg_cargo_prospecto.id_entidad_consumo,
                                  pi_tipo_balance                => 'CORE BALANCE',
                                  pi_monto                       => v_reg_cargo_prospecto.monto,
                                  pi_fch_vigencia                => v_vigencia_nueva,
                                  pi_dias_vigencia               => v_dias_vigencia,
                                  pi_cod_motivo                  => 'CBVMIN',
                                  pi_refill_profile_id           => v_refill_profile_id,  -- <= completar ese data cuando lleguemos ahi :) --> YA LLEGAMOS AHI :D
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_tran                     => v_id_tran,
                                  po_cod_gestion_tran            => v_cod_gestion_tran,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;


                    tx_sms.alta (pi_origen               => 'VIVA',
                             pi_destino              => v_reg_entidad_consumo.identificador_entidad,
                             pi_texto                => 'Tu recarga ha sido completada exitosamente por un monto de RD $'||v_reg_cargo_prospecto.monto||' Transaccion No. '||v_id_tran,
                             pi_prioridad            => '1',
                             pi_id_tran              => v_id_tran,
                             pi_fch_tran             => v_fch_tran,
                             pi_cod_gestion_tran     => v_cod_gestion_tran,
                             pi_cod_usuario          => pi_cod_usuario,
                             pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                             pi_master               => c_falso,
                             po_id_sms               => v_id_sms,
                             po_cod_err              => po_cod_err,
                             po_msj_err              => po_msj_err);



                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;
        ELSIF v_reg_vta_venta_minutos.cod_tipo_venta = 'VMINAN' THEN
            po_cod_err := 'PVT-2344';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al recuperar el grupo de plan

            SELECT cod_grupo_plan,
                   tarifa_basica
              INTO v_cod_grupo_grupo_plan,
                   v_tarifa_basica
              FROM bm_plan
             WHERE cod_plan = v_reg_entidad_consumo.cod_plan;

            IF v_cod_grupo_grupo_plan != 'PREANU' THEN
                po_cod_err := 'PVT-2345';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: El grupo de plan del suscriptor no es anual
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2346';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al calcular los impuestos de la tarifa basica
            tx_pvt_ccs.get_impuestos (v_tarifa_basica,
                                      c_cargo_tbm,
                                      v_monto_recarga,
                                      v_impuesto_1,
                                      v_impuesto_2,
                                      v_impuesto_3
                                     );

            --Solo tenemos clientes GSM
            v_accion    := 286;   --GSM SET_BAL_PPS
            v_fch_expiracion := ADD_MONTHS (v_fch_tran, 12);

            --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
            --Cambiamos la fecha del Supervision Period. Para estos planes se dan 12 meses.
            po_cod_err := 'PVT-5107'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al buscar el enlace del comando para cambio de fecha.
            SELECT tx_vpg_util.get_comando('CMB_CICLO_VIDA', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
              INTO v_command_id
            FROM DUAL;

            po_cod_err := 'PVT-5108'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al enviar comando para cambio de fecha supervision period.
            mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_tran,
                    pi_cod_transaccion      => v_cod_tran,
                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_p3                   => TO_CHAR(v_fch_expiracion, 'YYYY-MM-DD'),
                    pi_p4                   => NULL, --Service fee Expire Date
                    pi_p5                   => NULL, --Credit clearance Expire Date
                    pi_p6                   => NULL, --Service removal Expire Date
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => '0',
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_po_id_orden,
                    po_id_tran              => v_po_id_tran,
                    po_fch_tran             => v_po_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
            --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------

            --Recalculamos las fechas del cliente a nivel de ciclo de vida también
            po_cod_err := 'PVT-5020'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al intentar recalcular las fechas del suscriptor en control ciclo de vida.
            tx_cl_lifecycle.generate_subscriber_dates( pi_internal_id        => v_reg_entidad_consumo.id_entidad_consumo,
                                                       pi_expiration_date    => v_fch_expiracion,
                                                       pi_transaction_reason => 'ANNUAL_RENEWAL',
                                                       pi_master             => c_falso,
                                                       pi_tran_id            => v_id_tran,
                                                       pi_tran_date          => v_fch_tran,
                                                       pi_tran_user          => pi_cod_usuario,
                                                       pi_tran_period        => v_cod_gestion_tran,
                                                       po_cod_err            => po_cod_err,
                                                       po_msj_err            => po_msj_err
                                                      );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            --Solo tenemos clientes GSM
            v_accion    := 240;
            v_monto_recarga_parcial := (v_monto_recarga / 12);

            --------------------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------------------------
            po_cod_err := 'PVT-5109'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error obtener el refill profile id.
            v_refill_profile_id := tx_cnf_vigencia_carga.get_refill_profile_id(v_cod_grupo_plan, v_monto_recarga_parcial);

            IF  v_refill_profile_id IS NULL THEN
                po_cod_err := 'PVT-5110'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: El monto no tiene configurado un refill profile id.
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-5111'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al recuperar la accion para el VPG a invocar.
            SELECT tx_vpg_util.get_comando('RECARGA_NV', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
               INTO v_command_id
            FROM DUAL;

            po_cod_err := 'PVT-5112'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al dar de alta orden para carga de balance.
            mt_vpg.alta_orden(
                        pi_id_comando           => v_command_id,
                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_fch_programada       => v_fch_tran,
                        pi_cod_transaccion      => 'TX_TRAN_ACTIVACION',
                        pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                        pi_p2                   => 'ADM',
                        pi_p3                   => 'RECARGA CLIENTE PREPAGO ANUAL',
                        pi_p4                   => v_id_tran,
                        pi_p5                   => tx_vpg_util.date2iso(v_fch_expiracion),
                        pi_p6                   => tx_vpg_util.number2cs(v_monto_recarga_parcial),
                        pi_p7                   => v_refill_profile_id,
                        pi_p8                   => NULL, --External Data 1
                        pi_p9                   => NULL, --External Data 2
                        pi_p10                  => NULL, --External Data 3
                        pi_cod_usuario          => pi_cod_usuario,
                        pi_master               => c_falso,
                        pi_id_tran              => v_id_tran,
                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                        pi_fch_tran             => v_fch_tran,
                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                        po_id_orden             => v_po_id_orden,
                        po_id_tran              => v_po_id_tran,
                        po_fch_tran             => v_po_fch_tran,
                        po_cod_err              => po_cod_err,
                        po_msj_err              => po_msj_err
                        );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            --------------------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) ---------------------------

        ELSIF v_reg_vta_venta_minutos.cod_tipo_venta = 'VMINTP' THEN
            -- La recaga de la venta minutos para TPAGO es asyncrona y es realizada por otro proceso.
            NULL;
        END IF;

        --ESTABLECEMOS EL PROSPECTO COMO PAGADO
        po_cod_err := 'PVT-2349';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al invocar al procedimiento de finalizacion del prospectro.
        cc_vta_cargo_prospecto.cambia_estado (pi_id_prospecto                => pi_id_prospecto,
                                              pi_estado                      => c_estado_pagado,
                                              pi_cod_usuario                 => pi_cod_usuario,
                                              pi_id_tran                     => v_id_tran,
                                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                                              pi_fch_tran                    => v_fch_tran,
                                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                              po_cod_err                     => po_cod_err,
                                              po_msj_err                     => po_msj_err
                                             );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --REGISTRO TRANSACCIONAL POSTVENTA
        po_cod_err := 'PVT-2350';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al determinar el local de la venta.

        SELECT cod_local
          INTO v_cod_local
          FROM vta_venta_prospecto v
         WHERE v.id_venta = v_reg_cargo_prospecto.id_venta;

        v_trama_nuevo_pv       :=    'Local:'
                                  || v_cod_local
                                  || '|'
                                  || 'Monto:'
                                  || v_reg_cargo_prospecto.monto;
        v_trama_anterior_pv    := '';
        po_cod_err := 'PVT-2351';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_MINUTOS_CONSOLIDACION: Error al invocar al proc. de registro del log de transacciones PostVena.
        cc_tx_transaccion_postventa.alta
                                 (pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_cod_tipo                    => c_tipo_transaccion,
                                  pi_id_cliente                  => v_reg_cargo_prospecto.id_cliente,
                                  pi_id_comunidad                => v_reg_cargo_prospecto.id_comunidad_facturante,
                                  pi_id_entidad_consumo          => v_reg_cargo_prospecto.id_entidad_consumo,
                                  pi_cod_motivo_transaccion      => NULL,
                                  pi_cod_observacion             => NULL,
                                  pi_descripcion_observacion     => NULL,
                                  pi_valor_anterior              => v_trama_anterior_pv,
                                  pi_valor_nuevo                 => v_trama_nuevo_pv,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE cambio_equipo (
        -- Input parameters
        pi_id_entidad_consumo     IN       vta_articulo_prospecto.id_entidad_consumo%TYPE,
        pi_tipo_cambio            IN       VARCHAR2,   --CDMA,GSM,SIM
        pi_cod_articulo           IN       vta_articulo_prospecto.cod_articulo%TYPE,
        pi_nro_serie              IN       vta_articulo_prospecto.nro_serie%TYPE,
        pi_cod_motivo_cambio      IN       vta_articulo_prospecto.cod_motivo_cambio%TYPE
                DEFAULT NULL,
        pi_descuento              IN       vta_articulo_prospecto.descuento%TYPE,
        pi_tipo_descuento         IN       VARCHAR2,
        pi_cod_motivo_descuento   IN       vta_articulo_prospecto.cod_motivo_descuento%TYPE,
        pi_es_pago_diferido       IN       vta_articulo_prospecto.es_diferido%TYPE,
        pi_es_devolucion          IN       vta_articulo_prospecto.es_devolucion%TYPE,
        pi_cod_categoria          IN       vta_articulo_prospecto.cod_categoria%TYPE,   --para devolucion
        pi_puntos_utilizados      IN       vta_articulo_prospecto.cantidad_bonificacion%TYPE,
        pi_id_entidad_venta       IN       vta_venta_entidad.id_venta_entidad%TYPE,
        pi_cod_usuario_asignado   IN       vta_venta_entidad.cod_usuario_asignado%TYPE,
        pi_id_prospecto_tec       IN       vta_articulo_prospecto.id_prospecto_cambio_tec%TYPE
                DEFAULT NULL,
        pi_id_venta_tec           IN       vta_venta_prospecto.id_venta%TYPE,
        pi_id_financiamiento      IN       vta_articulo_prospecto.id_financiamiento%TYPE,
        pi_cod_tipo_cambio_equipo IN       vta_articulo_prospecto.cod_tipo_cambio%TYPE,
        pi_codigo_validacion      IN       vta_codigo_transaccion.codigo%TYPE,
        pi_descripcion_falla      IN       vta_articulo_prospecto.descripcion_falla%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_prospecto_art       OUT      vta_articulo_prospecto.id_prospecto%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion            VARCHAR2 (50)
                                    := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_EQUIPO');
        c_separador_doc      CONSTANT VARCHAR2 (50) := ',';
        c_separador_monto    CONSTANT VARCHAR2 (50) := ':';
        c_rubro_articulo_cdma CONSTANT cnf_constante.valor%TYPE
                                          := tx_cnf_constante.get_constante ('RUBRO_ARTICULO_CDMA');
        c_rubro_articulo_gsm CONSTANT cnf_constante.valor%TYPE
                                           := tx_cnf_constante.get_constante ('RUBRO_ARTICULO_GSM');

        c_tipo_transaccion_rtb  CONSTANT VARCHAR2(50) := 'TX_TRAN_RETENCION_BOX';
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.CAMBIO_EQUIPO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ARTICULO_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_dummy                       PLS_INTEGER;
        v_aplica_cambio               PLS_INTEGER;
        v_reg_art_entidad_consumo     cl_articulo_entidad_consumo%ROWTYPE;
        v_porcentaje_impuestos        inv_precio_articulo.precio%TYPE;
        v_precio_lista                inv_precio_articulo.precio%TYPE;
        v_precio_venta                inv_precio_articulo.precio%TYPE;
        v_precio_venta_con_imp        inv_precio_articulo.precio%TYPE;
        v_monto_descuento             inv_precio_articulo.precio%TYPE;
        v_monto_puntos                inv_precio_articulo.precio%TYPE;
        v_monto_puntos_con_imp        inv_precio_articulo.precio%TYPE;
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_precio_lista_con_imp        vta_venta_prospecto.valor%TYPE;
        v_id_cargo_articulo           tr_cargo.id_cargo%TYPE;
        v_nombre_factura              VARCHAR2 (200);
        v_rnc_factura                 cl_persona.nit%TYPE;
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_prospecto                vta_articulo_prospecto.id_prospecto%TYPE;
        v_tipo_cambio                 VARCHAR2 (10);
        v_cod_tipo_venta              VARCHAR2 (30);
        v_cod_almacen                 inv_almacen.cod_almacen%TYPE;
        v_permiso                     VARCHAR2 (10);
        v_valor                       VARCHAR2 (50);
        v_id_venta_entidad            vta_venta_entidad.id_venta_entidad%TYPE;
        v_id_venta_main               vta_venta_prospecto.id_venta%TYPE;
        v_id_prospecto_main           vta_venta_prospecto.id_prospecto%TYPE;
        v_reg_articulo                inv_articulo%ROWTYPE;
        v_reg_articulo_maestro        inv_articulo_maestro%ROWTYPE;
        v_procedencia_equipo          VARCHAR2 (10);
        v_cod_tipo_almacen            inv_almacen.cod_tipo%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_desc_promocion              cnf_promocion.descripcion%TYPE;
        v_desc_moneda                 cnf_moneda.descripcion%TYPE;
        v_desc_rubro_articulo         cnf_catalogo.descripcion%TYPE;
        v_desc_articulo               inv_articulo.descripcion%TYPE;
        v_es_prepago                  PLS_INTEGER;
        v_procedencia_equipo_telf     vta_articulo_prospecto.procedencia_articulo%TYPE;
        v_precio_puntos               inv_precio_articulo.precio%TYPE;
        v_cod_tipo_entidad_venta      inv_entidad_venta.cod_tipo%TYPE;
        v_cod_tipo_entidad_venta_p    inv_entidad_venta.cod_tipo%TYPE;
        v_tiempo_garantia_equipo      NUMBER (4);
        v_cod_grupo_plan              bm_grupo_plan.cod_grupo_plan%TYPE;
        v_permiso_por_dealer          VARCHAR2 (10);
        v_fch_ultimo_cambio_equipo    cl_articulo_entidad_consumo.fch_inicio%TYPE;
        v_cod_categoria_documento     bl_dosificacion.cod_categoria_documento%TYPE;
        v_tipo_doc_venta_equipo       cnf_cta_tipo_documento.cod_tipo_documento%TYPE;
        v_nro_serie_anterior          vta_articulo_prospecto.nro_serie%TYPE;
        v_sunday                      NUMBER := 0;
        v_tiempo_conv                 NUMBER := 0;
        v_identificador_entidad       VARCHAR2 (100);
        v_id_prospecto_detalle        vta_venta_prospecto_detalle.id_prospecto_detalle%TYPE;
        v_imsi_sim                    cl_entidad_consumo.sim%TYPE;
        v_serie_eq                    cl_articulo_entidad_consumo.nro_serie%TYPE;
        v_id_orden                    eir_orden.id_orden%TYPE;

        v_es_evdo                     NUMBER:= 0;
        v_excepcion_para_cambio       NUMBER:= 0;
        v_es_prospecto_rtb            PLS_INTEGER;
        v_tipo_tran                   VARCHAR2(50);
        v_id_ec_tiene_promo           PLS_INTEGER:=0;
        v_cod_articulo                inv_articulo.cod_articulo%TYPE;
        v_validar_cod_equipo         VARCHAR2(50);
        v_tipo_excepcion              vta_excepcion.cod_tipo_excepcion%TYPE;
        v_cod_motivo_descuento        vta_articulo_prospecto.cod_motivo_descuento%TYPE;

        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        IF pi_tipo_cambio = c_tipo_cambio_sim THEN
            c_tipo_transaccion    := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_SIM');
        ELSIF pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm) THEN
            c_tipo_transaccion    := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_EQUIPO');
        END IF;

        v_cod_tran                 := c_tipo_transaccion;
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                 :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_tipo_cambio:'
            || pi_tipo_cambio
            || '|'
            || 'pi_cod_articulo:'
            || pi_cod_articulo
            || '|'
            || 'pi_nro_serie:'
            || pi_nro_serie
            || '|'
            || 'pi_cod_motivo_cambio:'
            || pi_cod_motivo_cambio
            || '|'
            || 'pi_descuento:'
            || pi_descuento
            || '|'
            || 'pi_tipo_descuento:'
            || pi_tipo_descuento
            || '|'
            || 'pi_cod_motivo_descuento:'
            || pi_cod_motivo_descuento
            || '|'
            || 'pi_es_pago_diferido:'
            || pi_es_pago_diferido
            || '|'
            || 'pi_es_devolucion:'
            || pi_es_devolucion
            || '|'
            || 'pi_cod_categoria:'
            || pi_cod_categoria
            || '|'
            || 'pi_puntos_utilizados:'
            || pi_puntos_utilizados
            || '|'
            || 'pi_id_entidad_venta:'
            || pi_id_entidad_venta
            || '|'
            || 'pi_cod_usuario_asignado:'
            || pi_cod_usuario_asignado
            || '|'
            || 'pi_id_prospecto_tec:'
            || pi_id_prospecto_tec
            || '|'
            || 'pi_id_venta_tec:'
            || pi_id_venta_tec
            || '|'
            || 'pi_id_financiamiento:'
            || pi_id_financiamiento
            || '|'
            || 'pi_cod_tipo_cambio_equipo:'
            || pi_cod_tipo_cambio_equipo
            || '|'
            || 'pi_codigo_validacion:'
            || pi_codigo_validacion
            || '|'
            || 'pi_descripcion_falla:'
            || pi_descripcion_falla
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_tipo_cambio IS NULL
           OR pi_nro_serie IS NULL
           OR pi_id_entidad_venta IS NULL
           OR pi_cod_usuario_asignado IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2352';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2353';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2354';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                 := v_id_tran;
        po_cod_gestion_tran        := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        v_cod_motivo_descuento :=  pi_cod_motivo_descuento;

        IF v_cod_motivo_descuento = 'FINBA' AND pi_cod_motivo_cambio <> 'CSE008' THEN
            po_cod_err := 'PVT-6001';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El Financimiento de equipo solo esta permitio para el programa Subsidio.
            RAISE err_app;
        END IF;

        /* INICIO RQX 5125*/
        -- verificacion de que el usuario este dentro de los planes evdo.
        select count(cod_segmento)
        into v_es_evdo
        from v_plan_segmento where cod_plan = (
            select cod_plan
            from cl_entidad_consumo
            where id_entidad_consumo  = pi_id_entidad_consumo
            and estado not in ('I','TER','PORT'))
        and cod_segmento in ('EVDCOR','EVDO','EVDOPRE','EVDOREL');

        -- verificacion de la excepcion
        select count(id_entidad_consumo)
        into v_excepcion_para_cambio
        from vta_excepcion
        where fch_inicio >= trunc(sysdate)-2
        and id_entidad_consumo =  pi_id_entidad_consumo
        and estado = 'A'
        and cod_motivo = 'MEXRET'
        and cod_tipo_monto_deposito = 'TDEMON';

        if v_es_evdo = 1 and v_excepcion_para_cambio = 0 then

            if pi_cod_motivo_cambio in ('CSE001', -- Cambio por Robo
                                             'CSE003', -- Cambio por Renovación
                                                    'CSE011', -- Cambio por Excepción
                                                            'CSE002', -- Cambio por Perdida
                                                                    'CSE004', -- Cambio por Fraude
                                                                            'CSE005', -- Cambio por fallas del equipo
                                                                                    'CSE009' -- Cambio a Precio de Lista
                                                                                    ) then
                po_cod_err := 'PVT-2355';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error, no esta permitido realizar cambio de equipo con este motivo.
                RAISE err_app;
            end if;
        end if;
        /* FIN RQX 5125 */


        --LOS ARTICULOS DEVUELTOS DEBEN TENER UNA CATEGORIA
        IF NVL (pi_es_devolucion, c_falso) = c_verdadero AND pi_cod_categoria IS NULL THEN
            po_cod_err := 'PVT-2356';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Especifique la categoria del equipo devuelto.
            RAISE err_app;
        END IF;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR SUSPENDIDA NI DESCONECTADA
        IF suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero AND v_reg_entidad_consumo.estado <> 'S02' AND v_reg_entidad_consumo.cod_tecnologia
         <> 'CDMA' THEN
            po_cod_err := 'PVT-2357';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        IF v_reg_entidad_consumo.estado = 'S02' THEN
            tx_pvt_entidad_consumo.reconexion_entidad_consumo (pi_id_entidad_consumo    => pi_id_entidad_consumo,
                                                               pi_cod_servicio          => 'SS02',
                                                               pi_cod_usuario           => pi_cod_usuario,
                                                               pi_master                => c_falso,
                                                               pi_id_tran               => v_id_tran,
                                                               pi_cod_gestion_tran      => v_cod_gestion_tran,
                                                               pi_fch_tran              => v_fch_tran,
                                                               pi_cod_unidad_negocio    => pi_cod_unidad_negocio,
                                                               po_id_tran               => v_id_tran,
                                                               po_cod_gestion_tran      => v_cod_gestion_tran,
                                                               po_cod_err               => po_cod_err,
                                                               po_msj_err               => po_msj_err
                                                              );


            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

        END IF;

        po_cod_err := 'PVT-2358';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El equipo que desea cambiar esta fuera(del tiempo de garantia.

        SELECT vv.cod_tipo,
               v.cod_tipo
          INTO v_cod_tipo_entidad_venta_p,
               v_cod_tipo_entidad_venta
          FROM inv_entidad_venta v, inv_entidad_venta vv
         WHERE v.id_entidad_venta = pi_id_entidad_venta
           AND vv.id_entidad_venta = v.id_entidad_venta_padre;

        tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                   pi_cod_entidad                 => 'ESP_TRANSACCIONES_POR_DEALER',
                                   pi_cod_usuario_tran            => pi_cod_usuario,
                                   po_permiso                     => v_permiso_por_dealer,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --DETERMINAR SI TIENE PROSPECTO RTB
        SELECT COUNT(1)
            INTO v_es_prospecto_rtb
        FROM ret_prospecto
        WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
         AND estado IN ('ACC','ESC');


        --DETERMINACION DE LA LINEA DE NEGOCIO
        po_cod_err := 'PVT-2359';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al recuperar la linea de negocio de la cuenta.

        SELECT c.cod_linea_negocio
          INTO v_cod_linea_negocio
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        -- MVNO
        IF entidad_venta_valida (pi_id_entidad_venta, v_cod_linea_negocio) = c_falso THEN
            po_cod_err := 'PVT-2360';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO:  Su entidad de venta no puede realizar esta transaccion para esta linea de negocio
            RAISE err_app;
        END IF;

        /* No validar SIM para Moun RQX 5055
        IF     pi_tipo_cambio = c_tipo_cambio_sim
           AND v_cod_linea_negocio = 'EXTERN'
           AND es_sim_moun (pi_cod_articulo, 'TASIM') = c_falso THEN
            po_cod_err := 'PVT-2361';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO:  Debe usar un SIM Moun para este subscriptor
            RAISE err_app;
        END IF;*/

        --- MVNO

        --DETERMINAR EL GRUPO DE PLAN
        po_cod_err := 'PVT-2362';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al recuperar el grupo de plan

        SELECT bg.cod_grupo_plan
          INTO v_cod_grupo_plan
          FROM bm_plan b, bm_grupo_plan bg
         WHERE b.cod_grupo_plan = bg.cod_grupo_plan AND b.cod_plan = v_reg_entidad_consumo.cod_plan;

        IF     v_cod_tipo_entidad_venta_p IN ('TEVDLR', 'TEVMDL')
           -- AND (   v_cod_linea_negocio NOT IN ('HIBRID', 'FULL', 'POSCON', 'PREPAG', 'EXTERN')
           AND (   get_segmento(v_reg_entidad_consumo.cod_plan) NOT IN ('HIBRIDPRE','CASHIBPRE','CASHIBPREM','HIBRID','POSCON','EVDO','PREPAGO','PREPAGOTRY','MOUNPRE','CASFULL','CASPOS','CASPRE')
                OR v_cod_linea_negocio IN ('TRYME','POSCOR','FIJCOR')
                OR v_cod_grupo_plan = 'POSDAT'
               )
           AND v_permiso_por_dealer = c_falso THEN
            po_cod_err := 'PVT-2363';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: La transaccion no esta permitida para su entidad de venta y el plan del suscriptor.
            RAISE err_app;
        END IF;

        IF pi_tipo_cambio = c_tipo_cambio_sim THEN
            SELECT COUNT (*)
              INTO v_dummy
              FROM inv_serial_relacion sr
             WHERE sr.nro_serie = pi_nro_serie
               AND sr.cod_tipo_relacion IN ('TRPREA', 'TREKIS')
               AND sr.fch_fin = c_fecha_fin
               AND sr.estado = c_estado_activo;

            IF v_dummy > 0 THEN
                po_cod_err := 'PVT-2364';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El SIM esta reservado por una preactivacion.
                RAISE err_app;
            END IF;
            IF excepcion_cambio_sim(pi_id_entidad_consumo) = 0 THEN -- RQX 5435
                IF v_cod_tipo_entidad_venta_p IN ('TEVDLR', 'TEVMDL') THEN
                    SELECT COUNT (1)
                    INTO v_dummy
                     FROM vta_articulo_prospecto
                    WHERE id_prospecto_ec IS NULL
                    AND id_prospecto_cambio_tec IS NULL
                    AND estado IN (c_estado_pagado, c_estado_activo)
                    AND id_entidad_consumo = pi_id_entidad_consumo
                    AND fch_tran >= TRUNC (ADD_MONTHS (SYSDATE, -12))
                    AND cod_rubro_articulo = 'TASIM';

                    IF v_dummy >= c_maximo_cambio_sim THEN
                        po_cod_err := 'PVT-2365';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El suscriptor no puede cambiar mas de 3 veces de SIM en menos de un a?o
                        RAISE err_app;
                    END IF;
                END IF;
            END IF;-- RQX 5435
        END IF;

        po_cod_err := 'PVT-2366';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al obtener el id del cliente.
        v_id_cliente               := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

        --DETERMINAR LA PROCEDENCIA DEL ARTICULO
        BEGIN
            po_cod_err := 'PVT-2367';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al recuperar los datos del articulo.

            SELECT *
              INTO v_reg_articulo_maestro
              FROM inv_articulo_maestro am
             WHERE am.nro_serie = pi_nro_serie;


            IF pi_cod_articulo <> v_reg_articulo_maestro.cod_articulo THEN
                po_cod_err := 'PVT-2368';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El codigo del articulo no corresponde a la serial ingresada.
                RAISE err_app;
            END IF;

            IF v_reg_articulo_maestro.estado_articulo <> 'K_EXI' THEN
                po_cod_err := 'PVT-2369';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El articulo no esta en existencia.
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2370';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el tipo de almacen.

            SELECT a.cod_tipo
              INTO v_cod_tipo_almacen
              FROM inv_almacen a
             WHERE a.cod_almacen = v_reg_articulo_maestro.cod_almacen;

            IF v_cod_tipo_almacen = c_tipo_almacen_secundario THEN
                v_procedencia_equipo    := c_proced_empresa;
            ELSIF v_cod_tipo_almacen = c_tipo_almacen_externo THEN
                IF v_reg_articulo_maestro.es_equipo_empresa IN ('1','6','8') THEN
                    v_procedencia_equipo    := c_proced_empresa_dealer;
                ELSIF v_reg_articulo_maestro.es_equipo_empresa IN ('2','7') THEN
                    po_cod_err := 'PVT-2371';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Cambio con equipo seedstock no permitido en dealer.
                    RAISE err_app;
                ELSIF v_reg_articulo_maestro.es_equipo_empresa = '3' THEN
                    v_procedencia_equipo    := c_proced_dealer;
                END IF;
            ELSIF v_cod_tipo_almacen = c_tipo_almacen_cliente THEN
                v_procedencia_equipo    := c_proced_cliente;
            ELSE
                po_cod_err := 'PVT-2372';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Tipo de almacen no considerado.
                RAISE err_app;
            END IF;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_procedencia_equipo    := c_proced_cliente;
        END;

        --NO SE PERMITEN CAMBIOS DE EQUIPO CON EQUIPO DEL CLIENTE NI DEL DEALER PARA PLANES VIVA MI CASA
        IF v_cod_tipo_entidad_venta_p IN ('TEVDLR', 'TEVMDL') THEN
            -- En dealer solo se permite cambios normales y doa
            IF     pi_cod_tipo_cambio_equipo IS NOT NULL
               AND pi_cod_tipo_cambio_equipo NOT IN
                       (c_tipo_cambio_equipo_normal,
                        c_tipo_cambio_equipo_doa,
                        c_tipo_cambio_equipo_puntos
                       ) THEN
                po_cod_err := 'PVT-2373';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El equipo que desea cambiar esta fuera del tiempo de garantia.
                RAISE err_app;
            END IF;
        END IF;


        -- SI EL TIPO DE CAMBIO ES POR DOA
        IF     pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_doa
           AND v_cod_tipo_entidad_venta_p IN ('TEVDLR', 'TEVMDL')
           AND v_permiso_por_dealer = c_falso
           AND v_fch_tran > (v_reg_entidad_consumo.fch_creacion + c_tiempo_doa_equipo_deal) THEN
            po_cod_err := 'PVT-2374';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El tiempo para realizar el cambio de equipo por DOA(muerto en caja) ya expiro
            RAISE err_app;
        END IF;


     --SI ES CAMBIO DOA VALIDAR COD_TIPO PARA ROLES DEFINIDOS EN RQX-6550
        IF   pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_doa THEN
                 po_cod_err := 'PVT-2375';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al validar formato de cambio de equipo.
                tx_seg_sesion.get_permiso (pi_cod_usuario         => pi_cod_usuario,
                                   pi_cod_entidad                 => 'ESP_CAMBIO_EQUIPO_VALPERMISO',
                                   pi_cod_usuario_tran            => pi_cod_usuario,
                                   po_permiso                     => v_validar_cod_equipo,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

             IF (po_cod_err <> 'OK') THEN
                 RAISE err_app;
             END IF;
             IF v_validar_cod_equipo = c_verdadero THEN
                 po_cod_err := 'PVT-2376';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al validar codigos de equipos.

                 SELECT  cod_articulo
                   INTO v_cod_articulo
                   FROM   cl_articulo_entidad_consumo
                  WHERE       id_entidad_consumo = pi_id_entidad_consumo AND
                           fch_fin > SYSDATE
                          AND cod_rubro_articulo IN ('TAGSM', 'TACDMA');

                  IF pi_cod_articulo <> v_cod_articulo THEN
                     po_cod_err := 'PVT-2377';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: En Cambios DOA el cod. equipo nuevo debe ser el mismo equipo despachado al cliente.
                     RAISE err_app;
                  END IF;
            END IF;
        END IF;

        -- SI EL TIPO DE CAMBIO DE EQUIPO ES POR EXCHANGE
        --Ticket 30253 - No tomar en cuenta domingos para el calculo de garantia
        --RQX 3138 - Ampliacion Tiempo Garantia Exchange de 3 a 6 dias laborables, y garantia tiempo conversacion menor a 30 minutos
        --Si el cambio de equipo es exchange y el tiempo de conversacion es mayor a 30 minutos entonces, equipo fuera de garantia

        IF     pi_cod_tipo_cambio_equipo IS NOT NULL
           AND pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_exchange THEN

           IF (tx_inv_precio_articulo.aplica_cambio_equipo_generico(pi_id_entidad_consumo,pi_cod_motivo_cambio)) = c_falso THEN
               po_cod_err := 'PVT-2378';   --TX_PVT_ENTIDAL_CONSUMO.CAMBIO_EQUIPO: Cliente no aplica a cambio de equipo
               RAISE err_app;
           END IF;

        END IF;

        --RQX 3138 - Ampliacion Tiempo Garantia Exchange de 3 a 6 dias laborables, y garantia tiempo conversacion menor a 30 minutos

        --VALIDACION PRIVILEGIOS PARA DEVOLUCION
        IF     v_procedencia_equipo IN (c_proced_empresa)
           AND NVL (pi_es_devolucion, c_falso) = c_verdadero THEN
            tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                       pi_cod_entidad                 => 'ESP_CAMBIO_EQUIPO_DEVOLUCION',
                                       pi_cod_usuario_tran            => pi_cod_usuario,
                                       po_permiso                     => v_permiso,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            IF v_permiso = c_falso THEN
                po_cod_err := 'PVT-2379';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El usuario no tiene privilegio para registrar cambio de equipo con devolucion.
                RAISE err_app;
            END IF;
        END IF;

        --VALIDACION PRIVILEGIOS PARA DESCUENTO
        IF v_procedencia_equipo IN (c_proced_empresa) AND NVL (pi_descuento, 0) > 0 THEN
            tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                       pi_cod_entidad                 => 'ESP_CAMBIO_EQUIPO_CON_DESCUENTO',
                                       pi_cod_usuario_tran            => pi_cod_usuario,
                                       po_permiso                     => v_permiso,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            IF v_permiso = c_falso THEN
                po_cod_err := 'PVT-2380';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El usuario no tiene privilegio para registrar cambio de equipo con descuento.
                RAISE err_app;
            END IF;
        END IF;

        --VALIDACION PRIVILEGIOS PARA USO DE PUNTOS
        IF NVL (pi_puntos_utilizados, 0) > 0 THEN
            tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                       pi_cod_entidad                 => 'ESP_CAMBIO_EQUIPO_CON_PUNTOS',
                                       pi_cod_usuario_tran            => pi_cod_usuario,
                                       po_permiso                     => v_permiso,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            IF v_permiso = c_falso THEN
                po_cod_err := 'PVT-2381';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El usuario no tiene privilegio para cambiar equipo con puntos.
                RAISE err_app;
            END IF;
        END IF;
        --VALIDACION PRIVILEGIOS PARA CAMBIO DE EQUIPO CON EQUIPO
        IF pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm) THEN
            IF v_procedencia_equipo IN (c_proced_empresa, c_proced_empresa_dealer) THEN
                tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                           pi_cod_entidad                 => 'ESP_CAMBIO_EQUIPO_COEQ',
                                           pi_cod_usuario_tran            => pi_cod_usuario,
                                           po_permiso                     => v_permiso,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;

                IF v_permiso = c_falso THEN
                    po_cod_err := 'PVT-2382';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El usuario solo tiene permiso para realizar cambio de equipo con equipo del dealer o cliente.
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        IF NVL (pi_es_devolucion, c_falso) = c_verdadero AND v_procedencia_equipo = c_proced_cliente THEN
            po_cod_err := 'PVT-2383';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Para realizar la devolucion el nuevo equipo no debe ser del cliente.
            RAISE err_app;
        END IF;

        --NO SE PUEDEN CARGAR DEUDAS A CUENTAS PREPAGO
        IF     v_cod_linea_negocio NOT IN ('POSCOR', 'FIJCOR')
           AND NVL (pi_es_pago_diferido, c_falso) = c_verdadero
           AND pi_id_financiamiento IS NULL THEN
            po_cod_err := 'PVT-2384';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No se pueden registrar cargos diferidos a cuentas no corporativas.
            RAISE err_app;
        END IF;

        --NUEVA SERIE DISTINTA A LA ACTUAL
        IF pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma) THEN
            IF pi_nro_serie = v_reg_entidad_consumo.imsi THEN
                po_cod_err := 'PVT-2385';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El numero de serie nuevo es igual al actual.
                RAISE err_app;
            END IF;
        END IF;

        --NUEVA SERIE DISTINTA A LA ACTUAL
        IF pi_tipo_cambio IN (c_tipo_cambio_sim) THEN
            IF tx_pvt_ccs.get_imsi (pi_nro_serie) = v_reg_entidad_consumo.imsi THEN
                po_cod_err := 'PVT-2386';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El numero de serie nuevo es igual al actual.
                RAISE err_app;
            END IF;
        END IF;

        --VALIDACION DE ESTRUCTURA DE SERIAL
        IF pi_tipo_cambio = c_tipo_cambio_equipo_cdma THEN
            --EL ESN DEBE TENER 11 DIGITOS DE LONGITUD
            IF LENGTH (pi_nro_serie) <> 11 THEN
                po_cod_err := 'PVT-2387';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El ESN no tiene la longitud correcta.
                RAISE err_app;
            END IF;
        END IF;

        --VERIFICAR QUE LA ENTIDAD DE CONSUMO NO TENGA TRANSACCIONES PENDIENTES
        IF pi_id_prospecto_tec IS NULL THEN
            po_cod_err := 'PVT-2388';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al verificar si el suscriptor tiene transacciones pendientes.

            SELECT COUNT (*)
              INTO v_dummy
              FROM vta_articulo_prospecto p
             WHERE p.id_entidad_consumo = pi_id_entidad_consumo
               AND p.estado = c_estado_activo
               AND p.fch_tran = v_fch_tran;

            IF v_dummy > 0 THEN
                po_cod_err := 'PVT-2389';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El suscriptor tiene una transaccion pendiente.
                RAISE err_app;
            END IF;
        END IF;

        --VERIFICAR QUE EL ESN NO ESTE RESERVADO POR UNA ACTIVACION O CAMBIO DE EQUIPO PENDIENTE
        po_cod_err := 'PVT-2390';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al verificar si el articulo esta disponible.

        SELECT COUNT (*)
          INTO v_dummy
          FROM vta_articulo_prospecto ap
         WHERE ap.nro_serie = pi_nro_serie AND ap.estado = c_estado_activo;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2391';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El articulo no esta disponible.
            RAISE err_app;
        END IF;

        --VERIFICAR QUE EL NUMERO DE SERIE IMEI NO HAYA SIDO VENDIDO HACE MENOS DE TRES MESES
        IF pi_tipo_cambio = c_tipo_cambio_equipo_gsm THEN
            SELECT COUNT (*)
              INTO v_dummy
              FROM inv_articulo_maestro am
             WHERE am.nro_serie = pi_nro_serie AND am.cod_almacen <> 'ACLI';

            IF v_dummy = 0 THEN
                SELECT COUNT (*)
                  INTO v_dummy
                  FROM cl_articulo_entidad_consumo aec
                 WHERE aec.nro_serie = pi_nro_serie
                   AND aec.id_entidad_consumo <> pi_id_entidad_consumo
                   AND aec.cod_rubro_articulo = 'TAGSM'
                   AND aec.fch_inicio > SYSDATE - 90
                   AND aec.estado <> c_estado_inactivo
                   --RQX 7623 - Modificacion disponibilidad de Serie - algunas transacciones no estan seteando el estado.
                   and aec.fch_fin>sysdate;

                IF v_dummy > 0 THEN
                    po_cod_err := 'PVT-2392';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El equipo se activo con otro suscriptor hace menos de 3 meses.
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        --SIEMPRE ESTARA REGISTRADO EL COD_ARTICULO. PARA MODELOS NO EXISTENTES EN INVENTARIO EXISTIRA OTGSM Y OTCDMA
        po_cod_err := 'PVT-2393';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al obtener los datos del articulo.

        SELECT *
          INTO v_reg_articulo
          FROM inv_articulo a
         WHERE a.cod_articulo = pi_cod_articulo;

        --VERIFICAR QUE EL NRO DE SERIE NO ESTE REGISTRADO EN SERIALES NEGADAS, PARA EQUIPOS CDMA Y GSM
        IF pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm) THEN
            po_cod_err := 'PVT-2394';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al verificar si el articulo es negado.

            IF mt_ssn_util.es_serie_negada (pi_nro_serie) = 1 THEN
                po_cod_err := 'PVT-2395';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El Equipo esta reportado como negado.
                RAISE err_app;
            END IF;

            IF mt_ssn_util.es_tac_valido (pi_nro_serie) = 0 THEN
                po_cod_err := 'PVT-6107';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El Equipo no es valido para activar.
                RAISE err_app;
            END IF;

        END IF;

        --LOS SIMS DEBEN SER SIEMPRE DE LA EMPRESA
        IF     pi_tipo_cambio = c_tipo_cambio_sim
           AND v_procedencia_equipo IN (c_proced_dealer, c_proced_cliente) THEN
            po_cod_err := 'PVT-2396';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: La procedencia del SIM debe ser la empresa.
            RAISE err_app;
        END IF;

        --DETERMINAR EL CARGO RELACIONADO AL TIPO DEL ARTICULO
        po_cod_err := 'PVT-2397';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el cargo del equipo.

        SELECT id_cargo
          INTO v_id_cargo_articulo
          FROM cnf_rubro_cargo rc
         WHERE rc.cod_rubro_articulo = v_reg_articulo.cod_tipo
           AND rc.estado <> c_estado_inactivo
           AND rc.fch_fin = c_fecha_fin;

        --SOLO PARA LOS EQUIPOS DE LA EMPRESA SE CALCULA SU PRECIO
        SELECT ROUND (SUM (b.valor_porcentual) / 100, 2)
          INTO v_porcentaje_impuestos
          FROM bl_cargo_impuesto a, bl_impuesto b
         WHERE id_cargo_impuesto = v_id_cargo_articulo
           AND a.cod_impuesto = b.cod_impuesto
           AND a.estado <> c_estado_inactivo
           AND a.fch_fin_vigencia = c_fecha_fin;

          begin
            select count(1)
                      into v_id_ec_tiene_promo
                     from prm_base pb, prm_cnf_promocion pcp, prm_promo pp
                    where pb.id_entidad_consumo = pi_id_entidad_consumo
                     and pb.id_cnf_promocion = pcp.id_cnf_promocion
                     and pcp.id_promocion = pp.id_promocion
                     and pp.descripcion like '%5688%'
                     and pb.estado = 'PEN';
          exception
            when others then
              v_id_ec_tiene_promo := 0;
          end;

        IF v_procedencia_equipo IN (c_proced_empresa, c_proced_empresa_dealer) THEN

            --Ticket 115143 - Correccion RQX 5745 Bloqueo Heat 136 negro codigo 6755 - INICIO
            IF  pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                AND pi_tipo_cambio IN ('TCECDMA', 'TCEGSM')
                  AND pi_cod_motivo_cambio IN ('CSE003','CSE011') THEN

                po_cod_err := 'PVT-2398';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al verificar si el articulo aplica a la promocion.
                SELECT COUNT(1)
                  INTO v_dummy
                  FROM (SELECT valor
                          FROM TABLE (tx_utiles.SPLIT(tx_cnf_constante.get_constante('ARTICULOS_NO_APLICAN_OFERTA'))) --EQUIPO HEAT
                         WHERE valor = pi_cod_articulo
                           AND v_reg_entidad_consumo.cod_plan IN (SELECT valor FROM TABLE (tx_utiles.SPLIT(tx_cnf_constante.get_constante('PLANES_NO_APLICAN_OFERTA')))) --VMCP
                           AND NOT EXISTS (SELECT 1
                                             FROM vta_excepcion
                                            WHERE id_entidad_consumo = pi_id_entidad_consumo
                                              AND cod_tipo_excepcion = c_tipo_excepcion_cambio_equipo
                                              AND cod_plan = v_reg_entidad_consumo.cod_plan
                                              AND estado = c_estado_activo));
                IF v_dummy > 0  THEN
                    po_cod_err := 'PVT-2399';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No hay oferta de equipos disponible con este modelo, favor intentar con otro artículo.
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-2400';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al finalizar la excepcion de cambio de equipos.
                UPDATE vta_excepcion
                   SET estado = c_estado_pagado,
                       id_tran_fin = v_id_tran,
                       cod_gestion_tran_fin = v_cod_gestion_tran,
                       cod_usuario_fin = pi_cod_usuario
                 WHERE id_entidad_consumo = pi_id_entidad_consumo
                   AND cod_tipo_excepcion = c_tipo_excepcion_cambio_equipo
                   AND cod_plan = v_reg_entidad_consumo.cod_plan
                   AND estado = c_estado_activo;
            END IF;
            --Ticket 115143 - Correccion RQX 5745 Bloqueo Heat 136 negro codigo 6755 - FIN

            --CALCULO DEL PRECIO DE VENTA DEL ARTICULO--------------------------------------------------------
            IF     pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
               AND pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm)
               AND pi_cod_motivo_cambio IN ('CSE003','CSE011')
               AND tx_inv_precio_articulo.aplica_precio_corporativo (pi_id_entidad_consumo) =
                                                                                         c_verdadero THEN
                po_cod_err := 'PVT-2401';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_lista    :=
                    tx_inv_precio_articulo.get_precio_corporativo
                                                          (pi_cod_articulo,
                                                           v_reg_entidad_consumo.id_entidad_consumo);

                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-2402';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error el precio de venta del equipo para corporativo no esta definido.
                    RAISE err_app;
                END IF;

             ELSIF     pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio IN ('TCECDMA', 'TCEGSM')
                  AND pi_cod_motivo_cambio IN ('CSE003')
                  AND tx_inv_precio_articulo.aplica_precio_descuento_fija (pi_id_entidad_consumo) =
                                                                                         c_verdadero
                  AND prm_aplica_promocion(sysdate,'5688') = '1'
                  AND pi_cod_articulo = '6696'
                  AND v_id_ec_tiene_promo > 0
                       THEN
                po_cod_err := 'PVT-2403';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_lista    :=
                    tx_inv_precio_articulo.get_precio_descuento
                                                          (pi_cod_articulo,
                                                           v_reg_entidad_consumo.id_entidad_consumo);

                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-2404';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error el precio de venta del equipo para FIJA e EVDO no esta definido.
                    RAISE err_app;
                END IF;

                 --Rqx.5688 Actualizacion PRM_BASE

                IF  prm_aplica_promocion(sysdate,'5688') = c_verdadero AND tx_inv_precio_articulo.aplica_precio_descuento_fija (pi_id_entidad_consumo) = c_verdadero AND  pi_cod_articulo = '6696' THEN
                  begin
                    po_cod_err := 'PVT-2405';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No se pudo actualizar el registro de la promocion.
                    update prm_base
                       set estado = 'R'
                    where id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                      and id_cnf_promocion = PRM_GET_ID_CNF_PROMOCION('5688')
                      and estado = 'PEN';

                  exception
                    when others then
                      NULL;
                  end;

               END IF;
            ELSIF     pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio IN ('TCECDMA', 'TCEGSM')
                  AND pi_cod_motivo_cambio IN ('CSE003','CSE011')
                  AND (   tx_inv_precio_articulo.aplica_precio_descuento_fija (pi_id_entidad_consumo) =
                                                                                         c_verdadero
                       OR tx_inv_precio_articulo.aplica_precio_descuento_evdo (pi_id_entidad_consumo) =
                                                                                         c_verdadero
                       OR tx_inv_precio_articulo.aplica_precio_descuento_interm (pi_id_entidad_consumo) =
                                                                                         c_verdadero
                      ) THEN

                po_cod_err := 'PVT-2406';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_lista    :=
                    tx_inv_precio_articulo.get_precio_descuento
                                                          (pi_cod_articulo,
                                                           v_reg_entidad_consumo.id_entidad_consumo);

                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-2407';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error el precio de venta del equipo para FIJA e EVDO no esta definido.
                    RAISE err_app;
                END IF;

                --Rqx.5499 Actualizacion PRM_BASE

                IF  prm_aplica_promocion(sysdate,'5499') = c_verdadero AND tx_inv_precio_articulo.aplica_precio_descuento_fija (pi_id_entidad_consumo) = c_verdadero AND  pi_cod_articulo = '6696' THEN
                  begin
                    po_cod_err := 'PVT-2408';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error el precio de venta del equipo para FIJA e EVDO no esta definido.
                    update prm_base
                       set estado = 'R'
                    where id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                      and id_cnf_promocion = PRM_GET_ID_CNF_PROMOCION('5499')
                      and estado = 'PEN';

                  exception
                    when others then
                      NULL;
                  end;

               END IF;
            ELSIF      pi_cod_tipo_cambio_equipo in (c_tipo_cambio_equipo_normal,c_tipo_cambio_equipo_exchange)
               AND pi_cod_motivo_cambio = 'CSE003'
               AND tx_inv_precio_articulo.aplica_precio_cambio_equipo (pi_id_entidad_consumo, pi_cod_articulo) =
                                                                                         c_verdadero THEN

                po_cod_err := 'PVT-5204';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_lista    :=
                    tx_inv_precio_articulo.get_precio_cambio_equipo
                                                          ( v_reg_entidad_consumo.id_entidad_consumo,
                                                            pi_cod_articulo);

                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-5205';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error el precio de venta del equipo para corporativo no esta definido.
                    RAISE err_app;
                END IF;
            ELSIF     pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio IN ('TCECDMA', 'TCEGSM')
                  AND pi_cod_motivo_cambio IN ('CSE005','CSE003','CSE011')
                  AND tx_inv_precio_articulo.aplica_desc_fija_reparacion (pi_id_entidad_consumo,
                                                                          pi_cod_usuario) =
                                                                                         c_verdadero THEN
                v_precio_lista    :=
                    tx_inv_precio_articulo.get_precio_plan (pi_cod_articulo,
                                                            v_reg_entidad_consumo.cod_plan);

                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-2409';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                    RAISE err_app;
                END IF;
            ELSIF     pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm)
                  AND tx_inv_precio_articulo.aplica_precio_subsidio (pi_id_entidad_consumo) =
                                                                                         c_verdadero
                  AND pi_cod_motivo_cambio = 'CSE008'   -- MOTIVO PROGRAMA DE SUBSIDIO
                                                     THEN

                po_cod_err := 'PVT-2410';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio con subsidio del equipo.
                v_precio_lista    :=
                    tx_inv_precio_articulo.get_precio_subsidio (pi_cod_articulo,
                                                                pi_id_entidad_consumo);

                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-2411';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No existe un precio subsidiado para articulo seleccionado.
                    RAISE err_app;
                END IF;

            ELSIF     pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm)
                  AND tx_inv_precio_articulo.aplica_precio_subsidio (pi_id_entidad_consumo) =
                                                                                         c_verdadero
                  AND pi_cod_motivo_cambio = 'CSE010'   -- MOTIVO PROGRAMA DE SUBSIDIO
                                                     THEN
                po_cod_err := 'PVT-2412';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio con subsidio del equipo.
                v_precio_lista    :=
                    tx_inv_precio_articulo.get_precio_subsidio_especial (pi_cod_articulo,
                                                                pi_id_entidad_consumo);

                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-2413';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No existe un precio subsidiado para articulo seleccionado.
                    RAISE err_app;
                END IF;
            ELSIF     pi_cod_tipo_cambio_equipo <> c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm)
                  AND tx_inv_precio_articulo.aplica_cambio_equipo_generico (pi_id_entidad_consumo,pi_cod_motivo_cambio) =
                                                                                         c_falso
                  AND pi_cod_motivo_cambio in ('CSE005','CSE006')   -- MOTIVO CAMBIO POR SEEDSTOCK O POR FALLA DE EQUIPO
                                                     THEN
                     po_cod_err := 'PVT-2414';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No existe un precio subsidiado para articulo seleccionado.
                     RAISE err_app;
            ELSIF     pi_cod_tipo_cambio_equipo <> c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm)
                  AND tx_inv_precio_articulo.aplica_cambio_equipo_generico (pi_id_entidad_consumo,pi_cod_motivo_cambio) =
                                                                                     c_falso
                  AND pi_cod_motivo_cambio in ('CSE012','CSE013')   -- MOTIVO CAMBIO POR SEEDSTOCK O POR FALLA DE EQUIPO
                                                 THEN
                 po_cod_err := 'PVT-2415';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No se puede realizar el cambio de equipo, equipo fuera de garantia.
                 RAISE err_app;
            ELSIF
--                  pi_cod_tipo_cambio_equipo <> c_tipo_cambio_equipo_normal
                      pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm)
                  AND tx_eqp_refurbished.validar_cambio_refurbished(pi_id_entidad_consumo,pi_nro_serie) = c_verdadero
                  AND pi_cod_motivo_cambio in ('CSE014')   -- MOTIVO CAMBIO REFURBISHED
                                                 THEN
                v_precio_lista    :=  tx_eqp_refurbished.costo_eqp_gar_ref (pi_id_entidad_consumo);

                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-2416';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El precio_lista no puede ser nulo.
                    RAISE err_app;
                END IF;
            ELSIF     pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm)
                  AND pi_cod_motivo_cambio = 'CSE015'   -- MOTIVO PROGRAMA MIGRACION MASIVA CDMA
                                                     THEN
                po_cod_err := 'PVT-2417';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio con subsidio del equipo.
                v_precio_lista    :=
                    tx_inv_precio_articulo.get_precio_mig_cdma (pi_cod_articulo,
                                                                pi_id_entidad_consumo);

                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-2418';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No existe un precio subsidiado para articulo seleccionado.
                    RAISE err_app;
                END IF;
            ELSIF   pi_tipo_cambio = c_tipo_cambio_sim THEN  --new
                po_cod_err := 'PVT-5180';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio con subsidio del equipo.
                v_precio_lista := tx_inv_precio_articulo.get_precio_cambio_usim(
                                        pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                        pi_cod_articulo         => pi_cod_articulo,
                                        pi_nro_serie            => pi_nro_serie,
                                        pi_id_tran              => v_id_tran,
                                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                                        pi_fch_tran             => v_fch_tran
                                        );
                IF v_precio_lista IS NULL THEN
                    po_cod_err := 'PVT-5181';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                    v_precio_lista    := tx_inv_precio_articulo.get_precio_lista (pi_cod_articulo,
                                                                                  'LISTA');
                END IF;
            ELSE
                po_cod_err := 'PVT-2419';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_lista    := tx_inv_precio_articulo.get_precio_lista (pi_cod_articulo,
                                                                              'LISTA');
            END IF;

            ---- AMC determinar cobro de sim
            v_procedencia_equipo_telf    := NULL;

            IF pi_id_prospecto_tec IS NOT NULL AND pi_tipo_cambio = c_tipo_cambio_sim THEN
                SELECT COUNT (1)
                  INTO v_es_prepago
                  FROM bm_plan b, bm_grupo_plan bg
                 WHERE b.cod_plan = v_reg_entidad_consumo.cod_plan
                   AND bg.cod_grupo_plan = b.cod_grupo_plan
                   AND bg.cod_linea_negocio = 'PREPAG';

                po_cod_err := 'PVT-2420';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar la procedencia del articulo de telefono

                SELECT NVL (v.procedencia_articulo, '-10101')
                  INTO v_procedencia_equipo_telf
                  FROM vta_articulo_prospecto v
                 WHERE v.id_prospecto_cambio_tec = pi_id_prospecto_tec;

                IF    v_es_prepago = 0
                   OR v_procedencia_equipo_telf IN (c_proced_empresa, c_proced_empresa_dealer, c_proced_cliente) THEN
                    v_precio_lista    := 0;
                END IF;
            END IF;

            ---- AMC determinar cobro de sim
            IF NVL (pi_descuento, 0) > 0 THEN
                po_cod_err := 'PVT-2421';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al aplicar el descuento del equipo.

                IF pi_tipo_descuento = c_tipo_descuento_porcentual THEN
                    v_monto_descuento    := ROUND (v_precio_lista * pi_descuento / 100, 2);
                ELSIF pi_tipo_descuento = c_tipo_descuento_valor THEN
                    v_monto_descuento    := ROUND (pi_descuento / (1 + v_porcentaje_impuestos), 2);
                END IF;

                v_precio_venta    := v_precio_lista - v_monto_descuento;
            ELSIF NVL (pi_puntos_utilizados, 0) > 0 THEN
                IF     pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_puntos
                   AND pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm)
                   AND NVL
                           (tx_inv_precio_articulo.get_precio_vidas_entidad
                                                           (pi_cod_articulo,
                                                            v_reg_entidad_consumo.id_entidad_consumo),
                            0) > 0 THEN
                    po_cod_err := 'PVT-2422';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                    v_precio_lista    :=
                        tx_inv_precio_articulo.get_precio_vidas_entidad
                                                          (pi_cod_articulo,
                                                           v_reg_entidad_consumo.id_entidad_consumo);
                ELSE
                    po_cod_err := 'PVT-2423';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el el precio de lista con impuestos del articulo.
                    v_precio_lista_con_imp    :=
                          tx_vda_util.get_articulo_valor_en_vidas (pi_cod_articulo)
                        * tx_vda_util.monto_equivalente (1);
                    v_precio_lista            := ROUND (  v_precio_lista_con_imp
                                                        / (1 + v_porcentaje_impuestos),
                                                        2);
                END IF;

                po_cod_err := 'PVT-2424';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el monto equivalente a los puntos.
                v_monto_puntos_con_imp    :=
                                       tx_vda_util.monto_equivalente (NVL (pi_puntos_utilizados, 0));
                v_monto_puntos            := ROUND (  v_monto_puntos_con_imp
                                                    / (1 + v_porcentaje_impuestos),
                                                    2);
                v_precio_venta            := v_precio_lista - v_monto_puntos;

                IF ABS (v_precio_venta) < 1 THEN
                    v_precio_venta    := 0;
                END IF;
            ELSE
                v_monto_descuento    := 0;
                v_precio_venta       := v_precio_lista;
            END IF;

            IF v_precio_venta < 0 THEN
                po_cod_err := 'PVT-2425';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El precio de venta es menor a cero.
                RAISE err_app;
            END IF;

        ELSIF v_procedencia_equipo = c_proced_dealer THEN

            IF pi_cod_motivo_cambio = 'CSE003' THEN
                IF get_segmento(v_reg_entidad_consumo.cod_plan) = 'CASPRE' THEN
                    SELECT count(1)
                      INTO v_dummy
                      FROM cl_lifecycle
                     WHERE internal_id = pi_id_entidad_consumo
                       AND current_state = '2';

                    IF v_dummy <> 1 THEN
                        po_cod_err := 'PVT-5228';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: La entidad de consumo debe estar en estado Activo.
                        RAISE err_app;
                    END IF;
                ELSE
                    SELECT count(1)
                      INTO v_dummy
                      FROM cl_entidad_consumo
                     WHERE id_entidad_consumo = pi_id_entidad_consumo
                       AND estado = 'A';

                    IF v_dummy <> 1 THEN
                        po_cod_err := 'PVT-5231';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: La entidad de consumo debe estar en estado Activo.
                        RAISE err_app;
                    END IF;
                END IF;
            END IF;

            IF pi_cod_motivo_cambio = 'CSE008' THEN
                SELECT count(1)
                  INTO v_dummy
                  FROM cl_entidad_consumo
                 WHERE id_entidad_consumo = pi_id_entidad_consumo
                   AND estado = 'A';

                IF v_dummy <> 1 THEN
                    po_cod_err := 'PVT-5232';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: La entidad de consumo debe estar en estado Activo.
                    RAISE err_app;
                END IF;
            END IF;

            IF NVL (pi_puntos_utilizados, 0) > 0 THEN
                po_cod_err := 'PVT-5217';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Su entidad de venta no puede canjear puntos.
                RAISE err_app;
            END IF;

            IF NVL (pi_es_pago_diferido, c_falso) = c_verdadero THEN
                po_cod_err := 'PVT-5218';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Su entidad de venta no puede diferir ventas.
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-5219';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de lista del equipo.
            v_precio_lista    := tx_inv_precio_articulo.get_precio_lista (pi_cod_articulo,'LISTA');
            v_monto_descuento := 0;

     IF pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                AND pi_tipo_cambio = c_tipo_cambio_equipo_gsm
                AND pi_cod_motivo_cambio = 'CSE003'
                AND tx_inv_precio_articulo.aplica_precio_subsidio (pi_id_entidad_consumo) = c_verdadero
            THEN
                po_cod_err := 'PVT-5220';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_venta := tx_inv_precio_articulo.get_precio_subsidio (pi_cod_articulo,
                                                                               v_reg_entidad_consumo.id_entidad_consumo,
                                                                               'CSE003');
                IF v_precio_venta IS NULL THEN
                    po_cod_err := 'PVT-5221';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El precio de venta del equipo no esta definido.
                    RAISE err_app;
                END IF;

            ELSIF pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                AND pi_tipo_cambio = c_tipo_cambio_equipo_gsm
                AND pi_cod_motivo_cambio = 'CSE003'
                AND tx_inv_precio_articulo.aplica_precio_descuento_fija (pi_id_entidad_consumo) = c_verdadero
            THEN
                po_cod_err := 'PVT-5220';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_venta := tx_inv_precio_articulo.get_precio_descuento (pi_cod_articulo,
                                                                               v_reg_entidad_consumo.id_entidad_consumo);
                IF v_precio_venta IS NULL THEN
                    po_cod_err := 'PVT-5221';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El precio de venta del equipo no esta definido.
                    RAISE err_app;
                END IF;

            ELSIF pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio = c_tipo_cambio_equipo_gsm
                  AND pi_cod_motivo_cambio = 'CSE003'
                  AND tx_inv_precio_articulo.aplica_precio_cambio_equipo (pi_id_entidad_consumo, pi_cod_articulo) = c_verdadero
            THEN
                po_cod_err := 'PVT-5229';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_venta := tx_inv_precio_articulo.get_precio_cambio_equipo ( pi_id_entidad_consumo,
                                                                                    pi_cod_articulo);
                IF v_precio_venta IS NULL THEN
                    po_cod_err := 'PVT-5230';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El precio de venta del equipo no esta definido.
                    RAISE err_app;
                END IF;

            ELSIF pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio = c_tipo_cambio_equipo_gsm
                  AND pi_cod_motivo_cambio = 'CSE003'
                  AND tx_inv_precio_articulo.aplica_desc_fija_reparacion (pi_id_entidad_consumo, pi_cod_usuario) = c_verdadero
            THEN
                po_cod_err := 'PVT-5222';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_venta := tx_inv_precio_articulo.get_precio_plan ( pi_cod_articulo,
                                                                           v_reg_entidad_consumo.cod_plan);
                IF v_precio_venta IS NULL THEN
                    po_cod_err := 'PVT-5223';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El precio de venta del equipo no esta definido.
                    RAISE err_app;
                END IF;

            ELSIF pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio = c_tipo_cambio_equipo_gsm
                  AND pi_cod_motivo_cambio = 'CSE003'
                  AND tx_inv_precio_articulo.aplica_precio_corporativo (pi_id_entidad_consumo) = c_verdadero
            THEN
                po_cod_err := 'PVT-5224';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio de venta del equipo.
                v_precio_venta := tx_inv_precio_articulo.get_precio_corporativo ( pi_cod_articulo,
                                                                                  v_reg_entidad_consumo.id_entidad_consumo);

                IF v_precio_venta IS NULL THEN
                    po_cod_err := 'PVT-5225';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El precio de venta del equipo para corporativo no esta definido.
                    RAISE err_app;
                END IF;

            ELSIF pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio = c_tipo_cambio_equipo_gsm
                  AND pi_cod_motivo_cambio = 'CSE008'
                  AND tx_inv_precio_articulo.aplica_precio_subsidio (pi_id_entidad_consumo) = c_verdadero
            THEN

                IF v_cod_motivo_descuento = 'FINBA' THEN -- ugly fix BA
                    po_cod_err := 'PVT-6002';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio con subsidio del equipo.
                    v_precio_venta := tx_inv_precio_articulo.get_precio_subsidio_fin ( pi_cod_articulo,
                                                                                   v_reg_entidad_consumo.id_entidad_consumo);
                ELSE
                    po_cod_err := 'PVT-5226';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio con subsidio del equipo.
                    v_precio_venta := tx_inv_precio_articulo.get_precio_subsidio ( pi_cod_articulo,
                                                                                   v_reg_entidad_consumo.id_entidad_consumo);
                END IF;


                IF v_precio_venta IS NULL THEN
                    po_cod_err := 'PVT-5227';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No existe un precio subsidiado para articulo seleccionado.
                    RAISE err_app;
                END IF;

            ELSIF pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal
                  AND pi_tipo_cambio = c_tipo_cambio_equipo_gsm
                  AND pi_cod_motivo_cambio = 'CSE010'
                  AND tx_inv_precio_articulo.aplica_precio_subsidio (pi_id_entidad_consumo) = c_verdadero
            THEN


                    po_cod_err := 'PVT-5226';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el precio con subsidio del equipo.
                    v_precio_venta := tx_inv_precio_articulo.get_precio_subsidio_especial ( pi_cod_articulo,
                                                                                            v_reg_entidad_consumo.id_entidad_consumo);


                IF v_precio_venta IS NULL THEN
                    po_cod_err := 'PVT-5227';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No existe un precio subsidiado para articulo seleccionado.
                    RAISE err_app;
                END IF;

            ELSE
                v_precio_venta            := 0;
                v_monto_descuento         := 0;
                v_monto_puntos            := 0;
                v_precio_lista_con_imp    := 0;
            END IF;
        ELSE
            IF NVL (pi_puntos_utilizados, 0) > 0 THEN
                po_cod_err := 'PVT-2426';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Su entidad de venta no puede canjear puntos.
                RAISE err_app;
            END IF;

            IF NVL (pi_es_pago_diferido, c_falso) = c_verdadero THEN
                po_cod_err := 'PVT-2427';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Su entidad de venta no puede diferir ventas.
                RAISE err_app;
            END IF;

            v_precio_venta            := 0;
            v_monto_descuento         := 0;
            v_monto_puntos            := 0;
            v_precio_lista_con_imp    := 0;
        END IF;

        --v_precio_venta_con_imp    := ROUND (v_precio_venta * (1 + v_porcentaje_impuestos), 2);
        --FIN  CALCULO DEL PRECIO DE VENTA DEL ARTICULO---------------------------------------------------
        po_cod_err := 'PVT-2428';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al registrar el prospecto de venta del articulo.
        cc_vta_articulo_prospecto.alta
                       (pi_id_prospecto_cliente        => NULL,
                        pi_id_prospecto_ec             => NULL,
                        pi_id_prospecto_tec            => pi_id_prospecto_tec,
                        pi_id_entidad_consumo          => pi_id_entidad_consumo,
                        pi_id_cliente                  => v_id_cliente,
                        pi_id_comunidad_facturante     => v_reg_entidad_consumo.id_comunidad_facturante,
                        pi_cod_rubro_articulo          => v_reg_articulo.cod_tipo,
                        pi_cod_articulo                => pi_cod_articulo,
                        pi_nro_serie                   => pi_nro_serie,
                        pi_cod_motivo_cambio           => pi_cod_motivo_cambio,
                        pi_precio_venta                => v_precio_venta,
                        pi_cod_moneda                  => 'DOP',
                        pi_precio_nominal              => v_precio_lista,
                        pi_cantidad_bonificacion       => NVL (pi_puntos_utilizados, 0),
                        pi_bonificacion                => v_monto_puntos,
                        pi_descuento                   => v_monto_descuento,
                        pi_cod_motivo_descuento        => CASE WHEN v_cod_motivo_descuento = 'FINBA' THEN NULL ELSE pi_cod_motivo_descuento END,
                        pi_cod_promocion               => NULL,
                        pi_cod_plan_venta              => NULL,
                        pi_es_devolucion               => NVL (pi_es_devolucion, c_falso),
                        pi_cod_categoria               => pi_cod_categoria,
                        pi_es_diferido                 => NVL (pi_es_pago_diferido, c_falso),
                        pi_procedencia_articulo        => v_procedencia_equipo,
                        pi_id_financiamiento           => pi_id_financiamiento,
                        pi_cod_tipo_cambio             => pi_cod_tipo_cambio_equipo,
                        pi_descripcion_falla           => pi_descripcion_falla,
                        pi_cod_usuario                 => pi_cod_usuario,
                        pi_id_tran                     => v_id_tran,
                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                        pi_fch_tran                    => v_fch_tran,
                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                        po_id_prospecto                => v_id_prospecto,
                        po_cod_err                     => po_cod_err,
                        po_msj_err                     => po_msj_err
                       );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF pi_tipo_cambio = c_tipo_cambio_sim THEN
            v_cod_tipo_venta    := 'TV_CAMBIO_SIM';
        ELSE
            v_cod_tipo_venta    := 'TV_CAMBIO_EQUIPO';
        END IF;

        v_tipo_doc_venta_equipo    := c_tipo_doc_venta_equipo;
        po_id_prospecto_art        := v_id_prospecto;
        po_cod_err := 'PVT-2429';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al registrar la entidad de venta relacionada.
        cc_vta_venta_entidad.alta (pio_id_prospecto               => v_id_prospecto,
                                   pi_cod_tipo_venta              => v_cod_tipo_venta,
                                   pi_id_entidad_venta            => pi_id_entidad_venta,
                                   pi_cod_usuario_asignado        => pi_cod_usuario_asignado,
                                   pi_cod_usuario_digitador       => pi_cod_usuario,
                                   pi_fch_venta                   => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_id_venta_entidad            => v_id_venta_entidad,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        IF pi_id_prospecto_tec IS NULL THEN
            po_cod_err := 'PVT-2430';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al obtener un id_venta

            SELECT sq_vta_venta_pros.NEXTVAL
              INTO v_id_venta
              FROM DUAL;

            v_id_prospecto_main    := v_id_prospecto;
            v_id_venta_main        := v_id_venta;
        ELSE
            v_id_prospecto_main    := pi_id_prospecto_tec;
            v_id_venta_main        := pi_id_venta_tec;
        END IF;

        po_cod_err := 'PVT-2431';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al registrar el detalle de la venta.
        tx_pvt_ccs.alta_venta_detalle (pio_id_venta                   => v_id_venta_main,
                                       pi_id_prospecto                => v_id_prospecto_main,
                                       pi_id_cargo                    => v_id_cargo_articulo,
                                       pi_cod_tipo_documento          => v_tipo_doc_venta_equipo,
                                       pi_valor_venta                 => v_precio_venta,
                                       pi_id_prospecto_art            => v_id_prospecto,
                                       pi_cod_tipo                    => 'A',
                                       pi_estado                      => c_estado_activo,
                                       pi_cod_usuario                 => pi_cod_usuario,
                                       pi_master                      => c_falso,
                                       pi_id_tran                     => v_id_tran,
                                       pi_cod_gestion_tran            => v_cod_gestion_tran,
                                       pi_fch_tran                    => v_fch_tran,
                                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                       po_valor                       => v_precio_venta_con_imp,
                                       po_id_prospecto_detalle        => v_id_prospecto_detalle,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF pi_id_prospecto_tec IS NULL THEN
            --CREACION DEL PROSPECTO DE VENTA DEL ARTICULO ---------------------------------------------------
            BEGIN
                po_cod_err := 'PVT-2432';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al recuperar el RNC y nombre a facturar.

                SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                       p.nit
                  INTO v_nombre_factura,
                       v_rnc_factura
                  FROM cl_persona p, cl_datos_facturacion df
                 WHERE df.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                   AND df.id_persona = p.id_persona
                   AND df.estado <> c_estado_inactivo
                   AND df.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                           p.nit
                      INTO v_nombre_factura,
                           v_rnc_factura
                      FROM cl_persona p, cl_cliente c
                     WHERE c.id_cliente = v_id_cliente AND p.id_persona = c.id_persona;
            END;

            po_cod_err := 'PVT-2433';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al invocar al procedimiento TX_BL_DOSIFICACION.GET_COD_CATEGORIA_DOCUMENTO.
            tx_bl_dosificacion.get_cod_categoria_documento
                                  (pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   po_cod_categoria_documento     => v_cod_categoria_documento,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err);

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2434';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al registrar el prospecto de venta del articulo.
            tx_pvt_ccs.alta_venta (pi_id_prospecto                => v_id_prospecto,
                                   pi_nombre_factura              => v_nombre_factura,
                                   pi_nit                         => v_rnc_factura,
                                   pi_cod_categoria_documento     => v_cod_categoria_documento,
                                   pi_estado                      => c_estado_activo,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_master                      => c_falso,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_valor                       => v_precio_venta_con_imp,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        --ADICION DE IMPUESTOS AL DESCUENTO
        IF v_monto_descuento <> 0 THEN
            po_cod_err := 'PVT-2435';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al registrar impuestos por descuento
            cc_vta_venta_prospecto.registra_impuestos
                                                 (pi_id_prospecto                => v_id_prospecto,
                                                  pi_aplicado_a                  => 'TIDESC',
                                                  pi_id_prospecto_ec             => NULL,
                                                  pi_cod_tipo_documento          => v_tipo_doc_venta_equipo,
                                                  pi_monto                       => v_monto_descuento,
                                                  pi_id_cargo                    => v_id_cargo_articulo,
                                                  pi_cod_usuario                 => pi_cod_usuario,
                                                  pi_id_tran                     => v_id_tran,
                                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                  pi_fch_tran                    => v_fch_tran,
                                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                  po_cod_err                     => po_cod_err,
                                                  po_msj_err                     => po_msj_err
                                                 );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --ADICION DE IMPUESTOS A LOS PUNTOS
        IF v_monto_puntos <> 0 THEN
            po_cod_err := 'PVT-2436';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al registrar impuestos por puntos
            cc_vta_venta_prospecto.registra_impuestos
                                                 (pi_id_prospecto                => v_id_prospecto,
                                                  pi_aplicado_a                  => 'TIPTO',
                                                  pi_id_prospecto_ec             => NULL,
                                                  pi_cod_tipo_documento          => v_tipo_doc_venta_equipo,
                                                  pi_monto                       => v_monto_puntos,
                                                  pi_id_cargo                    => v_id_cargo_articulo,
                                                  pi_cod_usuario                 => pi_cod_usuario,
                                                  pi_id_tran                     => v_id_tran,
                                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                  pi_fch_tran                    => v_fch_tran,
                                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                  po_cod_err                     => po_cod_err,
                                                  po_msj_err                     => po_msj_err
                                                 );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- Verificacion de Subsidios
        -- No permitir cambios de equipo sin subsidio para motivos que anulan anteriores subsidios
        IF     pi_cod_motivo_cambio IN ('CSE003',   --POR RENOVACION DE CONTRATO
                                                 'CSE011',  --POR EXCEPCION
                                                          'CSE007',   --POR CANJE DE VIDAS
                                                                   'CSE008', --PROGRAMA SUBSIDIO
                                                                            'CSE010') --PROGRAMA SUBSIDIO PUNTUAL
           AND tx_subsidio.getsubsidioprospecto (v_id_prospecto) <= 0 AND v_cod_motivo_descuento <> 'FINBA' THEN
            po_cod_err := 'PVT-2437';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: El prospecto renueva contrato pero no tiene subsidio
            RAISE err_app;
        END IF;

        IF     pi_id_prospecto_tec IS NULL
           AND (   v_precio_venta_con_imp = 0
                OR NVL (pi_es_pago_diferido, c_falso) = c_verdadero
                OR v_procedencia_equipo NOT IN (c_proced_empresa, c_proced_empresa_dealer)
               ) THEN
            IF tx_cl_contrato_activacion.documentos_requeridos (po_id_prospecto_art) = 0 THEN
                po_cod_err := 'PVT-2438';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al invocar al proc. de consolidacion de venta de equipo con monto 0.


                tx_int_cliente_caja.consolidar_venta_prospecto
                                                   (pi_id_venta                    => v_id_venta,
                                                    pi_ncf                         => NULL,
                                                    pi_nro_pag_ext                 => NULL,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_master                      => c_falso,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    po_id_tran                     => po_id_tran,
                                                    po_cod_gestion_tran            => po_cod_gestion_tran,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;

            -- RQX 4323 - Apertura Cobertura Fijo GSM - INICIO
            -- Cambio de equipo (Excluye cambio de equipo en cambio de tecnologia)
            IF (   pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_doa
                OR pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_exchange
               ) THEN
                IF     (es_fija (v_reg_entidad_consumo.cod_plan) = '1' AND pi_tipo_cambio = 'TCEGSM'
                       )
                   AND pi_id_prospecto_tec IS NULL THEN
                    /*SELECT aec.nro_serie
                      INTO v_serie_eq
                      FROM cl_articulo_entidad_consumo aec
                     WHERE aec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                       AND aec.cod_rubro_articulo IN ('TAGSM')
                       AND aec.estado = c_estado_activo
                       AND aec.fch_fin = c_fecha_fin;*/
                    SELECT ih.imsi
                      INTO v_imsi_sim
                      FROM tr_imsi_historico ih
                     WHERE ih.id_entidad_consumo = pi_id_entidad_consumo
                           AND ih.fch_fin = c_fecha_fin;

                    po_cod_err := 'PVT-2439';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al enviar la orden al EIR.
                    tx_eir_orden.alta (pi_cod_accion                  => 'ADD_PL',
                                       pi_imei                        => pi_nro_serie,   --imsi
                                       pi_imsi                        => v_imsi_sim,   --sim
                                       pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                       pi_operadora                   => '400',
                                       pi_id_tran                     => v_id_tran,
                                       pi_fch_tran                    => v_fch_tran,
                                       pi_cod_gestion_tran            => v_cod_gestion_tran,
                                       pi_cod_usuario                 => pi_cod_usuario,
                                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                       pi_master                      => c_falso,
                                       po_id_orden                    => v_id_orden,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
            END IF;
        -- RQX 4323 - Apertura Cobertura Fijo GSM - FIN
        END IF;

        IF pi_cod_tipo_cambio_equipo = c_tipo_cambio_equipo_normal AND pi_descuento > 0 THEN
            po_cod_err := 'PVT-2440';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al dar de baja la excepcion de cambio de equipo.
            IF pi_id_prospecto_tec IS NOT NULL THEN
                v_tipo_excepcion    :=  c_tipo_excepcion_cambio_tec;
            ELSE
                v_tipo_excepcion    :=  c_tipo_excepcion_cambio_equipo;
            END IF;
            cc_vta_excepcion.baja (pi_cod_tipo_excepcion          => v_tipo_excepcion,
                                   pi_id_comunidad                => NULL,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_nro_documento               => NULL,
                                   pi_cod_tipo_doc                => NULL,
                                   pi_monto_deposito              => pi_descuento,
                                   pi_id_prospecto                => po_id_prospecto_art,
                                   pi_cod_articulo                => pi_cod_articulo,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_master                      => c_falso,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;




        IF     pi_cod_tipo_cambio_equipo IN (c_tipo_cambio_equipo_puntos,
                                             c_tipo_cambio_equipo_normal
                                            )
           AND pi_tipo_cambio IN (c_tipo_cambio_equipo_cdma, c_tipo_cambio_equipo_gsm)
           AND pi_codigo_validacion IS NOT NULL THEN
            po_cod_err := 'PVT-2441';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al invocar al procedimiento TX_VTA_CODIGO_TRANSACCION.VERIFICAR.

            IF v_es_prospecto_rtb > 0 THEN
                v_tipo_tran := c_tipo_transaccion_rtb;
            ELSE
                v_tipo_tran := c_tipo_transaccion;
            END IF;

            tx_vta_codigo_transaccion.verificar (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                 pi_cod_transaccion             => v_tipo_tran,
                                                 pi_id_entidad_venta            => pi_id_entidad_venta,
                                                 pi_codigo                      => pi_codigo_validacion,
                                                 pi_id_prospecto                => po_id_prospecto_art,
                                                 pi_cod_usuario                 => pi_cod_usuario,
                                                 pi_master                      => c_falso,
                                                 pi_id_tran                     => v_id_tran,
                                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                 pi_fch_tran                    => v_fch_tran,
                                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                 po_cod_err                     => po_cod_err,
                                                 po_msj_err                     => po_msj_err
                                                );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                 := 'OK';
        po_msj_err                 := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE cambio_equipo_consolidacion (
        -- Input parameters
        pi_id_prospecto           IN       vta_articulo_prospecto.id_prospecto%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                    := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_EQUIPO');
        c_glosa_canje_x_equipo CONSTANT cnf_constante.valor%TYPE
                                         := tx_cnf_constante.get_constante ('GLOSA_CANJE_X_EQUIPO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.CAMBIO_EQUIPO_CONSOLIDACION';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ARTICULO_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_registro_articulo        cl_articulo_entidad_consumo.id_registro%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_reg_articulo_prospecto      vta_articulo_prospecto%ROWTYPE;
        v_reg_art_entidad_consumo     cl_articulo_entidad_consumo%ROWTYPE;
        v_desc_moneda                 VARCHAR2 (100);
        v_desc_procedencia            VARCHAR2 (100);
        v_desc_categoria              VARCHAR2 (100);
        v_desc_rubro_articulo         VARCHAR2 (100);
        v_desc_articulo               VARCHAR2 (100);
        c_serv_evdo                   NUMBER (3);
        vserial_hex                   VARCHAR2 (36) := NULL;
        v_sim                         cl_entidad_consumo.sim%TYPE;
        v_imsi                        cl_entidad_consumo.imsi%TYPE;
        v_ki                          cl_serial_sim.ki%TYPE;
        v_transport_key               cl_serial_sim.transport_key%TYPE;
        v_nro_serie_prv               cl_entidad_consumo.imsi%TYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_registro_cargo_adic      bl_cargo_adicional.id_registro%TYPE;
        v_cod_almacen                 inv_almacen.cod_almacen%TYPE;
        v_id_canje_punto              pto_canjepunto.id_canjepunto%TYPE;
        v_id_contrato                 cl_contrato_entidad_consumo.id_contrato%TYPE;
        v_cod_forma_consumo_vigente   tr_cambio_plan_historico.cod_forma_consumo%TYPE;
        v_meses_vigencia_finan        inv_cnf_financiamiento.meses_vigencia%TYPE;
        v_cod_periodo_facturacion_fin tr_periodo_facturacion.cod_periodo%TYPE;
        v_cod_periodo_facturacion     tr_periodo_facturacion.cod_periodo%TYPE;
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_procedencia                 vta_articulo_prospecto.procedencia_articulo%TYPE;
        v_id_entidad_venta            inv_entidad_venta.id_entidad_venta%TYPE;
        v_tipo_transaccion            inv_articulo_movimiento.cod_tipo_transaccion%TYPE;
        v_passwd_evdo                 cl_entidad_consumo.imsi%TYPE;
        v_tipo_numero                 cl_numero_telefonico.estado%TYPE;
        v_min                         cl_numero_telefonico.numero_telefonico%TYPE;
        v_id_canje_vidas              vda_canje_vidas.id_canje_vidas%TYPE;
        v_ec_bb                       cl_entidad_consumo_bb%ROWTYPE;
        v_dummy                       NUMBER := 0;
        po_id_orden                   ord_simpleprv.id_orden%TYPE;
        v_es_equipo_bb                PLS_INTEGER;
        v_tiene_bb                    PLS_INTEGER;
        v_id_contacto                 ret_contactos.id_contacto%TYPE;
        v_imei                        cl_articulo_entidad_consumo.nro_serie%TYPE;
        v_id_orden                    eir_orden.id_orden%TYPE;
        v_id_sms                      sms_despachador.id_sms%TYPE;
        v_boletos                     NUMBER;
        v_saldo_vidas                 NUMBER;
        v_vidas_x_boletos             NUMBER;
        v_vidas_expirar               NUMBER;
        v_texto_promocion             VARCHAR2 (50);
        v_id_promocion                prm_promo.id_promocion%TYPE;
        v_div_boletos                 NUMBER;
        v_dual_sim                    PLS_INTEGER;
        v_cod_origen_subsidio         cl_subsidio_ec.cod_origen%TYPE;
        v_subsidio_monto              cl_subsidio_ec.monto%TYPE;
        v_reg_plan                    bm_plan%ROWTYPE;
        v_texto                       VARCHAR2(200);
        v_id_lote                     inv_articulo_maestro.id_lote%TYPE;
        v_tiene_prospecto_rtb         PLS_INTEGER;
        v_reg_prospecto_rtb           ret_prospecto%ROWTYPE;
        v_fch_inicio_subsidio         cl_subsidio_ec.fch_ini_vigencia%TYPE;
        v_total_rentas                NUMBER;
        v_cod_tipo_clasificacion      cl_entidad_clasif.cod_tipo_clasificacion%TYPE;
        v_exonerar_penalidad          VARCHAR2(1);
        v_articulo_promo_cam_tec      VARCHAR2(20) := tx_cnf_constante.get_constante ('COD_ARTICULO_CAMBIO_TECNOLOGIA');
        v_promo_cambio_tecnologia     VARCHAR2(20) := tx_cnf_constante.get_constante ('RX_PROMO_CAMBIO_TECNOLOGIA');
        v_id_cnf_promo_cambio_tec     VARCHAR2(20) := tx_cnf_constante.get_constante ('ID_CNF_PROMO_CAMBIO_TECNOLOGIA');
        v_aplica_articulo             PLS_INTEGER;
        v_aplica_tienda               PLS_INTEGER;
        v_aplica_promo                VARCHAR2(2):=c_falso;
        v_id_subsidio                 cl_subsidio_ec.id_subsidio%TYPE;
        v_es_dealer                   VARCHAR2(1);
        v_descripcion                 VARCHAR2(50);
        v_descripcion_equipo          VARCHAR2(50);
        v_existe_prospecto_tec        NUMBER:=0;
        v_articulo_promo              VARCHAR2(40) := tx_cnf_constante.get_constante ('COD_ARTICULO_PROMO');
        v_dar_baja_articulo           VARCHAR2(20) := c_verdadero;
        v_id_registro_pend            NUMBER;
        v_id_comando                  vpg_orden.id_comando%TYPE;
        po_fch_tran                   vpg_orden.fch_tran%TYPE;
        v_cod_enlace                  varchar2(25);
        v_es_usim                     NUMBER;
        v_vigencia_contrato           NUMBER;
        -- Excepciones
        err_app                       EXCEPTION;
        v_reg_vta_financiamiento      vta_financiamiento%ROWTYPE;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_prospecto:'
            || pi_id_prospecto
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_prospecto IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2442';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2443';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2444';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        po_cod_err := 'PVT-2445';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar el prospecto del articulo.

        SELECT *
          INTO v_reg_articulo_prospecto
          FROM vta_articulo_prospecto p
         WHERE p.id_prospecto = pi_id_prospecto AND p.estado = c_estado_activo;
        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (v_reg_articulo_prospecto.id_entidad_consumo, v_reg_entidad_consumo,
                                 po_cod_err, po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --VERIFICAR FINANCIAMIENTO EQUIPO
        BEGIN
            po_cod_err := 'PVT-6003';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al verificar si es un financiamiento de equipo
            SELECT *
                INTO v_reg_vta_financiamiento
            FROM vta_financiamiento f
            WHERE f.id_prospecto = pi_id_prospecto
            AND f.origen = 'CAMBIO_EQUIPO'
            AND f.estado <> 'I';
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_reg_vta_financiamiento.id_solicitud := NULL;
        END;

        --OBTENER LINEA DE NEGOCIO
     SELECT c.cod_linea_negocio
            INTO v_cod_linea_negocio
            FROM cl_comunidad c
           WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        --VERIFICAR TIENE PROSPECTO DE RTB
        SELECT COUNT(1)
            INTO v_tiene_prospecto_rtb
        FROM ret_prospecto
        WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
         AND estado IN ('ACC','ESC')
         AND cod_accion IN ('ARET01','ARET02','ARET05','ARET06','ARET21','ARET29','ARET04');

        po_cod_err := 'PVT-2446';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al obtener el id del cliente.
        v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        po_cod_err := 'PVT-2447';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al determinar el tipo de numero.
        v_tipo_numero          := get_tipo_numero (v_reg_entidad_consumo.identificador_entidad);

        --Si el numero es portado y es CDMA al hacer cambio de numero a un numero de viva se libera el MIN inicial
        IF     v_tipo_numero = c_tipo_numero_portin
           AND v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            po_cod_err := 'PVT-2448';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al determinar el MIN del suscriptor.
            v_min         := get_min_suscriptor (v_reg_entidad_consumo.id_entidad_consumo);
        ELSIF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            v_min    := v_reg_entidad_consumo.identificador_entidad;
        END IF;

        IF     v_reg_articulo_prospecto.cod_tipo_cambio IS NOT NULL
           AND v_reg_articulo_prospecto.cod_tipo_cambio = c_tipo_cambio_equipo_exchange THEN

           IF (tx_inv_precio_articulo.aplica_cambio_equipo_generico(v_reg_articulo_prospecto.id_entidad_consumo,v_reg_articulo_prospecto.cod_motivo_cambio)) = c_falso THEN
               po_cod_err := 'PVT-2449';   --TX_PVT_ENTIDAL_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Cliente no aplica a cambio de equipo por falla de equipo
               RAISE err_app;
           END IF;

           IF tx_pvt_util.tiene_excepcion_cambio_equipo(v_reg_articulo_prospecto.id_entidad_consumo) = c_verdadero THEN
                po_cod_err := 'PVT-2450';   --TX_PVT_ENTIDAL_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al dar baja a la excepcion.
                tx_pvt_util.baja_excepcion(pi_id_entidad_consumo    => v_reg_articulo_prospecto.id_entidad_consumo,
                                           pi_cod_tipo_excepcion    => c_tipo_cambio_equipo_exchange,
                                           pi_cod_usuario           => pi_cod_usuario,
                                           pi_cod_gestion_tran      => v_cod_gestion_tran,
                                           pi_id_tran               => v_id_tran,
                                           pi_fch_tran              => v_fch_tran
                                           );
           END IF;

        END IF;

        --todos los equipos blackberry deben tener el servicio blackberry
        SELECT COUNT (1)
          INTO v_es_equipo_bb
          FROM vta_articulo_prospecto vap
         WHERE vap.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
           AND vap.cod_rubro_articulo IN ('TAGSM', 'TACDMA')
           AND vap.estado = c_estado_activo
           AND EXISTS (SELECT 1
                         FROM cnf_catalogo
                        WHERE cod_entidad = 'EQUIPOS_BLACKBERRY'
                          AND estado = c_estado_activo
                          AND cod_catalogo = vap.cod_articulo);

        SELECT COUNT (1)
          INTO v_tiene_bb
          FROM cl_servicio_entidad_consumo sec
         WHERE sec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
           AND sec.estado = c_estado_activo
           AND sec.fch_fin = c_fecha_fin
           AND EXISTS (SELECT 1
                         FROM bm_servicio
                        WHERE cod_tipo_servicio = 'BBDAT'
                          AND estado = c_estado_activo
                          AND cod_servicio = sec.cod_servicio);

        IF     v_es_equipo_bb > 0
           AND v_tiene_bb = 0
           AND v_reg_articulo_prospecto.procedencia_articulo = c_proced_empresa
           AND v_reg_articulo_prospecto.id_prospecto_cambio_tec IS NULL THEN
            po_cod_err := 'PVT-2451';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: debe asignar el servicio BlackBerry a este equipo.
          --  RAISE err_app;
        END IF;
        --CAMBIO DE ESN DE LA ENTIDAD DE CONSUMO
        IF v_reg_articulo_prospecto.cod_rubro_articulo IN ('TACDMA', 'TASIM') THEN
            IF v_reg_articulo_prospecto.cod_rubro_articulo = 'TASIM' THEN
                po_cod_err := 'PVT-2452';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al obtener los datos del SIM.
                v_imsi        := tx_pvt_ccs.get_imsi (v_reg_articulo_prospecto.nro_serie);
                v_sim         := v_reg_articulo_prospecto.nro_serie;
            ELSE
                v_imsi    := v_reg_articulo_prospecto.nro_serie;
                v_sim     := NULL;
            END IF;

            po_cod_err := 'PVT-2453';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al modificar los datos del suscriptor.
            cc_cl_entidad_consumo.modificacion
                (pi_id_entidad_consumo          => v_reg_articulo_prospecto.id_entidad_consumo,
                 pi_descripcion                 => v_reg_entidad_consumo.descripcion,
                 pi_identificador_entidad       => v_reg_entidad_consumo.identificador_entidad,
                 pi_puk                         => NULL,
                 pi_imsi                        => v_imsi,
                 pi_sim                         => v_sim,
                 pi_cod_plan                    => v_reg_entidad_consumo.cod_plan,
                 pi_tiempo_obligatorio_contrato => v_reg_entidad_consumo.tiempo_obligatorio_contrato,
                 pi_id_comunidad_facturante     => v_reg_entidad_consumo.id_comunidad_facturante,
                 pi_cod_forma_consumo           => v_reg_entidad_consumo.cod_forma_consumo,
                 pi_id_persona                  => v_reg_entidad_consumo.id_persona,
                 pi_id_entidad_consumo_ref      => v_reg_entidad_consumo.id_entidad_consumo_referidor,
                 pi_id_entidad_consumo_vpn      => v_reg_entidad_consumo.id_entidad_consumo_vpn,
                 pi_id_cliente_fs               => v_reg_entidad_consumo.id_cliente_fs,
                 pi_id_suscriptor_fs            => v_reg_entidad_consumo.id_suscriptor_fs,
                 pi_es_facturable               => v_reg_entidad_consumo.es_facturable,
                 pi_id_proc_ems                 => v_reg_entidad_consumo.id_proc_ems,
                 pi_id_orig_proc_ems            => v_reg_entidad_consumo.id_orig_proc_ems,
                 pi_id_form_ems                 => v_reg_entidad_consumo.id_form_ems,
                 pi_id_orig_form_ems            => v_reg_entidad_consumo.id_orig_form_ems,
                 pi_cod_usuario                 => pi_cod_usuario,
                 pi_id_tran                     => v_id_tran,
                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                 pi_fch_tran                    => v_fch_tran,
                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                 pi_fch_efectiva                => v_fch_tran,
                 po_cod_err                     => po_cod_err,
                 po_msj_err                     => po_msj_err
                );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        IF prm_aplica_promocion(SYSDATE,v_promo_cambio_tecnologia) = c_verdadero AND v_reg_articulo_prospecto.cod_articulo = v_articulo_promo_cam_tec  THEN

            SELECT COUNT(1)
              INTO v_dummy
              FROM prm_base pb
             WHERE pb.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND pb.id_cnf_promocion = v_id_cnf_promo_cambio_tec
               AND pb.estado = 'PEN';

             IF v_dummy = c_verdadero THEN
                UPDATE prm_base
                   SET estado = 'P',
                       fch_tran = v_fch_tran
                 WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                   AND id_cnf_promocion = v_id_cnf_promo_cambio_tec;
             END IF;

        END IF;

        BEGIN
            --DESASIGNAR EL ARTICULO ANTERIOR
            po_cod_err := 'PVT-2454';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar el articulo vigente.

            SELECT c.*
              INTO v_reg_art_entidad_consumo
              FROM cl_articulo_entidad_consumo c
             WHERE id_entidad_consumo = v_reg_articulo_prospecto.id_entidad_consumo
               AND cod_rubro_articulo = v_reg_articulo_prospecto.cod_rubro_articulo
               AND fch_fin = c_fecha_fin
               AND estado <> c_estado_inactivo;
            --SI ES CAMBIO TECNOLOGIA SE DESASIGNA LOS ARTICULOS EN LA TRANSACCION ANTERIOR
--        select COUNT(1)
--          into v_existe_prospecto_tec
--          from vta_articulo_prospecto
--         where id_prospecto = pi_id_prospecto
--           and id_prospecto_cambio_tec is not null;
-- LOG_MESSAGE(
--'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION - desasignar',
--'pi_id_prospecto:'||pi_id_prospecto||'::v_existe_prospecto_tec:'||v_existe_prospecto_tec
--);
--          IF v_existe_prospecto_tec = 0 THEN
            po_cod_err := 'PVT-2455';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al desasignar el articulo actual.
            cc_cl_articulo_entidad_consumo.desasignar
                              (pi_id_entidad_consumo          => v_reg_articulo_prospecto.id_entidad_consumo,
                               pi_id_registro                 => v_reg_art_entidad_consumo.id_registro,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_id_tran                     => v_id_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_fch_tran                    => v_fch_tran - INTERVAL '1' SECOND,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               pi_fch_efectiva                => v_fch_tran,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
--          END IF;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                    select COUNT(1)
                    into v_existe_prospecto_tec
                    from vta_articulo_prospecto
                    where id_prospecto = pi_id_prospecto
                    and id_prospecto_cambio_tec is not null;
--                     LOG_MESSAGE('TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION - desasignar NO_DATA_FOUND',
--                                 'pi_id_prospecto:'||pi_id_prospecto||'::v_existe_prospecto_tec:'||v_existe_prospecto_tec
--                                 ||'::v_reg_articulo_prospecto.id_entidad_consumo:'||v_reg_articulo_prospecto.id_entidad_consumo
--                                 );
                    IF v_existe_prospecto_tec = 1 THEN
                        IF v_reg_articulo_prospecto.cod_rubro_articulo = 'TAGSM' THEN
                          po_cod_err    := 'PVT-03141: '||v_reg_articulo_prospecto.id_entidad_consumo;

                        BEGIN
                            SELECT c.*
                              INTO v_reg_art_entidad_consumo
                              FROM cl_articulo_entidad_consumo c
                             WHERE id_entidad_consumo = v_reg_articulo_prospecto.id_entidad_consumo
                               AND cod_rubro_articulo = 'TACDMA'
                               AND fch_fin = c_fecha_fin
                               AND estado <> c_estado_inactivo;
                        EXCEPTION
                            WHEN OTHERS THEN
                                v_dar_baja_articulo := c_falso;
                        END;

                        IF v_dar_baja_articulo = c_verdadero THEN
                             po_cod_err := 'PVT-2456';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al desasignar el articulo actual.
                            cc_cl_articulo_entidad_consumo.desasignar
                                              (pi_id_entidad_consumo          => v_reg_articulo_prospecto.id_entidad_consumo,
                                               pi_id_registro                 => v_reg_art_entidad_consumo.id_registro,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran - INTERVAL '1' SECOND,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               pi_fch_efectiva                => v_fch_tran,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                            IF (po_cod_err <> 'OK') THEN
                                RAISE err_app;
                            END IF;
                          END IF;

                        ELSE
                          po_cod_err := 'PVT-2457';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al obtener el registro de la entidad de consumo.
                        SELECT c.*
                          INTO v_reg_art_entidad_consumo
                          FROM cl_articulo_entidad_consumo c
                         WHERE id_entidad_consumo = v_reg_articulo_prospecto.id_entidad_consumo
                           AND cod_rubro_articulo IN ('TAGSM','TACDMA')
                           AND fch_fin = c_fecha_fin
                           AND estado <> c_estado_inactivo;
                        END IF;
                    ELSE

                        v_reg_art_entidad_consumo.cod_articulo    := 'OTROS';
                        v_reg_art_entidad_consumo.nro_serie       := v_reg_entidad_consumo.imsi;
--                         LOG_MESSAGE(
--'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION - NO DATA FOUND ELSE',
--'v_reg_art_entidad_consumo.cod_articulo:'||v_reg_articulo_prospecto.cod_articulo||'::v_reg_art_entidad_consumo.nro_serie:'||v_reg_art_entidad_consumo.nro_serie
--||'::v_reg_articulo_prospecto.cod_rubro_articulo:'||v_reg_articulo_prospecto.cod_rubro_articulo
--);
                   END IF;
            END;

--        END IF;
        --ASIGNACION DEL ARTICULO AL SUSCRIPTOR
--     LOG_MESSAGE(
--'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION - asignar',
--'v_reg_art_entidad_consumo.cod_articulo:'||v_reg_articulo_prospecto.cod_articulo||'::v_reg_art_entidad_consumo.nro_serie:'||v_reg_art_entidad_consumo.nro_serie
--||'::v_reg_articulo_prospecto.cod_rubro_articulo:'||v_reg_articulo_prospecto.cod_rubro_articulo
--);
        po_cod_err := 'PVT-2458';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al asignar el nuevo articulo.
        cc_cl_articulo_entidad_consumo.asignar
                              (pi_id_entidad_consumo          => v_reg_articulo_prospecto.id_entidad_consumo,
                               pi_cod_rubro_articulo          => v_reg_articulo_prospecto.cod_rubro_articulo,
                               pi_cod_articulo                => v_reg_articulo_prospecto.cod_articulo,
                               pi_nro_serie                   => v_reg_articulo_prospecto.nro_serie,
                               pi_precio_venta                => v_reg_articulo_prospecto.precio_venta,
                               pi_cod_moneda                  => v_reg_articulo_prospecto.cod_moneda,
                               pi_precio_nominal              => v_reg_articulo_prospecto.precio_nominal,
                               pi_bonificacion                => v_reg_articulo_prospecto.bonificacion,
                               pi_descuento                   => v_reg_articulo_prospecto.descuento,
                               pi_cod_promocion               => NULL,
                               pi_cod_plan_venta              => NULL,
                               pi_id_proc_ems                 => 1,   --COEQ = 1
                               pi_id_orig_proc_ems            => NULL,   --c_falso, --NO CONCILIADO
                               pi_id_form_ems                 => NULL,
                               pi_id_orig_form_ems            => NULL,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_id_tran                     => v_id_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               pi_fch_efectiva                => v_fch_tran,
                               po_id_registro                 => v_id_registro_articulo,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        -- RQX 3288: Vinculacion SIM CARD y Equipo Fijo GSM
        -- Cambio de SIM (Excluye cambio de SIM en cambio de tecnologia)
        IF     (    (es_fija (v_reg_entidad_consumo.cod_plan) = '1' OR  v_cod_linea_negocio = 'INTERM')
                AND v_reg_articulo_prospecto.cod_rubro_articulo = 'TASIM'
               )
           AND v_reg_articulo_prospecto.id_prospecto_cambio_tec IS NULL THEN
            SELECT aec.nro_serie
              INTO v_imei
              FROM cl_articulo_entidad_consumo aec
             WHERE aec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND aec.cod_rubro_articulo IN ('TAGSM')
               AND aec.estado = c_estado_activo
               AND aec.fch_fin = c_fecha_fin;


            po_cod_err := 'PVT-2459';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al enviar la orden al EIR.
            tx_eir_orden.alta (pi_cod_accion                  => 'ADD_PL',
                               pi_imei                        => v_imei,
                               pi_imsi                        => v_imsi,
                               pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                               pi_operadora                   => '400',
                               pi_id_tran                     => v_id_tran,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               pi_master                      => c_falso,
                               po_id_orden                    => v_id_orden,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;





        -- Cambio de equipo (Excluye cambio de equipo en cambio de tecnologia)
        IF     ( (es_fija (v_reg_entidad_consumo.cod_plan) = '1' OR  v_cod_linea_negocio = 'INTERM')
                AND v_reg_articulo_prospecto.cod_rubro_articulo = 'TAGSM'
               )
           AND v_reg_articulo_prospecto.id_prospecto_cambio_tec IS NULL THEN
            SELECT ih.imsi
              INTO v_imsi
              FROM tr_imsi_historico ih
             WHERE ih.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND ih.fch_fin = c_fecha_fin;

            po_cod_err := 'PVT-2460';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al enviar la orden al EIR.
            tx_eir_orden.alta (pi_cod_accion                  => 'ADD_PL',
                               pi_imei                        => v_reg_articulo_prospecto.nro_serie,
                               pi_imsi                        => v_imsi,
                               pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                               pi_operadora                   => '400',
                               pi_id_tran                     => v_id_tran,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               pi_master                      => c_falso,
                               po_id_orden                    => v_id_orden,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- FIN RQX 3288*/
        po_cod_err := 'PVT-2461';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar la entidad de venta.

        SELECT ve.id_entidad_venta
          INTO v_id_entidad_venta
          FROM vta_venta_entidad ve
         WHERE ve.id_prospecto = v_reg_articulo_prospecto.id_prospecto
           AND ve.cod_tipo_venta IN ('TV_CAMBIO_SIM', 'TV_CAMBIO_EQUIPO');

        --REGISTRAR EL EGRESO DEL ARTICULO DE INVENTARIOS, SI ARTICULO NO ES DEL CLIENTE
        IF v_reg_articulo_prospecto.procedencia_articulo <> c_proced_cliente THEN
          --            v_es_dealer := tx_eqp_refurbished.es_dealer(v_id_entidad_venta);
--            IF v_reg_articulo_prospecto.cod_motivo_cambio = 'CSE014' AND v_es_dealer = '1' THEN
--              po_cod_err    := 'PVT-0491';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el almacen de salida del articulo.
--              SELECT am.es_equipo_empresa
--              INTO v_procedencia
--              FROM inv_articulo_maestro am
--             WHERE am.cod_articulo = v_reg_articulo_prospecto.cod_articulo
--               AND am.nro_serie = v_reg_articulo_prospecto.nro_serie;
--
--            po_cod_err    := 'PVT-0491';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el almacen de salida del articulo.
--            select cod_almacen
--              into v_cod_almacen
--              from inv_almacen
--             where id_entidad_venta = v_id_entidad_venta
--             and estado = 'A'
--             and fch_fin > sysdate;
--
--            ELSE
               po_cod_err := 'PVT-2462';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el almacen de salida del articulo.
              SELECT am.cod_almacen,
                   am.es_equipo_empresa
              INTO v_cod_almacen,
                   v_procedencia
              FROM inv_articulo_maestro am
             WHERE am.cod_articulo = v_reg_articulo_prospecto.cod_articulo
               AND am.nro_serie = v_reg_articulo_prospecto.nro_serie;

--            END IF;

            IF v_procedencia IN ('1','6','8') THEN
                v_tipo_transaccion    := c_tipo_transaccion_venta;
            ELSIF v_procedencia = '2' THEN
                v_tipo_transaccion    := c_tipo_transaccion_egr_st;
            ELSIF v_procedencia = '3' THEN
                v_tipo_transaccion    := 'TTEVDE';
            ELSIF v_procedencia = '7' THEN
                 v_tipo_transaccion := c_tipo_transaccion_egr_stc;
            END IF;
--  LOG_MESSAGE(
--'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION - movimiento_articulo',
--'v_tipo_transaccion:'||v_tipo_transaccion||'::v_cod_almacen:'||v_cod_almacen||'::v_id_entidad_venta:'||v_id_entidad_venta
--||'::v_reg_articulo_prospecto.cod_articulo:'||v_reg_articulo_prospecto.cod_articulo
--||'::v_reg_articulo_prospecto.nro_serie:'||v_reg_articulo_prospecto.nro_serie
--);
            po_cod_err := 'PVT-2463';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al invocar al procedimiento de salida de articulo de almacen.
            tx_int_cliente_caja.movimiento_articulo
                                          (pi_cod_tipo_transaccion        => v_tipo_transaccion,
                                           pi_cod_almacen                 => v_cod_almacen,
                                           pi_id_entidad_venta            => v_id_entidad_venta,
                                           pi_cod_articulo                => v_reg_articulo_prospecto.cod_articulo,
                                           pi_nro_serie                   => v_reg_articulo_prospecto.nro_serie,
                                           pi_cantidad                    => 1,
                                           pi_cod_categoria_origen        => NULL,
                                           pi_cod_categoria_destino       => NULL,
                                           pi_id_lote                     => NULL,
                                           pi_es_equipo_empresa           => v_procedencia,
                                           pi_id_documento_ext            => pi_id_prospecto,
                                           pi_cod_tipo_documento_ext      => NULL,
                                           pi_cod_usuario                 => pi_cod_usuario,
                                           pi_id_tran                     => v_id_tran,
                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                           pi_fch_tran                    => v_fch_tran,
                                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                           po_id_lote                     => v_id_lote,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        IF v_reg_articulo_prospecto.procedencia_articulo IN ( c_proced_empresa,
                                                              c_proced_empresa_dealer,
                                                              c_proced_dealer
                                                             )
        THEN
            v_cod_origen_subsidio    := NULL;

            IF v_reg_articulo_prospecto.cod_motivo_cambio IN ('CSE003', 'CSE011', 'CSE008','CSE010','CSE015') THEN

                IF v_reg_vta_financiamiento.id_solicitud IS NOT NULL THEN
                    v_vigencia_contrato :=  v_reg_vta_financiamiento.nro_cuotas;
                ELSE
                    v_vigencia_contrato :=  18;
                END IF;

                po_cod_err := 'PVT-2464';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al modificar el contrato del suscriptor

                cc_cl_contrato_entidad_consumo.alta
                             (pi_id_entidad_consumo          => v_reg_articulo_prospecto.id_entidad_consumo,
                              pi_id_prospecto                => pi_id_prospecto,
                              pi_cod_origen                  => 'CONCER',
                              pi_vigencia                    => v_vigencia_contrato,
                              pi_cod_usuario                 => pi_cod_usuario,
                              pi_id_tran                     => v_id_tran,
                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                              pi_fch_tran                    => v_fch_tran,
                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                              po_id_contrato                 => v_id_contrato,
                              po_cod_err                     => po_cod_err,
                              po_msj_err                     => po_msj_err
                             );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                v_cod_origen_subsidio    := 'CONCER';

                IF v_reg_articulo_prospecto.cod_motivo_cambio IN ('CSE008','CSE010') THEN
                    po_cod_err := 'PVT-2465';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al obtener el nombre del articulo
                    SELECT descripcion
                      INTO v_descripcion_equipo
                      FROM inv_articulo
                     WHERE cod_articulo = v_reg_articulo_prospecto.cod_articulo;

                    v_texto := 'Has adquirido un ('||v_descripcion_equipo||') pagando RD$'||ROUND((v_reg_articulo_prospecto.precio_venta * gettaxfactor('DRS')),2)
                               ||' con el Programa de Subsidio Renueva remplazando tus Vidas acumuladas.';

                    po_cod_err := 'PVT-2466';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al enviar el mensaje de notificacion.
                    tx_sms.alta
                        (pi_origen                      => 'VIDAS',
                         pi_destino                     => v_reg_entidad_consumo.identificador_entidad,
                         pi_texto                       => v_texto,
                         pi_programado                  => v_fch_tran + 1/24/6,
                         pi_prioridad                   => '1',
                         pi_id_tran                     => v_id_tran,
                         pi_fch_tran                    => v_fch_tran,
                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                         pi_cod_usuario                 => pi_cod_usuario,
                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                         pi_master                      => c_falso,
                         po_id_sms                      => v_id_sms,
                         po_cod_err                     => po_cod_err,
                         po_msj_err                     => po_msj_err
                        );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
                IF v_reg_articulo_prospecto.cod_motivo_cambio = 'CSE010' THEN
                    UPDATE inv_precio_subsid_especial sub
                       SET id_tran_fin = v_id_tran,
                           cod_gestion_tran_fin = v_cod_gestion_tran,
                           cod_usuario_fin = pi_cod_usuario,
                           estado = 'P'
                      WHERE identificador_entidad = v_reg_entidad_consumo.identificador_entidad
                        AND id_tran_fin IS NULL;
                END IF;
            ELSIF NVL (v_reg_articulo_prospecto.bonificacion, 0) > 0 THEN
                po_cod_err := 'PVT-2467';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al modificar el contrato del suscriptor
                cc_cl_contrato_entidad_consumo.alta
                             (pi_id_entidad_consumo          => v_reg_articulo_prospecto.id_entidad_consumo,
                              pi_id_prospecto                => pi_id_prospecto,
                              pi_cod_origen                  => 'CONCEP',
                              pi_vigencia                    => 18,
                              pi_cod_usuario                 => pi_cod_usuario,
                              pi_id_tran                     => v_id_tran,
                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                              pi_fch_tran                    => v_fch_tran,
                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                              po_id_contrato                 => v_id_contrato,
                              po_cod_err                     => po_cod_err,
                              po_msj_err                     => po_msj_err
                             );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                v_cod_origen_subsidio    := 'CONCEP';
            END IF;

            IF v_reg_articulo_prospecto.cod_motivo_cambio IN ('CSE015') AND v_reg_entidad_consumo.cod_forma_consumo IN ('CCOPRE')  THEN
                v_cod_origen_subsidio   :=  NULL;
            END IF;

            -- registro de nuevo subsidio por equipo
            IF v_cod_origen_subsidio IS NOT NULL
             AND v_reg_vta_financiamiento.id_solicitud IS NULL THEN
                po_cod_err := 'PVT-2468';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al registrar el subsidio del equipo
                v_subsidio_monto    := tx_subsidio.getsubsidioprospecto (pi_id_prospecto);

                SELECT *
                  INTO v_reg_plan
                  FROM bm_plan
                 WHERE cod_plan = v_reg_entidad_consumo.cod_plan;

                IF v_subsidio_monto <= 0 THEN
                    po_cod_err := 'PVT-2469';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: No se encontro subsidio
                    RAISE err_app;
                ELSIF    NVL (v_reg_plan.tarifa_basica, 0) > 0
                      OR NVL (v_reg_plan.tarifa_basica_sec, 0) > 0 THEN
                    -- planes sin tarifa no registran subsidio

                    -- BEGIN: RQX-5330 Penalidad y Renovacion de Contrato Hibridos y Fixed Hibridos.
                    v_exonerar_penalidad := c_verdadero; -- Por defecto.
                    IF v_reg_articulo_prospecto.cod_motivo_cambio IN ('CSE003','CSE011','CSE007','CSE008','CSE010')
                    AND es_hibrida(v_reg_entidad_consumo.id_comunidad_facturante) = c_verdadero THEN
                        BEGIN
                            SELECT MAX(fch_ini_vigencia)
                            INTO v_fch_inicio_subsidio
                            FROM cl_subsidio_ec s
                            WHERE s.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                            AND s.concepto IN (tx_subsidio.c_subs_eqpold, tx_subsidio.c_subs_eqp)
                            AND s.estado = c_estado_activo
                            AND s.fch_fin = c_fecha_fin;
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                v_fch_inicio_subsidio   := NULL;
                        END;

                        IF v_fch_inicio_subsidio IS NOT NULL THEN
                            v_total_rentas  := tx_subsidio.get_total_rentas(v_reg_entidad_consumo.id_entidad_consumo,v_fch_inicio_subsidio);
                            -- Tiene menor a 12 rentas pagadas.
                            IF v_total_rentas < 12 THEN
                                BEGIN
                                    SELECT cod_tipo_clasificacion
                                    INTO v_cod_tipo_clasificacion
                                    FROM cl_entidad_clasif
                                    WHERE cod_grupo_clasificacion = 'GCSGEC'
                                    AND cod_entidad = 'CL_ENTIDAD_CONSUMO'
                                    AND id_entidad = TO_CHAR(v_reg_entidad_consumo.id_entidad_consumo)
                                    AND fch_fin = c_fecha_fin
                                    AND estado = c_estado_activo;

                                    -- Si es segmento PLATA o BRONCE, no exonerar penalidad.
                                    IF v_cod_tipo_clasificacion IN ('C','D') THEN
                                        v_exonerar_penalidad := c_falso;
                                    END IF;
                                EXCEPTION
                                    WHEN NO_DATA_FOUND THEN
                                        v_exonerar_penalidad := c_falso;
                                END;
                            END IF;
                        END IF;
                    END IF;
                    -- END: RQX-5330.


                    IF v_reg_articulo_prospecto.cod_motivo_cambio IN ('CSE015') THEN --migracion masiva cdma
                        IF es_fija (v_reg_entidad_consumo.cod_plan) = c_verdadero THEN
                            v_exonerar_penalidad    :=  c_verdadero;
                        ELSE
                            v_exonerar_penalidad    := c_falso;
                        END IF;
                    END IF;

                    po_cod_err := 'PVT-2470';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al dar de alta nuevo subsidio
                    tx_subsidio.alta
                         (pi_id_entidad_consumo          => v_reg_articulo_prospecto.id_entidad_consumo,
                          pi_cod_tipo_documento          => 'PENDES',
                          pi_concepto                    => 'SBEQUP',
                          pi_vigencia                    => 18,
                          pi_monto                       => v_subsidio_monto,
                          pi_fch_ini_vigencia            => v_fch_tran,
                          pi_cod_origen                  => v_cod_origen_subsidio,
                          pi_id_prospecto                => pi_id_prospecto,
                          pi_id_prospecto_ec             => NULL,
                          pi_id_prospecto_art            => pi_id_prospecto,
                          pi_reemplazar                  => v_exonerar_penalidad,   -- dar de baja subsidios por equipo vigentes
                          pi_cod_usuario                 => pi_cod_usuario,
                          pi_master                      => c_falso,
                          pi_id_tran                     => v_id_tran,
                          pi_cod_gestion_tran            => v_cod_gestion_tran,
                          pi_fch_tran                    => v_fch_tran,
                          pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                          po_id_subsidio                 => v_id_subsidio,
                          po_cod_err                     => po_cod_err,
                          po_msj_err                     => po_msj_err
                         );

                    IF (po_cod_err <> 'OK') THEN
                        RAISE err_app;
                    END IF;
                END IF;
            END IF;
        END IF;

        --DEVOLUCION A INVENTARIOS
        IF v_reg_articulo_prospecto.es_devolucion = c_verdadero THEN
            --EN DEVOLUCION, CAMBIAR EL COD ARTICULO OTROS POR EL COD DEL ARTICULO QUE ESTA SALIENDO,
            --PUESTO QUE EL COD ARTICULO DE LOS SERIALES ACTIVOS NO FUE MIGRADO
            IF v_reg_art_entidad_consumo.cod_articulo LIKE 'VAR%' THEN
                po_cod_err := 'PVT-2471';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: El articulo a devolver no se tiene registrado como vendido.
                RAISE err_app;
            END IF;

            IF v_procedencia IN ('1','6','8') THEN
                v_tipo_transaccion    := c_tipo_transaccion_devolucion;
            ELSIF v_procedencia = '2' THEN
                v_tipo_transaccion    := c_tipo_transaccion_ing_st;
            ELSIF v_procedencia = '3' THEN
                v_tipo_transaccion    := 'TTIVDE';
            ELSIF v_procedencia = '7' THEN
                v_tipo_transaccion    :=  c_tipo_transaccion_ing_stc;
            END IF;
--                         LOG_MESSAGE(
--'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION - ES DEVOLUCION',
--'v_reg_art_entidad_consumo.cod_articulo:'||v_reg_articulo_prospecto.cod_articulo||'::v_reg_art_entidad_consumo.nro_serie:'||v_reg_art_entidad_consumo.nro_serie
--||'::v_reg_articulo_prospecto.cod_rubro_articulo:'||v_reg_articulo_prospecto.cod_rubro_articulo
--||'::v_reg_articulo_prospecto.cod_categoria:'||v_reg_articulo_prospecto.cod_categoria
--);
            po_cod_err := 'PVT-2472';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al invocar al procedimiento de reingreso a almacen.
            tx_int_cliente_caja.movimiento_articulo
                (pi_cod_tipo_transaccion        => v_tipo_transaccion,
                 pi_cod_almacen                 => v_cod_almacen,   --CID: solo funciona si en la devolucion no sale un equipo de inventarios
                 pi_id_entidad_venta            => v_id_entidad_venta,
                 pi_cod_articulo                => v_reg_art_entidad_consumo.cod_articulo,
                 pi_nro_serie                   => v_reg_art_entidad_consumo.nro_serie,
                 pi_cantidad                    => 1,
                 pi_cod_categoria_origen        => NULL,
                 pi_cod_categoria_destino       => v_reg_articulo_prospecto.cod_categoria,
                 pi_id_lote                     => NULL,
                 pi_es_equipo_empresa           => v_procedencia,
                 pi_id_documento_ext            => pi_id_prospecto,
                 pi_cod_tipo_documento_ext      => NULL,
                 pi_cod_usuario                 => pi_cod_usuario,
                 pi_id_tran                     => v_id_tran,
                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                 pi_fch_tran                    => v_fch_tran,
                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                 po_id_lote                     => v_id_lote,
                 po_cod_err                     => po_cod_err,
                 po_msj_err                     => po_msj_err
                );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            -- si fue un cambio de equipo DOA entrara al inventario con K_ND
            IF v_reg_articulo_prospecto.cod_tipo_cambio = 'TCEDOA' THEN
                po_cod_err := 'PVT-2473';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al invocar al procedimiento de cambio de estado.
                tx_inv_articulo_maestro.cambiar_estado
                                        (pi_cod_articulo                => v_reg_art_entidad_consumo.cod_articulo,
                                         pi_cod_almacen                 => v_cod_almacen,
                                         pi_nro_serie                   => v_reg_art_entidad_consumo.nro_serie,
                                         pi_estado_articulo             => 'K_ND',
                                         pi_cod_usuario                 => pi_cod_usuario,
                                         pi_id_tran                     => v_id_tran,
                                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                                         pi_fch_tran                    => v_fch_tran,
                                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                         po_cod_err                     => po_cod_err,
                                         po_msj_err                     => po_msj_err
                                        );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        --PROVISIONAR CAMBIO DE EQUIPO CDMA O SIM A DISPOSITIVOS, SOLO SI NO ES CAMBIO DE TECNOLOGIA
        IF     v_reg_articulo_prospecto.id_prospecto_cambio_tec IS NULL
           AND v_reg_articulo_prospecto.cod_rubro_articulo IN ('TACDMA', 'TASIM') THEN
            v_identificador_entidad    := v_reg_entidad_consumo.identificador_entidad;
            po_cod_err := 'PVT-2474';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el plan vigente.

            SELECT cph.cod_forma_consumo
              INTO v_cod_forma_consumo_vigente
              FROM tr_cambio_plan_historico cph
             WHERE cph.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND v_fch_tran BETWEEN cph.fch_inicio AND cph.fch_fin;

            po_cod_err := 'PVT-2475';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar la accion para el PRV a invocar.
            v_id_accion_prv_ext        := get_accion_prv (c_tipo_transaccion,
                                                          v_reg_entidad_consumo.cod_tecnologia,
                                                          v_cod_forma_consumo_vigente);

            -- SE ENVIA ACCION ESPECIAL PARA AQUELLOS QUE TIENEN EVDO
            IF v_reg_articulo_prospecto.cod_rubro_articulo = 'TACDMA' THEN
                SELECT COUNT (1)
                  INTO c_serv_evdo
                  FROM cl_servicio_entidad_consumo
                 WHERE id_entidad_consumo = v_reg_articulo_prospecto.id_entidad_consumo
                   AND cod_servicio = 'EVDO'
                   AND estado = c_estado_activo;

                IF c_serv_evdo >= 1 THEN
                    v_id_accion_prv_ext    := '196';
                    vserial_hex            :=
                                tx_cl_serial_robado.dec_to_hex (v_reg_articulo_prospecto.nro_serie);

                    BEGIN
                        SELECT n.passwd
                          INTO v_passwd_evdo
                          FROM evdo_nai_update n
                         WHERE n.esn = v_reg_articulo_prospecto.nro_serie AND n.estado = 'OK';
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            v_passwd_evdo    := v_reg_articulo_prospecto.nro_serie;
                    END;
                END IF;
            END IF;

            IF v_reg_articulo_prospecto.cod_rubro_articulo = 'TASIM' THEN
                po_cod_err := 'PVT-2476';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al obtener los datos del SIM.

                SELECT ss.ki,
                       ss.transport_key,
                       ss.imsi
                  INTO v_ki,
                       v_transport_key,
                       v_imsi
                  FROM cl_serial_sim ss
                 WHERE ss.icc LIKE v_reg_articulo_prospecto.nro_serie || '%';

                v_nro_serie_prv    := v_imsi;
            ELSE
                v_nro_serie_prv    := v_reg_articulo_prospecto.nro_serie;
            END IF;

            --VPG--
            SELECT COUNT(1)
                INTO v_es_usim
            FROM inv_articulo
            WHERE cod_articulo = v_reg_articulo_prospecto.cod_articulo
             AND es_usim = c_verdadero;

            IF v_es_usim = c_falso THEN
                v_cod_enlace    :=  'CAMBIO_SIM';
            ELSE
                v_cod_enlace    :=  'CAMBIO_USIM';
            END IF;

            po_cod_err := 'PVT-5021'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al invocar al obtener el id action.
            v_id_comando    :=  tx_vpg_util.get_comando(v_cod_enlace,v_reg_entidad_consumo.cod_forma_consumo,'ADD',v_reg_entidad_consumo.cod_tecnologia);

            po_cod_err := 'PVT-5022'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al invocar el generador orden vpg
            mt_vpg.alta_orden(
                    pi_id_comando               => v_id_comando,
                    pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_cod_transaccion          => c_tipo_transaccion,
                    pi_p1                       => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_p2                       => v_imsi,
                    pi_p3                       => v_ki,
                    pi_p4                       => v_reg_entidad_consumo.imsi,
                    pi_cod_usuario              => pi_cod_usuario,
                    pi_master                   => '0',
                    pi_id_tran                  => v_id_tran,
                    pi_cod_gestion_tran         => v_cod_gestion_tran,
                    pi_fch_tran                 => v_fch_tran,
                    pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                    po_id_orden                 => v_id_orden,
                    po_id_tran                  => po_id_tran,
                    po_fch_tran                 => po_fch_tran,
                    po_cod_err                  => po_cod_err,
                    po_msj_err                  => po_msj_err);

            IF (po_cod_err != 'OK') THEN
                RAISE err_app;
            END IF;

        END IF;

        --SI ES PAGO DIFERIDO SE DEBE GENERAR EL CARGO PARA LA SIGUIENTE FACTURA
        IF v_reg_articulo_prospecto.es_diferido = c_verdadero THEN
            IF v_reg_articulo_prospecto.id_financiamiento IS NULL THEN
                po_cod_err := 'PVT-2478';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al invocar al proc. para registrar el cargo por venta de equipo.
                tx_pvt_ccs.asignar_cargo
                                (pi_id_cliente                  => v_id_cliente,
                                 pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                 pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_cod_local                   => NULL,
                                 pi_cod_tipo_documento          => NULL,
                                 pi_id_cargo                    => c_cargo_compra_eq_diferido,
                                 pi_monto                       => v_reg_articulo_prospecto.precio_venta,
                                 pi_es_diferido                 => c_verdadero,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_id_documento                => v_id_registro_cargo_adic,
                                 po_id_tran                     => v_id_tran,
                                 po_cod_gestion_tran            => v_cod_gestion_tran,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;
            ELSE
                --NO SE PUEDEN CARGAR DEUDAS A CUENTAS PREPAGO
                IF v_reg_entidad_consumo.cod_forma_consumo = c_forma_consumo_prepago THEN
                    IF v_cod_linea_negocio = 'PREPAG' THEN
                        po_cod_err := 'PVT-2479';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: No se pueden realizar cargos diferidos a cuentas prepago.
                        RAISE err_app;
                    END IF;
                END IF;

                po_cod_err := 'PVT-2480';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el periodo de facturacion.

                SELECT meses_vigencia
                  INTO v_meses_vigencia_finan
                  FROM inv_cnf_financiamiento
                 WHERE id_financiamiento = v_reg_articulo_prospecto.id_financiamiento
                   AND fch_fin = c_fecha_fin;

                po_cod_err := 'PVT-2481';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar el periodo de facturacion.

                SELECT p.cod_periodo,
                       TO_CHAR (ADD_MONTHS (TO_DATE (p.cod_periodo, 'YYYYMM'),
                                            v_meses_vigencia_finan - 1),
                                'YYYYMM')
                  INTO v_cod_periodo_facturacion,
                       v_cod_periodo_facturacion_fin
                  FROM tr_periodo_facturacion p, cl_comunidad c
                 WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                   AND c.cod_ciclo_facturacion = p.cod_ciclo_facturacion
                   AND p.vigente = c_verdadero
                   AND p.estado <> c_estado_inactivo;

                po_cod_err := 'PVT-2482';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al invocar al proc. de registro del cargo del cargo.
                cc_bl_cargo_adicional.alta
                       (pi_cod_periodo_inicio          => v_cod_periodo_facturacion,
                        pi_cod_periodo_fin             => v_cod_periodo_facturacion_fin,
                        pi_id_cliente                  => v_id_cliente,
                        pi_id_comunidad_facturante     => v_reg_entidad_consumo.id_comunidad_facturante,
                        pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_id_cargo                    => c_cargo_compra_eq_diferido,
                        pi_valor                       =>   v_reg_articulo_prospecto.precio_venta
                                                          / v_meses_vigencia_finan,
                        pi_cod_usuario                 => pi_cod_usuario,
                        pi_id_tran                     => v_id_tran,
                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                        pi_fch_tran                    => v_fch_tran,
                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                        po_id_registro                 => v_id_registro_cargo_adic,
                        po_cod_err                     => po_cod_err,
                        po_msj_err                     => po_msj_err
                       );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        IF NVL (v_reg_articulo_prospecto.bonificacion, 0) > 0 THEN
            po_cod_err := 'PVT-2483';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al canjear los puntos utilizados.
            tx_vda_canje_vidas.alta (v_reg_entidad_consumo.id_entidad_consumo,
                                     v_reg_articulo_prospecto.cantidad_bonificacion,
                                     c_canje_equipo,
                                     pi_id_prospecto,
                                     NULL,
                                     NULL,
                                     v_fch_tran,
                                     v_id_tran,
                                     v_cod_gestion_tran,
                                     pi_cod_usuario,
                                     pi_cod_unidad_negocio,
                                     0,
                                     v_id_canje_vidas,
                                     po_cod_err,
                                     po_msj_err
                                    );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

        ELSIF     v_reg_articulo_prospecto.procedencia_articulo IN
                                                        (c_proced_empresa, c_proced_empresa_dealer, c_proced_dealer)
              AND v_reg_articulo_prospecto.cod_motivo_cambio IN ('CSE008','CSE010')
              AND get_linea_negocio (v_reg_entidad_consumo.cod_plan) IN ('POSCON', 'HIBRID','FULL') THEN

            po_cod_err := 'PVT-2484';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al invocar al procedimiento CC_VDA_CUENTA_CORRIENTE_VIDA.GET_SALDO.
            cc_vda_cuenta_corriente_vida.get_saldo
                            (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                             pi_fch_fin                     => NULL,
                             pi_cod_usuario                 => pi_cod_usuario,
                             po_saldo                       => v_saldo_vidas,
                             po_cod_err                     => po_cod_err,
                             po_msj_err                     => po_msj_err
                             );

            IF po_cod_err <> 'OK' THEN
                 RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2485';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al invocar al procedimiento TX_VDA_UTIL.EXPIRAR_TODAS_VIDAS.
            tx_vda_util.expirar_todas_vidas
                            (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                             pi_motivo                      => 'PROGRAMA_SUBSIDIO',
                             pi_fch_tran                    => v_fch_tran,
                             pi_id_tran                     => v_id_tran,
                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                             pi_cod_usuario                 => pi_cod_usuario,
                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                             pi_master                      => c_falso,
                             po_cod_err                     => po_cod_err,
                             po_msj_err                     => po_msj_err
                            );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        IF v_reg_articulo_prospecto.cod_motivo_cambio IN ('CSE008','CSE010','CSE007') AND v_reg_entidad_consumo.cod_tecnologia = 'GSM' THEN

           po_cod_err := 'PVT-2486';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error en el envio de sms en la promocion.
           SELECT descripcion
             INTO v_descripcion
             FROM cnf_motivo_transaccion
            WHERE cod_motivo = v_reg_articulo_prospecto.cod_motivo_cambio;

           po_cod_err := 'PVT-2487';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error en el envio de sms en la promocion.
           v_texto := 'Has adquirido un nuevo equipo con ('||v_descripcion||'). Nos interesa conocer tu opinion. Marca #818# y accede a nuestra encuesta, solo toma un minuto.';
           tx_sms.alta
               (pi_origen                      => 'VIDAS',
                pi_destino                     => v_reg_entidad_consumo.identificador_entidad,
                pi_texto                       => v_texto,
                pi_prioridad                   => '1',
                pi_programado                  => v_fch_tran + 1/24,
                pi_id_tran                     => v_id_tran,
                pi_fch_tran                    => v_fch_tran,
                pi_cod_gestion_tran            => v_cod_gestion_tran,
                pi_cod_usuario                 => pi_cod_usuario,
                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                pi_master                      => c_falso,
                po_id_sms                      => v_id_sms,
                po_cod_err                     => po_cod_err,
                po_msj_err                     => po_msj_err
                );

            IF po_cod_err <> 'OK' THEN
                 RAISE err_app;
            END IF;

        END IF;
        --CAMBIO DE ESTADO DEL PROSPECTO DE VENTA A PAGADO
        po_cod_err := 'PVT-2488';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al invocar al procedimiento CC_VTA_ARTICULO_PROSPECTO.CAMBIA_ESTADO.
        cc_vta_articulo_prospecto.cambia_estado (pi_id_prospecto                => pi_id_prospecto,
                                                 pi_estado                      => c_estado_pagado,
                                                 pi_cod_usuario                 => pi_cod_usuario,
                                                 pi_id_tran                     => v_id_tran,
                                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                 pi_fch_tran                    => v_fch_tran,
                                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                 po_cod_err                     => po_cod_err,
                                                 po_msj_err                     => po_msj_err
                                                );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2489';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar la descripcion del rubro.

        BEGIN
            SELECT descripcion
              INTO v_desc_rubro_articulo
              FROM cnf_catalogo c
             WHERE c.cod_catalogo = v_reg_articulo_prospecto.cod_rubro_articulo;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_desc_rubro_articulo    := NULL;
        END;

        po_cod_err := 'PVT-2490';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar la descripcion del articulo.

        BEGIN
            SELECT descripcion
              INTO v_desc_articulo
              FROM inv_articulo a
             WHERE a.cod_articulo = v_reg_articulo_prospecto.cod_articulo;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_desc_articulo    := NULL;
        END;

        po_cod_err := 'PVT-2491';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar la descripcion de la moneda.

        BEGIN
            SELECT descripcion
              INTO v_desc_moneda
              FROM cnf_moneda c
             WHERE c.cod_moneda = v_reg_articulo_prospecto.cod_moneda;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_desc_moneda    := NULL;
        END;

        po_cod_err := 'PVT-2492';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar la descripcion del rubro.

        BEGIN
            SELECT descripcion
              INTO v_desc_categoria
              FROM cnf_catalogo c
             WHERE c.cod_catalogo = v_reg_articulo_prospecto.cod_categoria;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_desc_categoria    := NULL;
        END;

        po_cod_err := 'PVT-2493';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar la descripcion del rubro.

        BEGIN
            SELECT descripcion
              INTO v_desc_procedencia
              FROM cnf_catalogo c
             WHERE c.cod_catalogo = v_reg_articulo_prospecto.procedencia_articulo;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_desc_procedencia    := NULL;
        END;

        -- Actualizacion de la vta_excepcion a estado P

        begin
          SELECT   COUNT (1)
            INTO   v_dummy
            FROM   vta_excepcion
           WHERE       id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                   AND cod_tipo_excepcion = 'TEXCEV'
                   AND estado = 'A';
          IF v_dummy>0 THEN
            UPDATE vta_excepcion
               SET estado = 'P'
             WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND cod_tipo_excepcion = 'TEXCEV'
               AND estado = 'A';
          END IF;
       exception
        when others then
          v_dummy:=0;
       end;

---------INICIO PHC BLACKBERRY CAMBIO DE CHIP ---------------------------------------------------------
        IF v_reg_articulo_prospecto.cod_rubro_articulo = 'TASIM' THEN
            BEGIN
                SELECT *
                  INTO v_ec_bb
                  FROM cl_entidad_consumo_bb ecbb
                 WHERE ecbb.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                   AND ecbb.estado_bb = 'A'
                   AND ecbb.estado <> c_estado_inactivo
                   AND ecbb.fch_fin = c_fecha_fin;

                v_dummy    := 1;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_dummy    := 0;
            END;

            IF v_dummy > 0 THEN
                -- Enviar orden de activacion a la PRV
                po_cod_err := 'PVT-2494';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al invocar TX_ORD_SIMPLEPRV.ALTA
                tx_ord_simpleprv.alta
                                (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_device                      => 'BB',
                                 pi_cod_action                  => 'CHGIMSI',
                                 pi_p0                          => v_imsi,   -- nuevo imsi
                                 pi_p1                          => v_reg_entidad_consumo.imsi,   -- ANTERIOR imsi
                                 pi_p2                          => v_identificador_entidad,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => '0',
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_id_orden                    => po_id_orden,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        BEGIN
            v_id_registro_pend     := mt_ret_util.tiene_prospecto_cambio_eq(v_reg_entidad_consumo.id_entidad_consumo);

            IF v_id_registro_pend IS NOT NULL THEN

                tx_ret_prospecto.cambiar_estado(pi_id_registro          => v_id_registro_pend,
                                                pi_estado               => 'COMP',
                                                pi_cod_usuario          => pi_cod_usuario,
                                                pi_master               => c_falso,
                                                pi_id_tran              => v_id_tran,
                                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                                pi_fch_tran             => v_fch_tran,
                                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                                po_cod_err              => po_cod_err,
                                                po_msj_err              => po_msj_err
                                              );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;

        EXCEPTION
            WHEN OTHERS THEN
                NULL;
        END;

---------FIN PHC BLACKBERRY CAMBIO DE CHIP ---------------------------------------------------------
        BEGIN
            SELECT id_contacto
              INTO v_id_contacto
              FROM (SELECT   c.id_contacto
                        FROM ret_contactos c
                       WHERE c.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                         AND c.estado = 'EP'
                    ORDER BY c.id_contacto DESC)
             WHERE ROWNUM = 1;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_id_contacto    := NULL;
            WHEN OTHERS THEN
                v_id_contacto    := NULL;
        END;

        IF v_id_contacto IS NOT NULL THEN
            tx_ret_contactos.procesado (pi_id_contacto                 => v_id_contacto,
                                        pi_id_tran                     => v_id_tran,
                                        pi_fch_tran                    => v_fch_tran,
                                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                                        pi_cod_usuario                 => pi_cod_usuario,
                                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                        pi_master                      => c_falso,
                                        po_cod_err                     => po_cod_err,
                                        po_msj_err                     => po_msj_err
                                       );
        END IF;

        po_cod_err := 'PVT-2495';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al formar la trama nueva.
        v_trama_nuevo_pv       :=    'Cod. tipo articulo:'
                                  || v_reg_articulo_prospecto.cod_rubro_articulo
                                  || '|'
                                  || 'Tipo de articulo:'
                                  || v_desc_rubro_articulo
                                  || '|'
                                  || 'Cod. articulo:'
                                  || v_reg_articulo_prospecto.cod_articulo
                                  || '|'
                                  || 'Articulo:'
                                  || v_desc_articulo
                                  || '|'
                                  || 'Imsi/esn/imei:'
                                  || v_reg_articulo_prospecto.nro_serie
                                  || '|'
                                  || 'Precio venta:'
                                  || v_reg_articulo_prospecto.precio_venta
                                  || '|'
                                  || 'Cod Moneda:'
                                  || v_reg_articulo_prospecto.cod_moneda
                                  || '|'
                                  || 'Moneda:'
                                  || v_desc_moneda
                                  || '|'
                                  || 'Precio nominal:'
                                  || v_reg_articulo_prospecto.precio_nominal
                                  || '|'
                                  || 'Puntos bonificacion:'
                                  || v_reg_articulo_prospecto.cantidad_bonificacion
                                  || '|'
                                  || 'Bonificacion:'
                                  || v_reg_articulo_prospecto.bonificacion
                                  || '|'
                                  || 'Es devolucion:'
                                  || v_reg_articulo_prospecto.es_devolucion
                                  || '|'
                                  || 'Cod. Categoria:'
                                  || v_reg_articulo_prospecto.cod_categoria
                                  || '|'
                                  || 'Categoria:'
                                  || v_desc_categoria
                                  || '|'
                                  || 'Es diferido:'
                                  || v_reg_articulo_prospecto.es_diferido
                                  || '|'
                                  || 'Cod. proced. articulo:'
                                  || v_reg_articulo_prospecto.procedencia_articulo
                                  || '|'
                                  || 'Procedencia Articulo:'
                                  || v_desc_procedencia;
        po_cod_err := 'PVT-2496';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar la descripcion del rubro.

        BEGIN
            SELECT descripcion
              INTO v_desc_rubro_articulo
              FROM cnf_catalogo c
             WHERE c.cod_catalogo = v_reg_art_entidad_consumo.cod_rubro_articulo;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_desc_rubro_articulo    := NULL;
        END;

        po_cod_err := 'PVT-2497';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar la descripcion del articulo.

        BEGIN
            SELECT descripcion
              INTO v_desc_articulo
              FROM inv_articulo a
             WHERE a.cod_articulo = v_reg_art_entidad_consumo.cod_articulo;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_desc_articulo    := NULL;
        END;

        po_cod_err := 'PVT-2498';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al recuperar la descripcion de la moneda.

        BEGIN
            SELECT descripcion
              INTO v_desc_moneda
              FROM cnf_moneda c
             WHERE c.cod_moneda = v_reg_art_entidad_consumo.cod_moneda;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_desc_moneda    := NULL;
        END;

        po_cod_err := 'PVT-2499';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al formar la trama anterior.
        v_trama_anterior_pv    :=    'Cod. tipo articulo:'
                                  || v_reg_art_entidad_consumo.cod_rubro_articulo
                                  || '|'
                                  || 'Tipo articulo:'
                                  || v_desc_rubro_articulo
                                  || '|'
                                  || 'Cod. articulo:'
                                  || v_reg_art_entidad_consumo.cod_articulo
                                  || '|'
                                  || 'Articulo:'
                                  || v_desc_articulo
                                  || '|'
                                  || 'Imsi/esn/imei:'
                                  || v_reg_art_entidad_consumo.nro_serie
                                  || '|'
                                  || 'Precio venta:'
                                  || v_reg_art_entidad_consumo.precio_venta
                                  || '|'
                                  || 'Cod Moneda:'
                                  || v_reg_art_entidad_consumo.cod_moneda
                                  || '|'
                                  || 'Moneda:'
                                  || v_desc_moneda
                                  || '|'
                                  || 'Precio nominal:'
                                  || v_reg_art_entidad_consumo.precio_nominal
                                  || '|'
                                  || 'Bonificacion:'
                                  || v_reg_art_entidad_consumo.bonificacion
                                  || '|'
                                  || 'Descuento:'
                                  || v_reg_art_entidad_consumo.descuento;
        --- Registrar transaccion
        po_cod_err := 'PVT-2500';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
        cc_tx_transaccion_postventa.alta
                           (pi_id_tran                     => v_id_tran,
                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                            pi_cod_tipo                    => c_tipo_transaccion,
                            pi_id_cliente                  => v_reg_articulo_prospecto.id_cliente,
                            pi_id_comunidad                => v_reg_articulo_prospecto.id_comunidad_facturante,
                            pi_id_entidad_consumo          => v_reg_articulo_prospecto.id_entidad_consumo,
                            pi_cod_motivo_transaccion      => v_reg_articulo_prospecto.cod_motivo_cambio,
                            pi_cod_observacion             => NULL,
                            pi_descripcion_observacion     => NULL,
                            pi_valor_anterior              => v_trama_anterior_pv,
                            pi_valor_nuevo                 => v_trama_nuevo_pv,
                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                            pi_fch_tran                    => v_fch_tran,
                            pi_cod_usuario                 => pi_cod_usuario,
                            po_cod_err                     => po_cod_err,
                            po_msj_err                     => po_msj_err
                           );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF v_reg_vta_financiamiento.id_solicitud IS NOT NULL THEN

            IF v_reg_vta_financiamiento.estado_solicitud = 'VAL' THEN
                po_cod_err := 'PVT-6004';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Hubo un problema al actualizar el estado del prestamo.
                tx_vta_financiamiento.actualizar_estado(
                    pi_id_prospecto         => pi_id_prospecto,
                    pi_estado_solicitud     => 'PBA',
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_verdadero,
                    pi_id_tran              => v_id_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,

                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            ELSE
                po_cod_err := 'PVT-6005';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: La solicitud de financiamiento debe estar validada.
                RAISE err_app;
            END IF;
        END IF;



        --FINALIZAR PROSPECTO RTB
        IF v_tiene_prospecto_rtb > 0 THEN

            po_cod_err := 'PVT-2501';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al obtener el registro del prospecto RTB.
            SELECT *
                INTO v_reg_prospecto_rtb
            FROM ret_prospecto
            WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
             AND estado IN ('ACC','ESC')
             AND cod_accion IN ('ARET01','ARET02','ARET05','ARET06','ARET21','ARET29','ARET04');

            po_cod_err := 'PVT-2502';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al finalizar el prospecto RTB.

            tx_ret_prospecto.modificar_prospecto(pi_id_registro                 => v_reg_prospecto_rtb.id_registro,
                                                 pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                                 pi_cod_sintoma                 => v_reg_prospecto_rtb.cod_sintoma,
                                                 pi_cod_accion                  => v_reg_prospecto_rtb.cod_accion,
                                                 pi_nota                        => 'Satisfactorio',
                                                 pi_estado                      => 'SAT',
                                                 pi_cod_nivel                   => v_reg_prospecto_rtb.cod_nivel,
                                                 pi_parametros                  => NULL,
                                                 pi_cod_usuario                 => pi_cod_usuario,
                                                 pi_master                      => c_falso,
                                                 pi_id_tran                     => v_id_tran,
                                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                 pi_fch_tran                    => v_fch_tran,
                                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                 po_cod_err                     => po_cod_err,
                                                 po_msj_err                     => po_msj_err
                                                 );
            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

        END IF;

        IF prm_aplica_promocion(sysdate,'5499') = '1' THEN
          begin
            po_cod_err := 'PVT-2503';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error el precio de venta del equipo para FIJA e EVDO no esta definido.
            update prm_base
               set estado = 'P'
            where id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
              and id_cnf_promocion = PRM_GET_ID_CNF_PROMOCION('5499')
              and estado = 'R';

          exception
            when others then
              NULL;
          end;
        END IF;

        IF prm_aplica_promocion(sysdate,'5688') = '1' THEN
          begin
            po_cod_err := 'PVT-2504';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Hubo un problema al actualizar los datos de la promocion.
            update prm_base
               set estado = 'P'
            where id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
              and id_cnf_promocion = PRM_GET_ID_CNF_PROMOCION('5688')
              and estado = 'R';

          exception
            when others then
              NULL;
          end;
        END IF;
        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE cambio_numero (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_identificador_entidad  IN       cl_entidad_consumo.identificador_entidad%TYPE,
        pi_intercepto             IN       PLS_INTEGER DEFAULT 0,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        --CURSOR DE TIPOS DE AFINIDADES DE UNA ENTIDAD DE CONSUMO
        CURSOR curtiposafinidad (
            pi_id_entidad_consumo     IN       cl_entidad_consumo_afin.id_entidad_consumo%TYPE
        )
        IS
            SELECT DISTINCT eca.id_entidad_consumo,
                            eca.cod_tipo_afinidad
                       FROM cl_entidad_consumo_afin eca
                      WHERE eca.id_entidad_consumo = pi_id_entidad_consumo
                        AND eca.estado <> c_estado_inactivo
                        AND eca.fch_fin = c_fecha_fin;

        --CURSOR DE AFINIDADES DE UNA ENTIDAD DE CONSUMO Y UN TIPO DE AFINIDAD
        CURSOR curnumerosafines (
            pi_id_entidad_consumo     IN       cl_entidad_consumo_afin.id_entidad_consumo%TYPE,
            pi_cod_tipo_afinidad      IN       cl_entidad_consumo_afin.cod_tipo_afinidad%TYPE
        )
        IS
            SELECT eca.id_entidad_consumo,
                   eca.identificador_entidad,
                   eca.id_entidad_consumo_afin,
                   eca.identificador_entidad_afin,
                   eca.cod_tipo_afinidad
              FROM cl_entidad_consumo_afin eca
             WHERE eca.id_entidad_consumo = pi_id_entidad_consumo
               AND eca.cod_tipo_afinidad = pi_cod_tipo_afinidad
               AND eca.estado <> c_estado_inactivo
               AND eca.fch_fin = c_fecha_fin;

        --CURSOR DE TIPOS DE AFINIDADES RELACIONADAS A UN NUMERO DE TELEFONO DADO
        CURSOR curtiposafinidadrel (
            pi_identificador_entidad_afin IN   cl_entidad_consumo_afin.identificador_entidad_afin%TYPE
        )
        IS
            SELECT DISTINCT eca.id_entidad_consumo,
                            eca.cod_tipo_afinidad
                       FROM cl_entidad_consumo_afin eca
                      WHERE eca.identificador_entidad_afin = pi_identificador_entidad_afin
                        AND eca.estado <> c_estado_inactivo
                        AND eca.fch_fin = c_fecha_fin;

        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                     := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_NUMERO');
        c_transaccion_zonif  CONSTANT VARCHAR2 (50)
                           := tx_cnf_constante.get_constante ('TRANSACCION_ASIGNAR_ZONA_FULL_HOGAR');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.CAMBIO_NUMERO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_permiso                     VARCHAR2 (20);
        v_cambio_numero_gratis        BOOLEAN := FALSE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_orden                    cl_orden_prv.id_orden%TYPE;
        v_cosname                     bm_plan.cosname%TYPE;
        v_customer_group              bm_plan.customer_group%TYPE;
        v_cod_servicio                bm_servicio.cod_servicio%TYPE;
        v_esn_hex                     cl_entidad_consumo.imsi%TYPE;
        v_cod_forma_consumo_vigente   tr_cambio_plan_historico.cod_forma_consumo%TYPE;
        v_tipo_bolsillo               PLS_INTEGER;
        v_lrn_intercepto              PLS_INTEGER := 0;
        -- dmm vars
        v_tmp_identificador_entidad   VARCHAR2 (20);
        v_tmp_result                  VARCHAR2 (20);
        v_nro_documento               cl_persona.nro_documento%TYPE;
        v_cod_tipo_documento          cl_persona.cod_tipo_documento%TYPE;
        v_id_contrato                 cl_suscripcion_servicio.id_contrato%TYPE;
        v_cod_tipo_documento_ars      VARCHAR2 (10);
        v_id_servicio_externo         NUMBER(15);

        TYPE array_bal IS TABLE OF VARCHAR2 (50);

        v_arr_bal                     array_bal
            := array_bal ('CORE BALANCE',
                          'FREE SECONDS BALANCE',
                          'PROMOTIONAL BALANCE 1',
                          'PROMOTIONAL BALANCE 2',
                          'SMS BALANCE',
                          'MMS BALANCE',
                          'KBYTES',
                          'DOWNLOADS'
                         );
        v_cont                        PLS_INTEGER := 0;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_id_registro_cargo_adic      bl_cargo_adicional.id_registro%TYPE;
        v_cod_periodo_facturacion     tr_periodo_facturacion.cod_periodo%TYPE;
        v_cod_grupo_plan              bm_grupo_plan.cod_grupo_plan%TYPE;
        v_estado_numero               cl_numero_telefonico.estado_numero%TYPE;
        v_numeros_afines              VARCHAR2 (2000);
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_reg_config_esp              cnf_configuracion_especial%ROWTYPE;
        v_core_balance                NUMBER (15, 2);
        v_datos_suscriptor            VARCHAR2 (1000);
        v_dummy                       PLS_INTEGER;
        v_costo_transaccion           NUMBER (10, 2);
        v_id_cargo                    NUMBER (10);
        pi_tipo_cobro                 NUMBER (1);   --0:NO SE COBRA; 1:DIFERIDO A LA FACTURA; 2:DESCONTAR DE BALANCE; 3: COBRAR EN CAJA
        v_nro_pps                     VARCHAR2 (30);
        v_fch_vigencia                DATE;
        v_tipo_numero                 cl_numero_telefonico.estado%TYPE;
        v_lrn                         por_cnf_lrn.lrn%TYPE;
        v_min                         cl_numero_telefonico.numero_telefonico%TYPE;
        v_cod_segmento                cl_rangos.cod_segmento%TYPE;
        v_cos       varchar2(100);
        v_supcos    varchar2(100);
        v_id_entidad_consumo_afin     cl_entidad_consumo.id_entidad_consumo%TYPE;
        v_cod_tipo_afinidad           VARCHAR2(50);
        v_bolsillo_ecms               tx_ecms.type_ecms_bolsilos;
        v_cod_enlace                  VARCHAR2(50);
        v_id_comando                  NUMBER;

        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                     :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_identificador_entidad:'
            || pi_identificador_entidad
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_identificador_entidad IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2505';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2506';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2507';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                     := v_id_tran;
        po_cod_gestion_tran            := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        --EL SUSCRIPTOR NO DEBE TENER SUSPENSIONES
        IF suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2508';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --EL SUSCRIPTOR NO DEBE ESTAR INACTIVO
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF tiene_orden_diferida (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2509';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: La transaccion debe realizarse a fin de ciclo puesto que el suscriptor tiene ordenes diferidas.
            RAISE err_app;
        END IF;

        --- VALIDAR PORTABILIDAD
        IF tx_por_utiles.esta_en_proceso_portacion (v_reg_entidad_consumo.identificador_entidad) =
                                                                                         c_verdadero THEN
            po_cod_err := 'PVT-2510';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: El numero tiene un proceso de portacion out en marcha
            RAISE err_app;
        END IF;

        --SUSCRIPTORES DE CUENTAS PREPAGO NO PUEDEN REALIZAR CAMBIO DE NUMERO
        SELECT c.cod_linea_negocio
          INTO v_cod_linea_negocio
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        -- < ECN    20090116    BUG NO PERMITIR EL CAMBIO DE NUMERO A TODOS LOS PLANES QUE TENGAN EL SERVICIO DE EVDO.
        SELECT COUNT (1)
          INTO v_dummy
          FROM bm_plan_servicio
         WHERE cod_plan = v_reg_entidad_consumo.cod_plan
           AND cod_servicio = 'EVDO'
           AND estado = c_estado_activo;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2511';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error no esta permitido el cambio de numero para este plan.
            RAISE err_app;
        END IF;

        -- ECN    20090116    BUG NO PERMITIR EL CAMBIO DE NUMERO A TODOS LOS PLANES QUE TENGAN EL SERVICIO DE EVDO.  >

        --LOS NUMEROS ACTUAL Y NUEVO DEBEN SER DISTINTOS
        IF v_reg_entidad_consumo.identificador_entidad = pi_identificador_entidad THEN
            po_cod_err := 'PVT-2512';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error el numero nuevo y el antiguo son el mismo.
            RAISE err_app;
        END IF;

        --EL NUEVO NUMERO DEBE ESTAR DISPONIBLE
        po_cod_err := 'PVT-2513';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al determinal si el numero esta disponible.

        SELECT estado_numero
          INTO v_estado_numero
          FROM cl_numero_telefonico nt
         WHERE nt.numero_telefonico = pi_identificador_entidad;

        IF v_estado_numero = '2' THEN
            po_cod_err := 'PVT-2514';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: El numero ingresado no esta disponible.
            RAISE err_app;
        ELSIF v_estado_numero = 'R' THEN
            po_cod_err := 'PVT-2515';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: El numero ingresado esta reservado por una venta en curso.
            RAISE err_app;
        ELSIF v_estado_numero <> '1' THEN
            po_cod_err := 'PVT-2516';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: El numero ingresado no esta disponible.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2517';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al obtener el id del cliente.
        v_id_cliente                   := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        po_cod_err := 'PVT-2518';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al determinal el grupo de plan del suscriptor.

        SELECT cod_grupo_plan,
               p.customer_group
          INTO v_cod_grupo_plan,
               v_customer_group
          FROM bm_plan p
         WHERE p.cod_plan = v_reg_entidad_consumo.cod_plan;

        po_cod_err := 'PVT-2519';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al recuperar el rango del customer_group

        IF tx_por_utiles.get_customer_group_rango (pi_identificador_entidad) IS NOT NULL THEN
            v_customer_group    := tx_por_utiles.get_customer_group_rango (pi_identificador_entidad);
        END IF;

        --SOLO VALIDAR RANGOS CUANDO LA TRANSACCION ES MAESTRA
        IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            IF es_fija (pi_id_entidad_consumo, 'ENTIDAD_CONSUMO') = '1' THEN
                v_cod_segmento    := 'FIJO';
            ELSIF v_cod_linea_negocio IN ('T1VOZ', 'INTER', 'VOIP') THEN
                v_cod_segmento    := v_cod_linea_negocio;
            ELSE
                v_cod_segmento    := 'MOVIL';
            END IF;

            SELECT COUNT (*)
              INTO v_dummy
              FROM cl_rangos r
             WHERE pi_identificador_entidad LIKE r.rango || '%'
               AND r.cod_segmento = v_cod_segmento
               AND NVL (r.cod_tecnologia, v_reg_entidad_consumo.cod_tecnologia) =
                                                                v_reg_entidad_consumo.cod_tecnologia;

            IF v_dummy = 0 THEN
                po_cod_err := 'PVT-2520';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: El prefijo no esta disponible para el suscriptor.
                RAISE err_app;
            END IF;
        END IF;

        --ACTUALIZACION DEL NUMERO EN CL_ENTIDAD_CONSUMO
        po_cod_err := 'PVT-2521';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar a CC_CL_ENTIDAD_CONSUMO.MODIFICACION.
        cc_cl_entidad_consumo.modificacion
               (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                pi_descripcion                 => v_reg_entidad_consumo.descripcion,
                pi_identificador_entidad       => pi_identificador_entidad,
                pi_puk                         => v_reg_entidad_consumo.puk,
                pi_imsi                        => v_reg_entidad_consumo.imsi,
                pi_sim                         => v_reg_entidad_consumo.sim,
                pi_cod_plan                    => v_reg_entidad_consumo.cod_plan,
                pi_tiempo_obligatorio_contrato => v_reg_entidad_consumo.tiempo_obligatorio_contrato,
                pi_id_comunidad_facturante     => v_reg_entidad_consumo.id_comunidad_facturante,
                pi_cod_forma_consumo           => v_reg_entidad_consumo.cod_forma_consumo,
                pi_id_persona                  => v_reg_entidad_consumo.id_persona,
                pi_id_entidad_consumo_ref      => v_reg_entidad_consumo.id_entidad_consumo_referidor,
                pi_id_entidad_consumo_vpn      => v_reg_entidad_consumo.id_entidad_consumo_vpn,
                pi_id_cliente_fs               => v_reg_entidad_consumo.id_cliente_fs,
                pi_id_suscriptor_fs            => v_reg_entidad_consumo.id_suscriptor_fs,
                pi_es_facturable               => v_reg_entidad_consumo.es_facturable,
                pi_id_proc_ems                 => v_reg_entidad_consumo.id_proc_ems,
                pi_id_orig_proc_ems            => v_reg_entidad_consumo.id_orig_proc_ems,
                pi_id_form_ems                 => v_reg_entidad_consumo.id_form_ems,
                pi_id_orig_form_ems            => v_reg_entidad_consumo.id_orig_form_ems,
                pi_cod_usuario                 => pi_cod_usuario,
                pi_id_tran                     => v_id_tran,
                pi_cod_gestion_tran            => v_cod_gestion_tran,
                pi_fch_tran                    => v_fch_tran,
                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                pi_fch_efectiva                => v_fch_tran,
                po_cod_err                     => po_cod_err,
                po_msj_err                     => po_msj_err
               );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF pi_intercepto = 0 THEN
            --MARCAR EL NUMERO ANTERIOR COMO RECICLADO
            po_cod_err := 'PVT-2522';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar a cc_cl_numero_telefonico.CAMBIAR_ESTADO.
            cc_cl_numero_telefonico.cambiar_estado
                                         (pi_numero                      => v_reg_entidad_consumo.identificador_entidad,
                                          pi_estado                      => c_estado_telefono_reciclado,
                                          pi_cod_usuario                 => pi_cod_usuario,
                                          pi_master                      => c_falso,
                                          pi_id_tran                     => v_id_tran,
                                          pi_cod_gestion_tran            => v_cod_gestion_tran,
                                          pi_fch_tran                    => v_fch_tran,
                                          pi_cod_unidad_negocio_tran     => pi_cod_unidad_negocio,
                                          po_cod_err                     => po_cod_err,
                                          po_msj_err                     => po_msj_err
                                         );
        END IF;

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2523';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al determinar el tipo de numero.
        v_tipo_numero                  :=
                                       get_tipo_numero (v_reg_entidad_consumo.identificador_entidad);

        --Si el numero es portado y es CDMA al hacer cambio de numero a un numero de viva se libera el MIN inicial
        IF     v_tipo_numero = c_tipo_numero_portin
           AND v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            po_cod_err := 'PVT-2524';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al determinar el MIN del suscriptor.
            v_min         := get_min_suscriptor (pi_id_entidad_consumo);
            po_cod_err := 'PVT-2525';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al liberar el MIN.
            cc_cl_numero_telefonico.cambiar_estado
                                              (pi_numero                      => v_min,
                                               pi_estado                      => c_tipo_numero_viva,
                                               pi_estado_numero               => c_estado_telefono_disponible,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_master                      => c_falso,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio_tran     => pi_cod_unidad_negocio,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2526';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al desasignar el MIN.
            cc_cl_entidad_consumo_afin.desasignar (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                   pi_identificador_entidad_afin  => v_min,
                                                   pi_cod_tipo_afinidad           => 'TAMIN',
                                                   pi_cod_usuario                 => pi_cod_usuario,
                                                   pi_id_tran                     => v_id_tran,
                                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                   pi_fch_tran                    => v_fch_tran,
                                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                   pi_fch_efectiva                => v_fch_tran,
                                                   po_cod_err                     => po_cod_err,
                                                   po_msj_err                     => po_msj_err
                                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        ELSIF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            v_min    := v_reg_entidad_consumo.identificador_entidad;
        END IF;

        ---MARCAR EL NUEVO NUMERO COMO NUMERO UTILIZADO
        po_cod_err := 'PVT-2527';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar a cc_cl_numero_telefonico.CAMBIAR_ESTADO.
        cc_cl_numero_telefonico.cambiar_estado (pi_numero                      => pi_identificador_entidad,
                                                pi_estado                      => c_estado_telefono_activo,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_master                      => c_falso,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio_tran     => pi_cod_unidad_negocio,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2528';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al recuperar el LRN
        v_lrn                          :=
            tx_por_utiles.get_lrn_asignado (pi_identificador_entidad,
                                            v_reg_entidad_consumo.cod_tecnologia);

        IF v_lrn IS NOT NULL THEN
            --- CAMBIO_NUMERO: BAJA DE NUMERO PREVIO EN LA TABLA DE NUMEROS PORTADOS...
            DECLARE
                v_id_orden                    NUMBER;
                v_cod_err                     VARCHAR2 (200);
                v_msj_err                     VARCHAR2 (200);
            BEGIN
                IF pi_intercepto = 0 THEN
                    cc_ord_numero_portado_gsm.alta
                        (pi_numero                      => v_reg_entidad_consumo.identificador_entidad,
                         pi_lrn                         => NULL,
                         pi_provider_tag                => NULL,
                         pi_accion                      => 'DEL',
                         pi_cod_usuario                 => pi_cod_usuario,
                         pi_id_tran                     => v_id_tran,
                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                         pi_fch_tran                    => v_fch_tran,
                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                         pi_comentario                  =>    'TX_PVT_ENTIDAD_COMSUMO.CAMBIO_NUMERO pi_id_entidad_consumo=>'
                                                           || pi_id_entidad_consumo,
                         po_id_orden                    => v_id_orden,
                         po_cod_err                     => v_cod_err,
                         po_msj_err                     => v_msj_err
                        );

                    IF (v_cod_err <> 'OK') THEN
                        po_cod_err    := v_cod_err;
                        po_msj_err    :=    'CAMBIO_NUMERO. No su pudo dar de baja '
                                         || v_reg_entidad_consumo.identificador_entidad
                                         || ', en la tabla de numeros portados '
                                         || v_msj_err;
                        RAISE err_app;
                    END IF;
                ELSE
                    -- RQX-4284 intercepto de voz para cambio de numeros
                    v_lrn_intercepto    := 1;
                END IF;

                cc_ord_numero_portado_gsm.alta
                    (pi_numero                      => pi_identificador_entidad,
                     pi_lrn                         => v_lrn,
                     pi_provider_tag                => 'OMEGA',
                     pi_accion                      => 'ADD',
                     pi_cod_usuario                 => pi_cod_usuario,
                     pi_id_tran                     => v_id_tran,
                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                     pi_fch_tran                    => v_fch_tran,
                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                     pi_comentario                  =>    'TX_PVT_ENTIDAD_COMSUMO.CAMBIO_NUMERO pi_id_entidad_consumo=>'
                                                       || pi_id_entidad_consumo,
                     po_id_orden                    => v_id_orden,
                     po_cod_err                     => v_cod_err,
                     po_msj_err                     => v_msj_err
                    );

                IF (v_cod_err <> 'OK') THEN
                    po_cod_err    := v_cod_err;
                    po_msj_err    :=    'CAMBIO_NUMERO. No su pudo dar de alta '
                                     || pi_identificador_entidad
                                     || ', en la tabla de numeros portados'
                                     || v_msj_err;
                    RAISE err_app;
                END IF;
            END;
        END IF;

        IF     pi_identificador_entidad NOT LIKE '8294349%'
           AND pi_identificador_entidad NOT LIKE '8294346%'
           AND pi_identificador_entidad NOT LIKE '8294350%'
           -- no cobrar a numero 849305, estos no estaba listos para interconexion
           AND v_reg_entidad_consumo.identificador_entidad NOT LIKE '849305%'
           --Ticket 69955 Numero de Celulares a VMCP
           AND v_reg_entidad_consumo.identificador_entidad NOT IN
                   ('8294130032',
                    '8294130116',
                    '8294130222',
                    '8294130255',
                    '8294130308',
                    '8294130673',
                    '8294130849',
                    '8294130931',
                    '8294131001',
                    '8294131526',
                    '8294131794',
                    '8294131849',
                    '8294131915',
                    '8294131917',
                    '8294132040',
                    '8294132200',
                    '8294132276',
                    '8294132285',
                    '8294132723',
                    '8294132858',
                    '8294133126',
                    '8294133131',
                    '8294133636',
                    '8294133666',
                    '8294134111',
                    '8294134333',
                    '8294135777',
                    '8294136060',
                    '8294136242',
                    '8294137000',
                    '8294137672',
                    '8294137955',
                    '8294138093',
                    '8294138250',
                    '8294138299',
                    '8294138495',
                    '8294138858',
                    '8294139032',
                    '8294139082',
                    '8294139476',
                    '8294139652',
                    '8294139809',
                    '8294139969'
                   )
           -- 2012-08-15 numeros de rangos fijos activados erroneamente como moviles
           -- eliminar despues que realizen cambio de numero
           AND v_reg_entidad_consumo.identificador_entidad NOT IN
                   ('8292530404',
                    '8292530433',
                    '8292530630',
                    '8292530903',
                    '8292531001',
                    '8292531153',
                    '8292531212',
                    '8292531323',
                    '8292531426',
                    '8292532503',
                    '8292532709',
                    '8292535454',
                    '8292540000',
                    '8292540221',
                    '8292542928',
                    '8292547040',
                    '8292547352',
                    '8292548225',
                    '8292548989',
                    '8292549732'
                   )
           AND pi_identificador_entidad NOT LIKE '8294351%' THEN
            IF pi_master = c_verdadero THEN
                --GENERACION DE CARGO ADICIONAL POR TRANSACCION DE CAMBIO DE NUMERO
                po_cod_err := 'PVT-2529';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al obtener la configuracion especial de la transaccion de cambio de numero.

                SELECT *
                  INTO v_reg_config_esp
                  FROM cnf_configuracion_especial ce
                 WHERE ce.tipo = 'COSTO_TRANSACCION' AND ce.cod_registro = c_tipo_transaccion;

                --MVNO (MRT)
                IF v_cod_linea_negocio NOT IN ('PREPAG', 'EXTERN') THEN
                    -- RQX 2930: Alvaro Orellana (10/10/2011)
                    v_cambio_numero_gratis    := FALSE;

                    IF     es_fija (v_reg_entidad_consumo.cod_plan) = '1'
                       AND (v_fch_tran - TRUNC (v_reg_entidad_consumo.fch_creacion) < 2) THEN
                        po_cod_err := 'PVT-2530';   --TX_PVT_ENTIDAD_CONUSMO.CAMBIO_NUMERO: Error al obtener los permisos del usuario.
                        tx_seg_sesion.get_permiso
                                               (pi_cod_usuario                 => pi_cod_usuario,
                                                pi_cod_entidad                 => 'ESP_CAMBIO_NUMERO_VMC_SINCOSTO',
                                                pi_cod_usuario_tran            => pi_cod_usuario,
                                                po_permiso                     => v_permiso,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

                        IF (po_cod_err <> 'OK') THEN
                            RAISE err_app;
                        END IF;

                        IF v_permiso = '1' THEN
                            pi_tipo_cobro             := 0;
                            v_cambio_numero_gratis    := TRUE;
                        END IF;
                    END IF;

                    IF v_cambio_numero_gratis = FALSE THEN
                        --SI LA TRANSACCION DE CAMBIO DE NUMERO POSPAGO TIENE COSTO
                        IF v_reg_config_esp.parametro_1 = c_verdadero THEN
                            pi_tipo_cobro          := 1;   --DIFERIDO A LA FACTURA
                            v_costo_transaccion    := v_reg_config_esp.parametro_3;
                            v_id_cargo             := v_reg_config_esp.parametro_2;
                        ELSE
                            pi_tipo_cobro    := 0;
                        END IF;
                    END IF;
                ELSE
                    --ANTIGUEDAD MINIMA PARA CAMBIO DE NUMERO EN PREPAGO
                    --Ticket 100599 - Restriccion de numeros disponibles para activacion, pi_intercepto=0 (temporal)
                    IF (pi_intercepto=0) THEN
                    IF v_fch_tran - v_reg_entidad_consumo.fch_creacion <
                                                           TO_NUMBER (v_reg_config_esp.parametro_6) THEN
                        po_cod_err := 'PVT-2531';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: El suscriptor no tiene la antiguedad minima para realizar el cambio de numero.
                        RAISE err_app;
                    END IF;
                    END IF;

                    IF v_cod_linea_negocio = 'EXTERN' THEN
                        --SI LA TRANSACCION DE CAMBIO DE NUMERO PREPAGO TIENE COSTO
                        IF v_reg_config_esp.parametro_7 = c_verdadero THEN
                            --SI LA TRANSACCION TIENE COSTO
                            pi_tipo_cobro          := 2;   --DESCONTAR BALANCE
                            v_costo_transaccion    := v_reg_config_esp.parametro_8;
                        ELSE
                            pi_tipo_cobro    := 0;
                        END IF;
                    ELSE
                        --SI LA TRANSACCION DE CAMBIO DE NUMERO PREPAGO TIENE COSTO
                        IF v_reg_config_esp.parametro_4 = c_verdadero THEN
                            --SI LA TRANSACCION TIENE COSTO
                            pi_tipo_cobro          := 2;   --DESCONTAR BALANCE
                            v_costo_transaccion    := v_reg_config_esp.parametro_5;
                        ELSE
                            pi_tipo_cobro    := 0;
                        END IF;
                    END IF;
                END IF;

                --RQX 3013 - interconexion VMC Moca, San Francisco, Higuey 21-Oct-2011
                --IF v_reg_entidad_consumo.identificador_entidad>=8295300000 AND v_reg_entidad_consumo.identificador_entidad<8295304499 THEN
                IF pi_identificador_entidad >= 8295300000 AND pi_identificador_entidad < 8295304499 THEN
                    --El grupo plan debe pertenecer a una linea de negocios fija
                    SELECT COUNT (1)
                      INTO v_dummy
                      FROM bm_grupo_plan
                     WHERE cod_grupo_plan = v_cod_grupo_plan
                       AND cod_linea_negocio IN ('FIJA', 'FIJCOR');

                    IF v_dummy >= 1 THEN
                        v_costo_transaccion    := 0;

                        IF v_reg_entidad_consumo.cod_forma_consumo = 'CCOPRE' THEN
                            pi_tipo_cobro    := 2;
                        ELSE
                            pi_tipo_cobro    := 1;
                        END IF;
                    END IF;
                END IF;

                --RQX 3013 - interconexion VMC Moca, San Francisco, Higuey 21-Oct-2011

                -- /MVNO (MRT)
-- FALTA: no realizar cobro si tiene intercepto de voz
                IF pi_intercepto = 0 THEN
                    IF pi_tipo_cobro = 1 THEN
                        --SI EL COBRO ES DIFERIDO
                        po_cod_err := 'PVT-2532';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar al proc. de registro del cargo por cambio de numero.
                        tx_pvt_ccs.asignar_cargo
                                 (pi_id_cliente                  => v_id_cliente,
                                  pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                  pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                  pi_cod_local                   => NULL,
                                  pi_cod_tipo_documento          => NULL,
                                  pi_id_cargo                    => v_id_cargo,
                                  pi_monto                       => v_costo_transaccion,
                                  pi_es_diferido                 => c_verdadero,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_documento                => v_id_registro_cargo_adic,
                                  po_id_tran                     => v_id_tran,
                                  po_cod_gestion_tran            => v_cod_gestion_tran,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

                        IF (po_cod_err <> 'OK') THEN
                            RAISE err_app;
                        END IF;
                    --SI EL COBRO SE DESCUENTA DEL CORE BALANCE
                    ELSIF pi_tipo_cobro = 2 THEN
                        --EL CAMBIO DE NUMERO EN PREPAGO TIENE UN COSTO DE 50RD$ QUE SE DESCUENTAN DE SU BALANCE SI EL SUSCRIPTOR
                        IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
                            v_id_accion_prv_ext    := c_prv_accion_recarga;
                            v_nro_pps              := v_reg_entidad_consumo.identificador_entidad;
                        ELSE
                            v_id_accion_prv_ext    := 239;
                            v_nro_pps              :=
                                                 '1' || v_reg_entidad_consumo.identificador_entidad;
                        END IF;

                        SELECT COUNT (*)
                          INTO v_dummy
                          FROM bm_plan p, bm_grupo_plan gp
                         WHERE p.creacion_pps = '1'
                           AND p.cod_plan NOT LIKE 'FFA%'
                           AND p.cod_grupo_plan = gp.cod_grupo_plan
                           AND p.cod_plan = v_reg_entidad_consumo.cod_plan
                           AND gp.cod_linea_negocio IN ('FULL', 'FIJA', 'HIBRID');

                        IF v_dummy > 0 THEN
                            v_tipo_bolsillo    := tx_ecms.c_bal_promotional_balance_1;
                        ELSE
                            v_tipo_bolsillo    := tx_ecms.c_bal_core_balance;
                        END IF;

                        po_cod_err := 'PVT-2533';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al obtener el balance principal.
                        tx_ecms.get_datos_balance (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                   pi_balance_id                  => v_tipo_bolsillo,
                                                   po_monto                       => v_core_balance,
                                                   po_fecha                       => v_fch_vigencia,
                                                   po_cod_err                     => po_cod_err,
                                                   po_msj_err                     => po_msj_err
                                                  );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;

                        IF v_core_balance < v_costo_transaccion THEN
                            po_cod_err := 'PVT-2534';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: El suscriptor no tiene balance suficiente en plataforma para realizar el descuento.
                            RAISE err_app;
                        END IF;


                        IF v_tipo_bolsillo <> tx_ecms.c_bal_core_balance THEN
                            v_cod_enlace    :=  'SET_DA_BALANCE_SINEXP';
                        ELSE
                            v_cod_enlace    :=  'AIR_SET_BALANCE_MA';
                        END IF;

                        SELECT tx_vpg_util.get_comando(v_cod_enlace, v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                          INTO v_id_comando
                        FROM DUAL;

                        v_bolsillo_ecms := tx_ecms.get_info_bolsillo(v_tipo_bolsillo);

                        po_cod_err    := 'PVT-5206';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al dar de alta la orden en el PRV.
                        mt_vpg.alta_orden(
                                pi_id_comando               => v_id_comando,
                                pi_id_entidad_consumo       => pi_id_entidad_consumo,
                                pi_cod_transaccion          => c_tipo_transaccion,
                                pi_p1                       => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                                pi_p2                       => tx_air.get_transactionID,
                                pi_p3                       => tx_vpg_util.date2iso(v_fch_tran),
                                pi_p4                       => v_bolsillo_ecms.cod_bolsillo_c1, --ID Bolsillo, solo para DA
                                pi_p5                       => tx_vpg_util.number2cs(v_costo_transaccion*-1),
                                pi_p6                       => v_bolsillo_ecms.cod_unidad_medida_air, -- TIpo de bolsillo, solo para DA
                                pi_p7                       => NULL, --Fecha de expiracion, solo para DA
                                pi_p8                       => 'CAMBIO DE NUMERO',
                                pi_cod_usuario              => pi_cod_usuario,
                                pi_master                   => '0',
                                pi_id_tran                  => v_id_tran,
                                pi_cod_gestion_tran         => v_cod_gestion_tran,
                                pi_fch_tran                 => v_fch_tran,
                                pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                                po_id_orden                 => v_id_orden,
                                po_id_tran                  => v_id_tran,
                                po_fch_tran                 => v_fch_tran,
                                po_cod_err                  => po_cod_err,
                                po_msj_err                  => po_msj_err);

                        IF (po_cod_err != 'OK') THEN
                            RAISE err_app;
                        END IF;


                    END IF;
                END IF;
            END IF;
        END IF;

        --PROVISIONAMIENTO DEL CAMBIO DE NUMERO A DISPOSITIVOS
        po_cod_err := 'PVT-2536';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al determinar el plan vigente.

        SELECT cph.cod_forma_consumo
          INTO v_cod_forma_consumo_vigente
          FROM tr_cambio_plan_historico cph
         WHERE cph.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
           AND v_fch_tran BETWEEN cph.fch_inicio AND cph.fch_fin;

        po_cod_err := 'PVT-2537';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al recuperar la accion para el PRV a invocar.
        v_id_accion_prv_ext            := get_accion_prv (c_tipo_transaccion,
                                                          v_reg_entidad_consumo.cod_tecnologia,
                                                          v_cod_forma_consumo_vigente);
        po_cod_err := 'PVT-2538';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar al proc. PRV_DISPATCHER.EXECUTE_OAS.
        tx_cl_orden_prv.alta   -- C1 OK
            (pi_id_action                   => v_id_accion_prv_ext,
             pi_cod_transaccion             => c_tipo_transaccion,
             pi_id_entidad_consumo          => pi_id_entidad_consumo,
             pi_sub_operacion               => c_tipo_operacion_add,
             pi_fch_programada              => v_fch_tran,
             pi_p1                          => pi_identificador_entidad,
             pi_p2                          => v_reg_entidad_consumo.identificador_entidad,
             pi_p3                          => v_reg_entidad_consumo.imsi,
             pi_p4                          => v_min,   --se envia siempre en CDMA, solo para limpiar del ac, no para el nuevo numero
             pi_p5                          => v_customer_group,
             pi_cod_usuario                 => pi_cod_usuario,
             pi_master                      => c_falso,
             pi_id_tran                     => v_id_tran,
             pi_cod_gestion_tran            => v_cod_gestion_tran,
             pi_fch_tran                    => v_fch_tran,
             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
             po_id_orden                    => v_id_orden,
             po_cod_err                     => po_cod_err,
             po_msj_err                     => po_msj_err
            );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --SE REENVIAN A DISPOSITIVOS LOS SERVICIOS PROVISIONABLES (SOLO CDMA, EN GSM SOLO VMS)
        --PUESTO QUE EL CAMBIO DE NUMERO IMPLICA LA RECREACION DEL SUSCRIPTOR EN DISPOSITIVOS
        po_cod_err := 'PVT-2539';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al determinar los servicios a provisionar.
        v_esn_hex                      := tx_cl_serial_robado.dec_to_hex (v_reg_entidad_consumo.imsi);

        FOR casig IN (SELECT sec.cod_servicio
                        FROM cl_servicio_entidad_consumo sec, bm_servicio s, bm_plan_servicio ps
                       WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                         AND sec.cod_servicio = s.cod_servicio
                         AND s.se_provisiona = c_verdadero
                         AND s.cod_tipo_servicio = c_tipo_serv_basico
                         AND sec.cod_servicio = ps.cod_servicio
                         AND ps.cod_plan = v_reg_entidad_consumo.cod_plan
                         AND sec.estado <> c_estado_inactivo
                         AND sec.fch_fin = c_fecha_fin
                         AND ps.estado <> c_estado_inactivo
                         AND ps.fch_fin = c_fecha_fin)
        LOOP
            IF casig.cod_servicio = 'MS40' THEN
                po_cod_err := 'PVT-2540';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al provisionar Voice Mail.
                tx_cl_orden_prv.alta (pi_id_action                   => 151,   -- C1 OK
                                      pi_cod_transaccion             => c_tipo_transaccion,
                                      pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                      pi_sub_operacion               => c_tipo_operacion_del,
                                      pi_fch_programada              => v_fch_tran,
                                      pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                                      pi_p3                          => v_esn_hex,
                                      pi_p6                          => casig.cod_servicio,
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_master                      => c_falso,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_tran,
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      po_id_orden                    => v_id_orden,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;

            IF    v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma
               OR casig.cod_servicio = 'MS40' THEN
                po_cod_err := 'PVT-2541';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al obtener la accion de adicion de servicio a provisionar.
                v_id_accion_prv_ext    := get_accion_prv (casig.cod_servicio,
                                                          v_reg_entidad_consumo.cod_tecnologia,
                                                          v_cod_forma_consumo_vigente);
                po_cod_err := 'PVT-2542';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar al proc. de envio de ordenes de servicio al provisionador.
                tx_cl_orden_prv.alta (pi_id_action                   => v_id_accion_prv_ext,   -- C1 OK
                                      pi_cod_transaccion             => c_tipo_transaccion,
                                      pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                      pi_sub_operacion               => c_tipo_operacion_add,
                                      pi_fch_programada              => v_fch_tran,
                                      pi_p1                          => pi_identificador_entidad,
                                      pi_p3                          => v_esn_hex,
                                      pi_p6                          => casig.cod_servicio,
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_master                      => c_falso,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_tran,
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      po_id_orden                    => v_id_orden,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END LOOP;

        --ACTUALIZACION DE LAS AFINIDADES DEL SUSCRIPTOR CUYO PCS ESTA CAMBIANDO
        po_cod_err := 'PVT-2543';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al obtener la lista de tipos de afinidades.

        FOR ctipos IN curtiposafinidad (pi_id_entidad_consumo)
        LOOP
            v_numeros_afines    := NULL;

            FOR cnumafin IN curnumerosafines (ctipos.id_entidad_consumo, ctipos.cod_tipo_afinidad)
            LOOP
                v_numeros_afines    := v_numeros_afines || ','
                                       || cnumafin.identificador_entidad_afin;
            END LOOP;

            IF v_numeros_afines IS NOT NULL THEN
                po_cod_err := 'PVT-2544';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar al procedimiento de asignacion de numeros afines.
                tx_pvt_entidad_consumo.actualizar_numero_afin
                                               (pi_id_entidad_consumo          => ctipos.id_entidad_consumo,
                                                pi_cod_tipo_afinidad           => ctipos.cod_tipo_afinidad,
                                                pi_numeros_afines              => v_numeros_afines,
                                                pi_descontar                   => c_falso,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_master                      => c_falso,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                po_id_tran                     => v_id_tran,
                                                po_cod_gestion_tran            => v_cod_gestion_tran,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END LOOP;

        --ACTUALIZACION DE LAS AFINIDADES DE LOS SUSCRIPTORES QUE HACEN REFERENCIA
        --AL PCS DEL SUSCRIPTOR CUYO PCS ESTA CAMBIANDO
        po_cod_err := 'PVT-2545';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al obtener la lista de tipos de afinidad de los numeros relacionados.

        FOR ctipos IN curtiposafinidadrel (v_reg_entidad_consumo.identificador_entidad)
        LOOP
            v_numeros_afines    := NULL;

            FOR cnumafin IN curnumerosafines (ctipos.id_entidad_consumo, ctipos.cod_tipo_afinidad)
            LOOP
                v_numeros_afines    := v_numeros_afines || ','
                                       || cnumafin.identificador_entidad_afin;
            END LOOP;

            IF v_numeros_afines IS NOT NULL THEN
                po_cod_err := 'PVT-2546';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar al procedimiento de asignacion de numeros afines.
                tx_pvt_entidad_consumo.actualizar_numero_afin
                                               (pi_id_entidad_consumo          => ctipos.id_entidad_consumo,
                                                pi_cod_tipo_afinidad           => ctipos.cod_tipo_afinidad,
                                                pi_numeros_afines              => v_numeros_afines,
                                                pi_descontar                   => c_falso,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_master                      => c_falso,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                po_id_tran                     => v_id_tran,
                                                po_cod_gestion_tran            => v_cod_gestion_tran,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END LOOP;

        -- RQX-4284 intercepto de voz para cambio de numeros
        IF pi_intercepto = 1 THEN
            -- Agregar intercepto de voz
            po_cod_err    := 'PVT-2841' || v_lrn_intercepto;   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar al procedimiento que da de alta el intercepto de voz.
            tx_pvt_intercepto.alta
                                (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                 pi_numero_anterior             => v_reg_entidad_consumo.identificador_entidad,
                                 pi_numero_actual               => pi_identificador_entidad,
                                 pi_master                      => c_falso,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_lrn                         => v_lrn_intercepto,
                                 pi_cod_tecnologia              => v_reg_entidad_consumo.cod_tecnologia,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --PROVISIONAR LA ZONIFICACION PARA SUSCRIPTORES FULL CASA
        IF v_cod_grupo_plan = c_grupo_plan_full_hogar THEN
            BEGIN
                po_cod_err := 'PVT-2547';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al determinar la zonificacion actual del suscriptor fullcasa.

                SELECT sec.cod_servicio
                  INTO v_cod_servicio
                  FROM cl_servicio_entidad_consumo sec, bm_servicio s
                 WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                   AND sec.cod_servicio = s.cod_servicio
                   AND s.cod_tipo_servicio = c_tipo_serv_fullhogar
                   AND sec.estado <> c_estado_inactivo
                   AND sec.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_cod_servicio    := NULL;
            END;

            IF v_cod_servicio IS NOT NULL THEN
                po_cod_err := 'PVT-2548';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al obtener la accion de provisionamiento de zonas full casa.
                v_id_accion_prv_ext    := get_accion_prv (c_transaccion_zonif,
                                                          v_reg_entidad_consumo.cod_tecnologia,
                                                          v_cod_forma_consumo_vigente);
                po_cod_err := 'PVT-2549';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al establecer la zona del suscriptor fullcasa.
                tx_cl_orden_prv.alta (pi_id_action                   => v_id_accion_prv_ext,   -- C1 OK
                                      pi_cod_transaccion             => c_tipo_transaccion,
                                      pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                      pi_sub_operacion               => c_tipo_operacion_add,
                                      pi_fch_programada              => v_fch_tran,
                                      pi_p1                          => pi_identificador_entidad,
                                      pi_p6                          => SUBSTR (v_cod_servicio, 2),
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_master                      => c_falso,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_tran,
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      po_id_orden                    => v_id_orden,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;


        --ENVIAR ORDENES AL PRV SI SON ORDENES INMEDIATAS
        po_cod_err := 'PVT-2552';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al enviar las ordenes al provisionador.
        tx_cl_orden_prv.procesar (pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --REGISTRAR EL LOG TRANSACCIONAL POSTVENTA
        v_trama_anterior_pv            := 'Numero:' || v_reg_entidad_consumo.identificador_entidad;
        v_trama_nuevo_pv               := 'Numero:' || pi_identificador_entidad;
        --- Registrar transaccion
        po_cod_err := 'PVT-2553';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
        cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => NULL,
                                   pi_descripcion_observacion     => NULL,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;


        BEGIN
            SELECT ser.cod_servicio
              INTO v_cod_servicio
              FROM cl_servicio_entidad_consumo ser
             WHERE ser.id_entidad_consumo = pi_id_entidad_consumo
               AND ser.cod_servicio IN ('NFVMCM','NFVIVM')
               AND ser.fch_fin = c_fecha_fin;

            SELECT cp.nro_documento
              INTO v_nro_documento
              FROM cl_persona cp
             WHERE cp.id_persona = v_reg_entidad_consumo.id_persona
               AND cp.estado = c_estado_activo;

            SELECT /*+ INDEX(cp IDX_CL_PERSONA_NRO_DOCUMENTO)*/ ec.id_entidad_consumo, DECODE(ec.cod_plan,'VMCP','TANMOC','TANMOV') as cod_afinidad
              INTO v_id_entidad_consumo_afin, v_cod_tipo_afinidad
              FROM cl_entidad_consumo ec, cl_persona cp
             WHERE cp.nro_documento = v_nro_documento
               AND cp.id_persona = ec.id_persona
               AND ec.cod_plan NOT IN (v_reg_entidad_consumo.cod_plan)
               AND ec.fch_creacion >=  trunc(v_reg_entidad_consumo.fch_creacion)
               AND ec.fch_creacion <  trunc(v_reg_entidad_consumo.fch_creacion)  + 1
               AND EXISTS (SELECT 1
                             FROM cl_servicio_entidad_consumo
                            WHERE id_entidad_consumo = ec.id_entidad_consumo
                              AND cod_servicio IN ('NFVMCM','NFVIVM')
                          );
        EXCEPTION
            WHEN OTHERS THEN
                v_cod_servicio := NULL;
        END;

        IF v_cod_servicio IN ('NFVMCM','NFVIVM') THEN
            tx_pvt_entidad_consumo.actualizar_numero_afin (pi_id_entidad_consumo          => v_id_entidad_consumo_afin,
                                                            pi_cod_tipo_afinidad           => v_cod_tipo_afinidad,
                                                            pi_numeros_afines              => pi_identificador_entidad,
                                                            pi_descontar                   => c_falso,
                                                            pi_cod_usuario                 => pi_cod_usuario,
                                                            pi_master                      => c_falso,
                                                            pi_id_tran                     => v_id_tran,
                                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                            pi_fch_tran                    => v_fch_tran,
                                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                            po_id_tran                     => po_id_tran,
                                                            po_cod_gestion_tran            => po_cod_gestion_tran,
                                                            po_cod_err                     => po_cod_err,
                                                            po_msj_err                     => po_msj_err
                                                            );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                     := 'OK';
        po_msj_err                     := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE actualizar_numero_afin (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo_afin.id_entidad_consumo%TYPE,
        pi_cod_tipo_afinidad      IN       cl_entidad_consumo_afin.cod_tipo_afinidad%TYPE,
        pi_numeros_afines         IN       VARCHAR2,
        pi_descontar              IN       VARCHAR2,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                            := tx_cnf_constante.get_constante ('TRANSACCION_ACTUALIZA_NUMERO_AFIN');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.ACTUALIZAR_NUMERO_AFIN';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO_AFIN';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_orden                    cl_orden_prv.id_orden%TYPE;
        v_numeros_afines              VARCHAR2 (250);
        v_dummy                       PLS_INTEGER := 0;
        v_descontar                   PLS_INTEGER := 1;
        v_num_fav_inicial             PLS_INTEGER;
        v_fch_vigencia                DATE;
        v_es_numero_empresa           PLS_INTEGER;
        v_tipo_bolsillo               PLS_INTEGER;
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_id_entidad_consumo_afin     cl_entidad_consumo_afin.id_entidad_consumo_afin%TYPE;
        v_identificador_entidad_afin  cl_entidad_consumo_afin.identificador_entidad_afin%TYPE;
        v_pcs_afin                    cl_entidad_consumo_afin.identificador_entidad_afin%TYPE;
        v_id_registro_cargo_adic      bl_cargo_adicional.id_registro%TYPE;
        v_registro_entidad_consumo    cl_entidad_consumo%ROWTYPE;
        v_reg_entidad_consumo_faf     cl_entidad_consumo%ROWTYPE;
         v_id_registro                 cl_servicio_entidad_consumo.id_registro%TYPE;

        TYPE TabFavorito IS TABLE OF  tx_pvt_entidad_consumo.Favorito;

        TYPE array_num IS TABLE OF VARCHAR2 (50);

        v_arr_num                     array_num
                                    := array_num (' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' '
                                                 );
        v_arr_add                     TabFavorito := TabFavorito ();
        v_arr_del                     TabFavorito := TabFavorito ();
        v_num                         VARCHAR2 (50);
        v_numero_favorito             VARCHAR2 (50);
        v_fav                         Favorito;
        v_add                         BOOLEAN := FALSE;
        v_del                         BOOLEAN := FALSE;
        v_reg_config_esp              cnf_configuracion_especial%ROWTYPE;
        v_cod_servicio                bm_servicio.cod_servicio%TYPE;
        v_core_balance                NUMBER (15, 2);
        v_voila_balance               NUMBER (15, 2);
        v_monto_a_descontar           NUMBER (15, 2);
        v_voila_balance_descontar     NUMBER (15, 2);
        v_posicion                    PLS_INTEGER;
        v_id_wo                       prv_work_order_main.id_wo%TYPE;
        v_numeros_afines_pps          VARCHAR2 (200);
        v_datos_suscriptor            VARCHAR2 (1000);
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_pps_info                    tx_sapi.sapi_subscriber;
        v_i                           PLS_INTEGER;
        v_numero_onnet                NUMBER;
        v_cod_plan                    VARCHAR2(100);
        v_id_comando                  vpg_cnf_comando.id_comando%TYPE;
        v_id_orden_vpg                vpg_orden.id_orden%TYPE;
        v_faf_id                      cl_entidad_consumo_afin.faf_id%TYPE;
        v_tipo_bolsillo_cs            VARCHAR2(10);
        v_core_balance_cs             NUMBER (15,2);
        v_bolsillo_ecms               tx_ecms.type_ecms_bolsilos;
        v_favorito                    tx_pvt_entidad_consumo.Favorito;
        v_cod_enlace                  VARCHAR2(25);
        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_tipo_afinidad:'
            || pi_cod_tipo_afinidad
            || '|'
            || 'pi_numeros_afines:'
            || pi_numeros_afines
            || '|'
            || 'pi_descontar:'
            || pi_descontar
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_tipo_afinidad IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2557';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2558';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2559';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        --EL SUSCRIPTOR NO DEBE TENER NINGUNA SUSPENSION ASIGNADA
        IF     pi_master = c_verdadero
           AND suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2560';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR INACTIVA
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF tiene_orden_diferida (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2561';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: La transaccion debe realizarse a fin de ciclo puesto que el suscriptor tiene ordenes diferidas.
            RAISE err_app;
        END IF;


        SELECT COUNT(1)
            INTO v_dummy
        FROM cl_entidad_consumo_afin
        WHERE id_entidad_consumo = pi_id_entidad_consumo
        AND fch_fin > SYSDATE AND estado = 'A'
        AND cod_tipo_afinidad = pi_cod_tipo_afinidad;

        IF v_dummy > 0 THEN
            IF pi_cod_tipo_afinidad ='TAFIL1' AND pi_numeros_afines  IS NOT NULL THEN
                po_cod_err := 'PVT-5216';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: No esta permitido actualizar este tipo de favorito.
                RAISE
                err_app;
            END IF;
        END IF;

        SELECT COUNT(1)
          INTO v_dummy
          FROM cl_entidad_consumo_afin
         WHERE id_entidad_consumo = pi_id_entidad_consumo
           AND identificador_entidad_afin = pi_numeros_afines
           AND estado = c_estado_activo
           AND fch_fin = c_fecha_fin;

        IF v_dummy <> c_falso THEN
            po_cod_err := 'PVT-2562';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Este numero de telefono ya esta asignado como favorito a este cliente.
            RAISE err_app;
        END IF;

        IF     pi_cod_tipo_afinidad = 'TAFVMC'
           AND (   v_reg_entidad_consumo.fch_creacion <=
                                                TO_DATE ('20100123 00:00:00', 'YYYYMMDD HH24:MI:SS')
                OR v_reg_entidad_consumo.fch_creacion >=
                                                TO_DATE ('20100331 23:59:59', 'YYYYMMDD HH24:MI:SS')
               ) THEN
            po_cod_err := 'PVT-2563';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error el tipo de afinidad solo esta disponible para activaciones del 20090805 al 20090531.
            RAISE err_app;
        END IF;

        --LA ENTIDAD DE CONSUMO DEBE TENER ASIGNADO EL FEATURE RELACIONADO A LA AFINIDAD SOLICITADA
        BEGIN
            po_cod_err := 'PVT-2564';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al determinar si el suscriptor tiene el servicio habilitado.

            SELECT sec.cod_servicio
              INTO v_cod_servicio
              FROM cl_servicio_entidad_consumo sec, bm_servicio s, cnf_configuracion_especial p
             WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
               AND sec.cod_servicio = s.cod_servicio
               AND s.cod_tipo_servicio IN (c_tipo_serv_numfav, 'TSNFLN', 'TSNFUS', 'TSNFCE', 'TSPTA')
               AND s.cod_servicio = p.cod_registro
               AND p.nombre_tabla = 'BM_SERVICIO'
               AND p.parametro_1 = pi_cod_tipo_afinidad
               AND sec.estado <> c_estado_inactivo
               AND sec.fch_fin = c_fecha_fin;

        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                po_cod_err := 'PVT-2565';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El suscriptor no tiene habilitado el servicio requerido para la afinidad.
                RAISE err_app;
        END;

        --OBTENER LA CONFIGURACION ESPECIAL PARA EL SERVICIO DE NUMEROS FAVORITOS
        po_cod_err := 'PVT-2566';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al recuperar la parametrizacion del tipo de numeros favoritos.

        SELECT *
          INTO v_reg_config_esp
          FROM cnf_configuracion_especial p
         WHERE p.nombre_tabla = 'BM_SERVICIO'
           AND p.tipo = 'NUMEROS_FAVORITOS'
           AND p.parametro_1 = pi_cod_tipo_afinidad
           AND p.cod_registro = v_cod_servicio;

        --DESASIGNAR LOS NUMEROS FAVORITOS QUE SE HAYAN QUITADO
        v_numeros_afines       := ',' || pi_numeros_afines || ',';
        v_del                  := FALSE;

        FOR curdesasignados IN (SELECT eca.identificador_entidad,
                                       eca.identificador_entidad_afin numero
                                  FROM cl_entidad_consumo_afin eca
                                 WHERE eca.id_entidad_consumo = pi_id_entidad_consumo
                                   AND eca.cod_tipo_afinidad = pi_cod_tipo_afinidad
                                   AND eca.estado <> c_estado_inactivo
                                   AND eca.fch_fin = c_fecha_fin
                                MINUS
                                SELECT v_reg_entidad_consumo.identificador_entidad,
                                       LTRIM (SUBSTR (x.numeros,
                                                      INSTR (x.numeros, ',', 1, iter.pos),
                                                        INSTR (x.numeros, ',', 1, iter.pos + 1)
                                                      - INSTR (x.numeros, ',', 1, iter.pos)),
                                              ',') numero
                                  FROM (SELECT v_numeros_afines numeros
                                          FROM DUAL) x,
                                       (SELECT ROWNUM pos
                                          FROM cnf_catalogo) iter
                                 WHERE iter.pos <=   LENGTH (x.numeros)
                                                   - LENGTH (REPLACE (x.numeros, ','))
                                                   - 1)
        LOOP

            v_num := trim(curdesasignados.numero);

            po_cod_err := 'PVT-5081';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al obtener el FAF_ID del numero favorito.
            SELECT faf_id
              INTO v_faf_id
              FROM cl_entidad_consumo_afin
             WHERE id_entidad_consumo = pi_id_entidad_consumo
               AND identificador_entidad_afin = v_num
               AND cod_tipo_afinidad = pi_cod_tipo_afinidad
               AND fch_fin > sysdate;

            cc_cl_entidad_consumo_afin.desasignar
                                          (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                           pi_identificador_entidad_afin  => v_num,
                                           pi_cod_tipo_afinidad           => pi_cod_tipo_afinidad,
                                           pi_cod_usuario                 => pi_cod_usuario,
                                           pi_id_tran                     => v_id_tran,
                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                           pi_fch_tran                    =>   v_fch_tran
                                                                             - INTERVAL '1' SECOND,
                                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                           pi_fch_efectiva                =>   v_fch_tran
                                                                             - INTERVAL '1' SECOND,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

           v_numero_favorito :=  v_num;
           IF v_numero_favorito LIKE '809%' OR v_numero_favorito LIKE '829%' OR v_numero_favorito LIKE '849%' THEN
                v_numero_favorito := '1'||v_num;
           END IF;

            v_del                          := TRUE;
            v_arr_del.EXTEND;
            v_arr_del (v_arr_del.LAST).num                  := v_num;
            v_arr_del (v_arr_del.LAST).numero_favorito      := v_numero_favorito;
            v_arr_del (v_arr_del.LAST).faf_id               := v_faf_id;
        END LOOP;

        v_add                  := FALSE;

        --ASIGNAR LOS NUMEROS FAVORITOS QUE SE HAYAN ANADIDO
        FOR curasignados IN (SELECT DISTINCT v_reg_entidad_consumo.identificador_entidad,
                                             LTRIM (SUBSTR (x.numeros,
                                                            INSTR (x.numeros, ',', 1, iter.pos),
                                                              INSTR (x.numeros, ',', 1,
                                                                     iter.pos + 1)
                                                            - INSTR (x.numeros, ',', 1, iter.pos)),
                                                    ',') numero
                                        FROM (SELECT v_numeros_afines numeros
                                                FROM DUAL) x,
                                             (SELECT ROWNUM pos
                                                FROM cnf_catalogo) iter
                                       WHERE iter.pos <=
                                                   LENGTH (x.numeros)
                                                 - LENGTH (REPLACE (x.numeros, ','))
                                                 - 1
                             MINUS
                             SELECT eca.identificador_entidad,
                                    eca.identificador_entidad_afin numero
                               FROM cl_entidad_consumo_afin eca
                              WHERE eca.id_entidad_consumo = pi_id_entidad_consumo
                                AND eca.cod_tipo_afinidad = pi_cod_tipo_afinidad
                                AND eca.estado <> c_estado_inactivo
                                AND eca.fch_fin = c_fecha_fin)
        LOOP
            IF TRIM (curasignados.numero) IS NOT NULL THEN
                IF LENGTH (TRIM (curasignados.numero)) < 10 THEN
                    po_cod_err := 'PVT-2567';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El numero favorito no tiene la longitud correcta.
                    RAISE err_app;
                END IF;

                --VALIDAR QUE NO INGRESEN EL 1 POR DELANTE PARA NUMEROS FAVORITOS DE GSMs
                IF    curasignados.numero LIKE '1809%'
                   OR curasignados.numero LIKE '1829%'
                   OR curasignados.numero LIKE '1849%' THEN
                    po_cod_err := 'PVT-2568';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: No debe anteponer el 1 para el numero favorito de Republica Dominicana.
                    RAISE err_app;
                END IF;

                -- RQX 4997 Que no sean numero fuera de Puerto Rico, Canda y USA
                SELECT COUNT(1)
                  INTO v_numero_onnet
                  FROM cl_numero_telefonico
                 WHERE numero_telefonico = curasignados.numero
                   AND estado IN (c_estado_activo,'PORTIN')
                   AND estado_numero = '2';

                IF pi_cod_tipo_afinidad in ('TAFOA1','TANNW1') and (curasignados.numero LIKE '1473%'
                   OR curasignados.numero LIKE '1268%'
                   OR curasignados.numero LIKE '1242%'
                   OR curasignados.numero LIKE '1246%'
                   OR curasignados.numero LIKE '1441%'
                   OR curasignados.numero LIKE '1345%'
                   OR curasignados.numero LIKE '1767%'
                   OR curasignados.numero LIKE '1876%'
                   OR curasignados.numero LIKE '1869%'
                   OR curasignados.numero LIKE '1758%'
                   OR curasignados.numero LIKE '1784%'
                   OR curasignados.numero LIKE '1868%') THEN
                      po_cod_err    := 'VTA-0605';  --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El numero debe pertenecer a Puerto Rico, Canada o USA.
                      RAISE err_app;

                END IF;

                 if pi_cod_tipo_afinidad in ('TAFOA1','TANNW1') and v_numero_onnet = 1 THEN
                      po_cod_err    := 'VTA-0605';  --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El numero debe pertenecer a Puerto Rico, Canada o USA.
                      RAISE err_app;
                 END IF;

                IF v_numero_onnet = 0 and pi_cod_tipo_afinidad = 'TANFP1' THEN
                    po_cod_err    := 'VTA-0606';  --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El NUMERO FAVORITO PREPAGO solo puede tener numero ONNET.
                    RAISE err_app;
                END IF;
                -- RQX 4997 FIN


                --SI EL NUMERO FAVORITO DEBE ESTAR DENTRO DE LA RED, VALIDAR
                IF pi_master = c_verdadero AND v_reg_config_esp.parametro_6 = c_verdadero THEN
                    po_cod_err := 'PVT-2569';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al determinar si el numero es de la empresa.

                    SELECT COUNT (*)
                      INTO v_es_numero_empresa
                      FROM cl_entidad_consumo ec
                     WHERE ec.identificador_entidad = curasignados.numero
                       AND ec.estado NOT IN (c_estado_inactivo, 'TER', 'POR', 'POST');

                    IF v_es_numero_empresa = 0 THEN
                        po_cod_err := 'PVT-2570';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El/Los numeros favoritos ingresados deben estar dentro de la red.
                        RAISE err_app;
                    END IF;
                END IF;

                IF pi_master = c_verdadero AND v_reg_config_esp.parametro_9 IS NOT NULL THEN   --LONGITUD DEL NUMERO FAVORITO
                    IF LENGTH (TRIM (curasignados.numero)) <>
                                                           TO_NUMBER (v_reg_config_esp.parametro_9) THEN
                        po_cod_err := 'PVT-2571';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: La longitud del numero ingresado no es igual a la configurada para este tipo de numero favorito.
                        RAISE err_app;
                    END IF;
                END IF;

                IF pi_cod_tipo_afinidad = 'TANF16' THEN
                    SELECT COUNT (1)
                      INTO v_dummy
                      FROM TABLE (tx_utiles.SPLIT (   v_reg_config_esp.parametro_12
                                                   || ','
                                                   || v_reg_config_esp.parametro_13))
                     WHERE curasignados.numero LIKE valor || '%';

                    IF v_dummy = 0 THEN
                        po_cod_err := 'PVT-2572';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El prefijo no es valido para el tipo de numero favorito.
                        RAISE err_app;
                    END IF;
                ELSIF v_reg_config_esp.parametro_12 IS NOT NULL THEN
                    -- Verificacion del prefijo del numero favorito para USA, PR y CANADA
                    SELECT COUNT (1)
                      INTO v_dummy
                      FROM TABLE (tx_utiles.SPLIT (v_reg_config_esp.parametro_12))
                     WHERE curasignados.numero LIKE valor || '%';

                    IF v_dummy = 0 THEN
                        po_cod_err := 'PVT-2573';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El prefijo no es valido para el tipo de numero favorito.
                        RAISE err_app;
                    END IF;
                END IF;

                tx_pvt_entidad_consumo.get_faf_id(
                            pi_id_entidad_consumo   => pi_id_entidad_consumo,
                            pi_tipo_afinidad        => pi_cod_tipo_afinidad,
                            pi_numero               => TRIM (curasignados.numero),
                            po_favorito             => v_favorito,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-2574';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al invocar al proc de creacion de la afinidad.
                cc_cl_entidad_consumo_afin.asignar
                           (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                            pi_identificador_entidad       => v_reg_entidad_consumo.identificador_entidad,
                            pi_id_entidad_consumo_afin     => NULL,
                            pi_identificador_entidad_afin  => v_favorito.num,
                            pi_cod_tipo_afinidad           => pi_cod_tipo_afinidad,
                            pi_cod_servicio                => v_reg_config_esp.cod_registro,
                            pi_faf_id                      => v_favorito.faf_id,
                            pi_id_proc_ems                 => NULL,
                            pi_id_orig_proc_ems            => NULL,
                            pi_id_form_ems                 => NULL,
                            pi_id_orig_form_ems            => NULL,
                            pi_id_tarifa                   => v_reg_config_esp.parametro_10,   --id_tarifa
                            pi_cod_carrier                 => NULL,
                            pi_cod_usuario                 => pi_cod_usuario,
                            pi_id_tran                     => v_id_tran,
                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                            pi_fch_tran                    => v_fch_tran,
                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                            pi_fch_efectiva                => v_fch_tran,
                            po_cod_err                     => po_cod_err,
                            po_msj_err                     => po_msj_err
                           );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                v_add                          := TRUE;
                v_arr_add.EXTEND;
                v_arr_add (v_arr_add.LAST).numero_favorito    := v_favorito.numero_favorito;
                v_arr_add (v_arr_add.LAST).num                := v_favorito.num;
                v_arr_add (v_arr_add.LAST).faf_id             := v_favorito.faf_id;
            END IF;
        END LOOP;

        IF pi_master = c_verdadero THEN
            --LA CANTIDAD DE NUMEROS FAVORITOS NO DEBE EXCEDER AL CONFIGURADO EN CNF_CONFIGURACION_ESPECIAL.PARAMETRO_1
            po_cod_err := 'PVT-2575';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al determinar el numero de numeros favoritos registrados.

            SELECT COUNT (*)
              INTO v_dummy
              FROM cl_entidad_consumo_afin eca
             WHERE eca.id_entidad_consumo = pi_id_entidad_consumo
               AND eca.cod_tipo_afinidad = pi_cod_tipo_afinidad
               AND eca.estado <> c_estado_inactivo
               AND eca.fch_fin = c_fecha_fin;

            IF v_dummy > v_reg_config_esp.parametro_2 THEN
                po_cod_err := 'PVT-2576';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: La cantidad de numeros favoritos ingresado excede el maximo permitido.
                RAISE err_app;
            END IF;
        END IF;

        --SE DEBE DESCONTAR 50 PESOS DE CREDITO DE LA PLATAFORMA PARA LOS NUMEROS FAVORITOS
        --GRUPO FULL, CONFIGURADO EN CNF_CONFIGURACION_ESPECIAL.PARAMETRO_3
        IF     pi_descontar = c_verdadero
           AND v_add
           AND v_del
           AND v_reg_config_esp.parametro_3 = c_verdadero
           AND v_reg_entidad_consumo.cod_forma_consumo <> c_forma_consumo_postpago THEN   --RQX 2228
            --CID: ver si sera igual para prepago y full
            po_cod_err := 'PVT-2577';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al recuperar la accion para el PRV a invocar.
            v_id_accion_prv_ext    := get_accion_prv ('RECARGA',
                                                      v_reg_entidad_consumo.cod_tecnologia,
                                                      v_reg_entidad_consumo.cod_forma_consumo);

            SELECT COUNT (*)
              INTO v_dummy
              FROM bm_plan p, bm_grupo_plan gp
             WHERE p.creacion_pps = '1'
               AND p.cod_plan NOT LIKE 'FFA%'
               AND p.cod_grupo_plan = gp.cod_grupo_plan
               AND p.cod_plan = v_reg_entidad_consumo.cod_plan
               AND gp.cod_linea_negocio IN ('FULL', 'FIJA', 'HIBRID');

            v_monto_a_descontar    := TO_NUMBER (v_reg_config_esp.parametro_4);

            IF v_dummy > 0 THEN
                -- CS
                v_tipo_bolsillo_cs    := tx_ecms.c_bal_promotional_balance_1;
                po_cod_err := 'PVT-5083';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al obtener el balance principal.
                tx_ecms.get_datos_balance (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                           pi_balance_id                  => v_tipo_bolsillo_cs,
                                           po_monto                       => v_core_balance_cs,
                                           po_fecha                       => v_fch_vigencia,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                IF v_core_balance_cs < v_monto_a_descontar THEN
                    v_tipo_bolsillo_cs    := tx_ecms.c_bal_core_balance;
                END IF;
            ELSE
                v_tipo_bolsillo_cs    := tx_ecms.c_bal_core_balance;
            END IF;

            IF v_monto_a_descontar > 0 THEN

                po_cod_err := 'PVT-5084';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al obtener el balance principal.
                tx_ecms.get_datos_balance (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                           pi_balance_id                  => v_tipo_bolsillo_cs,
                                           po_monto                       => v_core_balance_cs,
                                           po_fecha                       => v_fch_vigencia,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                IF v_core_balance_cs < v_monto_a_descontar THEN
                    po_cod_err := 'PVT-2580';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: El suscriptor no tiene balance suficiente en dispositivos para realizar el descuento.
                    RAISE err_app;
                END IF;

                po_cod_err    := 'PVT-5085';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: No existe la Accion al PRV para el servicio.
                IF v_tipo_bolsillo_cs <> tx_ecms.c_bal_core_balance THEN
                    v_cod_enlace    :=  'SET_DA_BALANCE_SINEXP';
                ELSE
                    v_cod_enlace    :=  'AIR_SET_BALANCE_MA';
                END IF;

                SELECT tx_vpg_util.get_comando(v_cod_enlace, v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                  INTO v_id_comando
                  FROM DUAL;

                v_bolsillo_ecms := tx_ecms.get_info_bolsillo(v_tipo_bolsillo_cs);

                po_cod_err    := 'PVT-5087';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al dar de alta la orden en el PRV.
                mt_vpg.alta_orden(
                        pi_id_comando               => v_id_comando,
                        pi_id_entidad_consumo       => pi_id_entidad_consumo,
                        pi_fch_programada           => v_fch_tran,
                        pi_cod_transaccion          => c_tipo_transaccion,
                        pi_p1                       => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                        pi_p2                       => tx_air.get_transactionID,
                        pi_p3                       => tx_vpg_util.date2iso(v_fch_tran),
                        pi_p4                       => v_bolsillo_ecms.cod_bolsillo_c1, --ID Bolsillo, solo para DA
                        pi_p5                       => tx_vpg_util.number2cs(v_monto_a_descontar*-1),
                        pi_p6                       => v_bolsillo_ecms.cod_unidad_medida_air, -- TIpo de bolsillo, solo para DA
                        pi_p7                       => NULL, --Fecha de expiracion, solo para DA
                        pi_p8                       => 'ACTUALIZACION FAVORITOS',
                        pi_cod_usuario              => pi_cod_usuario,
                        pi_master                   => '0',
                        pi_id_tran                  => v_id_tran,
                        pi_cod_gestion_tran         => v_cod_gestion_tran,
                        pi_fch_tran                 => v_fch_tran,
                        pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                        po_id_orden                 => v_id_orden,
                        po_id_tran                  => v_id_tran,
                        po_fch_tran                 => v_fch_tran,
                        po_cod_err                  => po_cod_err,
                        po_msj_err                  => po_msj_err);

                IF (po_cod_err != 'OK') THEN
                    RAISE err_app;
                END IF;

            END IF;
        END IF;

        -- Si se debe cobrar por cambio de numero favorito en POSTPAGO se registra como un cargo adicional
        IF     pi_descontar = c_verdadero
           AND v_add
           AND v_del
           AND v_reg_config_esp.parametro_3 = c_verdadero
           AND v_reg_entidad_consumo.cod_forma_consumo = c_forma_consumo_postpago
           /*AND v_cod_servicio = 'INTFAV'*/ THEN
            po_cod_err := 'PVT-2582';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al obtener el id del cliente.
            v_id_cliente    := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
            po_cod_err := 'PVT-2583';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al invocar al proc. de registro del cargo por cambio de numero favorito.
            tx_pvt_ccs.asignar_cargo
                                (pi_id_cliente                  => v_id_cliente,
                                 pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                 pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_cod_local                   => NULL,
                                 pi_cod_tipo_documento          => NULL,
                                 pi_id_cargo                    => c_cargo_cambio_num_fav,
                                 pi_monto                       => v_reg_config_esp.parametro_4,
                                 pi_es_diferido                 => c_verdadero,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_id_documento                => v_id_registro_cargo_adic,
                                 po_id_tran                     => v_id_tran,
                                 po_cod_gestion_tran            => v_cod_gestion_tran,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_entidad_consumo ec
         WHERE ec.identificador_entidad = pi_numeros_afines
               AND ec.estado NOT IN ('I', 'TER', 'POST');

        IF pi_cod_tipo_afinidad = 'TANNW1' AND v_dummy = 0 THEN
            IF SUBSTR (pi_numeros_afines, 1, 3) NOT IN ('809', '829', '849') THEN
                IF SUBSTR (pi_numeros_afines, 1, 1) != '1' THEN
                    po_cod_err := 'PVT-2584';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Debe registrar su numero internacional con 1 delante.
                    RAISE err_app;
                ELSE
                    v_dummy    := 0;
                END IF;
            ELSE
                v_dummy    := 0;
            END IF;
        END IF;

        IF pi_cod_tipo_afinidad = 'TANFIL' AND pi_numeros_afines IS NOT NULL THEN   --NUMERO FAVORITO ILIMITADO ENTRE DOS PCSs
            IF pi_master = c_verdadero AND v_add AND v_del THEN
                po_cod_err := 'PVT-2585';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: No se pueden modificar los numeros favoritos del servicio HABLA GRATIS TU Y YO.
                RAISE err_app;
            END IF;

            --IF NOT v_fch_tran BETWEEN TO_DATE ('13032009', 'ddmmyyyy') AND TO_DATE ('02042009 23:59:59', 'ddmmyyyy HH24:MI:SS') THEN
            --    po_cod_err    := 'PVT-1334';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: La promocion habla gratis tu y yo no esta vigente.
            --    RAISE err_app;
            --END IF;
            po_cod_err := 'PVT-2586';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al determinar el numero de telefono del suscriptor afin.

            SELECT LTRIM (SUBSTR (x.numeros, INSTR (x.numeros, ',', 1, iter.pos),
                                    INSTR (x.numeros, ',', 1, iter.pos + 1)
                                  - INSTR (x.numeros, ',', 1, iter.pos)),
                          ',') numero
              INTO v_identificador_entidad_afin
              FROM (SELECT v_numeros_afines numeros
                      FROM DUAL) x,
                   (SELECT ROWNUM pos
                      FROM cnf_catalogo) iter
             WHERE iter.pos <= LENGTH (x.numeros) - LENGTH (REPLACE (x.numeros, ',')) - 1
               AND LTRIM (SUBSTR (x.numeros, INSTR (x.numeros, ',', 1, iter.pos),
                                    INSTR (x.numeros, ',', 1, iter.pos + 1)
                                  - INSTR (x.numeros, ',', 1, iter.pos)),
                          ',') IS NOT NULL;

            po_cod_err := 'PVT-2587';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al determinar el id del suscriptor afin.

            SELECT get_id_ec (v_identificador_entidad_afin)
              INTO v_id_entidad_consumo_afin
              FROM DUAL;

            po_cod_err := 'PVT-2588';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al determinar si ya esta creada la afinidad de vuelta.

            SELECT COUNT (*)
              INTO v_dummy
              FROM cl_servicio_entidad_consumo sec
             WHERE sec.id_entidad_consumo = v_id_entidad_consumo_afin
               AND sec.cod_servicio = v_cod_servicio
               AND sec.estado <> c_estado_inactivo
               AND sec.fch_fin = c_fecha_fin;

            IF v_dummy = 0 THEN
                po_cod_err := 'PVT-2589';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al determinar la fecha de activacion de los suscriptores.

                SELECT COUNT (*)
                  INTO v_dummy
                  FROM cl_entidad_consumo ec
                 WHERE ec.id_entidad_consumo IN (pi_id_entidad_consumo, v_id_entidad_consumo_afin)
                   AND ec.fch_creacion BETWEEN TO_DATE ('05052009', 'ddmmyyyy')
                                           AND TO_DATE ('02062009', 'ddmmyyyy');

                IF v_dummy = 0 THEN
                    po_cod_err := 'PVT-2590';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Por lo menos uno de los dos PCSs debe haberse activado en FEBRERO 2009.
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-2591';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al asignar el servicio al suscriptor afin.
                tx_pvt_entidad_consumo.asignar_servicio
                                     (pi_id_entidad_consumo          => v_id_entidad_consumo_afin,
                                      pi_cod_servicio                => v_cod_servicio,
                                      pi_complemento                 => v_reg_entidad_consumo.identificador_entidad,
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_master                      => c_falso,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_tran,
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      po_id_tran                     => v_id_tran,
                                      po_cod_gestion_tran            => v_cod_gestion_tran,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        --PROVISIONAR SI v_reg_config_esp.parametro_5 ES VERDADERO
        --CID: VERIFICAR TIPOS DE NUMEROS FAVORITOS PARA PREPAGO
        IF     v_reg_config_esp.parametro_5 = c_verdadero
           AND v_reg_entidad_consumo.cod_forma_consumo <> c_forma_consumo_postpago THEN
            -- Enviar a borrar numeros que se eliminaron
            v_i    := v_arr_del.FIRST;

            WHILE v_i IS NOT NULL
            LOOP
                v_fav         := v_arr_del (v_i);
                v_num         := v_fav.num;

                po_cod_err                  := 'PVT-5088';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al buscar el enlace del comando.
                SELECT tx_vpg_util.get_comando('FAF', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                  INTO v_id_comando
                  FROM DUAL;

                po_cod_err                  := 'PVT-5089';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al dar de alta la orden.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => c_tipo_transaccion,
                            pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_fav.numero_favorito,
                            pi_p4                   => NULL,
                            pi_p5                   => v_fav.faf_id,
                            pi_p6                   => '1',
                            pi_p7                   => 'D',
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden_vpg,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                v_i           := v_arr_del.NEXT (v_i);
            END LOOP;

            -- Enviar a crear numeros que se anadieron
            v_i    := v_arr_add.FIRST;

            WHILE v_i IS NOT NULL
            LOOP
                v_fav         := v_arr_add (v_i);
                v_num         := v_fav.num;

                IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_gsm THEN
                    v_id_accion_prv_ext    := 331;

                    IF v_num LIKE '809%' OR v_num LIKE '829%' OR v_num LIKE '849%' THEN
                        v_num    := '1' || v_num;
                    END IF;
                ELSE
                    v_id_accion_prv_ext    := 330;
                END IF;

                SELECT cod_plan
                  INTO v_cod_plan
                  FROM cl_entidad_consumo
                 WHERE id_entidad_consumo = pi_id_entidad_consumo;

                --IF pi_cod_tipo_afinidad = 'TANNW1' AND v_cod_plan NOT IN ('PRE_EQUIPO','PREPAG_80','PREPAG_150','PREPAG_250') THEN
                --    v_num    := '#' || v_num;
                --END IF;

                IF pi_cod_tipo_afinidad <> 'TANNW1' THEN
                    po_cod_err := 'PVT-2593';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al invocar al proc. de envio de ordenes al provisionador.
                    tx_cl_orden_prv.alta   -- C1 OK
                                                  (pi_id_action                   => v_id_accion_prv_ext,
                                                   pi_cod_transaccion             => c_tipo_transaccion,
                                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                   pi_sub_operacion               => c_tipo_operacion_add,
                                                   pi_fch_programada              => v_fch_tran,
                                                   pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                                                   pi_p2                          => v_num,
                                                   pi_cod_usuario                 => pi_cod_usuario,
                                                   pi_master                      => c_falso,
                                                   pi_id_tran                     => v_id_tran,
                                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                   pi_fch_tran                    => v_fch_tran,
                                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                   po_id_orden                    => v_id_orden,
                                                   po_cod_err                     => po_cod_err,
                                                   po_msj_err                     => po_msj_err
                                                  );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;

                po_cod_err                  := 'PVT-5090';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al buscar el enlace del comando.
                SELECT tx_vpg_util.get_comando('FAF', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                  INTO v_id_comando
                  FROM DUAL;

                po_cod_err                  := 'PVT-5091';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al dar de alta la orden.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => c_tipo_transaccion,
                            pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_fav.numero_favorito,
                            pi_p4                   => NULL,
                            pi_p5                   => v_fav.faf_id,
                            pi_p6                   => '1',
                            pi_p7                   => 'A',
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden_vpg,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                v_i           := v_arr_add.NEXT (v_i);
            END LOOP;
        END IF;

        --ENVIAR ORDENES AL PRV SI SON ORDENES INMEDIATAS
        po_cod_err := 'PVT-2594';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al enviar las ordenes al provisionador.
        tx_cl_orden_prv.procesar (pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --REGISTRAR LOG TRANSACCIONAL POSTVENTA
        IF pi_master = c_verdadero THEN
            po_cod_err := 'PVT-2595';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al obtener el id del cliente.
            v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
            v_trama_nuevo_pv       :=    'Afinidad:'
                                      || pi_cod_tipo_afinidad
                                      || '|'
                                      || 'Numeros Afines:'
                                      || pi_numeros_afines;
            v_trama_anterior_pv    := NULL;
            --- Registrar transaccion
            po_cod_err := 'PVT-2596';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al invocar al proc. de registro del log de la transaccion postventa.
            cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => NULL,
                                   pi_descripcion_observacion     => NULL,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    FUNCTION es_servicio_data_ilimitado(
        pi_cod_servicio         bm_servicio.cod_servicio%TYPE
    )RETURN VARCHAR2
    IS
        v_es_ilimitado        VARCHAR2(50);
    BEGIN

        SELECT tipo
          INTO v_es_ilimitado
          FROM cnf_configuracion_especial
         WHERE tipo = 'DATA_ILIMITADO'
           AND cod_registro =  pi_cod_servicio;

        RETURN c_verdadero;

    EXCEPTION
        WHEN OTHERS THEN
            RETURN c_falso;

    END;


    FUNCTION es_plan_4g (
        pi_cod_plan  IN       cl_entidad_consumo.cod_plan%TYPE
    )RETURN VARCHAR2
    IS
        v_rate_plan_id        VARCHAR2(50);
        v_dummy               NUMBER;
    BEGIN

        v_rate_plan_id  :=  tx_vpg_util.get_plan_param_value(pi_cod_plan, 'RATE_PLAN_ID', 'VPG_CNF');

        SELECT COUNT(1)
            INTO v_dummy
        FROM cnf_configuracion_especial
        WHERE nombre_tabla = 'BM_PLAN'
        AND tipo = 'PLAN_4G_SERVICE_CLASS'
        AND cod_registro = v_rate_plan_id;

        IF v_dummy > 0 THEN
            RETURN c_verdadero;
        ELSE
            RETURN c_falso;
        END IF;

    EXCEPTION
        WHEN OTHERS THEN
            RETURN c_falso;

    END;

    FUNCTION es_suscriptor_4g (
        pi_id_entidad_consumo  IN       cl_entidad_consumo.id_entidad_consumo%TYPE
    )RETURN VARCHAR2
    IS
        v_rate_plan_id        VARCHAR2(50);
        v_dummy               NUMBER;
        v_cod_plan            VARCHAR2(50);
    BEGIN

        SELECT cod_plan
            INTO v_cod_plan
        FROM cl_entidad_consumo
        WHERE id_entidad_consumo = pi_id_entidad_consumo;

        v_rate_plan_id  :=  tx_vpg_util.get_plan_param_value(v_cod_plan, 'RATE_PLAN_ID', 'VPG_CNF');

        SELECT COUNT(1)
            INTO v_dummy
        FROM cnf_configuracion_especial
        WHERE nombre_tabla = 'BM_PLAN'
        AND tipo = 'PLAN_4G_SERVICE_CLASS'
        AND cod_registro = v_rate_plan_id;

        IF v_dummy > 0 THEN
            RETURN c_verdadero;
        ELSE
            RETURN c_falso;
        END IF;

    EXCEPTION
        WHEN OTHERS THEN
            RETURN c_falso;

    END;


    PROCEDURE asignar_servicio (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_servicio           IN       cl_servicio_entidad_consumo.cod_servicio%TYPE,
        pi_complemento            IN       VARCHAR2,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                         := tx_cnf_constante.get_constante ('TRANSACCION_SERVICIO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.ASIGNAR_SERVICIO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_SERVICIO_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_reg_entidad_consumo_faf     cl_entidad_consumo%ROWTYPE;
        v_id_registro                 cl_servicio_entidad_consumo.id_registro%TYPE;
        v_dummy                       PLS_INTEGER;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_esn_hex                     cl_entidad_consumo.imsi%TYPE;
        v_cod_tipo_afinidad           cl_entidad_consumo_afin.cod_tipo_afinidad%TYPE;
        v_servicio_excluyente         bm_tipo_servicio.servicio_excluyente%TYPE;
        v_cod_servicio_excluyente     bm_servicio.cod_servicio%TYPE;
        v_tecnologia_exclusiva        cnf_configuracion_especial.parametro_1%TYPE;
        v_reg_servicio                bm_servicio%ROWTYPE;
        v_passwd_evdo                 cl_entidad_consumo.imsi%TYPE;
        v_flag                        NUMBER;
        v_precio                      NUMBER;
        v_sms_mensaje                 VARCHAR2(200);
        -- Excepciones
        err_app                       EXCEPTION;
        err_servicio                  EXCEPTION;
        --
        v_cod_observacion             cnf_nota_transaccion.cod_observacion%TYPE;
        v_descripcion_observacion     cnf_nota_transaccion.descripcion%TYPE;
        v_id_mensaje                  sms_despachador.id_sms%TYPE;
        v_parametro_1                 cnf_configuracion_especial.parametro_1%TYPE;
        po_id_orden                   ord_simpleprv.id_orden%TYPE;
        v_fch_fin_periodo_vigente     DATE;
        v_cod_ciclo_facturacion       tr_periodo_facturacion.cod_ciclo_facturacion%TYPE;
        v_id_accion                   prv_action.id_action%TYPE;
        v_tipo_procedencia            VARCHAR2(100);
        v_servicios_excluyentes       VARCHAR2(1000);
        v_cnf_servicio                cnf_servicios%ROWTYPE;
        v_dmm_identificador_entidad   VARCHAR2(20);
        v_orden_ird                   ord_simpleprv.id_orden%type;
        v_id_base                     prm_base_tv.id_base%TYPE;
        v_cod_segmento                VARCHAR2(100);
        v_resultado_bono              VARCHAR2(10);
        v_offer_id                    VARCHAR2(10);
        v_vigencia                    VARCHAR2(10);
        v_id_comando                  vpg_cnf_comando.id_comando%TYPE;
        v_id_orden                    vpg_orden.id_orden%TYPE;
        v_apn_id                      vpg_orden_param.valor%TYPE;
        v_eqos_id                     vpg_orden_param.valor%TYPE;
        v_pdpcp_id                    vpg_orden_param.valor%TYPE;
        v_eps_profile_id              vpg_orden_param.valor%TYPE;
        v_da_id                       vpg_orden_param.valor%TYPE;
        v_minutes_amt                 NUMBER;
        v_da_unit_type                NUMBER;
        v_id_cmd_upd                  NUMBER;
        v_reg_ecms_bolsillo           tx_ecms.type_ecms_bolsilos;
        v_reg_periodo                 tr_periodo_facturacion%ROWTYPE;
        v_numeros_afines              VARCHAR2(20);
        v_cod_tipo_documento          cl_persona.cod_tipo_documento%TYPE;

    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_servicio:'
            || pi_cod_servicio
            || '|'
            || 'pi_complemento:'
            || pi_complemento
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_servicio IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2597';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2598';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2599';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        --LA ENTIDAD DE CONSUMO NO DEBE TENER NINGUNA SUSPENSION
        IF suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2600';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR INACTIVA
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2601';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al recuperar los datos del servicio.

        SELECT *
          INTO v_reg_servicio
          FROM bm_servicio s
         WHERE s.cod_servicio = pi_cod_servicio;

        --NO PUEDE ASIGNARSE ESTA PROMOCION EN TRANSACCIONES POSTVENTA
        IF pi_master = c_verdadero AND v_reg_servicio.cod_tipo_servicio = 'TSPROM' THEN
            po_cod_err := 'PVT-2602';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: La promocion solo puede asignarse en activacion.
            RAISE err_app;
        END IF;


        --SOLO SE ASIGNAN SERVICIOS BASICOS, NUMEROS FAVORITOS Y SERVICIOS EXCLUYENTES MEDIANTE ESTE METODO
        IF v_reg_servicio.cod_tipo_servicio NOT IN (c_tipo_serv_basico,
                                                    c_tipo_serv_numfav,
                                                    'TSGAR',   --garantia
                                                    'TSNFLN',   --favoritos local nal
                                                    'TSNFUS',   --favoritos usa
                                                    'TSNFCE',   --favoritos centennial
                                                    'TSLOC',   --paquete de minutos
                                                    'TSDAT',   --servicio de datos
                                                    'TSSMS',   --paquete de sms
                                                    'TSLDU',   --LD usa
                                                    'TSPROM',   --Promociones en activacion
                                                    'TSPGPR',   --Pagos Recurrentes
                                                    'BBDAT',   --Servicio BB
                                                    'TSEVDO',   --Servicio EVDO Prepago
                                                    'TSVSOC',   --Servicio vSocial
                                                    'TSILI',   --Servicio Paquetes Ilimitados
                                                    'TSESP',   --Servicio Paquetes Especiales
                                                    'TSPTA', --Servicio Plan Prepago Tu Atributo
--                                                    'TSMSE', --Servicio MicroSeguros de Salud
                                                    'TSVMCP', --Servicio VMC PortIn
                                                    'TSVMP', --Servicio VMC PortIn
                                                    'TSOAT', --Servicio Own A Town
                                                    'TSTVBA', -- Servicio Basico Viva TV
                                                    'TSTVPQ', --Servicio Paquete HBO
                                                    'TSSTB', --Servicio TV Set Top Box
                                                    'TSVSF',  --Servicio Security Force
                                                    'TSPDAT', --Paquete datos new
                                                    'TSLIM', --Paquete datos new
                                                    'TSROM', --Paquete roaming new
                                                    'TSSOC', -- Paquete Social
                                                    'TSMIOF', -- PAquete minutos offnet
                                                    'TSPAQ', -- PAQUETE DE SERVICIOS DE ACTIVACION
                                                    'TSMION', --PAQUETE MINUTOS ONNET
                                                    'TSEXT', --Servicio Externo SAM Asistencia
                                                    'TSBON',
                                                    'TSPAIN'
                                                   ) THEN
            po_cod_err := 'PVT-2603';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Tipo de servicio no soportado por este procedimiento.
            RAISE err_app;
        END IF;

        IF     v_reg_servicio.cod_tipo_servicio = c_tipo_serv_datos
           AND v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma
           AND NVL
                   (tx_pvt_entidad_consumo.get_procedencia_articulo
                                                          (v_reg_entidad_consumo.id_entidad_consumo,
                                                           v_reg_entidad_consumo.imsi),
                    'NULL') IN ('TPDLR', 'TPCLI') THEN
            po_cod_err := 'PVT-2604';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Servicio de data no permitido CDMA con equipo del cliente.
            RAISE err_app;
        END IF;

        --EL SERVICIO DEBE ESTAR DISPONIBLE PARA EL PLAN DEL SUSCRIPTOR
        po_cod_err := 'PVT-2605';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al validar si el servicio esta permitido en el plan.

        SELECT COUNT (1)
          INTO v_dummy
          FROM bm_plan_servicio
         WHERE cod_plan = v_reg_entidad_consumo.cod_plan
           AND cod_servicio = pi_cod_servicio
           AND fch_fin = c_fecha_fin
           AND estado <> c_estado_inactivo;

        IF v_dummy = 0 THEN
            po_cod_err := 'PVT-2606';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: El servicio no esta disponible para el plan del suscriptor.
            RAISE err_app;
        END IF;

        --NO SE PUEDE ASIGNAR EL SERVICIO MAS DE UNA VEZ
        po_cod_err := 'PVT-2607';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al validar si el servicio ya se encuentra asignado.

        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_servicio_entidad_consumo
         WHERE id_entidad_consumo = pi_id_entidad_consumo
           AND cod_servicio = pi_cod_servicio
           AND fch_fin = c_fecha_fin
           AND estado <> c_estado_inactivo;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2608';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error el servicio ya se encuentra asignado.
            RAISE err_app;
        END IF;

        --PARA EL CASO DE SERVICIOS DE PAQUETES, NO PUEDE ASIGNARSE MAS DE UN SERVICIO CON EL MISMO TIPO
        po_cod_err := 'PVT-2609';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error el determinar si el tipo de servicio es excluyente o no.

        SELECT servicio_excluyente
          INTO v_servicio_excluyente
          FROM bm_tipo_servicio ts
         WHERE ts.cod_tipo_servicio = v_reg_servicio.cod_tipo_servicio;

        IF v_servicio_excluyente = c_verdadero THEN
            po_cod_err := 'PVT-2610';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al validar si el servicio ya se encuentra asignado.

            SELECT COUNT (1)
              INTO v_dummy
              FROM cl_servicio_entidad_consumo sec, bm_servicio s
             WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
               AND sec.cod_servicio = pi_cod_servicio
               AND sec.cod_servicio = s.cod_servicio
               AND s.cod_tipo_servicio = v_reg_servicio.cod_tipo_servicio
               AND sec.fch_fin = c_fecha_fin
               AND sec.estado <> c_estado_inactivo;

            IF v_dummy > 0 THEN
                po_cod_err := 'PVT-2611';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Ya existe asignado un servicio con el mismo tipo.
                RAISE err_app;
            END IF;
        END IF;

        IF v_reg_servicio.cod_tipo_servicio = 'TSROM' THEN

            SELECT COUNT(1) INTO v_dummy
            FROM cl_servicio_entidad_consumo ser
            WHERE ser.cod_servicio = 'ROAM'
            AND ser.id_entidad_consumo = pi_id_entidad_consumo
            AND ser.fch_fin = c_fecha_fin;

            IF v_dummy = 0 THEN
                tx_pvt_entidad_consumo.asignar_servicio (
                    pi_id_entidad_consumo   => pi_id_entidad_consumo,
                    pi_cod_servicio         => 'ROAM',
                    pi_complemento          => NULL,
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_tran              => v_id_tran,
                    po_cod_gestion_tran     => v_cod_gestion_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err);

                IF po_cod_err != 'OK'
                THEN
                    RAISE err_app;
                END IF;
            END IF;

        END IF;

        --Asistencia viva y Aeroambulancia/Unit.
        IF v_reg_servicio.cod_tipo_servicio = 'TSEXT' THEN

                SELECT COUNT (1)
                  INTO v_dummy
                  FROM cl_servicio_entidad_consumo cs
                 WHERE cs.id_entidad_consumo = pi_id_entidad_consumo
                 AND cs.COD_SERVICIO IN ( SELECT bm.cod_servicio
                                          FROM bm_servicio bm
                                          WHERE bm.cod_tipo_servicio = 'TSEXT'
                                            AND bm.cod_servicio = v_reg_servicio.cod_servicio)
                   AND cs.estado = 'A'
                   AND cs.fch_efectiva_fin >= trunc(sysdate);

            IF v_dummy > 0 THEN
                po_cod_err    := 'PVT-6106';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Ya tiene el servicio activo.
                RAISE err_app;
            END IF;

            IF v_reg_servicio.cod_servicio IN ('SAMBU', 'SUNDE', 'SUNEQ') THEN --CVE: para validar tipo-doc del cliente en servicio aeroambulancia/unit.20/06/2025.
                po_cod_err := 'PVT-2603';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Tipo de servicio no soportado por este procedimiento.
                SELECT p.cod_tipo_documento
                  INTO v_cod_tipo_documento
                  FROM cl_persona p
                 WHERE p.id_persona = v_reg_entidad_consumo.id_persona;

                IF v_cod_tipo_documento = 'RNC' THEN
                    po_cod_err := 'PVT-2603';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Tipo de servicio no soportado por este procedimiento.
                    RAISE err_app;
                END IF;
            END IF;

        END IF;

        IF v_reg_servicio.cod_tipo_servicio = 'TSTVPQ' THEN

            po_cod_err := 'PVT-2612';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al obtener la configuracion adicional del servicio.
            SELECT *
             INTO v_cnf_servicio
            FROM cnf_servicios
            WHERE cod_servicio = v_reg_servicio.cod_servicio;

            FOR c_servicios IN (SELECT INITCAP (s.descripcion) AS servicio
                                  FROM TABLE (tx_utiles.SPLIT (v_cnf_servicio.servicio_excluyente)) v,
                                       cl_servicio_entidad_consumo se,
                                       bm_servicio s
                                 WHERE s.cod_servicio = v.valor
                                   AND se.id_entidad_consumo = pi_id_entidad_consumo
                                   AND se.cod_servicio = s.cod_servicio
                                   AND se.fch_fin = c_fecha_fin
                                   AND se.estado <> c_estado_inactivo)
            LOOP
                v_servicios_excluyentes    := v_servicios_excluyentes || c_servicios.servicio || ', ';
            END LOOP;

            --Si la validacion por cod_servicio saca algun registro mostramos error
            IF v_servicios_excluyentes IS NOT NULL THEN
                v_servicios_excluyentes    := RTRIM (v_servicios_excluyentes, ', ');
                po_cod_err := 'PVT-2613';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Antes de activar este servicio debe terminar los servicios excluyentes.
                po_msj_err                 := 'Antes de activar el servicio ' || INITCAP(v_reg_servicio.descripcion) || ' debe terminar los siguientes servicios: ' || v_servicios_excluyentes;
                RAISE err_servicio;
            END IF;
        END IF;

        --EL SERVICIO NO DEBE ESTAR ASIGNADO EN UN PAQUETE DE SERVICIOS YA ASIGNADO
        po_cod_err := 'PVT-2614';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al validar si el servicio ya se encuentra asignado.

        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_servicio_entidad_consumo cs, bm_servicio_paquete bmp
         WHERE bmp.cod_servicio = pi_cod_servicio
           AND cs.cod_servicio = bmp.cod_servicio_paquete
           AND cs.id_entidad_consumo = pi_id_entidad_consumo
           AND cs.estado <> c_estado_inactivo
           AND cs.fch_fin = c_fecha_fin
           AND bmp.estado <> c_estado_inactivo
           AND bmp.fch_fin = c_fecha_fin;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2615';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error el servicio ya se encuentra asignado en un paquete de servicios.
            RAISE err_app;
        END IF;

        --EL SERVICIO A ASIGNAR NO DEBE SER EXCLUYENTE CON UN SERVICIO YA ASIGNADO
        po_cod_err := 'PVT-2616';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al determinar si el servicio tiene servicios excluyentes relacionados.

        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_servicio_entidad_consumo sec, cnf_configuracion_especial ce
         WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
           AND sec.cod_servicio = ce.cod_registro
           AND ce.parametro_7 = pi_cod_servicio
           AND ce.nombre_tabla = 'BM_SERVICIO'
           AND sec.fch_fin = c_fecha_fin
           AND sec.estado <> c_estado_inactivo;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2617';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: El servicio a asignar es excluyente con un servicio ya asignado al suscriptor.
            RAISE err_app;
        END IF;

        -- VERIFICAMOS SI EL SERVICIO ES DATA ILIMITADO O PIVOZDAT.
        SELECT COUNT (1)
          INTO v_dummy
          FROM cnf_configuracion_especial ce
         WHERE ce.cod_registro = pi_cod_servicio
           AND ce.tipo = 'DATA_ILIMITADO'
           AND ce.parametro_1 = '1';

        IF v_dummy > 0 THEN
            -- VERIFICAMOS SI YA TIENE OTRO SERVICIO DE ESTE GRUPO.
            SELECT COUNT (1)
              INTO v_dummy
              FROM cl_servicio_entidad_consumo sec, cnf_configuracion_especial ce
             WHERE sec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND sec.estado <> c_estado_inactivo
               AND sec.fch_fin = c_fecha_fin
               AND sec.cod_servicio = ce.cod_registro
               AND ce.tipo = 'DATA_ILIMITADO'
               AND ce.parametro_1 = '1';

            IF v_dummy > 0 THEN
                po_cod_err := 'PVT-2618';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: El suscriptor ya tiene un servicio de Data Ilimitado o PIVOZDAT.
                RAISE err_app;
            END IF;
        END IF;

        IF v_reg_servicio.cod_servicio = 'HABNOC' THEN

                    SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_plan, 'VIGENCIA', 'VPG_CNF')
                      INTO v_vigencia
                    FROM DUAL;

            --ASIGNACION DEL SERVICIO A LA ENTIDAD DE CONSUMO
            po_cod_err := 'PVT-2619';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al invocar a CC_CL_SERVICIO_ENTIDAD_CONSUMO.ASIGNAR.
            cc_cl_servicio_entidad_consumo.asignar (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                    pi_cod_servicio                => pi_cod_servicio,
                                                    pi_cod_plan                    => NULL,
                                                    pi_precio                      => CASE WHEN pi_cod_servicio IN('PLVOZ2') THEN pi_complemento ELSE NULL END,
                                                    pi_cod_moneda                  => NULL,
                                                    pi_cod_tipo_cobro              => NULL,
                                                    pi_es_facturable               => NULL,
                                                    pi_es_por_defecto              => NULL,
                                                    pi_id_proc_ems                 => NULL,
                                                    pi_id_orig_proc_ems            => NULL,
                                                    pi_id_form_ems                 => NULL,
                                                    pi_id_orig_form_ems            => NULL,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    pi_fch_efectiva_inicio         => v_fch_tran,
                                                    pi_fch_efectiva_fin            => SYSDATE + v_vigencia,
                                                    po_id_registro                 => v_id_registro,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE

             --ASIGNACION DEL SERVICIO A LA ENTIDAD DE CONSUMO
            po_cod_err := 'PVT-2619';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al invocar a CC_CL_SERVICIO_ENTIDAD_CONSUMO.ASIGNAR.
            cc_cl_servicio_entidad_consumo.asignar (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                    pi_cod_servicio                => pi_cod_servicio,
                                                    pi_cod_plan                    => NULL,
                                                    pi_precio                      => CASE WHEN pi_cod_servicio IN('PLVOZ2') THEN pi_complemento ELSE NULL END,
                                                    pi_cod_moneda                  => NULL,
                                                    pi_cod_tipo_cobro              => NULL,
                                                    pi_es_facturable               => NULL,
                                                    pi_es_por_defecto              => NULL,
                                                    pi_id_proc_ems                 => NULL,
                                                    pi_id_orig_proc_ems            => NULL,
                                                    pi_id_form_ems                 => NULL,
                                                    pi_id_orig_form_ems            => NULL,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    pi_fch_efectiva_inicio         => v_fch_tran,
                                                    pi_fch_efectiva_fin            => c_fecha_fin,
                                                    po_id_registro                 => v_id_registro,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

        END IF;

        -- El servicio APNWAP6 reemplaza el APN edge.viva.net.do(WAP3) por internet.viva.do (WAP6) para todos los servicios de data ilimitados
        IF pi_cod_servicio = 'APNWAP6' THEN
            po_cod_err := 'PVT-2620';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al invocar a toggle_wap6
            toggle_wap6 (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                         pi_sub_operation               => 'ADD',
                         pi_cod_transaccion             => c_tipo_transaccion,
                         pi_cod_usuario                 => pi_cod_usuario,
                         pi_id_tran                     => v_id_tran,
                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                         pi_fch_tran                    => v_fch_tran,
                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                         po_cod_err                     => po_cod_err,
                         po_msj_err                     => po_msj_err
                        );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --PROVISIONAR EL SERVICIO SI ES PROVISIONABLE - NO TV
        IF v_reg_servicio.se_provisiona = c_verdadero AND v_reg_entidad_consumo.cod_tecnologia <> 'TV' AND v_reg_servicio.cod_tipo_servicio NOT IN('TSPAQ') THEN

            IF v_reg_servicio.cod_tipo_servicio IN (c_tipo_serv_basico,
                                                    c_tipo_serv_datos,
                                                    'BBDAT',
                                                    'TSILI',
                                                    'TSLIM',
                                                    'TSESP',
                                                    'TSVMCP'
                                                   ) OR ( v_reg_servicio.cod_tipo_servicio = 'TSPTA'
                                                           AND v_reg_servicio.cod_servicio IN ('DATPTA', 'TRFESP') )
                                                     OR  v_reg_servicio.cod_servicio IN ('VOZUCP','VOZFIJ','HABNOC') THEN
                v_identificador_entidad    := v_reg_entidad_consumo.identificador_entidad;

                po_cod_err := 'PVT-2622';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al convertir el esn a hexadecimal.
                v_esn_hex                  :=
                                        tx_cl_serial_robado.dec_to_hex (v_reg_entidad_consumo.imsi);

                po_cod_err    := 'PVT-5023'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe la Accion al PRV para el servicio.
                SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                  INTO v_id_comando
                FROM DUAL;

                IF v_reg_servicio.cod_servicio = 'EVDO' THEN
                    BEGIN
                        SELECT n.passwd
                          INTO v_passwd_evdo
                          FROM evdo_nai_update n
                         WHERE n.esn = v_reg_entidad_consumo.imsi AND n.estado = 'OK';
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            v_passwd_evdo    := v_reg_entidad_consumo.imsi;
                    END;
                ELSIF v_reg_servicio.c1_offer_id is not null THEN
                        --PROVISIONAR EL SERVICIO VMC HABLA GRATIS ONNET
                        v_passwd_evdo := v_reg_servicio.c1_offer_id;
                END IF;

                v_id_accion_prv_ext        := get_accion_wap6_transform (pi_id_entidad_consumo,
                                                                         pi_cod_servicio,
                                                                         v_id_accion_prv_ext);

                IF v_reg_servicio.cod_servicio IN ('WHATILIINC') THEN

                    --VPG--
                    po_cod_err    := 'PVT-5023'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe un offer configurado para este servicio.
                    SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_plan, 'OFFER_ID', 'VPG_CNF')
                      INTO v_offer_id
                    FROM DUAL;

                    po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => v_offer_id, -- OFFER ID   -- TODO: JA nos enviare los OFFER ID
                                pi_p4                   => CASE WHEN v_reg_servicio.cod_servicio IN ('WHATILIINC') THEN 'A' ELSE 'C' END,
                                pi_p5                   => NULL, --Fecha Vigencia
                                pi_p6                   => NULL, --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;


                ELSIF v_reg_servicio.cod_servicio IN ('HABNOC') THEN

                    --VPG--
                    po_cod_err    := 'PVT-5023'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe un offer configurado para este servicio.
                    SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_plan, 'OFFER_ID', 'VPG_CNF')
                      INTO v_offer_id
                    FROM DUAL;

                    SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_plan, 'VIGENCIA', 'VPG_CNF')
                      INTO v_vigencia
                    FROM DUAL;

                    po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => v_offer_id, -- OFFER ID   -- TODO: JA nos enviare los OFFER ID
                                pi_p4                   => 'C',
                                pi_p5                   => SYSDATE, --Fecha Vigencia
                                pi_p6                   => SYSDATE + v_vigencia, --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;


                ELSIF v_reg_servicio.cod_servicio != 'BLQCAL'  OR (v_reg_servicio.cod_servicio = 'BLQCAL' AND v_reg_entidad_consumo.cod_tecnologia != 'CDMA') THEN

                    IF v_reg_servicio.cod_tipo_servicio NOT IN (c_tipo_serv_datos,c_tipo_serv_basico) THEN


                        po_cod_err := 'PVT-2612';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al obtener la configuracion adicional del servicio.
                        SELECT *
                         INTO v_cnf_servicio
                        FROM cnf_servicios
                        WHERE cod_servicio = v_reg_servicio.cod_servicio;


                        --VPG--
                        po_cod_err    := 'PVT-5033'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe un offer configurado para este servicio.
                        SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_plan, 'OFFER_ID', 'VPG_CNF')
                          INTO v_offer_id
                        FROM DUAL;

                        po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                        mt_vpg.alta_orden(
                                    pi_id_comando           => v_id_comando,
                                    pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                    pi_fch_programada       => pi_fch_tran,
                                    pi_cod_transaccion      => c_tipo_transaccion,
                                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                    pi_p2                   => pi_id_entidad_consumo,
                                    pi_p3                   => v_offer_id, -- OFFER ID
                                    pi_p4                   => CASE
                                                                WHEN (v_cnf_servicio.tipo_oferta = 'TIMER' OR es_suscriptor_4g(v_reg_entidad_consumo.id_entidad_consumo) = c_verdadero )
                                                                     THEN 'A' ELSE 'C' END,
                                    pi_p5                   => NULL, --Fecha Vigencia
                                    pi_p6                   => CASE WHEN pi_cod_servicio in ('PLVOZ1','PLVOZ2','PLVOZ3') THEN c_fecha_fin_ecms ELSE NULL END, --Fecha Expiracion
                                    pi_cod_usuario          => pi_cod_usuario,
                                    pi_master               => c_falso,
                                    pi_id_tran              => v_id_tran,
                                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                                    pi_fch_tran             => v_fch_tran,
                                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                    po_id_orden             => v_id_orden,
                                    po_id_tran              => v_id_tran,
                                    po_fch_tran             => v_fch_tran,
                                    po_cod_err              => po_cod_err,
                                    po_msj_err              => po_msj_err
                                    );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;

                    ELSIF v_reg_servicio.cod_tipo_servicio IN (c_tipo_serv_datos)
                        OR es_servcio_esp_data(v_reg_servicio.cod_servicio) = c_verdadero THEN

                         --VPG--
                        po_cod_err    := 'PVT-5034'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe un PDPCP configurado para este servicio.
                        SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_plan, 'PDPCP', 'VPG_CNF')
                          INTO v_pdpcp_id
                        FROM DUAL;

                        po_cod_err    := 'PVT-5036'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe la Accion al PRV para el servicio.
                        SELECT tx_vpg_util.get_comando(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                          INTO v_id_comando
                        FROM DUAL;

                        po_cod_err    := 'PVT-5175'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe un PDPCP configurado para este servicio.
                        SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_plan, 'EPS_PROFILE_ID', 'VPG_CNF')
                          INTO v_eps_profile_id
                        FROM DUAL;

                        po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                        mt_vpg.alta_orden(
                                    pi_id_comando           => v_id_comando,
                                    pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                    pi_fch_programada       => pi_fch_tran,
                                    pi_cod_transaccion      => c_tipo_transaccion,
                                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                    pi_p2                   => v_pdpcp_id,
                                    pi_p3                   => CASE WHEN v_reg_servicio.cod_servicio IN ('DAT4G','APNDATA','APNDAT2') THEN v_reg_entidad_consumo.imsi ELSE pi_id_entidad_consumo END,
                                    pi_p4                   => v_eps_profile_id,
                                    pi_cod_usuario          => pi_cod_usuario,
                                    pi_master               => c_falso,
                                    pi_id_tran              => v_id_tran,
                                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                                    pi_fch_tran             => v_fch_tran,
                                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                    po_id_orden             => v_id_orden,
                                    po_id_tran              => v_id_tran,
                                    po_fch_tran             => v_fch_tran,
                                    po_cod_err              => po_cod_err,
                                    po_msj_err              => po_msj_err
                                    );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;

                    ELSE

                        po_cod_err    := 'PVT-5037'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe la Accion al PRV para el servicio.
                        SELECT tx_vpg_util.get_comando(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                          INTO v_id_comando
                        FROM DUAL;

                        po_cod_err    := 'PVT-5038'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                        mt_vpg.alta_orden(
                                    pi_id_comando           => v_id_comando,
                                    pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                    pi_fch_programada       => pi_fch_tran,
                                    pi_cod_transaccion      => c_tipo_transaccion,
                                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                    pi_p2                   => v_reg_entidad_consumo.imsi,
                                    pi_cod_usuario          => pi_cod_usuario,
                                    pi_master               => c_falso,
                                    pi_id_tran              => v_id_tran,
                                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                                    pi_fch_tran             => v_fch_tran,
                                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                    po_id_orden             => v_id_orden,
                                    po_id_tran              => v_id_tran,
                                    po_fch_tran             => v_fch_tran,
                                    po_cod_err              => po_cod_err,
                                    po_msj_err              => po_msj_err
                                    );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;


                    END IF;


                 ELSE


                    --VPG--
                    po_cod_err    := 'PVT-5039'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe la Accion al PRV para el servicio.
                    SELECT tx_vpg_util.get_comando(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                      INTO v_id_comando
                    FROM DUAL;

                    po_cod_err    := 'PVT-5040'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                END IF;
            ELSIF v_reg_servicio.cod_tipo_servicio IN ('TSPAIN') THEN

                po_cod_err    := 'PVT-6013'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.

                SELECT tx_vpg_util.get_comando('SET_OFFER', 'CCOPRE', 'SET')
                  INTO v_id_comando
                FROM DUAL;

                po_cod_err    := 'PVT-6014'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                SELECT *
                    INTO v_reg_periodo
                FROM tr_periodo_facturacion tr
                WHERE tr.cod_ciclo_facturacion = (SELECT cod_ciclo_facturacion
                                                    FROM cl_comunidad
                                                    WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante  )
                 AND tr.vigente = c_verdadero;

                    v_offer_id      :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE(v_reg_servicio.cod_Servicio,v_reg_entidad_consumo.COD_PLAN,'OFFER_ID','VPG_CNF');

                    po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => v_offer_id, -- OFFER ID   -- TODO: JA nos enviare los OFFER ID
                                pi_p4                   =>  'A',
                                pi_p5                   => TO_CHAR(SYSDATE,'YYYY-MM-DD'), --Fecha Vigencia
                                pi_p6                   => TO_CHAR(TRUNC(v_reg_periodo.periodo_fin + 3),'YYYY-MM-DD'), --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

            ELSIF v_reg_servicio.cod_tipo_servicio IN ('TSMIOF','TSMION','TSSMS') THEN

                po_cod_err    := 'PVT-6013'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                SELECT tx_vpg_util.get_comando('SET_OFFER_DA', 'CCOPRE', 'SET')
                  INTO v_id_comando
                FROM DUAL;

                po_cod_err    := 'PVT-6014'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                SELECT *
                    INTO v_reg_periodo
                FROM tr_periodo_facturacion tr
                WHERE tr.cod_ciclo_facturacion = (SELECT cod_ciclo_facturacion
                                                    FROM cl_comunidad
                                                    WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante  )
                 AND tr.vigente = c_verdadero;

                po_cod_err    := 'PVT-6015'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                v_da_id         :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE(v_reg_servicio.cod_Servicio,v_reg_entidad_consumo.COD_PLAN,'DA_ID','VPG_CNF');
                v_offer_id      :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE(v_reg_servicio.cod_Servicio,v_reg_entidad_consumo.COD_PLAN,'OFFER_ID','VPG_CNF');
                v_minutes_amt   :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE(v_reg_servicio.cod_Servicio,v_reg_entidad_consumo.COD_PLAN,'MINUTES_AMT','VPG_CNF');
                v_da_unit_type  :=  nvl(tx_vpg_util.GET_SERVICIO_PARAM_VALUE(v_reg_servicio.cod_Servicio,v_reg_entidad_consumo.COD_PLAN,'DA_UNIT_TYPE','VPG_CNF'),'1');

                --DA tipo money convertir formato
                IF v_da_unit_type = '1' THEN
                    v_minutes_amt := tx_vpg_util.number2cs(v_minutes_amt);
                END IF;

                po_cod_err    := 'PVT-6016'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => pi_id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => tx_air.GET_TRANSACTIONID,
                            pi_p3                   => tx_vpg_util.date2iso(v_fch_tran), -- fecha transaccion
                            pi_p4                   => v_da_id, -- da_id
                            pi_p5                   => v_minutes_amt, -- valor de ajuste
                            pi_p6                   => v_da_unit_type, -- da_unit_type_id
                            pi_p7                   => tx_vpg_util.date2iso(v_reg_periodo.periodo_fin + 2), -- Fecha fin
                            pi_p8                   => 'RECARGA DE MINUTOS', -- comentario 1
                            pi_p9                   => '0', -- comentario 2 - puede ser nulo
                            pi_p12                  => v_offer_id, -- offer id
                            pi_p13                  => tx_vpg_util.date2iso(v_fch_tran), --Fecha inicio
                            pi_p14                  => tx_vpg_util.date2iso(v_reg_periodo.periodo_fin + 2), -- Fecha fin
                            pi_p15                  => '2', -- Offer type, por defecto 2= timer
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                        );

                    IF po_cod_err != 'OK' THEN
                        RAISE err_app;
                    END IF;

            END IF;

        END IF;

         IF v_reg_entidad_consumo.cod_tecnologia = 'TV'
           AND v_reg_servicio.cod_tipo_servicio IN ('TSTVPQ', 'TSTVBA') THEN
                 BEGIN
                    SELECT   p2
                      INTO v_tipo_procedencia
                    FROM   vta_venta_servicio vs, vta_otros_servicios vos
                  WHERE  vs.id_entidad_consumo = pi_id_entidad_consumo
                     AND vs.id_prospecto = vos.id_prospecto
                     AND vs.estado = c_estado_activo;
                 EXCEPTION
                  WHEN OTHERS THEN
                      v_tipo_procedencia := 'VTPPVT';
                 END;

            IF v_tipo_procedencia NOT IN ('VTPDIF') THEN

                   SELECT cod_segmento
                     INTO v_cod_segmento
                   FROM v_plan_segmento
                   WHERE cod_plan = v_reg_entidad_consumo.cod_plan;

                   IF v_cod_segmento = 'TVCABLEPOS' THEN
                      IF pi_complemento IS NOT NULL THEN
                         v_tipo_procedencia := pi_complemento;
                      ELSE
                         v_tipo_procedencia := 'VTPPVT';
                      END IF;
                   END IF;

                  tx_prv_tv.provisionar_servicio(
                                                     pi_id_entidad_consumo => pi_id_entidad_consumo,
                                                     pi_cod_servicio => pi_cod_servicio,
                                                     pi_cod_action => 'ADD_PACK',
                                                     pi_cod_usuario => pi_cod_usuario,
                                                     pi_tipo_procedencia => v_tipo_procedencia,
                                                     pi_master => c_falso,
                                                     pi_id_tran => v_id_tran,
                                                     pi_cod_gestion_tran => v_cod_gestion_tran,
                                                     pi_fch_tran => v_fch_tran,
                                                     pi_cod_unidad_negocio => pi_cod_unidad_negocio,
                                                     po_cod_err => po_cod_err,
                                                     po_msj_err => po_msj_err
                                                );
                  IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                  END IF;

                  IF v_tipo_procedencia NOT IN ('VTPBON', 'VTPANI', 'VTPRET') THEN
                      po_cod_err := 'PVT-2631';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al invocar TX_PRM_BASE_TV.ALTA
                      v_resultado_bono := tx_prm_funcion.aplica_promo_tv_premium(
                                                            pi_cod_servicio         => pi_cod_servicio,
                                                            pi_cod_plan             => v_reg_entidad_consumo.cod_plan,
                                                            pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                                            pi_tipo_procedencia     => v_tipo_procedencia,
                                                            pi_id_externo           => v_id_registro,
                                                            pi_vigencia             => 30,
                                                            pi_cod_usuario          => pi_cod_usuario,
                                                            pi_id_tran              => v_id_tran,
                                                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                                                            pi_fch_tran             => v_fch_tran,
                                                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio
                                                          );

                   v_cod_observacion            := '4ACSE';
                   v_descripcion_observacion    := 'ASIGNACION DE SERVICIO AL SUSCRIPTOR';
                   po_cod_err := 'PVT-2632';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al determinar el id del cliente.
                   v_id_cliente                 :=
                                          get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

                   v_trama_nuevo_pv  :=  pi_cod_servicio
                                        || '|'
                                        || v_tipo_procedencia
                                        || '|'
                                        || v_id_registro
                                        || '|'
                                        || v_resultado_bono;

                    po_cod_err := 'PVT-2633';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al registrar datos de la Postventa.
                    cc_tx_transaccion_postventa.alta
                                          (pi_id_tran                     => v_id_tran,
                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                           pi_cod_tipo                    => 'TX_PVT_ASIGNA_PAQUETE_TV',
                                           pi_id_cliente                  => v_id_cliente,
                                           pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                           pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                           pi_cod_motivo_transaccion      => NULL,
                                           pi_cod_observacion             => v_cod_observacion,
                                           pi_descripcion_observacion     => v_descripcion_observacion,
                                           pi_valor_anterior              => v_trama_anterior_pv,
                                           pi_valor_nuevo                 => v_trama_nuevo_pv,
                                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                           pi_fch_tran                    => v_fch_tran,
                                           pi_cod_usuario                 => pi_cod_usuario,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

                    IF (po_cod_err <> 'OK') THEN
                        RAISE err_app;
                    END IF;
                END IF;
             END IF;
        END IF;

        --SI EL SERVICIO ES DE NUMEROS FAVORITOS ACTUALIZAR LOS NUMEROS FAVORITOS
        IF     v_reg_servicio.cod_tipo_servicio IN (c_tipo_serv_numfav, 'TSNFLN', 'TSNFUS',
                                                    'TSNFCE')
           AND LENGTH (REPLACE (pi_complemento, ',', '')) >= 10 THEN
            po_cod_err := 'PVT-2634';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al determinar el tipo de afinidad relacionado al servicio.

            SELECT parametro_1
              INTO v_cod_tipo_afinidad
              FROM cnf_configuracion_especial c
             WHERE c.nombre_tabla = 'BM_SERVICIO' AND c.cod_registro = pi_cod_servicio;

            po_cod_err := 'PVT-2635';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al invocar al procedimiento de asignacion de numeros afines.
            tx_pvt_entidad_consumo.actualizar_numero_afin
                                                    (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                     pi_cod_tipo_afinidad           => v_cod_tipo_afinidad,
                                                     pi_numeros_afines              => pi_complemento,
                                                     pi_descontar                   => c_falso,
                                                     pi_cod_usuario                 => pi_cod_usuario,
                                                     pi_master                      => c_falso,
                                                     pi_id_tran                     => v_id_tran,
                                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                     pi_fch_tran                    => v_fch_tran,
                                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                     po_id_tran                     => v_id_tran,
                                                     po_cod_gestion_tran            => v_cod_gestion_tran,
                                                     po_cod_err                     => po_cod_err,
                                                     po_msj_err                     => po_msj_err
                                                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

           IF v_cod_tipo_afinidad = 'TAFIL1' THEN

           v_numeros_afines := REPLACE (pi_complemento, ',', '');

            SELECT COUNT (1)
                      INTO v_dummy
                  FROM cl_entidad_consumo_afin
                 WHERE     cod_tipo_afinidad = v_cod_tipo_afinidad
                       AND identificador_entidad_afin = v_reg_entidad_consumo.identificador_entidad
                       AND cod_servicio = pi_cod_servicio
                       AND faf_id = 61
                       AND fch_fin > SYSDATE
                       AND estado = 'A';

                IF v_dummy =  0 THEN

                 BEGIN
                    SELECT *
                       INTO v_reg_entidad_consumo_faf
                       FROM cl_entidad_consumo ec
                      WHERE ec.identificador_entidad = v_numeros_afines
                      AND ec.estado NOT IN ('I', 'TER', 'POST');
                  EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                          RAISE err_app;
                  END;

                IF v_reg_entidad_consumo_faf.cod_plan = 'PREPAG_4G' THEN

                    cc_cl_servicio_entidad_consumo.asignar (pi_id_entidad_consumo          => v_reg_entidad_consumo_faf.id_entidad_consumo,
                                                            pi_cod_servicio                => pi_cod_servicio,
                                                            pi_cod_plan                    => NULL,
                                                            pi_precio                      => NULL,
                                                            pi_cod_moneda                  => NULL,
                                                            pi_cod_tipo_cobro              => NULL,
                                                            pi_es_facturable               => NULL,
                                                            pi_es_por_defecto              => NULL,
                                                            pi_id_proc_ems                 => NULL,
                                                            pi_id_orig_proc_ems            => NULL,
                                                            pi_id_form_ems                 => NULL,
                                                            pi_id_orig_form_ems            => NULL,
                                                            pi_cod_usuario                 => pi_cod_usuario,
                                                            pi_id_tran                     => v_id_tran,
                                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                            pi_fch_tran                    => v_fch_tran,
                                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                            pi_fch_efectiva_inicio         => v_fch_tran,
                                                            pi_fch_efectiva_fin            => c_fecha_fin,
                                                            po_id_registro                 => v_id_registro,
                                                            po_cod_err                     => po_cod_err,
                                                            po_msj_err                     => po_msj_err
                                                           );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                    tx_pvt_entidad_consumo.actualizar_numero_afin
                                                (pi_id_entidad_consumo          => v_reg_entidad_consumo_faf.id_entidad_consumo,
                                                 pi_cod_tipo_afinidad           => v_cod_tipo_afinidad,
                                                 pi_numeros_afines              => v_reg_entidad_consumo.identificador_entidad,
                                                 pi_descontar                   => c_falso,
                                                 pi_cod_usuario                 => pi_cod_usuario,
                                                 pi_master                      => c_falso,
                                                 pi_id_tran                     => v_id_tran,
                                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                 pi_fch_tran                    => v_fch_tran,
                                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                 po_id_tran                     => v_id_tran,
                                                 po_cod_gestion_tran            => v_cod_gestion_tran,
                                                 po_cod_err                     => po_cod_err,
                                                 po_msj_err                     => po_msj_err
                                                );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;
                    ELSE
                        po_cod_err := 'PVT-5208';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al determinar el id del cliente.
                        po_msj_err := 'No esta permido para este plan';
                        RAISE err_app;
                    END IF;
                END IF;
           END IF;

         END IF;

        --REGISTRO DE LA TRANSACCION POSTVENTA
        IF pi_master = c_verdadero AND pi_cod_servicio NOT IN ('NFVMCM','NFVIVM') THEN
            v_cod_observacion            := '4ACSE';
            v_descripcion_observacion    := 'ASIGNACION DE SERVICIO AL SUSCRIPTOR';
            po_cod_err := 'PVT-2636';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al determinar el id del cliente.
            v_id_cliente                 :=
                                          get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

            v_trama_nuevo_pv             :=    'Codigo:'
                                            || pi_cod_servicio
                                            || '|'
                                            || 'Descripcion:'
                                            || v_reg_servicio.descripcion
                                            || '|'
                                            || 'Favoritos:'
                                            || pi_complemento;
            --- Registrar transaccion
            po_cod_err := 'PVT-2637';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
            cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => v_cod_observacion,
                                   pi_descripcion_observacion     => v_descripcion_observacion,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        ELSIF pi_cod_servicio = 'NFVMCM' THEN
            v_cod_observacion            := '4ACSE';
            v_descripcion_observacion    := 'ASIGNACION DE SERVICIO MOCHILERO VMCP';
            po_cod_err := 'PVT-2638';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al determinar el id del cliente.
            v_id_cliente                 :=
                                          get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

            v_trama_nuevo_pv             :=    'Codigo:'
                                            || pi_cod_servicio
                                            || '|'
                                            || 'Descripcion:'
                                            || v_reg_servicio.descripcion
                                            || '|'
                                            || 'Favoritos:'
                                            || pi_complemento;
            --- Registrar transaccion
            po_cod_err := 'PVT-2639';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
            cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => 'TX_TRAN_SERVICIO_MOCHILERO',
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => v_cod_observacion,
                                   pi_descripcion_observacion     => v_descripcion_observacion,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        IF v_reg_servicio.cod_tipo_servicio = 'TSEXT' THEN

            IF v_reg_servicio.cod_servicio IN ('SUNDE', 'SUNEQ') THEN --CVE: para envio sms del servicio seguros unit al activarlo 16-06-2025.
                SELECT descipcion
                INTO v_sms_mensaje
                FROM omega.cnf_configuracion_especial
                WHERE nombre_tabla = 'MAIL_MENSAJE_DISPATCHER'
                AND tipo = 'TEXT_UNIT_ACTIVO'
                AND cod_registro = 'NOTACTUNIT'
                AND parametro_1 = v_reg_servicio.cod_servicio;
            ELSIF v_reg_servicio.cod_servicio = 'SAMBU' THEN --CVE: para envio sms del servicio aeroambulancia al activarlo 10-04-2025.
                SELECT descipcion
                INTO v_sms_mensaje
                FROM omega.cnf_configuracion_especial
                WHERE nombre_tabla = 'MAIL_MENSAJE_DISPATCHER'
                AND tipo = 'TEXT_SAMBU_ACTIVO'
                AND cod_registro = 'NOTACTSAMBU'
                AND parametro_1 = v_reg_servicio.cod_servicio;
            ELSE
                SELECT descipcion
                INTO v_sms_mensaje
                FROM omega.cnf_configuracion_especial
                WHERE nombre_tabla = 'MAIL_MENSAJE_DISPATCHER'
                AND tipo = 'TEXT_ASIS_VV_PLAN'
                AND cod_registro = 'NOTFASISVV'
                AND parametro_1 = v_reg_servicio.cod_servicio;
            END IF;

            SELECT ( pns.precio *
                ( SELECT SUM(bli.valor_porcentual) / 100
                FROM bl_impuesto bli, bl_cargo_impuesto bci
                WHERE bci.id_cargo_impuesto = v_reg_servicio.id_cargo
                AND bli.cod_impuesto = bci.cod_impuesto) + pns.precio )
              INTO v_precio
              FROM bm_plan_servicio pns
             WHERE cod_plan = v_reg_entidad_consumo.cod_plan
               AND cod_servicio = pi_cod_servicio
               AND fch_fin = c_fecha_fin
               AND estado <> c_estado_inactivo;

            v_sms_mensaje := SUBSTR( REPLACE(v_sms_mensaje, '{monto}', ROUND(v_precio) ), 0, 158) ; --monto

            --po_cod_err := 'PVT-6097'; --TX_CL_SUSCRIPCION_SERVICIO.ALTA: no se pudo enviar el sms
            --Enviar SMS
            tx_sms.alta (pi_origen                      => 'VIVA',
                         pi_destino                     => v_reg_entidad_consumo.identificador_entidad,
                         pi_texto                       => v_sms_mensaje,
                         pi_prioridad                   => 1,
                         pi_programado                  => v_fch_tran,
                         pi_id_tran                     => v_id_tran,
                         pi_fch_tran                    => v_fch_tran,
                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                         pi_cod_usuario                 => pi_cod_usuario,
                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                         pi_master                      => c_falso,
                         po_id_sms                      => v_id_mensaje,
                         po_cod_err                     => po_cod_err,
                         po_msj_err                     => po_msj_err);

                IF po_cod_err != 'OK' THEN
                    RAISE err_app;
                END IF;

        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
         WHEN err_servicio THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    := NULL;
            -- Registro de log
            tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                                 pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 pi_nombre_tabla                => v_nombre_tabla,
                                 pi_pk_registro                 => v_pk_registro,
                                 pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_trama_in                    => v_trama_in,
                                 pi_trama_out                   => v_trama_out,
                                 pi_cod_err                     => po_cod_err,
                                 pi_msj_err                     => po_msj_err,
                                 pi_log_file                    => v_reg_entidad.log_file,
                                 pi_log_tabla                   => v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE asignar_zona_full_hogar (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_servicio           IN       cl_servicio_entidad_consumo.cod_servicio%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                          := tx_cnf_constante.get_constante ('TRANSACCION_ASIGNAR_ZONA_FULL_HOGAR');
        c_max_zona_primer_anio CONSTANT VARCHAR2 (50)
                              := tx_cnf_constante.get_constante ('MAXIMO_ZONIFICACION_PRIMER_ANIO');
        c_zona_gratuitas     CONSTANT VARCHAR2 (50)
                                     := tx_cnf_constante.get_constante ('ZONIFICACIONES_GRATUITAS');
        c_cargo_transferencia CONSTANT VARCHAR2 (50)
                                := tx_cnf_constante.get_constante ('CARGO_TRANSFERENCIA_LOCALIDAD');
        c_exc_traslado_fijo  CONSTANT VARCHAR2 (50)
                                 := tx_cnf_constante.get_constante ('TIPO_EXCEPCION_TRASLADO_FIJO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.ASIGNAR_ZONA_FULL_HOGAR';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_SERVICIO_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_registro                 cl_servicio_entidad_consumo.id_registro%TYPE;
        v_dummy                       PLS_INTEGER := 0;
        v_descripcion_servicio        bm_servicio.descripcion%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_cod_tipo_servicio           bm_servicio.cod_tipo_servicio%TYPE;
        v_cod_servicio_actual         cl_servicio_entidad_consumo.cod_servicio%TYPE;
        v_cod_grupo_plan              bm_grupo_plan.cod_grupo_plan%TYPE;
        v_permiso                     VARCHAR2 (10);
        v_zonificaciones              PLS_INTEGER;
        v_cobro                       PLS_INTEGER := 0;
        v_balance                     NUMBER (15, 2);
        v_fch_vigencia                DATE;
        v_tipo_bolsillo               PLS_INTEGER;
        v_id_accion                   bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_cod_zona_prv                cnf_configuracion_especial.parametro_2%TYPE;
        v_excepcion                   PLS_INTEGER;
        v_cod_segmento                VARCHAR2(50);
        v_asignar_cargo               VARCHAR2(2):=c_falso;
        v_es_diferido                 VARCHAR2(2);
        v_cod_tipo_documento          VARCHAR2(100):= tx_cnf_constante.get_constante ('CNF_DOCUMENTO_ZONIFICACION');
        v_id_cargo                    NUMBER:= TO_NUMBER(tx_cnf_constante.get_constante ('ID_CARGO_ZONIFICACION'));
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_es_cambio_tecnologia        PLS_INTEGER;
        v_bolsillo_ecms               tx_ecms.type_ecms_bolsilos;
        v_cod_enlace                  VARCHAR2(50);
        v_id_comando                  NUMBER;
        v_id_orden                    NUMBER;
        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                 :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_servicio:'
            || pi_cod_servicio
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_servicio IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2640';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2641';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2642';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                 := v_id_tran;
        po_cod_gestion_tran        := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
          SELECT COUNT(1)
            INTO v_es_cambio_tecnologia
          FROM vta_cambio_tecnologia
         WHERE id_entidad_consumo = pi_id_entidad_consumo
           AND estado <> c_estado_inactivo
           AND fch_fin = c_fecha_fin;

        --EL SUSCRIPTOR NO DEBE TENER NINGUNA SUSPENSION NI DESCONEXION
        IF suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero AND v_es_cambio_tecnologia = 0 THEN
            po_cod_err := 'PVT-2643';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --EL SUSCRIPTOR NO DEBE ESTAR TERMINADO
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --SOLO SE APLICA AL GRUPO DE PLAN FULL CASA
        po_cod_err := 'PVT-2644';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error al determinar el grupo de plan del suscriptor.

        SELECT cod_segmento, cod_grupo_plan
          INTO v_cod_segmento, v_cod_grupo_plan
          FROM v_plan_segmento p
         WHERE p.cod_plan = v_reg_entidad_consumo.cod_plan;

        SELECT COUNT (1)
          INTO v_dummy
          FROM cnf_configuracion_especial c
         WHERE c.nombre_tabla = 'BM_GRUPO_PLAN'
           AND c.tipo = 'GRUPO_PLAN_ZONIFICADOS'
           AND v_cod_grupo_plan IN (SELECT valor
                                      FROM TABLE (tx_utiles.SPLIT (c.parametro_1)));

        IF v_dummy = 0 THEN
            po_cod_err := 'PVT-2645';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: El grupo de plan del suscriptor no es Full Hogar.
            RAISE err_app;
        END IF;

        BEGIN
            --EL SERVICIO DEBE SER DE TIPO ZONIFICACION FULLCASA
            -- y de una zona correspondiente a la tecnologia del usuario
            po_cod_err := 'PVT-2646';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error al validar la zona.

            SELECT NVL (ce.parametro_2, SUBSTR (s.cod_servicio, 2))
              INTO v_cod_zona_prv
              FROM bm_servicio s LEFT JOIN cnf_configuracion_especial ce
                   ON ce.nombre_tabla = 'BM_SERVICIO'
                 AND ce.tipo = 'ZONIFICACION_FIJA'
                 AND ce.cod_registro = s.cod_servicio
             WHERE s.cod_servicio = pi_cod_servicio
               AND s.cod_tipo_servicio = c_tipo_serv_fullhogar
               AND NVL (ce.parametro_1, 'CDMA') = v_reg_entidad_consumo.cod_tecnologia;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                po_cod_err := 'PVT-2647';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error, no es una zona valida.
                RAISE err_app;
        END;

        --VERIFICACION PRIVILEGIOS PARA ZONIFICACION 1
        IF pi_master = c_verdadero AND pi_cod_servicio = c_servicio_zona_1 THEN
            tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                       pi_cod_entidad                 => 'ESP_RESETEAR_ZONA_FULL_HOGAR',
                                       pi_cod_usuario_tran            => pi_cod_usuario,
                                       po_permiso                     => v_permiso,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            IF v_permiso = c_falso THEN
                po_cod_err := 'PVT-2648';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Usted no tiene permiso para resetear la zona del suscriptor full hogar.
                RAISE err_app;
            END IF;
        END IF;

        -- el permiso no se verifica si se llama desde otra transaccion (cambio tecnologia)
        IF pi_master = c_verdadero THEN
            --VERIFICACION PERMISOS PARA REALIZAR MAS DE UN CAMBIO DE ZONIFICACION
            po_cod_err := 'PVT-2649';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Error al determinar la cantidad de asignaciones de zona fullcasa.

            SELECT COUNT (*)
              INTO v_dummy
              FROM cl_servicio_entidad_consumo sec, bm_servicio s
             WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
               AND sec.cod_servicio = s.cod_servicio
               AND s.cod_tipo_servicio = c_tipo_serv_fullhogar
               AND s.estado <> c_estado_inactivo
               AND sec.cod_servicio NOT IN ('X175', c_servicio_zona_1);

            IF v_dummy > 0 THEN
                tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                           pi_cod_entidad                 => 'ESP_MULTIPLE_ASIG_ZONA_FH',
                                           pi_cod_usuario_tran            => pi_cod_usuario,
                                           po_permiso                     => v_permiso,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;

                IF v_permiso = c_falso THEN
                    po_cod_err := 'PVT-2650';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO: Usted no tiene permiso para realizar multiples zonificaciones para full casa.
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        BEGIN
            po_cod_err := 'PVT-2651';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error al validar la zona actual de la entidad de consumo.

            SELECT sec.cod_servicio
              INTO v_cod_servicio_actual
              FROM cl_servicio_entidad_consumo sec, bm_servicio s
             WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
               AND sec.cod_servicio = s.cod_servicio
               AND s.cod_tipo_servicio = c_tipo_serv_fullhogar
               AND sec.fch_fin = c_fecha_fin
               AND sec.estado <> c_estado_inactivo;

            --LA NUEVA ZONA DEBE SER DISTINTA A LA ACTUAL
            IF v_cod_servicio_actual = pi_cod_servicio THEN
                po_cod_err := 'PVT-2652';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: La zona de la entidad de consumo es la misma.
                RAISE err_app;
            ELSE
                v_dummy    := 1;
            END IF;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_dummy    := 0;
        END;

        -- el cobro no se efectua si se llama desde otra transaccion (cambio tecnologia)
        IF pi_master = c_verdadero THEN
            /*Cobro por transferencia de localidad fuera de la cantidad gratuita*/
            -- Tiene excepciones
            SELECT COUNT (1)
              INTO v_excepcion
              FROM vta_excepcion
             WHERE cod_tipo_excepcion = c_exc_traslado_fijo
               AND id_entidad_consumo = pi_id_entidad_consumo
               AND estado = c_estado_activo
               AND fch_fin = c_fecha_fin
               AND fch_inicio >= TRUNC (v_fch_tran - 2);

            IF v_excepcion = c_falso THEN
                IF TRUNC (v_fch_tran) BETWEEN TRUNC (v_reg_entidad_consumo.fch_creacion)
                                          AND TRUNC
                                                   (ADD_MONTHS (v_reg_entidad_consumo.fch_creacion,
                                                                12)) THEN
                    --determinar cantidad de zonificaciones realizadas, primer a?o
                    SELECT COUNT (1)
                      INTO v_zonificaciones
                      FROM cl_servicio_entidad_consumo sec, bm_servicio s, cl_entidad_consumo ec
                     WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                       AND sec.cod_servicio = s.cod_servicio
                       AND s.cod_tipo_servicio = c_tipo_serv_fullhogar
                       AND sec.id_entidad_consumo = ec.id_entidad_consumo
                       AND ec.estado NOT IN (c_estado_inactivo, c_estado_terminado)
                       AND TRUNC (sec.fch_inicio) BETWEEN TRUNC (ec.fch_creacion)
                                                      AND TRUNC (ADD_MONTHS (ec.fch_creacion, 12));

                    IF v_zonificaciones >= c_max_zona_primer_anio THEN
                        v_cobro    := 1;
                    END IF;
                ELSE
                    --determinar cantidad de zonificaciones realizadas, fuera del primer a?o
                    SELECT COUNT (1)
                      INTO v_zonificaciones
                      FROM cl_servicio_entidad_consumo sec, bm_servicio s, cl_entidad_consumo ec
                     WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                       AND sec.cod_servicio = s.cod_servicio
                       AND s.cod_tipo_servicio = c_tipo_serv_fullhogar
                       AND sec.id_entidad_consumo = ec.id_entidad_consumo
                       AND ec.estado NOT IN (c_estado_inactivo, c_estado_terminado)
                       AND TRUNC (sec.fch_inicio) > TRUNC (ADD_MONTHS (ec.fch_creacion, 12));

                    IF v_zonificaciones >= c_zona_gratuitas THEN
                        v_cobro    := 1;
                    END IF;
                END IF;

                --verificar si tiene balance suficiente
                IF v_cobro = 1 AND v_cod_segmento IN ('CASPRE','CASFULL','CASNEGHP') THEN
                    IF v_cod_segmento IN  ('CASPRE') THEN
                        v_tipo_bolsillo    := tx_ecms.c_bal_promotional_balance_1;
                        po_cod_err := 'PVT-2653';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: error al obtener el balance.
                        tx_ecms.get_datos_balance (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                                   pi_balance_id                  => v_tipo_bolsillo,
                                                   po_monto                       => v_balance,
                                                   po_fecha                       => v_fch_vigencia,
                                                   po_cod_err                     => po_cod_err,
                                                   po_msj_err                     => po_msj_err
                                                  );
                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;

                    ELSIF v_cod_segmento IN ('CASFULL','CASNEGHP') THEN --PARA COBRAR DEL CORE
                        v_balance   := 0;
                    END IF;

                    IF v_balance < c_cargo_transferencia THEN
                        v_tipo_bolsillo    := tx_ecms.c_bal_core_balance;
                        po_cod_err := 'PVT-2655';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: error al obtener el balance.
                        tx_ecms.get_datos_balance (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                                   pi_balance_id                  => v_tipo_bolsillo,
                                                   po_monto                       => v_balance,
                                                   po_fecha                       => v_fch_vigencia,
                                                   po_cod_err                     => po_cod_err,
                                                   po_msj_err                     => po_msj_err
                                                  );
                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;

                        IF v_balance < c_cargo_transferencia THEN
                            po_cod_err := 'PVT-2657';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: balance insuficiente. Favor realizar una recarga y reintentar.
                            RAISE err_app;
                        ELSE
                            v_cobro    := 2;
                        END IF;
                    ELSE
                        v_cobro    := 2;
                    END IF;

                    --aplicar el cobro
                    IF v_cobro = 2 THEN
                        po_cod_err := 'PVT-2658';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: error al obtener la accion a realizar.


                        IF v_tipo_bolsillo <> tx_ecms.c_bal_core_balance THEN
                            v_cod_enlace    :=  'SET_DA_BALANCE_SINEXP';
                        ELSE
                            v_cod_enlace    :=  'AIR_SET_BALANCE_MA';
                        END IF;

                        SELECT tx_vpg_util.get_comando(v_cod_enlace, v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                          INTO v_id_comando
                          FROM DUAL;

                        v_bolsillo_ecms := tx_ecms.get_info_bolsillo(v_tipo_bolsillo);

                        po_cod_err    := 'PVT-5087';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al dar de alta la orden en el PRV.
                        mt_vpg.alta_orden(
                                pi_id_comando               => v_id_comando,
                                pi_id_entidad_consumo       => pi_id_entidad_consumo,
                                pi_cod_transaccion          => c_tipo_transaccion,
                                pi_p1                       => tx_vpg_util.pcs2cs(pi_id_entidad_consumo),
                                pi_p2                       => tx_air.get_transactionID,
                                pi_p3                       => tx_vpg_util.date2iso(v_fch_tran),
                                pi_p4                       => v_bolsillo_ecms.cod_bolsillo_c1, --ID Bolsillo, solo para DA
                                pi_p5                       => tx_vpg_util.number2cs(c_cargo_transferencia*-1),
                                pi_p6                       => v_bolsillo_ecms.cod_unidad_medida_air, -- TIpo de bolsillo, solo para DA
                                pi_p7                       => NULL, --Fecha de expiracion, solo para DA
                                pi_p8                       => 'TRANSFERENCIA DE LOCALIDAD',
                                pi_cod_usuario              => pi_cod_usuario,
                                pi_master                   => '0',
                                pi_id_tran                  => v_id_tran,
                                pi_cod_gestion_tran         => v_cod_gestion_tran,
                                pi_fch_tran                 => v_fch_tran,
                                pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                                po_id_orden                 => v_id_orden,
                                po_id_tran                  => v_id_tran,
                                po_fch_tran                 => v_fch_tran,
                                po_cod_err                  => po_cod_err,
                                po_msj_err                  => po_msj_err);

                        IF (po_cod_err != 'OK') THEN
                            RAISE err_app;
                        END IF;

                    END IF;
                ELSIF v_cobro = 1 AND v_cod_segmento IN ('CASHIBPRE') THEN
                    v_es_diferido := c_falso;
                    v_asignar_cargo := c_verdadero;
                ELSIF  v_cobro = 1 AND v_cod_segmento IN ('CASPOS') THEN
                    v_es_diferido := c_verdadero;
                    v_asignar_cargo := c_verdadero;
                END IF;

                IF v_asignar_cargo = c_verdadero THEN

                    po_cod_err := 'PVT-2660';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error al obtener id cliente para asignar cargo al cliente.
                    v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

                    po_cod_err := 'PVT-2661';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error al invocar procedimiento para asignar cargo en la zonificacion.
                    tx_pvt_ccs.asignar_cargo (pi_id_cliente                  => v_id_cliente,
                                              pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                              pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                              pi_cod_local                   => NULL,
                                              pi_cod_tipo_documento          => v_cod_tipo_documento,
                                              pi_id_cargo                    => v_id_cargo,
                                              pi_monto                       => TO_NUMBER(c_cargo_transferencia)/gettaxfactor('DRS'),
                                              pi_monto_antes_imp             => c_verdadero,
                                              pi_cod_tipo_venta              => 'TV_SERVICIOS_ZONIFICACION',
                                              pi_es_diferido                 => v_es_diferido,
                                              pi_cod_usuario                 => pi_cod_usuario,
                                              pi_master                      => c_falso,
                                              pi_id_tran                     => v_id_tran,
                                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                                              pi_fch_tran                    => v_fch_tran,
                                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                              po_id_documento                => v_id_venta,
                                              po_id_tran                     => v_id_tran,
                                              po_cod_gestion_tran            => v_cod_gestion_tran,
                                              po_cod_err                     => po_cod_err,
                                              po_msj_err                     => po_msj_err
                                             );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    po_cod_err := 'PVT-2662';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error al crear prospecto del servicio.
                    cc_vta_otros_servicios.alta (pi_id_prospecto            => v_id_venta,
                                                 pi_id_prospecto_ec         => v_id_venta,
                                                 pi_id_servicio             => pi_cod_servicio,
                                                 pi_1                       => NULL,
                                                 pi_2                       => NULL,
                                                 pi_3                       => NULL,
                                                 pi_4                       => NULL,
                                                 pi_5                       => NULL,
                                                 pi_6                       => NULL,
                                                 pi_7                       => NULL,
                                                 pi_8                       => NULL,
                                                 pi_9                       => NULL,
                                                 pi_10                      => NULL,
                                                 pi_cod_usuario             => pi_cod_usuario,
                                                 pi_id_tran                 => v_id_tran,
                                                 pi_cod_gestion_tran        => v_cod_gestion_tran,
                                                 pi_fch_tran                => v_fch_tran,
                                                 pi_cod_unidad_negocio      => pi_cod_unidad_negocio,
                                                 po_cod_err                 => po_cod_err,
                                                 po_msj_err                 => po_msj_err
                                                );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
           END IF;
       END IF;

       IF v_excepcion = c_verdadero
          OR v_es_diferido = c_verdadero
          OR (v_cobro = 2 AND v_cod_segmento IN ('CASPRE','CASFULL','CASNEGHP'))
          OR v_cobro = c_falso
          OR pi_master = c_falso THEN    -- si pi_master = 0 asignar el servicio

            po_cod_err := 'PVT-2663';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error al invocar procedimiento para asignar servicio de zonificacion.
            asignar_servicio_zona (pi_id_entidad_consumo    => pi_id_entidad_consumo,
                                   pi_cod_servicio          => pi_cod_servicio,
                                   pi_cod_usuario           => pi_cod_usuario,
                                   pi_master                => c_falso,
                                   pi_id_tran               => v_id_tran,
                                   pi_cod_gestion_tran      => v_cod_gestion_tran,
                                   pi_fch_tran              => v_fch_tran,
                                   pi_cod_unidad_negocio    => pi_cod_unidad_negocio,
                                   po_id_tran               => po_id_tran,
                                   po_cod_gestion_tran      => po_cod_gestion_tran,
                                   po_cod_err               => po_cod_err,
                                   po_msj_err               => po_msj_err
                                  );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
       END IF;

       po_cod_err := 'PVT-2664';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al obtener el id del cliente.
       v_id_cliente        := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

       IF v_cod_servicio_actual IS NOT NULL THEN
            po_cod_err := 'PVT-2665';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al recuperar la descripcion del servicio actual.

            SELECT b.descripcion
              INTO v_descripcion_servicio
              FROM bm_servicio b
             WHERE b.cod_servicio = v_cod_servicio_actual;

            v_trama_anterior_pv    :=    'Codigo:'
                                      || v_cod_servicio_actual
                                      || '|'
                                      || 'Descripcion:'
                                      || v_descripcion_servicio;
        END IF;

        po_cod_err := 'PVT-2666';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al recuperar la descripcion del servicio.

        SELECT b.descripcion
          INTO v_descripcion_servicio
          FROM bm_servicio b
         WHERE b.cod_servicio = pi_cod_servicio;

        v_trama_nuevo_pv    :=    'Codigo:'
                               || pi_cod_servicio
                               || '|'
                               || 'Descripcion:'
                               || v_descripcion_servicio;
        --- Registrar transaccion
        po_cod_err := 'PVT-2667';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
        cc_tx_transaccion_postventa.alta
                              (pi_id_tran                     => v_id_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_cod_tipo                    => c_tipo_transaccion,
                               pi_id_cliente                  => v_id_cliente,
                               pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                               pi_id_entidad_consumo          => pi_id_entidad_consumo,
                               pi_cod_motivo_transaccion      => NULL,
                               pi_cod_observacion             => NULL,
                               pi_descripcion_observacion     => NULL,
                               pi_valor_anterior              => v_trama_anterior_pv,
                               pi_valor_nuevo                 => v_trama_nuevo_pv,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_usuario                 => pi_cod_usuario,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                 := 'OK';
        po_msj_err                 := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;


    PROCEDURE asignar_servicio_zona (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_servicio           IN       cl_servicio_entidad_consumo.cod_servicio%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                          := tx_cnf_constante.get_constante ('TRANSACCION_ASIGNAR_ZONA_FULL_HOGAR');
        c_max_zona_primer_anio CONSTANT VARCHAR2 (50)
                              := tx_cnf_constante.get_constante ('MAXIMO_ZONIFICACION_PRIMER_ANIO');
        c_zona_gratuitas     CONSTANT VARCHAR2 (50)
                                     := tx_cnf_constante.get_constante ('ZONIFICACIONES_GRATUITAS');
        c_cargo_transferencia CONSTANT VARCHAR2 (50)
                                := tx_cnf_constante.get_constante ('CARGO_TRANSFERENCIA_LOCALIDAD');
        c_exc_traslado_fijo  CONSTANT VARCHAR2 (50)
                                 := tx_cnf_constante.get_constante ('TIPO_EXCEPCION_TRASLADO_FIJO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.ASIGNAR_ZONA_FULL_HOGAR';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_SERVICIO_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_registro                 cl_servicio_entidad_consumo.id_registro%TYPE;
        v_dummy                       PLS_INTEGER := 0;
        v_descripcion_servicio        bm_servicio.descripcion%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_cod_tipo_servicio           bm_servicio.cod_tipo_servicio%TYPE;
        v_cod_servicio_actual         cl_servicio_entidad_consumo.cod_servicio%TYPE;
        v_cod_grupo_plan              bm_grupo_plan.cod_grupo_plan%TYPE;
        v_permiso                     VARCHAR2 (10);
        v_zonificaciones              PLS_INTEGER;
        v_cobro                       PLS_INTEGER := 0;
        v_balance                     NUMBER (15, 2);
        v_fch_vigencia                DATE;
        v_tipo_bolsillo               PLS_INTEGER;
        v_id_accion                   bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_cod_zona_prv                cnf_configuracion_especial.parametro_2%TYPE;
        v_excepcion                   PLS_INTEGER;
        v_cod_segmento                VARCHAR2(50);
        v_es_cambio_tecnologia        PLS_INTEGER;

        v_id_orden_vpg                vpg_orden.id_orden%TYPE;
        v_id_tran_vpg                 vpg_orden.id_tran%TYPE;
        v_fch_tran_vpg                vpg_orden.fch_tran%TYPE;
        v_id_comando_vpg              vpg_cnf_comando.id_comando%TYPE;
        v_msisdn                      VARCHAR2(25);
        v_offer_plan                  bm_plan_param.valor%TYPE;
        v_group_ids                   cnf_configuracion_especial.parametro_3%TYPE:=NULL;
        v_group_id1                   cnf_configuracion_especial.parametro_3%TYPE:=NULL;
        v_group_id2                   cnf_configuracion_especial.parametro_3%TYPE:=NULL;
        v_group_id3                   cnf_configuracion_especial.parametro_3%TYPE:=NULL;

        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                 :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_servicio:'
            || pi_cod_servicio
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_servicio IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2668';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2669';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2670';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                 := v_id_tran;
        po_cod_gestion_tran        := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------

         SELECT COUNT(1)
            INTO v_es_cambio_tecnologia
          FROM vta_cambio_tecnologia
         WHERE id_entidad_consumo = pi_id_entidad_consumo
           AND estado <> c_estado_inactivo
           AND fch_fin = c_fecha_fin;

        --EL SUSCRIPTOR NO DEBE TENER NINGUNA SUSPENSION NI DESCONEXION
        IF suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero AND v_es_cambio_tecnologia = 0 THEN
            po_cod_err := 'PVT-2671';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --EL SUSCRIPTOR NO DEBE ESTAR TERMINADO
        po_cod_err := 'PVT-2672';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al obtener los datos del cliente.
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --VERIFICACION PRIVILEGIOS PARA ZONIFICACION 1
        IF pi_master = c_verdadero AND pi_cod_servicio = c_servicio_zona_1 THEN
            tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                       pi_cod_entidad                 => 'ESP_RESETEAR_ZONA_FULL_HOGAR',
                                       pi_cod_usuario_tran            => pi_cod_usuario,
                                       po_permiso                     => v_permiso,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            IF v_permiso = c_falso THEN
                po_cod_err := 'PVT-2673';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Usted no tiene permiso para resetear la zona del suscriptor full hogar.
                RAISE err_app;
            END IF;
        END IF;

        -- el permiso no se verifica si se llama desde otra transaccion (cambio tecnologia)
        IF pi_master = c_verdadero THEN
            --VERIFICACION PERMISOS PARA REALIZAR MAS DE UN CAMBIO DE ZONIFICACION
            po_cod_err := 'PVT-2674';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al determinar la cantidad de asignaciones de zona fullcasa.

            SELECT COUNT (*)
              INTO v_dummy
              FROM cl_servicio_entidad_consumo sec, bm_servicio s
             WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
               AND sec.cod_servicio = s.cod_servicio
               AND s.cod_tipo_servicio = c_tipo_serv_fullhogar
               AND s.estado <> c_estado_inactivo
               AND sec.cod_servicio NOT IN ('X175', c_servicio_zona_1);

            IF v_dummy > 0 THEN
                tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                           pi_cod_entidad                 => 'ESP_MULTIPLE_ASIG_ZONA_FH',
                                           pi_cod_usuario_tran            => pi_cod_usuario,
                                           po_permiso                     => v_permiso,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;

                IF v_permiso = c_falso THEN
                    po_cod_err := 'PVT-2675';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Usted no tiene permiso para realizar multiples zonificaciones para full casa.
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        BEGIN
            po_cod_err := 'PVT-2676';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al validar la zona actual de la entidad de consumo.

            SELECT sec.cod_servicio
              INTO v_cod_servicio_actual
              FROM cl_servicio_entidad_consumo sec, bm_servicio s
             WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
               AND sec.cod_servicio = s.cod_servicio
               AND s.cod_tipo_servicio = c_tipo_serv_fullhogar
               AND sec.fch_fin = c_fecha_fin
               AND sec.estado <> c_estado_inactivo;

            --LA NUEVA ZONA DEBE SER DISTINTA A LA ACTUAL
            IF v_cod_servicio_actual = pi_cod_servicio THEN
                po_cod_err := 'PVT-2677';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: La zona de la entidad de consumo es la misma.
                RAISE err_app;
            ELSE
                v_dummy    := 1;
            END IF;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_dummy    := 0;
        END;

        BEGIN
            --EL SERVICIO DEBE SER DE TIPO ZONIFICACION FULLCASA
            -- y de una zona correspondiente a la tecnologia del usuario
            po_cod_err := 'PVT-2678';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error al validar la zona.

            SELECT NVL (ce.parametro_2, SUBSTR (s.cod_servicio, 2)), ce.parametro_3
              INTO v_cod_zona_prv, v_group_ids
              FROM bm_servicio s LEFT JOIN cnf_configuracion_especial ce
                   ON ce.nombre_tabla = 'BM_SERVICIO'
                 AND ce.tipo = 'ZONIFICACION_FIJA'
                 AND ce.cod_registro = s.cod_servicio
             WHERE s.cod_servicio = pi_cod_servicio
               AND s.cod_tipo_servicio = c_tipo_serv_fullhogar
               AND NVL (ce.parametro_1, 'CDMA') = v_reg_entidad_consumo.cod_tecnologia;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                po_cod_err := 'PVT-2679';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_ZONA_FULL_HOGAR: Error, no es una zona valida.
                RAISE err_app;
        END;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2680';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al invocar a CC_CL_SERVICIO_ENTIDAD_CONSUMO.ASIGNAR.
            cc_cl_servicio_entidad_consumo.desasignar (pi_id_entidad_consumo,
                                                       v_cod_servicio_actual,
                                                       pi_cod_usuario,
                                                       v_id_tran,
                                                       v_cod_gestion_tran,
                                                       v_fch_tran,
                                                       pi_cod_unidad_negocio,
                                                       v_fch_tran,
                                                       po_cod_err,
                                                       po_msj_err
                                                      );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- Tiene excepciones
        SELECT COUNT (1)
          INTO v_excepcion
          FROM vta_excepcion
         WHERE cod_tipo_excepcion = c_exc_traslado_fijo
           AND id_entidad_consumo = pi_id_entidad_consumo
           AND estado = c_estado_activo
           AND fch_fin = c_fecha_fin
           AND fch_inicio >= TRUNC (v_fch_tran - 2);


        IF v_excepcion > 0 THEN
            po_cod_err := 'PVT-2681';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: error al dar de baja a la excepcion.
            cc_vta_excepcion.baja
                             (pi_cod_tipo_excepcion          => c_exc_traslado_fijo,
                              pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                              pi_id_entidad_consumo          => pi_id_entidad_consumo,
                              pi_nro_documento               => NULL,
                              pi_cod_tipo_doc                => NULL,
                              pi_monto_deposito              => NULL,
                              pi_id_prospecto                => NULL,
                              pi_cod_articulo                => NULL,
                              pi_cod_usuario                 => pi_cod_usuario,
                              pi_master                      => c_falso,
                              pi_id_tran                     => v_id_tran,
                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                              pi_fch_tran                    => v_fch_tran,
                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                              po_cod_err                     => po_cod_err,
                              po_msj_err                     => po_msj_err
                             );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;   -- pi_master = c_verdadero

        --ASIGNACION DE LA ZONA
        po_cod_err := 'PVT-2682';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al invocar a CC_CL_SERVICIO_ENTIDAD_CONSUMO.ASIGNAR.
        cc_cl_servicio_entidad_consumo.asignar (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                pi_cod_servicio                => pi_cod_servicio,
                                                pi_cod_plan                    => NULL,
                                                pi_precio                      => NULL,
                                                pi_cod_moneda                  => NULL,
                                                pi_cod_tipo_cobro              => NULL,
                                                pi_es_facturable               => NULL,
                                                pi_es_por_defecto              => NULL,
                                                pi_id_proc_ems                 => NULL,
                                                pi_id_orig_proc_ems            => NULL,
                                                pi_id_form_ems                 => NULL,
                                                pi_id_orig_form_ems            => NULL,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                pi_fch_efectiva_inicio         => v_fch_tran,
                                                pi_fch_efectiva_fin            => c_fecha_fin,
                                                po_id_registro                 => v_id_registro,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        IF (tx_cnf_constante.get_constante('ERS_ZONIFICACION') IN ('1','2')) THEN
            -- Obtener comando del PRV2 y validar que group_id no sea nulo
            po_cod_err := 'PVT-2683';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al recuperar la accion para el PRV a invocar (asignacion).
            v_id_comando_vpg := tx_vpg_util.get_comando(
                                pi_cod_enlace       => c_tipo_transaccion, --TX_TRAN_ASIGNAR_ZONA_FULL_HOGAR
                                pi_cod_forma_consumo=> v_reg_entidad_consumo.cod_forma_consumo,
                                pi_cod_operacion    => 'SET' --c_tipo_operacion_add
                                );
            IF v_id_comando_vpg IS NULL OR v_group_ids IS NULL THEN
                po_cod_err := 'PVT-2683';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al recuperar la accion para el PRV a invocar (asignacion).
                RAISE err_app;
            END IF;

            --Obtener msisdn para crear la orden
            v_msisdn := tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad);

            --Obtener el OfferId
            v_offer_plan := tx_vpg_util.vpg_getvalor(v_reg_entidad_consumo.cod_plan,'OFFER_HOME_ZONE');

            --Obtener los GroupId
            FOR gr IN (SELECT rownum rn,'HZ'||LPAD(valor,3,'0') as valor FROM (TABLE (tx_utiles.SPLIT(v_group_ids))) )
            LOOP
                IF gr.rn=1 THEN v_group_id1:=gr.valor;
                END IF;
                IF gr.rn=2 THEN v_group_id2:=gr.valor;
                END IF;
                IF gr.rn=3 THEN v_group_id3:=gr.valor;
                END IF;
            END LOOP;

            po_cod_err := 'PVT-2684';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO_ZONA: Error al invocar al proc. PRV_DISPATCHER.EXECUTE_OAS.
            mt_vpg.alta_orden(  pi_id_comando           => v_id_comando_vpg,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => v_msisdn,
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => v_offer_plan, --OFFER ID
                                pi_p4                   => v_group_id1, --Valor del atributo (valor LAC/ CELL ID/GROUP_ID)
                                pi_p5                   => v_group_id2, --Valor del atributo (valor LAC/ CELL ID/GROUP_ID)
                                pi_p6                   => v_group_id3, --Valor del atributo (valor LAC/ CELL ID/GROUP_ID)
                                --pi_p7                  => 'S', --Accion sobre atributo A:Agregar S:Actualizar D:Eliminar
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden_vpg,
                                po_id_tran              => v_id_tran_vpg,
                                po_fch_tran             => v_fch_tran_vpg,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;
        -- 2017-02-09 GAC-Ericsson - Se cambia envio de orden al PRV2 - FIN

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                 := 'OK';
        po_msj_err                 := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    /*
    Purpose: [Registrar una transaccion de baja de entidad de consumo]
    Date: 2007-08-13
    Author: [Edwin Maldonado]
    #param pi_id_entidad_consumo    Identificador de la Entidad de consumo (parametro de entrada)
    #param pi_cod_servicio          Codigo del servicio a ser asignado (parametro de entrada)
    #param pi_cod_usuario           Codigo del usuario que ejecuta la transaccion (parametro de entrada)
    #param pi_master                Indica si el procedimiento administrara transacciones o no (0-1) (parametro de entrada)
    #param pi_id_tran               Identificador de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_cod_gestion_tran      Codigo de la gestion de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_fch_tran              Fecha de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_cod_unidad_negocio    Codigo de la unidad de negocio (parametro de entrada)
    #param po_id_tran               Identificador de la transaccion (parametro de salida)
    #param po_cod_gestion_tran    Codigo de la gestion de la transaccion (parametro de salida)
    #param po_Cod_Err               En caso de existir error devuelve el codigo de error, sino 'OK' (parametro de salida)
    #param po_Msj_Err               En caso de existir error devuelve el mensaje del error, sino '' (parametro de salida)
    #Changes :
      <hr>
      Date :
      Author :
      Note :
      <hr>
    */
    PROCEDURE desasignar_servicio (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_servicio           IN       cl_servicio_entidad_consumo.cod_servicio%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                         := tx_cnf_constante.get_constante ('TRANSACCION_SERVICIO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.DESASIGNAR_SERVICIO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_cod_tipo_afinidad           cl_entidad_consumo_afin.cod_tipo_afinidad%TYPE;
        v_dummy                       PLS_INTEGER;
        v_param2                      VARCHAR2(200);
        v_cod_plan                    cl_entidad_consumo.cod_plan%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_reg_servicio                bm_servicio%ROWTYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_id_entidad_consumo_afin     cl_entidad_consumo_afin.id_entidad_consumo_afin%TYPE;
        v_id_accion                   NUMBER;
        -- Excepciones
        err_app                       EXCEPTION;
        v_cod_observacion             cnf_nota_transaccion.cod_observacion%TYPE;
        v_descripcion_observacion     cnf_nota_transaccion.descripcion%TYPE;
        po_id_orden                   ord_simpleprv.id_orden%TYPE;
        v_parametro_1                 cnf_configuracion_especial.parametro_1%TYPE;
        v_tipo_procedencia            cl_servicio_recarga.tipo_procedencia%TYPE;
        v_customer_group              bm_plan.customer_group%TYPE;
        v_dmm_identificador_entidad   VARCHAR2(20);
        v_orden_ird                   ord_simpleprv.id_orden%type;
        v_offer_id                    VARCHAR2(10);
        v_id_comando                  vpg_cnf_comando.id_comando%TYPE;
        v_id_orden                    vpg_orden.id_orden%TYPE;
        v_cod_enlace                  VARCHAR2(100);
        v_reg_periodo                 tr_periodo_facturacion%ROWTYPE;
        v_cod_ciclo_facturacion       NUMBER;
        v_id_comando2                 NUMBER;
        v_da_id                       NUMBER;
        v_da_unit_type                NUMBER;
        v_id_mensaje                  sms_despachador.id_sms%TYPE;
        v_sms_mensaje                 VARCHAR2(200);


    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                 :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_servicio:'
            || pi_cod_servicio
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_servicio IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2685';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2686';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2687';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                 := v_id_tran;
        po_cod_gestion_tran        := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        --NO SE PUEDEN REALIZAR TRANSACCIONES CUANDO EL SUSCRIPTOR ESTA CON SUSPENSION
        IF     pi_master = c_verdadero
           AND suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2688';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --DATOS DEL SERVICIO
        po_cod_err := 'PVT-2689';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al determinar si el servicio se provisiona.

        SELECT *
          INTO v_reg_servicio
          FROM bm_servicio
         WHERE cod_servicio = pi_cod_servicio;

        --SOLO SE DESASIGNAN SERVICIOS BASICOS, NUMEROS FAVORITOS Y SERVICIOS EXCLUYENTES MEDIANTE ESTE METODO
        IF v_reg_servicio.cod_tipo_servicio NOT IN (c_tipo_serv_basico,
                                                    c_tipo_serv_numfav,
                                                    'TSGAR',   --garantia
                                                    'TSNFLN',   --favoritos local nal
                                                    'TSNFUS',   --favoritos usa
                                                    'TSNFCE',   --favoritos centennial
                                                    'TSLOC',   --paquete de minutos
                                                    'TSDAT',   --servicio de datos
                                                    'TSSMS',   --paquete de sms
                                                    'TSLDU',   --LD usa
                                                    'BBDAT',   --Servicio Blackberry
                                                    'TSPGPR',   --Pagos recurrentes
                                                    'TSEVDO',   --Servicio EVDO Prepago
                                                    'TSVSOC',   --Servicio vSocial
                                                    'TSILI',   --Servicio Paquetes Ilimitados
                                                    'TSESP',   --Servicio Paquetes Especiales,
                                                    'TSVMCP',   --Servicio Habla Gratis ONNET VMC,
                                                    'TSVMP',   --Servicio Habla Gratis ONNET VMC,
                                                    'TSPTA', --Servicios Plan: Prepago TU Atributo (PREVIVA_TU)
                                                    'TSTVBA', -- Servicio Basico Viva TV
                                                    'TSTVPQ', --Servicio Paquete HBO
                                                    'TSSTB', --Servicio TV Set Top Box
                                                    'TSVSF',  --Servicio Security Force
                                                    'TSPROM',
                                                    'TSPDAT',
                                                    'TSLIM', --Paquete datos new
                                                    'TSROM', --Paquete roaming new
                                                    'TSSOC', -- Paquete Social
                                                    'TSMIOF', -- PAquete minutos offnet
                                                    'TSMION', -- PAquete minutos onnet
                                                    'TSEXT', --Servicio Externo SAM Asistencia
                                                    'TSPAIN',
                                                    'TSBON'
                                                   ) THEN
            po_cod_err := 'PVT-2690';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Tipo de servicio no soportado por este procedimiento.
            RAISE err_app;
        END IF;

        v_cod_plan                 := v_reg_entidad_consumo.cod_plan;
        --ERROR SI EL SERVICIO NO SE ENCUENTRA ASIGNADO
        po_cod_err := 'PVT-2691';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al validar si el servicio se encuentra asignado a la Entidad de consumo.

        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_servicio_entidad_consumo
         WHERE id_entidad_consumo = pi_id_entidad_consumo
           AND cod_servicio = pi_cod_servicio
           AND fch_fin = c_fecha_fin
           AND estado <> c_estado_inactivo;

        IF v_dummy = 0 THEN
            po_cod_err := 'PVT-2692';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: El servicio no se encuentra asignado a la Entidad de consumo.
            RAISE err_app;
        END IF;

        --SI EL SERVICIO ES DE NUMEROS FAVORITOS SE DEBEN FINALIZAR LAS AFINIDADES
        BEGIN
            po_cod_err := 'PVT-2693';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al invocar al proc. de actualizacion de afinidades.

            SELECT parametro_1
              INTO v_cod_tipo_afinidad
              FROM cnf_configuracion_especial ce
             WHERE ce.nombre_tabla = 'BM_SERVICIO'
               AND ce.tipo = 'NUMEROS_FAVORITOS'
               AND ce.cod_registro = pi_cod_servicio
               AND ce.parametro_1 IS NOT NULL;

            po_cod_err := 'PVT-2694';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al invocar al proc. de actualizacion de afinidades.
            tx_pvt_entidad_consumo.actualizar_numero_afin
                (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                 pi_cod_tipo_afinidad           => v_cod_tipo_afinidad,
                 pi_numeros_afines              => NULL,   --ENVIANDO LA LISTA DE AFINIDADES EN NULL DEBERIA FINALIZAR TODAS LAS AFINIDADES VIGENTES DEL TIPO ESPECIFICADO
                 pi_descontar                   => c_falso,
                 pi_cod_usuario                 => pi_cod_usuario,
                 pi_master                      => c_falso,
                 pi_id_tran                     => v_id_tran,
                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                 pi_fch_tran                    => v_fch_tran,
                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                 po_id_tran                     => v_id_tran,
                 po_cod_gestion_tran            => v_cod_gestion_tran,
                 po_cod_err                     => po_cod_err,
                 po_msj_err                     => po_msj_err
                );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                NULL;
        END;


        --PARA CAJAS ADICIONALES DIFERIR LOS DIAS CONSUMIDOS DEL SERVICIO A LA FACTURA

        IF tx_pvt_servicios.get_cod_tipo_servicio(pi_cod_servicio) IN ('TSSTB') THEN

            IF v_reg_entidad_consumo.cod_forma_consumo <> 'CCOPRE' THEN

                tx_pvt_servicios_tv.diferir_pago_servicios(
                                                        pi_id_comunidad              => v_reg_entidad_consumo.id_comunidad_facturante,
                                                        pi_servicio_actual           => pi_cod_servicio,
                                                        pi_cod_usuario               => pi_cod_usuario,
                                                        pi_master                    => c_falso,
                                                        pi_id_tran                   => v_id_tran,
                                                        pi_cod_gestion_tran          => v_cod_gestion_tran,
                                                        pi_fch_tran                  => v_fch_tran,
                                                        pi_cod_unidad_negocio        => pi_cod_unidad_negocio,
                                                        po_cod_err                   => po_cod_err,
                                                        po_msj_err                   => po_msj_err);

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;

            END IF;
        END IF;

        IF v_reg_servicio.cod_tipo_servicio = 'TSEXT' THEN

            SELECT periodo_fin
            INTO v_fch_tran
            FROM cl_entidad_consumo ec
            INNER JOIN cl_comunidad cm ON cm.id_comunidad = ec.id_comunidad_facturante
            INNER JOIN tr_periodo_facturacion pf ON pf.cod_ciclo_facturacion = cm.cod_ciclo_facturacion AND pf.vigente = '1'
            WHERE ec.id_entidad_consumo = pi_id_entidad_consumo;

        END IF;

        --DESASIGNACION DEL SERVICIO
        po_cod_err := 'PVT-2695';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al invocar a CC_CL_SERVICIO_ENTIDAD_CONSUMO.DESASIGNAR.
        cc_cl_servicio_entidad_consumo.desasignar (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                   pi_cod_servicio                => pi_cod_servicio,
                                                   pi_cod_usuario                 => pi_cod_usuario,
                                                   pi_id_tran                     => v_id_tran,
                                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                   pi_fch_tran                    => v_fch_tran,
                                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                   pi_fch_efectiva                => v_fch_tran,
                                                   po_cod_err                     => po_cod_err,
                                                   po_msj_err                     => po_msj_err
                                                  );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --PROVISIONAR SI EL SERVICIO ES PROVISIONABLE
        v_identificador_entidad    := v_reg_entidad_consumo.identificador_entidad;

        IF pi_cod_servicio = 'APNWAP6' THEN
            po_cod_err := 'PVT-2696';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al invocar a toggle_wap6
            toggle_wap6 (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                         pi_sub_operation               => 'DEL',
                         pi_cod_transaccion             => c_tipo_transaccion,
                         pi_cod_usuario                 => pi_cod_usuario,
                         pi_id_tran                     => v_id_tran,
                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                         pi_fch_tran                    => v_fch_tran,
                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                         po_cod_err                     => po_cod_err,
                         po_msj_err                     => po_msj_err
                        );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        IF pi_cod_servicio = 'PEMPV' THEN
            SELECT COUNT(1)
                INTO v_dummy
                FROM prm_base b
               WHERE b.id_entidad_consumo = pi_id_entidad_consumo
                 AND b.id_cnf_promocion = 130 ---PROMOCION 3754
                 AND b.estado IN ('PEN');

             IF v_dummy <> c_falso THEN
                SELECT COUNT(1)
                  INTO v_dummy
                  FROM prv_work_order_main
                 WHERE id_wo = (SELECT MAX(id_wo)
                                  FROM prv_work_order_main
                                 WHERE subscriber_id = pi_id_entidad_consumo
                                   AND id_action IN (355,356)
                               )
                   AND p3 IS NOT NULL;

                IF v_dummy = c_verdadero THEN
                    v_reg_servicio.se_provisiona := c_verdadero;
                END IF;
             END IF;
        END IF;

        --El plan VIVA TV provisiona con el Simple PRV y logica distinta.

        IF v_reg_entidad_consumo.cod_tecnologia <> 'TV' THEN
            IF v_reg_servicio.se_provisiona = c_verdadero AND v_reg_servicio.expira_auto = '0' THEN
                po_cod_err := 'PVT-2697';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al recuperar la accion para el PRV a invocar.

                v_id_accion_prv_ext    := get_accion_wap6_transform (pi_id_entidad_consumo,
                                                                     pi_cod_servicio,
                                                                     v_id_accion_prv_ext);
                IF v_reg_servicio.c1_offer_id IS NOT NULL THEN
                    v_param2 := to_char(v_reg_servicio.c1_offer_id);
                ELSE
                    v_param2 := NULL;
                END IF;

                po_cod_err    := 'PVT-5023'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: No existe la Accion al PRV para el servicio.
                SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                  INTO v_id_comando
                FROM DUAL;


                IF v_reg_servicio.cod_servicio = 'HABNOC' THEN

                    --VPG--
                    po_cod_err    := 'PVT-5023'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: No existe un offer configurado para este servicio.
                    SELECT tx_vpg_util.get_servicio_param_value('HABNOC', v_reg_entidad_consumo.cod_plan, 'OFFER_ID', 'VPG_CNF')
                      INTO v_offer_id
                    FROM DUAL;

                    po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => v_offer_id,
                                pi_p4                   => 'D',
                                pi_p5                   => NULL, --Fecha Vigencia
                                pi_p6                   => NULL, --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                ELSIF v_reg_servicio.cod_tipo_servicio IN ('TSPAIN') THEN

                    po_cod_err    := 'PVT-6013'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.


                     SELECT cod_ciclo_facturacion
                            INTO v_cod_ciclo_facturacion
                        FROM cl_comunidad
                        WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

                    v_reg_periodo       := tx_tr_periodo_facturacion.get_periodo_vigente (v_cod_ciclo_facturacion);

                    SELECT tx_vpg_util.get_comando('SET_OFFER', 'CCOPRE', 'SET')
                      INTO v_id_comando
                    FROM DUAL;

                    po_cod_err    := 'PVT-6014'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.

                    v_offer_id      :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE(v_reg_servicio.cod_Servicio,v_reg_entidad_consumo.COD_PLAN,'OFFER_ID','VPG_CNF');

                    po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => v_offer_id, -- OFFER ID
                                pi_p4                   => 'U',
                                pi_p5                   => NULL, --Fecha Vigencia
                                pi_p6                   => TO_CHAR(TRUNC(v_reg_periodo.periodo_fin + 3),'YYYY-MM-DD'), --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                ELSIF v_reg_servicio.cod_tipo_servicio IN ('TSMIOF','TSMION','TSSMS') THEN

                    --Verificar si existe otro paquete vigente con el mismo offer_id, en dado caso no se actuliza la fecha fin en CS
                    po_cod_err    := 'PVT-6017'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                    v_offer_id      :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE(v_reg_servicio.cod_Servicio,v_reg_entidad_consumo.COD_PLAN,'OFFER_ID','VPG_CNF');

                    WITH base AS ( SELECT cod_Servicio, tx_vpg_util.GET_SERVICIO_PARAM_VALUE(cod_servicio,NULL, 'OFFER_ID','VPG_CNF') AS offer_id
                                    FROM bm_servicio WHERE cod_tipo_servicio = v_reg_servicio.cod_tipo_servicio )
                    SELECT COUNT(1)
                        INTO v_dummy
                    FROM cl_servicio_entidad_consumo sec, base b
                    WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
                     AND sec.cod_Servicio = b.cod_servicio
                     AND b.offer_id = v_offer_id
                     AND sec.fch_fin > SYSDATE;

                    IF v_dummy = c_falso THEN
                        po_cod_err    := 'PVT-6018'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                        SELECT tx_vpg_util.get_comando('SET_OFFER_DA', 'CCOPRE', 'SET')
                          INTO v_id_comando
                        FROM DUAL;

                        po_cod_err    := 'PVT-6019'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                        SELECT *
                            INTO v_reg_periodo
                        FROM tr_periodo_facturacion tr
                        WHERE tr.cod_ciclo_facturacion = (SELECT cod_ciclo_facturacion
                                                            FROM cl_comunidad
                                                            WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante  )
                         AND tr.vigente = c_verdadero;

                        po_cod_err    := 'PVT-6020'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                        v_da_id         :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE(v_reg_servicio.cod_Servicio,v_reg_entidad_consumo.COD_PLAN,'DA_ID','VPG_CNF');
                        v_da_unit_type  :=  nvl(tx_vpg_util.GET_SERVICIO_PARAM_VALUE(v_reg_servicio.cod_Servicio,v_reg_entidad_consumo.COD_PLAN,'DA_UNIT_TYPE','VPG_CNF'),'1');


                        po_cod_err    := 'PVT-6021'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                        mt_vpg.alta_orden(
                                    pi_id_comando           => v_id_comando,
                                    pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                    pi_fch_programada       => v_fch_tran,
                                    pi_cod_transaccion      => v_cod_tran,
                                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                    pi_p2                   => tx_air.GET_TRANSACTIONID,
                                    pi_p3                   => tx_vpg_util.date2iso(v_fch_tran), -- fecha transaccion
                                    pi_p4                   => v_da_id, -- da_id
                                    pi_p5                   => '0', -- valor de ajuste
                                    pi_p6                   => v_da_unit_type, -- da_unit_type_id
                                    pi_p7                   => tx_vpg_util.date2iso(v_reg_periodo.periodo_fin - 0.5/24), -- ajuste para no hacer rollover
                                    pi_p8                   => 'AJUSTE FECHA EXPIRACION DA', -- comentario 1
                                    pi_p9                   => '0', -- comentario 2 - puede ser nulo
                                    pi_p12                  => v_offer_id, -- offer id
                                    pi_p13                  => tx_vpg_util.date2iso(v_fch_tran), --Fecha inicio
                                    pi_p14                  => tx_vpg_util.date2iso(v_reg_periodo.periodo_fin - 0.5/24), -- ajuste para no hacer rollover
                                    pi_p15                  => '2', -- Offer type, por defecto 2= timer
                                    pi_cod_usuario          => pi_cod_usuario,
                                    pi_master               => c_falso,
                                    pi_id_tran              => v_id_tran,
                                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                                    pi_fch_tran             => v_fch_tran,
                                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                    po_id_orden             => v_id_orden,
                                    po_id_tran              => v_id_tran,
                                    po_fch_tran             => v_fch_tran,
                                    po_cod_err              => po_cod_err,
                                    po_msj_err              => po_msj_err
                                );

                            IF po_cod_err != 'OK' THEN
                                RAISE err_app;
                            END IF;
                    END IF;


                ELSIF v_reg_servicio.cod_servicio != 'BLQCAL'  OR (v_reg_servicio.cod_servicio = 'BLQCAL' AND v_reg_entidad_consumo.cod_tecnologia != 'CDMA') THEN

                    --VPG--
                    IF v_reg_servicio.cod_tipo_servicio NOT IN (c_tipo_serv_datos,c_tipo_serv_basico) THEN

                        po_cod_err    := 'PVT-5041'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: No existe un offer configurado para este servicio.
                        SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_plan, 'OFFER_ID', 'VPG_CNF')
                          INTO v_offer_id
                        FROM DUAL;

                        IF pi_cod_servicio IN ('PLVOZ1','PLVOZ2','PLVOZ3') THEN

                            po_cod_err    := 'PVT-5176'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al obtener el ciclo de facturacion del cuenta.
                            SELECT cod_ciclo_facturacion
                                INTO v_cod_ciclo_facturacion
                            FROM cl_comunidad
                            WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

                            v_reg_periodo       := tx_tr_periodo_facturacion.get_periodo_vigente (v_cod_ciclo_facturacion);


                            --Para estos servicio no eliminarlo de una vez, poner la fecha expiracion hasta su corte, se pone a las 23:59 del dia anterior.
                            po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                            mt_vpg.alta_orden(
                                        pi_id_comando           => v_id_comando,
                                        pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                        pi_fch_programada       => pi_fch_tran,
                                        pi_cod_transaccion      => c_tipo_transaccion,
                                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                        pi_p2                   => pi_id_entidad_consumo,
                                        pi_p3                   => v_offer_id, -- OFFER ID
                                        pi_p4                   => 'U',
                                        pi_p5                   => NULL, --Fecha Vigencia
                                        pi_p6                   => tx_ecms.date2iso(v_reg_periodo.periodo_fin-1), --Fecha Expiracion
                                        pi_cod_usuario          => pi_cod_usuario,
                                        pi_master               => c_falso,
                                        pi_id_tran              => v_id_tran,
                                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                                        pi_fch_tran             => v_fch_tran,
                                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                        po_id_orden             => v_id_orden,
                                        po_id_tran              => v_id_tran,
                                        po_fch_tran             => v_fch_tran,
                                        po_cod_err              => po_cod_err,
                                        po_msj_err              => po_msj_err
                                        );

                            IF po_cod_err <> 'OK' THEN
                                RAISE err_app;
                            END IF;

                            --Ajuste al bolsillo para para no hacer rollover

                            SELECT tx_vpg_util.get_comando('SET_DA_BALANCE', 'CCOPRE', 'SET')
                              INTO v_id_comando2
                            FROM DUAL;

                            v_da_id             :=   tx_vpg_util.get_servicio_param_value(pi_cod_servicio, v_reg_entidad_consumo.cod_plan, 'DA_ID', 'VPG_CNF');

                            mt_vpg.alta_orden(
                                    pi_id_comando               => v_id_comando2,
                                    pi_id_entidad_consumo       => pi_id_entidad_consumo,
                                    pi_cod_transaccion          => c_tipo_transaccion,
                                    pi_fch_programada           => pi_fch_tran,
                                    pi_p1                       => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                    pi_p2                       => tx_air.get_transactionID,
                                    pi_p3                       => tx_vpg_util.date2iso(v_fch_tran),
                                    pi_p4                       => v_da_id,
                                    pi_p5                       => 0, --Monto de Ajuste
                                    pi_p6                       => '1', -- Cod Unidad de Medida
                                    pi_p7                       => tx_vpg_util.date2iso(v_reg_periodo.periodo_fin-1 ),  --Fecha expiracion
                                    pi_p8                       => 'AJUSTE FECHA EXPIRACION DA',
                                    pi_cod_usuario              => pi_cod_usuario,
                                    pi_master                   => '0',
                                    pi_id_tran                  => v_id_tran,
                                    pi_cod_gestion_tran         => v_cod_gestion_tran,
                                    pi_fch_tran                 => v_fch_tran,
                                    pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                                    po_id_orden                 => v_id_orden,
                                    po_id_tran                  => v_id_tran,
                                    po_fch_tran                 => v_fch_tran,
                                    po_cod_err                  => po_cod_err,
                                    po_msj_err                  => po_msj_err);

                            IF (po_cod_err != 'OK') THEN
                                RAISE err_app;
                            END IF;


                        ELSE

                            po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                            mt_vpg.alta_orden(
                                        pi_id_comando           => v_id_comando,
                                        pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                        pi_fch_programada       => pi_fch_tran,
                                        pi_cod_transaccion      => c_tipo_transaccion,
                                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                        pi_p2                   => pi_id_entidad_consumo,
                                        pi_p3                   => v_offer_id, -- OFFER ID
                                        pi_p4                   => 'D',
                                        pi_p5                   => NULL, --Fecha Vigencia
                                        pi_p6                   => NULL, --Fecha Expiracion
                                        pi_cod_usuario          => pi_cod_usuario,
                                        pi_master               => c_falso,
                                        pi_id_tran              => v_id_tran,
                                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                                        pi_fch_tran             => v_fch_tran,
                                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                        po_id_orden             => v_id_orden,
                                        po_id_tran              => v_id_tran,
                                        po_fch_tran             => v_fch_tran,
                                        po_cod_err              => po_cod_err,
                                        po_msj_err              => po_msj_err
                                        );

                            IF po_cod_err <> 'OK' THEN
                                RAISE err_app;
                            END IF;

                        END IF;



                    ELSE


                        v_cod_enlace    :=  v_reg_servicio.cod_servicio;

                        po_cod_err    := 'PVT-5042'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: No existe la Accion al PRV para el servicio.
                        SELECT tx_vpg_util.get_comando(v_cod_enlace, v_reg_entidad_consumo.cod_forma_consumo, 'DEL')
                          INTO v_id_comando
                        FROM DUAL;

                        IF v_reg_servicio.cod_servicio = 'SUS4G' THEN

                            -- AL QUITAR EL SERVICIO DE SUSPENCION 4G, DEBE PROVISIONARSE DE NUEVO EL HSS EL NUMERO.

                            po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                            mt_vpg.alta_orden(
                                        pi_id_comando           => v_id_comando,
                                        pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                        pi_fch_programada       => pi_fch_tran,
                                        pi_cod_transaccion      => c_tipo_transaccion,
                                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                        pi_p2                   => tx_vpg_util.get_servicio_param_value('DAT4G', v_reg_entidad_consumo.cod_plan, 'PDPCP', 'VPG_CNF'),
                                        pi_p3                   => v_reg_entidad_consumo.imsi,
                                        pi_p4                   => tx_vpg_util.get_servicio_param_value('DAT4G', v_reg_entidad_consumo.cod_plan, 'EPS_PROFILE_ID', 'VPG_CNF'),
                                        pi_cod_usuario          => pi_cod_usuario,
                                        pi_master               => c_falso,
                                        pi_id_tran              => v_id_tran,
                                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                                        pi_fch_tran             => v_fch_tran,
                                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                        po_id_orden             => v_id_orden,
                                        po_id_tran              => v_id_tran,
                                        po_fch_tran             => v_fch_tran,
                                        po_cod_err              => po_cod_err,
                                        po_msj_err              => po_msj_err
                                        );

                            IF po_cod_err <> 'OK' THEN
                                RAISE err_app;
                            END IF;


                        ELSE
                            po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                            mt_vpg.alta_orden(
                                        pi_id_comando           => v_id_comando,
                                        pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                        pi_fch_programada       => pi_fch_tran,
                                        pi_cod_transaccion      => c_tipo_transaccion,
                                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                        pi_p2                   => CASE WHEN v_reg_servicio.cod_servicio IN ('DAT4G','APNDATA','APNDAT2','BLDATR') THEN v_reg_entidad_consumo.imsi ELSE pi_id_entidad_consumo END,
                                        pi_cod_usuario          => pi_cod_usuario,
                                        pi_master               => c_falso,
                                        pi_id_tran              => v_id_tran,
                                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                                        pi_fch_tran             => v_fch_tran,
                                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                        po_id_orden             => v_id_orden,
                                        po_id_tran              => v_id_tran,
                                        po_fch_tran             => v_fch_tran,
                                        po_cod_err              => po_cod_err,
                                        po_msj_err              => po_msj_err
                                        );

                            IF po_cod_err <> 'OK' THEN
                                RAISE err_app;
                            END IF;
                        END IF;


                    END IF;


                ELSE
                    SELECT customer_group
                      INTO v_customer_group
                    FROM bm_plan
                    WHERE cod_plan = v_reg_entidad_consumo.cod_plan
                    AND estado = c_estado_activo;

                    --Se envia ADD porque se pretende agregar el Customer Group relacionadl al plan del suscriptor
                    po_cod_err := 'PVT-2701';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al invocar al proc. PRV_DISPATCHER.EXECUTE_OAS - BLQCAL.
                    prv_dispatcher.execute_oas (pi_subscriber_id               => pi_id_entidad_consumo,   --C1 OK
                                                pi_cod_transaccion             => c_tipo_transaccion,
                                                pi_id_action                   => v_id_accion_prv_ext,
                                                pi_sub_operation               => c_tipo_operacion_add,
                                                pi_p1                          => v_identificador_entidad,
                                                pi_p2                          => NULL,
                                                pi_p3                          => NULL,
                                                pi_p6                          => v_customer_group, --Customer Group del Plan
                                                pi_specific_user               => c_falso,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_master                      => c_falso,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;

            ELSIF v_reg_servicio.se_provisiona = c_verdadero AND v_reg_servicio.expira_auto = '1' THEN

                 --VPG--
                 IF NVL(v_reg_servicio.c1_offer_id,0) <> 0 THEN

                    --VPG--
                    po_cod_err    := 'PVT-000'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: No existe la Accion al PRV para el servicio.
                    SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                      INTO v_id_comando
                    FROM DUAL;

                    po_cod_err    := 'PVT-5043'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: No existe un offer configurado para este servicio.
                    SELECT tx_vpg_util.get_servicio_param_value(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_plan, 'OFFER_ID', 'VPG_CNF')
                      INTO v_offer_id
                    FROM DUAL;

                    po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => pi_id_entidad_consumo,
                                pi_p3                   => v_offer_id, -- OFFER ID
                                pi_p4                   => 'D',
                                pi_p5                   => NULL, --Fecha Vigencia
                                pi_p6                   => NULL, --Fecha Expiracion
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                 ELSE

                    po_cod_err    := 'PVT-5044'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: No existe la Accion al PRV para el servicio.
                    SELECT tx_vpg_util.get_comando(v_reg_servicio.cod_servicio, v_reg_entidad_consumo.cod_forma_consumo, 'DEL')
                      INTO v_id_comando
                    FROM DUAL;

                    po_cod_err    := 'PVT-5045'; --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                    mt_vpg.alta_orden(
                                pi_id_comando           => v_id_comando,
                                pi_id_entidad_consumo   => pi_id_entidad_consumo,
                                pi_fch_programada       => pi_fch_tran,
                                pi_cod_transaccion      => c_tipo_transaccion,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => c_falso,
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_id_orden,
                                po_id_tran              => v_id_tran,
                                po_fch_tran             => v_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                 END IF;


            END IF;
        ELSE

           IF tx_pvt_servicios.get_cod_tipo_servicio(pi_cod_servicio) IN ('TSTVPQ', 'TSTVBA') THEN

                BEGIN
                    SELECT tipo_procedencia
                      INTO v_tipo_procedencia
                      FROM cl_servicio_recarga
                     WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                       AND cod_servicio = v_reg_servicio.cod_servicio
                       AND id_tran_fin = v_id_tran;
                EXCEPTION
                    WHEN OTHERS THEN
                        v_tipo_procedencia    := 'VTPPVT';
                END;

                tx_prv_tv.provisionar_servicio(
                                            pi_id_entidad_consumo => v_reg_entidad_consumo.id_entidad_consumo,
                                            pi_cod_servicio => v_reg_servicio.cod_servicio,
                                            pi_cod_action => 'REMOVE_PACK',
                                            pi_tipo_procedencia => v_tipo_procedencia,
                                            pi_cod_usuario => pi_cod_usuario,
                                            pi_master => c_falso,
                                            pi_id_tran => v_id_tran,
                                            pi_cod_gestion_tran => v_cod_gestion_tran,
                                            pi_fch_tran => v_fch_tran,
                                            pi_cod_unidad_negocio => pi_cod_unidad_negocio,
                                            po_cod_err => po_cod_err,
                                            po_msj_err => po_msj_err
                                           );
                IF po_cod_err <> 'OK' THEN
                  RAISE err_app;
                END IF;
            END IF;

        END IF;

        IF pi_master = c_verdadero AND pi_cod_servicio = 'NFILIM2' THEN   --NUMERO FAVORITO ILIMITADO ENTRE DOS PCSs
            po_cod_err := 'PVT-2707';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al determinar el id del suscriptor afin.

            SELECT eca.id_entidad_consumo
              INTO v_id_entidad_consumo_afin
              FROM cl_entidad_consumo_afin eca
             WHERE eca.identificador_entidad_afin = v_reg_entidad_consumo.identificador_entidad
               AND eca.cod_tipo_afinidad = v_cod_tipo_afinidad
               AND eca.estado <> c_estado_inactivo
               AND eca.fch_fin = c_fecha_fin;

            po_cod_err := 'PVT-2708';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al desasignar el servicio del suscriptor afin.
            tx_pvt_entidad_consumo.desasignar_servicio
                                                (pi_id_entidad_consumo          => v_id_entidad_consumo_afin,
                                                 pi_cod_servicio                => pi_cod_servicio,
                                                 pi_cod_usuario                 => pi_cod_usuario,
                                                 pi_master                      => c_falso,
                                                 pi_id_tran                     => v_id_tran,
                                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                 pi_fch_tran                    => v_fch_tran,
                                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                 po_id_tran                     => v_id_tran,
                                                 po_cod_gestion_tran            => v_cod_gestion_tran,
                                                 po_cod_err                     => po_cod_err,
                                                 po_msj_err                     => po_msj_err
                                                );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --REGISTRAR EL LOG TRANSACCIONAL POSTVENTA
        IF pi_master = c_verdadero THEN
            v_cod_observacion            := '4DSER';
            v_descripcion_observacion    := 'DESASIGNACION DE SERVICIO AL SUSCRIPTOR';
            po_cod_err := 'PVT-2709';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al obtener el id del cliente.
            v_id_cliente                 :=
                                          get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
            v_trama_anterior_pv          :=    'Codigo:'
                                            || pi_cod_servicio
                                            || '|'
                                            || 'Descripcion:'
                                            || v_reg_servicio.descripcion;
            --- Registrar transaccion
            po_cod_err := 'PVT-2710';   --TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
            cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => v_cod_observacion,
                                   pi_descripcion_observacion     => v_descripcion_observacion,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        IF v_reg_servicio.cod_tipo_servicio = 'TSEXT' AND v_reg_servicio.cod_servicio IN ('SAMBU', 'SUNDE', 'SUNEQ') THEN --CVE: para envio sms del servicio aeroambulancia/unit al suspenderlo 18/06/2025.

            IF v_reg_servicio.cod_servicio IN ('SUNDE', 'SUNEQ') THEN --CVE: para envio sms del servicio seguros unit al activarlo 16-06-2025.
                SELECT descipcion
                INTO v_sms_mensaje
                FROM omega.cnf_configuracion_especial
                WHERE nombre_tabla = 'MAIL_MENSAJE_DISPATCHER'
                AND tipo = 'TEXT_UNIT_SUSPEN'
                AND cod_registro = 'NOTTERUNIT'
                AND parametro_1 = v_reg_servicio.cod_servicio;
            ELSIF v_reg_servicio.cod_servicio = 'SAMBU' THEN --CVE: para envio sms del servicio aeroambulancia al activarlo 10-04-2025.
                SELECT descipcion
                INTO v_sms_mensaje
                FROM omega.cnf_configuracion_especial
                WHERE nombre_tabla = 'MAIL_MENSAJE_DISPATCHER'
                AND tipo = 'TEXT_SAMBU_SUSPEN'
                AND cod_registro = 'NOTTERSAMBU'
                AND parametro_1 = v_reg_servicio.cod_servicio;
            END IF;

            --po_cod_err := 'PVT-6097'; --TX_CL_SUSCRIPCION_SERVICIO.ALTA: no se pudo enviar el sms
            --Enviar SMS.
            tx_sms.alta (pi_origen                      => 'VIVA',
                         pi_destino                     => v_reg_entidad_consumo.identificador_entidad,
                         pi_texto                       => v_sms_mensaje,
                         pi_prioridad                   => 1,
                         pi_programado                  => v_fch_tran,
                         pi_id_tran                     => v_id_tran,
                         pi_fch_tran                    => v_fch_tran,
                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                         pi_cod_usuario                 => pi_cod_usuario,
                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                         pi_master                      => c_falso,
                         po_id_sms                      => v_id_mensaje,
                         po_cod_err                     => po_cod_err,
                         po_msj_err                     => po_msj_err);

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                 := 'OK';
        po_msj_err                 := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE baja_entidad_consumo (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_motivo             IN       tx_transaccion_postventa.cod_motivo_transaccion%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                             := tx_cnf_constante.get_constante ('TRANSACCION_BAJA_ENTIDAD_CONSUMO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.BAJA_ENTIDAD_CONSUMO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_estado_comunidad            cl_comunidad.estado%TYPE;
        v_dummy                       PLS_INTEGER;
        v_susc_activos                PLS_INTEGER;
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_cod_tipo_afinidad           cl_entidad_consumo_afin.cod_tipo_afinidad%TYPE;
        v_id_entidad_consumo_afin     cl_entidad_consumo_afin.id_entidad_consumo_afin%TYPE;
        v_se_renta                    bm_grupo_plan.se_renta%TYPE;
        v_cod_linea_negocio           bm_grupo_plan.cod_linea_negocio%TYPE;
        v_tipo_numero                 cl_numero_telefonico.estado%TYPE;
        v_min                         cl_numero_telefonico.numero_telefonico%TYPE;
        v_cod_servicio_act            bm_servicio.cod_servicio%TYPE;
        v_id_ord                      ord_simpleprv.id_orden%TYPE;
        v_imsi_eir                    cl_articulo_entidad_consumo.nro_serie%TYPE;
        v_imei_eir                    cl_articulo_entidad_consumo.nro_serie%TYPE;
        v_id_orden                    eir_orden.id_orden%TYPE;
        v_id_comando                  vpg_orden.id_comando%TYPE;
        po_fch_tran                   vpg_orden.fch_tran%TYPE;
        v_aplica_ciclo_vida           PLS_INTEGER;
        -- dmm
        v_dmm_tmp_val                 VARCHAR2 (20);

        v_reg_config_esp cnf_configuracion_especial%ROWTYPE;
        v_reg_config_esp_afin cnf_configuracion_especial%ROWTYPE;

        v_config_esp_param5    NUMBER;
        v_reg_ec_afin cl_entidad_consumo%ROWTYPE;

        v_reg_entidad_consumo_afin cl_entidad_consumo%ROWTYPE;
        v_num VARCHAR2(50);

        -- Cursores
        CURSOR clista_entidad_consumo_afin (
            v_identificador_entidad_afin       cl_entidad_consumo_afin.identificador_entidad_afin%TYPE
        )
        IS
            SELECT *
              FROM cl_entidad_consumo_afin
             WHERE id_entidad_consumo = pi_id_entidad_consumo
               AND estado <> c_estado_inactivo
               AND fch_fin = c_fecha_fin
            UNION
            SELECT *
              FROM cl_entidad_consumo_afin
             --WHERE id_entidad_consumo_afin = pi_id_entidad_consumo
            WHERE  identificador_entidad_afin = v_identificador_entidad_afin
               AND estado <> c_estado_inactivo
               AND fch_fin = c_fecha_fin;

        CURSOR clista_ec_afin (
            v_identificador_entidad_afin       cl_entidad_consumo_afin.identificador_entidad_afin%TYPE
        )
        IS
            SELECT *
              FROM cl_entidad_consumo_afin
             --WHERE id_entidad_consumo_afin = pi_id_entidad_consumo
            WHERE  identificador_entidad_afin = v_identificador_entidad_afin
               AND estado <> c_estado_inactivo
               AND fch_fin = c_fecha_fin;

        CURSOR clista_articulos
        IS
            SELECT *
              FROM cl_articulo_entidad_consumo
             WHERE id_entidad_consumo = pi_id_entidad_consumo
               AND estado <> c_estado_inactivo
               AND fch_fin = c_fecha_fin;

        CURSOR clista_servicios
        IS
            SELECT sec.*,
                   s.cod_tipo_servicio
              FROM cl_servicio_entidad_consumo sec, bm_servicio s
             WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
               AND sec.cod_servicio = s.cod_servicio
               AND sec.estado <> c_estado_inactivo
               AND sec.fch_fin = c_fecha_fin;

        CURSOR clista_componente_comunidad
        IS
            SELECT *
              FROM cl_componente_comunidad
             WHERE id_entidad_consumo = pi_id_entidad_consumo
               AND estado <> c_estado_inactivo
               AND fch_fin = c_fecha_fin;

        CURSOR clista_limite_credito
        IS
            SELECT *
              FROM cl_limite_credito_ent_cons
             WHERE id_entidad_consumo = pi_id_entidad_consumo
               AND estado <> c_estado_inactivo
               AND fch_fin = c_fecha_fin;

        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                 :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_motivo:'
            || pi_cod_motivo
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2711';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2712';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2713';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                 := v_id_tran;
        po_cod_gestion_tran        := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2714';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al recuperar parametros del grupo plan

        SELECT bg.se_renta,
               bg.cod_linea_negocio
          INTO v_se_renta,
               v_cod_linea_negocio
          FROM bm_plan b, bm_grupo_plan bg
         WHERE b.cod_grupo_plan = bg.cod_grupo_plan AND b.cod_plan = v_reg_entidad_consumo.cod_plan;

        IF v_se_renta > 0 THEN
            IF pi_cod_motivo NOT IN ('TRTT52', 'TRTT51') THEN
                po_cod_err := 'PVT-2715';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: El motivo de terminacion no esta definido para ese tipo de suscriptor
                RAISE err_app;
            ELSIF pi_master = c_falso AND pi_cod_motivo = 'TRTT52' THEN
                po_cod_err := 'PVT-2716';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: El motivo de terminacion no esta definido para ese tipo de suscriptor
                RAISE err_app;
            END IF;
        END IF;

        --DETERMINAR EL MIN SI ES PORTED-IN CDMA
        po_cod_err := 'PVT-2717';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al determinar el tipo de numero.
        v_tipo_numero              := get_tipo_numero (v_reg_entidad_consumo.identificador_entidad);

        IF     v_tipo_numero = c_tipo_numero_portin
           AND v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            po_cod_err := 'PVT-2718';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al determinar el MIN del suscriptor.
            v_min         := get_min_suscriptor (pi_id_entidad_consumo);
        ELSIF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            v_min    := v_reg_entidad_consumo.identificador_entidad;
        END IF;

        -- RQX 3288: Vinculacion SIM CARD y Equipo Fijo GSM
        IF (    (es_fija (v_reg_entidad_consumo.cod_plan) = '1' OR v_cod_linea_negocio = 'INTERM')
            AND v_reg_entidad_consumo.cod_tecnologia = 'GSM'
           ) THEN
            SELECT aec.nro_serie
              INTO v_imei_eir
              FROM cl_articulo_entidad_consumo aec
             WHERE aec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND aec.cod_rubro_articulo IN ('TAGSM')
               AND aec.estado = c_estado_activo
               AND aec.fch_fin = c_fecha_fin;

            SELECT ih.imsi
              INTO v_imsi_eir
              FROM tr_imsi_historico ih
             WHERE ih.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND ih.fch_fin = c_fecha_fin;

            po_cod_err := 'PVT-2719';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al enviar la orden al EIR.
            tx_eir_orden.alta (pi_cod_accion                  => 'DEL_PL',
                               pi_imei                        => v_imei_eir,
                               pi_imsi                        => v_imsi_eir,
                               pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                               pi_operadora                   => '400',
                               pi_id_tran                     => v_id_tran,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               pi_master                      => c_falso,
                               po_id_orden                    => v_id_orden,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- FIN RQX 3288

        --BAJA DE ARTICULOS ASIGNADOS
        FOR i IN clista_articulos
        LOOP
            cc_cl_articulo_entidad_consumo.desasignar
                                                    (i.id_entidad_consumo,   --pi_id_entidad_consumo,
                                                     i.id_registro,   --pi_id_registro,
                                                     pi_cod_usuario,   --pi_cod_usuario,
                                                     v_id_tran,   --pi_id_tran,
                                                     v_cod_gestion_tran,   --pi_cod_gestion_tran,
                                                     v_fch_tran,   --pi_fch_tran,
                                                     pi_cod_unidad_negocio,   --pi_cod_unidad_negocio,
                                                     v_fch_tran,   --pi_Fch_efectiva
                                                     po_cod_err,
                                                     po_msj_err
                                                    );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END LOOP;

        v_identificador_entidad    := v_reg_entidad_consumo.identificador_entidad;

        --BAJA DE SERVICIOS ASIGNADOS
        FOR i IN clista_servicios
        LOOP
            IF i.cod_tipo_servicio = c_tipo_serv_paquete THEN
                v_cod_servicio_act    := i.cod_servicio;
            END IF;

            cc_cl_servicio_entidad_consumo.desasignar
                                                     (i.id_entidad_consumo,   --pi_id_entidad_consumo,
                                                      i.cod_servicio,   --pi_cod_servicio,
                                                      pi_cod_usuario,   --pi_cod_usuario,
                                                      v_id_tran,   --pi_id_tran,
                                                      v_cod_gestion_tran,   --pi_cod_gestion_tran,
                                                      v_fch_tran,   --pi_fch_tran,
                                                      pi_cod_unidad_negocio,   --pi_cod_unidad_negocio,
                                                      v_fch_tran,   --pi_Fch_efectiva
                                                      po_cod_err,
                                                      po_msj_err
                                                     );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            IF i.cod_servicio = 'NFILIM' THEN   --NUMERO FAVORITO ILIMITADO ENTRE DOS PCSs
                po_cod_err := 'PVT-2722';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al determinar el tipo de afinidad del servicio.

                SELECT parametro_1
                  INTO v_cod_tipo_afinidad
                  FROM cnf_configuracion_especial ce
                 WHERE ce.nombre_tabla = 'BM_SERVICIO'
                   AND ce.tipo = 'NUMEROS_FAVORITOS'
                   AND ce.cod_registro = i.cod_servicio
                   AND ce.parametro_1 IS NOT NULL;

                BEGIN
                    po_cod_err := 'PVT-2723';   --TX_PVT_ENTILAD_CONSUMO.JAJA_ENTIDAD_CONSUMO: Error al determinar el id del suscriptor afin.

                    SELECT eca.id_entidad_consumo
                      INTO v_id_entidad_consumo_afin
                      FROM cl_entidad_consumo_afin eca
                     WHERE eca.identificador_entidad_afin =
                                                         v_reg_entidad_consumo.identificador_entidad
                       AND eca.cod_tipo_afinidad = v_cod_tipo_afinidad
                       AND eca.estado <> c_estado_inactivo
                       AND eca.fch_fin = c_fecha_fin;

                    po_cod_err := 'PVT-2724';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al desasignar el servicio del suscriptor afin.
                    tx_pvt_entidad_consumo.desasignar_servicio
                                                (pi_id_entidad_consumo          => v_id_entidad_consumo_afin,
                                                 pi_cod_servicio                => i.cod_servicio,
                                                 pi_cod_usuario                 => pi_cod_usuario,
                                                 pi_master                      => c_falso,
                                                 pi_id_tran                     => v_id_tran,
                                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                 pi_fch_tran                    => v_fch_tran,
                                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                 po_id_tran                     => v_id_tran,
                                                 po_cod_gestion_tran            => v_cod_gestion_tran,
                                                 po_cod_err                     => po_cod_err,
                                                 po_msj_err                     => po_msj_err
                                                );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        NULL;   --PUEDE ESTAR EL SERVICIO ANADIDO PERO NO NECESARIAMENTE TENER ASIGNADOS LOS NUMEROS AFINES
                END;
            END IF;


        END LOOP;


        -- Baja de numeros favoritos mediante comandos al PRV

        --DESASIGNAR SERVICIO FAVORITO MOCHILERO

        FOR mochilero IN ( SELECT ec.id_entidad_consumo,
                                  ec.identificador_entidad,
                                  cnf.cod_catalogo as tipo_afinidad,
                                  se.cod_servicio
                             FROM cl_entidad_consumo ec,  cnf_catalogo cnf,  cl_servicio_entidad_consumo se
                            WHERE ec.id_persona = v_reg_entidad_consumo.id_persona
                              AND ec.cod_plan in ('PREVIVA_TU','VMCP')
                              AND se.id_entidad_consumo = ec.id_entidad_consumo
                              AND se.cod_servicio IN ('NFVIVM','NFVMCM')
                              AND cnf.abreviatura = se.cod_servicio
                              AND se.fch_fin = c_fecha_fin
                              AND se.estado = c_estado_activo
                              AND EXISTS(SELECT 1
                                           FROM cl_servicio_entidad_consumo sec
                                          WHERE sec.cod_servicio IN ('NFVIVM','NFVMCM')
                                            AND sec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo))
        LOOP

            tx_pvt_entidad_consumo.actualizar_numero_afin
                             (pi_id_entidad_consumo          => mochilero.id_entidad_consumo,
                              pi_cod_tipo_afinidad           => mochilero.tipo_afinidad,
                              pi_numeros_afines              => NULL,
                              pi_descontar                   => c_falso,
                              pi_cod_usuario                 => pi_cod_usuario,
                              pi_master                      => c_falso,
                              pi_id_tran                     => v_id_tran,
                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                              pi_fch_tran                    => v_fch_tran,
                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                              po_id_tran                     => v_id_tran,
                              po_cod_gestion_tran            => v_cod_gestion_tran,
                              po_cod_err                     => po_cod_err,
                              po_msj_err                     => po_msj_err
                             );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;


            po_cod_err := 'PVT-2727';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc. de desasignacion de servicios.
            cc_cl_servicio_entidad_consumo.desasignar
                                 (pi_id_entidad_consumo          => mochilero.id_entidad_consumo,
                                  pi_cod_servicio                => mochilero.cod_servicio,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  pi_fch_efectiva                => v_fch_tran,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

        END LOOP;

        FOR i IN clista_ec_afin (v_identificador_entidad)
        LOOP
                po_cod_err := 'PVT-2728';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al recuperar el registro COD_TIPO_AFINIDAD no valido.
            SELECT
            CASE
                WHEN EXISTS
                    (
                        SELECT
                            1
                        FROM
                            cnf_configuracion_especial p
                        WHERE
                            p.nombre_tabla = 'BM_SERVICIO'
                        AND p.tipo         = 'NUMEROS_FAVORITOS'
                        AND p.parametro_5  = 1
                        AND p.parametro_6  = 1
                        AND p.parametro_1  = i.cod_tipo_afinidad
                    )
                    THEN
                    1
                ELSE
                    0
                END INTO v_config_esp_param5 FROM DUAL ;

                po_cod_err := 'PVT-2729';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al recuperar el registro relacionado con el identificador_entidad_afin.
              SELECT *
                INTO v_reg_ec_afin
                FROM cl_entidad_consumo ec
               WHERE ec.identificador_entidad = i.identificador_entidad_afin
                 AND estado NOT IN (c_estado_inactivo, 'TER');

              po_cod_err := 'PVT-2730';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al validar el parametro de numero favorito o cod_forma_consumo.
             IF v_config_esp_param5           = c_verdadero
                 AND v_reg_ec_afin.cod_forma_consumo <> 'CCOPOS'  THEN

                   v_num := i.identificador_entidad_afin;

                    po_cod_err := 'PVT-2731';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al validar la tecnologia del numero afin.
                   IF v_reg_ec_afin.cod_tecnologia = c_tecnologia_gsm THEN
                       v_id_accion_prv_ext                  := 333;
                       IF v_num LIKE '809%' OR v_num LIKE '829%' OR v_num LIKE '849%' THEN
                           v_num := '1' || v_num;
                       END IF;
                   ELSE
                       v_id_accion_prv_ext := 332;
                   END IF;

                 po_cod_err := 'PVT-2732';   --TX_PVT_ENTIDAD_CONSUMO.ACTUALIZAR_NUMERO_AFIN: Error al invocar al proc. de envio de ordenes al provisionador.

                 tx_cl_orden_prv.alta                                -- C1 OK
                                     ( pi_id_action => v_id_accion_prv_ext,
                                       pi_cod_transaccion => c_tipo_transaccion,
                                       pi_id_entidad_consumo =>  i.id_entidad_consumo, --v_reg_entidad_consumo_afin.id_entidad_consumo,
                                       pi_sub_operacion => c_tipo_operacion_add,
                                       pi_fch_programada => v_fch_tran,
                                       pi_p1 => i.identificador_entidad,   --i.identificador_entidad, --v_num, --v_reg_entidad_consumo.identificador_entidad,
                                       pi_p2 => v_num,
                                       pi_cod_usuario => pi_cod_usuario,
                                       pi_master => c_falso,
                                       pi_id_tran => v_id_tran,
                                       pi_cod_gestion_tran => v_cod_gestion_tran,
                                       pi_fch_tran => v_fch_tran,
                                       pi_cod_unidad_negocio => pi_cod_unidad_negocio,
                                       po_id_orden => v_id_orden,
                                       po_cod_err => po_cod_err,
                                       po_msj_err => po_msj_err );

                 IF po_cod_err <> 'OK' THEN
                     RAISE err_app;
                 END IF;

             END IF;

         END LOOP;

        -- Fin de numeros favoritos mediante comandos a PRV


        --BAJA DE NUMEROS FAVORITOS
        FOR i IN clista_entidad_consumo_afin (v_identificador_entidad)
        LOOP
            cc_cl_entidad_consumo_afin.desasignar
                                    (i.id_entidad_consumo,   -- pi_id_entidad_consumo,
                                     i.identificador_entidad_afin,   -- pi_identificador_entidad_afin,
                                     i.cod_tipo_afinidad,
                                     pi_cod_usuario,
                                     v_id_tran,
                                     v_cod_gestion_tran,
                                     v_fch_tran,
                                     pi_cod_unidad_negocio,
                                     v_fch_tran,
                                     po_cod_err,
                                     po_msj_err
                                    );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END LOOP;

        --BAJA DE ASOCIACIONES CON LAS COMUNIDADES HABLANTE Y FACTURANTE
        FOR i IN clista_componente_comunidad
        LOOP
            cc_cl_componente_comunidad.desasignar (i.id_comunidad,   --pi_id_comunidad,
                                                   i.id_entidad_consumo,   --pi_id_entidad_consumo,
                                                   pi_cod_usuario,   --pi_cod_usuario,
                                                   v_id_tran,   --pi_id_tran,
                                                   v_cod_gestion_tran,   --pi_cod_gestion_tran,
                                                   v_fch_tran,   --pi_fch_tran,
                                                   pi_cod_unidad_negocio,   --pi_cod_unidad_negocio,
                                                   v_fch_tran,   --pi_Fch_efectiva
                                                   po_cod_err,
                                                   po_msj_err
                                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END LOOP;

        --BAJA DE LOS LIMITES DE CREDITO Y CONSUMO
        FOR i IN clista_limite_credito
        LOOP
            cc_cl_limite_credito_ent_cons.desasignar
                                                    (i.id_entidad_consumo,   --pi_id_entidad_consumo,
                                                     i.cod_limite,
                                                     NULL,   --pi_id_proc_ems,
                                                     NULL,   --pi_id_orig_proc_ems,
                                                     NULL,   --pi_id_form_ems,
                                                     NULL,   --pi_id_orig_form_ems,
                                                     pi_cod_usuario,   --pi_cod_usuario,
                                                     v_id_tran,   --pi_id_tran,
                                                     v_cod_gestion_tran,   --pi_cod_gestion_tran,
                                                     v_fch_tran,   --pi_fch_tran,
                                                     pi_cod_unidad_negocio,   --pi_cod_unidad_negocio,
                                                     v_fch_tran,   --pi_Fch_efectiva
                                                     po_cod_err,
                                                     po_msj_err
                                                    );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END LOOP;

        --CAMBIAR EL ESTADO DEL NUMERO A RECICLADO
        po_cod_err := 'PVT-2733';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al invocar al proc. de reciclaje de numeros.
        cc_cl_numero_telefonico.cambiar_estado
                                          (pi_numero                      => v_reg_entidad_consumo.identificador_entidad,
                                           pi_estado                      => c_estado_telefono_reciclado,
                                           pi_cod_usuario                 => pi_cod_usuario,
                                           pi_master                      => c_falso,
                                           pi_id_tran                     => v_id_tran,
                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                           pi_fch_tran                    => v_fch_tran,
                                           pi_cod_unidad_negocio_tran     => pi_cod_unidad_negocio,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --Si el numero es portado y es CDMA liberamos el MIN
        IF     v_tipo_numero = c_tipo_numero_portin
           AND v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            po_cod_err := 'PVT-2734';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_NUMERO: Error al liberar el MIN.
            cc_cl_numero_telefonico.cambiar_estado
                                              (pi_numero                      => v_min,
                                               pi_estado                      => c_tipo_numero_viva,
                                               pi_estado_numero               => c_estado_telefono_disponible,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_master                      => c_falso,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio_tran     => pi_cod_unidad_negocio,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        --BAJA DE LA ENTIDAD DE CONSUMO
        po_cod_err := 'PVT-2735';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al invocar a CC_CL_ENTIDAD_CONSUMO.BAJA.
    cc_cl_entidad_consumo.baja (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                    pi_id_proc_ems                 => v_reg_entidad_consumo.id_proc_ems,
                                    pi_id_orig_proc_ems            => v_reg_entidad_consumo.id_orig_proc_ems,
                                    pi_id_form_ems                 => v_reg_entidad_consumo.id_form_ems,
                                    pi_id_orig_form_ems            => v_reg_entidad_consumo.id_orig_form_ems,
                                    pi_cod_usuario                 => pi_cod_usuario,
                                    pi_id_tran                     => v_id_tran,
                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                    pi_fch_tran                    => v_fch_tran,
                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                    pi_fch_efectiva                => v_fch_tran,
                                    po_cod_err                     => po_cod_err,
                                    po_msj_err                     => po_msj_err
                                   );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

         IF tx_pvt_ccs.se_provisiona (v_cod_linea_negocio) = c_verdadero AND v_reg_entidad_consumo.cod_tecnologia !='SAAS' THEN

            --BAJA EN DISPOSITIVOS
            --VPG--
            po_cod_err := 'PVT-5025'; --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al obtener el numero de orden vpg
            v_id_comando    :=  tx_vpg_util.get_comando(v_cod_servicio_act,v_reg_entidad_consumo.cod_forma_consumo,'DEL',v_reg_entidad_consumo.cod_tecnologia);
            po_cod_err := 'PVT-5026'; --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al al crear la orden vpg
            mt_vpg.alta_orden(
                    pi_id_comando               => v_id_comando,
                    pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_cod_transaccion          => c_tipo_transaccion,
                    pi_p1                       => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_p2                       => CASE WHEN  v_reg_entidad_consumo.cod_tecnologia = 'TV' THEN '00' ELSE v_reg_entidad_consumo.imsi END,
                    pi_p3                       => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_cod_usuario              => pi_cod_usuario,
                    pi_master                   => '0',
                    pi_id_tran                  => v_id_tran,
                    pi_cod_gestion_tran         => v_cod_gestion_tran,
                    pi_fch_tran                 => v_fch_tran,
                    pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                    po_id_orden                 => v_id_orden,
                    po_id_tran                  => po_id_tran,
                    po_fch_tran                 => po_fch_tran,
                    po_cod_err                  => po_cod_err,
                    po_msj_err                  => po_msj_err);

            IF (po_cod_err != 'OK') THEN
                RAISE err_app;

            END IF;
            ----

            --Baja en cl_lifecycle
            SELECT COUNT(1)
              INTO v_aplica_ciclo_vida
            FROM bm_plan_param pp
            WHERE pp.cod_plan = v_reg_entidad_consumo.cod_plan
              AND pp.cod_tipo_parametro = 'LIFE_CYCLE'
              AND pp.fch_tran_fin IS NULL;

            IF v_aplica_ciclo_vida != 0 THEN
                po_cod_err := 'PVT-5027'; --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al dar de baja el suscriptor en control ciclo de vida.
                tx_cl_lifecycle.delete_row(pi_internal_id        => pi_id_entidad_consumo,
                                           pi_transaction_reason => 'TERMINATION',
                                           pi_master             => c_falso,
                                           pi_tran_id            => v_id_tran,
                                           pi_tran_date          => v_fch_tran,
                                           pi_tran_user          => pi_cod_usuario,
                                           pi_tran_period        => v_cod_gestion_tran,
                                           po_cod_err            => po_cod_err,
                                           po_msj_err            => po_msj_err);

                IF po_cod_err != 'OK' THEN
                 RAISE err_app;
                END IF;
            END IF;

            -- 2017-01-18 GAC-Ericsson - Las ordenes de alta y baja portabilidad no seran necesarias ya que el switch interactuara directamente con el MNP - INICIO
            --IF (tx_cnf_constante.get_constante('ERS_PORTABILIDAD')='0') THEN
            po_cod_err := 'PVT-2738';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al determinar si es portado

            IF tx_por_utiles.es_portado (v_reg_entidad_consumo.identificador_entidad) = c_falso THEN
                -- BAJA_ENTIDAD_CONSUMO: BAJA DE NUMERO EN LA TABLA DE NUMEROS PORTADOS...
                IF v_reg_entidad_consumo.cod_tecnologia = 'GSM' THEN
                    DECLARE
                        v_id_orden                    NUMBER;
                        v_cod_err                     VARCHAR2 (200);
                        v_msj_err                     VARCHAR2 (200);
                    BEGIN
                        cc_ord_numero_portado_gsm.alta
                            (pi_numero                      => v_reg_entidad_consumo.identificador_entidad,
                             pi_lrn                         => NULL,
                             pi_provider_tag                => NULL,
                             pi_accion                      => 'DEL',
                             pi_cod_usuario                 => pi_cod_usuario,
                             pi_id_tran                     => v_id_tran,
                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                             pi_fch_tran                    => v_fch_tran,
                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                             pi_comentario                  =>    'TX_PVT_ENTIDAD_COMSUMO.BAJA_ENTIDAD_CONSUMO pi_id_entidad_consumo=>'
                                                               || pi_id_entidad_consumo,
                             po_id_orden                    => v_id_orden,
                             po_cod_err                     => v_cod_err,
                             po_msj_err                     => v_msj_err
                            );

                        IF (v_cod_err <> 'OK') THEN
                            po_cod_err    := v_cod_err;
                            po_msj_err    :=    'BAJA_ENTIDAD_CONSUMO. No su pudo dar de baja '
                                             || v_reg_entidad_consumo.identificador_entidad
                                             || ', en la tabla de numeros portados '
                                             || v_msj_err;
                            RAISE err_app;
                        END IF;
                    END;
                END IF;
            END IF;
            --END IF;
            -- 2017-01-18 GAC-Ericsson - Las ordenes de alta y baja portabilidad no seran necesarias ya que el switch interactuara directamente con el MNP - FIN

            -- EVDO CONTROLADO


            -- FIN EVDO CONTROLADO
            IF tx_bm_plan.es_evdo_prepago (v_reg_entidad_consumo.cod_plan) = c_verdadero THEN
                po_cod_err := 'PVT-2740';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: error al terminar el servicio evdo prepago.
                tx_evdo.terminar_servicio
                                (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        po_cod_err := 'PVT-2741';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al determinar el estado de la cuenta.

        SELECT estado
          INTO v_estado_comunidad
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        IF v_estado_comunidad NOT IN (c_estado_inactivo, 'TER') THEN
            po_cod_err := 'PVT-2742';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al verificar si la cuenta tiene suscriptores activos.

            SELECT COUNT (*)
              INTO v_susc_activos
              FROM cl_entidad_consumo ec
             WHERE ec.id_comunidad_facturante = v_reg_entidad_consumo.id_comunidad_facturante
               AND ec.estado NOT IN (c_estado_inactivo, 'TER', 'POST');

            IF v_susc_activos = 0 THEN
                po_cod_err := 'PVT-2743';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al terminar la cuenta.
                tx_pvt_comunidad.baja_comunidad
                      (pi_id_comunidad_facturante     => v_reg_entidad_consumo.id_comunidad_facturante,
                       pi_cod_motivo                  => pi_cod_motivo,
                       pi_cod_usuario                 => pi_cod_usuario,
                       pi_master                      => c_falso,
                       pi_id_tran                     => v_id_tran,
                       pi_cod_gestion_tran            => v_cod_gestion_tran,
                       pi_fch_tran                    => v_fch_tran,
                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                       po_id_tran                     => v_id_tran,
                       po_cod_gestion_tran            => v_cod_gestion_tran,
                       po_cod_err                     => po_cod_err,
                       po_msj_err                     => po_msj_err
                      );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        --REGISTRO TRANSACCIONAL POSTVENTA
        --IF pi_master = c_verdadero THEN
        po_cod_err := 'PVT-2744';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al obtener el id del cliente.
        v_id_cliente               := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        --- Registrar transaccion
        po_cod_err := 'PVT-2745';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
        cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => pi_cod_motivo,
                                   pi_cod_observacion             => NULL,
                                   pi_descripcion_observacion     => NULL,
                                   pi_valor_anterior              => NULL,
                                   pi_valor_nuevo                 => NULL,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --END IF;

        -- < ECN    200902017   RQX-954 Validar que si tiene inclusiones tenga por lo menos un principal.
        IF pi_master = c_verdadero THEN
            tx_pvt_ccs.validar_si_tiene_principal (v_reg_entidad_consumo.id_comunidad_facturante,
                                                   po_cod_err, po_msj_err);

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            -- <ECN    20100922   RQX-2419 Validar si la cuenta requiere de un minimo de suscriptores abiertos.
            tx_pvt_ccs.tiene_planes_dependientes (v_reg_entidad_consumo.id_comunidad_facturante,
                                                  po_cod_err, po_msj_err);

            IF po_cod_err <> 'OK' THEN
                po_cod_err := 'PVT-2746';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: El cliente tiene un suscriptor con un plan que depende del plan del presente suscriptor.
                RAISE err_app;
            END IF;
        -- ECN    20100922   RQX-2419 Validar si la cuenta requiere de un minimo de suscriptores abiertos. >
        END IF;

        -- ECN    200902017   RQX-954 Validar que si tiene inclusiones tenga por lo menos un principal. >

         ---Dar baja a los servicios de Universal...
        FOR servicio_seg IN (SELECT *
                               FROM cl_suscripcion_servicio cs
                              WHERE cs.id_entidad_consumo = pi_id_entidad_consumo
                                AND cs.estado = c_estado_activo
                                AND cs.fch_efectiva_fin = c_fecha_fin
                            )
        LOOP
            po_cod_err := 'PVT-2747';   --TX_PVT_ENTIDAD_CONSUMO.BAJA_ENTIDAD_CONSUMO: Erro al invocar procedimiento para dar debaja suscripcion de seguro.
            tx_cl_suscripcion_servicio.baja(pi_id_contrato          => servicio_seg.id_contrato,
                                            pi_motivo_terminacion   => 'MTSPAG',
                                            pi_id_tran              => v_id_tran,
                                            pi_fch_tran             => v_fch_tran,
                                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                                            pi_cod_usuario          => pi_cod_usuario,
                                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                            pi_master               => c_falso,
                                            po_cod_err              => po_cod_err,
                                            po_msj_err              => po_msj_err
                                            );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END LOOP;
        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                 := 'OK';
        po_msj_err                 := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    /*
    Purpose: [Registrar la reinstalacion de un suscriptor terminado]
    Date: 2007-11-19
    Author: [Edwin Maldonado]
    #param pi_id_entidad_consumo    Identificador de la Entidad de consumo (parametro de entrada)
    #param pi_identificador_entidad Numero de telefono (parametro de entrada)
    #param pi_cod_motivo            Motivo de la reinstalacion (parametro de entrada)
    #param pi_cod_usuario           Codigo del usuario que ejecuta la transaccion (parametro de entrada)
    #param pi_master                Indica si el procedimiento administrara transacciones o no (0-1) (parametro de entrada)
    #param pi_id_tran               Identificador de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_cod_gestion_tran      Codigo de la gestion de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_fch_tran              Fecha de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_cod_unidad_negocio    Codigo de la unidad de negocio (parametro de entrada)
    #param po_id_tran               Identificador de la transaccion (parametro de salida)
    #param po_cod_gestion_tran      Codigo de la gestion de la transaccion (parametro de salida)
    #param po_Cod_Err               En caso de existir error devuelve el codigo de error, sino 'OK' (parametro de salida)
    #param po_Msj_Err               En caso de existir error devuelve el mensaje del error, sino '' (parametro de salida)
    #Changes :
      <hr>
      Date :
      Author :
      Note :
      <hr>
    */
    --CID: VERIFICAR REGLAS DE COMPOSICION DE CUENTAS ATM PARA REINSTALACION
/*
    Purpose: [Registrar la reinstalacion de un suscriptor terminado]
    Date: 2007-11-19
    Author: [Edwin Maldonado]
    #param pi_id_entidad_consumo    Identificador de la Entidad de consumo (parametro de entrada)
    #param pi_identificador_entidad Numero de telefono (parametro de entrada)
    #param pi_cod_motivo            Motivo de la reinstalacion (parametro de entrada)
    #param pi_cod_usuario           Codigo del usuario que ejecuta la transaccion (parametro de entrada)
    #param pi_master                Indica si el procedimiento administrara transacciones o no (0-1) (parametro de entrada)
    #param pi_id_tran               Identificador de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_cod_gestion_tran      Codigo de la gestion de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_fch_tran              Fecha de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_cod_unidad_negocio    Codigo de la unidad de negocio (parametro de entrada)
    #param po_id_tran               Identificador de la transaccion (parametro de salida)
    #param po_cod_gestion_tran      Codigo de la gestion de la transaccion (parametro de salida)
    #param po_Cod_Err               En caso de existir error devuelve el codigo de error, sino 'OK' (parametro de salida)
    #param po_Msj_Err               En caso de existir error devuelve el mensaje del error, sino '' (parametro de salida)
    #Changes :
      <hr>
      Date : 2010-06-10
      Author : Pablo Herbas
      Note : Creacion de prospectos para la venta de reinstalacion de interjets libres
      <hr>
    */
    PROCEDURE reinstalacion (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_identificador_entidad  IN       cl_entidad_consumo.identificador_entidad%TYPE,
        pi_cod_motivo             IN       tx_transaccion_postventa.cod_motivo_transaccion%TYPE,
        pi_cod_plan               IN       bm_plan.cod_plan%TYPE,
        pi_id_entidad_venta       IN       vta_venta_entidad.id_venta_entidad%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_prospecto           OUT      vta_venta_reinstalacion.id_prospecto%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                           := tx_cnf_constante.get_constante ('TRANSACCION_REINST_ENTIDAD_CONSUMO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.REINSTALACION';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_nombre                      cl_persona.nombre%TYPE;
        v_apellidos                   cl_persona.apellido_paterno%TYPE;
        v_zona                        cl_direccion.zona_barrio_urb%TYPE;
        v_calle                       cl_direccion.calle_av_pasaje%TYPE;
        v_fecha_expiracion            DATE;
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_estado                      cl_numero_telefonico.estado%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_cod_servicio                bm_servicio.cod_servicio%TYPE;
        v_fch_fin                     DATE;
        v_reg_articulo                cl_articulo_entidad_consumo%ROWTYPE;
        v_id_registro                 NUMBER (15);
        v_reg_plan                    bm_plan%ROWTYPE;
        v_rowid_plan                  ROWID;
        v_monto_recarga               NUMBER (15, 2);
        v_tax1                        NUMBER (15, 2);
        v_tax2                        NUMBER (15, 2);
        v_tax3                        NUMBER (15, 2);
        v_dummy                       PLS_INTEGER;
        v_reg_periodo                 tr_periodo_facturacion%ROWTYPE;
        v_reg_comunidad               cl_comunidad%ROWTYPE;
        v_nro_documento               cta_doc_cuenta_corriente.nro_documento%TYPE;
        v_estado_numero               cl_numero_telefonico.estado_numero%TYPE;
        v_deuda_cuenta                cta_doc_cuenta_corriente.valor%TYPE;
        v_tiene_recarga               BOOLEAN;
        v_valor_impuesto              NUMBER;
        v_id_orden                    ord_numero_portado_gsm.id_orden%TYPE;
        v_sim                         cl_entidad_consumo.sim%TYPE;
        v_imsi                        cl_entidad_consumo.imsi%TYPE;
        v_ki                          cl_serial_sim.ki%TYPE;
        v_transport_key               cl_serial_sim.transport_key%TYPE;
        v_lrn                         por_cnf_lrn.lrn%TYPE;
        v_provider_tag                VARCHAR2 (100);
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_min                         cl_numero_telefonico.numero_telefonico%TYPE;
        v_tipo_numero                 cl_numero_telefonico.estado%TYPE;
        v_id_prospecto                vta_venta_reinstalacion.id_prospecto%TYPE;
        v_nombre_factura              VARCHAR2 (200);
        v_rnc_factura                 cl_persona.nit%TYPE;
        v_precio_venta_con_imp        bm_plan.tarifa_basica%TYPE;
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_id_venta_entidad            vta_venta_entidad.id_venta_entidad%TYPE;
        v_tipo_documento              cnf_cta_tipo_documento_cargo.cod_tipo_documento%TYPE;
        v_cod_categoria_documento     vta_venta_prospecto.cod_categoria_documento%TYPE;
        v_id_prospecto_detalle        vta_venta_prospecto_detalle.id_prospecto_detalle%TYPE;
        v_saldo_total                 VARCHAR2(4000);
        po_monto_vigente              NUMBER(17,5);
        po_saldo_vigente              NUMBER(17,5);
        po_cod_periodo_vigente        VARCHAR2(4000);
        po_monto_futuro               NUMBER(17,5);
        po_saldo_futuro               NUMBER(17,5);
        po_cod_periodo_futuro         VARCHAR2(4000);
        v_moto_plan                   NUMBER(17,5);
        v_cuenta_corriente            NUMBER(17,5);
        v_saldo_afavor                NUMBER(17,5);
        v_dias_terminado              NUMBER(17,5);

        --CVE: agregar variables para reintalacion GPON.
        c_to_mail                   CONSTANT CNF_CONSTANTE.VALOR%TYPE := TX_CNF_CONSTANTE.GET_CONSTANTE('EMAIL_GPON_INSTALACIONES');
        c_estado_instalacion        CONSTANT CNF_CONSTANTE.VALOR%TYPE := TX_CNF_CONSTANTE.GET_CONSTANTE('EDO_INSTALACION');
        v_mensaje                   VARCHAR2 (4000) := NULL;
        v_body                      mail_mensaje.body_%TYPE;
        v_id_mail                   mail_mensaje.id_mail%TYPE;
        v_subject                   mail_mensaje.subject%TYPE;

        CURSOR clista_componente_comunidad (pi_fch_tran IN DATE)
        IS
            SELECT *
              FROM (SELECT cc.id_comunidad,
                           cc.fch_fin,
                           cc.id_proc_ems,
                           cc.id_orig_proc_ems,
                           cc.id_form_ems,
                           cc.id_orig_form_ems,
                           MAX (fch_fin) OVER () max_fch_fin
                      FROM cl_componente_comunidad cc
                     WHERE id_entidad_consumo = pi_id_entidad_consumo
                       AND estado <> c_estado_inactivo
                       AND fch_fin < pi_fch_tran)
             WHERE fch_fin = max_fch_fin;

        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_identificador_entidad:'
            || pi_identificador_entidad
            || '|'
            || 'pi_cod_motivo:'
            || pi_cod_motivo
            || '|'
            || 'pi_cod_plan:'
            || pi_cod_plan
            || '|'
            || 'pi_id_entidad_venta:'
            || pi_id_entidad_venta
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2748';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2749';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2750';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------

        --EL SUSCRIPTOR DEBE ESTAR TERMINADO
        po_cod_err := 'PVT-2751';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al recuperar los datos de la entidad de consumo.

         SELECT *
          INTO v_reg_entidad_consumo
          FROM cl_entidad_consumo ec
         WHERE ec.id_entidad_consumo = pi_id_entidad_consumo;

        IF v_reg_entidad_consumo.estado <> c_estado_inactivo THEN
            po_cod_err := 'PVT-2752';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: El suscriptor no esta inactivo.
            RAISE err_app;
        END IF;

        --LA CUENTA NO DEBE TENER NINGUNA DEUDA PENDIENTE SI NO EXISTE NINGUN SUSCRIPTOR ACTIVO EN LA CUENTA
        po_cod_err := 'PVT-2753';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al determinar si la cuenta tiene suscriptores activos.

        SELECT COUNT (*)
          INTO v_dummy
          FROM cl_entidad_consumo ec
         WHERE ec.id_comunidad_facturante = v_reg_entidad_consumo.id_comunidad_facturante
           AND estado NOT IN (c_estado_inactivo, 'TER');

        po_cod_err := 'PVT-2754';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al recuperar la Comunidad

        SELECT *
          INTO v_reg_comunidad
          FROM cl_comunidad
         WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;


        IF v_reg_comunidad.estado = 'TER' AND v_reg_comunidad.cod_linea_negocio <> 'INTERF' THEN --CVE-GAC: excluir clientes gpon.
                     po_cod_err := 'PVT-2754';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: La cuenta no puede estar terminada.
                     RAISE err_app;
        END IF;

        IF v_dummy = 0 AND cc_vta_excepcion.has_texprs(v_reg_entidad_consumo.id_entidad_consumo) = 0 THEN

            -- RQX 6698 - Modificar proceso generacion penalidad -- INICIO
            IF v_reg_comunidad.cod_linea_negocio in ('POSCON','FIJCON') THEN
                po_cod_err := 'PVT-2755';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al determinar la deuda de la cuenta.
                -- llamando funcion para validar deuda hibrida
                tx_bl_facturador_individual.calcular_deuda_hibrido(v_reg_entidad_consumo.id_comunidad_facturante,
                                                         pi_cod_usuario,
                                                         pi_master,
                                                         pi_id_tran,
                                                         v_cod_gestion_tran,
                                                         pi_fch_tran,
                                                         pi_cod_unidad_negocio,
                                                         po_monto_vigente,
                                                         po_saldo_vigente,
                                                         po_cod_periodo_vigente,
                                                         po_monto_futuro,
                                                         po_saldo_futuro,
                                                         po_cod_periodo_futuro,
                                                         po_cod_err,po_msj_err);
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END iF;

                IF po_saldo_vigente > 0 THEN
                    po_cod_err := 'PVT-2756';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: El cliente tiene deuda pendiente, debe hacer el pago para continuar con la reinstalación.
                    RAISE err_app;
                END IF;
            END IF;
            -- RQX 6698 - Modificar proceso generacion penalidad -- FIN


            po_cod_err := 'PVT-2757';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al determinar la deuda de la cuenta.
            v_deuda_cuenta    :=
                      tx_cta_cuenta_corriente.get_deuda_total (v_reg_comunidad.id_cuenta_corriente);

            IF v_deuda_cuenta > 1 THEN
                po_cod_err := 'PVT-2758';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: La cuenta tiene deuda pendiente.
                RAISE err_app;
            END IF;
        END IF;

        --EL NUMERO DEBE ESTAR DISPONIBLE
        po_cod_err := 'PVT-2759';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al determinar el estado del numero telefonico.

        SELECT estado_numero, estado
          INTO v_estado_numero, v_estado
          FROM cl_numero_telefonico n
         WHERE n.numero_telefonico = pi_identificador_entidad;

        IF v_estado_numero NOT IN ('1', 'X') THEN
            po_cod_err := 'PVT-2760';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: El numero telefonico no esta disponible.
            RAISE err_app;
        END IF;

        --Validamos que el suscriptor haya sido terminado hace mas de 24 horas por un control del Charging System
        SELECT TRUNC(v_fch_tran) - TRUNC(v_reg_entidad_consumo.fch_tran)
          INTO v_dias_terminado
        FROM DUAL;

        IF ((v_dias_terminado < 2 OR v_dias_terminado > 60) AND v_estado <> 'PORTIN')
            OR (v_dias_terminado < 2 AND v_estado = 'PORTIN') THEN
           po_cod_err := 'PVT-5125'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: El suscriptor debe tener 24 horas o mas de haber sido terminado.  CVE-CID: se cambia esta condicion.
           RAISE err_app;
        END IF;

        /* INICIO - RQX 5385 Cobrar Renta por Adelantado a Cuentas Terminadas que soliciten Reinstalación */
         IF es_hibrida(v_reg_entidad_consumo.id_comunidad_facturante) = c_verdadero THEN

            -- llamando funcion para validar deuda hibrida
            tx_bl_facturador_individual.calcular_deuda_hibrido(v_reg_entidad_consumo.id_comunidad_facturante,
                                                     pi_cod_usuario,
                                                     pi_master,
                                                     pi_id_tran,
                                                     v_cod_gestion_tran,
                                                     pi_fch_tran,
                                                     pi_cod_unidad_negocio,
                                                     po_monto_vigente,
                                                     po_saldo_vigente,
                                                     po_cod_periodo_vigente,
                                                     po_monto_futuro,
                                                     po_saldo_futuro,
                                                     po_cod_periodo_futuro,
                                                     po_cod_err,po_msj_err);

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END iF;

            IF po_saldo_vigente > 0 THEN
                po_cod_err := 'PVT-2761';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: El cliente tiene deuda pendiente, debe hacer el pago para continuar con la reinstalación.
                RAISE err_app;
            END IF;

          -- cargando la tarifa del plan
            select (tarifa_basica *(select (SELECT 1+ nvl(SUM (valor_porcentual) / 100 , 0) as itb
                                        FROM bl_impuesto
                                        WHERE cod_impuesto IN (
                                            SELECT cod_impuesto
                                            FROM bl_cargo_impuesto
                                            WHERE id_cargo_impuesto = 42
                                            AND estado = 'A'
                                            AND fch_fin_vigencia > SYSDATE)
                                      ) as suma from dual)
                      ) as tarifa_basica
              into v_moto_plan
              from bm_plan
             where cod_plan = v_reg_entidad_consumo.cod_plan
               and estado = 'A';

            SELECT NVL (SUM (a.saldo*a.signo), 0)
              INTO v_saldo_total
              FROM cta_doc_cuenta_corriente a
             WHERE id_cuenta_corriente = get_id_cc(v_reg_entidad_consumo.id_comunidad_facturante)
               AND a.estado = 'ABIER'
               AND saldo > 0;
             -- validando que el usuario pago el valor del plan
            IF v_moto_plan > v_saldo_total AND v_reg_comunidad.cod_linea_negocio <> 'INTERF' THEN --CVE-GAC: excluir clientes gpon.
                po_cod_err    :='PVT-4337 El cliente debe realizar un pago por adelantado de una factura. Monto: '|| v_moto_plan;
                RAISE err_app;
            END IF;

            /*po_cod_err    :='saldo a favor :'||v_deuda_cuenta||' monto de plan: '||v_moto_plan||'.'|| po_monto_vigente||'-'||po_saldo_vigente||'--'|| po_monto_futuro||'---'||po_saldo_futuro;   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: La cuenta tiene deuda pendiente.
            RAISE err_app;*/
        END IF;
        /* FINAL - RQX 5385 Cobrar Renta por Adelantado a Cuentas Terminadas que soliciten Reinstalación */

--PHC inicio---------------------------------------------------------------------------------------------------------
--Si el pi_cod_plan no es nulo entonces creamos prospectos de venta, caso contrario pasamos a consolidar
        IF pi_cod_plan IS NOT NULL THEN
            po_cod_err := 'PVT-2762';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al recuperar los datos del plan.

            SELECT *
              INTO v_reg_plan
              FROM bm_plan bp
             WHERE bp.cod_plan = pi_cod_plan;

            po_cod_err := 'PVT-2763';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Tiene un prospecto pendiente

            SELECT COUNT (1)
              INTO v_dummy
              FROM vta_venta_reinstalacion
             WHERE id_entidad_consumo = pi_id_entidad_consumo
               AND estado = c_estado_activo
               AND fch_fin = c_fecha_fin;

            IF v_dummy > 0 THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2764';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al determinar el monto con impuestos.
            tx_pvt_ccs.get_impuestos (v_reg_plan.tarifa_basica,
                                      c_cargo_tbm,
                                      v_precio_venta_con_imp,
                                      v_tax1,
                                      v_tax2,
                                      v_tax3
                                     );
            -- Insercion en la tabla vta_venta_reinstalacion
            po_cod_err := 'PVT-2765';   --TX_PVT_ENTIDAD_CONSUMO.reinstalacion: Error al invocar a CC_VTA_VENTA_REINSTALACION.ALTA
            cc_vta_venta_reinstalacion.alta
                                  (pi_cod_plan                    => pi_cod_plan,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_precio_venta                => v_precio_venta_con_imp,
                                   pi_estado                      => c_estado_activo,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_id_prospecto                => v_id_prospecto,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            po_id_prospecto    := v_id_prospecto;
            -- REGISTRO DE LA ENTIDAD VENTA
            po_cod_err := 'PVT-2766';   --TX_PVT_ENTIDAD_CONSUMO.reinstalacion: Error al registrar la entidad de venta relacionada.
            cc_vta_venta_entidad.alta (pio_id_prospecto               => v_id_prospecto,
                                       pi_cod_tipo_venta              => 'TX_PVT_EC_REINSTALACION',
                                       pi_id_entidad_venta            => pi_id_entidad_venta,
                                       pi_cod_usuario_asignado        => pi_cod_usuario,
                                       pi_cod_usuario_digitador       => pi_cod_usuario,
                                       pi_fch_venta                   => v_fch_tran,
                                       pi_cod_usuario                 => pi_cod_usuario,
                                       pi_id_tran                     => v_id_tran,
                                       pi_cod_gestion_tran            => v_cod_gestion_tran,
                                       pi_fch_tran                    => v_fch_tran,
                                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                       po_id_venta_entidad            => v_id_venta_entidad,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2767';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al crear el detalle de la venta
            tx_pvt_ccs.alta_venta_detalle (pio_id_venta                   => v_id_venta,
                                           pi_id_prospecto                => v_id_prospecto,
                                           pi_id_cargo                    => c_cargo_tbm,
                                           pi_cod_tipo_documento          => 'RINJLI',
                                           pi_valor_venta                 => v_reg_plan.tarifa_basica,
                                           pi_cod_tipo                    => 'E',
                                           pi_estado                      => c_estado_activo,
                                           pi_cod_usuario                 => pi_cod_usuario,
                                           pi_master                      => c_falso,
                                           pi_id_tran                     => v_id_tran,
                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                           pi_fch_tran                    => v_fch_tran,
                                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                           po_valor                       => v_precio_venta_con_imp,
                                           po_id_prospecto_detalle        => v_id_prospecto_detalle,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            --CREACION DEL PROSPECTO DE VENTA DEL SERVICIO ---------------------------------------------------
            BEGIN
                po_cod_err := 'PVT-2768';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al recuperar el RNC y nombre a facturar.

                SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                       p.nit
                  INTO v_nombre_factura,
                       v_rnc_factura
                  FROM cl_persona p, cl_datos_facturacion df
                 WHERE df.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                   AND df.id_persona = p.id_persona
                   AND df.estado <> c_estado_inactivo
                   AND df.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    SELECT cc.id_cliente
                      INTO v_id_cliente
                      FROM cl_cliente_comunidad cc
                     WHERE cc.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                       AND cc.fch_fin = c_fecha_fin;

                    SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                           p.nit
                      INTO v_nombre_factura,
                           v_rnc_factura
                      FROM cl_persona p, cl_cliente c
                     WHERE c.id_cliente = v_id_cliente AND p.id_persona = c.id_persona;
            END;

            po_cod_err := 'PVT-2769';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al invocar al procedimiento TX_BL_DOSIFICACION.GET_COD_CATEGORIA_DOCUMENTO.
            tx_bl_dosificacion.get_cod_categoria_documento
                                  (pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   po_cod_categoria_documento     => v_cod_categoria_documento,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err);

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2770';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al invocar al procedimiento de registro del prospecto de venta.
            tx_pvt_ccs.alta_venta (pi_id_prospecto                => v_id_prospecto,
                                   pi_nombre_factura              => v_nombre_factura,
                                   pi_nit                         => v_rnc_factura,
                                   pi_cod_categoria_documento     => v_cod_categoria_documento,
                                   pi_estado                      => c_estado_activo,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_master                      => c_falso,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_valor                       => v_precio_venta_con_imp,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        ELSE   --cod_plan es nulo, entonces pasamos a consolidar no hay nada que cobrar
            IF v_reg_entidad_consumo.cod_tecnologia = 'FIBRA' THEN  --CVE: para proceso de reinstalacion GPON.

                po_cod_err := 'PVT-2754';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al recuperar la Comunidad
                cc_cl_comunidad.cambia_estado (pi_id_comunidad                => v_reg_comunidad.id_comunidad,
                                               pi_estado                      => c_estado_instalacion,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               pi_fch_efectiva                => v_fch_tran,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-2751';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al recuperar los datos de la entidad de consumo.
                cc_cl_entidad_consumo.cambia_estado (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                     pi_estado                      => c_estado_instalacion,
                                                     pi_cod_usuario                 => pi_cod_usuario,
                                                     pi_id_tran                     => v_id_tran,
                                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                     pi_fch_tran                    => v_fch_tran,
                                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                     pi_fch_efectiva                => v_fch_tran,
                                                     po_cod_err                     => po_cod_err,
                                                     po_msj_err                     => po_msj_err
                                                    );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            ELSE
                po_cod_err := 'PVT-2771';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al invocar a TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION
                reinstalacion_consolidacion (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                             pi_identificador_entidad       => pi_identificador_entidad,
                                             pi_cod_motivo                  => pi_cod_motivo,
                                             pi_cod_usuario                 => pi_cod_usuario,
                                             pi_id_prospecto                => v_id_prospecto,
                                             pi_master                      => c_falso,
                                             pi_id_tran                     => v_id_tran,
                                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                                             pi_fch_tran                    => v_fch_tran,
                                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                             po_id_tran                     => po_id_tran,
                                             po_cod_gestion_tran            => po_cod_gestion_tran,
                                             po_cod_err                     => po_cod_err,
                                             po_msj_err                     => po_msj_err
                                            );

                IF po_cod_err != 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;

            po_cod_err := 'PVT-2772';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION: Error al invocar al procedimiento de registro transaccional de postventa.
            cc_tx_transaccion_postventa.alta
                                 (pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_cod_tipo                    => c_tipo_transaccion,
                                  pi_id_cliente                  => get_id_cl(v_reg_entidad_consumo.id_comunidad_facturante),
                                  pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                  pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                  pi_cod_motivo_transaccion      => pi_cod_motivo,
                                  pi_cod_observacion             => NULL,
                                  pi_descripcion_observacion     => NULL,
                                  pi_valor_anterior              => NULL,
                                  pi_valor_nuevo                 => NULL,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        --RAISE err_app;
        END IF;   --fin IF pi_cod_plan <> NULL

        --CVE: Notificacion interna Renistalacion de clientes GPON, 23/01/2025.
        IF  (v_reg_comunidad.cod_linea_negocio = 'INTERF') AND c_to_mail IS NOT NULL THEN
                FOR curGPON IN
                           (
                           SELECT ec.identificador_entidad as numero,
                           (TRIM(p.nombre)||' '||TRIM(p.apellido_paterno)) AS cliente,
                           ec.id_comunidad_facturante,
                           ec.cod_plan as codigo_plan,
                           b.descripcion as descripcion_plan,
                           b.tarifa_basica as renta_plan,

                           (select valor from cl_persona_dato pd1
                            where id_persona=df.id_persona
                            and fch_fin>sysdate
                            and cod_tipo_dato='TDTFIJ') as telefono_1,

                           (select valor from cl_persona_dato pd1
                            where id_persona=df.id_persona
                            and fch_fin>sysdate
                            and cod_tipo_dato='TDTFI2') as telefono_2,

                           cc.descripcion as ciudad,
                           cp.descripcion as provincia,
                           'Sector: '||cd.zona_barrio_urb||' Calle: '||calle_av_pasaje||' Entre'||entre_calle_1
                               ||' y'||entre_calle_2||' Edif.: '||edificio||' Piso:'||piso||' Apto: '||departamento
                               ||' Num:'||numero||' SubSector:'||sub_sector as direccion,
                           cd.observacion as localizacion

                      FROM cl_comunidad c,
                           cl_entidad_consumo ec,
                           bm_plan b,
                           cl_persona p,
                           cl_datos_facturacion df,
                           cl_direccion cd,
                           cnf_ciudad cc,
                           cnf_provincia cp

                     WHERE c.id_comunidad = v_reg_comunidad.id_comunidad
                       AND c.estado NOT IN ('I', 'POST', 'TER')
                       AND c.id_comunidad = ec.id_comunidad_facturante
                       AND ec.estado NOT IN ('I', 'POST', 'TER')
                       AND ec.cod_tecnologia = 'FIBRA'
                       AND ec.cod_plan = b.cod_plan
                       AND ec.id_entidad_consumo = pi_id_entidad_consumo
                       AND ec.id_persona = p.id_persona
                       AND c.id_comunidad = df.id_comunidad
                       AND df.estado = 'A'
                       AND df.fch_fin > SYSDATE
                       AND df.id_persona = p.id_persona
                       AND p.id_persona = cd.id_persona
                       AND df.id_direccion=cd.id_direccion
                       AND cd.cod_ciudad=cc.cod_ciudad
                       AND cd.cod_provincia=cp.cod_provincia
                       AND ROWNUM=1)
                LOOP

                    SELECT mensaje
                        INTO v_mensaje
                    FROM cnf_notificacion_orquestador
                    WHERE cod_proceso='NOTIGPON';

                    IF v_mensaje IS NOT NULL THEN

                        v_mensaje   := REPLACE(v_mensaje,'ACTIVACION INTERNET FIBRA','REINSTALACION INTERNET FIBRA');
                        v_mensaje   := REPLACE(v_mensaje,'${reg.numero}',curGPON.numero);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_nombres}',curGPON.cliente);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_codigo_plan}',curGPON.codigo_plan);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_descripcion_plan}',curGPON.descripcion_plan);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_renta_plan}',curGPON.renta_plan);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_telefono_1}',curGPON.telefono_1);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_telefono_2}',curGPON.telefono_2);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_ciudad}',curGPON.ciudad);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_provincia}',curGPON.provincia);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_direccion}',curGPON.direccion);
                        v_mensaje   := REPLACE(v_mensaje,'${v_email_localizacion}',curGPON.localizacion);

                        tx_mail_mensaje.alta (pi_id_origen                   => NULL,
                                              pi_id_documento                => NULL,
                                              pi_to                          => c_to_mail,
                                              pi_subject                     => 'REINSTALACION CLIENTES GPON',
                                              pi_body                        => v_mensaje,
                                              pi_attach_file                 => NULL,
                                              pi_fecha_programado            => v_fch_tran,
                                              pi_cod_usuario                 => pi_cod_usuario,
                                              pi_master                      => c_falso,
                                              pi_id_tran                     => v_id_tran,
                                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                                              pi_fch_tran                    => v_fch_tran,
                                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                              po_id_mail                     => v_id_mail,
                                              po_cod_err                     => po_cod_err,
                                              po_msj_err                     => po_msj_err
                                             );

                        IF po_cod_err != 'OK' THEN
                            RAISE err_app;
                        END IF;

                    END IF;
                END LOOP;
        END IF;


--PHC finito---------------------------------------------------------------------------------------------------------

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;   --FIN REINSTALACION

    /*
    Purpose: [Registrar la reinstalacion de un suscriptor terminado]
    Date: 2007-11-19
    Author: [Edwin Maldonado]
    #param pi_id_entidad_consumo    Identificador de la Entidad de consumo (parametro de entrada)
    #param pi_identificador_entidad Numero de telefono (parametro de entrada)
    #param pi_cod_motivo            Motivo de la reinstalacion (parametro de entrada)
    #param pi_cod_usuario           Codigo del usuario que ejecuta la transaccion (parametro de entrada)
    #param pi_master                Indica si el procedimiento administrara transacciones o no (0-1) (parametro de entrada)
    #param pi_id_tran               Identificador de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_cod_gestion_tran      Codigo de la gestion de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_fch_tran              Fecha de la transaccion cuando pi_master es FALSO (parametro de entrada)
    #param pi_cod_unidad_negocio    Codigo de la unidad de negocio (parametro de entrada)
    #param po_id_tran               Identificador de la transaccion (parametro de salida)
    #param po_cod_gestion_tran      Codigo de la gestion de la transaccion (parametro de salida)
    #param po_Cod_Err               En caso de existir error devuelve el codigo de error, sino 'OK' (parametro de salida)
    #param po_Msj_Err               En caso de existir error devuelve el mensaje del error, sino '' (parametro de salida)
    #Changes :
      <hr>
      Date : 2010-06-10
      Author : Pablo Herbas
      Note : Separar REINSTALACION en dos partes, reinstalacion y reinstalacion_consolidacion
      <hr>
    */
    PROCEDURE reinstalacion_consolidacion (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_identificador_entidad  IN       cl_entidad_consumo.identificador_entidad%TYPE,
        pi_cod_motivo             IN       tx_transaccion_postventa.cod_motivo_transaccion%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_id_prospecto           IN       vta_venta_reinstalacion.id_prospecto%TYPE,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                            := tx_cnf_constante.get_constante ('TRANS_REINST_CONS_ENTIDAD_CONSUMO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.REINSTALACION';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_nombre                      cl_persona.nombre%TYPE;
        v_apellidos                   cl_persona.apellido_paterno%TYPE;
        v_zona                        cl_direccion.zona_barrio_urb%TYPE;
        v_calle                       cl_direccion.calle_av_pasaje%TYPE;
        v_fecha_expiracion            VARCHAR2 (25);
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_cod_servicio                bm_servicio.cod_servicio%TYPE;
        v_fch_fin                     DATE;
        v_reg_articulo                cl_articulo_entidad_consumo%ROWTYPE;
        v_id_registro                 NUMBER (15);
        v_reg_plan                    bm_plan%ROWTYPE;
        v_rowid_plan                  ROWID;
        v_monto_recarga               NUMBER (15, 2);
        v_tax1                        NUMBER (15, 2);
        v_tax2                        NUMBER (15, 2);
        v_tax3                        NUMBER (15, 2);
        v_dummy                       PLS_INTEGER;
        v_reg_periodo                 tr_periodo_facturacion%ROWTYPE;
        v_reg_comunidad               cl_comunidad%ROWTYPE;
        v_nro_documento               cta_doc_cuenta_corriente.nro_documento%TYPE;
        v_estado_numero               cl_numero_telefonico.estado_numero%TYPE;
        v_deuda_cuenta                cta_doc_cuenta_corriente.valor%TYPE;
        v_tiene_recarga               BOOLEAN;
        v_valor_impuesto              NUMBER;
        v_id_orden                    ord_numero_portado_gsm.id_orden%TYPE;
        v_sim                         cl_entidad_consumo.sim%TYPE;
        v_imsi                        cl_entidad_consumo.imsi%TYPE;
        v_ki                          cl_serial_sim.ki%TYPE;
        v_transport_key               cl_serial_sim.transport_key%TYPE;
        v_lrn                         por_cnf_lrn.lrn%TYPE;
        v_provider_tag                VARCHAR2 (100);
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_min                         cl_numero_telefonico.numero_telefonico%TYPE;
        v_tipo_numero                 cl_numero_telefonico.estado%TYPE;
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_id_prospecto                vta_venta_reinstalacion.id_prospecto%TYPE;
        v_tiempo_obligatorio_contrato bm_plan.tiempo_obligatorio_contrato%TYPE;
        v_cod_plan                    vta_venta_reinstalacion.cod_plan%TYPE;
        v_servicio_bb                 bm_servicio.cod_servicio%TYPE;
        v_cos                         VARCHAR2(100);
        v_supcos                      VARCHAR2(100);
        v_tmp_identificador_entidad   VARCHAR2 (20);
        v_command_id                  vpg_cnf_comando.id_comando%TYPE;
        v_bm_plan                     bm_plan%ROWTYPE;
        v_refill_profile_id           cnf_vigencia_carga.refill_profile_id%TYPE;
        v_bolsillos_cs                tx_ecms.type_ecms_bolsilos;
        v_cod_enlace                 VARCHAR2(25);
        v_es_usim                    NUMBER;
        v_pam_class_id               VARCHAR2(25);
        v_pam_schedule_id            VARCHAR2(25);

        CURSOR clista_componente_comunidad (pi_fch_tran IN DATE)
        IS
            SELECT *
              FROM (SELECT cc.id_comunidad,
                           cc.fch_fin,
                           cc.id_proc_ems,
                           cc.id_orig_proc_ems,
                           cc.id_form_ems,
                           cc.id_orig_form_ems,
                           MAX (fch_fin) OVER () max_fch_fin
                      FROM cl_componente_comunidad cc
                     WHERE id_entidad_consumo = pi_id_entidad_consumo
                       AND estado <> c_estado_inactivo
                       AND fch_fin < pi_fch_tran)
             WHERE fch_fin = max_fch_fin;

        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                 :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_identificador_entidad:'
            || pi_identificador_entidad
            || '|'
            || 'pi_cod_motivo:'
            || pi_cod_motivo
            || '|'
            || 'pi_id_prospecto:'
            || pi_id_prospecto
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2773';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2774';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2775';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                 := v_id_tran;
        po_cod_gestion_tran        := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        --EL SUSCRIPTOR DEBE ESTAR TERMINADO
        po_cod_err := 'PVT-2776';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al recuperar los datos de la entidad de consumo.

        SELECT *
          INTO v_reg_entidad_consumo
          FROM cl_entidad_consumo ec
         WHERE ec.id_entidad_consumo = pi_id_entidad_consumo;

        IF v_reg_entidad_consumo.estado <> c_estado_inactivo THEN
            po_cod_err := 'PVT-2777';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: El suscriptor no esta inactivo.
            RAISE err_app;
        END IF;

        --LA CUENTA NO DEBE TENER NINGUNA DEUDA PENDIENTE SI NO EXISTE NINGUN SUSCRIPTOR ACTIVO EN LA CUENTA
        po_cod_err := 'PVT-2778';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar si la cuenta tiene suscriptores activos.

        SELECT COUNT (*)
          INTO v_dummy
          FROM cl_entidad_consumo ec
         WHERE ec.id_comunidad_facturante = v_reg_entidad_consumo.id_comunidad_facturante
           AND estado NOT IN (c_estado_inactivo, 'TER');

        po_cod_err := 'PVT-2779';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al recuperar la Comunidad

        SELECT *
          INTO v_reg_comunidad
          FROM cl_comunidad
         WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        po_cod_err := 'PVT-5113'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al recuperar los datos del plan.
        SELECT *
         INTO v_bm_plan
        FROM bm_plan
        WHERE cod_plan = v_reg_entidad_consumo.cod_plan;

        IF ( v_dummy = 0 AND cc_vta_excepcion.has_texprs(v_reg_entidad_consumo.id_entidad_consumo)=0 ) THEN
            po_cod_err := 'PVT-2780';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar la deuda de la cuenta.
            tx_pvt_ccs.get_total_deuda
                                 (pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                  pi_id_entidad_consumo          => NULL,
                                  pi_cod_tipo_corte              => NULL,
                                  pi_cod_motivo                  => NULL,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_total_deuda                 => v_deuda_cuenta,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            IF v_deuda_cuenta > 1 THEN
                po_cod_err := 'PVT-2781';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: La cuenta tiene deuda pendiente.
                RAISE err_app;
            END IF;
        END IF;

        --EL NUMERO DEBE ESTAR DISPONIBLE
        po_cod_err := 'PVT-2782';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar el estado del numero telefonico.

        SELECT estado_numero
          INTO v_estado_numero
          FROM cl_numero_telefonico n
         WHERE n.numero_telefonico = pi_identificador_entidad;

        IF v_estado_numero NOT IN ('1', 'X') THEN
            po_cod_err := 'PVT-2783';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: El numero telefonico no esta disponible.
            RAISE err_app;
        END IF;

        --PRIMERO REACTIVAR LA CUENTA
        IF v_reg_comunidad.estado = c_estado_inactivo THEN
            cc_cl_comunidad.cambia_estado (pi_id_comunidad                => v_reg_comunidad.id_comunidad,
                                           pi_estado                      => c_estado_activo,
                                           pi_cod_usuario                 => pi_cod_usuario,
                                           pi_id_tran                     => v_id_tran,
                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                           pi_fch_tran                    => v_fch_tran,
                                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                           pi_fch_efectiva                => v_fch_tran,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --- CAMBIO DE ESTADO DEL SUSCRIPTOR A ACTIVO
        po_cod_err := 'PVT-2784';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar al proc. de reinstalacion del suscriptor.
        cc_cl_entidad_consumo.cambia_estado (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                             pi_estado                      => c_estado_activo,
                                             pi_id_proc_ems                 => NULL,
                                             pi_id_orig_proc_ems            => NULL,
                                             pi_id_form_ems                 => NULL,
                                             pi_id_orig_form_ems            => NULL,
                                             pi_cod_usuario                 => pi_cod_usuario,
                                             pi_id_tran                     => v_id_tran,
                                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                                             pi_fch_tran                    => v_fch_tran,
                                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                             pi_fch_efectiva                => v_fch_tran,
                                             po_cod_err                     => po_cod_err,
                                             po_msj_err                     => po_msj_err
                                            );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --DETERMINAR EL ESN CON EL QUE SE TERMINO
        BEGIN
            po_cod_err := 'PVT-2785';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar el equipo para la reinstalacion.

            SELECT cod_rubro_articulo,
                   cod_articulo,
                   nro_serie
              INTO v_reg_articulo.cod_rubro_articulo,
                   v_reg_articulo.cod_articulo,
                   v_reg_articulo.nro_serie
              FROM (SELECT aec.cod_rubro_articulo,
                           aec.cod_articulo,
                           aec.nro_serie,
                           aec.fch_fin,
                           MAX (aec.fch_fin) OVER () max_fch_fin
                      FROM cl_articulo_entidad_consumo aec
                     WHERE aec.id_entidad_consumo = pi_id_entidad_consumo
                       AND aec.estado <> c_estado_inactivo
                       AND aec.cod_rubro_articulo IN ('TACDMA', 'TAGSM')
                       AND aec.fch_fin < v_fch_tran)
             WHERE fch_fin = max_fch_fin;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                v_reg_articulo.cod_rubro_articulo    := c_rubro_telefono;
                v_reg_articulo.cod_articulo          := 'OTROS';
                v_reg_articulo.nro_serie             := v_reg_entidad_consumo.imsi;
        END;

        --ASIGNACION DEL EQUIPO
        po_cod_err := 'PVT-2786';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar al procedimiento de asignacion de equipo.
        cc_cl_articulo_entidad_consumo.asignar
                                        (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                         pi_cod_rubro_articulo          => v_reg_articulo.cod_rubro_articulo,
                                         pi_cod_articulo                => v_reg_articulo.cod_articulo,
                                         pi_nro_serie                   => v_reg_articulo.nro_serie,
                                         pi_precio_venta                => v_reg_articulo.precio_venta,
                                         pi_cod_moneda                  => v_reg_articulo.cod_moneda,
                                         pi_precio_nominal              => v_reg_articulo.precio_nominal,
                                         pi_bonificacion                => v_reg_articulo.bonificacion,
                                         pi_descuento                   => v_reg_articulo.descuento,
                                         pi_cod_promocion               => v_reg_articulo.cod_promocion,
                                         pi_cod_plan_venta              => v_reg_articulo.cod_plan_venta,
                                         pi_id_proc_ems                 => v_reg_articulo.id_proc_ems,
                                         pi_id_orig_proc_ems            => v_reg_articulo.id_orig_proc_ems,
                                         pi_id_form_ems                 => v_reg_articulo.id_form_ems,
                                         pi_id_orig_form_ems            => v_reg_articulo.id_orig_form_ems,
                                         pi_cod_usuario                 => pi_cod_usuario,
                                         pi_id_tran                     => v_id_tran,
                                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                                         pi_fch_tran                    => v_fch_tran,
                                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                         pi_fch_efectiva                => v_fch_tran,
                                         po_id_registro                 => v_id_registro,
                                         po_cod_err                     => po_cod_err,
                                         po_msj_err                     => po_msj_err
                                        );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --ALTA DE ASOCIACIONES A LA COMUNIDAD FACTURANTE Y A LA HABLANTE
        po_cod_err := 'PVT-2787';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar las comunidades a relacionar.

        FOR i IN clista_componente_comunidad (v_fch_tran)
        LOOP
            po_cod_err := 'PVT-2788';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar al proc. de asignacion a comunidad.
            cc_cl_componente_comunidad.asignar (pi_id_comunidad                => i.id_comunidad,
                                                pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                pi_id_proc_ems                 => i.id_proc_ems,
                                                pi_id_orig_proc_ems            => i.id_orig_proc_ems,
                                                pi_id_form_ems                 => i.id_form_ems,
                                                pi_id_orig_form_ems            => i.id_orig_form_ems,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                pi_fch_efectiva                => v_fch_tran,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END LOOP;

        --ALTA EN TR_IMSI_HISTORICO
        po_cod_err := 'PVT-2789';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar al proc. de reinstalacion del numero.
        cc_tr_imsi_historico.alta (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_id_entidad_consumo_vpn      => NULL,
                                   pi_imsi                        => v_reg_entidad_consumo.imsi,
                                   pi_sim                         => v_reg_entidad_consumo.sim,
                                   pi_puk                         => v_reg_entidad_consumo.puk,
                                   pi_identificador_entidad       => pi_identificador_entidad,
                                   pi_numero_corto                => NULL,
                                   pi_id_proc_ems                 => v_reg_entidad_consumo.id_proc_ems,
                                   pi_id_orig_proc_ems            => v_reg_entidad_consumo.id_orig_proc_ems,
                                   pi_id_form_ems                 => v_reg_entidad_consumo.id_form_ems,
                                   pi_id_orig_form_ems            => v_reg_entidad_consumo.id_orig_form_ems,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_efectiva                => v_fch_tran,
                                   po_id_registro                 => v_id_registro,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --DATOS DEL PLAN ACTUAL
        po_cod_err := 'PVT-2790';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al obtener los datos del plan.
        tx_bm_plan.get_entidad (v_reg_entidad_consumo.cod_plan,
                                pi_cod_usuario,
                                v_reg_plan,
                                v_rowid_plan,
                                po_cod_err,
                                po_msj_err
                               );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2791';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al recuperar el rango del customer_group

        IF tx_por_utiles.get_customer_group_rango (v_reg_entidad_consumo.identificador_entidad) IS NOT NULL THEN
            v_reg_plan.customer_group    :=
                tx_por_utiles.get_customer_group_rango (v_reg_entidad_consumo.identificador_entidad);
        END IF;

        --ALTA EN TR_CAMBIO_PLAN_HISTORICO
        po_cod_err := 'PVT-2792';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar al proc. de reinstalacion del plan.
        cc_tr_cambio_plan_historico.alta
                                 (pi_cod_unidad_negocio          => v_reg_entidad_consumo.cod_unidad_negocio,
                                  pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                  pi_cod_plan                    => v_reg_entidad_consumo.cod_plan,
                                  pi_es_plan_facturable          => v_reg_plan.es_facturable,
                                  pi_es_plan_tarifable           => v_reg_plan.es_tarifable,
                                  pi_id_proc_ems                 => NULL,
                                  pi_id_orig_proc_ems            => NULL,
                                  pi_id_form_ems                 => NULL,
                                  pi_id_orig_form_ems            => NULL,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_fch_efectiva                => v_fch_tran,
                                  po_id_registro                 => v_id_registro,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --CAMBIO DE ESTADO DEL NUMERO TELEONICO A UTILIZADO (2)
        po_cod_err := 'PVT-2793';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar al proc. de utilizacion del numero telefonico.
        cc_cl_numero_telefonico.cambiar_estado (pi_numero                      => pi_identificador_entidad,
                                                pi_estado                      => c_estado_telefono_activo,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_master                      => c_falso,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio_tran     => pi_cod_unidad_negocio,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --REALIZAR LA RECARGA SI ES FULL Y NO HA SIDO EFECTUADA
        IF v_reg_comunidad.cod_linea_negocio IN ('FULL', 'FIJA') THEN
            po_cod_err := 'PVT-2794';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar el periodo vigente.
            v_reg_periodo      :=
                tx_tr_periodo_facturacion.get_periodo_vigente
                                                             (v_reg_comunidad.cod_ciclo_facturacion);
            po_cod_err := 'PVT-2795';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al verificar si la entidad de consumo tiene una recarga para el periodo vigente.
            v_tiene_recarga    :=
                tx_cta_cuenta_corriente.tiene_recarga_full
                                                         (v_reg_periodo.cod_periodo,
                                                          v_reg_entidad_consumo.id_cuenta_corriente);
            po_cod_err := 'PVT-2796';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar el monto a recargar.
            tx_pvt_ccs.get_impuestos (v_reg_plan.tarifa_basica,
                                      c_cargo_tbm,
                                      v_monto_recarga,
                                      v_tax1,
                                      v_tax2,
                                      v_tax3
                                     );

            IF v_monto_recarga > 0 AND NOT v_tiene_recarga THEN
                po_cod_err := 'PVT-2797';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al generar el registro de recarga
                tx_cta_cuenta_corriente.registra_recarga_full
                                 (pi_cod_periodo                 => v_reg_periodo.cod_periodo,
                                  pi_id_cuenta_cte_ec            => v_reg_entidad_consumo.id_cuenta_corriente,
                                  pi_cod_ciclo                   => v_reg_comunidad.cod_ciclo_facturacion,
                                  pi_impuesto                    => NULL,
                                  pi_valor                       => v_monto_recarga,
                                  pi_fch_creacion                => v_fch_tran,
                                  pi_fch_vencimiento             => v_fch_tran,
                                  pi_master                      => c_falso,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_nro_documento               => v_nro_documento,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                -- ACV [20071204] - Envio de impuestos
                FOR j IN (SELECT   *
                              FROM bl_impuesto
                          ORDER BY posicion_factura)
                LOOP
                    IF (j.posicion_factura = 1) THEN
                        v_valor_impuesto    := v_tax1;
                    ELSIF (j.posicion_factura = 2) THEN
                        v_valor_impuesto    := v_tax2;
                    ELSIF (j.posicion_factura = 3) THEN
                        v_valor_impuesto    := v_tax3;
                    ELSE
                        po_cod_err := 'PVT-2798';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS:El codigo de impuesto no esta definido
                    END IF;

                    cc_cta_doc_cuenta_corriente.alta_impuesto
                                                    (pi_cod_tipo_documento          => c_doc_recarga_full,
                                                     pi_nro_documento               => v_nro_documento,
                                                     pi_cod_periodo                 => v_reg_periodo.cod_periodo,
                                                     pi_cod_impuesto                => j.cod_impuesto,
                                                     pi_valor                       => v_valor_impuesto,
                                                     pi_cod_usuario                 => pi_cod_usuario,
                                                     pi_id_tran                     => v_id_tran,
                                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                     pi_fch_tran                    => v_fch_tran,
                                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                     po_cod_err                     => po_cod_err,
                                                     po_msj_err                     => po_msj_err
                                                    );

                    IF (po_cod_err <> 'OK') THEN
                        RAISE err_app;
                    END IF;
                END LOOP;

                po_cod_err := 'PVT-2799';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al invocar el procedimiento CC_CTA_NOTA.CONSOLIDAR_NOTA_DEBITO.
                cc_cta_nota.consolidar_nota_debito
                (
                    pi_cod_tipo_documento     => c_tipo_doc_ndeb_full,
                    pi_id_cuenta_corriente    => v_reg_comunidad.id_cuenta_corriente,
                    pi_observacion            => NULL,
                    pi_fch_vencimiento        => v_reg_periodo.periodo_fin,
                    pi_nro_doc_externo        => NULL,
                    pi_monto                  => v_monto_recarga,
                    pi_cod_usuario            => pi_cod_usuario,
                    pi_master                 => c_falso,
                    pi_id_tran                => v_id_tran,
                    pi_cod_gestion_tran       => v_cod_gestion_tran,
                    pi_fch_tran               => v_fch_tran,
                    pi_cod_unidad_negocio     => pi_cod_unidad_negocio,
                    po_nro_doc_nota           => v_nro_documento,
                    po_cod_err                => po_cod_err,
                    po_msj_err                => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        --DETERMINAR EL SERVICIO DE ACTIVACION POR DEFECTO
        po_cod_err := 'PVT-2800';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error en al recuperar el servicio de activacion.

        SELECT ps.cod_servicio
          INTO v_cod_servicio
          FROM bm_plan_servicio ps, bm_servicio s
         WHERE ps.cod_plan = v_reg_entidad_consumo.cod_plan
           AND ps.cod_servicio = s.cod_servicio
           AND s.cod_tipo_servicio = c_tipo_serv_paquete
           AND ps.estado <> c_estado_inactivo
           AND ps.fch_fin = c_fecha_fin;

        po_cod_err := 'PVT-2801';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al recuperar los datos de la persona.

        SELECT SUBSTR (nombre, 0, 15) nombre,
               SUBSTR (apellido_paterno || ' ' || apellido_materno, 0, 15) apellidos,
               SUBSTR (d.zona_barrio_urb, 0, 15) zona,
               SUBSTR (d.calle_av_pasaje, 0, 15) calle
          INTO v_nombre,
               v_apellidos,
               v_zona,
               v_calle
          FROM cl_persona p, cl_direccion d
         WHERE p.id_persona = v_reg_entidad_consumo.id_persona
           AND p.id_persona = d.id_persona
           AND ROWNUM = 1;

        v_fecha_expiracion         := TO_CHAR (v_fch_tran + 1, 'YYYY-MM-DD');
        --PROVISIONAR LA REACTIVACION DEL SUSCRIPTOR CON EL MONTO DE LA RECARGA
        v_identificador_entidad    := pi_identificador_entidad;
        po_cod_err := 'PVT-2802';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar la accion de provisionamiento a invocar.


        IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_gsm THEN
            v_sim         := v_reg_entidad_consumo.sim;
            po_cod_err := 'PVT-2803';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al obtener los datos del SIM.

            SELECT ss.ki,
                   ss.transport_key,
                   ss.imsi
              INTO v_ki,
                   v_transport_key,
                   v_imsi
              FROM cl_serial_sim ss
             WHERE ss.icc LIKE v_sim || '%';
        ELSIF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            v_imsi           := v_reg_entidad_consumo.imsi;
            v_sim            := NULL;
            po_cod_err := 'PVT-2804';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar el tipo de numero.
            v_tipo_numero    := get_tipo_numero (pi_identificador_entidad);

            IF v_tipo_numero = c_tipo_numero_portin THEN
                po_cod_err := 'PVT-2805';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar la linea de negocio del suscriptor.

                SELECT cod_linea_negocio
                  INTO v_cod_linea_negocio
                  FROM cl_comunidad c
                 WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

                po_cod_err := 'PVT-2806';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al determinar un MIN para el suscriptor.
                v_min         := get_min (v_reg_entidad_consumo.cod_plan);
                po_cod_err := 'PVT-2807';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al reservar el MIN.
                cc_cl_numero_telefonico.cambiar_estado
                                               (pi_numero                      => v_min,
                                                pi_estado                      => c_tipo_numero_min,
                                                pi_estado_numero               => c_estado_telefono_activo,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_master                      => c_falso,
                                                pi_id_tran                     => pi_id_tran,
                                                pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                                pi_fch_tran                    => pi_fch_tran,
                                                pi_cod_unidad_negocio_tran     => pi_cod_unidad_negocio,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-2808';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al asignar el MIN al suscriptor.
                cc_cl_entidad_consumo_afin.asignar
                                              (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                               pi_identificador_entidad       => pi_identificador_entidad,
                                               pi_id_entidad_consumo_afin     => NULL,
                                               pi_identificador_entidad_afin  => v_min,
                                               pi_cod_tipo_afinidad           => 'TAMIN',
                                               pi_cod_servicio                => NULL,
                                               pi_faf_id                      => 0,
                                               pi_id_proc_ems                 => NULL,
                                               pi_id_orig_proc_ems            => NULL,
                                               pi_id_form_ems                 => NULL,
                                               pi_id_orig_form_ems            => NULL,
                                               pi_id_tarifa                   => NULL,
                                               pi_cod_carrier                 => NULL,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_id_tran                     => pi_id_tran,
                                               pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                               pi_fch_tran                    => pi_fch_tran,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               pi_fch_efectiva                => v_fch_tran,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;
            ELSE
                v_min    := pi_identificador_entidad;
            END IF;

            v_ki             := v_min;
        END IF;


        ------------------------- INICIO PROVISIONING (ERICSSON) --------------------------

        po_cod_err := 'PVT-5114'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al obtener la orden de reinstalacion en CS.
       -- SELECT tx_vpg_util.get_comando('TX_TRAN_REINSTALACION', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
         --INTO v_command_id
       -- FROM DUAL;


       --Enviar orden de creacion SIM aparte.
        SELECT COUNT(1)
            INTO v_es_usim
        FROM inv_articulo_maestro m, inv_articulo a
        WHERE m.nro_serie =  v_sim
        AND m.cod_articulo = a.cod_articulo
        AND NVL(a.es_usim,0) = c_verdadero;

        IF v_es_usim = c_falso THEN
            v_cod_enlace    :=  'ADD_SIM_AUC';
        ELSE
            v_cod_enlace    :=  'ADD_USIM_AUC';
        END IF;

         po_cod_err    := 'CLI-3006';   --TX_CL_ACTIVACION.ALTA_ENTIDAD_CONSUMO: No existe la Accion al PRV para el servicio.
        SELECT tx_vpg_util.get_comando(v_cod_enlace, v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
          INTO v_command_id
          FROM DUAL;

        po_cod_err    := 'CLI-3007';   --TX_CL_ACTIVACION.ALTA_ENTIDAD_CONSUMO: Error al dar de alta la orden en el PRV.
        mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_tran,
                    pi_cod_transaccion      => c_tipo_transaccion,
                    pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                    pi_p2                   => v_imsi,
                    pi_p3                   => v_ki,
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => pi_id_tran,
                    pi_cod_gestion_tran     => pi_cod_gestion_tran,
                    pi_fch_tran             => pi_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_id_orden,
                    po_id_tran              => v_id_tran,
                    po_fch_tran             => v_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );
        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;


        SELECT tx_vpg_util.get_comando(v_cod_servicio, v_reg_entidad_consumo.cod_forma_consumo, 'REACT')
         INTO v_command_id
        FROM DUAL;

        IF v_command_id IS NULL THEN

            SELECT tx_vpg_util.get_comando(v_cod_servicio, v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
             INTO v_command_id
            FROM DUAL;

        END IF;

        IF v_bm_plan.cod_grupo_plan IN ('HIBINF','HIBJEV','POSINF','INREHP') THEN

            --Asignar PAM de factuarcion nuevos planes infinitos acorde al ciclo

            po_cod_err := 'PVT-5233'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al obtener el PAM ID asociado al ciclo de facturacion.

            SELECT parametro_1,parametro_2
                INTO v_pam_class_id, v_pam_schedule_id
                FROM cnf_configuracion_especial
            WHERE tipo = 'PAM_CNF' AND nombre_tabla = 'CNF_FACTURACION'
            AND cod_registro = (SELECT cod_ciclo_facturacion FROM cl_comunidad WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante);

        ELSE
            v_pam_class_id      :=  tx_vpg_util.get_plan_param_value(v_reg_entidad_consumo.cod_plan,c_pam_class_id, 'VPG_CNF');
            v_pam_schedule_id   :=  tx_vpg_util.get_plan_param_value(v_reg_entidad_consumo.cod_plan,c_pam_schedule_id, 'VPG_CNF');
        END IF;

        po_cod_err := 'PVT-5115'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al enviar la orden para reinstalacion en el CS.
        mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_tran,
                    pi_cod_transaccion      => c_tipo_transaccion,
                    pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo), -- pi_identificador_entidad,
                    pi_p2                   => v_imsi,   -- Numero de IMSI
                    pi_p3                   => v_sim,    -- ICC
                    pi_p4                   => tx_vpg_util.get_plan_param_value(v_reg_entidad_consumo.cod_plan,c_hlr_profile_id, 'VPG_CNF'),
                    pi_p5                   => v_ki,
                    pi_p6                   => tx_vpg_util.get_plan_param_value(v_reg_entidad_consumo.cod_plan,c_contract_template_id, 'VPG_CNF'),
                    pi_p7                   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_p8                   => tx_vpg_util.get_plan_param_value(v_reg_entidad_consumo.cod_plan,c_contract_type_id, 'VPG_CNF'),
                    pi_p9                   => tx_vpg_util.vpg_getIdSdp(v_reg_entidad_consumo.identificador_entidad),
                    pi_p10                  => tx_vpg_util.get_plan_param_value(v_reg_entidad_consumo.cod_plan,c_main_offer_id, 'VPG_CNF'),
                    pi_p14                  => v_pam_class_id,  -- PAM CLASS
                    pi_p15                  => v_pam_schedule_id, -- PAM SCHEDULE,
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_id_orden,
                    po_id_tran              => v_id_tran,
                    po_fch_tran             => v_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        IF get_segmento(v_reg_entidad_consumo.cod_plan) IN ('PREPAGO','CASPRE','INTERMVPRE') THEN

            po_cod_err := 'PVT-5116'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al obtener la orden de cambio ciclo vida.
            SELECT tx_vpg_util.get_comando('CMB_CICLO_VIDA', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
              INTO v_command_id
            FROM DUAL;

            po_cod_err := 'PVT-5117'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al enviar comando para cambio de fecha supervision period
            mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_tran,
                    pi_cod_transaccion      => c_tipo_transaccion,
                    pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                    pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_p3                   => v_fecha_expiracion,
                    pi_p4                   => tx_cnf_constante.get_constante ('VIGENCIA_FIN_ECMS'), --Service fee Expire Date
                    pi_p5                   => NULL, --Credit clearance Expire Date
                    pi_p6                   => NULL, --Service removal Expire Date
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => '0',
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_id_orden,
                    po_id_tran              => v_id_tran,
                    po_fch_tran             => v_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        ------------------------- FIN PROVISIONING (ERICSSON) -----------------------------

        IF v_reg_comunidad.cod_linea_negocio IN ('FULL', 'FIJA') THEN
            -- REALIZAR LA RECARGA EN PLATAFORMA.
            IF v_reg_plan.cod_plan LIKE 'FFA%' THEN
                -- Envio de la recarga mensual al bolsillo CORE BALANCE, para los planes FFA%
                ------------------------- INICIO PROVISIONING (ERICSSON) --------------------------
                po_cod_err := 'PVT-5118'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error obtener el refill profile id.
                v_refill_profile_id := tx_cnf_vigencia_carga.get_refill_profile_id(v_bm_plan.cod_grupo_plan, v_monto_recarga);

                IF  v_refill_profile_id IS NULL THEN
                    po_cod_err := 'PVT-5119'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: El monto no tiene configurado un refill profile id.
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-5120'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al recuperar la accion para el VPG a invocar.
                SELECT tx_vpg_util.get_comando('RECARGA_NV', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                   INTO v_command_id
                FROM DUAL;

                po_cod_err := 'PVT-5121'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al dar de alta orden para carga de balance.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => 'TX_TRAN_CAMBIO_PLAN',
                            pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                            pi_p2                   => 'ADM',
                            pi_p3                   => 'RECARGA MENSUAL EN REINSTALACION',
                            pi_p4                   => v_id_tran,
                            pi_p5                   => tx_vpg_util.date2iso(v_fch_tran),
                            pi_p6                   => tx_vpg_util.number2cs(v_monto_recarga),
                            pi_p7                   => v_refill_profile_id,
                            pi_p8                   => NULL, --External Data 1
                            pi_p9                   => NULL, --External Data 2
                            pi_p10                  => NULL, --External Data 3
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
                ------------------------- FIN PROVISIONING (ERICSSON) --------------------------
            ELSE
                IF v_monto_recarga > 0 THEN
                    -- Envio de la recarga mensual en reinstalacion al bolsillo principal, antes CORE BALANCE

                    ---------------------- INICIO PROVISIONING (ERICSSON) --------------------
                    po_cod_err := 'PVT-5122'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al obtener el comando para ajuste balance.
                    SELECT tx_vpg_util.get_comando('SET_DA_BALANCE', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                      INTO v_command_id
                    FROM DUAL;

                    v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_promotional_balance_1);

                    po_cod_err := 'PVT-5123'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al dar de alta orden para carga de balance mensual.

                    IF v_bolsillos_cs.cod_unidad_medida IN ('MONEY') THEN
                        v_monto_recarga :=  tx_vpg_util.number2cs(v_monto_recarga);
                    END IF;

                    mt_vpg.alta_orden(
                            pi_id_comando               => v_command_id,
                            pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_cod_transaccion          => c_tipo_transaccion,
                            pi_p1                       => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                            pi_p2                       => tx_air.get_transactionID,
                            pi_p3                       => tx_vpg_util.date2iso(v_fch_tran),
                            pi_p4                       => v_bolsillos_cs.cod_bolsillo_c1,
                            pi_p5                       => v_monto_recarga,
                            pi_p6                       => v_bolsillos_cs.cod_unidad_medida_air,
                            pi_p7                       => tx_vpg_util.date2iso( TO_DATE(c_vigencia_fin_ecms,'YYYY-MM-DD') ),
                            pi_p8                       => 'RECARGA MENSUAL EN REINSTALACION',
                            pi_cod_usuario              => pi_cod_usuario,
                            pi_master                   => '0',
                            pi_id_tran                  => v_id_tran,
                            pi_cod_gestion_tran         => v_cod_gestion_tran,
                            pi_fch_tran                 => v_fch_tran,
                            pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                            po_id_orden                 => v_id_orden,
                            po_id_tran                  => v_id_tran,
                            po_fch_tran                 => v_fch_tran,
                            po_cod_err                  => po_cod_err,
                            po_msj_err                  => po_msj_err);

                    IF (po_cod_err != 'OK') THEN
                        RAISE err_app;
                    END IF;


                    ---------------------- FIN PROVISIONING (ERICSSON) --------------------

                END IF;

                NULL;
            END IF;
        END IF;


        IF v_reg_plan.c1_offer_id IS NOT NULL THEN
            po_cod_err := 'PVT-5028'; --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONSOLIDACION: Error al intentar reinstalar el suscriptor en control ciclo de vida.
            tx_cl_lifecycle.generate_subscriber_dates( pi_internal_id        => v_reg_entidad_consumo.id_entidad_consumo,
                                                       pi_expiration_date    => v_fecha_expiracion,
                                                       pi_transaction_reason => 'REINSTALLATION',
                                                       pi_master             => c_falso,
                                                       pi_tran_id            => v_id_tran,
                                                       pi_tran_date          => v_fch_tran,
                                                       pi_tran_user          => pi_cod_usuario,
                                                       pi_tran_period        => v_cod_gestion_tran,
                                                       po_cod_err            => po_cod_err,
                                                       po_msj_err            => po_msj_err
                                                      );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --ASIGNAR EL SERVICIO DE ACTIVACION
        po_cod_err := 'PVT-2812';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error en al invocar a CC_CL_SERVICIO_ENTIDAD_CONSUMO.ASIGNAR
        cc_cl_servicio_entidad_consumo.asignar (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                pi_cod_servicio                => v_cod_servicio,
                                                pi_cod_plan                    => v_reg_entidad_consumo.cod_plan,
                                                pi_precio                      => NULL,
                                                pi_cod_moneda                  => NULL,
                                                pi_cod_tipo_cobro              => NULL,
                                                pi_es_facturable               => NULL,
                                                pi_es_por_defecto              => NULL,
                                                pi_id_proc_ems                 => NULL,
                                                pi_id_orig_proc_ems            => NULL,
                                                pi_id_form_ems                 => NULL,
                                                pi_id_orig_form_ems            => NULL,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                pi_fch_efectiva_inicio         => v_fch_tran,
                                                pi_fch_efectiva_fin            => c_fecha_fin,
                                                po_id_registro                 => v_id_registro,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2813';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al recuperar el LRN
        v_lrn                      :=
            tx_por_utiles.get_lrn_asignado (pi_identificador_entidad,
                                            v_reg_entidad_consumo.cod_tecnologia);
        po_cod_err := 'PVT-2814';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al validar si se trata de un numero portado o no

        IF tx_por_utiles.es_portado (pi_identificador_entidad) = c_verdadero THEN
            v_provider_tag    := 'SCP:' || c_prestador_propio;
        ELSE
            v_provider_tag    := 'OMEGA';
        END IF;

        -- 2017-01-18 GAC-Ericsson - No enviar ordenes cuando el flag ERS_PORTABILIDAD sea 1 - INICIO
        --IF (tx_cnf_constante.get_constante('ERS_PORTABILIDAD')='0') THEN
        IF v_lrn IS NOT NULL THEN
            po_cod_err := 'PVT-2815';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al insertar en tabla de protacion hacia el LNP
            cc_ord_numero_portado_gsm.alta (pi_numero                      => pi_identificador_entidad,
                                            pi_lrn                         => v_lrn,
                                            pi_provider_tag                => v_provider_tag,
                                            pi_accion                      => 'ADD',
                                            pi_cod_usuario                 => pi_cod_usuario,
                                            pi_id_tran                     => v_id_tran,
                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                            pi_fch_tran                    => v_fch_tran,
                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            pi_comentario                  => v_cod_tran,
                                            po_id_orden                    => v_id_orden,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;
        --END IF;
        -- 2017-01-18 GAC-Ericsson - No enviar ordenes cuando el flag ERS_PORTABILIDAD sea 1 - FIN

        --PHC inicio-----------------------reinstalacion interjet libre-------------------------------------------
        IF pi_id_prospecto IS NOT NULL THEN
            -- Obtener el id_venta
            po_cod_err := 'PVT-2816';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al obtener id_venta del prospecto

            SELECT id_venta
              INTO v_id_venta
              FROM vta_venta_prospecto
             WHERE id_prospecto = pi_id_prospecto;

            -- Cambiar estado al prospecto
            po_cod_err := 'PVT-2817';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar a CC_VTA_VENTA_PROSPECTO.CAMBIAR_ESTADO
            cc_vta_venta_prospecto.cambia_estado (pi_id_venta                    => v_id_venta,
                                                  pi_estado                      => c_estado_pagado,
                                                  pi_cod_usuario                 => pi_cod_usuario,
                                                  pi_id_tran                     => v_id_tran,
                                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                  pi_fch_tran                    => v_fch_tran,
                                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                  po_cod_err                     => po_cod_err,
                                                  po_msj_err                     => po_msj_err
                                                 );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            -- Cambiar estado a los detalles del prospecto
            po_cod_err := 'PVT-2818';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar a CC_VTA_VENTA_PROSPECTO_DETALLE.CAMBIAR_ESTADO
            cc_vta_venta_prospecto_detalle.cambia_estado
                                                    (pi_id_venta                    => v_id_venta,
                                                     pi_id_prospecto                => pi_id_prospecto,
                                                     pi_id_cargo                    => c_cargo_tbm,
                                                     pi_id_prospecto_ec             => NULL,
                                                     pi_id_prospecto_art            => NULL,
                                                     pi_id_prospecto_car            => NULL,
                                                     pi_estado                      => c_estado_pagado,
                                                     pi_cod_usuario                 => pi_cod_usuario,
                                                     pi_id_tran                     => v_id_tran,
                                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                     pi_fch_tran                    => v_fch_tran,
                                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                     po_cod_err                     => po_cod_err,
                                                     po_msj_err                     => po_msj_err
                                                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2819';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al recuperar datos del plan

            SELECT cod_plan
              INTO v_cod_plan
              FROM vta_venta_reinstalacion
             WHERE id_prospecto = pi_id_prospecto;

            po_cod_err := 'PVT-2820';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al recuperar datos del tiempo obligatorio

            SELECT tiempo_obligatorio_contrato
              INTO v_tiempo_obligatorio_contrato
              FROM bm_plan
             WHERE cod_plan = v_cod_plan;

            po_cod_err := 'PVT-2821';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al Error al invocar a CC_CL_ENTIDAD_CONSUMO.MODIFICACION
            cc_cl_entidad_consumo.modificacion
                   (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                    pi_descripcion                 => v_reg_entidad_consumo.descripcion,
                    pi_identificador_entidad       => v_reg_entidad_consumo.identificador_entidad,
                    pi_puk                         => NULL,
                    pi_imsi                        => v_imsi,
                    pi_sim                         => v_sim,
                    pi_cod_plan                    => v_cod_plan,
                    pi_tiempo_obligatorio_contrato => v_tiempo_obligatorio_contrato,
                    pi_id_comunidad_facturante     => v_reg_entidad_consumo.id_comunidad_facturante,
                    pi_cod_forma_consumo           => v_reg_entidad_consumo.cod_forma_consumo,
                    pi_id_persona                  => v_reg_entidad_consumo.id_persona,
                    pi_id_entidad_consumo_ref      => v_reg_entidad_consumo.id_entidad_consumo_referidor,
                    pi_id_entidad_consumo_vpn      => v_reg_entidad_consumo.id_entidad_consumo_vpn,
                    pi_id_cliente_fs               => v_reg_entidad_consumo.id_cliente_fs,
                    pi_id_suscriptor_fs            => v_reg_entidad_consumo.id_suscriptor_fs,
                    pi_es_facturable               => v_reg_entidad_consumo.es_facturable,
                    pi_id_proc_ems                 => v_reg_entidad_consumo.id_proc_ems,
                    pi_id_orig_proc_ems            => v_reg_entidad_consumo.id_orig_proc_ems,
                    pi_id_form_ems                 => v_reg_entidad_consumo.id_form_ems,
                    pi_id_orig_form_ems            => v_reg_entidad_consumo.id_orig_form_ems,
                    pi_cod_usuario                 => pi_cod_usuario,
                    pi_id_tran                     => v_id_tran,
                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                    pi_fch_tran                    => v_fch_tran,
                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                    pi_fch_efectiva                => v_fch_tran,
                    po_cod_err                     => po_cod_err,
                    po_msj_err                     => po_msj_err
                   );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2822';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar a VTA_VENTA_REINSTALACION.CAMBIA_ESTADO
            cc_vta_venta_reinstalacion.cambia_estado
                                                    (pi_id_prospecto                => pi_id_prospecto,
                                                     pi_estado                      => c_estado_pagado,
                                                     pi_cod_usuario                 => pi_cod_usuario,
                                                     pi_id_tran                     => v_id_tran,
                                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                     pi_fch_tran                    => v_fch_tran,
                                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                     po_cod_err                     => po_cod_err,
                                                     po_msj_err                     => po_msj_err
                                                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;   --pi_id_prospecto IS NOT NULL

--PHC final-------------------------------------------------------------------------

        -------------------------- Reinstalacion Blackberry --------------------------------
        BEGIN
            SELECT bs.cod_servicio
              INTO v_servicio_bb
              FROM bm_servicio bs, bm_plan_servicio bps
             WHERE bs.cod_tipo_servicio = 'BBDAT'
               AND bs.cod_servicio = bps.cod_servicio
               AND bps.cod_plan = v_reg_entidad_consumo.cod_plan
               AND bps.es_por_defecto = 1
               AND bs.estado = c_estado_activo
               AND bps.estado = c_estado_activo
               AND bps.fch_fin = c_fecha_fin;
        EXCEPTION
            WHEN OTHERS THEN
                v_servicio_bb    := NULL;
        END;

        IF v_servicio_bb IS NOT NULL THEN
            po_cod_err := 'PVT-2823';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: error en al invocar a TX_BLACKBERRY.ASIGNAR_SERVICIO
            tx_blackberry.asignar_servicio
                                (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_cod_servicio_bb             => v_servicio_bb,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -------------------------- Reinstalacion Blackberry --------------------------------


        --REGISTRAR EL LOG TRANSACCIONAL POSTVENTA
        IF pi_master = c_verdadero THEN
            po_cod_err := 'PVT-2825';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al obtener el id del cliente.
            v_id_cliente    := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
            --- Registrar transaccion
            po_cod_err := 'PVT-2826';   --TX_PVT_ENTIDAD_CONSUMO.REINSTALACION_CONS: Error al invocar al proc. de registro transaccional postventa.
            cc_tx_transaccion_postventa.alta
                                 (pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_cod_tipo                    => c_tipo_transaccion,
                                  pi_id_cliente                  => v_id_cliente,
                                  pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                  pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                  pi_cod_motivo_transaccion      => pi_cod_motivo,
                                  pi_cod_observacion             => NULL,
                                  pi_descripcion_observacion     => NULL,
                                  pi_valor_anterior              => NULL,
                                  pi_valor_nuevo                 => NULL,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                 := 'OK';
        po_msj_err                 := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;   --REINSTALACION_CONSOLIDACION

    PROCEDURE corte_entidad_consumo_consol (
        -- Input parameters
        pi_id_prospecto           IN       vta_corte_entidad_consumo.id_prospecto%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                            := tx_cnf_constante.get_constante ('TRANSACCION_CORTE_ENTIDAD_CONSUMO');
        c_min_diferido_ord_bloq   CONSTANT NUMBER (4)
                            := tx_cnf_constante.get_constante ('MIN_DIFERIDO_ORD_BLQ_DATA');

        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.CORTE_ENTIDAD_CONSUMO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_operacion                   VARCHAR2 (10);
        v_estado_ini                  bm_servicio_suspension.estado_asociado%TYPE;
        v_customer_group_ini          bm_servicio_suspension.grupo_cliente%TYPE;
        v_susp_salientes_ini          bm_servicio_suspension.susp_salientes%TYPE;
        v_susp_entrantes_ini          bm_servicio_suspension.susp_entrantes%TYPE;
        v_estado_fin                  bm_servicio_suspension.estado_asociado%TYPE;
        v_customer_group_fin          bm_servicio_suspension.grupo_cliente%TYPE;
        v_susp_salientes_fin          bm_servicio_suspension.susp_salientes%TYPE;
        v_susp_entrantes_fin          bm_servicio_suspension.susp_entrantes%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_reg_servicio_suspension     bm_servicio_suspension%ROWTYPE;
        v_dummy                       PLS_INTEGER;
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_id_servicio_ec              cl_servicio_entidad_consumo.id_registro%TYPE;
        v_cod_tipo_articulo           cl_articulo_entidad_consumo.cod_rubro_articulo%TYPE;
        v_nro_serie_articulo          cl_articulo_entidad_consumo.nro_serie%TYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        descripcion_nuevo_estado      cnf_estado_entidad.descripcion%TYPE;
        descripcion_estado_actual     cnf_estado_entidad.descripcion%TYPE;
        v_num_ec                      NUMBER;
        v_se_renta                    bm_grupo_plan.se_renta%TYPE;
        v_reg_corte_entidad_consumo   vta_corte_entidad_consumo%ROWTYPE;
        v_id_entidad_venta            inv_entidad_venta.id_entidad_venta%TYPE;
        v_cod_plan_pre_por            bm_plan.cod_plan%TYPE;
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_cod_ciclo                   cl_comunidad.cod_ciclo_facturacion%TYPE;
        v_id_cuenta_corriente         cl_comunidad.id_cuenta_corriente%TYPE;
        v_reg_periodo                 tr_periodo_facturacion%ROWTYPE;
        v_precio_trafico              vta_venta_prospecto_detalle.valor%TYPE;
        v_nro_documento               cta_doc_cuenta_corriente.nro_documento%TYPE;
        v_estado                      cl_serial_robado.estado_indotel%TYPE;
        v_id_registro                 cl_serial_robado.id_registro%TYPE;
        v_id_reg                      PLS_INTEGER;
        v_tiene_bb                    BOOLEAN := FALSE;
        v_balance_info                tx_ecms.ecms_balance_instances;
        v_date_exp_core_balance       DATE;
        v_date_exp_promo_balance_1    DATE;
        v_date_exp_free_sec_balance   DATE;
        v_id_accion                   NUMBER;
        v_id_paquete                  cl_paquete.id_paquete%TYPE;
        v_segmento_plan               v_plan_segmento.segmento%TYPE;
        v_mora                        NUMBER;
        v_nro_doc_nota                NUMBER;
        v_cod_estado_serie            VARCHAR2(15);
        po_fch_tran                   DATE;
        v_po_id_orden                 vpg_orden.id_orden%TYPE;
        v_po_id_tran                  tx_historico_transaccion.id_tran%TYPE;
        v_po_fch_tran                 DATE;
        v_command_id                  vpg_cnf_comando_enlace.id_comando%TYPE;
        v_bolsillos_cs                tx_ecms.type_ecms_bolsilos;
        v_imsi                        cl_entidad_consumo.imsi%TYPE;
        -- Excepciones
        err_app                       EXCEPTION;
        v_bloq_data                   boolean := false;
        v_tipo_serv                   VARCHAR2(25);
        v_susp_esp_hibpre             VARCHAR2(3) := c_falso;
        v_grupo_plan                  bm_plan.cod_grupo_plan%TYPE;
        v_es_sup_pu                   PLS_INTEGER;
        v_cod_enlace                  vpg_cnf_comando_enlace.cod_enlace%TYPE;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                 :=   ---------- parametros variables ------------------
               'pi_id_prospecto:'
            || pi_id_prospecto
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_prospecto IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2827';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2828';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2829';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                 := v_id_tran;
        po_cod_gestion_tran        := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------

        ---RECUPERAR EL ID _PROSPECTO
        po_cod_err := 'PVT-2830';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al recuperar datos del prospecto de corte

        SELECT *
          INTO v_reg_corte_entidad_consumo
          FROM vta_corte_entidad_consumo
         WHERE id_prospecto = pi_id_prospecto;

        po_cod_err := 'PVT-2831';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al recuperar datos de la entidad de venta

        SELECT v.id_entidad_venta
          INTO v_id_entidad_venta
          FROM vta_venta_entidad v
         WHERE id_prospecto = pi_id_prospecto;

        --EL SUSCRIPTOR NO DEBE ESTAR TERMINADO
        validar_entidad_consumo (v_reg_corte_entidad_consumo.id_entidad_consumo,
                                 v_reg_entidad_consumo, po_cod_err, po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --NO DEBE TENER ASIGNADO UN CORTE DEL MISMO TIPO
        po_cod_err := 'PVT-2832';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al verificar si el suscriptor ya tiene asignado la suspension o desconexion.

        SELECT COUNT (*)
          INTO v_dummy
          FROM cl_servicio_entidad_consumo sec
         WHERE sec.id_entidad_consumo = v_reg_corte_entidad_consumo.id_entidad_consumo
           AND sec.estado <> c_estado_inactivo
           AND sec.fch_fin = c_fecha_fin
           AND sec.cod_servicio = v_reg_corte_entidad_consumo.cod_servicio;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2833';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: El suscriptor ya tiene asignado la suspension o desconexion.
            RAISE err_app;
        END IF;

        v_estado_ini               := v_reg_entidad_consumo.estado;
        --DATOS DEL TIPO DE CORTE A APLICAR
        po_cod_err := 'PVT-2834';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al obtener los datos del tipo de corte a aplicar.

        SELECT ss.*
          INTO v_reg_servicio_suspension
          FROM bm_servicio_suspension ss
         WHERE ss.cod_servicio = v_reg_corte_entidad_consumo.cod_servicio;

        --EL TIPO DE CORTE DEBE ESTAR VIGENTE
        IF v_reg_servicio_suspension.estado = c_estado_inactivo THEN
            po_cod_err := 'PVT-2835';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: El tipo de corte no esta vigente.
            RAISE err_app;
        END IF;

        --DETERMINAR LA LINEA DE NEGOCIO DE LA CUENTA
        po_cod_err := 'PVT-2836';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al determinar la linea de negocio de la cuenta.

        SELECT cod_linea_negocio
          INTO v_cod_linea_negocio
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        po_cod_err := 'PVT-2837';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al recuperar parametros del grupo plan

        SELECT NVL (bg.se_renta, 0), b.cod_grupo_plan
          INTO v_se_renta, v_grupo_plan
          FROM bm_plan b, bm_grupo_plan bg
         WHERE b.cod_grupo_plan = bg.cod_grupo_plan AND b.cod_plan = v_reg_entidad_consumo.cod_plan;

        IF     v_se_renta = c_verdadero
           AND v_reg_corte_entidad_consumo.cod_servicio NOT IN ('SDRB', c_serv_suspension_robo) THEN
            po_cod_err := 'PVT-2838';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: La suspension o desconexion no esta habilitada para el suscriptor
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2839';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al recuperar  el periodo vigente

        SELECT c.cod_ciclo_facturacion,
               c.id_cuenta_corriente
          INTO v_cod_ciclo,
               v_id_cuenta_corriente
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        po_cod_err := 'PVT-2840';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al recuperar  el periodo vigente
        v_reg_periodo              := tx_tr_periodo_facturacion.get_periodo_vigente (v_cod_ciclo);

        ---CARGO DE TRAFICO A LA CUENTA CORRIENTE DE LA EC
        po_cod_err := 'PVT-2841';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al recuperar el trafico cobrado.
        SELECT NVL (SUM (d.valor), 0)
        INTO v_precio_trafico
        FROM vta_venta_prospecto_detalle d
        WHERE d.id_prospecto_ec = pi_id_prospecto
        AND d.estado = c_estado_activo
        AND d.cod_tipo_documento = 'PENTRF';

        --RQX 8251 - Suspension especial hibrido en DPF
        IF tx_cnf_constante.get_constante ('VIGENTE_SUSP_ESP_HIB_PRE') = c_verdadero
            AND get_segmento(v_reg_entidad_consumo.cod_plan) IN ('HIBRIDPRE','INTERMVHIB','INTERESHIB')
            AND v_reg_corte_entidad_consumo.cod_servicio = c_servicio_desc_full
        THEN
            v_susp_esp_hibpre   := c_verdadero;
        ELSE
            v_susp_esp_hibpre   := c_falso;
        END IF;
        --------

        IF v_precio_trafico > 0 THEN
            po_cod_err := 'PVT-2842';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al invocar al procedimiento TX_CTA_CUENTA_CORRIENTE.REGISTRA_DOCUMENTO.
            tx_cta_cuenta_corriente.registra_documento
                              (pi_cod_tipo_documento          => 'PENTRF',
                               pi_cod_periodo                 => v_reg_periodo.cod_periodo,
                               pi_cod_tipo_doc_afectado       => NULL,
                               pi_nro_doc_afectado            => NULL,
                               pi_id_cuenta_corriente         => v_reg_entidad_consumo.id_cuenta_corriente,
                               pi_cod_ciclo                   => v_cod_ciclo,
                               pi_impuesto                    => NULL,
                               pi_valor                       => v_precio_trafico,
                               pi_fch_creacion                => v_fch_tran,
                               pi_fch_cierre                  => NULL,
                               pi_fch_vencimiento             => v_fch_tran,
                               pi_cod_forma_pago              => NULL,
                               pi_ncf                         => NULL,
                               -- ncf de venta de minutos
                               pi_nro_doc_ext                 => NULL,
                               pi_master                      => c_falso,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_id_tran                     => v_id_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               po_nro_documento               => v_nro_documento,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;
        --SUSPENSION POR POLITCA DE USO
             SELECT COUNT(1)
                 INTO v_es_sup_pu
             FROM   cl_servicio_entidad_consumo
                WHERE  id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                       AND cod_servicio = c_servicio_sus_politica_uso
                       AND fch_fin = c_fecha_fin;

            IF v_es_sup_pu > 0 THEN
                po_cod_err := 'PVT-6023';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al invocar a tx_pvt_entidad_consumo.desasignar_servicio
                tx_pvt_entidad_consumo.desasignar_servicio(
                            pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_cod_servicio             => c_servicio_sus_politica_uso,
                            pi_cod_usuario              => pi_cod_usuario,
                            pi_master                   => 0,
                            pi_id_tran                  => v_id_tran,
                            pi_cod_gestion_tran         => v_cod_gestion_tran,
                            pi_fch_tran                 => v_fch_tran,
                            pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                            po_id_tran                  => v_id_tran,
                            po_cod_gestion_tran         => v_cod_gestion_tran,
                            po_cod_err                  => po_cod_err,
                            po_msj_err                  => po_msj_err
                            );

                    IF po_cod_err <> 'OK'
                    THEN
                       RAISE err_app;
                    END IF;

                     po_cod_err := 'PVT-6024';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al invocar a cc_cl_servicio_suspendido.alta
                    cc_cl_servicio_suspendido.alta
                          (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                           pi_cod_servicio                => c_servicio_datg,
                           pi_cod_usuario                 => pi_cod_usuario,
                           pi_id_tran                     => v_id_tran,
                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                           pi_fch_tran                    => v_fch_tran,
                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                           po_id_registro                 => v_id_reg,
                           po_cod_err                     => po_cod_err,
                           po_msj_err                     => po_msj_err
                          );

                    IF po_cod_err <> 'OK'
                    THEN
                       RAISE err_app;
                    END IF;
                END IF;


        --PORTABILIDAD
        IF v_reg_corte_entidad_consumo.cod_servicio IN ('SDPOR', 'SDPO') THEN
            po_cod_err := 'PVT-2843';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO:  Error al invocar a CC_CL_CONTRATO_ENTIDAD_CONSUMO.BAJA
            cc_cl_contrato_entidad_consumo.baja
                                (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            IF     v_reg_corte_entidad_consumo.cod_servicio IN ('SDPOR')
               AND v_reg_entidad_consumo.cod_forma_consumo = 'CCOPOS' THEN
                IF v_cod_linea_negocio = 'POSCOR' THEN
                    v_cod_plan_pre_por    := 'PREPORC';
                ELSE
                    v_cod_plan_pre_por    := 'PREPOR';
                END IF;

                po_cod_err := 'PVT-2844';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al Error al invocar a TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN
                tx_pvt_entidad_consumo.cambio_plan
                                 (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                  pi_cod_plan                    => v_cod_plan_pre_por,
                                  pi_es_pago_diferido            => c_falso,
                                  pi_es_x_retencion              => c_falso,
                                  pi_id_entidad_venta            => v_id_entidad_venta,
                                  pi_cod_usuario_asignado        => pi_cod_usuario,
                                  pi_id_prospecto_mig            => NULL,
                                  pi_id_venta_mig                => NULL,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_tran                     => v_id_tran,
                                  po_cod_gestion_tran            => v_cod_gestion_tran,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                --NO ES NECESARIO CAMBIAR EL ESTADO A ACTIVO, YA QUE SE CREA EN ESE ESTADO EN EL CONTROL CICLO DE VIDA
                END IF;
            END IF;

        --EL TIPO DE CORTE DEBE ESTAR HABILITADO PARA LA LINEA DE NEGOCIO, FORMA DE CONSUMO DEL SUSCRIPTOR
        IF v_reg_servicio_suspension.aplicable_a NOT LIKE
                 '%' || v_cod_linea_negocio || ',' || v_reg_entidad_consumo.cod_forma_consumo || '%' THEN
            po_cod_err := 'PVT-2846';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: El tipo de corte no es aplicable al suscriptor seleccionado.
            RAISE err_app;
        END IF;

        get_estado_entidad_consumo
                           (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                            po_estado                      => v_estado_ini,
                            po_customer_group              => v_customer_group_ini,
                            po_salientes                   => v_susp_salientes_ini,
                            po_entrantes                   => v_susp_entrantes_ini,
                            po_cod_err                     => po_cod_err,
                            po_msj_err                     => po_msj_err
                           );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        -- TICKET 23985 TERMINAR SUSPENCION 3G & LTE ANTES DE APLICAR NUEVA SUSPENCION

        FOR suspencion_data IN (
          SELECT serv.cod_servicio, serv.id_entidad_consumo
          FROM cl_servicio_entidad_consumo serv
          WHERE serv.id_entidad_consumo = v_reg_corte_entidad_consumo.id_entidad_consumo
          AND serv.cod_servicio IN ('SUS3G','SUS4G')
          AND serv.ultimo_registro = 1
          AND serv.estado = 'A'
        )

        LOOP
          po_cod_err := 'PVT-6022';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: ERROR AL DESASIGNAR SUSPENCION 3G & LTE.
          cc_cl_servicio_entidad_consumo.desasignar
                 (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                  pi_cod_servicio                => suspencion_data.cod_servicio,
                  pi_cod_usuario                 => pi_cod_usuario,
                  pi_id_tran                     => v_id_tran,
                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                  pi_fch_tran                    => v_fch_tran,
                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                  pi_fch_efectiva                => v_fch_tran,
                  po_cod_err                     => po_cod_err,
                  po_msj_err                     => po_msj_err
                 );

          IF po_cod_err <> 'OK' THEN
              RAISE err_app;
          END IF;

        END LOOP;

        --SI TIENE ASIGNADO UNO O MAS SERVICIOS DE CORTE PREVIOS, DESASIGNARLOS
        IF v_reg_servicio_suspension.requiere_servicio_previo = c_verdadero THEN
            FOR curserviciosprevios IN
                (SELECT     ss.cod_servicio
                       FROM bm_servicio_suspension ss
                      WHERE ss.cod_servicio <> v_reg_corte_entidad_consumo.cod_servicio
                 CONNECT BY PRIOR ss.cod_servicio_previo = ss.cod_servicio
                 START WITH ss.cod_servicio = v_reg_corte_entidad_consumo.cod_servicio
                 UNION   --SI EL SERVICIO ES UN SERVICIO DE DEUDA SELECCIONAR TODOS LOS SERVICIOS DE DEUDA YA ASIGNADOS
                 SELECT s.cod_servicio
                   FROM bm_servicio s
                  WHERE s.cod_servicio <> v_reg_corte_entidad_consumo.cod_servicio
                    AND s.cod_servicio IN (c_servicio_desc_full,
                                           c_servicio_susp_limite_credito,
                                           c_servicio_susp_falta_pago,
                                           c_servicio_desc_falta_pago,
                                           c_servicio_susp_cheque_dev
                                          )
                    AND v_reg_corte_entidad_consumo.cod_servicio IN
                            (c_servicio_desc_full,
                             c_servicio_susp_limite_credito,
                             c_servicio_susp_falta_pago,
                             c_servicio_desc_falta_pago,
                             c_servicio_susp_cheque_dev
                            ))
            LOOP
                BEGIN
                    po_cod_err := 'PVT-2847';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al obtener el tipo de corte previo asignado.

                    SELECT 1
                      INTO v_dummy
                      FROM cl_servicio_entidad_consumo sec
                     WHERE sec.id_entidad_consumo = v_reg_corte_entidad_consumo.id_entidad_consumo
                       AND sec.cod_servicio = curserviciosprevios.cod_servicio
                       AND sec.estado <> c_estado_inactivo
                       AND sec.fch_fin = c_fecha_fin;

                    po_cod_err := 'PVT-2848';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al desasignar el tipo de corte previo asignado.
                    cc_cl_servicio_entidad_consumo.desasignar
                           (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                            pi_cod_servicio                => curserviciosprevios.cod_servicio,
                            pi_cod_usuario                 => pi_cod_usuario,
                            pi_id_tran                     => v_id_tran,
                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                            pi_fch_tran                    => v_fch_tran,
                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                            pi_fch_efectiva                => v_fch_tran,
                            po_cod_err                     => po_cod_err,
                            po_msj_err                     => po_msj_err
                           );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        NULL;
                END;
            END LOOP;
        END IF;

        --ASIGNAR EL CORTE REQUERIDO
        po_cod_err := 'PVT-2849';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al invocar el proc. de suspension del suscriptor.
        cc_cl_servicio_entidad_consumo.asignar
                   (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                    pi_cod_servicio                => v_reg_corte_entidad_consumo.cod_servicio,
                    pi_cod_plan                    => v_reg_entidad_consumo.cod_plan,
                    pi_precio                      => NULL,
                    pi_cod_moneda                  => NULL,
                    pi_cod_tipo_cobro              => NULL,
                    pi_es_facturable               => NULL,
                    pi_es_por_defecto              => NULL,
                    pi_id_proc_ems                 => NULL,
                    pi_id_orig_proc_ems            => NULL,
                    pi_id_form_ems                 => NULL,
                    pi_id_orig_form_ems            => NULL,
                    pi_cod_usuario                 => pi_cod_usuario,
                    pi_id_tran                     => v_id_tran,
                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                    pi_fch_tran                    => v_fch_tran,
                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                    --pi_fch_efectiva                => v_fch_tran,
                    pi_fch_efectiva_inicio         => NVL
                                                          (v_reg_corte_entidad_consumo.fch_efectiva_inicio,
                                                           v_fch_tran),
                    pi_fch_efectiva_fin            => NVL
                                                          (v_reg_corte_entidad_consumo.fch_efectiva_fin,
                                                           c_fecha_fin),
                    po_id_registro                 => v_id_servicio_ec,
                    po_cod_err                     => po_cod_err,
                    po_msj_err                     => po_msj_err
                   );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        v_identificador_entidad    := v_reg_entidad_consumo.identificador_entidad;

        --SI ES SUSPENSION POR ROBO, REGISTRAR EL SERIAL COMO SERIAL NEGADO
        IF v_reg_corte_entidad_consumo.cod_servicio IN
                                                  (c_serv_suspension_robo, c_serv_desconexion_robo) THEN
            IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
                v_cod_tipo_articulo    := 'TACDMA';

                BEGIN
                    po_cod_err := 'PVT-2850';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al determinar el serial del equipo.

                    SELECT aec.nro_serie
                      INTO v_nro_serie_articulo
                      FROM cl_articulo_entidad_consumo aec
                     WHERE aec.id_entidad_consumo = v_reg_corte_entidad_consumo.id_entidad_consumo
                       AND aec.cod_rubro_articulo = v_cod_tipo_articulo
                       AND aec.estado <> c_estado_inactivo
                       AND aec.fch_fin = c_fecha_fin;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        NULL;
                END;
            ELSE
                v_cod_tipo_articulo    := 'TAGSM';

                BEGIN
                    po_cod_err := 'PVT-2851';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al determinar el serial del equipo.

                    SELECT ecec.imei
                      INTO v_nro_serie_articulo
                      FROM eir_corte_entidad_consumo ecec
                     WHERE ecec.id_prospecto = pi_id_prospecto;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        NULL;
                END;
            END IF;

            IF v_nro_serie_articulo IS NOT NULL THEN
                --verificar si la serie ya fue negada
                IF mt_ssn_util.es_serie_negada (v_nro_serie_articulo) = 0 THEN
                    -- motivo de la transaccion
                    IF v_reg_corte_entidad_consumo.cod_motivo = 'SDTPER' THEN
                        v_estado    := c_edo_extraviado;   --extraviado
                        v_cod_estado_serie  := 'SSNEXT';
                    ELSE
                        v_estado    := c_edo_sustraido;   --sustraido
                        v_cod_estado_serie  := 'SSNSUS';
                    END IF;

                    po_cod_err := 'PVT-2852';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al registrar en la tabla de seriales negadas.
                    mt_ssn.registrar_serie(
                        pi_id_entidad_consumo     => v_reg_corte_entidad_consumo.id_entidad_consumo,
                        pi_nro_serie              => v_nro_serie_articulo,
                        pi_cod_motivo             => 'MOTROB',
                        pi_cod_estado_serie       => v_cod_estado_serie,
                        pi_cod_usuario            => pi_cod_usuario,
                        pi_master                 => '0',
                        pi_id_tran                => v_id_tran,
                        pi_cod_gestion_tran       => v_cod_gestion_tran,
                        pi_fch_tran               => v_fch_tran,
                        pi_cod_unidad_negocio     => pi_cod_unidad_negocio,
                        po_id_tran                => po_id_tran,
                        po_fch_tran               => po_fch_tran,
                        po_cod_err                => po_cod_err,
                        po_msj_err                => po_msj_err);

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
            END IF;
        END IF;

        get_estado_entidad_consumo
                           (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                            po_estado                      => v_estado_fin,
                            po_customer_group              => v_customer_group_fin,
                            po_salientes                   => v_susp_salientes_fin,
                            po_entrantes                   => v_susp_entrantes_fin,
                            po_cod_err                     => po_cod_err,
                            po_msj_err                     => po_msj_err
                           );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --SI EL ESTADO FINAL ES DIFERENTE AL ACTUAL, ACTUALIZAR EL ESTADO DEL SUSCRIPTOR
        IF v_estado_ini <> v_estado_fin THEN
            --- CAMBIO DE ESTADO DEL SUSCRIPTOR
            po_cod_err := 'PVT-2853';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al invocar al proc. para establecer el nuevo estado del sucriptor.
            cc_cl_entidad_consumo.cambia_estado
                          (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                           pi_estado                      => v_estado_fin,
                           pi_id_proc_ems                 => v_reg_entidad_consumo.id_proc_ems,
                           pi_id_orig_proc_ems            => v_reg_entidad_consumo.id_orig_proc_ems,
                           pi_id_form_ems                 => v_reg_entidad_consumo.id_form_ems,
                           pi_id_orig_form_ems            => v_reg_entidad_consumo.id_orig_form_ems,
                           pi_cod_usuario                 => pi_cod_usuario,
                           pi_id_tran                     => v_id_tran,
                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                           pi_fch_tran                    => v_fch_tran,
                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                           pi_fch_efectiva                => v_fch_tran,
                           po_cod_err                     => po_cod_err,
                           po_msj_err                     => po_msj_err
                          );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --EN CASO DE CORTE QUITAR EL SERVICIO DE ROAMING INTERNACIONAL, DATA, SMS y BLACKBERRY
        v_bloq_data :=  FALSE;
        IF v_estado_ini = c_estado_activo AND v_estado_fin NOT IN (c_estado_activo, 'POR') THEN
            FOR curservdesasig IN
                (SELECT   cod_servicio
                     FROM cl_servicio_entidad_consumo sec
                    WHERE sec.id_entidad_consumo = v_reg_corte_entidad_consumo.id_entidad_consumo
                      AND sec.cod_servicio IN (SELECT s.cod_servicio
                                                 FROM bm_servicio s
                                                WHERE s.cod_servicio IN
                                                               ('CD01', 'SMSO', 'DATA2', 'DATVISA')
                                                   OR s.cod_tipo_servicio IN
                                                                       (c_tipo_serv_datos, 'BBDAT', 'TSEXT'))   -- BBDAT servicio BB PHC
                      AND sec.estado <> c_estado_inactivo
                      AND sec.fch_fin = c_fecha_fin
                 ORDER BY sec.cod_servicio)
            LOOP

                IF v_susp_esp_hibpre = c_verdadero AND curservdesasig.cod_servicio <> 'SMSO' THEN
                    CONTINUE; -- sOLO SUSPENDER LOS SMS SALIENTES
                END IF;

                po_cod_err := 'PVT-5234'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al obtener el tipo de servicio.
                SELECT cod_tipo_servicio
                    INTO v_tipo_serv
                FROM bm_servicio
                WHERE cod_servicio = curservdesasig.cod_servicio;

                IF v_tipo_serv  = 'TSDAT' OR es_servcio_esp_data(curservdesasig.cod_servicio) = c_verdadero THEN
                    v_bloq_data :=  TRUE;
                END IF;

                po_cod_err := 'PVT-5235'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden para bloqueo de llamadas salientes.
                tx_pvt_entidad_consumo.desasignar_servicio
                          (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                           pi_cod_servicio                => curservdesasig.cod_servicio,
                           pi_cod_usuario                 => pi_cod_usuario,
                           pi_master                      => c_falso,
                           pi_id_tran                     => v_id_tran,
                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                           pi_fch_tran                    => v_fch_tran,
                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                           po_id_tran                     => v_id_tran,
                           po_cod_gestion_tran            => v_cod_gestion_tran,
                           po_cod_err                     => po_cod_err,
                           po_msj_err                     => po_msj_err
                          );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;


                -----phc blackberry si es un servicio BB suspender en cl_entidad_consumo_bb
                v_dummy    := 0;

                SELECT COUNT (1)
                  INTO v_dummy
                  FROM bm_servicio
                 WHERE estado = c_estado_activo
                   AND cod_servicio = curservdesasig.cod_servicio
                   AND cod_tipo_servicio = 'BBDAT';

                IF v_dummy > 0 THEN
                    tx_blackberry.suspender_bb
                          (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                           pi_master                      => c_falso,
                           pi_cod_usuario                 => pi_cod_usuario,
                           pi_id_tran                     => v_id_tran,
                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                           pi_fch_tran                    => v_fch_tran,
                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                           po_cod_err                     => po_cod_err,
                           po_msj_err                     => po_msj_err
                          );
                    v_tiene_bb    := TRUE;
                END IF;

                ----phc blackberry
                SELECT COUNT (1)
                  INTO v_dummy
                  FROM DUAL
                 WHERE curservdesasig.cod_servicio IN (
                           SELECT s.cod_servicio
                             FROM bm_servicio s
                            WHERE s.cod_servicio IN ('DATA2')
                               OR s.cod_tipo_servicio IN (c_tipo_serv_datos));

                -- Si tiene el servicio de BB y tambien DATA, no registramos el servicio de DATA.
                IF NOT (v_tiene_bb AND v_dummy > 0) THEN
                    --registrar el servicio para poder devolverlo cuando se levante la suspencion
                    po_cod_err := 'PVT-2854';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al invocar a cc_cl_servicio_suspendido.alta
                    cc_cl_servicio_suspendido.alta
                          (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                           pi_cod_servicio                => curservdesasig.cod_servicio,
                           pi_cod_usuario                 => pi_cod_usuario,
                           pi_id_tran                     => v_id_tran,
                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                           pi_fch_tran                    => v_fch_tran,
                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                           po_id_registro                 => v_id_reg,
                           po_cod_err                     => po_cod_err,
                           po_msj_err                     => po_msj_err
                          );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
            END LOOP;

            IF NOT v_bloq_data AND v_cod_linea_negocio NOT IN ('T1VOZ', 'INTER', 'VOIP') AND v_susp_esp_hibpre = c_falso THEN

                IF es_suscriptor_4g(v_reg_entidad_consumo.id_entidad_consumo) = c_verdadero THEN

                    SELECT tx_vpg_util.get_comando('BLQDAT', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                       INTO v_command_id
                    FROM DUAL;
                ELSE
                    SELECT tx_vpg_util.get_comando('DATA', v_reg_entidad_consumo.cod_forma_consumo, 'DEL')
                       INTO v_command_id
                    FROM DUAL;
                END IF;

                po_cod_err := 'PVT-5236'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden para bloqueo de llamadas salientes.
                mt_vpg.alta_orden(
                        pi_id_comando           => v_command_id,
                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_fch_programada       => v_fch_tran,
                        pi_cod_transaccion      => c_tipo_transaccion,
                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                        pi_p2                   => v_reg_entidad_consumo.imsi,
                        pi_cod_usuario          => pi_cod_usuario,
                        pi_master               => '0',
                        pi_id_tran              => v_id_tran,
                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                        pi_fch_tran             => v_fch_tran,
                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                        po_id_orden             => v_po_id_orden,
                        po_id_tran              => v_po_id_tran,
                        po_fch_tran             => v_po_fch_tran,
                        po_cod_err              => po_cod_err,
                        po_msj_err              => po_msj_err
                        );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;

            --Quitar servicios de minutos-sms
            FOR c_serv IN (SELECT   sec.cod_servicio
                             FROM cl_servicio_entidad_consumo sec, bm_servicio s
                            WHERE sec.id_entidad_consumo = v_reg_corte_entidad_consumo.id_entidad_consumo
                              AND sec.cod_servicio =  s.cod_Servicio
                              AND s.cod_tipo_servicio IN ('TSMION','TSMIOF','TSSMS')
                              AND s.cod_servicio <> 'PLVOZ100' -- fix no quitar paq minutos adicionales
                              AND sec.estado <> c_estado_inactivo
                              AND sec.fch_fin = c_fecha_fin)
            LOOP

                po_cod_err := 'PVT-6031'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al dar de alta al registro..
                cc_cl_servicio_suspendido.alta
                      (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                       pi_cod_servicio                => c_serv.cod_servicio,
                       pi_cod_usuario                 => pi_cod_usuario,
                       pi_id_tran                     => v_id_tran,
                       pi_cod_gestion_tran            => v_cod_gestion_tran,
                       pi_fch_tran                    => v_fch_tran,
                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                       po_id_registro                 => v_id_reg,
                       po_cod_err                     => po_cod_err,
                       po_msj_err                     => po_msj_err
                      );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-6032'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al dar de baja al registro..
                cc_cl_servicio_entidad_consumo.desasignar
                           (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                            pi_cod_servicio                => c_serv.cod_servicio,
                            pi_cod_usuario                 => pi_cod_usuario,
                            pi_id_tran                     => v_id_tran,
                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                            pi_fch_tran                    => v_fch_tran,
                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                            pi_fch_efectiva                => v_fch_tran,
                            po_cod_err                     => po_cod_err,
                            po_msj_err                     => po_msj_err
                           );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END LOOP;


        END IF;

        --PROVISIONAR LA ASIGNACION DEL SUSCRIPTOR AL CUSTOMER GROUP DESTINO
        v_identificador_entidad    := v_reg_entidad_consumo.identificador_entidad;
        IF v_reg_entidad_consumo.cod_tecnologia = 'SAAS' THEN
            po_cod_err := 'PVT-6161'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al tx_vens_generate_events.saas_change_status.
            tx_vens_generate_events.saas_change_status(
                    pi_pcs                  => v_identificador_entidad,
                    pi_internal_id          => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_status               => 'inactive',
                    pi_cod_plan             => v_reg_entidad_consumo.cod_plan,
                    pi_master               => pi_master,
                    pi_id_tran              => v_id_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
            );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        IF v_cod_linea_negocio NOT IN ('1162', 'T1VOZ', 'INTER', 'VOIP','INTERM') THEN
            IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_gsm THEN
                IF v_susp_salientes_ini > 0 AND v_susp_salientes_fin = 0 THEN
                    v_operacion    := c_tipo_operacion_del;
                ELSIF v_susp_salientes_ini = 0 AND v_susp_salientes_fin > 0 THEN
                    v_operacion    := c_tipo_operacion_add;
                ELSE
                    v_operacion    := NULL;
                END IF;

                IF v_operacion IS NOT NULL THEN

                    ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                    SELECT tx_vpg_util.get_comando(c_susp_salientes, v_reg_entidad_consumo.cod_forma_consumo, v_operacion)
                       INTO v_command_id
                    FROM DUAL;

                    po_cod_err := 'PVT-5029'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden para bloqueo de llamadas salientes.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => c_tipo_transaccion,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------

                END IF;

                IF v_susp_entrantes_ini > 0 AND v_susp_entrantes_fin = 0 THEN
                    v_operacion    := c_tipo_operacion_del;
                ELSIF v_susp_entrantes_ini = 0 AND v_susp_entrantes_fin > 0 THEN
                    v_operacion    := c_tipo_operacion_add;
                ELSE
                    v_operacion    := NULL;
                END IF;

                IF v_operacion IS NOT NULL THEN

                    ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                    SELECT tx_vpg_util.get_comando(c_susp_entrantes, v_reg_entidad_consumo.cod_forma_consumo, v_operacion)
                       INTO v_command_id
                    FROM DUAL;

                    po_cod_err := 'PVT-5030'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden para bloqueo de llamadas entrantes.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => c_tipo_transaccion,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------

                END IF;
              --SE ELIMINO CODIGO DE CDMA QUE HABIA AQUI, YA QUE NO EXISTEN CLIENTES CON ESTA TECNOLOGIA
            END IF;
        END IF;

        po_cod_err := 'PVT-2863';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al afectar subsidios
        tx_subsidio.consolidar_prospecto_subsidios
                                    (pi_id_prospecto_cp             => v_reg_corte_entidad_consumo.id_prospecto,
                                     pi_cod_usuario                 => pi_cod_usuario,
                                     pi_master                      => c_falso,
                                     pi_id_tran                     => v_id_tran,
                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                     pi_fch_tran                    => v_fch_tran,
                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                     po_cod_err                     => po_cod_err,
                                     po_msj_err                     => po_msj_err
                                    );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --EN CASO DE DESCONEXION POR TERMINACION EN VENTA DEVUELTA DESASOCIAR LOS ARTICULOS GSM Y CDMA
        IF     v_reg_corte_entidad_consumo.cod_servicio = 'SDPO'
           AND v_reg_corte_entidad_consumo.cod_motivo IN
                                                 ('CCTT15', 'TRTT46', 'TRTT15', 'SDTT15', 'CECM26') THEN
            FOR cur IN (SELECT id_registro
                          FROM cl_articulo_entidad_consumo aec
                         WHERE aec.id_entidad_consumo =
                                                      v_reg_corte_entidad_consumo.id_entidad_consumo
                           AND aec.cod_rubro_articulo IN ('TAGSM', 'TACDMA')
                           AND aec.estado <> c_estado_inactivo
                           AND aec.fch_fin = c_fecha_fin)
            LOOP
                cc_cl_articulo_entidad_consumo.desasignar
                          (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                           pi_id_registro                 => cur.id_registro,
                           pi_cod_usuario                 => pi_cod_usuario,
                           pi_id_tran                     => v_id_tran,
                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                           pi_fch_tran                    => v_fch_tran,
                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                           pi_fch_efectiva                => v_fch_tran,
                           po_cod_err                     => po_cod_err,
                           po_msj_err                     => po_msj_err
                          );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END LOOP;
        END IF;

        IF v_reg_corte_entidad_consumo.cod_servicio = 'SSTMP' THEN
            SELECT COUNT (1)
              INTO v_dummy
              FROM bm_plan
             WHERE cod_plan = v_reg_entidad_consumo.cod_plan AND c1_offer_id IS NOT NULL;

            IF v_dummy > 0 THEN   --v_reg_entidad_consumo.cod_forma_consumo IN (c_forma_consumo_prepago,c_forma_consumo_full) THEN
                -- Obtener informacion de la plataforma.
                po_cod_err := 'PVT-2864';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al invocar al procedimiento tx_ecms.getSubscriberBalance
                tx_ecms.getSubscriberBalance(pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                             po_balance_info         => v_balance_info,
                                             po_cod_err              => po_cod_err,
                                             po_msj_err              => po_msj_err
                                             );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                -- Fechas de expiracion de los bolsillos.
                v_date_exp_core_balance       := v_balance_info (tx_ecms.c_bal_core_balance).expirationdate;
                v_date_exp_promo_balance_1    := v_balance_info (tx_ecms.c_bal_promotional_balance_1).expirationdate;

                BEGIN
                    v_date_exp_free_sec_balance    := v_balance_info (tx_ecms.c_bal_free_seconds_balance).expirationdate;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        v_date_exp_free_sec_balance    := NULL;
                END;

                --Solo tenemos clientes GSM
                v_id_accion    := 286;

                -- Movemos la fecha de expiracion del bolsillo CORE BALANCE.
                IF     v_date_exp_core_balance IS NOT NULL
                   AND v_date_exp_core_balance < ADD_MONTHS (SYSDATE, 12) THEN
                    -- Sumando la duracion de la suspencion.
                    v_date_exp_core_balance    :=   v_date_exp_core_balance
                                                  + (  v_reg_corte_entidad_consumo.fch_efectiva_fin
                                                     - v_reg_corte_entidad_consumo.fch_efectiva_inicio
                                                    );
                    ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                    SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                       INTO v_command_id
                    FROM DUAL;

                    v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_core_balance);

                    po_cod_err := 'PVT-5031'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al cambiar la fecha de core balance en charging system.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                            pi_p4                   => 0,
                            pi_p5                   => 'OMEGA:' || v_reg_corte_entidad_consumo.cod_servicio,
                            pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                            pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                            pi_p8                   => NULL, --balance_start_date
                            pi_p9                   => TO_CHAR (v_date_exp_core_balance, 'YYYY-MM-DD'), --balance_expiry_date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                END IF;

                -- Movemos la fecha de expiracion del bolsillo PROMOTIONAL BALANCE 1.
                IF     v_date_exp_promo_balance_1 IS NOT NULL
                   AND v_date_exp_promo_balance_1 < ADD_MONTHS (SYSDATE, 12) THEN
                    -- Sumando la duracion de la suspencion.
                    v_date_exp_promo_balance_1    :=
                          v_date_exp_promo_balance_1
                        + (  v_reg_corte_entidad_consumo.fch_efectiva_fin
                           - v_reg_corte_entidad_consumo.fch_efectiva_inicio
                          );


                    ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                    SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                       INTO v_command_id
                    FROM DUAL;

                    v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_promotional_balance_1);

                    po_cod_err := 'PVT-5032'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al cambiar la fecha de balance promocional en charging system.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                            pi_p4                   => 0,
                            pi_p5                   => 'OMEGA:' || v_reg_corte_entidad_consumo.cod_servicio,
                            pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                            pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                            pi_p8                   => NULL, --balance_start_date
                            pi_p9                   => TO_CHAR (v_date_exp_promo_balance_1, 'YYYY-MM-DD'), --balance_expiry_date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                END IF;

                -- Movemos la fecha de expiracion del bolsillo FREE SECONDS.
                IF     v_date_exp_free_sec_balance IS NOT NULL
                   AND v_date_exp_free_sec_balance < ADD_MONTHS (SYSDATE, 12) THEN
                    -- Sumando la duracion de la suspencion.
                    v_date_exp_free_sec_balance    :=
                          v_date_exp_free_sec_balance
                        + (  v_reg_corte_entidad_consumo.fch_efectiva_fin
                           - v_reg_corte_entidad_consumo.fch_efectiva_inicio
                          );

                    ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                    SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                       INTO v_command_id
                    FROM DUAL;

                    v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_free_seconds_balance);

                    po_cod_err := 'PVT-5072'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al cambiar la fecha de free seconds en CS.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                            pi_p4                   => 0,
                            pi_p5                   => 'OMEGA:' || v_reg_corte_entidad_consumo.cod_servicio,
                            pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                            pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                            pi_p8                   => NULL, --balance_start_date
                            pi_p9                   => TO_CHAR (v_date_exp_free_sec_balance, 'YYYY-MM-DD'), --balance_expiry_date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------


                END IF;
            END IF;
        END IF;

        IF v_susp_esp_hibpre = c_verdadero THEN
            --REGISTRAr servico de control
            cc_cl_servicio_suspendido.alta
                          (pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                           pi_cod_servicio                => 'SHIBESP',
                           pi_cod_usuario                 => pi_cod_usuario,
                           pi_id_tran                     => v_id_tran,
                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                           pi_fch_tran                    => v_fch_tran,
                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                           po_id_registro                 => v_id_reg,
                           po_cod_err                     => po_cod_err,
                           po_msj_err                     => po_msj_err
                          );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            -- Para estos planes enviar orden de activar Service Offering par no ejecucion de PAM.
            po_cod_err := 'PVT-6014'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden..
            SELECT tx_vpg_util.get_comando('SET_SERV_OFFERING', 'CCOPRE', 'SET')
              INTO v_command_id
              FROM DUAL;

            po_cod_err := 'PVT-6015'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden..
            mt_vpg.alta_orden(
                        pi_id_comando           => v_command_id,
                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_fch_programada       => v_fch_tran,
                        pi_cod_transaccion      => v_cod_tran,
                        pi_p1                   => '1'||v_reg_entidad_consumo.identificador_entidad,
                        pi_p2                   => v_id_tran,
                        pi_p3                   => tx_vpg_util.date2iso(v_fch_tran),
                        pi_p4                   => '6',  -- SErvice offering
                        pi_p5                   => '1',  -- Flag activado
                        pi_cod_usuario          => pi_cod_usuario,
                        pi_master               => c_falso,
                        pi_id_tran              => v_id_tran,
                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                        pi_fch_tran             => v_fch_tran,
                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                        po_id_orden             => v_po_id_orden,
                        po_id_tran              => v_po_id_tran,
                        po_fch_tran             => v_po_fch_tran,
                        po_cod_err              => po_cod_err,
                        po_msj_err              => po_msj_err
                        );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            /*Para terminar la session activa de datos enviar un orden de bloqueo de navegacion
                y luego otra orden en diferido para habilitar navegacion nuevamente
            */

            --Primer bloqueo
            IF es_suscriptor_4g(v_reg_entidad_consumo.id_entidad_consumo) = c_verdadero THEN
                v_cod_enlace    :=  'BLQDAT';
            ELSE
                v_cod_enlace    :=  'BLQ3G';
            END IF;

            SELECT COUNT(1) INTO v_dummy
                FROM cnf_configuracion_especial
            WHERE nombre_tabla = 'HSS_MIFI'
            AND parametro_1 = v_reg_entidad_consumo.cod_plan;

            IF v_dummy != c_falso THEN

                SELECT COUNT(1) INTO v_dummy
                    FROM cl_inclusion_mifi_lte
                WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                AND estado = c_estado_activo AND fch_fin = c_fecha_fin;

                IF v_dummy = c_falso THEN
                    v_cod_enlace := 'BLQ3G';
                END IF;

            END IF;

            po_cod_err := 'PVT-6028'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden para bloqueo de llamadas salientes.

            SELECT tx_vpg_util.get_comando(v_cod_enlace, v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
               INTO v_command_id
            FROM DUAL;

            mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_tran,
                    pi_cod_transaccion      => c_tipo_transaccion,
                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_p2                   => v_reg_entidad_consumo.imsi,
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => '0',
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_po_id_orden,
                    po_id_tran              => v_po_id_tran,
                    po_fch_tran             => v_po_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            --Order diferida de desbloqueo
            po_cod_err := 'PVT-6029'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden para bloqueo de llamadas salientes.

            SELECT tx_vpg_util.get_comando(v_cod_enlace, v_reg_entidad_consumo.cod_forma_consumo, 'DEL')
               INTO v_command_id
            FROM DUAL;

            mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => SYSDATE + (1/1440*c_min_diferido_ord_bloq),
                    pi_cod_transaccion      => c_tipo_transaccion,
                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_p2                   => v_reg_entidad_consumo.imsi,
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => '0',
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_po_id_orden,
                    po_id_tran              => v_po_id_tran,
                    po_fch_tran             => v_po_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;


        END IF;

        --CAMBIO DE ESTADO DEL PROSPECTO DE VENTA A PAGADO
        po_cod_err := 'PVT-2868';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al invocar al procedimiento CC_VTA_CORTE_ENTIDAD_CONSUMO.CAMBIO_ESTADO
        cc_vta_corte_entidad_consumo.cambio_estado (pi_id_prospecto                => pi_id_prospecto,
                                                    pi_nuevo_estado                => c_estado_pagado,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        -- <ECN    20100922   RQX-2419 Validar si la cuenta tiene suscriptores con planes dependientes de otros planes.
        tx_pvt_ccs.tiene_planes_dependientes (v_reg_entidad_consumo.id_comunidad_facturante,
                                              po_cod_err, po_msj_err);

        IF po_cod_err <> 'OK' THEN
            po_cod_err := 'PVT-2869';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: El cliente tiene un suscriptor con un plan que depende del plan del presente suscriptor.
            RAISE err_app;
        END IF;

        -- ECN    20100922   RQX-2419 Validar si la cuenta tiene suscriptores con planes dependientes de otros planes. >
        po_cod_err := 'PVT-2870';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al obtener el id del cliente.
        v_id_cliente               := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        po_cod_err := 'PVT-2871';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al recuperar la descripcion del nuevo estado.

        SELECT descripcion
          INTO descripcion_nuevo_estado
          FROM cnf_estado_entidad c
         WHERE c.cod_estado = v_estado_fin
           AND c.cod_entidad = c_nivel_entidad_consumo
           AND c.estado <> c_estado_inactivo
           AND c.fch_fin = c_fecha_fin;

        po_cod_err := 'PVT-2872';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al recuperar la descripcion del estado actual.

        SELECT descripcion
          INTO descripcion_estado_actual
          FROM cnf_estado_entidad c
         WHERE c.cod_estado = v_estado_ini
           AND c.cod_entidad = c_nivel_entidad_consumo
           AND c.estado <> c_estado_inactivo
           AND c.fch_fin = c_fecha_fin;

        v_trama_nuevo_pv           :=
               'Estado:'
            || v_estado_fin
            || '|'
            || 'Descripcion:'
            || descripcion_nuevo_estado
            || '|'
            || 'Fecha Inicio:'
            || NVL (TO_CHAR (v_reg_corte_entidad_consumo.fch_efectiva_inicio,
                             'YYYY-MM-DD HH24.MI.SS'),
                    '-')
            || '|'
            || 'Fecha Fin:'
            || NVL (TO_CHAR (v_reg_corte_entidad_consumo.fch_efectiva_fin, 'YYYY-MM-DD HH24.MI.SS'),
                    '-');
        v_trama_anterior_pv        :=    'Estado:'
                                      || v_estado_ini
                                      || '|'
                                      || 'Descripcion:'
                                      || descripcion_estado_actual
                                      || '|'
                                      || 'Fecha Inicio:'
                                      || '-'
                                      || '|'
                                      || 'Fecha Fin:'
                                      || '-';
        --- Registrar transaccion
        po_cod_err := 'PVT-2873';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
        cc_tx_transaccion_postventa.alta
                           (pi_id_tran                     => v_id_tran,
                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                            pi_cod_tipo                    => c_tipo_transaccion,
                            pi_id_cliente                  => v_id_cliente,
                            pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                            pi_id_entidad_consumo          => v_reg_corte_entidad_consumo.id_entidad_consumo,
                            pi_cod_motivo_transaccion      => v_reg_corte_entidad_consumo.cod_motivo,
                            pi_cod_observacion             => NULL,
                            pi_descripcion_observacion     => NULL,
                            pi_valor_anterior              => v_trama_anterior_pv,
                            pi_valor_nuevo                 => v_trama_nuevo_pv,
                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                            pi_fch_tran                    => v_fch_tran,
                            pi_cod_usuario                 => pi_cod_usuario,
                            po_cod_err                     => po_cod_err,
                            po_msj_err                     => po_msj_err
                           );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_entidad_consumo e, cl_servicio_entidad_consumo s
         WHERE e.id_comunidad_facturante = v_reg_entidad_consumo.id_comunidad_facturante
           AND e.estado NOT IN (c_estado_inactivo, 'TER')
           AND s.id_entidad_consumo = e.id_entidad_consumo
           AND s.cod_servicio = 'SDPO'
           AND s.estado = c_estado_activo
           AND s.fch_fin = c_fecha_fin;

        SELECT COUNT (1)
          INTO v_num_ec
          FROM cl_entidad_consumo
         WHERE id_comunidad_facturante = v_reg_entidad_consumo.id_comunidad_facturante
           AND estado NOT IN (c_estado_inactivo, 'TER');

        IF v_reg_corte_entidad_consumo.cod_servicio = 'SDPO' AND (v_num_ec - v_dummy) = 0 THEN
            FOR c_reg_cargo_adicional IN
                (SELECT *
                   FROM bl_cargo_adicional
                  WHERE id_comunidad_facturante = v_reg_entidad_consumo.id_comunidad_facturante
                    AND id_cargo = c_cargo_promodesc2k8   -- CARGO POR 'DESCUENTO DE PAGO' (5024)
                    AND estado = c_estado_activo
                    AND fch_fin = c_fecha_fin)
            LOOP
                po_cod_err := 'PVT-2874';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al invocar a CC_BL_CARGO_ADICIONAL.BAJA.
                cc_bl_cargo_adicional.baja
                              (pi_id_registro                 => c_reg_cargo_adicional.id_registro,
                               pi_cod_periodo_facturacion     => c_reg_cargo_adicional.cod_periodo_fin,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_id_tran                     => v_id_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END LOOP;
        END IF;

        /*INICIO RQX 5374*/
        po_cod_err := 'PVT-2875';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al buscar la cantidad de entidades con servicios SDPO y SDPOR
         SELECT COUNT (1)
          INTO v_dummy
          FROM cl_entidad_consumo e, cl_servicio_entidad_consumo s
         WHERE e.id_comunidad_facturante = v_reg_entidad_consumo.id_comunidad_facturante
           AND e.estado NOT IN (c_estado_inactivo, 'TER','POST')
           AND s.id_entidad_consumo = e.id_entidad_consumo
           AND s.cod_servicio in('SDPO','SDPOR')
           AND s.estado = c_estado_activo
           AND s.fch_fin = c_fecha_fin;

        po_cod_err := 'PVT-2876';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al validar cantidad de entiedades que no esten I, TER, POST.
        SELECT COUNT(1)
          INTO v_num_ec
          FROM cl_entidad_consumo
         WHERE id_comunidad_facturante = v_reg_entidad_consumo.id_comunidad_facturante
           AND estado NOT IN (c_estado_inactivo, 'TER','POST');

        IF v_reg_corte_entidad_consumo.cod_servicio in('SDPO','SDPOR') AND (v_num_ec - v_dummy) = 0 THEN

            po_cod_err := 'PVT-2877';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al buscar el segmento de la entidad.
            SELECT cod_segmento
              INTO v_segmento_plan
              FROM v_plan_segmento
             WHERE cod_plan = (SELECT cod_plan
                                 FROM cl_entidad_consumo
                                WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo);

           po_cod_err := 'PVT-2878';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al obtener la configuracion especial para el numero.
           SELECT COUNT(1)
            INTO v_dummy
            FROM cnf_configuracion_especial
            WHERE tipo = 'CARGOS_X_COBRAR'
            AND cod_registro = 'TX_TRAN_DESCONEXION'
            AND parametro_11 = '1'
            AND parametro_1 = v_segmento_plan
            AND parametro_2 is null;

            IF v_dummy > 0 THEN
                po_cod_err := 'PVT-2879';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al invocar al procedimiento TX_PVT_POLITICAS.SET_MORA.
                tx_pvt_politicas.set_mora
                (
                    pi_id_comunidad             => v_reg_entidad_consumo.id_comunidad_facturante,
                    pi_pre_delete               => c_verdadero,
                    po_cod_err                  => po_cod_err,
                    po_msj_err                  => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-2880';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al obtener la mora del numero.
                SELECT valor_cimp
                INTO v_mora
                FROM vta_deuda_pendiente
                WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                ;

                    IF v_mora > 0 THEN

                        po_cod_err := 'PVT-2881';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al ejecutar el cc_cta_nota.consolidar_nota_debito.
                        cc_cta_nota.consolidar_nota_debito(pi_cod_tipo_documento          => 'NDEB07',
                                                           pi_id_cuenta_corriente         => get_id_cc(v_reg_entidad_consumo.id_comunidad_facturante),
                                                           pi_observacion                 => 'CARGO POR MORA',
                                                           pi_fch_vencimiento             => TRUNC (v_fch_tran + 1),
                                                           pi_nro_doc_externo             => NULL,
                                                           pi_monto                       => v_mora,
                                                           pi_cod_usuario                 => pi_cod_usuario,
                                                           pi_master                      => pi_master,
                                                           pi_id_tran                     => v_id_tran,
                                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                           pi_fch_tran                    => v_fch_tran,
                                                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                           po_nro_doc_nota                => v_nro_doc_nota,
                                                           po_cod_err                     => po_cod_err,
                                                           po_msj_err                     => po_msj_err
                                                           );
                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;
                    END IF;
              END IF;
        END IF;

        /*FINAL RQX 5374*/


        --RQX 4119 BUNDLE FASE 1 (Eliseo Reyes)
        -- tiene algun paquete? terminar.
        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_paquete_entidad_consumo cpe
         WHERE cpe.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
           AND cpe.estado = 'A'
           AND cpe.fch_tran_fin = utl_verificacion.get_end_date;

        IF v_dummy > c_falso THEN
            po_cod_err := 'PVT-2882';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOLIDACION: Error al recuperar el bundle

            BEGIN
                SELECT cpec.id_paquete
                  INTO v_id_paquete
                  FROM cl_paquete_entidad_consumo cpec
                 WHERE cpec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                   AND cpec.estado = 'A'
                   AND cpec.fch_tran_fin = utl_verificacion.get_end_date;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_id_paquete    := NULL;
            END;

            IF v_id_paquete IS NOT NULL THEN
                po_cod_err := 'PVT-2883';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOLIDACION: Error al invocar al TX_CL_PAQUETE
                tx_cl_paquete.baja_paquete (pi_id_paquete                  => v_id_paquete,
                                            pi_id_tran                     => v_id_tran,
                                            pi_fch_tran                    => v_fch_tran,
                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                            pi_cod_usuario                 => pi_cod_usuario,
                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            pi_master                      => c_falso,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        --END RQX 419
        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                 := 'OK';
        po_msj_err                 := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE corte_entidad_consumo (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_servicio           IN       bm_servicio.cod_servicio%TYPE,
        pi_cod_motivo             IN       tx_transaccion_postventa.cod_motivo_transaccion%TYPE,
        pi_cod_submotivo          IN       vta_corte_entidad_consumo.cod_submotivo%TYPE DEFAULT NULL,
        pi_es_pago_diferido       IN       vta_corte_entidad_consumo.es_pago_diferido%TYPE,
        pi_id_entidad_venta       IN       vta_venta_entidad.id_venta_entidad%TYPE,
        pi_cod_usuario_asignado   IN       vta_venta_entidad.cod_usuario_asignado%TYPE,
        pi_id_prospecto_com       IN       vta_corte_entidad_consumo.id_prospecto_com%TYPE,
        pi_id_venta_com           IN       vta_venta_prospecto.id_venta%TYPE,
        pi_imei                   IN       eir_orden.imei%TYPE DEFAULT NULL,
        pi_fch_efectiva_inicio    IN       vta_corte_entidad_consumo.fch_efectiva_inicio%TYPE
                DEFAULT NULL,
        pi_fch_efectiva_fin       IN       vta_corte_entidad_consumo.fch_efectiva_fin%TYPE
                DEFAULT NULL,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT cnf_constante.valor%TYPE
                            := tx_cnf_constante.get_constante ('TRANSACCION_CORTE_ENTIDAD_CONSUMO');
        c_suspension_tmp_meses_act CONSTANT cnf_constante.valor%TYPE
                                := tx_cnf_constante.get_constante ('SUSPENCION_TEMPORAL_MESES_ACT');
        c_suspension_tmp_meses_req CONSTANT cnf_constante.valor%TYPE
                                := tx_cnf_constante.get_constante ('SUSPENCION_TEMPORAL_MESES_REQ');
        c_suspension_tmp_meses_min CONSTANT cnf_constante.valor%TYPE
                                := tx_cnf_constante.get_constante ('SUSPENCION_TEMPORAL_MESES_MIN');
        c_suspension_tmp_meses_max CONSTANT cnf_constante.valor%TYPE
                                := tx_cnf_constante.get_constante ('SUSPENCION_TEMPORAL_MESES_MAX');
        c_suspension_tmp_deuda_max CONSTANT cnf_constante.valor%TYPE
                                := tx_cnf_constante.get_constante ('SUSPENCION_TEMPORAL_DEUDA_MAX');
        c_costo_mes_suspension_tmp CONSTANT cnf_constante.valor%TYPE
                                := tx_cnf_constante.get_constante ('COSTO_MES_SUSPENSION_TEMPORAL');
        c_id_cargo_suspension_tmp CONSTANT cnf_constante.valor%TYPE
                                      := tx_cnf_constante.get_constante ('ID_CARGO_SUSPENSION_TMP');

        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.CORTE_ENTIDAD_CONSUMO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_operacion                   VARCHAR2 (10);
        v_estado_ini                  bm_servicio_suspension.estado_asociado%TYPE;
        v_customer_group_ini          bm_servicio_suspension.grupo_cliente%TYPE;
        v_susp_salientes_ini          bm_servicio_suspension.susp_salientes%TYPE;
        v_susp_entrantes_ini          bm_servicio_suspension.susp_entrantes%TYPE;
        v_estado_fin                  bm_servicio_suspension.estado_asociado%TYPE;
        v_customer_group_fin          bm_servicio_suspension.grupo_cliente%TYPE;
        v_susp_salientes_fin          bm_servicio_suspension.susp_salientes%TYPE;
        v_susp_entrantes_fin          bm_servicio_suspension.susp_entrantes%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_reg_servicio_suspension     bm_servicio_suspension%ROWTYPE;
        v_dummy                       PLS_INTEGER;
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_id_servicio_ec              cl_servicio_entidad_consumo.id_registro%TYPE;
        v_cod_tipo_articulo           cl_articulo_entidad_consumo.cod_rubro_articulo%TYPE;
        v_nro_serie_articulo          cl_articulo_entidad_consumo.nro_serie%TYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_se_renta                    bm_grupo_plan.se_renta%TYPE;
        v_id_prospecto                vta_corte_entidad_consumo.id_prospecto%TYPE;
        v_nombre_factura              VARCHAR2 (200);
        v_rnc_factura                 cl_persona.nit%TYPE;
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_monto_total                 vta_venta_prospecto.valor%TYPE;
        v_precio_venta_con_imp        inv_precio_articulo.precio%TYPE := 0;
        v_id_venta_entidad            vta_venta_entidad.id_venta_entidad%TYPE;
        v_id_venta_main               vta_venta_prospecto.id_venta%TYPE;
        v_id_prospecto_main           vta_venta_prospecto.id_prospecto%TYPE;
        v_precio_penalidad            NUMBER (15, 5) := 0;
        v_nro_documento               cta_doc_cuenta_corriente.nro_documento%TYPE;
        v_cod_ciclo                   cl_comunidad.cod_ciclo_facturacion%TYPE;
        v_id_cuenta_corriente         cl_comunidad.id_cuenta_corriente%TYPE;
        v_reg_periodo                 tr_periodo_facturacion%ROWTYPE;
        v_precio_penalidad_imp        NUMBER (15, 5) := 0;
        v_id_contrato                 cl_contrato_entidad_consumo.id_contrato%TYPE;
        v_cod_origen                  cl_contrato_entidad_consumo.cod_origen%TYPE;
        v_fecha_ultimo_contrato       cl_contrato_entidad_consumo.fch_inicio%TYPE;
        v_id_prospecto_con            cl_contrato_entidad_consumo.id_prospecto%TYPE;
        v_cod_articulo_con            vta_articulo_prospecto.cod_articulo%TYPE;
        v_precio_venta_con            vta_articulo_prospecto.precio_venta%TYPE;
        v_procedencia_articulo_con    vta_articulo_prospecto.procedencia_articulo%TYPE;
        v_dias                        PLS_INTEGER;
        v_permiso                     VARCHAR2 (10);
        v_cod_categoria_documento     bl_dosificacion.cod_categoria_documento%TYPE;
        v_existe_excepcion            BOOLEAN;
        v_id_documento_cargo          vta_venta_prospecto.id_venta%TYPE;
        v_id_tran_cargo               tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran_cargo      tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_id_prospecto_detalle        vta_venta_prospecto_detalle.id_prospecto_detalle%TYPE;
        v_monto_deuda_total           NUMBER;
        v_body                        mail_mensaje.body_%TYPE;
        v_nombre_empresa              cl_persona.nombre%TYPE;
        v_to_mail                     mail_mensaje.to_%TYPE;

        TYPE t_penalidad IS RECORD (
            cod_tipo_documento  cnf_cta_tipo_documento.cod_tipo_documento%TYPE,
            id_cargo            NUMBER(15,5),
            valor_simp          NUMBER(15,5),
            valor_cimp          NUMBER(15,5)
        );
        TYPE t_docs_penalidad IS TABLE OF t_penalidad INDEX BY BINARY_INTEGER;

        v_docs_penalidad              t_docs_penalidad;
        v_penalidad                   t_penalidad;
        v_doc                         BINARY_INTEGER;

        TYPE t_subsidio IS VARRAY (3) OF NUMBER (15, 5);

        TYPE t_subsidios IS TABLE OF t_subsidio
            INDEX BY BINARY_INTEGER;

        v_subsidios                   t_subsidios;
        v_subs                        NUMBER (15, 0);
        v_cant_meses_suspension       NUMBER := NULL;
        v_cod_tipo_documento_sstmp    cnf_cta_tipo_documento.cod_tipo_documento%TYPE := 'PGSTMP';
        v_valor_sstmp                 vta_venta_prospecto_detalle.valor%TYPE;
        v_costo_stmp                  NUMBER := NULL;
        v_cod_periodo_facturacion     tr_periodo_facturacion.cod_periodo%TYPE;
        v_id_registro_cargo_adic_stmp bl_cargo_adicional.id_registro%TYPE;
        v_cod_transaccion             VARCHAR2(100);
        v_monto_deposito              NUMBER;
        v_monto_deposito_tmp          NUMBER;
        v_monto_descuento             NUMBER;
        v_impuestos                   NUMBER;
        v_id_registro_dpt               NUMBER;
        po_fch_tran                     DATE;
        v_monto_descuento_imp           NUMBER;

        -- Excepciones
        err_app                       EXCEPTION;
        v_deuda_corriente             NUMBER;
        v_deuda_cuenta                NUMBER;
        v_desconexion_intencional     NUMBER;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                     :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_servicio:'
            || pi_cod_servicio
            || '|'
            || 'pi_cod_motivo:'
            || pi_cod_motivo
            || '|'
            || 'pi_cod_submotivo:'
            || pi_cod_submotivo
            || '|'
            || 'pi_es_pago_diferido:'
            || pi_es_pago_diferido
            || '|'
            || 'pi_id_entidad_venta:'
            || pi_id_entidad_venta
            || '|'
            || 'pi_cod_usuario_asignado:'
            || pi_cod_usuario_asignado
            || '|'
            || 'pi_id_prospecto_com:'
            || pi_id_prospecto_com
            || '|'
            || 'pi_id_venta_com:'
            || pi_id_venta_com
            || '|'
            || 'pi_imei:'
            || pi_imei
            || '|'
            || 'pi_fch_efectiva_inicio:'
            || pi_fch_efectiva_inicio
            || '|'
            || 'pi_fch_efectiva_fin:'
            || pi_fch_efectiva_fin
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_servicio IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2884';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2885';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2886';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                     := v_id_tran;
        po_cod_gestion_tran            := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        --EL SUSCRIPTOR NO DEBE ESTAR TERMINADO
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --NO DEBE TENER UN CORTE PENDIENTE EN CAJA
        po_cod_err := 'PVT-2887';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al verificar si el suscriptor ya tiene la suspension o desconexion pendiente en caja

        SELECT COUNT (*)
          INTO v_dummy
          FROM vta_corte_entidad_consumo sec
         WHERE sec.id_entidad_consumo = pi_id_entidad_consumo AND sec.estado = c_estado_activo;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2888';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: El suscriptor ya tiene un pago por desconexion pendiente en caja
            RAISE err_app;
        END IF;

        --- VALIDAR PORTABILIDAD
        IF     tx_por_utiles.esta_en_proceso_portacion (v_reg_entidad_consumo.identificador_entidad) =
                                                                                         c_verdadero
           AND pi_cod_servicio = 'SDPO' THEN
            po_cod_err := 'PVT-2889';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: El numero tiene un proceso de portacion out en marcha
            RAISE err_app;
        END IF;

        --NO DEBE TENER ASIGNADO UN CORTE DEL MISMO TIPO
        po_cod_err := 'PVT-2890';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al verificar si el suscriptor ya tiene asignado la suspension o desconexion.

        SELECT COUNT (*)
          INTO v_dummy
          FROM cl_servicio_entidad_consumo sec
         WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
           AND sec.estado <> c_estado_inactivo
           AND sec.fch_fin = c_fecha_fin
           AND sec.cod_servicio = pi_cod_servicio;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2891';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: El suscriptor ya tiene asignado la suspension o desconexion.
            RAISE err_app;
        END IF;

        v_estado_ini                   := v_reg_entidad_consumo.estado;
        --DATOS DEL TIPO DE CORTE A APLICAR
        po_cod_err := 'PVT-2892';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al obtener los datos del tipo de corte a aplicar.

        SELECT ss.*
          INTO v_reg_servicio_suspension
          FROM bm_servicio_suspension ss
         WHERE ss.cod_servicio = pi_cod_servicio;

        --EL TIPO DE CORTE DEBE ESTAR VIGENTE
        IF v_reg_servicio_suspension.estado = c_estado_inactivo THEN
            po_cod_err := 'PVT-2893';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: El tipo de corte no esta vigente.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2894';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al obtener el id del cliente.
        v_id_cliente                   := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

        IF pi_cod_servicio = 'SDPOR' THEN
            v_cod_transaccion   := 'TX_TRAN_PORTABILIDAD';
        ELSE
            v_cod_transaccion   := 'TX_TRAN_DESCONEXION';
        END IF;

        IF pi_id_prospecto_com IS NULL THEN
            BEGIN
                po_cod_err := 'PVT-2895';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al invocar al procedimiento TX_PVT_POLITICAS.SET_DEUDA_PENDIENTE.
                tx_pvt_politicas.set_deuda_pendiente
                (
                    pi_cod_transaccion          => v_cod_transaccion,
                    pi_id_comunidad             => v_reg_entidad_consumo.id_comunidad_facturante,
                    pi_id_entidad_consumo       => NULL,
                    pi_cod_servicio             => pi_cod_servicio,
                    pi_cod_motivo               => pi_cod_motivo,
                    pi_cod_segmento_destino     => NULL,
                    pi_cod_plan_destino         => NULL,
                    po_cod_err                  => po_cod_err,
                    po_msj_err                  => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-2896';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al obtener la deuda total de la cuenta.
                SELECT SUM(valor_cimp),po_cod_err
                INTO v_monto_deuda_total,po_cod_err
                FROM vta_deuda_pendiente
                WHERE facturacion = 'PROXIMO_CICLO'
                AND tipo_registro <> 'DEPOSITO_INICIAL'
                AND (NVL(id_entidad_consumo,v_reg_entidad_consumo.id_entidad_consumo) = NVL(v_reg_entidad_consumo.id_entidad_consumo,id_entidad_consumo)
                    OR facturacion_pendiente = c_verdadero
                    )
                AND id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                GROUP BY id_comunidad,po_cod_err;

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_monto_deuda_total := 0;
            END;
        ELSE
            v_monto_deuda_total := 0;
        END IF;


        IF pi_cod_servicio = 'SDPOR' THEN
            po_cod_err := 'PVT-2897';   --TX_PVT_COMUNIDAD.CORTE_COMUNIDAD: Error al verificar la nueva politica de portabilidad.
            SELECT SUM(valor_vencido_cimp)
                INTO v_deuda_corriente
            FROM vta_deuda_pendiente
            WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

            IF tx_por_utiles.APLICA_NUEVA_POLITICA_DEUDA_EC(v_reg_entidad_consumo.id_entidad_consumo) = c_verdadero THEN
                v_monto_deuda_total   :=  v_deuda_corriente; -- solo deuda corriente no penalidades
            END IF;
        END IF;

        -- RQX-3863: Suspension Temporal.
        IF pi_cod_servicio = 'SSTMP' THEN
            /*
            -- Validar si tiene la antiguedad requerida (6 meses de antiguedad).
            IF ADD_MONTHS(TRUNC(v_reg_entidad_consumo.fch_creacion)+1,TO_NUMBER(c_suspension_tmp_meses_act)) > v_fch_tran THEN
                po_cod_err := 'PVT-2898';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: El suscriptor no tiene la antiguedad suficiente para este tipo de suspension.
                RAISE err_app;
            END IF;
            */
            SELECT COUNT (1)
              INTO v_dummy
              FROM cl_servicio_entidad_consumo
             WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND cod_servicio = pi_cod_servicio
               AND fch_fin BETWEEN ADD_MONTHS (TRUNC (v_fch_tran),
                                               -TO_NUMBER (c_suspension_tmp_meses_req))
                               AND TRUNC (v_fch_tran + 1)
               AND estado = c_estado_activo;

            IF v_dummy > 0 THEN
                po_cod_err := 'PVT-2899';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: El cliente ya tiene una suspension de este tipo en el ultimo anio.
                RAISE err_app;
            END IF;

            -- Se requiere que ingrese el intervalo del corte.
            IF pi_fch_efectiva_inicio IS NULL OR pi_fch_efectiva_fin IS NULL THEN
                po_cod_err := 'PVT-2900';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: No se ingreso el intervalo de la suspension.
                RAISE err_app;
            END IF;

            IF TRUNC (pi_fch_efectiva_inicio) <> TRUNC (v_fch_tran) THEN
                po_cod_err := 'PVT-2901';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: La suspension no puede iniciar antes o despues del dia de hoy.
                RAISE err_app;
            END IF;

            -- Validar que el tiempo de la suspension sea mayor a un mes.
            -- se ha quitado la suma de +1 a pi_fch_efectiva_inicio para realizar los cobros de suspension por mes
            IF ADD_MONTHS (TRUNC (pi_fch_efectiva_inicio), TO_NUMBER (c_suspension_tmp_meses_min)) >
                                                                                 pi_fch_efectiva_fin THEN
                po_cod_err := 'PVT-2902';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: El tiempo minimo de esta suspension es de un mes.
                RAISE err_app;
            END IF;

            -- Validar que el tiempo de la suspension sea menor a tres meses.
            IF ADD_MONTHS (TRUNC (pi_fch_efectiva_inicio) + 1,
                           TO_NUMBER (c_suspension_tmp_meses_max)) < pi_fch_efectiva_fin THEN
                po_cod_err := 'PVT-2903';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: El tiempo maximo de esta suspension es de tres meses.
                RAISE err_app;
            END IF;

            IF v_monto_deuda_total > c_suspension_tmp_deuda_max THEN
                po_cod_err := 'PVT-2904';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: La cuenta del cliente tiene deuda pendiente por pagar.
                RAISE err_app;
            END IF;
        ELSE
            IF v_monto_deuda_total > 0.99999 THEN
                po_cod_err := 'PVT-2905';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: La cuenta del cliente tiene deuda pendiente por pagar.
                RAISE err_app;
            END IF;
        END IF;

        --DETERMINAR LA LINEA DE NEGOCIO DE LA CUENTA
        po_cod_err := 'PVT-2906';   --TX_PVT_ENTIDAD_CONSUMO.SUSPENSION_ENTIDAD_CONSUMO: Error al determinar la linea de negocio de la cuenta.

        SELECT cod_linea_negocio
          INTO v_cod_linea_negocio
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        po_cod_err := 'PVT-2907';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al recuperar parametros del grupo plan

        SELECT NVL (bg.se_renta, 0)
          INTO v_se_renta
          FROM bm_plan b, bm_grupo_plan bg
         WHERE b.cod_grupo_plan = bg.cod_grupo_plan AND b.cod_plan = v_reg_entidad_consumo.cod_plan;

        IF v_se_renta = c_verdadero AND pi_cod_servicio NOT IN ('SDRB', c_serv_suspension_robo) THEN
            po_cod_err := 'PVT-2908';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: La suspension o desconexion no esta habilitada para el suscriptor
            RAISE err_app;
        END IF;

        --EL TIPO DE CORTE DEBE ESTAR HABILITADO PARA LA LINEA DE NEGOCIO, FORMA DE CONSUMO DEL SUSCRIPTOR
        IF v_reg_servicio_suspension.aplicable_a NOT LIKE
                 '%' || v_cod_linea_negocio || ',' || v_reg_entidad_consumo.cod_forma_consumo || '%' THEN
            po_cod_err := 'PVT-2909';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: El tipo de corte no es aplicable al suscriptor seleccionado.
            RAISE err_app;
        END IF;

        get_estado_entidad_consumo (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                    po_estado                      => v_estado_ini,
                                    po_customer_group              => v_customer_group_ini,
                                    po_salientes                   => v_susp_salientes_ini,
                                    po_entrantes                   => v_susp_entrantes_ini,
                                    po_cod_err                     => po_cod_err,
                                    po_msj_err                     => po_msj_err
                                   );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        IF pi_master = c_verdadero AND pi_cod_servicio = 'SDPOR' THEN
            po_cod_err := 'PVT-2910';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Transaccion no habilitada para esa pantalla
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2911';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al obtener el nuevo contrato
        tx_pvt_entidad_consumo.get_ultimo_contrato (pi_id_entidad_consumo,
                                                    v_id_contrato,
                                                    v_cod_origen,
                                                    v_fecha_ultimo_contrato,
                                                    v_id_prospecto_con,
                                                    v_cod_articulo_con,
                                                    v_precio_venta_con,
                                                    v_procedencia_articulo_con,
                                                    po_cod_err
                                                   );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2912';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al obtener el permiso de venta devuelta
        tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                   pi_cod_entidad                 => 'ESP_VENTA_DEVUELTA',
                                   pi_cod_usuario_tran            => pi_cod_usuario,
                                   po_permiso                     => v_permiso,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF v_permiso = c_verdadero THEN
            v_dias    := 15;
        ELSE
            v_dias    := 3;
        END IF;

        IF     pi_cod_servicio IN ('SDPO', 'SDPOR')
           AND pi_cod_motivo IN ('CCTT15', 'SDTT15', 'CECM26')
           AND NVL (v_fecha_ultimo_contrato, v_reg_entidad_consumo.fch_creacion) <
                                                                             TRUNC (SYSDATE)
                                                                             - v_dias THEN
            v_existe_excepcion    := FALSE;

            SELECT COUNT (1)
              INTO v_dummy
              FROM vta_excepcion e
             WHERE e.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND e.cod_tipo_excepcion = c_tipo_excepcion_vta_devuelta
               AND e.estado = c_estado_activo
               AND e.fch_inicio >= TRUNC (SYSDATE - 3);

            IF v_dummy > 0 THEN
                v_existe_excepcion    := TRUE;
            ELSE
                po_cod_err := 'PVT-2913';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: No tiene permiso para realizar la venta devuelta luego de 3 dias de la fecha de activacion
                RAISE err_app;
            END IF;
        END IF;

        po_cod_err := 'PVT-2914';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al invocar al procedimiento TX_PVT_POLITICAS.SET_DEUDA_PENDIENTE.
        tx_pvt_politicas.set_deuda_pendiente
        (
            pi_cod_transaccion          => v_cod_transaccion,
            pi_id_comunidad             => v_reg_entidad_consumo.id_comunidad_facturante,
            pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
            pi_cod_servicio             => pi_cod_servicio,
            pi_cod_motivo               => pi_cod_motivo,
            pi_cod_segmento_destino     => NULL,
            pi_cod_plan_destino         => NULL,
            po_cod_err                  => po_cod_err,
            po_msj_err                  => po_msj_err
        );
        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2915';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al inicializar penalidades
        FOR c_deuda IN (SELECT t.tipo_registro
                            ,t.id_registro
                            ,t.cod_tipo_documento
                            ,c.id_cargo
                            ,t.valor_simp
                            ,t.valor_cimp
                            ,t.facturacion
                            ,t.po_cod_err
                            ,t.po_msj_err
                        FROM vta_deuda_pendiente t
                            LEFT JOIN cnf_cta_tipo_documento_cargo c
                            ON t.cod_tipo_documento = c.cod_tipo_documento
                            AND c.estado = c_estado_activo
                        WHERE t.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                        AND t.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                        )
        LOOP
            -- en caso de cobrar una desconexion, se deben anular todos subsidios activos
            IF c_deuda.tipo_registro = 'PENALIDAD' THEN
                v_subsidios(c_deuda.id_registro)    := t_subsidio(c_deuda.valor_simp,NULL,NULL);
            END IF;

            IF c_deuda.facturacion IN ('PROXIMO_CICLO','INFORMATIVO')
            AND c_deuda.tipo_registro NOT IN ('CARGOS','TRAFICO','DEUDA_CUENTA_CORRIENTE','DEUDA_VIGENTE','CARGO_MORA')
            AND ROUND(c_deuda.valor_cimp,2) > 0
            THEN
                po_cod_err := 'PVT-2916';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al invocar al procedimiento TX_PVT_CCS.ASIGNAR_CARGO.
                tx_pvt_ccs.asignar_cargo(
                    pi_id_cliente                  => v_id_cliente,
                    pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                    pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_cod_local                   => NULL,
                    pi_cod_tipo_documento          => NULL,
                    pi_id_cargo                    => c_deuda.id_cargo, -- v_id_cargo,
                    pi_monto                       => ROUND (c_deuda.valor_simp, 2),   -- Los impuestos son calculados en la facturacion.
                    pi_es_diferido                 => c_verdadero,
                    pi_cod_usuario                 => pi_cod_usuario,
                    pi_master                      => c_falso,
                    pi_id_tran                     => v_id_tran,
                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                    pi_fch_tran                    => v_fch_tran,
                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                    po_id_documento                => v_id_documento_cargo,
                    po_id_tran                     => v_id_tran_cargo,
                    po_cod_gestion_tran            => v_cod_gestion_tran_cargo,
                    po_cod_err                     => po_cod_err,
                    po_msj_err                     => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            ELSIF c_deuda.facturacion NOT IN ('PROXIMO_CICLO','INFORMATIVO') THEN
                v_penalidad                             := NULL;
                v_penalidad.cod_tipo_documento          := c_deuda.cod_tipo_documento;
                v_penalidad.id_cargo                    := c_deuda.id_cargo;
                v_penalidad.valor_simp                  := ROUND(c_deuda.valor_simp,2);
                v_penalidad.valor_cimp                  := ROUND(c_deuda.valor_cimp,2);
                v_docs_penalidad (c_deuda.id_registro)  := v_penalidad;
            END IF;
        END LOOP;

        IF pi_id_prospecto_com IS NOT NULL THEN
            v_monto_deposito    := 0;
            BEGIN
                SELECT SUM(NVL(t.valor_cimp,0))*(-1),NVL(t.po_cod_err,'OK')
                INTO v_monto_deposito,po_cod_err
                FROM vta_deuda_pendiente t
                WHERE t.facturacion = 'CAJA'
                AND t.tipo_registro = 'DEPOSITO_INICIAL'
                AND t.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                GROUP BY t.id_comunidad,t.po_cod_err;
            EXCEPTION
                WHEN OTHERS THEN
                    v_monto_deposito    := 0;
                    po_cod_err          := 'OK';
            END;

            IF po_cod_err <> 'OK' THEN
                po_cod_err := 'PVT-2917';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error durante el calculo del deposito.
                RAISE err_app;
            END IF;

            IF v_monto_deposito > 0 THEN

                po_cod_err := 'PVT-5252';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: error al determinar la deuda de la cuenta.
                v_id_cuenta_corriente   :=  get_id_cc(v_reg_entidad_consumo.id_comunidad_facturante);
                v_deuda_cuenta          :=  tx_cta_cuenta_corriente.get_deuda_total (v_id_cuenta_corriente);
                v_monto_deposito        :=  ROUND (v_monto_deposito -  v_deuda_cuenta,2);
            END IF;

        ELSE
            v_monto_deposito    := 0;
        END IF;

        po_cod_err := 'PVT-2918';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al registrar la entidad de venta relacionada.
        cc_vta_venta_entidad.alta (pio_id_prospecto               => v_id_prospecto,
                                   pi_cod_tipo_venta              => 'TV_CORTE_ENTIDAD_CONSUMO',
                                   pi_id_entidad_venta            => pi_id_entidad_venta,
                                   pi_cod_usuario_asignado        => pi_cod_usuario_asignado,
                                   pi_cod_usuario_digitador       => pi_cod_usuario,
                                   pi_fch_venta                   => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_id_venta_entidad            => v_id_venta_entidad,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        IF pi_id_prospecto_com IS NULL THEN
            v_id_prospecto_main    := v_id_prospecto;
            v_id_venta_main        := NULL;   -- se creara uno nuevo al llamar a tx_pvt_ccs.alta_venta_detalle
        ELSE
            v_id_prospecto_main    := pi_id_prospecto_com;
            v_id_venta_main        := pi_id_venta_com;
        END IF;

        -- registrar la afectacion de subsidios
        v_subs                         := v_subsidios.FIRST;

        WHILE v_subs IS NOT NULL
        LOOP
            po_cod_err := 'PVT-2919';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al registrar el detalle de subsidios
            tx_subsidio.registrar_pago_subsidio
                                (pi_id_prospecto                => v_id_prospecto_main,
                                 pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_id_subsidio                 => v_subs,
                                 pi_monto                       => v_subsidios (v_subs) (1),   -- penalidad
                                 pi_nuevo_subsidio              => v_subsidios (v_subs) (2),
                                 pi_nueva_vigencia              => v_subsidios (v_subs) (3),
                                 pi_id_prospecto_cp             => v_id_prospecto,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            v_subs        := v_subsidios.NEXT (v_subs);
        END LOOP;

        v_precio_venta_con_imp         := 0;
        v_doc                          := v_docs_penalidad.FIRST;

        WHILE v_doc IS NOT NULL
        LOOP
            v_precio_penalidad    := v_docs_penalidad (v_doc).valor_simp;
            v_monto_descuento       := 0;
            v_monto_descuento_imp   := 0;

            IF v_monto_deposito > 0 THEN
                BEGIN
                    BEGIN
                        SELECT (1+(NVL(SUM(i.valor_porcentual),0)/100))
                        INTO v_impuestos
                        FROM bl_cargo_impuesto ci
                            ,bl_impuesto i
                        WHERE ci.id_cargo_impuesto = v_docs_penalidad (v_doc).id_cargo
                        AND i.cod_impuesto = ci.cod_impuesto
                        AND ci.estado = 'A';
                    EXCEPTION
                        WHEN OTHERS THEN
                            v_impuestos := 1.18;
                    END;


                    SELECT NVL(SUM(deposito_simp),0)*v_impuestos
                        INTO v_monto_descuento
                    FROM vta_prospecto_deposito
                    WHERE id_prospecto = v_id_prospecto_main;

                    v_monto_deposito_tmp    := v_monto_deposito - v_monto_descuento;
                    IF v_monto_deposito_tmp < 0.99 THEN
                        v_monto_descuento       := 0;
                        v_monto_descuento_imp   := 0;
                    ELSE
                        IF v_monto_deposito_tmp >= v_docs_penalidad (v_doc).valor_cimp THEN
                            v_monto_descuento       := v_precio_penalidad;
                            v_monto_descuento_imp   := v_precio_penalidad*v_impuestos;
                        ELSE
                            v_monto_descuento       := v_monto_deposito_tmp/v_impuestos;
                            v_monto_descuento_imp   := v_monto_deposito_tmp;
                        END IF;
                    END IF;
                EXCEPTION
                    WHEN OTHERS THEN
                        v_monto_descuento       := 0;
                        v_monto_descuento_imp   := 0;
                END;
            END IF;


            IF v_precio_penalidad > 0 OR v_docs_penalidad(v_doc).cod_tipo_documento = 'PENDES' THEN
                po_cod_err := 'PVT-2920';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al registrar el detalle de la venta.
                tx_pvt_ccs.alta_venta_detalle (pio_id_venta                   => v_id_venta_main,
                                               pi_id_prospecto                => v_id_prospecto_main,
                                               pi_id_cargo                    => v_docs_penalidad(v_doc).id_cargo,
                                               pi_cod_tipo_documento          => v_docs_penalidad(v_doc).cod_tipo_documento,
                                               pi_valor_venta                 => v_precio_penalidad,
                                               pi_valor_descuento             => 0,--v_monto_descuento,
                                               pi_id_prospecto_ec             => v_id_prospecto,
                                               pi_cod_tipo                    => 'C',
                                               pi_estado                      => c_estado_activo,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_master                      => c_falso,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               po_valor                       => v_precio_penalidad_imp,
                                               po_id_prospecto_detalle        => v_id_prospecto_detalle,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                IF po_cod_err != 'OK' THEN
                    RAISE err_app;
                END IF;

                 IF v_monto_descuento > 0 THEN
                        po_cod_err := 'PVT-2921';   --TX_PVT_ENTIDAD.SUSPENSION_ENTIDAD: Error al registrar el descuento por deposito.
                        tx_vta_prospecto_deposito.alta(
                            pi_id_prospecto             => v_id_prospecto_main,
                            pi_id_prospecto_detalle     => v_id_prospecto_detalle,
                            pi_valor_simp               => v_precio_penalidad,
                            pi_deposito_simp            => v_monto_descuento,
                            pi_valor_cimp               => v_precio_penalidad_imp,
                            pi_deposito_cimp            => v_monto_descuento_imp,
                            pi_cod_usuario              => pi_cod_usuario,
                            pi_master                   => c_falso,
                            pi_id_tran                  => v_id_tran,
                            pi_fch_tran                 => v_fch_tran,
                            pi_cod_gestion_tran         => v_cod_gestion_tran,
                            pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                            po_id_registro              => v_id_registro_dpt,
                            po_id_tran                  => po_id_tran,
                            po_fch_tran                 => po_fch_tran,
                            po_cod_err                  => po_cod_err,
                            po_msj_err                  => po_msj_err
                        );

                        IF po_cod_err != 'OK' THEN
                            RAISE err_app;
                        END IF;
                    END IF;

                v_precio_venta_con_imp    := v_precio_venta_con_imp + v_precio_penalidad_imp - v_monto_descuento_imp;
            END IF;
            v_doc                 := v_docs_penalidad.NEXT (v_doc);
        END LOOP;

        IF v_precio_venta_con_imp = 0 THEN
            po_cod_err := 'PVT-2922';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al invocar el procedimiento TX_PVT_CCS.ALTA_VENTA_DETALLE.
            tx_pvt_ccs.alta_venta_detalle (
                pio_id_venta                   => v_id_venta_main,
                pi_id_prospecto                => v_id_prospecto_main,
                pi_id_cargo                    => 0,
                pi_cod_tipo_documento          => 'PENDES',
                pi_valor_venta                 => 0,
                pi_id_prospecto_ec             => v_id_prospecto,
                pi_cod_tipo                    => 'E',
                pi_estado                      => c_estado_activo,
                pi_cod_usuario                 => pi_cod_usuario,
                pi_master                      => c_falso,
                pi_id_tran                     => v_id_tran,
                pi_cod_gestion_tran            => v_cod_gestion_tran,
                pi_fch_tran                    => v_fch_tran,
                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                po_valor                       => v_precio_penalidad_imp,
                po_id_prospecto_detalle        => v_id_prospecto_detalle,
                po_cod_err                     => po_cod_err,
                po_msj_err                     => po_msj_err
                );
            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- RQX-4094: pago suspension temporal
        IF pi_cod_servicio = 'SSTMP' THEN
            SELECT CASE
                       WHEN (  MONTHS_BETWEEN (pi_fch_efectiva_fin, pi_fch_efectiva_inicio)
                             - TRUNC (MONTHS_BETWEEN (pi_fch_efectiva_fin, pi_fch_efectiva_inicio))
                            ) > 0 THEN   TRUNC (MONTHS_BETWEEN (pi_fch_efectiva_fin,
                                                                pi_fch_efectiva_inicio))
                                       + 1
                       ELSE TRUNC (MONTHS_BETWEEN (pi_fch_efectiva_fin, pi_fch_efectiva_inicio))
                   END cant_meses
              INTO v_cant_meses_suspension
              FROM DUAL;

            v_costo_stmp    := TO_NUMBER (c_costo_mes_suspension_tmp) * v_cant_meses_suspension;

            --RQX 8263...... Suspensión a BroadBand por CoronaVirus
            IF pi_cod_servicio = 'SSTMP' AND v_cod_linea_negocio IN ('INTER','T1VOZ') THEN
                v_costo_stmp:=0;

                BEGIN

                SELECT cp.nombre ||' '|| cp.apellido_paterno
                INTO v_nombre_empresa
                FROM cl_entidad_consumo   cec, cl_persona           cp
                WHERE cec.id_persona = cp.id_persona
                AND cec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo;

                SELECT parametro_1, descipcion
                INTO v_to_mail, v_body
                FROM cnf_configuracion_especial
                WHERE nombre_tabla = 'TX_PVT_ENTIDAD_CONSUMO'
                AND cod_registro = 'SUSPENSION_TEMPORAL';
                EXCEPTION
                    WHEN OTHERS THEN
                    v_nombre_empresa := '';
                    v_to_mail        :='COIT@viva.com.do';
                    v_body           :='<html>Error de configuración</html>';
                END;

                v_body:=replace(v_body,'#NCUENTA', TO_CHAR(v_reg_entidad_consumo.id_comunidad_facturante));
                v_body:=replace(v_body,'#NOMBREEMPRESA',v_nombre_empresa);
                v_body:=replace(v_body,'#NUMEROPCS',v_reg_entidad_consumo.identificador_entidad);
                v_body:=replace(v_body,'#INICIOSUSPENSION',TO_CHAR(pi_fch_efectiva_inicio,'DD-MM-YYYY'));
                v_body:=replace(v_body,'#FINSUSPENSION',TO_CHAR(pi_fch_efectiva_fin, 'DD-MM-YYYY'));

                -- Envia mail
                tx_mail_mensaje.alta (pi_id_origen                   => NULL,
                                      pi_id_documento                => NULL,
                                      pi_to                          => v_to_mail,
                                      pi_subject                     => 'Suspension Temporal',
                                      pi_body                        => v_body,
                                      pi_attach_file                 => NULL,
                                      pi_fecha_programado            => v_fch_tran,
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_master                      => c_falso,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_tran,
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      po_id_mail                     => v_dummy,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

                IF po_cod_err != 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;

            IF v_cod_linea_negocio IN ('POSCOR', 'FIJCOR') THEN   -- pago diferido --pi_es_pago_diferido = 1
                SELECT p.cod_periodo
                  INTO v_cod_periodo_facturacion
                  FROM tr_periodo_facturacion p, cl_comunidad c
                 WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                   AND c.cod_ciclo_facturacion = p.cod_ciclo_facturacion
                   AND p.vigente = c_verdadero
                   AND p.estado <> c_estado_inactivo;

                po_cod_err := 'PVT-2923';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al invocar al proc. de registro del cargo del cargo.
                cc_bl_cargo_adicional.alta
                       (pi_cod_periodo_inicio          => v_cod_periodo_facturacion,
                        pi_cod_periodo_fin             => v_cod_periodo_facturacion,
                        pi_id_cliente                  => v_id_cliente,
                        pi_id_comunidad_facturante     => v_reg_entidad_consumo.id_comunidad_facturante,
                        pi_id_entidad_consumo          => pi_id_entidad_consumo,
                        pi_id_cargo                    => c_id_cargo_suspension_tmp,
                        pi_valor                       => v_costo_stmp,
                        pi_cod_usuario                 => pi_cod_usuario,
                        pi_id_tran                     => v_id_tran,
                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                        pi_fch_tran                    => v_fch_tran,
                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                        po_id_registro                 => v_id_registro_cargo_adic_stmp,
                        po_cod_err                     => po_cod_err,
                        po_msj_err                     => po_msj_err
                       );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;

                v_costo_stmp    := 0;
            END IF;

            po_cod_err := 'PVT-2924';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al registrar el detalle de la venta.
            tx_pvt_ccs.alta_venta_detalle (pio_id_venta                   => v_id_venta_main,
                                           pi_id_prospecto                => v_id_prospecto_main,
                                           pi_id_cargo                    => 0,
                                           pi_cod_tipo_documento          => v_cod_tipo_documento_sstmp,
                                           pi_valor_venta                 => v_costo_stmp,
                                           pi_id_prospecto_ec             => v_id_prospecto,
                                           pi_cod_tipo                    => 'E',
                                           pi_estado                      => c_estado_activo,
                                           pi_cod_usuario                 => pi_cod_usuario,
                                           pi_master                      => c_falso,
                                           pi_id_tran                     => v_id_tran,
                                           pi_cod_gestion_tran            => v_cod_gestion_tran,
                                           pi_fch_tran                    => v_fch_tran,
                                           pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                           po_valor                       => v_valor_sstmp,
                                           po_id_prospecto_detalle        => v_id_prospecto_detalle,
                                           po_cod_err                     => po_cod_err,
                                           po_msj_err                     => po_msj_err
                                          );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- RQX-4094: fin
        IF pi_id_prospecto_com IS NULL THEN
            --CREACION DEL PROSPECTO DE VENTA DEL ARTICULO ---------------------------------------------------
            BEGIN
                po_cod_err := 'PVT-2925';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al recuperar el RNC y nombre a facturar.

                SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                       p.nit
                  INTO v_nombre_factura,
                       v_rnc_factura
                  FROM cl_persona p, cl_datos_facturacion df
                 WHERE df.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                   AND df.id_persona = p.id_persona
                   AND df.estado <> c_estado_inactivo
                   AND df.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    NULL;
            END;

            po_cod_err := 'PVT-2926';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al invocar al procedimiento TX_BL_DOSIFICACION.GET_COD_CATEGORIA_DOCUMENTO.
            tx_bl_dosificacion.get_cod_categoria_documento
                                  (pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   po_cod_categoria_documento     => v_cod_categoria_documento,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err);

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-2927';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al invocar al procedimiento de registro del prospecto de venta.
            tx_pvt_ccs.alta_venta (pi_id_prospecto                => v_id_prospecto,
                                   pi_nombre_factura              => v_nombre_factura,
                                   pi_nit                         => v_rnc_factura,
                                   pi_cod_categoria_documento     => v_cod_categoria_documento,
                                   pi_estado                      => c_estado_activo,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_master                      => c_falso,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_valor                       => v_precio_venta_con_imp,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        po_cod_err := 'PVT-2928';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: El tipo de corte no es aplicable al suscriptor seleccionado.
        cc_vta_corte_entidad_consumo.alta
                    (pi_id_prospecto_com            => pi_id_prospecto_com,
                     pi_id_cliente                  => get_id_cl
                                                           (v_reg_entidad_consumo.id_comunidad_facturante),
                     pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                     pi_id_entidad_consumo          => pi_id_entidad_consumo,
                     pi_cod_servicio                => pi_cod_servicio,
                     pi_cod_motivo                  => pi_cod_motivo,
                     pi_cod_submotivo               => pi_cod_submotivo,
                     pi_estado_actual               => v_reg_entidad_consumo.estado,
                     pi_estado_final                => NULL,
                     pi_precio_venta                => v_precio_venta_con_imp,
                     pi_es_pago_diferido            => pi_es_pago_diferido,
                     pi_id_entidad_venta            => pi_id_entidad_venta,
                     pi_cod_usuario_asignado        => pi_cod_usuario_asignado,
                     pi_fch_efectiva_inicio         => v_fch_tran,   -- NVL(pi_fch_efectiva_inicio,v_fch_tran),
                     pi_fch_efectiva_fin            => NVL (pi_fch_efectiva_fin, c_fecha_fin),
                     pi_cod_usuario                 => pi_cod_usuario,
                     pi_id_tran                     => v_id_tran,
                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                     pi_fch_tran                    => v_fch_tran,
                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                     pio_id_prospecto               => v_id_prospecto,
                     po_cod_err                     => po_cod_err,
                     po_msj_err                     => po_msj_err
                    );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;


        -- RQX 4941 - Validando linea de negocios para terminar vivas luego de la terminacion
       /* tx_vda_util.expirar_todas_vidas(pi_id_entidad_consumo,
                                        'TERMINACION DE LA UNIDAD',
                                        v_fch_tran,
                                        v_id_tran,
                                        v_cod_gestion_tran,
                                        pi_cod_usuario,
                                        pi_cod_unidad_negocio,
                                        c_falso,
                                        po_cod_err,
                                        po_msj_err
                                        );
        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;*/


        -- Si se recibe el IMEI en la TX de corte/suspension por robo, registrar el valor hasta la consolidacion del prospecto.
        IF pi_imei IS NOT NULL THEN
            po_cod_err := 'PVT-2929';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al registrar el IMEI para el prospecto.
            tx_eir_corte_entidad_consumo.alta (pi_id_prospecto                => v_id_prospecto,
                                               pi_imei                        => pi_imei,
                                               pi_id_tran                     => v_id_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               pi_master                      => c_falso,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        SELECT COUNT(1)
            INTO v_desconexion_intencional
            FROM vta_corte_entidad_consumo
            WHERE id_entidad_consumo = pi_id_entidad_consumo
            AND cod_servicio = 'SDPO'
            AND estado = c_estado_activo;

        IF pi_id_prospecto_com IS NULL
           AND (v_precio_venta_con_imp = 0 OR NVL (pi_es_pago_diferido, c_falso) = c_verdadero)
           AND tx_cl_contrato_activacion.documentos_requeridos (v_id_prospecto) = 0
           AND v_desconexion_intencional <= 0 THEN
           -- validar si es desconexion por terminación intencional
            po_cod_err := 'PVT-2930';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN: Error al invocar al proc. de consolidacion de venta de equipo con monto 0.
            tx_int_cliente_caja.consolidar_venta_prospecto
                                                   (pi_id_venta                    => v_id_venta_main,
                                                    pi_ncf                         => NULL,
                                                    pi_nro_pag_ext                 => NULL,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_master                      => c_falso,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    po_id_tran                     => po_id_tran,
                                                    po_cod_gestion_tran            => po_cod_gestion_tran,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        IF v_existe_excepcion THEN
            po_cod_err := 'PVT-2931';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Error al dar de baja la excepcion de venta devuelta.
            cc_vta_excepcion.baja
                                (pi_cod_tipo_excepcion          => c_tipo_excepcion_vta_devuelta,
                                 pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                 pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_nro_documento               => NULL,
                                 pi_cod_tipo_doc                => NULL,
                                 pi_monto_deposito              => NULL,
                                 pi_id_prospecto                => v_id_prospecto,
                                 pi_cod_articulo                => NULL,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --Ticket 110535 - BugFix proceso de Terminación de cuentas solo por el RTB usuarios nivel 1 --111755
        IF pi_cod_usuario NOT IN ('OMEGA','ADMOMEGA') AND tiene_permiso('ESP_RET_NIVEL_PERMISO_1',c_verdadero,pi_cod_usuario) = c_verdadero
          AND tx_ret_prospecto.cliente_tiene_prospecto(pi_id_entidad_consumo,'NSAT') = c_falso
            AND tx_ret_prospecto.cliente_aplica_sintoma_rtb(pi_id_entidad_consumo) = c_verdadero
                --Ticket 112110 - Motivo desconexion por terminacion, en suspender-desconectar para modulo RTB
                AND pi_cod_servicio = 'SDPO' THEN
                    po_cod_err := 'PVT-2932';   --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO: Esta opción está disponible solo a través del módulo RTB, favor crear prospecto de retención para completar la acción.
            RAISE err_app;
        END IF;
        --Fin Ticket 110535 - BugFix proceso de Terminación de cuentas solo por el RTB usuarios nivel 1
        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                     := 'OK';
        po_msj_err                     := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE reconexion_entidad_consumo (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_servicio           IN       bm_servicio.cod_servicio%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                            := tx_cnf_constante.get_constante ('TRANSACCION_RECONEXION_SUSCRIPTOR');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.RECONEXION_ENTIDAD_CONSUMO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_operacion                   VARCHAR2 (10);
        v_estado_ini                  bm_servicio_suspension.estado_asociado%TYPE;
        v_customer_group_ini          bm_servicio_suspension.grupo_cliente%TYPE;
        v_susp_salientes_ini          bm_servicio_suspension.susp_salientes%TYPE;
        v_susp_entrantes_ini          bm_servicio_suspension.susp_entrantes%TYPE;
        v_estado_fin                  bm_servicio_suspension.estado_asociado%TYPE;
        v_customer_group_fin          bm_servicio_suspension.grupo_cliente%TYPE;
        v_susp_salientes_fin          bm_servicio_suspension.susp_salientes%TYPE;
        v_susp_entrantes_fin          bm_servicio_suspension.susp_entrantes%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_dummy                       PLS_INTEGER;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        descripcion_nuevo_estado      cnf_estado_entidad.descripcion%TYPE;
        descripcion_estado_actual     cnf_estado_entidad.descripcion%TYPE;
        v_id_tran_inicio              tx_historico_transaccion.id_tran%TYPE;
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_parametro_2                 cnf_configuracion_especial.parametro_2%TYPE;
        v_count                       PLS_INTEGER;
        v_fch_efectiva_inicio         cl_servicio_entidad_consumo.fch_efectiva_inicio%TYPE;
        v_fch_efectiva_fin            cl_servicio_entidad_consumo.fch_efectiva_fin%TYPE;
        v_dias_diferencia             NUMBER;
        v_balance_info                tx_ecms.ecms_balance_instances;
        v_date_exp_core_balance       DATE;
        v_date_exp_promo_balance_1    DATE;
        v_date_exp_free_sec_balance   DATE;
        v_id_accion                   NUMBER;
        v_permiso                     VARCHAR2(10);
        v_sql                         VARCHAR2(4000);
        v_acct_expire_date            DATE;
        v_available_balance1          NUMBER(38,6);
        v_date_exp_promo_balance_4    DATE;
        v_command_id                  vpg_cnf_comando_enlace.id_comando%TYPE;
        po_fch_tran                   DATE;
        v_po_id_orden                 vpg_orden.id_orden%TYPE;
        v_po_id_tran                  tx_historico_transaccion.id_tran%TYPE;
        v_po_fch_tran                 DATE;
        v_bolsillos_cs                tx_ecms.type_ecms_bolsilos;
        v_cod_grupo_plan              bm_grupo_plan.cod_grupo_plan%TYPE;
        v_existe_serv                 NUMBER;
        -- Excepciones
        err_app                       EXCEPTION;
        v_sus_esp_hibpre              NUMBER;
        v_plan_contador               VARCHAR2(12);
        v_offer_id                    VARCHAR2(12);
        v_da_id                       VARCHAR2(12);
        v_minutos_amt                 NUMBER;
        v_reg_periodo                  tr_periodo_facturacion%ROWTYPE;
        v_ers_so                      ers_subscriber.service_offerings%TYPE;
        v_so_eliminar                 VARCHAR2(5);
        v_status                      cl_comunidad.estado%TYPE;
        v_cod_motivo                  cnf_motivo_transaccion.cod_motivo%type;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                 :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_servicio:'
            || pi_cod_servicio
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_servicio IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2933';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2934';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2935';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                 := v_id_tran;
        po_cod_gestion_tran        := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        --EL SUSCRIPTOR NO DEBE ESTAR TERMINADO
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF pi_cod_servicio IN ('SS04','SD07') THEN
            po_cod_err := 'PVT-2936';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al consultar el permiso para la reconexion por FRAUDE.
            tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                       pi_cod_entidad                 => 'ESP_RECONEXION_X_FRAUDE',
                                       pi_cod_usuario_tran            => pi_cod_usuario,
                                       po_permiso                     => v_permiso,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            IF v_permiso = c_falso THEN
                po_cod_err := 'PVT-2937';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: El usuario no tiene permiso para reconectar lineas desconectadas por FRAUDE.
                RAISE err_app;
            END IF;
        END IF;

        --DETERMINAR LA LINEA DE NEGOCIO DE LA CUENTA
        po_cod_err := 'PVT-2938';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al determinar la linea de negocio de la cuenta.

        SELECT cod_linea_negocio
          INTO v_cod_linea_negocio
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

         SELECT cod_grupo_plan
                INTO v_cod_grupo_plan
         FROM bm_plan
            WHERE  cod_plan = v_reg_entidad_consumo.cod_plan AND estado ='A';


        SELECT COUNT(1)
            INTO v_sus_esp_hibpre
        FROM cl_servicio_suspendido
        WHERE ID_ENTIDAD_CONSUMO = v_reg_entidad_consumo.id_entidad_consumo
        AND cod_Servicio = 'SHIBESP'
        AND estado = 'P'
        AND FCH_FIN > SYSDATE;


        BEGIN
            --VERIFICAR QUE EL SERVICIO DE CORTE ESTE ASIGNADO AL SUSCRIPTOR
            po_cod_err := 'PVT-2939';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al verificar si el suscriptor tiene asignado la suspension o desconexion.

            SELECT sec.id_tran_inicio,
                   sec.fch_efectiva_inicio,
                   sec.fch_efectiva_fin
              INTO v_id_tran_inicio,
                   v_fch_efectiva_inicio,
                   v_fch_efectiva_fin
              FROM cl_servicio_entidad_consumo sec
             WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
               AND sec.estado <> c_estado_inactivo
               AND sec.fch_fin = c_fecha_fin
               AND sec.cod_servicio = pi_cod_servicio;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                po_cod_err := 'PVT-2940';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: El suscriptor no tiene asignado la suspension o desconexion.
                RAISE err_app;
        END;

        get_estado_entidad_consumo (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                    po_estado                      => v_estado_ini,
                                    po_customer_group              => v_customer_group_ini,
                                    po_salientes                   => v_susp_salientes_ini,
                                    po_entrantes                   => v_susp_entrantes_ini,
                                    po_cod_err                     => po_cod_err,
                                    po_msj_err                     => po_msj_err
                                   );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-2941';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al invocar al proc. de desasignacion de la suspension.
        cc_cl_servicio_entidad_consumo.desasignar (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                   pi_cod_servicio                => pi_cod_servicio,
                                                   pi_cod_usuario                 => pi_cod_usuario,
                                                   pi_id_tran                     => v_id_tran,
                                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                   pi_fch_tran                    => v_fch_tran,
                                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                   pi_fch_efectiva                => v_fch_tran,
                                                   po_cod_err                     => po_cod_err,
                                                   po_msj_err                     => po_msj_err
                                                  );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        get_estado_entidad_consumo (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                    po_estado                      => v_estado_fin,
                                    po_customer_group              => v_customer_group_fin,
                                    po_salientes                   => v_susp_salientes_fin,
                                    po_entrantes                   => v_susp_entrantes_fin,
                                    po_cod_err                     => po_cod_err,
                                    po_msj_err                     => po_msj_err
                                   );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --EN CASO DE RECONEXION REASIGNAR EL SERVICIO DE ROAMING INTERNACIONAL SI LO TENIA ANTES DEL CORTE
        IF v_estado_ini <> c_estado_activo AND v_estado_fin = c_estado_activo THEN
            --para que sea correcta la determinacion de que el suscriptor tenia el servicio antes del corte
            --seria necesario revisar que transaccion desasigno el corte, puesto que la transaccion que se
            --esta considerando en el sgte query no es necesariamente la que realizo el corte
            FOR curservasig IN
                (SELECT ss.id_registro,
                        s.cod_servicio,
                        s.cod_tipo_servicio,
                        ROW_NUMBER () OVER (PARTITION BY ss.cod_servicio ORDER BY ss.fch_inicio DESC)
                                                                                                 rn
                   FROM cl_servicio_suspendido ss INNER JOIN bm_servicio s
                        ON s.cod_servicio = ss.cod_servicio
                  WHERE ss.id_entidad_consumo = pi_id_entidad_consumo
                    AND ss.estado = 'P'
                    AND ss.fch_fin = c_fecha_fin)
            LOOP
                IF     (   curservasig.cod_tipo_servicio = c_tipo_serv_datos
                        OR curservasig.cod_servicio = 'DATA2'
                       )
                   AND v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
                    IF NVL
                           (tx_pvt_entidad_consumo.get_procedencia_articulo
                                                                        (pi_id_entidad_consumo,
                                                                         v_reg_entidad_consumo.imsi),
                            'NULL') IN ('TPDLR', 'TPCLI') THEN
                        NULL;
                    END IF;
                -- en caso de tener servicios duplicados en cl_servicio_suspendido no hacemos nada, solo dar de baja el registro
                ELSIF curservasig.rn > 1 THEN
                    NULL;
                ELSE
                    v_dummy       := 0;
                    -- verificar que el servicio es valido en el plan actual
                    -- y que no esta actualmente asignado al subscriptor
                    po_cod_err := 'PVT-2942';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al invocar verificar si se puede asignar el servicio

                    SELECT COUNT (*)
                      INTO v_count
                      FROM bm_plan_servicio ps
                     WHERE ps.cod_plan = v_reg_entidad_consumo.cod_plan
                       AND ps.cod_servicio = curservasig.cod_servicio
                       AND ps.estado = c_estado_activo
                       AND ps.fch_fin = c_fecha_fin
                       AND NOT EXISTS (SELECT 1
                                         FROM cl_servicio_entidad_consumo cs
                                        WHERE cs.id_entidad_consumo =
                                                            v_reg_entidad_consumo.id_entidad_consumo
                                          AND cs.cod_servicio = ps.cod_servicio
                                          -- Bug Manolo :)
                                          --AND cs.estado = c_estado_inactivo
                                          AND cs.estado = c_estado_activo
                                          AND cs.fch_fin = c_fecha_fin);

                    IF v_count = 0 THEN
                        v_dummy    := 1;
                    END IF;

                    -- PHC verificar si es del tipo BBDAT
                    IF curservasig.cod_tipo_servicio = 'BBDAT' THEN
                        SELECT parametro_2
                          INTO v_parametro_2
                          FROM cnf_configuracion_especial
                         WHERE cod_registro = curservasig.cod_servicio;

                        -- Si el cod_servicio tiene recarga (es prepago)
                        IF v_parametro_2 = '1' THEN
                            v_count    := 0;

                            --Buscamos si tiene una recarga vigente para volver a asignar el servicio
                            SELECT COUNT (1)
                              INTO v_count
                              FROM cl_recarga_bb
                             WHERE estado = 'A'
                               AND SYSDATE BETWEEN fch_efectiva_inicio AND fch_efectiva_fin
                               AND id_entidad_consumo = pi_id_entidad_consumo;

                            IF v_count = 0 THEN
                                v_dummy    := 1;
                            ELSE   --tiene una recarga vigente, volvemos a abrirla
                                UPDATE cl_recarga_bb
                                   SET fch_fin = c_fecha_fin,
                                       id_tran_fin = NULL,
                                       cod_gestion_tran_fin = NULL,
                                       cod_usuario_fin = NULL
                                 WHERE estado = 'A'
                                   AND SYSDATE BETWEEN fch_efectiva_inicio AND fch_efectiva_fin
                                   AND id_entidad_consumo = pi_id_entidad_consumo;
                            END IF;
                        END IF;   --BBPRE

                        IF v_dummy = 0 THEN
                            po_cod_err := 'PVT-2943';   --TX_BLACKBERRY.suspender_bb: Error al invocar a CC_CL_ENTIDAD_CONSUMO_BB.ALTA
                            cc_cl_entidad_consumo_bb.alta
                                                   (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                    pi_estado_bb                   => 'A',
                                                    pi_estado                      => c_estado_activo,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    pi_master                      => c_falso,
                                                    pi_fue_activado                => c_falso,
                                                    pi_cod_servicio                => curservasig.cod_servicio,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

                            IF po_cod_err <> 'OK' THEN
                                RAISE err_app;
                            END IF;
                        END IF;
                    END IF;   --BBDAT

                    IF v_dummy = 0 THEN

                        IF curservasig.cod_servicio = 'DAT4G' THEN

                            SELECT COUNT(1)
                                INTO v_existe_serv
                            FROM cl_servicio_entidad_consumo s
                            WHERE s.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                             AND s.cod_servicio = 'DAT4G'
                             AND s.fch_fin > SYSDATE;

                            IF v_existe_serv = c_falso THEN

                                tx_pvt_entidad_consumo.asignar_servicio
                                                       (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                        pi_cod_servicio                => curservasig.cod_servicio,
                                                        pi_complemento                 => NULL,
                                                        pi_cod_usuario                 => pi_cod_usuario,
                                                        pi_master                      => c_falso,
                                                        pi_id_tran                     => v_id_tran,
                                                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                        pi_fch_tran                    => v_fch_tran,
                                                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                        po_id_tran                     => v_id_tran,
                                                        po_cod_gestion_tran            => v_cod_gestion_tran,
                                                        po_cod_err                     => po_cod_err,
                                                        po_msj_err                     => po_msj_err
                                                       );

                                IF po_cod_err <> 'OK' THEN
                                    RAISE err_app;
                                END IF;

                            ELSE
                                SELECT tx_vpg_util.get_comando('BLQDAT', v_reg_entidad_consumo.cod_forma_consumo, 'DEL')
                                   INTO v_command_id
                                FROM DUAL;

                                po_cod_err := 'PVT-5178'; --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al enviar orden para bloqueo de llamadas salientes.
                                mt_vpg.alta_orden(
                                        pi_id_comando           => v_command_id,
                                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                        pi_fch_programada       => v_fch_tran,
                                        pi_cod_transaccion      => c_tipo_transaccion,
                                        pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                        pi_p2                   => v_reg_entidad_consumo.imsi,
                                        pi_cod_usuario          => pi_cod_usuario,
                                        pi_master               => '0',
                                        pi_id_tran              => v_id_tran,
                                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                                        pi_fch_tran             => v_fch_tran,
                                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                        po_id_orden             => v_po_id_orden,
                                        po_id_tran              => v_po_id_tran,
                                        po_fch_tran             => v_po_fch_tran,
                                        po_cod_err              => po_cod_err,
                                        po_msj_err              => po_msj_err
                                        );

                                IF po_cod_err <> 'OK' THEN
                                    RAISE err_app;
                                END IF;
                            END IF;



                        ELSE

                            tx_pvt_entidad_consumo.asignar_servicio
                                                       (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                        pi_cod_servicio                => curservasig.cod_servicio,
                                                        pi_complemento                 => NULL,
                                                        pi_cod_usuario                 => pi_cod_usuario,
                                                        pi_master                      => c_falso,
                                                        pi_id_tran                     => v_id_tran,
                                                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                        pi_fch_tran                    => v_fch_tran,
                                                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                        po_id_tran                     => v_id_tran,
                                                        po_cod_gestion_tran            => v_cod_gestion_tran,
                                                        po_cod_err                     => po_cod_err,
                                                        po_msj_err                     => po_msj_err
                                                       );

                            IF po_cod_err <> 'OK' THEN
                                RAISE err_app;
                            END IF;
                        END IF;
                    END IF;   --v_dummy
                END IF;

                -- en todo caso es necesario finalizar el registro en cl_servicio_suspendido
                po_cod_err := 'PVT-2944';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al dar de baja el servicio suspendido.
                cc_cl_servicio_suspendido.baja (pi_id_registro                 => curservasig.id_registro,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END LOOP;
        END IF;

        --SI EL ESTADO FINAL ES DIFERENTE AL ACTUAL, ACTUALIZAR EL ESTADO DEL SUSCRIPTOR
        IF v_estado_fin <> v_estado_ini THEN
            --- CAMBIO DE ESTADO DEL SUSCRIPTOR
            po_cod_err := 'PVT-2945';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al invocar al proc. para establecer el nuevo estado del sucriptor.
            cc_cl_entidad_consumo.cambia_estado
                                    (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                     pi_estado                      => v_estado_fin,
                                     pi_id_proc_ems                 => v_reg_entidad_consumo.id_proc_ems,
                                     pi_id_orig_proc_ems            => v_reg_entidad_consumo.id_orig_proc_ems,
                                     pi_id_form_ems                 => v_reg_entidad_consumo.id_form_ems,
                                     pi_id_orig_form_ems            => v_reg_entidad_consumo.id_orig_form_ems,
                                     pi_cod_usuario                 => pi_cod_usuario,
                                     pi_id_tran                     => v_id_tran,
                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                     pi_fch_tran                    => v_fch_tran,
                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                     pi_fch_efectiva                => v_fch_tran,
                                     po_cod_err                     => po_cod_err,
                                     po_msj_err                     => po_msj_err
                                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --PROVISIONAR LA DESASIGNACION DEL SERVICIO dnd
        v_identificador_entidad    := v_reg_entidad_consumo.identificador_entidad;

        IF pi_cod_servicio IN (c_serv_suspension_robo, c_serv_desconexion_robo) AND v_cod_grupo_plan NOT IN('DATON')
            AND v_cod_linea_negocio NOT IN('INTERM')  THEN

            --Solo tenemos tecnologia GSM


            ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
            SELECT tx_vpg_util.get_comando('BLQHLR', v_reg_entidad_consumo.cod_forma_consumo, 'DEL')
               INTO v_command_id
            FROM DUAL;

            po_cod_err := 'PVT-5073'; --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al enviar orden reconectar al suscriptor.
            mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_tran,
                    pi_cod_transaccion      => c_tipo_transaccion,
                    pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => '0',
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_po_id_orden,
                    po_id_tran              => v_po_id_tran,
                    po_fch_tran             => v_po_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
        END IF;

        IF v_reg_entidad_consumo.cod_tecnologia = 'SAAS' THEN
            po_cod_err := 'PVT-6162'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al tx_vens_generate_events.saas_change_status.
            tx_vens_generate_events.saas_change_status(
                    pi_pcs                  => v_identificador_entidad,
                    pi_internal_id          => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_status               => 'active',
                    pi_cod_plan             => v_reg_entidad_consumo.cod_plan,
                    pi_master               => pi_master,
                    pi_id_tran              => v_id_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
            );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;
        --PROVISIONAR LA RECONEXION EN DISPOSITIVOS
        IF v_cod_linea_negocio NOT IN ('1162', 'T1VOZ', 'INTER', 'VOIP','INTERM') THEN
            IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_gsm THEN
                IF v_susp_salientes_ini > 0 AND v_susp_salientes_fin = 0 THEN
                    v_operacion    := c_tipo_operacion_del;
                ELSIF v_susp_salientes_ini = 0 AND v_susp_salientes_fin > 0 THEN
                    v_operacion    := c_tipo_operacion_add;
                ELSE
                    v_operacion    := NULL;
                END IF;

                IF v_operacion IS NOT NULL THEN
                    po_cod_err := 'PVT-2947';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al determinar la accion del PRV.
                    v_id_accion_prv_ext    :=
                        get_accion_prv (c_susp_salientes, v_reg_entidad_consumo.cod_tecnologia,
                                        v_reg_entidad_consumo.cod_forma_consumo);


                    ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                    SELECT tx_vpg_util.get_comando(c_susp_salientes, v_reg_entidad_consumo.cod_forma_consumo, v_operacion)
                       INTO v_command_id
                    FROM DUAL;

                    po_cod_err := 'PVT-5074'; --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al enviar orden para activar llamadas salientes.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => c_tipo_transaccion,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------

                END IF;

                IF v_susp_entrantes_ini > 0 AND v_susp_entrantes_fin = 0 THEN
                    v_operacion    := c_tipo_operacion_del;
                ELSIF v_susp_entrantes_ini = 0 AND v_susp_entrantes_fin > 0 THEN
                    v_operacion    := c_tipo_operacion_add;
                ELSE
                    v_operacion    := NULL;
                END IF;

                IF v_operacion IS NOT NULL THEN
                    po_cod_err := 'PVT-2949';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al determinar la accion del PRV.
                    ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                    SELECT tx_vpg_util.get_comando(c_susp_entrantes, v_reg_entidad_consumo.cod_forma_consumo, v_operacion)
                       INTO v_command_id
                    FROM DUAL;

                    po_cod_err := 'PVT-5075'; --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al enviar orden para activar llamadas entrantes.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => c_tipo_transaccion,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                END IF;
             --SE QUITA TODA LA PARTE DE CDMA
            END IF;
        END IF;

        IF pi_cod_servicio = 'SSTMP' THEN
            SELECT COUNT (1)
              INTO v_dummy
              FROM bm_plan
             WHERE cod_plan = v_reg_entidad_consumo.cod_plan AND c1_offer_id IS NOT NULL;

            IF v_dummy > 0 THEN
                -- Verificamos si la reconexion es mucho antes de tiempo.
                v_dias_diferencia    := TRUNC (v_fch_efectiva_fin) - TRUNC (v_fch_tran);

                IF v_dias_diferencia > 0 THEN
                    -- Obtener informacion de la plataforma.
                    po_cod_err := 'PVT-2955';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al invocar al procedimiento tx_ecms.getSubscriberBalance
                    tx_ecms.getSubscriberBalance(pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                                 po_balance_info         => v_balance_info,
                                                 po_cod_err              => po_cod_err,
                                                 po_msj_err              => po_msj_err
                                                 );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    -- Fechas de expiracion de los bolsillos.
                    v_date_exp_core_balance       := v_balance_info (tx_ecms.c_bal_core_balance).expirationdate;
                    v_date_exp_promo_balance_1    := v_balance_info (tx_ecms.c_bal_promotional_balance_1).expirationdate;

                    BEGIN
                        v_date_exp_free_sec_balance    := v_balance_info (tx_ecms.c_bal_free_seconds_balance).expirationdate;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            v_date_exp_free_sec_balance    := NULL;
                    END;

                    --Solo tenemos tecnologia GSM
                    v_id_accion    := 286;

                    -- Movemos la fecha de expiracion del bolsillo CORE BALANCE.
                    IF     v_date_exp_core_balance IS NOT NULL
                       AND v_date_exp_core_balance < ADD_MONTHS (SYSDATE, 12) THEN
                        -- Restamos los dias no faltantes de la suspension.
                        v_date_exp_core_balance    := v_date_exp_core_balance - v_dias_diferencia;

                    ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                    SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                       INTO v_command_id
                    FROM DUAL;

                    v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_core_balance);

                    po_cod_err := 'PVT-5076'; --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al cambiar la fecha de core balance en charging system.
                    mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                            pi_p4                   => 0,
                            pi_p5                   => 'OMEGA:' || pi_cod_servicio,
                            pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                            pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                            pi_p8                   => NULL, --balance_start_date
                            pi_p9                   => TO_CHAR (v_date_exp_core_balance, 'YYYY-MM-DD'), --balance_expiry_date
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

                    ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------

                    END IF;

                    -- Movemos la fecha de expiracion del bolsillo PROMOTIONAL BALANCE 1.
                    IF     v_date_exp_promo_balance_1 IS NOT NULL
                       AND v_date_exp_promo_balance_1 < ADD_MONTHS (SYSDATE, 12) THEN
                        -- Restamos los dias no faltantes de la suspension.
                        v_date_exp_promo_balance_1    :=
                                                     v_date_exp_promo_balance_1 - v_dias_diferencia;


                        ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                        SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                           INTO v_command_id
                        FROM DUAL;

                        v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_promotional_balance_1);

                        po_cod_err := 'PVT-5077'; --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al cambiar la fecha de balance promocional en charging system.
                        mt_vpg.alta_orden(
                                pi_id_comando           => v_command_id,
                                pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_fch_programada       => v_fch_tran,
                                pi_cod_transaccion      => v_cod_tran,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                                pi_p4                   => 0,
                                pi_p5                   => 'OMEGA:' || pi_cod_servicio,
                                pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                                pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                                pi_p8                   => NULL, --balance_start_date
                                pi_p9                   => TO_CHAR (v_date_exp_promo_balance_1, 'YYYY-MM-DD'), --balance_expiry_date
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => '0',
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_po_id_orden,
                                po_id_tran              => v_po_id_tran,
                                po_fch_tran             => v_po_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;

                        ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                    END IF;

                    -- Movemos la fecha de expiracion del bolsillo FREE SECONDS.
                    IF     v_date_exp_free_sec_balance IS NOT NULL
                       AND v_date_exp_free_sec_balance < ADD_MONTHS (SYSDATE, 12) THEN
                        -- Restamos los dias no faltantes de la suspension.
                        v_date_exp_free_sec_balance    :=
                                                    v_date_exp_free_sec_balance - v_dias_diferencia;

                        ----------------- INICIO PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------
                        SELECT tx_vpg_util.get_comando('SET_BALANCE', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
                           INTO v_command_id
                        FROM DUAL;

                        v_bolsillos_cs := tx_ecms.get_C1toEcms(tx_sapi.c_bal_free_seconds_balance);

                        po_cod_err := 'PVT-5124'; --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al cambiar la fecha de free seconds en CS.
                        mt_vpg.alta_orden(
                                pi_id_comando           => v_command_id,
                                pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_fch_programada       => v_fch_tran,
                                pi_cod_transaccion      => v_cod_tran,
                                pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                                pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                                pi_p3                   => v_bolsillos_cs.cod_bolsillo_ecms,
                                pi_p4                   => 0,
                                pi_p5                   => 'OMEGA:' || pi_cod_servicio,
                                pi_p6                   => v_bolsillos_cs.cod_unidad_medida,
                                pi_p7                   => 'C', --adjustment_type --> Tipo de Ajuste = C: Credito D: Debito M: Modificar
                                pi_p8                   => NULL, --balance_start_date
                                pi_p9                   => TO_CHAR (v_date_exp_free_sec_balance, 'YYYY-MM-DD'), --balance_expiry_date
                                pi_cod_usuario          => pi_cod_usuario,
                                pi_master               => '0',
                                pi_id_tran              => v_id_tran,
                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                pi_fch_tran             => v_fch_tran,
                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                po_id_orden             => v_po_id_orden,
                                po_id_tran              => v_po_id_tran,
                                po_fch_tran             => v_po_fch_tran,
                                po_cod_err              => po_cod_err,
                                po_msj_err              => po_msj_err
                                );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;

                        ----------------- FIN PROVISIONING CHARGING SYSTEM (ERICSSON) -----------------

                    END IF;
                END IF;
            END IF;

        ELSIF pi_cod_servicio = 'SS13' THEN

            po_cod_err := 'PVT-2959';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al armar la consulta para obtener los datos de suspencion de la entidad de consumo.
            v_sql   := 'SELECT COUNT(1)
                        FROM accout_subscriber_susp
                        WHERE LTRIM(range_map_external_id,''1'') = :1'
                        ;
            po_cod_err := 'PVT-2960';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al ejecutar la consulta para obtener datos de suspension de la entidad de consumo.
            EXECUTE IMMEDIATE v_sql INTO v_dummy USING v_reg_entidad_consumo.identificador_entidad;

            IF v_dummy > 0 THEN
                po_cod_err := 'PVT-2961';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al armar la consulta para obtener datos de la entidad de consumo.
                v_sql   := 'SELECT acct_expire_date,available_balance1
                            FROM accout_subscriber_susp
                            WHERE LTRIM(range_map_external_id,''1'') = :1'
                            ;
                po_cod_err := 'PVT-2962';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al ejecutar la consulta para obtener datos de suspencion de la entidad de consumo.
                EXECUTE IMMEDIATE v_sql INTO v_acct_expire_date, v_available_balance1 USING v_reg_entidad_consumo.identificador_entidad;
                -- La fecha de inicio es la fecha del proceso.
                v_fch_efectiva_inicio   := TO_DATE('20140911','YYYYMMDD');
            ELSE
                po_cod_err := 'PVT-2963';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al armar la consulta para obtener datos historicos de la entidad de consumo.
                v_sql   := 'SELECT supervision_period_expiry_date,account_balance
                            FROM it_ers.ers_subscriber_hist@zunzun_bidw.om.do
                            WHERE internal_id = :1
							AND date_of_picture = TO_DATE('''||TO_CHAR(v_fch_efectiva_inicio,'YYYYMMDD')||''',''YYYYMMDD'')'
                            ;
                po_cod_err := 'PVT-2964';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al obtener los datos historicos de la entidad de consumo.
                EXECUTE IMMEDIATE v_sql INTO v_acct_expire_date, v_available_balance1 USING TO_CHAR(v_reg_entidad_consumo.id_entidad_consumo);
            END IF;

            IF v_reg_entidad_consumo.cod_tecnologia = 'GSM' THEN
                v_id_accion    := 286;
            ELSE
                v_id_accion    := 285;
            END IF;

            IF NVL(v_available_balance1,0) > 0 THEN
                -- Movemos la fecha de expiracion del bolsillo CORE BALANCE.
                po_cod_err := 'PVT-2965';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al definir la nueva fecha de expiracion.
                -- v_date_exp_core_balance     := TRUNC(v_fch_tran) + (TRUNC(v_acct_expire_date) - TO_DATE('20140619','YYYYMMDD'));
                v_date_exp_core_balance     := TRUNC(v_fch_tran) + (TRUNC(v_acct_expire_date) - TRUNC(v_fch_efectiva_inicio));

                po_cod_err := 'PVT-2966';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al invocar al procedimiento PRV_DISPATCHER.EXECUTE_OAS.
                prv_dispatcher.execute_oas
                (
                    pi_subscriber_id               => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_cod_transaccion             => c_tipo_transaccion,
                    pi_id_action                   => v_id_accion,
                    pi_sub_operation               => c_tipo_operacion_add,
                    pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                    pi_p6                          => tx_ecms.c_bal_core_balance,
                    pi_p7                          => 'OMEGA:' || pi_cod_servicio,
                    pi_p8                          => TO_CHAR(v_date_exp_core_balance,'YYYY-MM-DD"T"HH24:MI:SS"-04:00"'),
                    pi_specific_user               => c_falso,
                    pi_cod_usuario                 => pi_cod_usuario,
                    pi_master                      => c_falso,
                    pi_id_tran                     => v_id_tran,
                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                    pi_fch_tran                    => v_fch_tran,
                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                    po_cod_err                     => po_cod_err,
                    po_msj_err                     => po_msj_err
                );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                -- BREAKAGE: Realizar recarga y actualizar vigencia.
                IF v_fch_tran > v_acct_expire_date THEN
                    v_date_exp_promo_balance_4  := v_date_exp_core_balance;
                    po_cod_err := 'PVT-2967';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al invocar al procedimiento PRV_DISPATCHER.EXECUTE_OAS.
                    prv_dispatcher.execute_oas
                    (
                        pi_subscriber_id               => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_cod_transaccion             => c_tipo_transaccion,
                        pi_id_action                   => v_id_accion,
                        pi_sub_operation               => c_tipo_operacion_add,
                        pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                        pi_p5                          => v_available_balance1,
                        pi_p6                          => tx_ecms.c_bal_promotional_balance_4,
                        pi_p7                          => 'OMEGA:' || pi_cod_servicio,
                        pi_p8                          => TO_CHAR(v_date_exp_promo_balance_4,'YYYY-MM-DD"T"HH24:MI:SS"-04:00"'),
                        pi_specific_user               => c_falso,
                        pi_cod_usuario                 => pi_cod_usuario,
                        pi_master                      => c_falso,
                        pi_id_tran                     => v_id_tran,
                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                        pi_fch_tran                    => v_fch_tran,
                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                        po_cod_err                     => po_cod_err,
                        po_msj_err                     => po_msj_err
                     );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
            END IF;
        END IF;

        IF v_sus_esp_hibpre > 0 THEN

            po_cod_err := 'PVT-6017';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al dar de baja el servicio suspendido.
            UPDATE cl_servicio_suspendido
                SET estado = 'A',
                    fch_fin = v_fch_tran,
                    id_tran_fin = v_id_tran,
                    cod_gestion_tran_fin = v_cod_gestion_tran,
                    cod_usuario_fin = pi_cod_usuario
             WHERE ID_ENTIDAD_CONSUMO = v_reg_entidad_consumo.id_entidad_consumo
                AND cod_Servicio = 'SHIBESP'
                AND estado = 'P'
                AND FCH_FIN > SYSDATE;

            po_cod_err := 'PVT-6018';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al verificar el contador del plan.
            v_plan_contador :=  tx_vpg_util.get_plan_param_value(v_reg_entidad_consumo.cod_plan,'MAIN_COUNTER_ID', 'VPG_CNF');

            IF v_plan_contador IS NOT NULL THEN

                --Enviar la orden para reset del counter de plan.
                SELECT tx_vpg_util.get_comando('SET_OFFER_COUNTER', 'CCOPRE', 'SET')
                  INTO v_command_id
                  FROM DUAL;

                po_cod_err    := 'PVT-6019'; --TX_PVT_SERVICIOS.ASIGNAR_RECARGA_DATA: Error al dar de alta la orden en el PRV.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => '1'||v_reg_entidad_consumo.identificador_entidad,
                            pi_p2                   => TX_AIR.GET_TRANSACTIONID,
                            pi_p3                   => tx_vpg_util.date2iso(v_fch_tran),
                            pi_p4                   => v_plan_contador, -- COUNTER_ID
                            pi_p5                   => '0', -- VALOR
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;

                SELECT COUNT(1)
                    INTO v_dummy
                FROM cl_servicio_entidad_consumo ec
                WHERE ec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                AND ec.cod_servicio = 'PMODAXS'
                AND ec.fch_fin > SYSDATE;

                IF v_dummy = c_verdadero THEN

                 SELECT *
                    INTO v_reg_periodo
                FROM tr_periodo_facturacion tr
                WHERE tr.cod_ciclo_facturacion = (SELECT cod_ciclo_facturacion
                                                    FROM cl_comunidad
                                                    WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante  )
                AND tr.vigente = c_verdadero;


                SELECT tx_vpg_util.get_comando('SET_OFFER', 'CCOPRE', 'SET')
                    INTO v_command_id
                FROM DUAL;

                v_offer_id      :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE('PMODAXS',v_reg_entidad_consumo.COD_PLAN,'OFFER_ID','VPG_CNF');

                po_cod_err    := 'PVT-5024'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_offer_id, -- OFFER ID   -- TODO: JA nos enviare los OFFER ID
                            pi_p4                   =>  'A',
                            pi_p5                   => NULL, --Fecha Vigencia
                            pi_p6                   => TO_CHAR(TRUNC( v_reg_periodo.periodo_fin + 3 ),'YYYY-MM-DD'), --Fecha Expiracion
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;

               --VErificar primer paquete de minutos
            SELECT COUNT(1)
                INTO v_dummy
            FROM cl_servicio_entidad_consumo
            WHERE id_entidad_consumo =  v_reg_entidad_consumo.id_entidad_consumo
            AND cod_servicio = 'PLVOZ1'
            AND fch_fin > SYSDATE;

            IF v_dummy = c_verdadero THEN

                SELECT tx_vpg_util.get_comando('SET_OFFER_DA', 'CCOPRE', 'SET')
                    INTO v_command_id
                FROM DUAL;

                po_cod_err    := 'PVT-6020'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                v_da_id         :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE('PLVOZ1',v_reg_entidad_consumo.COD_PLAN,'DA_ID','VPG_CNF');
                v_offer_id      :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE('PLVOZ1',v_reg_entidad_consumo.COD_PLAN,'OFFER_ID','VPG_CNF');
                v_minutos_amt  :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE('PLVOZ1',v_reg_entidad_consumo.COD_PLAN,'MINUTES_AMT','VPG_CNF');

                po_cod_err    := 'PVT-6021'; --TX_PVT_SERVICIOS.ASIGNAR_RECARGA_DATA: Error al obtener periodo vigente.
                SELECT *
                    INTO v_reg_periodo
                FROM tr_periodo_facturacion tr
                WHERE tr.cod_ciclo_facturacion = (SELECT cod_ciclo_facturacion
                                                    FROM cl_comunidad
                                                    WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante  )
                AND tr.vigente = c_verdadero;

                po_cod_err    := 'PVT-6022'; --TX_PVT_SERVICIOS.ASIGNAR_RECARGA_DATA: Error al dar de alta la orden en el PRV.

                mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_tran,
                    pi_cod_transaccion      => v_cod_tran,
                    pi_p1                   => '1'||v_reg_entidad_consumo.identificador_entidad,
                    pi_p2                   => tx_air.GET_TRANSACTIONID,
                    pi_p3                   => tx_vpg_util.date2iso(v_fch_tran), -- fecha transaccion
                    pi_p4                   => v_da_id, -- da_id
                    pi_p5                   => tx_vpg_util.number2cs(v_minutos_amt), -- valor de ajuste
                    pi_p6                   => 1, -- da_unit_type_id
                    pi_p7                   => tx_vpg_util.date2iso(v_reg_periodo.periodo_fin + 2), -- Fecha fin
                    pi_p8                   => 'RECARGA MINUTOS EN RECONEXION', -- comentario 1
                    pi_p9                   => 0, -- comentario 2 - puede ser nulo
                    pi_p12                  => v_offer_id, -- offer id
                    pi_p13                  => tx_vpg_util.date2iso(v_fch_tran), --Fecha inicio
                    pi_p14                  => tx_vpg_util.date2iso(v_reg_periodo.periodo_fin + 2), -- Fecha fin
                    pi_p15                  => '2', -- Offer type, por defecto 2= timer
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_po_id_orden,
                    po_id_tran              => v_po_id_tran,
                    po_fch_tran             => v_po_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                );

                IF po_cod_err != 'OK' THEN
                    RAISE err_app;
                END IF;


            END IF;

            --VErificar paquete minutos 50
            SELECT COUNT(1)
                INTO v_dummy
            FROM cl_servicio_entidad_consumo
            WHERE id_entidad_consumo =  v_reg_entidad_consumo.id_entidad_consumo
            AND cod_servicio = 'PLVOZ3'
            AND fch_fin > SYSDATE;

            IF v_dummy = c_verdadero THEN

                SELECT tx_vpg_util.get_comando('SET_OFFER_DA', 'CCOPRE', 'SET')
                    INTO v_command_id
                FROM DUAL;

                po_cod_err    := 'PVT-6020'; --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO: Error al dar de alta la orden en el PRV.
                v_da_id         :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE('PLVOZ3',v_reg_entidad_consumo.COD_PLAN,'DA_ID','VPG_CNF');
                v_offer_id      :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE('PLVOZ3',v_reg_entidad_consumo.COD_PLAN,'OFFER_ID','VPG_CNF');
                v_minutos_amt  :=  tx_vpg_util.GET_SERVICIO_PARAM_VALUE('PLVOZ3',v_reg_entidad_consumo.COD_PLAN,'MINUTES_AMT','VPG_CNF');

                po_cod_err    := 'PVT-6021'; --TX_PVT_SERVICIOS.ASIGNAR_RECARGA_DATA: Error al obtener periodo vigente.
                SELECT *
                    INTO v_reg_periodo
                FROM tr_periodo_facturacion tr
                WHERE tr.cod_ciclo_facturacion = (SELECT cod_ciclo_facturacion
                                                    FROM cl_comunidad
                                                    WHERE id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante  )
                AND tr.vigente = c_verdadero;

                po_cod_err    := 'PVT-6022'; --TX_PVT_SERVICIOS.ASIGNAR_RECARGA_DATA: Error al dar de alta la orden en el PRV.

                mt_vpg.alta_orden(
                    pi_id_comando           => v_command_id,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_tran,
                    pi_cod_transaccion      => v_cod_tran,
                    pi_p1                   => '1'||v_reg_entidad_consumo.identificador_entidad,
                    pi_p2                   => tx_air.GET_TRANSACTIONID,
                    pi_p3                   => tx_vpg_util.date2iso(v_fch_tran), -- fecha transaccion
                    pi_p4                   => v_da_id, -- da_id
                    pi_p5                   => tx_vpg_util.number2cs(v_minutos_amt), -- valor de ajuste
                    pi_p6                   => 1, -- da_unit_type_id
                    pi_p7                   => tx_vpg_util.date2iso(v_reg_periodo.periodo_fin + 2), -- Fecha fin
                    pi_p8                   => 'RECARGA MINUTOS EN RECONEXION', -- comentario 1
                    pi_p9                   => 0, -- comentario 2 - puede ser nulo
                    pi_p12                  => v_offer_id, -- offer id
                    pi_p13                  => tx_vpg_util.date2iso(v_fch_tran), --Fecha inicio
                    pi_p14                  => tx_vpg_util.date2iso(v_reg_periodo.periodo_fin + 2), -- Fecha fin
                    pi_p15                  => '2', -- Offer type, por defecto 2= timer
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_po_id_orden,
                    po_id_tran              => v_po_id_tran,
                    po_fch_tran             => v_po_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                );

                IF po_cod_err != 'OK' THEN
                    RAISE err_app;
                END IF;


            END IF;

            -- Para estos planes enviar orden de inactivar Service Offering par no ejecucion de PAM.
            --IF tx_pvt_entidad_consumo.ES_PLAN_4G(v_reg_entidad_consumo.cod_plan) = c_verdadero THEN
                po_cod_err := 'PVT-6014'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden..
                SELECT tx_vpg_util.get_comando('SET_SERV_OFFERING', 'CCOPRE', 'SET')
                  INTO v_command_id
                  FROM DUAL;

                /*SELECT ers.service_offerings
                    INTO v_ers_so
                FROM ers_subscriber ers
                WHERE ers.internal_id = v_reg_entidad_consumo.id_entidad_consumo;

                IF v_ers_so >= 16 AND  v_ers_so < 32 THEN
                    v_so_eliminar   :=  '5';
                ELSIF v_ers_so >= 32 THEN
                    v_so_eliminar   :=  '6';
                ELSE
                    v_so_eliminar   :=  '4';
                END IF;*/

                v_so_eliminar   :=  '6';

                po_cod_err := 'PVT-6015'; --TX_PVT_ENTIDAD_CONSUMO.CORTE_ENTIDAD_CONSUMO_CONSOL: Error al enviar orden..
                mt_vpg.alta_orden(
                            pi_id_comando           => v_command_id,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => '1'||v_reg_entidad_consumo.identificador_entidad,
                            pi_p2                   => v_id_tran,
                            pi_p3                   => tx_vpg_util.date2iso(v_fch_tran),
                            pi_p4                   => v_so_eliminar,  -- SErvice offering
                            pi_p5                   => '0',  -- Flag activado
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => c_falso,
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_po_id_orden,
                            po_id_tran              => v_po_id_tran,
                            po_fch_tran             => v_po_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            --END IF;


        END IF;

        po_cod_err := 'PVT-2968';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al obtener el id del cliente.
        v_id_cliente               := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        po_cod_err := 'PVT-2969';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al recuperar la descripcion del nuevo estado.

        SELECT descripcion
          INTO descripcion_nuevo_estado
          FROM cnf_estado_entidad c
         WHERE c.cod_estado = v_estado_fin
           AND c.cod_entidad = c_nivel_entidad_consumo
           AND c.estado <> c_estado_inactivo
           AND c.fch_fin = c_fecha_fin;

        po_cod_err := 'PVT-2970';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al recuperar la descripcion del estado actual.

        SELECT estado into v_status from cl_comunidad where id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        SELECT cod_motivo into v_cod_motivo
        FROM cnf_motivo_transaccion
        WHERE estado='A' AND cod_transaccion='TX_TRAN_RECONEXION_COMUNIDAD'
        ORDER BY descripcion;


        if(v_status='RESD')  THEN

            po_cod_err := 'PVT-6221'; --CC_CL_COMUNIDAD.CAMBIA_ESTADO: Error al cambiar estado de la comunidad al activar suscriptor con comunidad inactiva.


            cc_cl_comunidad.cambia_estado (pi_id_comunidad            => v_reg_entidad_consumo.id_comunidad_facturante,
                                       pi_estado                      => c_estado_activo,
                                       pi_cod_usuario                 => pi_cod_usuario,
                                       pi_id_tran                     => v_id_tran,
                                       pi_cod_gestion_tran            => v_cod_gestion_tran,
                                       pi_fch_tran                    => v_fch_tran,
                                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                       pi_fch_efectiva                => v_fch_tran,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );
            IF po_cod_err <> 'OK' THEN
            RAISE err_app;
            END IF;

        END IF;

        SELECT descripcion
          INTO descripcion_estado_actual
          FROM cnf_estado_entidad c
         WHERE c.cod_estado = v_estado_ini
           AND c.cod_entidad = c_nivel_entidad_consumo
           AND c.estado <> c_estado_inactivo
           AND c.fch_fin = c_fecha_fin;

        v_trama_nuevo_pv           :=    'Estado:'
                                      || v_estado_fin
                                      || '|'
                                      || 'Descripcion:'
                                      || descripcion_nuevo_estado;
        v_trama_anterior_pv        :=    'Estado:'
                                      || v_estado_ini
                                      || '|'
                                      || 'Descripcion:'
                                      || descripcion_estado_actual;
        --- Registrar transaccion
        po_cod_err := 'PVT-2971';   --TX_PVT_ENTIDAD_CONSUMO.RECONEXION_ENTIDAD_CONSUMO: Error al invocar al proc. de registro del log transaccional postventa.
        cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => NULL,
                                   pi_descripcion_observacion     => NULL,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err                 := 'OK';
        po_msj_err                 := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out                :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE carga_balance (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_tipo_balance           IN       VARCHAR2,
        pi_monto                  IN       vta_venta_prospecto.valor%TYPE,
        pi_fch_vigencia           IN       DATE,
        pi_dias_vigencia          IN       NUMBER,
        pi_cod_motivo             IN       vta_venta_prospecto.cod_local%TYPE,
        pi_refill_profile_id      IN       cl_recarga_inicial.refill_profile_id%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion            VARCHAR2 (50)
                                    := tx_cnf_constante.get_constante ('TRANSACCION_CARGA_BALANCE');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.VENTA_MINUTOS';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := '';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_fch_vigencia                VARCHAR2 (20);
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_desc_motivo                 cnf_motivo_transaccion.descripcion%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        vcod_grupo_plan               bm_grupo_plan.cod_grupo_plan%TYPE;
        v_dias_vigencia               VARCHAR2 (20);
        v_id_comando                  vpg_cnf_comando.id_comando%TYPE;
        v_id_orden                    vpg_orden.id_orden%TYPE;
        v_tipo_recarga                cnf_catalogo.cod_catalogo%TYPE := 'TRECBA';
        -- Excepciones
        err_app                       EXCEPTION;
        v_ext_data_1                  VARCHAR2(50) := '0';
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_tipo_balance:'
            || pi_tipo_balance
            || '|'
            || 'pi_monto:'
            || pi_monto
            || '|'
            || 'pi_cod_motivo:'
            || pi_cod_motivo
            || '|'
            || 'pi_refill_profile_id:'
            || pi_refill_profile_id
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_tipo_balance IS NULL
           OR pi_monto IS NULL
           OR pi_cod_motivo IS NULL
           OR pi_refill_profile_id IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2972';   --TX_PVT_ENTIDAD_CONSUMO.CARGA_BALANCE: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2973';   --TX_PVT_ENTIDAD_CONSUMO.CARGA_BALANCE: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2974';   --TX_PVT_ENTIDAD_CONSUMO.CARGA_BALANCE: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        --EL SUSCRIPTOR NO DEBE ESTAR SUSPENDIDO NI DESCONECTADO
        IF     pi_master = c_verdadero
           AND suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-2975';   --TX_PVT_ENTIDAD_CONSUMO.CARGA_BALANCE: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --EL SUSCRIPTOR NO DEBE ESTAR TERMINADO
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --DESCRIPCION DEL MOTIVO
        po_cod_err := 'PVT-2976';   --TX_PVT_ENTIDAD_CONSUMO.CARGA_BALANCE: Error al recuperar la descripcion del motivo.

        SELECT descripcion
          INTO v_desc_motivo
          FROM cnf_motivo_transaccion mt
         WHERE mt.cod_motivo = pi_cod_motivo;

        IF pi_cod_motivo = 'CBRINI' THEN
            c_tipo_transaccion    := 'RECARGA_INICIAL';
            v_tipo_recarga  := 'TREINI';  -- cnf_catalogo
        END IF;

        IF pi_dias_vigencia IS NULL THEN
            v_dias_vigencia    := 0;
        ELSE
            v_dias_vigencia    := pi_dias_vigencia;
        END IF;

        IF pi_cod_usuario = 'APPVIVA' THEN
            v_desc_motivo := 'RECARGA VIVA APP';
            v_ext_data_1  := 'VIVA-APP';
        ELSIF pi_cod_usuario = 'PAGOPGW' THEN
            v_desc_motivo := 'RECARGA VIVA IVR';
            v_ext_data_1  := 'VIVA-IVR';
        END IF;

        --PROVISIONAR CARGA DE BALANCE EN DISPOSITIVOS
        v_fch_vigencia         := TO_CHAR (TRUNC (NVL (pi_fch_vigencia + 1, c_fecha_fin)),
                                           'yyyy-mm-dd');

        po_cod_err                  := 'PVT-5093';   --TX_PVT_ENTIDAD_CONSUMO.CARGA_BALANCE: Error al buscar el enlace del comando.
        SELECT tx_vpg_util.get_comando('RECARGA_NV', v_reg_entidad_consumo.cod_forma_consumo, 'ADD')
          INTO v_id_comando
          FROM DUAL;

        po_cod_err                  := 'PVT-5094'; --TX_PVT_ENTIDAD_CONSUMO.CARGA_BALANCE: Error al dar de alta la orden.
        mt_vpg.alta_orden(
                    pi_id_comando           => v_id_comando,
                    pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada       => v_fch_tran,
                    pi_cod_transaccion      => c_tipo_transaccion,
                    pi_p1                   => tx_vpg_util.pcs2cs(v_reg_entidad_consumo.id_entidad_consumo),
                    pi_p2                   => 'ADM',
                    pi_p3                   => v_desc_motivo,
                    pi_p4                   => v_id_tran,
                    pi_p5                   => tx_vpg_util.date2iso(v_fch_tran),
                    pi_p6                   => tx_vpg_util.number2cs(pi_monto),
                    pi_p7                   => pi_refill_profile_id,
                    pi_p8                   => v_ext_data_1,
                    pi_p9                   => v_tipo_recarga,
                    pi_p10                  => null,
                    pi_cod_usuario          => pi_cod_usuario,
                    pi_master               => c_falso,
                    pi_id_tran              => v_id_tran,
                    pi_cod_gestion_tran     => v_cod_gestion_tran,
                    pi_fch_tran             => v_fch_tran,
                    pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                    po_id_orden             => v_id_orden,
                    po_id_tran              => v_id_tran,
                    po_fch_tran             => v_fch_tran,
                    po_cod_err              => po_cod_err,
                    po_msj_err              => po_msj_err
                    );
        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --REGISTRAR EL LOG TRANSACCIONAL POSTVENTA
        IF pi_master = c_verdadero THEN
            po_cod_err := 'PVT-2979';   --TX_PVT_ENTIDAD_CONSUMO.CARGA_BALANCE: Error al obtener el id del cliente.
            v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
            v_trama_anterior_pv    := NULL;
            v_trama_nuevo_pv       :=    'Balance:'
                                      || pi_tipo_balance
                                      || '|'
                                      || 'Monto:'
                                      || pi_monto
                                      || '|'
                                      || 'Cod_motivo:'
                                      || pi_cod_motivo
                                      || '|'
                                      || 'Motivo:'
                                      || v_desc_motivo;
            --- Registrar transaccion
            po_cod_err := 'PVT-2980';   --TX_PVT_ENTIDAD_CONSUMO.CARGA_BALANCE: Error al invocar al proc. de registro transaccional de postventa.
            cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => pi_cod_motivo,
                                   pi_cod_observacion             => NULL,
                                   pi_descripcion_observacion     => NULL,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE cambio_datos_suscriptor (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_id_persona             IN       cl_datos_facturacion.id_persona%TYPE,
        pi_id_direccion           IN       cl_datos_facturacion.id_direccion%TYPE,
        --- Datos de la persona
        pi_cod_tipo_persona       IN       cl_persona.cod_tipo_persona%TYPE,
        pi_nombre                 IN       cl_persona.nombre%TYPE,
        pi_apellido_paterno       IN       cl_persona.apellido_paterno%TYPE,
        pi_apellido_materno       IN       cl_persona.apellido_materno%TYPE,
        pi_cod_tipo_documento     IN       cl_persona.cod_tipo_documento%TYPE,
        pi_nro_documento          IN       cl_persona.nro_documento%TYPE,
        pi_cod_ciudad_expedida    IN       cl_persona.cod_ciudad_expedida%TYPE,
        pi_nit                    IN       cl_persona.nit%TYPE,
        --- Datos de la direccion
        pi_cod_tipo_direccion     IN       cl_direccion.cod_tipo_direccion%TYPE,
        pi_cod_tipo_propiedad     IN       cl_direccion.cod_tipo_propiedad%TYPE,
        pi_zona_barrio_urb        IN       cl_direccion.zona_barrio_urb%TYPE,
        pi_calle_av_pasaje        IN       cl_direccion.calle_av_pasaje%TYPE,
        pi_entre_calle_1          IN       cl_direccion.entre_calle_1%TYPE,
        pi_entre_calle_2          IN       cl_direccion.entre_calle_2%TYPE,
        pi_cod_ciudad             IN       cl_direccion.cod_ciudad%TYPE,
        pi_edificio               IN       cl_direccion.edificio%TYPE,
        pi_departamento           IN       cl_direccion.departamento%TYPE,
        pi_piso                   IN       cl_direccion.piso%TYPE,
        pi_numero                 IN       cl_direccion.numero%TYPE,
        pi_subnumero              IN       cl_direccion.subnumero%TYPE,
        pi_desde_ano              IN       cl_direccion.desde_ano%TYPE,
        pi_desde_mes              IN       cl_direccion.desde_mes%TYPE,
        pi_observacion            IN       cl_direccion.observacion%TYPE,
        pi_id_sector              IN       cl_direccion.id_sector%TYPE,
        pi_id_sub_sector          IN       cl_direccion.id_sub_sector%TYPE,
        pi_sub_sector             IN       cl_direccion.sub_sector%TYPE,
        pi_id_calle               IN       cl_direccion.id_calle%TYPE,
        pi_cod_provincia          IN       cl_direccion.cod_provincia%TYPE,
        pi_datos_adic_persona     IN       VARCHAR2,
        -- Datos Transaccionales
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        -- Datos de Salida
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_DATOS_SUSC');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_PERSONA';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_persona                  cl_persona.id_persona%TYPE;
        v_reg_persona                 cl_persona%ROWTYPE;
        v_id_direccion                cl_direccion.id_direccion%TYPE;
        v_reg_direccion               cl_direccion%ROWTYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_reg_datos_facturacion       cl_datos_facturacion%ROWTYPE;
        v_id_datos_factura            cl_datos_facturacion.id_datos_factura%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_desc_tipo_persona           cnf_catalogo.descripcion%TYPE;
        v_desc_tipo_documento         cnf_catalogo.descripcion%TYPE;
        v_desc_ciudad_expedida        cnf_ciudad.descripcion%TYPE;
        v_desc_tipo_direccion         cnf_catalogo.descripcion%TYPE;
        v_desc_tipo_propiedad         cnf_catalogo.descripcion%TYPE;
        v_desc_ciudad                 cnf_ciudad.descripcion%TYPE;
        v_modificacion                VARCHAR2 (1);
        v_dummy                       PLS_INTEGER;
        v_id_paquete                  cl_paquete.id_paquete%TYPE;
        v_fch_cambio_dir              cl_direccion.fch_tran%TYPE;
        -- Excepciones
        err_app                       EXCEPTION;
        v_identificador_entidad       VARCHAR2 (100);
        v_service_exists              VARCHAR2 (1);
        id_tran_inicio_datos          tx_historico_transaccion.id_tran%TYPE;
        v_email_to                    VARCHAR2(400);
        v_po_id_tran                  tx_historico_transaccion.id_tran%TYPE;
        v_po_fch_tran                 tx_historico_transaccion.fch_tran%TYPE;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in      :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_id_persona:'
            || pi_id_persona
            || '|'
            || 'pi_id_direccion:'
            || pi_id_direccion
            || '|'
            || 'pi_cod_tipo_persona:'
            || pi_cod_tipo_persona
            || '|'
            || 'pi_apellido_paterno:'
            || pi_apellido_paterno
            || '|'
            || 'pi_apellido_materno:'
            || pi_apellido_materno
            || '|'
            || 'pi_cod_tipo_documento:'
            || pi_cod_tipo_documento
            || '|'
            || 'pi_nro_documento:'
            || pi_nro_documento
            || '|'
            || 'pi_cod_ciudad_expedida:'
            || pi_cod_ciudad_expedida
            || '|'
            || 'pi_nit:'
            || pi_nit
            || '|'
            || 'pi_cod_tipo_direccion:'
            || pi_cod_tipo_direccion
            || '|'
            || 'pi_cod_tipo_propiedad:'
            || pi_cod_tipo_propiedad
            || '|'
            || 'pi_zona_barrio_urb:'
            || pi_zona_barrio_urb
            || '|'
            || 'pi_calle_av_pasaje:'
            || pi_calle_av_pasaje
            || '|'
            || 'pi_entre_calle_1:'
            || pi_entre_calle_1
            || '|'
            || 'pi_entre_calle_2:'
            || pi_entre_calle_2
            || '|'
            || 'pi_cod_ciudad:'
            || pi_cod_ciudad
            || '|'
            || 'pi_edificio:'
            || pi_edificio
            || '|'
            || 'pi_departamento:'
            || pi_departamento
            || '|'
            || 'pi_piso:'
            || pi_piso
            || '|'
            || 'pi_numero:'
            || pi_numero
            || '|'
            || 'pi_subnumero:'
            || pi_subnumero
            || '|'
            || 'pi_desde_ano:'
            || pi_desde_ano
            || '|'
            || 'pi_desde_mes:'
            || pi_desde_mes
            || '|'
            || 'pi_observacion:'
            || pi_observacion
            || '|'
            || 'pi_datos_adic_persona:'
            || pi_datos_adic_persona
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF pi_id_entidad_consumo IS NULL OR pi_master IS NULL THEN
            po_cod_err := 'PVT-2981';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-2982';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-2983';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        ------------------------------ Logica del procedimiento -------------------------
        v_service_exists:= tiene_servicio_suspension(pi_id_entidad_consumo,'SS13');

        IF v_service_exists = '0' THEN

                --EL SUSCRIPTOR NO DEBE TENER NINGUNA SUSPENSION NI DESCONEXION
                IF suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero THEN
                    po_cod_err := 'PVT-2984';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: El suscriptor esta suspendido.
                    RAISE err_app;
                END IF;

        END IF;
        --EL SUSCRIPTOR NO DEBE ESTAR TERMINADO
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        /* -- Comentado a solitud de Dayana Perez.
        po_cod_err := 'PVT-2985';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al validar las cuentas del cliente en la empresa.
        tx_cl_cicla.valida_cuentas (
            pi_tipo_documento           =>  pi_cod_tipo_documento,
            pi_nro_documento            =>  pi_nro_documento,
            pi_cod_usuario              =>  pi_cod_usuario,
            pi_id_tran                  =>  v_id_tran,
            pi_cod_gestion_tran         =>  v_cod_gestion_tran,
            pi_fch_tran                 =>  v_fch_tran,
            pi_cod_unidad_negocio       =>  pi_cod_unidad_negocio,
            po_cod_err                  =>  po_cod_err,
            po_msj_err                  =>  po_msj_err
        );
        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;
        */
        po_cod_err := 'PVT-2986';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al obtener el id del cliente.
        v_id_cliente    := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        po_cod_err := 'PVT-2987';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar los datos de la persona actual de facturacion.

        SELECT *
          INTO v_reg_persona
          FROM cl_persona
         WHERE id_persona = v_reg_entidad_consumo.id_persona AND estado <> c_estado_inactivo;

        po_cod_err := 'PVT-2988';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar los datos de la direccion actual del suscriptor.

        SELECT *
          INTO v_reg_direccion
          FROM (SELECT   *
                    FROM cl_direccion
                   WHERE id_persona = v_reg_entidad_consumo.id_persona
                     AND estado <> c_estado_inactivo
                ORDER BY fch_tran DESC)
         WHERE ROWNUM < 2;

        --NUEVA PERSONA
        IF pi_id_persona IS NULL THEN
            po_cod_err := 'PVT-2989';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al invocar a CC_CL_PERSONA.ALTA.
            cc_cl_persona.alta (pi_cod_tipo_persona            => pi_cod_tipo_persona,
                                pi_nombre                      => pi_nombre,
                                pi_apellido_paterno            => pi_apellido_paterno,
                                pi_apellido_materno            => pi_apellido_materno,
                                pi_apellido_casada             => NULL,
                                pi_cod_estado_civil            => NULL,
                                pi_cod_tipo_documento          => pi_cod_tipo_documento,
                                pi_nro_documento               => pi_nro_documento,
                                pi_cod_ciudad_expedida         => pi_cod_ciudad_expedida,
                                pi_fch_nacimiento              => NULL,
                                pi_sexo                        => NULL,
                                pi_ruc                         => NULL,
                                pi_cod_ciiu                    => NULL,
                                pi_nit                         => pi_nit,
                                pi_cod_pais                    => NULL,
                                pi_empresa_trabajo             => NULL,
                                pi_ano_ingreso                 => NULL,
                                pi_mes_ingreso                 => NULL,
                                pi_id_proc_ems                 => NULL,
                                pi_id_orig_proc_ems            => NULL,
                                pi_id_form_ems                 => NULL,
                                pi_id_orig_form_ems            => NULL,
                                pi_cod_usuario                 => pi_cod_usuario,
                                pi_id_tran                     => v_id_tran,
                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                pi_fch_tran                    => v_fch_tran,
                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                pi_fch_efectiva                => v_fch_tran,
                                po_id_persona                  => v_id_persona,
                                po_cod_err                     => po_cod_err,
                                po_msj_err                     => po_msj_err
                               );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            v_modificacion    := c_falso;
        ELSE
            --ACTUALIZACION DE DATOS DE PERSONA
            v_id_persona      := pi_id_persona;
            po_cod_err := 'PVT-2990';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al invocar a CC_CL_PERSONA.MODIFICACION.
            cc_cl_persona.modificacion (pi_id_persona                  => v_id_persona,
                                        pi_cod_tipo_persona            => pi_cod_tipo_persona,
                                        pi_nombre                      => pi_nombre,
                                        pi_apellido_paterno            => pi_apellido_paterno,
                                        pi_apellido_materno            => pi_apellido_materno,
                                        pi_apellido_casada             => v_reg_persona.apellido_casada,
                                        pi_cod_estado_civil            => v_reg_persona.cod_estado_civil,
                                        pi_cod_tipo_documento          => pi_cod_tipo_documento,
                                        pi_nro_documento               => pi_nro_documento,
                                        pi_cod_ciudad_expedida         => pi_cod_ciudad_expedida,
                                        pi_fch_nacimiento              => v_reg_persona.fch_nacimiento,
                                        pi_sexo                        => v_reg_persona.sexo,
                                        pi_ruc                         => v_reg_persona.ruc,
                                        pi_cod_ciiu                    => v_reg_persona.cod_ciiu,
                                        pi_nit                         => pi_nit,
                                        pi_cod_pais                    => v_reg_persona.cod_pais,
                                        pi_empresa_trabajo             => v_reg_persona.empresa_trabajo,
                                        pi_ano_ingreso                 => v_reg_persona.ano_ingreso,
                                        pi_mes_ingreso                 => v_reg_persona.mes_ingreso,
                                        pi_id_proc_ems                 => v_reg_persona.id_proc_ems,
                                        pi_id_orig_proc_ems            => v_reg_persona.id_orig_proc_ems,
                                        pi_id_form_ems                 => v_reg_persona.id_form_ems,
                                        pi_id_orig_form_ems            => v_reg_persona.id_orig_form_ems,
                                        pi_cod_usuario                 => pi_cod_usuario,
                                        pi_id_tran                     => v_id_tran,
                                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                                        pi_fch_tran                    => v_fch_tran,
                                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                        pi_fch_efectiva                => v_fch_tran,
                                        po_cod_err                     => po_cod_err,
                                        po_msj_err                     => po_msj_err
                                       );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            v_modificacion    := c_verdadero;
        END IF;

        po_cod_err := 'PVT-2991';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al registrar los datos adicionales de la persona.
        tx_pvt_ccs.registrar_datos_persona (pi_id_persona                  => v_id_persona,
                                            pi_datos                       => pi_datos_adic_persona,
                                            pi_modificacion                => v_modificacion,
                                            pi_cod_usuario                 => pi_cod_usuario,
                                            pi_id_tran                     => v_id_tran,
                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                            pi_fch_tran                    => v_fch_tran,
                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        BEGIN

             SELECT per.valor
               INTO v_email_to
               FROM cl_persona_dato per
              WHERE per.id_persona = v_id_persona
                AND per.cod_tipo_dato = 'TDCELE'
                AND per.ultimo_registro = c_verdadero
                AND id_tran_inicio = v_id_tran;
         EXCEPTION
             WHEN OTHERS THEN
                 v_email_to := c_falso;
         END;

         IF v_email_to <> c_falso THEN

             po_cod_err := 'PVT-2992';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al enviar correo electronico al cliente
           mt_cli_util.registra_email(
                                      pi_id_entidad_consumo => pi_id_entidad_consumo,
                                      pi_cod_usuario => pi_cod_usuario,
                                      pi_master => pi_master,
                                      pi_id_tran => v_id_tran,
                                      pi_cod_gestion_tran => v_cod_gestion_tran,
                                      pi_fch_tran => v_fch_tran,
                                      pi_cod_unidad_negocio => pi_cod_unidad_negocio,
                                      po_id_tran => v_po_id_tran,
                                      po_fch_tran => v_po_fch_tran,
                                      po_cod_err => po_cod_err,
                                      po_msj_err => po_msj_err
                                    );
--             cc_cl_persona.enviar_correo_cambio_email (pi_id_persona                  => pi_id_persona,
--                                                       pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
--                                                       pi_email                       => v_email_to,
--                                                       pi_id_entidad_consumo          => pi_id_entidad_consumo,
--                                                       pi_cod_usuario                 => pi_cod_usuario,
--                                                       pi_fch_tran                    => v_fch_tran,
--                                                       pi_cod_gestion_tran            => v_cod_gestion_tran,
--                                                       pi_id_tran                     => v_id_tran,
--                                                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
--                                                       po_cod_err                     => po_cod_err,
--                                                       po_msj_err                     => po_msj_err
--                                                      );
             IF po_cod_err != 'OK' THEN
                 RAISE err_app;
             END IF;
         END IF;

       --PROMOCION 1 BOLETO POR ACTUALIZACION DE DATOS PREPAGOS
       SELECT COUNT(1)
         INTO v_dummy
         FROM v_plan_segmento
        WHERE cod_plan = v_reg_entidad_consumo.cod_plan
          AND cod_segmento IN ('PREPAGO','CASPRE','MOUNPRE');

       IF  prm_aplica_promocion (SYSDATE, '4899') = c_verdadero AND v_dummy = c_verdadero THEN
            BEGIN
                SELECT identificador_entidad
                  INTO v_identificador_entidad
                  FROM cl_entidad_consumo
                 WHERE id_entidad_consumo = pi_id_entidad_consumo;

                SELECT cd.fch_tran
                  INTO v_fch_cambio_dir
                  FROM cl_entidad_consumo ce, cl_direccion cd
                 WHERE ce.id_entidad_consumo = pi_id_entidad_consumo
                   AND ce.id_persona = cd.id_persona
                   AND cd.estado = 'A'
                   AND cd.fch_tran = (SELECT MAX(fch_tran)
                                        FROM cl_direccion
                                       WHERE id_persona = ce.id_persona
                                         AND estado = 'A');
            EXCEPTION
                WHEN OTHERS THEN
                    v_fch_cambio_dir := v_fch_tran;
            END;

            IF v_fch_cambio_dir < v_fch_tran - (INTERVAL '3' MONTH)  THEN
                tx_prm_base_sorteo.alta (pi_id_promocion                 => prm_get_id_promocion ('4899'),
                                         pi_id_externo                   => pi_id_entidad_consumo,
                                         pi_id_entidad_consumo           => pi_id_entidad_consumo,
                                         pi_identificador_entidad        => v_identificador_entidad,
                                         pi_cod_tipo_boleto              => 'TBODIR',
                                         pi_id_tran                      => v_id_tran,
                                         pi_fch_tran                     => v_fch_tran,
                                         pi_cod_gestion_tran             => v_cod_gestion_tran,
                                         pi_cod_usuario                  => pi_cod_usuario,
                                         pi_cod_unidad_negocio           => pi_cod_unidad_negocio,
                                         pi_master                       => c_falso,
                                         po_cod_err                      => po_cod_err,
                                         po_msj_err                      => po_msj_err
                                        );
                 IF po_cod_err != 'OK' THEN
                    RAISE err_app;
                 END IF;

                 tx_sms.alta(pi_origen                      => 'VIVA',
                             pi_destino                     => v_identificador_entidad,
                             pi_texto                       => 'Por actualizar tus datos, has generado un boleto para participar en la rifa de un fin de semana o una cena de lujo. Valida tus boletos marcando #818#.',
                             pi_prioridad                   => 1,
                             pi_id_tran                     => v_id_tran,
                             pi_fch_tran                    => v_fch_tran,
                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                             pi_cod_usuario                 => pi_cod_usuario,
                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                             pi_master                      => c_falso,
                             po_id_sms                      => v_dummy,
                             po_cod_err                     => po_cod_err,
                             po_msj_err                     => po_msj_err
                            );
                   IF po_cod_err != 'OK' THEN
                      RAISE err_app;
                   END IF;
            END IF;
        END IF;

        --NUEVA DIRECCION
        IF pi_id_direccion IS NULL THEN
            po_cod_err := 'PVT-2993';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al invocar a CC_CL_DIRECCION.ALTA.
            cc_cl_direccion.alta (pi_id_persona                  => v_id_persona,
                                  pi_cod_tipo_direccion          => pi_cod_tipo_direccion,
                                  pi_cod_tipo_propiedad          => pi_cod_tipo_propiedad,
                                  pi_zona_barrio_urb             => pi_zona_barrio_urb,
                                  pi_calle_av_pasaje             => pi_calle_av_pasaje,
                                  pi_entre_calle_1               => pi_entre_calle_1,
                                  pi_entre_calle_2               => pi_entre_calle_2,
                                  pi_cod_ciudad                  => pi_cod_ciudad,
                                  pi_edificio                    => pi_edificio,
                                  pi_piso                        => pi_piso,
                                  pi_departamento                => pi_departamento,
                                  pi_numero                      => pi_numero,
                                  pi_subnumero                   => pi_subnumero,
                                  pi_desde_ano                   => pi_desde_ano,
                                  pi_desde_mes                   => pi_desde_mes,
                                  pi_observacion                 => pi_observacion,
                                  pi_id_sector                   => pi_id_sector,
                                  pi_id_sub_sector               => pi_id_sub_sector,
                                  pi_sub_sector                  => pi_sub_sector,
                                  pi_id_calle                    => pi_id_calle,
                                  pi_cod_provincia               => pi_cod_provincia,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  pi_fch_efectiva                => v_fch_tran,
                                  po_id_direccion                => v_id_direccion,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_cod_err
                                 );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            --ACTUALIZACION DE DATOS DE DIRECCION
            v_id_direccion    := pi_id_direccion;
            po_cod_err := 'PVT-2994';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al invocar a CC_CL_DIRECCION.MODIFICACION.
            cc_cl_direccion.modificacion (pi_id_direccion                => v_id_direccion,
                                          pi_cod_tipo_direccion          => pi_cod_tipo_direccion,
                                          pi_cod_tipo_propiedad          => pi_cod_tipo_propiedad,
                                          pi_zona_barrio_urb             => pi_zona_barrio_urb,
                                          pi_calle_av_pasaje             => pi_calle_av_pasaje,
                                          pi_entre_calle_1               => pi_entre_calle_1,
                                          pi_entre_calle_2               => pi_entre_calle_2,
                                          pi_cod_ciudad                  => pi_cod_ciudad,
                                          pi_edificio                    => pi_edificio,
                                          pi_piso                        => pi_piso,
                                          pi_departamento                => pi_departamento,
                                          pi_numero                      => pi_numero,
                                          pi_subnumero                   => pi_subnumero,
                                          pi_desde_ano                   => pi_desde_ano,
                                          pi_desde_mes                   => pi_desde_mes,
                                          pi_observacion                 => pi_observacion,
                                          pi_id_sector                   => pi_id_sector,
                                          pi_id_sub_sector               => pi_id_sub_sector,
                                          pi_sub_sector                  => pi_sub_sector,
                                          pi_id_calle                    => pi_id_calle,
                                          pi_cod_provincia               => pi_cod_provincia,
                                          pi_cod_usuario                 => pi_cod_usuario,
                                          pi_id_tran                     => v_id_tran,
                                          pi_cod_gestion_tran            => v_cod_gestion_tran,
                                          pi_fch_tran                    => v_fch_tran,
                                          pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                          pi_fch_efectiva                => v_fch_tran,
                                          po_cod_err                     => po_cod_err,
                                          po_msj_err                     => po_cod_err
                                         );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --ACTUALIZAR LA PERSONA DEL SUSCRIPTOR SI ESTA HA CAMBIADO
        IF v_reg_entidad_consumo.id_persona <> v_id_persona THEN

            FOR mochilero IN ( SELECT ec.id_entidad_consumo,
                                       ec.identificador_entidad,
                                       cnf.cod_catalogo as tipo_afinidad,
                                       se.cod_servicio
                                 FROM cl_entidad_consumo ec,  cnf_catalogo cnf,  cl_servicio_entidad_consumo se
                                WHERE ec.id_persona = v_reg_entidad_consumo.id_persona
                                  AND ec.cod_plan in ('PREVIVA_TU','VMCP')
                                  AND se.id_entidad_consumo = ec.id_entidad_consumo
                                  AND se.cod_servicio IN ('NFVIVM','NFVMCM')
                                  AND cnf.abreviatura = se.cod_servicio
                                  AND se.fch_fin = c_fecha_fin
                                  AND se.estado = c_estado_activo)
            LOOP

                tx_pvt_entidad_consumo.actualizar_numero_afin
                                 (pi_id_entidad_consumo          => mochilero.id_entidad_consumo,
                                  pi_cod_tipo_afinidad           => mochilero.tipo_afinidad,
                                  pi_numeros_afines              => NULL,
                                  pi_descontar                   => c_falso,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_tran                     => v_id_tran,
                                  po_cod_gestion_tran            => v_cod_gestion_tran,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;


                po_cod_err := 'PVT-2995';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_CONSOLIDACION: Error al invocar al proc. de desasignacion de servicios.
                cc_cl_servicio_entidad_consumo.desasignar
                                     (pi_id_entidad_consumo          => mochilero.id_entidad_consumo,
                                      pi_cod_servicio                => mochilero.cod_servicio,
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_tran,
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      pi_fch_efectiva                => v_fch_tran,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;

            END LOOP;
            po_cod_err := 'PVT-2996';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al invocar a CC_CL_DATOS_FACTURACION.ALTA.
            cc_cl_entidad_consumo.modificacion_dato
                                                   (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                    pi_columna                     => 'ID_PERSONA',
                                                    pi_valor                       => v_id_persona,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    pi_fch_efectiva                => v_fch_tran,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        --RQX 4119 BUNDLE FASE 1 (Eliseo Reyes)
        -- tiene paquete bundle ? terminar
        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_paquete_entidad_consumo pec
         WHERE pec.id_entidad_consumo = pi_id_entidad_consumo
           AND pec.fch_tran_fin = utl_verificacion.get_end_date
           AND pec.estado = c_estado_activo;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-2997';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar el bundle

            BEGIN
                SELECT pec.id_paquete
                  INTO v_id_paquete
                  FROM cl_paquete_entidad_consumo pec
                 WHERE pec.id_entidad_consumo = pi_id_entidad_consumo
                   AND pec.fch_tran_fin = utl_verificacion.get_end_date
                   AND pec.estado = c_estado_activo;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_id_paquete    := NULL;
            END;

            IF v_id_paquete IS NOT NULL THEN
                po_cod_err := 'PVT-2998';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al invocar al TX_CL_PAQUETE.BAJA_PAQUETE
                tx_cl_paquete.baja_paquete (pi_id_paquete                  => v_id_paquete,
                                            pi_id_tran                     => v_id_tran,
                                            pi_fch_tran                    => v_fch_tran,
                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                            pi_cod_usuario                 => pi_cod_usuario,
                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            pi_master                      => c_falso,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        --END RQX 4119

        --REGISTRAR EN EL LOG TRANSACCIONAL POSTVENTA
        IF pi_master = c_verdadero THEN
            po_cod_err := 'PVT-2999';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion del tipo de persona.

            BEGIN
                SELECT descripcion
                  INTO v_desc_tipo_persona
                  FROM cnf_catalogo c
                 WHERE c.cod_catalogo = pi_cod_tipo_persona
                   AND estado <> c_estado_inactivo
                   AND c.cod_entidad = 'TIPO_PERSONA'
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_tipo_persona    := NULL;
            END;

            po_cod_err := 'PVT-3000';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion del tipo de documento.

            BEGIN
                SELECT descripcion
                  INTO v_desc_tipo_documento
                  FROM cnf_catalogo c
                 WHERE c.cod_catalogo = pi_cod_tipo_documento
                   AND estado <> c_estado_inactivo
                   AND c.cod_entidad = 'TIPO_DOCUMENTO'
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_tipo_documento    := NULL;
            END;

            po_cod_err := 'PVT-3001';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion de la ciudad.

            BEGIN
                SELECT descripcion
                  INTO v_desc_ciudad_expedida
                  FROM cnf_ciudad c
                 WHERE c.cod_ciudad = pi_cod_ciudad_expedida
                   AND estado <> c_estado_inactivo
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_ciudad_expedida    := NULL;
            END;

            po_cod_err := 'PVT-3002';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion del tipo de direccion.

            BEGIN
                SELECT descripcion
                  INTO v_desc_tipo_direccion
                  FROM cnf_catalogo c
                 WHERE c.cod_catalogo = pi_cod_tipo_direccion
                   AND estado <> c_estado_inactivo
                   AND c.cod_entidad = 'TIPO_DIRECCION'
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_tipo_direccion    := NULL;
            END;

            po_cod_err := 'PVT-3003';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion del tipo de propiedad.

            BEGIN
                SELECT descripcion
                  INTO v_desc_tipo_propiedad
                  FROM cnf_catalogo c
                 WHERE c.cod_catalogo = pi_cod_tipo_propiedad
                   AND estado <> c_estado_inactivo
                   AND c.cod_entidad = 'TIPO_PROPIEDAD'
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_tipo_propiedad    := NULL;
            END;

            po_cod_err := 'PVT-3004';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion de la ciudad.

            BEGIN
                SELECT descripcion
                  INTO v_desc_ciudad
                  FROM cnf_ciudad c
                 WHERE c.cod_ciudad = pi_cod_ciudad
                   AND estado <> c_estado_inactivo
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_ciudad    := NULL;
            END;

            v_trama_nuevo_pv       :=    'cod_tipo_persona:'
                                      || pi_cod_tipo_persona
                                      || '|'
                                      || 'tipo persona:'
                                      || v_desc_tipo_persona
                                      || '|'
                                      || 'nombre:'
                                      || pi_nombre
                                      || '|'
                                      || 'apellido paterno:'
                                      || pi_apellido_paterno
                                      || '|'
                                      || 'apellido materno:'
                                      || pi_apellido_materno
                                      || '|'
                                      || 'cod_tipo_documento:'
                                      || pi_cod_tipo_documento
                                      || '|'
                                      || 'tipo documento:'
                                      || v_desc_tipo_documento
                                      || '|'
                                      || 'nro_documento:'
                                      || pi_nro_documento
                                      || '|'
                                      || 'cod_ciudad_expedida:'
                                      || pi_cod_ciudad_expedida
                                      || '|'
                                      || 'ciudad expedida:'
                                      || v_desc_ciudad_expedida
                                      || '|'
                                      || 'nro doc fiscal:'
                                      || pi_nit
                                      || '|'
                                      || 'cod_tipo_direccion:'
                                      || pi_cod_tipo_direccion
                                      || '|'
                                      || 'tipo direccion:'
                                      || v_desc_tipo_direccion
                                      || '|'
                                      || 'cod_tipo_propiedad:'
                                      || pi_cod_tipo_propiedad
                                      || '|'
                                      || 'tipo propiedad:'
                                      || v_desc_tipo_propiedad
                                      || '|'
                                      || 'zona barrio urb:'
                                      || pi_zona_barrio_urb
                                      || '|'
                                      || 'calle/av/pasaje:'
                                      || pi_calle_av_pasaje
                                      || '|'
                                      || 'entre calle 1:'
                                      || pi_entre_calle_1
                                      || '|'
                                      || 'entre calle 2:'
                                      || pi_entre_calle_2
                                      || '|'
                                      || 'cod_ciudad:'
                                      || pi_cod_ciudad
                                      || '|'
                                      || 'ciudad:'
                                      || v_desc_ciudad
                                      || '|'
                                      || 'edificio:'
                                      || pi_edificio
                                      || '|'
                                      || 'departamento:'
                                      || pi_departamento
                                      || '|'
                                      || 'piso:'
                                      || pi_piso
                                      || '|'
                                      || 'numero:'
                                      || pi_numero
                                      || '|'
                                      || 'subnumero:'
                                      || pi_subnumero
                                      || '|'
                                      || 'desde a?o:'
                                      || pi_desde_ano
                                      || '|'
                                      || 'desde mes:'
                                      || pi_desde_mes
                                      || '|'
                                      || 'observacion:'
                                      || pi_observacion;
            po_cod_err := 'PVT-3005';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion del tipo de persona.

            BEGIN
                SELECT descripcion
                  INTO v_desc_tipo_persona
                  FROM cnf_catalogo c
                 WHERE c.cod_catalogo = v_reg_persona.cod_tipo_persona
                   AND estado <> c_estado_inactivo
                   AND c.cod_entidad = 'TIPO_PERSONA'
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_tipo_persona    := NULL;
            END;

            po_cod_err := 'PVT-3006';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion del tipo de documento.

            BEGIN
                SELECT descripcion
                  INTO v_desc_tipo_documento
                  FROM cnf_catalogo c
                 WHERE c.cod_catalogo = v_reg_persona.cod_tipo_documento
                   AND estado <> c_estado_inactivo
                   AND c.cod_entidad = 'TIPO_DOCUMENTO'
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_tipo_documento    := NULL;
            END;

            po_cod_err := 'PVT-3007';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion de la ciudad.

            BEGIN
                SELECT descripcion
                  INTO v_desc_ciudad_expedida
                  FROM cnf_ciudad c
                 WHERE c.cod_ciudad = v_reg_persona.cod_ciudad_expedida
                   AND estado <> c_estado_inactivo
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_ciudad_expedida    := NULL;
            END;

            po_cod_err := 'PVT-3008';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion del tipo de direccion.

            BEGIN
                SELECT descripcion
                  INTO v_desc_tipo_direccion
                  FROM cnf_catalogo c
                 WHERE c.cod_catalogo = v_reg_direccion.cod_tipo_direccion
                   AND estado <> c_estado_inactivo
                   AND c.cod_entidad = 'TIPO_DIRECCION'
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_tipo_direccion    := NULL;
            END;

            po_cod_err := 'PVT-3009';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion del tipo de propiedad.

            BEGIN
                SELECT descripcion
                  INTO v_desc_tipo_propiedad
                  FROM cnf_catalogo c
                 WHERE c.cod_catalogo = v_reg_direccion.cod_tipo_propiedad
                   AND estado <> c_estado_inactivo
                   AND c.cod_entidad = 'TIPO_PROPIEDAD'
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_tipo_propiedad    := NULL;
            END;

            po_cod_err := 'PVT-3010';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar la descripcion de la ciudad.

            BEGIN
                SELECT descripcion
                  INTO v_desc_ciudad
                  FROM cnf_ciudad c
                 WHERE c.cod_ciudad = v_reg_direccion.cod_ciudad
                   AND estado <> c_estado_inactivo
                   AND c.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    v_desc_ciudad    := NULL;
            END;

            v_trama_anterior_pv    :=    'cod_tipo_persona:'
                                      || v_reg_persona.cod_tipo_persona
                                      || '|'
                                      || 'tipo persona:'
                                      || v_desc_tipo_persona
                                      || '|'
                                      || 'nombre:'
                                      || v_reg_persona.nombre
                                      || '|'
                                      || 'apellido paterno:'
                                      || v_reg_persona.apellido_paterno
                                      || '|'
                                      || 'apellido materno:'
                                      || v_reg_persona.apellido_materno
                                      || '|'
                                      || 'cod_tipo_documento:'
                                      || v_reg_persona.cod_tipo_documento
                                      || '|'
                                      || 'tipo documento:'
                                      || v_desc_tipo_documento
                                      || '|'
                                      || 'nro_documento:'
                                      || v_reg_persona.nro_documento
                                      || '|'
                                      || 'cod_ciudad_expedida:'
                                      || v_reg_persona.cod_ciudad_expedida
                                      || '|'
                                      || 'ciudad expedida:'
                                      || v_desc_ciudad_expedida
                                      || '|'
                                      || 'nro doc fiscal:'
                                      || v_reg_persona.nit
                                      || '|'
                                      || 'cod_tipo_direccion:'
                                      || v_reg_direccion.cod_tipo_direccion
                                      || '|'
                                      || 'tipo direccion:'
                                      || v_desc_tipo_direccion
                                      || '|'
                                      || 'cod_tipo_propiedad:'
                                      || v_reg_direccion.cod_tipo_propiedad
                                      || '|'
                                      || 'tipo propiedad:'
                                      || v_desc_tipo_propiedad
                                      || '|'
                                      || 'zona barrio urb:'
                                      || v_reg_direccion.zona_barrio_urb
                                      || '|'
                                      || 'calle/av/pasaje:'
                                      || v_reg_direccion.calle_av_pasaje
                                      || '|'
                                      || 'entre calle 1:'
                                      || v_reg_direccion.entre_calle_1
                                      || '|'
                                      || 'entre calle 2:'
                                      || v_reg_direccion.entre_calle_2
                                      || '|'
                                      || 'cod_ciudad:'
                                      || v_reg_direccion.cod_ciudad
                                      || '|'
                                      || 'ciudad:'
                                      || v_desc_ciudad
                                      || '|'
                                      || 'edificio:'
                                      || v_reg_direccion.edificio
                                      || '|'
                                      || 'departamento:'
                                      || v_reg_direccion.departamento
                                      || '|'
                                      || 'piso:'
                                      || v_reg_direccion.piso
                                      || '|'
                                      || 'numero:'
                                      || v_reg_direccion.numero
                                      || '|'
                                      || 'subnumero:'
                                      || v_reg_direccion.subnumero
                                      || '|'
                                      || 'desde a?o:'
                                      || v_reg_direccion.desde_ano
                                      || '|'
                                      || 'desde mes:'
                                      || v_reg_direccion.desde_mes
                                      || '|'
                                      || 'observacion:'
                                      || v_reg_direccion.observacion;
            --- Registrar transaccion
            po_cod_err := 'PVT-3011';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
            cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => NULL,
                                   pi_descripcion_observacion     => NULL,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- Reconectar la cuenta si el estado es SS13
        po_cod_err := 'PVT-3012';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al recuperar el servicio especifico de la entidad consumo

        IF v_service_exists = '1' THEN
            po_cod_err := 'PVT-3013';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_DATOS_SUSCRIPTOR: Error al realizar la reconexion del suscriptor.
            tx_pvt_entidad_consumo.reconexion_entidad_consumo
                                                       (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                                        pi_cod_servicio                => 'SS13',
                                                        pi_cod_usuario                 => pi_cod_usuario,
                                                        pi_master                      => c_falso,
                                                        pi_id_tran                     => v_id_tran,
                                                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                        pi_fch_tran                    => v_fch_tran,
                                                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                        po_id_tran                     => v_id_tran,
                                                        po_cod_gestion_tran            => v_cod_gestion_tran,
                                                        po_cod_err                     => po_cod_err,
                                                        po_msj_err                     => po_msj_err
                                                       );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            IF v_reg_entidad_consumo.cod_plan IN ('ANUAL1','PREPAGOTXT','PREPAGO_HD','PREPAGO_MT','PREPAGO_NP','PREPAGO_P','PREPAGO_S',
                                                  'PREPAGO_TU','PREPAGO_V','PREPAG_TU2','PREVIVA_TU','PREPAGO_T')
               AND v_reg_entidad_consumo.cod_tecnologia = 'GSM' THEN


                 tx_prm_base.alta (pi_id_cnf_promocion            => PRM_GET_ID_CNF_PROMOCION('5249'),
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_identificador_entidad       => v_reg_entidad_consumo.identificador_entidad,
                                   pi_id_externo                  => c_falso,
                                   pi_id_tran                     => v_id_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_master                      => c_falso,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

                 IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                 END IF;

                 TX_SMS.alta (pi_origen                      => 'VIVA',
                              pi_destino                     => v_reg_entidad_consumo.identificador_entidad,
                              pi_texto                       => 'Ya validaste tu linea. Ahora recarga y recibiras un bono gratis para hablar dentro y fuera de la red Viva o Larga Distancia.',
                              pi_dlr                         => 1,
                              pi_prioridad                   => c_verdadero,
                              pi_id_tran                     => v_id_tran,
                              pi_fch_tran                    => v_fch_tran,
                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                              pi_cod_usuario                 => pi_cod_usuario,
                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                              pi_master                      => c_falso,
                              po_id_sms                      => v_dummy,
                              po_cod_err                     => po_cod_err,
                              po_msj_err                     => po_msj_err
                             );

                 IF po_msj_err != 'OK' THEN
                     RAISE err_app;
                 END IF;

             END IF;

        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err      := 'OK';
        po_msj_err      := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out     := NULL;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    := NULL;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    := NULL;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END cambio_datos_suscriptor;

    PROCEDURE cambio_tecnologia (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_plan               IN       cl_entidad_consumo.cod_plan%TYPE,
        pi_numero                 IN       cl_entidad_consumo.identificador_entidad%TYPE,
        pi_cod_zona               IN       bm_servicio.cod_servicio%TYPE,
        pi_cod_articulo           IN       cl_articulo_entidad_consumo.cod_articulo%TYPE,
        pi_nro_serie              IN       cl_articulo_entidad_consumo.nro_serie%TYPE,
        pi_cod_motivo_cambio      IN       vta_articulo_prospecto.cod_motivo_cambio%TYPE
                DEFAULT NULL,
        pi_descuento              IN       cl_articulo_entidad_consumo.descuento%TYPE,
        pi_tipo_descuento         IN       VARCHAR2,
        pi_cod_motivo_descuento   IN       cnf_motivo_transaccion.cod_motivo%TYPE,
        pi_puntos_utilizados      IN       pto_entregapunto.cantidad%TYPE,
        pi_cod_articulo_sim       IN       cl_articulo_entidad_consumo.cod_articulo%TYPE,
        pi_nro_serie_sim          IN       cl_articulo_entidad_consumo.nro_serie%TYPE,
        pi_descuento_sim          IN       cl_articulo_entidad_consumo.descuento%TYPE,
        pi_tipo_descuento_sim     IN       VARCHAR2,
        pi_cod_motivo_descuento_sim IN     cnf_motivo_transaccion.cod_motivo%TYPE,
        pi_puntos_utilizados_sim  IN       pto_entregapunto.cantidad%TYPE,
        pi_es_pago_diferido       IN       VARCHAR2,
        pi_id_entidad_venta       IN       vta_venta_entidad.id_venta_entidad%TYPE,
        pi_cod_tipo_cambio_equipo IN       vta_articulo_prospecto.cod_tipo_cambio%TYPE,
        pi_codigo_validacion      IN       vta_codigo_transaccion.codigo%TYPE,
        pi_cod_usuario_asignado   IN       vta_venta_entidad.cod_usuario_asignado%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_prospecto           OUT      vta_cambio_tecnologia.id_prospecto%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_TECNOLOGIA');
        c_separador_doc      CONSTANT VARCHAR2 (50) := ',';
        c_separador_monto    CONSTANT VARCHAR2 (50) := ':';
        c_habili_cambio_tec  CONSTANT cnf_constante.valor%TYPE
                                     := tx_cnf_constante.get_constante ('HABILITAR_CAMBIO_TEC_POR');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.CAMBIO_EQUIPO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimienro
        v_nombre_factura              VARCHAR2 (200);
        v_rnc_factura                 cl_persona.nit%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_monto_total                 vta_venta_prospecto.valor%TYPE;
        v_precio_venta                vta_venta_prospecto.valor%TYPE;
        v_impuestos                   vta_venta_prospecto.valor%TYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_prospecto_art_1          vta_articulo_prospecto.id_prospecto%TYPE;
        v_id_prospecto_art_2          vta_articulo_prospecto.id_prospecto%TYPE;
        v_tipo_cambio                 VARCHAR2 (10);
        v_procedencia_equipo          VARCHAR2 (10);
        v_cod_tipo_almacen            inv_almacen.cod_tipo%TYPE;
        v_id_entidad_venta            inv_almacen.id_entidad_venta%TYPE;
        v_id_venta_entidad            vta_venta_entidad.id_venta_entidad%TYPE;
        v_nueva_tecnologia            cl_entidad_consumo.cod_tecnologia%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_dummy                       PLS_INTEGER;
        v_cod_categoria_documento     bl_dosificacion.cod_categoria_documento%TYPE;
        v_cod_linea_negocio           bm_linea_negocio.cod_linea_negocio%TYPE;
        v_cod_zona                    bm_servicio.cod_servicio%TYPE;
        v_es_devolucion               VARCHAR2(1);
        v_cod_categoria               VARCHAR2(50);
        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_plan:'
            || pi_cod_plan
            || '|'
            || 'pi_numero:'
            || pi_numero
            || '|'
            || 'pi_cod_zona:'
            || pi_cod_zona
            || '|'
            || 'pi_cod_articulo:'
            || pi_cod_articulo
            || '|'
            || 'pi_nro_serie:'
            || pi_nro_serie
            || '|'
            || 'pi_cod_motivo_cambio:'
            || pi_cod_motivo_cambio
            || '|'
            || 'pi_descuento:'
            || pi_descuento
            || '|'
            || 'pi_tipo_descuento:'
            || pi_tipo_descuento
            || '|'
            || 'pi_cod_motivo_descuento:'
            || pi_cod_motivo_descuento
            || '|'
            || 'pi_puntos_utilizados:'
            || pi_puntos_utilizados
            || '|'
            || 'pi_cod_articulo_sim:'
            || pi_cod_articulo_sim
            || '|'
            || 'pi_nro_serie_sim:'
            || pi_nro_serie_sim
            || '|'
            || 'pi_descuento_sim:'
            || pi_descuento_sim
            || '|'
            || 'pi_tipo_descuento_sim:'
            || pi_tipo_descuento_sim
            || '|'
            || 'pi_cod_motivo_descuento_sim:'
            || pi_cod_motivo_descuento_sim
            || '|'
            || 'pi_puntos_utilizados_sim:'
            || pi_puntos_utilizados_sim
            || '|'
            || 'pi_es_pago_diferido:'
            || pi_es_pago_diferido
            || '|'
            || 'pi_id_entidad_venta:'
            || pi_id_entidad_venta
            || '|'
            || 'pi_cod_tipo_cambio_equipo:'
            || pi_cod_tipo_cambio_equipo
            || '|'
            || 'pi_codigo_validacion:'
            || pi_codigo_validacion
            || '|'
            || 'pi_cod_usuario_asignado:'
            || pi_cod_usuario_asignado
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_articulo IS NULL
           OR pi_nro_serie IS NULL
           OR pi_id_entidad_venta IS NULL
           OR pi_cod_usuario_asignado IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-3014';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-3015';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-3016';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR SUSPENDIDA NI DESCONECTADA
        IF suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero AND v_reg_entidad_consumo.cod_tecnologia != 'CDMA' THEN
            po_cod_err := 'PVT-3017';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        --- MVNO
        IF es_entidad_venta_externa (pi_id_entidad_venta) = c_verdadero THEN
            po_cod_err := 'PVT-3018';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA:  Su entidad de venta no puede realizar esta transaccion
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3019';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA:  Error al recuperar la tecnologia de la cuenta

        SELECT cod_linea_negocio
          INTO v_cod_linea_negocio
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        /*
        IF v_cod_linea_negocio = 'EXTERN' THEN
            po_cod_err := 'PVT-3020';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA:  La linea de negocio no puede realizar cambio de tecnologia
            RAISE err_app;
        END IF;
        */

        --- MVNO
        po_cod_err := 'PVT-3021';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al obtener el id del cliente.
        v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

        IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            v_nueva_tecnologia    := c_tecnologia_gsm;
            v_tipo_cambio         := c_tipo_cambio_equipo_gsm;
        ELSE
            v_nueva_tecnologia    := c_tecnologia_cdma;
            v_tipo_cambio         := c_tipo_cambio_equipo_cdma;
        END IF;

        IF     v_nueva_tecnologia = c_tecnologia_cdma
           AND (pi_cod_articulo_sim IS NOT NULL OR pi_nro_serie_sim IS NOT NULL) THEN
            po_cod_err := 'PVT-3022';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Para cambiar a la tecnologia CDMA no debe seleccionar el SIM.
            RAISE err_app;
        ELSIF     v_nueva_tecnologia = c_tecnologia_gsm
              AND (pi_cod_articulo_sim IS NULL OR pi_nro_serie_sim IS NULL) THEN
            po_cod_err := 'PVT-3023';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Para cambiar a la tecnologia GSM debe seleccionar un SIM.
            RAISE err_app;
        END IF;

        IF tiene_orden_diferida (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err := 'PVT-3024';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: La transaccion debe realizarse a fin de ciclo puesto que el suscriptor tiene ordenes diferidas.
            RAISE err_app;
        END IF;

        IF     tx_por_utiles.es_portado (v_reg_entidad_consumo.identificador_entidad) = c_verdadero
           AND c_habili_cambio_tec = c_falso THEN
            po_cod_err := 'PVT-3025';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: El cambio de tecnologia no esta habilitado a numeros portados , por favor contactar a Helpdesk OMEGA
            RAISE err_app;
        END IF;

        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_servicio_entidad_consumo sec, bm_servicio bs
         WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
           AND sec.cod_servicio = bs.cod_servicio
           AND sec.estado = c_estado_activo
           AND v_fch_tran BETWEEN sec.fch_inicio AND sec.fch_fin
           AND bs.cod_tipo_servicio = 'BBDAT';

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-3026';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Para el cambio de tecnologia es necesario desasignar el servicio BLACKBERRY
            RAISE err_app;
        END IF;

        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_servicio_entidad_consumo sec
         WHERE sec.id_entidad_consumo = pi_id_entidad_consumo
           AND sec.estado = c_estado_activo
           AND v_fch_tran BETWEEN sec.fch_inicio AND sec.fch_fin
           AND sec.cod_servicio = 'PIVOZDAT';

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-3027';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Para el cambio de tecnologia es necesario desasignar el servicio Paquetes Ilimitados
            RAISE err_app;
        END IF;

        SELECT COUNT (1)
          INTO v_dummy
          FROM cl_servicio_entidad_consumo sec, cnf_configuracion_especial ce
         WHERE sec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
           AND sec.estado <> c_estado_inactivo
           AND sec.fch_fin = c_fecha_fin
           AND sec.cod_servicio = ce.cod_registro
           AND ce.tipo = 'DATA_ILIMITADO'
           AND ce.parametro_1 = '1'
           AND ce.cod_registro <> 'PIVOZDAT';

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-3028';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Para el cambio de tecnologia es necesario desasignar el servicio Data Ilimitado.
            RAISE err_app;
        END IF;

        IF es_fija (v_reg_entidad_consumo.id_entidad_consumo, 'ENTIDAD_CONSUMO') = c_verdadero THEN
            IF pi_cod_zona IS NULL THEN
                po_cod_err := 'PVT-3029';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Es necesario especificar la zonificacion para lineas fijas
                RAISE err_app;
            END IF;

            IF tx_pvt_ccs.es_zona_fija_valida (pi_cod_zona, v_reg_entidad_consumo.cod_plan,
                                               v_nueva_tecnologia) = c_falso THEN
                po_cod_err := 'PVT-3030';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Codigo de zonificacion no valido
                RAISE err_app;
            END IF;

            v_cod_zona    := pi_cod_zona;
        ELSE
            -- solo deben registrarse zonas para lineas fijas
            v_cod_zona    := NULL;
        END IF;

        --CREACION DEL PROSPECTO PARA EL CAMBIO DE TECNOLOGIA
        po_cod_err := 'PVT-3031';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al invocar al procedimiento de registro del prospecto de cambio de tecnologia.
        cc_vta_cambio_tecnologia.alta
                                     (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                      pi_cod_plan                    => NVL
                                                                            (pi_cod_plan,
                                                                             v_reg_entidad_consumo.cod_plan),
                                      pi_numero                      => NVL
                                                                            (pi_numero,
                                                                             v_reg_entidad_consumo.identificador_entidad),
                                      pi_cod_zona                    => v_cod_zona,
                                      pi_cod_articulo                => pi_cod_articulo,
                                      pi_nro_serie                   => pi_nro_serie,
                                      pi_descuento                   => pi_descuento,
                                      pi_tipo_descuento              => pi_tipo_descuento,
                                      pi_cod_motivo_descuento        => pi_cod_motivo_descuento,
                                      pi_puntos_utilizados           => NVL (pi_puntos_utilizados,
                                                                             0),
                                      pi_cod_articulo_sim            => pi_cod_articulo_sim,
                                      pi_nro_serie_sim               => pi_nro_serie_sim,
                                      pi_descuento_sim               => pi_descuento_sim,
                                      pi_tipo_descuento_sim          => pi_tipo_descuento_sim,
                                      pi_cod_motivo_descuento_sim    => pi_cod_motivo_descuento_sim,
                                      pi_puntos_utilizados_sim       => NVL
                                                                            (pi_puntos_utilizados_sim,
                                                                             0),
                                      pi_es_pago_diferido            => NVL (pi_es_pago_diferido,
                                                                             c_falso),
                                      pi_id_entidad_venta            => pi_id_entidad_venta,
                                      pi_cod_usuario_asignado        => pi_cod_usuario_asignado,
                                      pi_cod_usuario                 => pi_cod_usuario,
                                      pi_id_tran                     => v_id_tran,
                                      pi_cod_gestion_tran            => v_cod_gestion_tran,
                                      pi_fch_tran                    => v_fch_tran,
                                      pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                      po_id_prospecto                => po_id_prospecto,
                                      po_cod_err                     => po_cod_err,
                                      po_msj_err                     => po_msj_err
                                     );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3032';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al registrar la entidad de venta relacionada.
        cc_vta_venta_entidad.alta (pio_id_prospecto               => po_id_prospecto,
                                   pi_cod_tipo_venta              => 'TV_CAMBIO_TECNOLOGIA',
                                   pi_id_entidad_venta            => pi_id_entidad_venta,
                                   pi_cod_usuario_asignado        => pi_cod_usuario_asignado,
                                   pi_cod_usuario_digitador       => pi_cod_usuario,
                                   pi_fch_venta                   => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   po_id_venta_entidad            => v_id_venta_entidad,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3033';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al obtener un id_venta

        SELECT sq_vta_venta_pros.NEXTVAL
          INTO v_id_venta
          FROM DUAL;

          --Si es cambio refurbished setear es_devolucion y cod_categoria
        IF pi_cod_motivo_cambio = 'CSE014' THEN
          v_es_devolucion := '1';
          v_cod_categoria := 'CSDESC';
        ELSE
          v_es_devolucion := '0';
          v_cod_categoria := NULL;
        END IF;

        --ASIGNACION DE EQUIPO
        po_cod_err := 'PVT-3034';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al invocar al procedimiento para la asignacion del equipo.
        tx_pvt_entidad_consumo.cambio_equipo
                                            (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                             pi_tipo_cambio                 => v_tipo_cambio,
                                             pi_cod_articulo                => pi_cod_articulo,
                                             pi_nro_serie                   => pi_nro_serie,
                                             pi_cod_motivo_cambio           => pi_cod_motivo_cambio,
                                             pi_descuento                   => pi_descuento,
                                             pi_tipo_descuento              => pi_tipo_descuento,
                                             pi_cod_motivo_descuento        => pi_cod_motivo_descuento,
                                             pi_es_pago_diferido            => NVL
                                                                                   (pi_es_pago_diferido,
                                                                                    c_falso),
                                             pi_es_devolucion               => v_es_devolucion,
                                             pi_cod_categoria               => v_cod_categoria,
                                             pi_puntos_utilizados           => NVL
                                                                                   (pi_puntos_utilizados,
                                                                                    0),
                                             pi_id_entidad_venta            => pi_id_entidad_venta,
                                             pi_cod_usuario_asignado        => pi_cod_usuario_asignado,
                                             pi_id_prospecto_tec            => po_id_prospecto,
                                             pi_id_venta_tec                => v_id_venta,
                                             pi_id_financiamiento           => NULL,
                                             pi_cod_tipo_cambio_equipo      => pi_cod_tipo_cambio_equipo,
                                             pi_codigo_validacion           => pi_codigo_validacion,
                                             pi_descripcion_falla           => NULL,
                                             pi_cod_usuario                 => pi_cod_usuario,
                                             pi_master                      => c_falso,
                                             pi_id_tran                     => v_id_tran,
                                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                                             pi_fch_tran                    => v_fch_tran,
                                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                             po_id_prospecto_art            => v_id_prospecto_art_2,
                                             po_id_tran                     => po_id_tran,
                                             po_cod_gestion_tran            => po_cod_gestion_tran,
                                             po_cod_err                     => po_cod_err,
                                             po_msj_err                     => po_msj_err
                                            );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --ASIGNACION DE SIM
        IF v_nueva_tecnologia = c_tecnologia_gsm THEN
            po_cod_err := 'PVT-3035';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al invocar al procedimiento para la asignacion del SIM.
            tx_pvt_entidad_consumo.cambio_equipo
                                           (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                            pi_tipo_cambio                 => c_tipo_cambio_sim,
                                            pi_cod_articulo                => pi_cod_articulo_sim,
                                            pi_nro_serie                   => pi_nro_serie_sim,
                                            pi_descuento                   => pi_descuento_sim,
                                            pi_tipo_descuento              => pi_tipo_descuento_sim,
                                            pi_cod_motivo_descuento        => pi_cod_motivo_descuento_sim,
                                            pi_es_pago_diferido            => NVL
                                                                                  (pi_es_pago_diferido,
                                                                                   c_falso),
                                            pi_es_devolucion               => c_falso,
                                            pi_cod_categoria               => NULL,
                                            pi_puntos_utilizados           => NVL
                                                                                  (pi_puntos_utilizados_sim,
                                                                                   0),
                                            pi_id_entidad_venta            => pi_id_entidad_venta,
                                            pi_cod_usuario_asignado        => pi_cod_usuario_asignado,
                                            pi_id_prospecto_tec            => po_id_prospecto,
                                            pi_id_venta_tec                => v_id_venta,
                                            pi_id_financiamiento           => NULL,
                                            pi_cod_tipo_cambio_equipo      => pi_cod_tipo_cambio_equipo,
                                            pi_codigo_validacion           => pi_codigo_validacion,
                                            pi_descripcion_falla           => NULL,
                                            pi_cod_usuario                 => pi_cod_usuario,
                                            pi_master                      => c_falso,
                                            pi_id_tran                     => v_id_tran,
                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                            pi_fch_tran                    => v_fch_tran,
                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            po_id_tran                     => po_id_tran,
                                            po_cod_gestion_tran            => po_cod_gestion_tran,
                                            po_id_prospecto_art            => v_id_prospecto_art_1,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        --CREACION DEL PROSPECTO DE VENTA PARA EL CAMBIO DE TECNOLOGIA
        BEGIN
            po_cod_err := 'PVT-3036';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al recuperar el RNC y nombre a facturar.

            SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                   p.nit
              INTO v_nombre_factura,
                   v_rnc_factura
              FROM cl_persona p, cl_datos_facturacion df
             WHERE df.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
               AND df.id_persona = p.id_persona
               AND df.estado <> c_estado_inactivo
               AND df.fch_fin = c_fecha_fin;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                       p.nit
                  INTO v_nombre_factura,
                       v_rnc_factura
                  FROM cl_persona p, cl_cliente c
                 WHERE c.id_cliente = v_id_cliente AND p.id_persona = c.id_persona;
        END;

        po_cod_err := 'PVT-3037';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al invocar al procedimiento TX_BL_DOSIFICACION.GET_COD_CATEGORIA_DOCUMENTO.
        tx_bl_dosificacion.get_cod_categoria_documento
                                  (pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   po_cod_categoria_documento     => v_cod_categoria_documento,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err);

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3038';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al invocar al procedimiento de registro del prospecto de venta.
        tx_pvt_ccs.alta_venta (pi_id_prospecto                => po_id_prospecto,
                               pi_nombre_factura              => v_nombre_factura,
                               pi_nit                         => v_rnc_factura,
                               pi_cod_categoria_documento     => v_cod_categoria_documento,
                               pi_estado                      => c_estado_activo,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_master                      => c_falso,
                               pi_id_tran                     => v_id_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               po_valor                       => v_monto_total,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        IF     (v_monto_total = 0 OR NVL (pi_es_pago_diferido, c_falso) = c_verdadero)
           AND tx_cl_contrato_activacion.documentos_requeridos (po_id_prospecto) = 0 THEN
            po_cod_err := 'PVT-3039';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA: Error al consolidar la venta.
            tx_int_cliente_caja.consolidar_venta_prospecto
                                                   (pi_id_venta                    => v_id_venta,
                                                    pi_ncf                         => NULL,
                                                    pi_nro_pag_ext                 => NULL,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_master                      => c_falso,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    po_id_tran                     => po_id_tran,
                                                    po_cod_gestion_tran            => po_cod_gestion_tran,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
               'po_id_prospecto'
            || po_id_prospecto
            || '|'
            || 'po_id_tran:'
            || po_id_tran
            || '|'
            || 'po_cod_gestion_tran:'
            || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                   'po_id_prospecto'
                || po_id_prospecto
                || '|'
                || 'po_id_tran:'
                || po_id_tran
                || '|'
                || 'po_cod_gestion_tran:'
                || po_cod_gestion_tran;
            -- Registrar el jog
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                   'po_id_prospecto'
                || po_id_prospecto
                || '|'
                || 'po_id_tran:'
                || po_id_tran
                || '|'
                || 'po_cod_gestion_tran:'
                || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE cambio_tecnologia_consolida (
        -- Input parameters
        pi_id_prospecto           IN       vta_cambio_tecnologia.id_prospecto%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_TECNOLOGIA');
        c_separador_doc      CONSTANT VARCHAR2 (50) := ',';
        c_separador_monto    CONSTANT VARCHAR2 (50) := ':';
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.CAMBIO_EQUIPO';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_cambio_tecnologia       vta_cambio_tecnologia%ROWTYPE;
        v_imsi                        cl_entidad_consumo.imsi%TYPE;
        v_ki                          cl_serial_sim.ki%TYPE;
        v_transport_key               cl_serial_sim.transport_key%TYPE;
        v_cod_plan_vigente            tr_cambio_plan_historico.cod_plan%TYPE;
        v_reg_plan_vigente            bm_plan%ROWTYPE;
        v_esn_hex                     cl_entidad_consumo.imsi%TYPE;
        v_cod_servicio_act            cl_servicio_entidad_consumo.cod_servicio%TYPE;
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_nombre_factura              VARCHAR2 (200);
        v_rnc_factura                 cl_persona.nit%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_monto_total                 vta_venta_prospecto.valor%TYPE;
        v_precio_venta                vta_venta_prospecto.valor%TYPE;
        v_impuestos                   vta_venta_prospecto.valor%TYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_prospecto                vta_articulo_prospecto.id_prospecto%TYPE;
        v_id_prospecto_art_1          vta_articulo_prospecto.id_prospecto%TYPE;
        v_id_prospecto_art_2          vta_articulo_prospecto.id_prospecto%TYPE;
        v_num_fav                     PLS_INTEGER;
        v_lrn                         por_cnf_lrn.lrn%TYPE;
        v_provider_tag                VARCHAR2 (100);

        -- dmm vars
        v_tmp_result                  VARCHAR2(20);

        TYPE array_num IS TABLE OF VARCHAR2 (50);

        v_arr_num                     array_num
                                    := array_num (' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' ',
                                                  ' '
                                                 );
        v_num_del                     VARCHAR2 (50);
        v_num_add                     VARCHAR2 (50);
        v_tipo_cambio                 VARCHAR2 (10);
        v_procedencia_equipo          VARCHAR2 (10);
        v_cod_tipo_almacen            inv_almacen.cod_tipo%TYPE;
        v_id_entidad_venta            inv_almacen.id_entidad_venta%TYPE;
        v_nueva_tecnologia            cl_entidad_consumo.cod_tecnologia%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_desc_plan                   VARCHAR2 (1000);
        v_desc_motivo_descuento       VARCHAR2 (1000);
        v_desc_articulo               VARCHAR2 (1000);
        v_desc_motivo_descuento_sim   VARCHAR2 (1000);
        v_desc_articulo_sim           VARCHAR2 (1000);
        v_min                         cl_numero_telefonico.numero_telefonico%TYPE;
        v_tipo_numero                 cl_numero_telefonico.estado%TYPE;
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_imsi_eir                    cl_articulo_entidad_consumo.nro_serie%TYPE;
        v_imei_eir                    cl_articulo_entidad_consumo.nro_serie%TYPE;
        v_id_orden                    eir_orden.id_orden%TYPE;
        v_cod_proceso                 prt_proceso.cod_proceso%type;
        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_prospecto:'
            || pi_id_prospecto
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_prospecto IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-3040';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-3041';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDAKION: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-3042';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        po_cod_err := 'PVT-3043';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al recuperar el prospecto de cambio de tecnologia.
        SELECT *
          INTO v_reg_cambio_tecnologia
          FROM vta_cambio_tecnologia ct
         WHERE ct.id_prospecto = pi_id_prospecto AND estado = c_estado_activo;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (v_reg_cambio_tecnologia.id_entidad_consumo, v_reg_entidad_consumo,
                                 po_cod_err, po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR SUSPENDIDA NI DESCONECTADA
        IF suscriptor_tiene_suspension (v_reg_cambio_tecnologia.id_entidad_consumo) = c_verdadero AND v_reg_entidad_consumo.cod_tecnologia != c_tecnologia_cdma THEN
            po_cod_err := 'PVT-3044';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: El suscriptor esta suspendido.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3045';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al obtener el id del cliente.
        v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

        IF v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma THEN
            v_nueva_tecnologia    := c_tecnologia_gsm;
            v_tipo_cambio         := 'GSM';
        ELSE
            v_nueva_tecnologia    := c_tecnologia_cdma;
            v_tipo_cambio         := 'CDMA';
            po_cod_err := 'PVT-3046';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al determinar el hexadecimal del serial.
            v_esn_hex             :=
                                 tx_cl_serial_robado.dec_to_hex (v_reg_cambio_tecnologia.nro_serie);
        END IF;

        --MODIFICACION DEL ATRIBUTO COD_TECNOLOGIA PARA LUEGO PROVISIONAR CON ESTA NUEVA TECNOLOGIA
        po_cod_err := 'PVT-3047';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al modificar la tecnologia del suscriptor.
        cc_cl_entidad_consumo.modificacion_dato
                               (pi_id_entidad_consumo          => v_reg_cambio_tecnologia.id_entidad_consumo,
                                pi_columna                     => 'COD_TECNOLOGIA',
                                pi_valor                       => v_nueva_tecnologia,
                                pi_cod_usuario                 => pi_cod_usuario,
                                pi_id_tran                     => v_id_tran,
                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                pi_fch_tran                    => v_fch_tran,
                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                pi_fch_efectiva                => v_fch_tran,
                                po_cod_err                     => po_cod_err,
                                po_msj_err                     => po_msj_err
                               );
        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3048';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al recuperar los datos del plan.

        SELECT *
          INTO v_reg_plan_vigente
          FROM bm_plan p
         WHERE p.cod_plan = NVL (v_reg_cambio_tecnologia.cod_plan, v_reg_entidad_consumo.cod_plan);   --v_cod_plan_vigente;

        po_cod_err := 'PVT-3049';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al determinar la linea de negocio del suscriptor.

        SELECT c.cod_linea_negocio
          INTO v_cod_linea_negocio
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        po_cod_err := 'PVT-3050';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al determinar el tipo de suscriptor.
        v_tipo_numero          := get_tipo_numero (v_reg_entidad_consumo.identificador_entidad);

        --Si el numero anterior es PORTIN
        IF v_tipo_numero = c_tipo_numero_portin THEN
            --GSM-CDMA, seleccionar un numero para el MIN estado = 'A', estado_numero = '1' y cambiara a estado_numero = '2'
            IF     v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_gsm
               AND v_nueva_tecnologia = c_tecnologia_cdma THEN
                IF v_reg_cambio_tecnologia.numero = v_reg_entidad_consumo.identificador_entidad THEN
                    po_cod_err := 'PVT-3051';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al buscar un MIN para el suscriptor.
                    v_min         := get_min (v_reg_entidad_consumo.cod_plan);
                    po_cod_err := 'PVT-3052';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al reservar el MIN.
                    cc_cl_numero_telefonico.cambiar_estado
                                              (pi_numero                      => v_min,
                                               pi_estado                      => c_tipo_numero_min,
                                               pi_estado_numero               => c_estado_telefono_activo,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_master                      => c_falso,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio_tran     => pi_cod_unidad_negocio,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                    IF (po_cod_err <> 'OK') THEN
                        RAISE err_app;
                    END IF;

                    po_cod_err := 'PVT-3053';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al asignar el MIN al suscriptor.
                    cc_cl_entidad_consumo_afin.asignar
                               (pi_id_entidad_consumo          => v_reg_cambio_tecnologia.id_entidad_consumo,
                                pi_identificador_entidad       => v_reg_cambio_tecnologia.numero,
                                pi_id_entidad_consumo_afin     => NULL,
                                pi_identificador_entidad_afin  => v_min,
                                pi_cod_tipo_afinidad           => 'TAMIN',
                                pi_cod_servicio                => NULL,
                                pi_faf_id                      => 0,
                                pi_id_proc_ems                 => NULL,
                                pi_id_orig_proc_ems            => NULL,
                                pi_id_form_ems                 => NULL,
                                pi_id_orig_form_ems            => NULL,
                                pi_id_tarifa                   => NULL,
                                pi_cod_carrier                 => NULL,
                                pi_cod_usuario                 => pi_cod_usuario,
                                pi_id_tran                     => v_id_tran,
                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                pi_fch_tran                    => v_fch_tran,
                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                pi_fch_efectiva                => v_fch_tran,
                                po_cod_err                     => po_cod_err,
                                po_msj_err                     => po_msj_err
                               );

                    IF (po_cod_err <> 'OK') THEN
                        RAISE err_app;
                    END IF;
                END IF;
            --CDMA-GSM, liberar el numero MIN cambiando su estado a '1'
            ELSIF     v_reg_entidad_consumo.cod_tecnologia = c_tecnologia_cdma
                  AND v_nueva_tecnologia = c_tecnologia_gsm THEN
                po_cod_err := 'PVT-3054';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al determinar el MIN del suscriptor.
                v_min         := get_min_suscriptor (v_reg_cambio_tecnologia.id_entidad_consumo);
                po_cod_err := 'PVT-3055';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al liberar el MIN.
                cc_cl_numero_telefonico.cambiar_estado
                                              (pi_numero                      => v_min,
                                               pi_estado                      => c_tipo_numero_viva,
                                               pi_estado_numero               => c_estado_telefono_disponible,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_master                      => c_falso,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio_tran     => pi_cod_unidad_negocio,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-3056';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al desasignar el MIN.
                cc_cl_entidad_consumo_afin.desasignar
                               (pi_id_entidad_consumo          => v_reg_cambio_tecnologia.id_entidad_consumo,
                                pi_identificador_entidad_afin  => v_min,
                                pi_cod_tipo_afinidad           => 'TAMIN',
                                pi_cod_usuario                 => pi_cod_usuario,
                                pi_id_tran                     => v_id_tran,
                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                pi_fch_tran                    => v_fch_tran,
                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                pi_fch_efectiva                => v_fch_tran,
                                po_cod_err                     => po_cod_err,
                                po_msj_err                     => po_msj_err
                               );

                IF (po_cod_err <> 'OK') THEN
                    RAISE err_app;
                END IF;
            END IF;
        END IF;

        IF v_min IS NULL THEN
            v_min    := v_reg_cambio_tecnologia.numero;
        END IF;

        po_cod_err := 'PVT-3057';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al recuperar el LRN
        v_lrn                  :=
            tx_por_utiles.get_lrn_asignado (v_reg_entidad_consumo.identificador_entidad,
                                            v_nueva_tecnologia);
        po_cod_err := 'PVT-3058';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al validar si se trata de un numero portado o no

        IF tx_por_utiles.es_portado (v_reg_entidad_consumo.identificador_entidad) = c_verdadero THEN
            v_provider_tag    := 'SCP:' || c_prestador_propio;
        ELSE
            v_provider_tag    := 'OMEGA';
        END IF;
        --PROVISIONAR LA ELIMINACION DEL SUSCRIPTOR DE UNO DE LOS DISPOSITIVOS
        IF v_nueva_tecnologia = c_tecnologia_gsm THEN
            po_cod_err := 'PVT-3059';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al obtener los datos del SIM.

            SELECT ss.ki,
                   ss.transport_key,
                   ss.imsi
              INTO v_ki,
                   v_transport_key,
                   v_imsi
              FROM cl_serial_sim ss
             WHERE ss.icc LIKE v_reg_cambio_tecnologia.nro_serie_sim || '%';

            po_cod_err := 'PVT-3060';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al provisionar el cambio de tecnologia.
            tx_cl_orden_prv.alta (pi_id_action                   => '226',   -- C1 OK
                                  pi_cod_transaccion             => c_tipo_transaccion,
                                  pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                  pi_sub_operacion               => c_tipo_operacion_add,
                                  pi_fch_programada              => v_fch_tran,
                                  pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                                  pi_p2                          => v_ki,
                                  pi_p3                          => v_imsi,
                                  pi_p4                          => v_transport_key,
                                  pi_p5                          => v_min,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_orden                    => v_id_orden,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            -- 2017-01-18 GAC-Ericsson - No enviar ordenes cuando el flag ERS_PORTABILIDAD sea 1 - INICIO
            --IF (tx_cnf_constante.get_constante('ERS_PORTABILIDAD')='0') THEN
            --- CAMBIO_TECNOLOGIA_CONSOLIDA: ALTA DEL NUMERO EN LA TABLA DE NUMEROS PORTADOS...
            DECLARE
                v_id_orden                    NUMBER;
                v_cod_err                     VARCHAR2 (200);
                v_msj_err                     VARCHAR2 (200);
            BEGIN
                cc_ord_numero_portado_gsm.alta
                    (pi_numero                      => v_reg_entidad_consumo.identificador_entidad,
                     pi_lrn                         => v_lrn,
                     pi_provider_tag                => v_provider_tag,
                     pi_accion                      => 'ADD',
                     pi_cod_usuario                 => pi_cod_usuario,
                     pi_id_tran                     => v_id_tran,
                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                     pi_fch_tran                    => v_fch_tran,
                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                     pi_comentario                  =>    'TX_PVT_ENTIDAD_COMSUMO.CAMBIO_TECNOLOGIA_CONSOLIDA pi_id_prospecto=>'
                                                       || pi_id_prospecto,
                     po_id_orden                    => v_id_orden,
                     po_cod_err                     => v_cod_err,
                     po_msj_err                     => v_msj_err
                    );

                IF (v_cod_err <> 'OK') THEN
                    po_cod_err    := v_cod_err;
                    po_msj_err    :=    'CAMBIO_TECNOLOGIA_CONSOLIDA: No su pudo dar de alta '
                                     || v_reg_entidad_consumo.identificador_entidad
                                     || ', en la tabla de numeros portados '
                                     || v_msj_err;
                    RAISE err_app;
                END IF;
            END;
            --END IF;
            -- 2017-01-18 GAC-Ericsson - No enviar ordenes cuando el flag ERS_PORTABILIDAD sea 1 - FIN

            IF v_reg_plan_vigente.c1_offer_id IS NOT NULL THEN
                po_cod_err := 'PVT-3061';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al provisionar el feature para prepagos.
                tx_cl_orden_prv.alta   -- C1 OK
                                (pi_id_action                   => '227',
                                 pi_cod_transaccion             => c_tipo_transaccion,
                                 pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_sub_operacion               => c_tipo_operacion_add,
                                 pi_fch_programada              => v_fch_tran,
                                 pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_id_orden                    => v_id_orden,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;
----------------------------------------------------------------------------------------------------------------
        ELSIF v_nueva_tecnologia = c_tecnologia_cdma THEN

            po_cod_err := 'PVT-3062';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al determinar el servicio de activacion.

            SELECT sec.cod_servicio
              INTO v_cod_servicio_act
              FROM cl_servicio_entidad_consumo sec, bm_servicio s
             WHERE sec.id_entidad_consumo = v_reg_cambio_tecnologia.id_entidad_consumo
               AND sec.cod_servicio = s.cod_servicio
               AND sec.estado <> c_estado_inactivo
               AND sec.fch_fin = c_fecha_fin
               AND s.cod_tipo_servicio = c_tipo_serv_paquete;

            IF v_cod_servicio_act = 'APREP' THEN
                v_id_accion_prv_ext    := 242;
            ELSIF v_cod_servicio_act = 'APOST' THEN
                v_id_accion_prv_ext    := 246;
            ELSIF v_cod_servicio_act = 'AFULL' THEN
                v_id_accion_prv_ext    := 251;
            ELSIF v_cod_servicio_act = 'AFULLA' THEN
                v_id_accion_prv_ext    := 264;
            ELSIF v_cod_servicio_act = 'APREPC' THEN
                v_id_accion_prv_ext    := 265;
            ELSIF v_cod_servicio_act = 'AFULLH' THEN
                v_id_accion_prv_ext    := 270;
            ELSIF v_cod_servicio_act = 'APREPI' THEN
                v_id_accion_prv_ext    := 274;
            ELSIF v_cod_servicio_act = 'APREPA' THEN
                v_id_accion_prv_ext    := 290;
            ELSIF v_cod_servicio_act = 'APREE' THEN
                v_id_accion_prv_ext    := 360;
            ELSE
                po_cod_err := 'PVT-3063';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: No implementado.
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-3064';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al recuperar el rango del customer_group

            IF tx_por_utiles.get_customer_group_rango (v_reg_entidad_consumo.identificador_entidad) IS NOT NULL THEN
                v_reg_plan_vigente.customer_group    :=
                    tx_por_utiles.get_customer_group_rango
                                                       (v_reg_entidad_consumo.identificador_entidad);
            END IF;

            po_cod_err := 'PVT-3065';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al provisionar el cambio de tecnologia.
            tx_cl_orden_prv.alta (pi_id_action                   => v_id_accion_prv_ext,   -- C1 OK
                                  pi_cod_transaccion             => c_tipo_transaccion,
                                  pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                  pi_sub_operacion               => c_tipo_operacion_add,
                                  pi_fch_programada              => v_fch_tran,
                                  pi_p1                          => v_reg_entidad_consumo.identificador_entidad,
                                  pi_p2                          => v_min,
                                  pi_p3                          => v_reg_cambio_tecnologia.nro_serie,
                                  pi_p5                          => v_reg_plan_vigente.customer_group,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_orden                    => v_id_orden,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            -- 2017-01-18 GAC-Ericsson - No enviar ordenes cuando el flag ERS_PORTABILIDAD sea 1 - INICIO
            --IF (tx_cnf_constante.get_constante('ERS_PORTABILIDAD')='0') THEN
            --- CAMBIO_TECNOLOGIA_CONSOLIDA: BAJA DEL NUMERO EN LA TABLA DE NUMEROS PORTADOS...
            DECLARE
                v_id_orden                    NUMBER;
                v_cod_err                     VARCHAR2 (200);
                v_msj_err                     VARCHAR2 (200);
            BEGIN
                cc_ord_numero_portado_gsm.alta
                    (pi_numero                      => v_reg_entidad_consumo.identificador_entidad,
                     pi_lrn                         => NULL,
                     pi_provider_tag                => NULL,
                     pi_accion                      => 'DEL',
                     pi_cod_usuario                 => pi_cod_usuario,
                     pi_id_tran                     => v_id_tran,
                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                     pi_fch_tran                    => v_fch_tran,
                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                     pi_comentario                  =>    'TX_PVT_ENTIDAD_COMSUMO.CAMBIO_TECNOLOGIA_CONSOLIDA (baja por gsm->cdma) pi_id_prospecto=>'
                                                       || pi_id_prospecto,
                     po_id_orden                    => v_id_orden,
                     po_cod_err                     => v_cod_err,
                     po_msj_err                     => v_msj_err
                    );

                IF (v_cod_err <> 'OK') THEN
                    po_cod_err    := v_cod_err;
                    po_msj_err    :=    'CAMBIO_TECNOLOGIA_CONSOLIDA: No su pudo dar de alta '
                                     || v_reg_entidad_consumo.identificador_entidad
                                     || ', en la tabla de numeros portados '
                                     || v_msj_err;
                    RAISE err_app;
                END IF;
            END;

            IF v_lrn IS NOT NULL THEN
                --- CAMBIO_TECNOLOGIA_CONSOLIDA: ALTA DEL NUMERO EN LA TABLA DE NUMEROS PORTADOS...
                DECLARE
                    v_id_orden                    NUMBER;
                    v_cod_err                     VARCHAR2 (200);
                    v_msj_err                     VARCHAR2 (200);
                BEGIN
                    cc_ord_numero_portado_gsm.alta
                        (pi_numero                      => v_reg_entidad_consumo.identificador_entidad,
                         pi_lrn                         => v_lrn,
                         pi_provider_tag                => v_provider_tag,
                         pi_accion                      => 'ADD',
                         pi_cod_usuario                 => pi_cod_usuario,
                         pi_id_tran                     => v_id_tran,
                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                         pi_fch_tran                    => v_fch_tran,
                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                         pi_comentario                  =>    'TX_PVT_ENTIDAD_COMSUMO.CAMBIO_TECNOLOGIA_CONSOLIDA pi_id_prospecto=>'
                                                           || pi_id_prospecto,
                         po_id_orden                    => v_id_orden,
                         po_cod_err                     => v_cod_err,
                         po_msj_err                     => v_msj_err
                        );

                    IF (v_cod_err <> 'OK') THEN
                        po_cod_err    := v_cod_err;
                        po_msj_err    :=    'CAMBIO_TECNOLOGIA_CONSOLIDA: No su pudo dar de alta '
                                         || v_reg_entidad_consumo.identificador_entidad
                                         || ', en la tabla de numeros portados '
                                         || v_msj_err;
                        RAISE err_app;
                    END IF;
                END;
            END IF;
            --END IF;
            -- 2017-01-18 GAC-Ericsson - No enviar ordenes cuando el flag ERS_PORTABILIDAD sea 1 - FIN
        END IF;

        --DESASIGNACION DE LOS ARTICULOS
--        FOR curarticulos IN (SELECT aec.id_registro
--                               FROM cl_articulo_entidad_consumo aec
--                              WHERE aec.id_entidad_consumo =
--                                                          v_reg_cambio_tecnologia.id_entidad_consumo
--                                AND aec.cod_rubro_articulo IN ('TACDMA', 'TAGSM', 'TASIM')
--                                AND aec.estado <> c_estado_inactivo
--                                AND aec.fch_fin = c_fecha_fin)
--        LOOP
--            po_cod_err    := 'PVT-0940';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al desasignar el articulo del suscriptor.
--            cc_cl_articulo_entidad_consumo.desasignar
--                              (pi_id_entidad_consumo          => v_reg_cambio_tecnologia.id_entidad_consumo,
--                               pi_id_registro                 => curarticulos.id_registro,
--                               pi_cod_usuario                 => pi_cod_usuario,
--                               pi_id_tran                     => v_id_tran,
--                               pi_cod_gestion_tran            => v_cod_gestion_tran,
--                               pi_fch_tran                    => v_fch_tran,
--                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
--                               pi_fch_efectiva                => v_fch_tran,
--                               po_cod_err                     => po_cod_err,
--                               po_msj_err                     => po_msj_err
--                              );
--
--            IF (po_cod_err <> 'OK') THEN
--                RAISE err_app;
--            END IF;
--        END LOOP;

        --CONSOLIDACION DE LOS PROSPECTOS DE ARTICULOS
        FOR curarticulos IN (SELECT *
                               FROM vta_articulo_prospecto ap
                              WHERE ap.id_prospecto_cambio_tec = pi_id_prospecto
                                AND ap.estado = c_estado_activo)
        LOOP
            po_cod_err := 'PVT-3066';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al consolidar la asignacion de articulos al suscriptor.
            tx_pvt_entidad_consumo.cambio_equipo_consolidacion
                                                   (pi_id_prospecto                => curarticulos.id_prospecto,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_master                      => c_falso,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    po_id_tran                     => po_id_tran,
                                                    po_cod_gestion_tran            => po_cod_gestion_tran,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END LOOP;

        -- RQX 3288: Vinculacion SIM CARD y Equipo Fijo GSM
        IF (es_fija (v_cod_plan_vigente) = '1' AND v_nueva_tecnologia = 'GSM') THEN
            SELECT aec.nro_serie
              INTO v_imei_eir
              FROM cl_articulo_entidad_consumo aec
             WHERE aec.id_entidad_consumo = v_reg_cambio_tecnologia.id_entidad_consumo
               AND aec.cod_rubro_articulo IN ('TAGSM')
               AND aec.estado = c_estado_activo
               AND aec.fch_fin = c_fecha_fin;

            SELECT ih.imsi
              INTO v_imsi_eir
              FROM tr_imsi_historico ih
             WHERE ih.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND ih.fch_fin = c_fecha_fin;

            po_cod_err := 'PVT-3067';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_EQUIPO_CONSOLIDACION: Error al enviar la orden al EIR.
            tx_eir_orden.alta (pi_cod_accion                  => 'ADD_PL',
                               pi_imei                        => v_imei_eir,
                               pi_imsi                        => v_imsi_eir,
                               pi_id_entidad_consumo          => v_reg_cambio_tecnologia.id_entidad_consumo,
                               pi_operadora                   => '400',
                               pi_id_tran                     => v_id_tran,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               pi_master                      => c_falso,
                               po_id_orden                    => v_id_orden,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- FIN RQX 3288

        --PROVISIONAR LA ADICION DEL SUSCRIPTOR EN EL DISPOSITIVO CORRESPONDIENTE
        IF v_reg_entidad_consumo.identificador_entidad <> v_reg_cambio_tecnologia.numero THEN
            po_cod_err := 'PVT-3068';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al cambiar el numero del suscriptor.
            tx_pvt_entidad_consumo.cambio_numero
                              (pi_id_entidad_consumo          => v_reg_cambio_tecnologia.id_entidad_consumo,
                               pi_identificador_entidad       => v_reg_cambio_tecnologia.numero,
                               pi_cod_usuario                 => pi_cod_usuario,
                               pi_master                      => c_falso,
                               pi_id_tran                     => v_id_tran,
                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                               pi_fch_tran                    => v_fch_tran,
                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                               po_id_tran                     => po_id_tran,
                               po_cod_gestion_tran            => po_cod_gestion_tran,
                               po_cod_err                     => po_cod_err,
                               po_msj_err                     => po_msj_err
                              );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        --PROVISIONAR LOS SERVICIOS EN CAMBIO DE TECNOLOGIA
        po_cod_err := 'PVT-3069';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al determinar los servicios a provisionar.

        FOR casig IN (SELECT sec.cod_servicio
                        FROM cl_servicio_entidad_consumo sec, bm_servicio s, bm_plan_servicio ps
                       WHERE sec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                         AND sec.cod_servicio = s.cod_servicio
                         AND s.se_provisiona = c_verdadero
                         AND s.cod_tipo_servicio = c_tipo_serv_basico
                         AND sec.cod_servicio = ps.cod_servicio
                         AND ps.cod_plan = v_reg_plan_vigente.cod_plan
                         AND sec.estado <> c_estado_inactivo
                         AND sec.fch_fin = c_fecha_fin
                         AND ps.estado <> c_estado_inactivo
                         AND ps.fch_fin = c_fecha_fin
                      UNION
                      SELECT sp.cod_servicio
                        FROM bm_plan_servicio ps,
                             bm_servicio s,
                             bm_servicio_paquete sp,
                             bm_servicio ser
                       WHERE v_nueva_tecnologia = c_tecnologia_gsm
                         AND ps.cod_plan = v_reg_plan_vigente.cod_plan
                         AND ps.cod_servicio = s.cod_servicio
                         AND s.cod_tipo_servicio = c_tipo_serv_paquete
                         AND s.cod_servicio = sp.cod_servicio_paquete
                         AND sp.cod_servicio = ser.cod_servicio
                         AND ser.se_provisiona = c_verdadero
                         AND ps.estado <> c_estado_inactivo
                         AND ps.fch_fin = c_fecha_fin
                         AND sp.estado <> c_estado_inactivo
                         AND sp.fch_fin = c_fecha_fin)
        LOOP
            IF casig.cod_servicio = 'MS40' THEN
                IF v_nueva_tecnologia = c_tecnologia_gsm THEN
                    v_id_accion_prv_ext    := 243;
                ELSE
                    v_id_accion_prv_ext    := 245;
                END IF;
            ELSE
                po_cod_err := 'PVT-3070';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al obtener la accion de adicion de servicio a provisionar.
                v_id_accion_prv_ext    := get_accion_prv (casig.cod_servicio, v_nueva_tecnologia,
                                                          v_reg_plan_vigente.cod_forma_consumo);
            END IF;

            po_cod_err := 'PVT-3071';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al provisionar un servicio.
            tx_cl_orden_prv.alta (pi_id_action                   => v_id_accion_prv_ext,   --C1 OK
                                  pi_cod_transaccion             => c_tipo_transaccion,
                                  pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                  pi_sub_operacion               => c_tipo_operacion_add,
                                  pi_fch_programada              => v_fch_tran,
                                  pi_p1                          => v_reg_cambio_tecnologia.numero,
                                  pi_p3                          => v_esn_hex,
                                  pi_p6                          => casig.cod_servicio,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_orden                    => v_id_orden,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END LOOP;

        --PROVISIONAR LOS NUMEROS FAVORITOS
        v_num_fav              := 0;
        IF v_reg_plan_vigente.cod_forma_consumo <> c_forma_consumo_postpago THEN
            po_cod_err := 'PVT-3072';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al determinar la accion a provisionar.
            v_id_accion_prv_ext    := get_accion_prv ('NUMFAV', v_nueva_tecnologia,
                                                      v_reg_plan_vigente.cod_forma_consumo);

            FOR curafinesactual IN
                (SELECT eca.identificador_entidad_afin numero,
                          parametro_8
                        - 1
                        + ROW_NUMBER () OVER (PARTITION BY cod_tipo_afinidad ORDER BY eca.identificador_entidad_afin)
                                                                                           posicion
                   FROM cl_servicio_entidad_consumo sec,
                        cnf_configuracion_especial ce,
                        cl_entidad_consumo_afin eca
                  WHERE sec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                    AND sec.estado <> c_estado_inactivo
                    AND sec.fch_fin = c_fecha_fin
                    AND eca.id_entidad_consumo = sec.id_entidad_consumo
                    AND eca.estado <> c_estado_inactivo
                    AND eca.fch_fin = c_fecha_fin
                    AND ce.parametro_1 = eca.cod_tipo_afinidad
                    AND ce.cod_registro = sec.cod_servicio
                    AND ce.tipo = 'NUMEROS_FAVORITOS'
                    AND ce.parametro_5 = c_verdadero)
            LOOP
                po_cod_err := 'PVT-3073';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al actualizar los numeros favoritos del suscriptor.

                --SI EL NUMERO ES GSM ANTEPONER EL 1 A LOS NUMEROS FAVORITOS DE REPUBLICA DOMINICANA
                IF     v_nueva_tecnologia = c_tecnologia_gsm
                   AND (   curafinesactual.numero LIKE '809%'
                        OR curafinesactual.numero LIKE '829%'
                        OR curafinesactual.numero LIKE '849%'
                       ) THEN
                    v_num_del    := curafinesactual.numero;
                    v_num_add    := '1' || curafinesactual.numero;
                ELSE
                    v_num_del    := '1' || curafinesactual.numero;
                    v_num_add    := curafinesactual.numero;
                END IF;

                po_cod_err := 'PVT-3074';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al provisionar los numeros favoritos.
                tx_cl_orden_prv.alta   -- C1 OK
                                 (pi_id_action                   => v_id_accion_prv_ext,
                                  pi_cod_transaccion             => c_tipo_transaccion,
                                  pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                  pi_sub_operacion               => c_tipo_operacion_del,
                                  pi_fch_programada              => v_fch_tran,
                                  pi_p1                          => v_reg_cambio_tecnologia.numero,
                                  pi_p2                          => v_num_del,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_orden                    => v_id_orden,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-3075';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al provisionar los numeros favoritos.
                tx_cl_orden_prv.alta   -- C1 OK
                                 (pi_id_action                   => v_id_accion_prv_ext,
                                  pi_cod_transaccion             => c_tipo_transaccion,
                                  pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                  pi_sub_operacion               => c_tipo_operacion_add,
                                  pi_fch_programada              => v_fch_tran,
                                  pi_p1                          => v_reg_cambio_tecnologia.numero,
                                  pi_p2                          => v_num_add,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_orden                    => v_id_orden,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END LOOP;
        END IF;

        --ENVIAR ORDENES AL PRV
        po_cod_err := 'PVT-3076';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al enviar las ordenes al PRV.
        tx_cl_orden_prv.procesar (pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        -- zonificacion para lineas fijas
        -- NOTA: Se llama despues de tx_cl_orden_prv.procesar por que asignar_zona_full_hogar llama directamente a
        --       prv_dispatcher, necesitamos que las ordenes de zonificacion se envien al final
        IF es_fija (v_reg_entidad_consumo.id_entidad_consumo, 'ENTIDAD_CONSUMO') = c_verdadero THEN
            po_cod_err := 'PVT-3077';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al asignar zona
            tx_pvt_entidad_consumo.asignar_zona_full_hogar
                                (pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_cod_servicio                => v_reg_cambio_tecnologia.cod_zona,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_master                      => c_falso,
                                 pi_id_tran                     => v_id_tran,
                                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                                 pi_fch_tran                    => v_fch_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 po_id_tran                     => v_id_tran,
                                 po_cod_gestion_tran            => v_cod_gestion_tran,
                                 po_cod_err                     => po_cod_err,
                                 po_msj_err                     => po_msj_err
                                );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;

        -- END zonificacion para lineas fijas
        po_cod_err := 'PVT-3078';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al cambiar el estado del prospecto de cambio de tecnologia.
        cc_vta_cambio_tecnologia.cambia_estado (pi_id_prospecto                => pi_id_prospecto,
                                                pi_estado                      => c_estado_pagado,
                                                pi_cod_usuario                 => pi_cod_usuario,
                                                pi_id_tran                     => v_id_tran,
                                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                pi_fch_tran                    => v_fch_tran,
                                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                po_cod_err                     => po_cod_err,
                                                po_msj_err                     => po_msj_err
                                               );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;
        po_cod_err := 'PVT-3079';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al recuperar la descripcion del plan.

        SELECT descripcion
          INTO v_desc_plan
          FROM bm_plan p
         WHERE p.cod_plan = v_reg_cambio_tecnologia.cod_plan;

        IF v_reg_cambio_tecnologia.cod_articulo IS NOT NULL THEN
            po_cod_err := 'PVT-3080';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al recuperar la descripcion del articulo.

            SELECT descripcion
              INTO v_desc_articulo
              FROM inv_articulo a
             WHERE a.cod_articulo = v_reg_cambio_tecnologia.cod_articulo;
        END IF;

        IF v_reg_cambio_tecnologia.cod_motivo_descuento IS NOT NULL THEN
            po_cod_err := 'PVT-3081';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al recuperar el motivo del descuento.

            SELECT descripcion
              INTO v_desc_motivo_descuento
              FROM cnf_motivo_transaccion a
             WHERE a.cod_motivo = v_reg_cambio_tecnologia.cod_motivo_descuento;
        END IF;

        IF v_reg_cambio_tecnologia.cod_articulo_sim IS NOT NULL THEN
            po_cod_err := 'PVT-3082';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al recuperar la descripcion del sim.

            SELECT descripcion
              INTO v_desc_articulo_sim
              FROM inv_articulo a
             WHERE a.cod_articulo = v_reg_cambio_tecnologia.cod_articulo_sim;
        END IF;

        IF v_reg_cambio_tecnologia.cod_motivo_descuento_sim IS NOT NULL THEN
            po_cod_err := 'PVT-3083';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al recuperar el motivo de descuento.

            SELECT descripcion
              INTO v_desc_motivo_descuento_sim
              FROM cnf_motivo_transaccion a
             WHERE a.cod_motivo = v_reg_cambio_tecnologia.cod_motivo_descuento_sim;
        END IF;

        po_cod_err := 'PVT-3084';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al formar los nuevos datos de la transaccion.
        v_trama_nuevo_pv       :=    'Cod. plan:'
                                  || v_reg_cambio_tecnologia.cod_plan
                                  || '|'
                                  || 'Plan:'
                                  || v_desc_plan
                                  || '|'
                                  || 'Numero:'
                                  || v_reg_cambio_tecnologia.numero
                                  || '|'
                                  || 'Cod. Articulo:'
                                  || v_reg_cambio_tecnologia.cod_articulo
                                  || '|'
                                  || 'Articulo:'
                                  || v_desc_articulo
                                  || '|'
                                  || 'Nro Serie:'
                                  || v_reg_cambio_tecnologia.nro_serie
                                  || '|'
                                  || 'Descuento:'
                                  || v_reg_cambio_tecnologia.descuento
                                  || '|'
                                  || 'Tipo descuento:'
                                  || v_reg_cambio_tecnologia.tipo_descuento
                                  || '|'
                                  || 'Cod Motivo descuento:'
                                  || v_reg_cambio_tecnologia.cod_motivo_descuento
                                  || '|'
                                  || 'Motivo descuento:'
                                  || v_desc_motivo_descuento
                                  || '|'
                                  || 'Puntos bonificacion:'
                                  || v_reg_cambio_tecnologia.puntos_utilizados
                                  || '|'
                                  || 'Cod articulo SIM:'
                                  || v_reg_cambio_tecnologia.cod_articulo_sim
                                  || '|'
                                  || 'Articulo SIM:'
                                  || v_desc_articulo_sim
                                  || '|'
                                  || 'Nro SIM:'
                                  || v_reg_cambio_tecnologia.nro_serie_sim
                                  || '|'
                                  || 'Descuento SIM:'
                                  || v_reg_cambio_tecnologia.descuento_sim
                                  || '|'
                                  || 'Tipo descuento SIM:'
                                  || v_reg_cambio_tecnologia.tipo_descuento_sim
                                  || '|'
                                  || 'Cod Motivo descuento SIM:'
                                  || v_reg_cambio_tecnologia.cod_motivo_descuento_sim
                                  || '|'
                                  || 'Motivo descuento SIM:'
                                  || v_desc_motivo_descuento_sim
                                  || '|'
                                  || 'Puntos bonificacion SIM:'
                                  || v_reg_cambio_tecnologia.puntos_utilizados_sim
                                  || '|'
                                  || 'Es diferido:'
                                  || v_reg_cambio_tecnologia.es_pago_diferido;
        --- Registrar transaccion
        po_cod_err := 'PVT-3085';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_TECNOLOGIA_CONSOLIDACION: Error al registrar el log transaccional.
        cc_tx_transaccion_postventa.alta
                               (pi_id_tran                     => v_id_tran,
                                pi_cod_gestion_tran            => v_cod_gestion_tran,
                                pi_cod_tipo                    => c_tipo_transaccion,
                                pi_id_cliente                  => v_id_cliente,
                                pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                pi_id_entidad_consumo          => v_reg_cambio_tecnologia.id_entidad_consumo,
                                pi_cod_motivo_transaccion      => NULL,
                                pi_cod_observacion             => NULL,
                                pi_descripcion_observacion     => NULL,
                                pi_valor_anterior              => v_trama_anterior_pv,
                                pi_valor_nuevo                 => v_trama_nuevo_pv,
                                pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                pi_fch_tran                    => v_fch_tran,
                                pi_cod_usuario                 => pi_cod_usuario,
                                po_cod_err                     => po_cod_err,
                                po_msj_err                     => po_msj_err
                               );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;



        -- envio de cambio de LRN al SCP si es un numero portado
        tx_pvt_ccs.cambio_tecnologia_portado
           (pi_numero                 => v_reg_entidad_consumo.identificador_entidad,
            pi_cod_tecnologia         => v_nueva_tecnologia,
            pi_cod_usuario            => pi_cod_usuario,
            pi_master                 => c_falso,
            pi_id_tran                => v_id_tran,
            pi_cod_gestion_tran       => v_cod_gestion_tran,
            pi_fch_tran               => v_fch_tran,
            pi_cod_unidad_negocio     => pi_cod_unidad_negocio,
            po_cod_proceso            => v_cod_proceso,
            po_cod_err                => po_cod_err,
            po_msj_err                => po_msj_err
            );
        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE cambio_ptos_x_paquete_servicio (
        -- Input parameters
        pi_id_comunidad           IN       cl_comunidad.id_comunidad%TYPE,
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_plan               IN       cl_entidad_consumo.cod_plan%TYPE,
        pi_id_paquete_servicio    IN       vta_paquete_servicio_x_ptos.id_paquete_servicio%TYPE,
        pi_puntos_utilizados      IN       vta_paquete_servicio_x_ptos.total_puntos%TYPE,
        pi_id_entidad_venta       IN       vta_paquete_servicio_x_ptos.id_entidad_venta%TYPE,
        pi_id_entidad_venta_padre IN       vta_paquete_servicio_x_ptos.id_entidad_venta_padre%TYPE,
        pi_id_entidad_consumo_ter IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        -- Output parameters
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT cnf_constante.valor%TYPE
                           := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_PTOS_X_PAQ_SERV');
        c_glosa_canje_x_minutos CONSTANT cnf_constante.valor%TYPE
                                        := tx_cnf_constante.get_constante ('GLOSA_CANJE_X_MINUTOS');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'PTO_PAQUETE_SERVICIO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_accion                   bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_reg_paquete_servicio        pto_paquete_servicio_hist%ROWTYPE;
        v_bolsillo_paqmin             pto_paquete_servicio.bolsillo%TYPE;
        v_cod_linea_negocio           bm_grupo_plan.cod_linea_negocio%TYPE;
        v_cod_grupo_plan              bm_grupo_plan.cod_grupo_plan%TYPE;
        v_cod_plan                    bm_plan.cod_plan%TYPE;
        v_id_registro                 vta_paquete_servicio_x_ptos.id_registro%TYPE;
        v_id_canjepunto               pto_canjepunto.id_canjepunto%TYPE;
        v_fch_vigencia                DATE;
        v_vigencia                    pto_paquete_servicio.vigencia%TYPE;
        v_balance_info                tx_ecms.ecms_balance_instances;
        v_monto_paquete               NUMBER;
        v_permiso                     VARCHAR2 (10);
        v_bal_bolsillo                NUMBER (10, 2);
        v_aplica_mensaje              BOOLEAN := FALSE;
        v_id_promocion                prm_promo.id_promocion%TYPE;
        v_texto_promocion             VARCHAR2 (50);
        -- Excepciones
        err_app                       EXCEPTION;
        --
        v_cod_observacion             cnf_nota_transaccion.cod_observacion%TYPE;
        v_descripcion_observacion     cnf_nota_transaccion.descripcion%TYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_trama_anterior              VARCHAR2 (4000);
        v_trama_nuevo                 VARCHAR2 (4000);
        v_id_canje_vidas              vda_canje_vidas.id_canje_vidas%TYPE;
        v_cod_tipo_objeto_canje       vda_canje_vidas.cod_tipo_objeto_canje%TYPE;
        v_id_objeto_canje             vda_canje_vidas.id_objeto_canje%TYPE;
        v_pps_status                  VARCHAR2 (50);
        v_num_telefono                cl_entidad_consumo.identificador_entidad%TYPE;
        v_id_sms                      sms_despachador.id_sms%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        v_boletos                     NUMBER;
        v_dummy                       PLS_INTEGER;
        v_lista_fechas                prm_promo.lista_fch_especificas%TYPE;
        v_id_bono                     prm_abono.id_abono%TYPE;
        v_monto_bono                  prm_abono.monto%TYPE;
        v_cod_segmento                VARCHAR2(60);
        v_mensaje                     VARCHAR2(400);
        v_vidas_canjeas_serv          NUMBER;
        v_vidas_disponible_serv       NUMBER:=0;
        c_id_cnf_promo_data_x_vidas   cnf_constante.valor%TYPE := tx_cnf_constante.get_constante ('ID_CNF_PROMO_DATA_X_VIDAS');
        c_data_x_vida_aplica_base     cnf_constante.valor%TYPE := tx_cnf_constante.get_constante ('DATA_X_VIDAS_APLICA_BASE');
        v_cod_tecnologia              cl_entidad_consumo.cod_tecnologia%TYPE;
        v_fch_inicio_promo            DATE;
        v_promo_articulos             cnf_constante.valor%TYPE := tx_cnf_constante.get_constante ('RQX_PROMOCION_ARTICULOS');
        v_opcion_dos                  VARCHAR2(5):='2';
        v_aplica_envio_sms            VARCHAR2(5);
        v_monto_bolsillo              VARCHAR2(30);
        v_monto_bolsillo_cs           VARCHAR2(30);
        v_id_bolsillo                 VARCHAR2(30);
        v_cod_servicio                VARCHAR2(30);
        v_cod_servicio_recarga        VARCHAR2(30);
        v_expiration_date             DATE;
        v_id_registro_pend            NUMBER;
        v_id_entidad_consumo          NUMBER;
        v_bolsillos_cs                tx_ecms.type_ecms_bolsilos;
        v_id_comando                  NUMBER;
        v_id_orden                    NUMBER;
     	v_plan_aplica  		          NUMBER;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_comunidad:'
            || pi_id_comunidad
            || '|'
            || 'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_plan:'
            || pi_cod_plan
            || '|'
            || 'pi_id_paquete_servicio:'
            || pi_id_paquete_servicio
            || '|'
            || 'pi_puntos_utilizados:'
            || pi_puntos_utilizados
            || '|'
            || 'pi_id_entidad_venta:'
            || pi_id_entidad_venta
            || '|'
            || 'pi_id_entidad_venta_padre:'
            || pi_id_entidad_venta_padre
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_comunidad IS NULL
           OR pi_id_entidad_consumo IS NULL
           OR pi_cod_plan IS NULL
           OR pi_id_paquete_servicio IS NULL
           OR pi_puntos_utilizados IS NULL
           OR pi_id_entidad_venta IS NULL
           OR pi_id_entidad_venta_padre IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-3088';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-3089';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-3090';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                   pi_cod_entidad                 => 'ESP_CAMBIO_PTOS_X_PAQUETE_SERVICIOS',
                                   pi_cod_usuario_tran            => pi_cod_usuario,
                                   po_permiso                     => v_permiso,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

      IF v_permiso = c_falso THEN
            po_cod_err := 'PVT-3091';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: El usuario solo tiene permiso para realizar el canje de puntos por paquetes de servicio.
            RAISE err_app;
          END IF;


        IF entidad_venta_valida (pi_id_entidad_venta, v_cod_linea_negocio) = c_falso THEN
            po_cod_err := 'PVT-3092';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Su entidad de venta no puede realizar esta transaccion para esta linea de negocio
            RAISE err_app;
        END IF;

        c_id_paquete_servicio := c_falso;

        IF pi_id_entidad_consumo_ter IS NOT NULL THEN

            po_cod_err := 'PVT-3093';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al realizar el bloqueo de la entidad de consumo.
            SELECT ec.identificador_entidad, ec.cod_tecnologia
              INTO v_identificador_entidad, v_cod_tecnologia
              FROM cl_entidad_consumo ec
             WHERE ec.id_entidad_consumo = pi_id_entidad_consumo_ter
               AND ec.estado NOT IN ('I', 'TER', 'POST')
            FOR UPDATE WAIT 0;

           v_id_entidad_consumo         :=  pi_id_entidad_consumo_ter;
           c_id_entidad_consumo_ter     :=  pi_id_entidad_consumo_ter;
           c_identificador_entidad_ter  :=  v_identificador_entidad;
           c_id_paquete_servicio        :=  pi_id_paquete_servicio;

        ELSE
            v_id_entidad_consumo := pi_id_entidad_consumo;
        END IF;


        po_cod_err := 'PVT-3094';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al realizar el bloqueo de la entidad de consumo.
        SELECT     ec.identificador_entidad, ec.cod_tecnologia
              INTO v_identificador_entidad, v_cod_tecnologia
              FROM cl_entidad_consumo ec
             WHERE ec.id_entidad_consumo = pi_id_entidad_consumo
               AND ec.estado NOT IN ('I', 'TER', 'POST')
        FOR UPDATE WAIT 0;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR SUSPENDIDA NI DESCONECTADA
       IF suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero THEN
          po_cod_err := 'PVT-3095';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: El suscriptor esta suspendido.
          RAISE err_app;
       END IF;

        po_cod_err := 'PVT-3096';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al recuperar el total de compra de los paquetes.

        IF pi_id_paquete_servicio IN (14,15) THEN
            SELECT paquete, 'SEGUROS' AS id_objeto_canje, DECODE(pi_id_paquete_servicio,'14','TOCSGA','TOCSGH')
              INTO v_monto_paquete, v_id_objeto_canje, v_cod_tipo_objeto_canje
              FROM TABLE (tx_pto_paquete_servicio.get_rango_pto_micseg (pi_id_paquete_servicio,pi_id_entidad_consumo))
             WHERE puntos = pi_puntos_utilizados;

        ELSE
            SELECT monto_bolsillo, id_bolsillo, cod_servicio, cod_servicio_recarga, vigencia, cod_tipo_objeto_canje, id_objeto_canje, monto_paquete
              INTO v_monto_bolsillo, v_id_bolsillo, v_cod_servicio, v_cod_servicio_recarga, v_vigencia, v_cod_tipo_objeto_canje, v_id_objeto_canje, v_monto_paquete
              FROM TABLE (tx_pto_paquete_servicio.get_rango_pto (pi_id_paquete_servicio))
             WHERE puntos = pi_puntos_utilizados;
        END IF;

         --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (v_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

       IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
       END IF;

       IF es_suscriptor_4g(pi_id_entidad_consumo) = '1' THEN
        IF v_id_bolsillo = '34' THEN
         IF pi_id_entidad_consumo_ter IS NOT NULL
           	AND v_reg_entidad_consumo.cod_plan = 'VMCP' THEN
                v_id_bolsillo := '3';
              ELSE
                 v_id_bolsillo := c_new_bolsillo_vidas;
              END IF;
      		 END IF;
           IF v_id_bolsillo ='95'
             THEN
               v_id_bolsillo :=c_new_bolsillo_ldi;
           END IF;
           IF v_id_bolsillo ='10'
             THEN
               v_id_bolsillo :=c_new_bolsillo_ldu;
           END IF;
       END IF;


        tx_pto_paquete_servicio.get_paquete_servicio
                                                 (pi_id_paquete_servicio         => pi_id_paquete_servicio,
                                                  po_reg_paquete_servicio        => v_reg_paquete_servicio,
                                                  po_cod_err                     => po_cod_err,
                                                  po_msj_err                     => po_msj_err);

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3097';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al obtener la linea de negocio del plan.

        SELECT cod_linea_negocio,
               cod_grupo_plan,
               cod_plan,
               cod_segmento
          INTO v_cod_linea_negocio,
               v_cod_grupo_plan,
               v_cod_plan,
               v_cod_segmento
          FROM v_plan_segmento
         WHERE cod_plan =  v_reg_entidad_consumo.cod_plan;


        IF v_cod_linea_negocio IN (c_linea_negocio_prepago,'EXTERN') OR v_cod_segmento IN ('CASPRE') THEN
            po_cod_err := 'PVT-3098';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: El identificador entidad no existe.

            -- Consulta en ECMS, para verificar el estado del numero.
             SELECT current_state
              INTO v_pps_status
              FROM TABLE(tx_cl_lifecycle.get_subscriber_data(v_reg_entidad_consumo.id_entidad_consumo));

            po_cod_err := 'PVT-3099';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: El numero no esta activo.

            IF v_pps_status <> '2' THEN
                RAISE err_app;
            END IF;
        END IF;


        IF v_reg_paquete_servicio.cod_tipo_paquete IN ('CTPESP','CTPUCP','CTPMIN','CTPFAC','CTPYOU','CTPDAR','CTPINS','CTPNET','CTPMI2') THEN

            BEGIN
                po_cod_err := 'PVT-3100';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al obtener la informacion del subscriptor
                tx_ecms.getSubscriberBalance(pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                             po_balance_info         => v_balance_info,
                                             po_cod_err              => po_cod_err,
                                             po_msj_err              => po_msj_err
                                             );
                po_cod_err := 'PVT-3101';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al obtener el identificador del bolsillo. CVE: agrega exception en este bloque.
                v_fch_vigencia        := v_balance_info (tx_ecms.c_bal_core_balance).expirationdate;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                     v_fch_vigencia   := NULL;
            END;

            v_expiration_date         := SYSDATE + v_vigencia;

            /* MODIFICAR FECHA CORE BALANCE PARA QUE NO EXPIRE EL BONO OTORGADO */
            IF v_cod_linea_negocio IN (c_linea_negocio_prepago,'EXTERN') OR v_cod_segmento IN ('CASPRE') THEN
                IF v_fch_vigencia < v_expiration_date THEN

                    po_cod_err := 'PVT-3102';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al actualizar la vigencia del CORE BALANCE.
                    tx_ecms.setExpirationDates( pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                                                pi_fch_expiracion       => v_expiration_date,
                                                po_cod_err              => po_cod_err,
                                                po_msj_err              => po_msj_err);
                END IF;
            ELSE
                v_fch_vigencia    := NULL;
            END IF;

            IF v_reg_paquete_servicio.cod_tipo_paquete IN ('CTPFAC','CTPYOU','CTPDAR','CTPINS','CTPNET') THEN
                v_bolsillos_cs             := tx_ecms.get_OffertoEcms(v_id_bolsillo);
            ELSE

            SELECT CASE
		             WHEN EXISTS (
		               SELECT 1
		                 FROM omega.ecms_bolsillos b
		                 JOIN omega.bm_plan_bolsillos_ecms pb
		                   ON pb.cod_bolsillo_ecms = b.cod_bolsillo_ecms
		                WHERE b.cod_bolsillo_c1 = v_id_bolsillo
		                  AND b.estado = 'A'
		                  AND pb.cod_plan = v_reg_entidad_consumo.cod_plan
		                  AND pb.estado = 'A'
		             )
		             THEN 1
		             ELSE 0
		           END
		      INTO v_plan_aplica
		      FROM dual;

              IF v_plan_aplica = 0 THEN
			     po_cod_err := 'PVT-6233'; --TX_PVT_ENTIDAD_CONSUMO.cambio_ptos_x_paquete_servicio No está permitido el canje por servicio OnNet para este plan.
			     po_msj_err := 'TX_PVT_ENTIDAD_CONSUMO.cambio_ptos_x_paquete_servicio No está permitido el canje por servicio OnNet para este plan';
			     RETURN;

			  END IF;
                v_bolsillos_cs             := tx_ecms.get_C1toEcms(v_id_bolsillo,v_reg_entidad_consumo.cod_plan);
            END IF;

            IF v_bolsillos_cs.offer_id IS NOT NULL THEN

                 po_cod_err    := 'PVT-5199'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: No existe la Accion al PRV para el servicio.
                 SELECT tx_vpg_util.get_comando('SET_OFFER', v_reg_entidad_consumo.cod_forma_consumo, 'SET')
                  INTO v_id_comando
                 FROM DUAL;

                 po_cod_err    := 'PVT-5198'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al dar de alta la orden en el PRV.

                 mt_vpg.alta_orden(
                            pi_id_comando           => v_id_comando,
                            pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_fch_programada       => v_fch_tran,
                            pi_cod_transaccion      => v_cod_tran,
                            pi_p1                   => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                            pi_p2                   => v_reg_entidad_consumo.id_entidad_consumo,
                            pi_p3                   => v_bolsillos_cs.offer_id, -- OFFER ID
                            pi_p4                   => 'A',
                            pi_p5                   => NULL, --Fecha Inicio
                            pi_p6                   => TX_ECMS.date2iso(v_expiration_date), --Fecha Fin
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_master               => '0',
                            pi_id_tran              => v_id_tran,
                            pi_cod_gestion_tran     => v_cod_gestion_tran,
                            pi_fch_tran             => v_fch_tran,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            po_id_orden             => v_id_orden,
                            po_id_tran              => v_id_tran,
                            po_fch_tran             => v_fch_tran,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err
                            );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;


                  --QUITAR SERVICIOS DE SUSPENCION DE LTE / 3G

                FOR c_base IN (SELECT SEC.COD_SERVICIO
                                  FROM cl_servicio_entidad_consumo sec
                                WHERE sec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                                AND sec.cod_servicio IN ('SUS3G','SUS4G')
                                AND sec.estado = 'A'
                                AND sec.fch_fin = c_fecha_fin
                )
                LOOP

                    po_cod_err := 'PVT-6111';   --TX_VTA_PAQUETES.ASIGNAR: Error al desasignar servicio de suspencion LTE.
                    tx_pvt_entidad_consumo.desasignar_servicio(
                        pi_id_entidad_consumo   => v_reg_entidad_consumo.id_entidad_consumo,
                        pi_cod_servicio         => c_base.cod_servicio,
                        pi_cod_usuario          => pi_cod_usuario,
                        pi_master               => '0',
                        pi_id_tran              => v_id_tran,
                        pi_cod_gestion_tran     => v_cod_gestion_tran,
                        pi_fch_tran             => v_fch_tran,
                        pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                        po_id_tran              => po_id_tran,
                        po_cod_gestion_tran     => v_cod_gestion_tran,
                        po_cod_err              => po_cod_err,
                        po_msj_err              => po_msj_err
                    );

                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;

              END LOOP;


            END IF;

            po_cod_err := 'PVT-3103';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al actualizar el bolsillo en la PPS.
            IF v_bolsillos_cs.cod_unidad_medida IN ('MONEY') THEN
                v_monto_bolsillo_cs :=  tx_vpg_util.number2cs(v_monto_bolsillo);
            ELSE
                v_monto_bolsillo_cs := v_monto_bolsillo;
            END IF;

            v_id_comando    :=  tx_vpg_util.get_comando('SET_DA_BALANCE',v_reg_entidad_consumo.cod_forma_consumo,'SET');

            mt_vpg.alta_orden(
                    pi_id_comando               => v_id_comando,
                    pi_id_entidad_consumo       => v_reg_entidad_consumo.id_entidad_consumo,
                    pi_fch_programada           => v_fch_tran,
                    pi_cod_transaccion          => v_cod_tran,
                    pi_p1                       => tx_vpg_util.get_msisdn(v_reg_entidad_consumo.identificador_entidad),
                    pi_p2                       => tx_air.get_transactionID,
                    pi_p3                       => tx_vpg_util.date2iso(v_fch_tran),
                    pi_p4                       => v_bolsillos_cs.cod_bolsillo_c1,
                    pi_p5                       => v_monto_bolsillo_cs,
                    pi_p6                       => v_bolsillos_cs.cod_unidad_medida_air,
                    pi_p7                       => tx_vpg_util.date2iso( v_expiration_date ),
                    pi_p8                       => 'CANJE PUNTOS X ' || v_reg_paquete_servicio.descripcion,
                    pi_cod_usuario              => pi_cod_usuario,
                    pi_master                   => '0',
                    pi_id_tran                  => v_id_tran,
                    pi_cod_gestion_tran         => v_cod_gestion_tran,
                    pi_fch_tran                 => v_fch_tran,
                    pi_cod_unidad_negocio       => pi_cod_unidad_negocio,
                    po_id_orden                 => v_id_orden,
                    po_id_tran                  => v_id_tran,
                    po_fch_tran                 => v_fch_tran,
                    po_cod_err                  => po_cod_err,
                    po_msj_err                  => po_msj_err);

            IF (po_cod_err != 'OK') THEN
                RAISE err_app;
            END IF;
            IF v_reg_entidad_consumo.cod_forma_consumo = 'CCOPRE' THEN
                --???? DUDA - POR QUE EXTIENDE CON UN PAQUETE PROMOCIONAL ????
                --Extension de fechas en el ciclo de vida de OMEGA
                po_cod_err := 'PVT-4981'; --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al intentar extender las fecha en ciclo de vida.

                IF v_fch_vigencia < v_expiration_date THEN
                    tx_cl_lifecycle.generate_subscriber_dates( pi_internal_id        => pi_id_entidad_consumo,
                                                   pi_expiration_date    => v_expiration_date,
                                                   pi_transaction_reason => 'DATE_EXTENSION_BY_SERVICE',
                                                   pi_master             => c_falso,
                                                   pi_tran_id            => v_id_tran,
                                                   pi_tran_date          => v_fch_tran,
                                                   pi_tran_user          => pi_cod_usuario,
                                                   pi_tran_period        => v_cod_gestion_tran,
                                                   po_cod_err            => po_cod_err,
                                                   po_msj_err            => po_msj_err
                                                  );
                    IF po_cod_err <> 'OK' THEN
                        RAISE err_app;
                    END IF;
                END IF;
            END IF;
        ELSIF v_reg_paquete_servicio.cod_tipo_paquete = 'CTPART' THEN

            po_cod_err                 := 'PVT-4576:';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al obtener la fecha inicial de la promocion de articulos
            SELECT fch_inicio
              INTO v_fch_inicio_promo
              FROM prm_promo
             WHERE descripcion LIKE '%'||v_promo_articulos||'%';

            po_cod_err := 'PVT-3104';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al invocar al procedimiento TX_VDA_CANJE_VIDAS.ALTA.
            SELECT SUM(total_puntos)
              INTO v_vidas_canjeas_serv
              FROM vta_paquete_servicio_x_ptos
             WHERE id_paquete_servicio = pi_id_paquete_servicio
               AND id_entidad_consumo = pi_id_entidad_consumo
               AND fch_tran >= v_fch_inicio_promo;

            IF v_vidas_canjeas_serv >= TO_NUMBER(c_max_pto_x_servicio_acum) THEN
                po_cod_err := 'PVT-3105';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Cliente ha realizado el canje maximo de vidas por servicios durante esta promocion.
                po_msj_err := 'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Cliente ha realizado el canje maximo de vidas por articulos durante esta promocion.';
                RAISE err_app;
            END IF;

            IF v_vidas_canjeas_serv + pi_puntos_utilizados > TO_NUMBER(c_max_pto_x_servicio_acum) THEN
                v_dummy := TO_NUMBER(c_max_pto_x_servicio_acum) - v_vidas_canjeas_serv;
                po_cod_err := 'PVT-3106';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: El cliente ha canjeado XXX Vidas por articulos, solo puede canjear xxx Vidas mas por articulos.
                po_msj_err   := 'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: El cliente ha canjeado '||v_vidas_canjeas_serv||' Vidas por articulos, solo puede canjear '||v_dummy||' Vidas mas por articulos.';
                RAISE err_app;
            END IF;

        /*RQX 7728 PROMOCIÓN CENAS NAVIDEÑAS 2018*/
        ELSIF v_reg_paquete_servicio.codigo = 'PAQNAV' THEN
            po_cod_err                 := 'PVT-4576:';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al obtener la fecha inicial de la promocion de articulos
            SELECT fch_desde
              INTO v_fch_inicio_promo
              FROM PTO_PAQUETE_SERVICIO_hist
             WHERE id_paquete_servicio = pi_id_paquete_servicio;

            po_cod_err := 'PVT-3104';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al invocar al procedimiento TX_VDA_CANJE_VIDAS.ALTA.
            SELECT SUM(total_puntos)
              INTO v_vidas_canjeas_serv
              FROM vta_paquete_servicio_x_ptos
             WHERE id_paquete_servicio = pi_id_paquete_servicio
               AND id_entidad_consumo = pi_id_entidad_consumo
               AND fch_tran >= v_fch_inicio_promo;

            IF v_vidas_canjeas_serv >= 250 THEN
                po_cod_err := 'PVT-6006';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Usted a sobrepasado la cantidad máxima para canje de Vidas en esta promoción (250).
                po_msj_err := 'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Usted a sobrepasado la cantidad máxima para canje de Vidas en esta promoción (250).';
                RAISE err_app;
            END IF;

            IF v_vidas_canjeas_serv + pi_puntos_utilizados > 250 THEN
                v_dummy := 250 - v_vidas_canjeas_serv;
                po_cod_err := 'PVT-6007';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: El cliente ha canjeado XXX Vidas por articulos, solo puede canjear xxx Vidas mas por articulos.
                po_msj_err   := 'TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: El cliente ha canjeado '||v_vidas_canjeas_serv||' Vidas por boletos, solo puede canjear '||v_dummy||' Vidas mas.';
                RAISE err_app;
            END IF;

        ELSIF v_reg_paquete_servicio.codigo IN ('PAQHOS','PAQACC') THEN
             po_cod_err := 'PVT-3107';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: El paquete suscripcion servicio no esta implementado.
             tx_cl_suscripcion_servicio.canje_vidas_por_seguro(pi_id_entidad_consumo    => pi_id_entidad_consumo,
                                                               pi_id_paquete_servicio   => pi_id_paquete_servicio,
                                                               pi_puntos_utilizados     => pi_puntos_utilizados,
                                                               pi_cod_tipo_procedencia  => c_procedencia_vidas_bal,
                                                               pi_cod_usuario           => pi_cod_usuario,
                                                               pi_master                => c_falso,
                                                               pi_id_tran               => v_id_tran,
                                                               pi_cod_gestion_tran      => v_cod_gestion_tran,
                                                               pi_fch_tran              => v_fch_tran,
                                                               pi_cod_unidad_negocio    => pi_cod_unidad_negocio,
                                                               po_cod_err               => po_cod_err,
                                                               po_msj_err               => po_msj_err
                                                               );

             IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
             END IF;

        ELSIF v_reg_paquete_servicio.cod_tipo_paquete IN ('CTPMGP','CTPSMS','CTPVOZ','CTPDAT','CTPNDT','CTPWHT','CTPSIV','CTPDIV') THEN

            IF  v_reg_paquete_servicio.cod_tipo_paquete IN ('CTPSIV','CTPDIV') THEN

                 SELECT
                        COUNT(1)
                       INTO  v_dummy
                 FROM  cl_servicio_recarga
                     WHERE id_entidad_consumo = v_id_entidad_consumo
                     AND  cod_servicio IN (
                           'VIDATI',
                           'VIDATC'
                        )
                     AND fch_fin > SYSDATE
                     AND fch_efectiva_fin > SYSDATE
                     AND estado <> 'I';

                 IF v_dummy >= 1 THEN
                    po_cod_err := 'PVT-6008';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Cliente tiene un paquete vigente de este tipo.
                    RAISE err_app;
                 END IF;

            END IF;

            po_cod_err := 'PVT-3108';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIOS_PTOS_X_PAQUETE_SERVICIO: Error al invocar tx_pvt_servicios.asignar_venta
            tx_pvt_servicios.asignar_venta
                                 (pi_cod_servicio                => v_cod_servicio,
                                  pi_id_entidad_consumo          => v_id_entidad_consumo,
                                  pi_id_entidad_venta            => pi_id_entidad_venta,
                                  pi_es_pago_diferido            => '0',
                                  pi_id_prospecto_ceq            => '',
                                  pi_tipo_procedencia            => 'VTPVID',
                                  pi_parametros                  => v_cod_servicio_recarga,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => '0',
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_prospecto                => v_id_bono,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF po_cod_err <> 'OK' THEN
               RAISE err_app;
            END IF;

        END IF;

        IF v_reg_paquete_servicio.texto_sms IS NOT NULL THEN
            v_mensaje  := v_reg_paquete_servicio.texto_sms;
            v_mensaje  := REPLACE(v_mensaje, 'MITAD_BONO', (v_monto_bolsillo / 2));
            v_mensaje  := REPLACE(v_mensaje, 'VIDAS_UTILIZADAS', pi_puntos_utilizados);
            v_mensaje  := REPLACE(v_mensaje, '#VIDAS_CANJEADAS#', pi_puntos_utilizados);
             v_mensaje  := REPLACE(v_mensaje,
                                  '#REGALO_DE#',
                                  CASE
                                      WHEN pi_id_entidad_consumo_ter IS NOT NULL THEN ' del ' || v_identificador_entidad
                                      ELSE ''
                                  END);

         IF pi_id_entidad_consumo_ter IS NOT NULL THEN
                IF INSTR(v_reg_paquete_servicio.texto_sms, '#REGALO_DE#') > 0 THEN
                    NULL;
                ELSIF INSTR(LOWER(v_mensaje), ', gracias por formar parte de la familia viva') > 0 THEN
                    v_mensaje := SUBSTR(v_mensaje,
                                        1,
                                        INSTR(LOWER(v_mensaje), ', gracias por formar parte de la familia viva') - 1)
                                 || '. Regalo de '
                                 || v_identificador_entidad
                                 || '. Gracias por formar parte de viva, estamos de tu lado.';
                ELSE
                    v_mensaje := RTRIM(v_mensaje, '. ')
                                 || '. Regalo de '
                                 || v_identificador_entidad
                                 || '. Gracias por formar parte de viva, estamos de tu lado.';
                END IF;
            END IF;

            po_cod_err := 'PVT-3109';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE: Error al Enviar msj Por cambio de vidas por sericios.
            tx_sms.alta (pi_origen                      => 'VIVA',
                         pi_destino                     => v_reg_entidad_consumo.identificador_entidad,
                         pi_texto                       => v_mensaje,
                         pi_prioridad                   => '2',
                         pi_id_tran                     => v_id_tran,
                         pi_fch_tran                    => v_fch_tran,
                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                         pi_cod_usuario                 => pi_cod_usuario,
                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                         pi_master                      => c_falso,
                         po_id_sms                      => v_id_sms,
                         po_cod_err                     => po_cod_err,
                         po_msj_err                     => po_msj_err
                        );
            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;


        IF pi_id_entidad_consumo_ter IS NOT NULL THEN
            validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                     po_msj_err);

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END IF;


        tx_vda_canje_vidas.alta (v_reg_entidad_consumo.id_entidad_consumo,
                                 pi_puntos_utilizados,
                                 v_cod_tipo_objeto_canje,
                                 v_id_objeto_canje,
                                 NULL,
                                 NULL,
                                 v_fch_tran,
                                 v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_usuario,
                                 pi_cod_unidad_negocio,
                                 c_falso,
                                 v_id_canje_vidas,
                                 po_cod_err,
                                 po_msj_err
                                );

        IF po_cod_err <> 'OK' AND po_cod_err <> 'VDA-0398' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3110';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al invocar al procedimiento TX_VTA_PAQUETE_SERVICIO_X_PTOS.ALTA.
        tx_vta_paquete_servicio_x_ptos.alta
                                 (pi_id_paquete_servicio         => pi_id_paquete_servicio,
                                  pi_total_puntos                => pi_puntos_utilizados,
                                  pi_total_compra                => v_monto_paquete,
                                  pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                  pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                  pi_cod_plan                    => v_reg_entidad_consumo.cod_plan,
                                  pi_id_entidad_venta            => pi_id_entidad_venta,
                                  pi_id_entidad_venta_padre      => pi_id_entidad_venta_padre,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_registro                 => v_id_registro,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;


        IF pi_id_entidad_consumo_ter IS NOT NULL THEN
            po_cod_err := 'PVT-3111';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al registrar cambio de vidas a un tercer cliente.
            tx_vda_canje_paq_servicio_ter.alta(pi_id_canje_vidas                => v_id_canje_vidas,
                                               pi_id_reg_paquete_servicios      => v_id_registro,
                                               pi_id_entidad_consumo_ter        => v_id_entidad_consumo,
                                               pi_id_prospecto                  => v_id_bono,
                                               pi_cod_usuario                   => pi_cod_usuario,
                                               pi_master                        => c_falso,
                                               pi_id_tran                       => v_id_tran,
                                               pi_fch_tran                      => v_fch_tran,
                                               pi_cod_gestion_tran              => v_cod_gestion_tran,
                                               pi_cod_unidad_negocio            => pi_cod_unidad_negocio,
                                               po_id_tran                       => po_id_tran,
                                               po_fch_tran                      => v_fch_tran,
                                               po_cod_err                       => po_cod_err,
                                               po_msj_err                       => po_msj_err
                                               );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        IF v_reg_paquete_servicio.codigo = c_paquete_servicio_minutos THEN
            v_cod_observacion            := 'CVPM';
            v_descripcion_observacion    := 'CAMBIO DE PUNTOS X PAQUETE DE MINUTO';
        END IF;

        po_cod_err := 'PVT-3112';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al determinar el id del cliente.
        v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);
        po_cod_err := 'PVT-3113';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al recuperar forma de consumo del plan anterior
        v_trama_anterior       := '';
        v_trama_nuevo          :=    'Puntos utilizados:'
                                  || pi_puntos_utilizados
                                  || '|'
                                  || 'Monto paquete:'
                                  || '|'
                                  || v_monto_paquete;
        --- Registrar transaccion
        po_cod_err := 'PVT-3114';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PTOS_X_PAQUETE_SERVICIO: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
        cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => v_cod_observacion,
                                   pi_descripcion_observacion     => v_descripcion_observacion,
                                   pi_valor_anterior              => v_trama_anterior,
                                   pi_valor_nuevo                 => v_trama_nuevo,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        BEGIN
            v_id_registro_pend     := mt_ret_util.tiene_prospecto_serv_x_vd(v_reg_entidad_consumo.id_entidad_consumo);

            IF v_id_registro_pend IS NOT NULL THEN

                tx_ret_prospecto.cambiar_estado(pi_id_registro          => v_id_registro_pend,
                                                pi_estado               => 'COMP',
                                                pi_cod_usuario          => pi_cod_usuario,
                                                pi_master               => c_falso,
                                                pi_id_tran              => v_id_tran,
                                                pi_cod_gestion_tran     => v_cod_gestion_tran,
                                                pi_fch_tran             => v_fch_tran,
                                                pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                                po_cod_err              => po_cod_err,
                                                po_msj_err              => po_msj_err
                                              );
                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

            END IF;

        EXCEPTION
            WHEN OTHERS THEN
                NULL;
        END;


        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := NULL;
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END cambio_ptos_x_paquete_servicio;

    PROCEDURE revertir_cambio_plan (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        -- Output parameters
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Cursores
        CURSOR c_vta_cambio_plan (pi_id_tran_prospecto IN vta_cambio_plan.id_tran_inicio%TYPE)
        IS
            SELECT *
              FROM vta_cambio_plan
             WHERE id_tran_fin = pi_id_tran_prospecto;

        -- Constantes
        c_tipo_transaccion   CONSTANT cnf_constante.valor%TYPE
                              := tx_cnf_constante.get_constante ('TRANSACCION_REVERTIR_CAMBIO_PLAN');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_tran_prospecto           vta_cambio_plan.id_tran_inicio%TYPE;
        v_id_registro_com_hist        cl_comunidad_historico.id_registro%TYPE;
        v_id_registro_ec_hist         cl_entidad_consumo_historico.id_registro%TYPE;
        v_cod_forma_consumo_ant       bm_plan.cod_forma_consumo%TYPE;
        v_id_prospecto_mig            vta_cambio_plan.id_prospecto_mig%TYPE;
        v_reg_migracion_com           vta_migracion_comunidad%ROWTYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_desc_plan_nuevo             bm_plan.descripcion%TYPE;
        v_desc_plan_anterior          bm_plan.descripcion%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_dummy                       NUMBER;
        v_servicio_bb                 NUMBER := 0;
        v_po_id_tran                  tx_historico_transaccion.id_tran%TYPE;
        v_po_fch_tran                 tx_historico_transaccion.fch_tran%TYPE;
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            ||
               ---------- parametros obligatorios ---------------
               'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF pi_id_entidad_consumo IS NULL OR pi_master IS NULL THEN
            po_cod_err := 'PVT-3126';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-3127';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-3128';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        SELECT COUNT (1)
          INTO v_dummy
          FROM tr_cambio_plan_historico cph, vta_cambio_plan cp
         WHERE cph.id_entidad_consumo = pi_id_entidad_consumo
           AND cph.fch_fin = c_fecha_fin
           AND cph.fch_inicio > SYSDATE
           AND cp.id_entidad_consumo = cph.id_entidad_consumo
           AND cp.id_tran_fin = cph.id_tran_inicio;

        IF v_dummy = 0 THEN
            po_cod_err := 'PVT-3129';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: El PCS no tiene una transaccion de cambio y/o migracion de plan diferida.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3130';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al recuperar la transaccion de cambio y/o migracion de plan diferida.

        SELECT cp.id_tran_inicio,
               cp.id_prospecto_mig
          INTO v_id_tran_prospecto,
               v_id_prospecto_mig
          FROM tr_cambio_plan_historico cph, vta_cambio_plan cp
         WHERE cph.id_entidad_consumo = pi_id_entidad_consumo
           AND cph.fch_fin = c_fecha_fin
           AND cph.fch_inicio > SYSDATE
           AND cp.id_entidad_consumo = cph.id_entidad_consumo
           AND cp.id_tran_fin = cph.id_tran_inicio;

        -- Solo si es un cambio de Plan.
        IF v_id_prospecto_mig IS NOT NULL THEN
            po_cod_err := 'PVT-3131';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al recuperar datos de la migracion de plan.

            SELECT *
              INTO v_reg_migracion_com
              FROM vta_migracion_comunidad
             WHERE id_prospecto = v_id_prospecto_mig AND id_tran_inicio = v_id_tran_prospecto;

            v_id_tran_prospecto    := v_reg_migracion_com.id_tran_fin;
            po_cod_err := 'PVT-3132';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al actualizar los datos de la comunidad.

            UPDATE cl_comunidad
               SET cod_linea_negocio = v_reg_migracion_com.cod_linea_negocio_anterior,
                   cod_ciclo_facturacion = v_reg_migracion_com.cod_ciclo_anterior
             WHERE id_comunidad = v_reg_migracion_com.id_comunidad;

            po_cod_err := 'PVT-3133';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al eliminar el registro historico de la comunidad.

            DELETE FROM cl_comunidad_historico
                  WHERE id_comunidad = v_reg_migracion_com.id_comunidad
                    AND id_tran = v_id_tran_prospecto;

            po_cod_err := 'PVT-3134';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al recuperar datos historicos de la comunidad.

            SELECT id_registro
              INTO v_id_registro_com_hist
              FROM (SELECT   id_registro
                        FROM cl_comunidad_historico
                       WHERE id_comunidad = v_reg_migracion_com.id_comunidad
                         AND cod_linea_negocio = v_reg_migracion_com.cod_linea_negocio_anterior
                    ORDER BY id_registro DESC)
             WHERE ROWNUM = 1;

            po_cod_err := 'PVT-3135';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al actualizar los datos historicos de la comunidad.

            UPDATE cl_comunidad_historico
               SET fch_fin = c_fecha_fin,
                   ultimo_registro = c_verdadero
             WHERE id_comunidad = v_reg_migracion_com.id_comunidad
               AND id_registro = v_id_registro_com_hist;

            po_cod_err := 'PVT-3136';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al actualizar el prospecto de migracion.

            UPDATE vta_migracion_comunidad
               SET estado = c_estado_inactivo
             WHERE id_comunidad = v_reg_migracion_com.id_comunidad
               AND id_tran_fin = v_id_tran_prospecto;
        END IF;

        FOR c_cambio_plan IN c_vta_cambio_plan (v_id_tran_prospecto)
        LOOP
            IF c_cambio_plan.id_tran_fin IS NULL THEN
                po_cod_err := 'PVT-3137';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: El prospecto ahun esta en estado pendiente.
                RAISE err_app;
            END IF;

            v_id_tran_prospecto    := c_cambio_plan.id_tran_fin;
            po_cod_err := 'PVT-3138';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al determinar la forma de consumo del plan anterior.

            SELECT p.cod_forma_consumo
              INTO v_cod_forma_consumo_ant
              FROM bm_plan p, bm_grupo_plan g
             WHERE p.cod_plan = c_cambio_plan.cod_plan_anterior
               AND g.cod_grupo_plan = p.cod_grupo_plan;

            po_cod_err := 'PVT-3139';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al actualizar los datos de la entidad de consumo.

            UPDATE cl_entidad_consumo
               SET cod_plan = c_cambio_plan.cod_plan_anterior,
                   cod_forma_consumo = v_cod_forma_consumo_ant
             WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo;

            po_cod_err := 'PVT-3140';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al eliminar el registro historico de la entidad de consumo.

            DELETE FROM cl_entidad_consumo_historico
                  WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
                    AND id_tran = v_id_tran_prospecto;

            po_cod_err := 'PVT-3141';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al recuperar datos de entidad de consumo.

            SELECT id_registro
              INTO v_id_registro_ec_hist
              FROM (SELECT   id_registro
                        FROM cl_entidad_consumo_historico
                       WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
                         AND cod_plan = c_cambio_plan.cod_plan_anterior
                    ORDER BY id_registro DESC)
             WHERE ROWNUM = 1;

            po_cod_err := 'PVT-3142';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al actualizar el registro historico de la entidad de consumo.

            UPDATE cl_entidad_consumo_historico
               SET fch_fin = c_fecha_fin,
                   ultimo_registro = c_verdadero
             WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
               AND id_registro = v_id_registro_ec_hist;

            po_cod_err := 'PVT-3143';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al eliminar un registro del historico.

            DELETE FROM tr_cambio_plan_historico
                  WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
                    AND id_tran_inicio = v_id_tran_prospecto;

            po_cod_err := 'PVT-3144';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al actualizar el historico del cambio de plan.

            UPDATE tr_cambio_plan_historico
               SET id_tran_fin = NULL,
                   fch_fin = c_fecha_fin,
                   cod_gestion_tran_fin = NULL,
                   fch_efectiva_fin = c_fecha_fin,
                   ultimo_registro = c_verdadero
             WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
               AND id_tran_fin = v_id_tran_prospecto;

            po_cod_err := 'PVT-5179'; --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al actualizar el registro de numero favorito.

            UPDATE cl_entidad_consumo_afin
               SET estado = c_estado_activo,
                   fch_fin = c_fecha_fin,
                   cod_gestion_tran_fin = NULL,
                   id_tran_fin = NULL,
                   fch_efectiva_fin = c_fecha_fin,
                   cod_usuario_fin = NULL
             WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
               AND id_tran_fin = v_id_tran_prospecto;

            po_cod_err := 'PVT-3145';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al actualizar el registro de cambio de plan.

            UPDATE vta_cambio_plan
               SET estado = c_estado_inactivo
             WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
               AND id_tran_fin = v_id_tran_prospecto;



            FOR c_orden IN (SELECT o.*
                              FROM cl_orden_prv o, bm_servicio s
                             WHERE o.id_entidad_consumo = c_cambio_plan.id_entidad_consumo
                               AND o.id_tran_inicio = v_id_tran_prospecto
                               AND o.fch_fin <> c_fecha_fin
                               AND s.cod_servicio = o.p6)
            LOOP
                IF c_orden.sub_operacion = 'ADD' THEN
                    SELECT COUNT (1)
                      INTO v_dummy
                      FROM cl_servicio_entidad_consumo c
                     WHERE c.id_entidad_consumo = c_orden.id_entidad_consumo
                       AND c.cod_servicio = c_orden.p6
                       AND c.estado <> c_estado_inactivo
                       AND c.fch_fin = c_fecha_fin;

                    IF v_dummy > 0 THEN
                        po_cod_err := 'PVT-3146';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al invocar el procedimiento TX_PVT_ENTIDAD_CONSUMO.DESASIGNAR_SERVICIO.
                        tx_pvt_entidad_consumo.desasignar_servicio
                                              (pi_id_entidad_consumo          => c_orden.id_entidad_consumo,
                                               pi_cod_servicio                => c_orden.p6,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_master                      => c_falso,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               po_id_tran                     => po_id_tran,
                                               po_cod_gestion_tran            => po_cod_gestion_tran,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;

                        SELECT COUNT (1)
                          INTO v_servicio_bb
                          FROM bm_servicio b
                         WHERE b.cod_servicio = c_orden.p6
                           AND b.cod_tipo_servicio = 'BBDAT'
                           AND b.estado = 'A';

                        IF v_servicio_bb > 0 THEN
                            po_cod_err := 'PVT-3147';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al invocar el procedimiento CC_CL_ENTIDAD_CONSUMO_BB.ALTA.
                            cc_cl_entidad_consumo_bb.alta
                                              (pi_id_entidad_consumo          => c_orden.id_entidad_consumo,
                                               pi_estado_bb                   => 'I',
                                               pi_estado                      => 'A',
                                               pi_fch_inicio                  => v_fch_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               pi_master                      => c_falso,
                                               pi_fue_activado                => c_falso,
                                               pi_cod_servicio                => c_orden.p6,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                            IF po_cod_err <> 'OK' THEN
                                RAISE err_app;
                            END IF;
                        END IF;
                    END IF;
                ELSIF c_orden.sub_operacion = 'DEL' THEN
                    SELECT COUNT (1)
                      INTO v_dummy
                      FROM cl_servicio_entidad_consumo c
                     WHERE c.id_entidad_consumo = c_orden.id_entidad_consumo
                       AND c.cod_servicio = c_orden.p6
                       AND c.estado <> c_estado_inactivo
                       AND c.fch_fin = c_fecha_fin;

                    IF v_dummy = 0 THEN
                        po_cod_err := 'PVT-3148';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al invocar el procedimiento TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_SERVICIO.
                        tx_pvt_entidad_consumo.asignar_servicio
                                              (pi_id_entidad_consumo          => c_orden.id_entidad_consumo,
                                               pi_cod_servicio                => c_orden.p6,
                                               pi_complemento                 => NULL,
                                               pi_cod_usuario                 => pi_cod_usuario,
                                               pi_master                      => c_falso,
                                               pi_id_tran                     => v_id_tran,
                                               pi_cod_gestion_tran            => v_cod_gestion_tran,
                                               pi_fch_tran                    => v_fch_tran,
                                               pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                               po_id_tran                     => po_id_tran,
                                               po_cod_gestion_tran            => po_cod_gestion_tran,
                                               po_cod_err                     => po_cod_err,
                                               po_msj_err                     => po_msj_err
                                              );

                        IF po_cod_err <> 'OK' THEN
                            RAISE err_app;
                        END IF;
                    END IF;
                END IF;
            END LOOP;

            po_cod_err := 'PVT-3149';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al dar de baja las ordenes diferidas.

            UPDATE cl_orden_prv
               SET estado = c_estado_inactivo,
                   fch_fin = SYSDATE,
                   id_tran_fin = v_id_tran,
                   cod_gestion_tran_fin = v_cod_gestion_tran,
                   cod_usuario_fin = pi_cod_usuario
             WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
               AND id_tran_inicio = v_id_tran_prospecto
               AND fch_fin = c_fecha_fin
               AND estado = c_estado_activo;

            po_cod_err := 'PVT-5095'; --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al dar de baja las ordenes enviadas al VPG.
            FOR vpg_orders
                IN (SELECT id_orden
                      FROM vpg_orden
                     WHERE     id_entidad_consumo = c_cambio_plan.id_entidad_consumo
                           AND id_tran = v_id_tran_prospecto
                           AND estado_orden = 'D')
            LOOP
                tx_vpg_orden.baja (pi_id_orden             => vpg_orders.id_orden,
                                   pi_cod_usuario          => pi_cod_usuario,
                                   pi_master               => c_falso,
                                   pi_id_tran              => v_id_tran,
                                   pi_cod_gestion_tran     => v_cod_gestion_tran,
                                   pi_fch_tran             => v_fch_tran,
                                   pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                                   po_id_tran              => v_po_id_tran,
                                   po_fch_tran             => v_po_fch_tran,
                                   po_cod_err              => po_cod_err,
                                   po_msj_err              => po_msj_err);

                IF po_cod_err != 'OK'
                THEN
                    RAISE err_app;
                END IF;
            END LOOP;

            --Hacemos el reverso a nivel de ciclo de vida
            po_cod_err := 'PVT-5096';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al hacer reverso de cambio en ciclo de vida.
            tx_cl_lifecycle.revert_offer_change(
                                                 pi_internal_id        => pi_id_entidad_consumo,
                                                 pi_change_tran_id     => v_id_tran_prospecto,
                                                 pi_transaction_reason => 'OFFER_CHANGE_REVERSE',
                                                 pi_master             => c_falso,
                                                 pi_tran_id            => v_id_tran,
                                                 pi_tran_date          => v_fch_tran,
                                                 pi_tran_user          => pi_cod_usuario,
                                                 pi_tran_period        => v_cod_gestion_tran,
                                                 po_cod_err            => po_cod_err,
                                                 po_msj_err            => po_msj_err);

            IF po_cod_err != 'OK' THEN
               RAISE err_app;
            END IF;

            po_cod_err := 'PVT-3150';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al eliminar el servicio de la entidad de consumo.

            DELETE FROM cl_servicio_entidad_consumo
                  WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
                    AND id_tran_inicio = v_id_tran_prospecto
                    AND fch_fin = c_fecha_fin;

            po_cod_err := 'PVT-3151';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al actualizar el servicio de la entidad de consumo.

            UPDATE cl_servicio_entidad_consumo
               SET ultimo_registro = c_verdadero,
                   fch_fin = c_fecha_fin,
                   id_tran_fin = NULL,
                   cod_gestion_tran_fin = NULL,
                   cod_usuario_fin = NULL,
                   fch_efectiva_fin = c_fecha_fin
             WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
               AND id_tran_fin = v_id_tran_prospecto
               AND cod_servicio NOT IN (SELECT cod_servicio
                                          FROM cl_servicio_entidad_consumo
                                         WHERE id_entidad_consumo = c_cambio_plan.id_entidad_consumo
                                           AND fch_fin = c_fecha_fin);

            po_cod_err := 'PVT-3152';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al recuperar la descripcion del plan nuevo.

            SELECT descripcion
              INTO v_desc_plan_nuevo
              FROM bm_plan
             WHERE cod_plan = c_cambio_plan.cod_plan_anterior;

            po_cod_err := 'PVT-3153';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al recuperar la descripcion del plan anterior.

            SELECT descripcion
              INTO v_desc_plan_anterior
              FROM bm_plan
             WHERE cod_plan = c_cambio_plan.cod_plan;

            po_cod_err := 'PVT-3154';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al determinar el id del cliente.
            v_id_cliente           := get_id_cl (c_cambio_plan.id_comunidad);
            po_cod_err := 'PVT-3155';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al recuperar informacion del plan nuevo y anterior.
            v_trama_anterior_pv    :=    'Codigo:'
                                      || c_cambio_plan.cod_plan
                                      || '|'
                                      || 'Descripcion:'
                                      || v_desc_plan_anterior;
            v_trama_nuevo_pv       :=    'Codigo:'
                                      || c_cambio_plan.cod_plan_anterior
                                      || '|'
                                      || 'Descripcion:'
                                      || v_desc_plan_nuevo;
            --- Registrar transaccion
            po_cod_err := 'PVT-3156';   --TX_PVT_ENTIDAD_CONSUMO.REVERTIR_CAMBIO_PLAN: Error al invocar a CC_TX_TRANSACCION_POSTVENTA.ALTA.
            cc_tx_transaccion_postventa.alta
                                         (pi_id_tran                     => v_id_tran,
                                          pi_cod_gestion_tran            => v_cod_gestion_tran,
                                          pi_cod_tipo                    => c_tipo_transaccion,
                                          pi_id_cliente                  => v_id_cliente,
                                          pi_id_comunidad                => c_cambio_plan.id_comunidad,
                                          pi_id_entidad_consumo          => c_cambio_plan.id_entidad_consumo,
                                          pi_cod_motivo_transaccion      => NULL,
                                          pi_cod_observacion             => NULL,
                                          pi_descripcion_observacion     => NULL,
                                          pi_valor_anterior              => v_trama_anterior_pv,
                                          pi_valor_nuevo                 => v_trama_nuevo_pv,
                                          pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                          pi_fch_tran                    => v_fch_tran,
                                          pi_cod_usuario                 => pi_cod_usuario,
                                          po_cod_err                     => po_cod_err,
                                          po_msj_err                     => po_msj_err
                                         );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        END LOOP;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := NULL;
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END revertir_cambio_plan;

    FUNCTION get_procedencia_articulo (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_nro_serie              IN       inv_articulo_maestro.nro_serie%TYPE
    )
        RETURN VARCHAR2
    IS
        v_procedencia                 vta_articulo_prospecto.procedencia_articulo%TYPE;
    BEGIN
        SELECT procedencia_articulo
          INTO v_procedencia
          FROM (SELECT procedencia_articulo,
                       fch_tran,
                       MAX (fch_tran) OVER () max_fch_tran
                  FROM (SELECT va.procedencia_articulo,
                               va.fch_tran
                          FROM vta_articulo_prospecto va
                         WHERE va.nro_serie = pi_nro_serie
                           AND va.estado = c_estado_pagado
                           AND id_entidad_consumo = pi_id_entidad_consumo
                        UNION
                        SELECT va.procedencia_articulo,
                               va.fch_tran
                          FROM vta_articulo_prospecto va, vta_entidad_consumo v
                         WHERE va.nro_serie = pi_nro_serie
                           AND va.estado = c_estado_pagado
                           AND v.id_prospecto = va.id_prospecto_cliente
                           AND v.id_prospecto_ec = va.id_prospecto_ec
                           AND v.estado = c_estado_pagado
                           AND v.id_entidad_consumo = pi_id_entidad_consumo))
         WHERE fch_tran = max_fch_tran;

        RETURN v_procedencia;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RETURN NULL;
    END;

    PROCEDURE validar_pcs (
        pi_identificador_entidad  IN       cl_entidad_consumo.identificador_entidad%TYPE,
        po_estado                 OUT      VARCHAR2,
        po_cod_plan               OUT      VARCHAR2,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        err_tencologia                EXCEPTION;
        v_cod_tecnologia              cl_entidad_consumo.cod_tecnologia%TYPE;
    BEGIN
        SELECT ec.estado,
               ec.cod_forma_consumo,
               ec.cod_tecnologia
          INTO po_estado,
               po_cod_plan,
               v_cod_tecnologia
          FROM cl_entidad_consumo ec
         WHERE ec.identificador_entidad = pi_identificador_entidad
           AND ec.estado NOT IN ('I', 'TER', 'POR', 'POST');

        po_estado      := 'A';
        po_cod_plan    := v_cod_tecnologia || '_' || po_cod_plan;
        po_cod_err     := 'OK';
        po_msj_err     := NULL;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            po_cod_err := 'PVT-3157';   --TX_PVT_ENTIDAD_CONSUMO.VALIDAR_PCS: El suscriptor no esta activo o no existe.
            po_msj_err    := get_error (po_cod_err);
        WHEN OTHERS THEN
            po_cod_err := 'PVT-3158';   --TX_PVT_ENTIDAD_CONSUMO.VALIDAR_PCS: Error al recuperar los datos del suscriptor.
            po_msj_err    := get_sys_error (po_cod_err, SQLERRM);
    END;

    /***********************************************************************************************
    Purpose : [Procedimiento para la venta de un servicio (como la impresion del detalle de llamadas)]
    Date    : [2012-11-22 10:10:00]
    Author  : [Erick Choque Navia]

    #param pi_cod_servicio, Codigo del servicio (parametro de entrada)
    #param pi_id_entidad_consumo, Identificador de la entidad de consumo (parametro de entrada)
    #param pi_id_entidad_venta, Identificador de la entidad de venta (parametro de entrada)
    #param pi_es_pago_diferido, Si el pago es diferido (parametro de entrada)
    #param pi_tipo_procedencia, Tipo de procedencia de la solicitud (parametro de entrada)
    #param pi_parametros, Cadena de parametros de acuerdo al servicio (parametro de entrada)
    #param pi_cod_usuario, Codigo del usuario que ejecuta la transaccion (parametro de entrada)
    #param pi_master, 1 Si la transaccion es maestra, de lo contrario 0 (parametro de entrada)
    #param pi_id_tran, Identificador de la transaccion (parametro de entrada)
    #param pi_cod_gestion_tran, Codigo de gestion de la transaccion (parametro de entrada)
    #param pi_fch_tran, Fecha de la transaccion (parametro de entrada)
    #param pi_cod_unidad_negocio, Codigo de la unidad de negocio de la transaccion (parametro de entrada)

    #param po_id_tran, Identificador de la transaccion (parametro de salida)
    #param po_cod_gestion_tran, Codigo de la gestion de la transaccion (parametro de salida)
    #param po_cod_err, En caso de existir error devuelve el codigo de error, sino OK (parametro de salida)
    #param po_msj_err, En caso de existir error devuelve el mensaje de error, sino '' (parametro de salida)

    #Changes:
    <hr>
    Date    :
    Author  :
    Note    :
    <hr>
    ***********************************************************************************************/
    PROCEDURE venta_servicio (
        -- Input parameters
        pi_cod_servicio           IN       vta_venta_servicio.cod_servicio%TYPE,
        pi_id_entidad_consumo     IN       vta_venta_servicio.id_entidad_consumo%TYPE,
        pi_id_entidad_venta       IN       vta_venta_entidad.id_venta_entidad%TYPE,
        pi_es_pago_diferido       IN       vta_venta_servicio.es_pago_diferido%TYPE,
        pi_tipo_procedencia       IN       cnf_catalogo.cod_catalogo%TYPE,
        pi_solo_simular           IN       VARCHAR2,
        pi_parametros             IN       VARCHAR2,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        -- Output parameters
        po_precio_venta_sin_imp   OUT      vta_venta_prospecto_detalle.valor%TYPE,
        po_precio_venta_con_imp   OUT      vta_venta_prospecto_detalle.valor%TYPE,
        po_id_prospecto           OUT      vta_venta_servicio.id_prospecto%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes locales
        c_tipo_transaccion   CONSTANT cnf_constante.valor%TYPE
                                   := tx_cnf_constante.get_constante ('TRANSACCION_VENTA_SERVICIO');
        c_tipo_servicio_especial CONSTANT cnf_constante.valor%TYPE
                                 := tx_cnf_constante.get_constante ('TIPO_SERVICIO_ESPECIAL_VENTA');
        c_precio_x_hoja_det_llamadas CONSTANT cnf_constante.valor%TYPE
                               := tx_cnf_constante.get_constante ('PRECIO_X_HOJA_IMP_DET_LLAMADAS');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.VENTA_SERVICIO';
        v_nombre_tabla                VARCHAR2 (50) := 'VTA_VENTA_SERVICIO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables locales
        v_dummy                       NUMBER;
        v_tiene_costo                 NUMBER;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_reg_servicio                bm_servicio%ROWTYPE;
        v_parametro_01                vta_otros_servicios.p1%TYPE;
        v_parametro_02                vta_otros_servicios.p2%TYPE;
        v_parametro_03                vta_otros_servicios.p3%TYPE;
        v_parametro_04                vta_otros_servicios.p4%TYPE;
        v_parametro_05                vta_otros_servicios.p5%TYPE;
        v_parametro_06                vta_otros_servicios.p6%TYPE;
        v_parametro_07                vta_otros_servicios.p7%TYPE;
        v_parametro_08                vta_otros_servicios.p8%TYPE;
        v_parametro_09                vta_otros_servicios.p9%TYPE;
        v_parametro_10                vta_otros_servicios.p10%TYPE;
        v_id_reg_cargo_adicional      bl_cargo_adicional.id_registro%TYPE;
        v_cod_periodo_vigente         tr_periodo_facturacion.cod_periodo%TYPE;
        v_cod_linea_negocio           cl_comunidad.cod_linea_negocio%TYPE;
        v_cod_tipo_documento          cnf_cta_tipo_documento.cod_tipo_documento%TYPE;
        v_precio_venta_sin_imp        bm_plan_servicio.precio%TYPE;   --Precio del servicio SIN impuestos
        v_precio_venta_con_imp        bm_plan_servicio.precio%TYPE;   --Precio del servicio CON impuestos
        v_cod_categoria_documento     vta_venta_prospecto.cod_categoria_documento%TYPE;
        v_id_venta                    vta_venta_prospecto.id_venta%TYPE;
        v_id_venta_entidad            vta_venta_entidad.id_venta_entidad%TYPE;
        v_id_prospecto_detalle        vta_venta_prospecto_detalle.id_prospecto_detalle%TYPE;
        v_nombre_factura              VARCHAR2 (300);
        v_rnc_factura                 cl_persona.nit%TYPE;
        v_permiso_servicio            cnf_entidad.cod_entidad%TYPE;
        v_tiene_permiso               VARCHAR2 (10);
        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (pi_cod_entidad                 => v_cod_tran,
                                    po_reg_entidad                 => v_reg_entidad,
                                    po_rowid                       => v_rowid_entidad,
                                    po_cod_err                     => po_cod_err,
                                    po_msj_err                     => po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in                 :=
                                         ---------- parametros variables ------------------
                                         'pi_cod_servicio:'
                                      || pi_cod_servicio
                                      || '|'
                                      || 'pi_id_entidad_consumo:'
                                      || pi_id_entidad_consumo
                                      || '|'
                                      || 'pi_id_entidad_venta:'
                                      || pi_id_entidad_venta
                                      || '|'
                                      || 'pi_es_pago_diferido:'
                                      || pi_es_pago_diferido
                                      || '|'
                                      || 'pi_tipo_procedencia:'
                                      || pi_tipo_procedencia
                                      || '|'
                                      || 'pi_solo_simular:'
                                      || pi_solo_simular
                                      || '|'
                                      || 'pi_parametros:'
                                      || pi_parametros
                                      || '|'
                                      ||
                                         ---------- parametros obligatorios ---------------
                                         'pi_cod_usuario:'
                                      || pi_cod_usuario
                                      || '|'
                                      || 'pi_master:'
                                      || pi_master
                                      || '|'
                                      || 'pi_id_tran:'
                                      || pi_id_tran
                                      || '|'
                                      || 'pi_cod_gestion_tran:'
                                      || pi_cod_gestion_tran
                                      || '|'
                                      || 'pi_fch_tran:'
                                      || pi_fch_tran
                                      || '|'
                                      || 'pi_cod_unidad_negocio:'
                                      || pi_cod_unidad_negocio
                                      || '|'
                                      || 'usuario:'
                                      || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_cod_servicio IS NULL
           OR pi_id_entidad_consumo IS NULL
           OR pi_id_entidad_venta IS NULL
           OR pi_es_pago_diferido IS NULL
           OR pi_tipo_procedencia IS NULL
           OR pi_solo_simular IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_master IS NULL
           OR pi_cod_unidad_negocio IS NULL THEN
            po_cod_err := 'PVT-3159';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-3160';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-3161';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            po_id_tran                     => v_id_tran,
                                            po_cod_gestion_tran            => v_cod_gestion_tran,
                                            po_fch_tran                    => v_fch_tran,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran                 := v_id_tran;
        po_cod_gestion_tran        := v_cod_gestion_tran;
        -------------------------------- INICIO LOGICA ----------------------------
        po_cod_err := 'PVT-3162';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al consultar el permiso requerido para el servicio.

        SELECT eh.cod_entidad
          INTO v_permiso_servicio
          FROM cnf_subentidad ep, cnf_entidad eh
         WHERE ep.cod_entidad_padre = c_tipo_transaccion
           AND ep.cod_entidad = eh.cod_entidad
           AND eh.ruta = pi_cod_servicio;

        tx_seg_sesion.get_permiso (pi_cod_usuario                 => pi_cod_usuario,
                                   pi_cod_entidad                 => v_permiso_servicio,
                                   pi_cod_usuario_tran            => pi_cod_usuario,
                                   po_permiso                     => v_tiene_permiso,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        IF v_tiene_permiso = c_falso THEN
            po_cod_err := 'PVT-3163';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: No tiene permisos para este servicio.
            RAISE err_app;
        END IF;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR INACTIVA
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        SELECT COUNT (1)
          INTO v_dummy
          FROM bm_servicio
         WHERE cod_servicio = pi_cod_servicio
           AND cod_tipo_servicio = c_tipo_servicio_especial
           AND estado = c_estado_activo;

        IF v_dummy = 0 THEN
            po_cod_err := 'PVT-3164';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El servicio no esta configurado o esta inactivo.
            RAISE err_app;
        END IF;

        IF pi_cod_servicio = 'SEIMCE' THEN
            po_cod_err := 'PVT-3165';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Para generar la certificacion prrepago debe haber un Supervisor de Tienda.
            SELECT 1
              INTO v_dummy
              FROM (SELECT   per.nombres || ' ' || per.apellido_paterno
                FROM inv_usuario_entidad_venta inv,
                     seg_rol_usuario rol,
                     seg_usuario usr,
                     seg_personal per
               WHERE inv.fch_fin = c_fecha_fin
                 AND inv.estado = c_estado_activo
                 AND rol.cod_usuario = inv.cod_usuario
                 AND rol.fch_fin = c_fecha_fin
                 AND rol.cod_rol IN ('RLSUTI04')
                 AND inv.id_entidad_venta = pi_id_entidad_venta
                 AND usr.cod_usuario = inv.cod_usuario
                 AND usr.cod_personal = per.cod_personal
                ORDER BY per.fch_tran)
             WHERE ROWNUM <= 1;

        END IF;

        po_cod_err := 'PVT-3166';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al obtener informacion del servicio.

        SELECT *
          INTO v_reg_servicio
          FROM bm_servicio
         WHERE cod_servicio = pi_cod_servicio
           AND cod_tipo_servicio = c_tipo_servicio_especial
           AND estado = c_estado_activo;

        SELECT COUNT (1)
          INTO v_dummy
          FROM vta_venta_servicio
         WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
           AND estado = c_estado_activo
           AND fch_fin = c_fecha_fin;

        IF v_dummy > 0 THEN
            po_cod_err := 'PVT-3167';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El suscriptor tiene un prospecto pendiente.
            RAISE err_app;
        END IF;

        SELECT COUNT (1)
          INTO v_dummy
          FROM cnf_catalogo
         WHERE cod_catalogo = pi_tipo_procedencia
           AND cod_entidad = 'VTA_TIPO_PROCEDENCIA'
           AND estado = c_estado_activo
           AND fch_fin = c_fecha_fin;

        IF v_dummy = 0 THEN
            po_cod_err := 'PVT-3168';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El tipo de procedencia de la asignacion del servicio no es valido.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3169';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al recuperar el tipo de documento del servicio.

        SELECT cod_tipo_documento
          INTO v_cod_tipo_documento
          FROM cnf_cta_tipo_documento
         WHERE categoria_documento = 'CPS'
           AND id_cargo = v_reg_servicio.id_cargo
           AND estado = c_estado_activo
           AND fch_fin = c_fecha_fin;

        IF v_cod_tipo_documento IS NULL THEN
            po_cod_err := 'PVT-3170';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El tipo de documento no esta configurado.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3171';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El durante el desglose de los parametros.

        IF pi_parametros IS NOT NULL THEN
            FOR c_param IN (SELECT ROWNUM AS orden,
                                   valor
                              FROM TABLE (tx_utiles.SPLIT (pi_parametros)))
            LOOP
                CASE
                    WHEN c_param.orden = 1 THEN
                        v_parametro_01    := c_param.valor;
                    WHEN c_param.orden = 2 THEN
                        v_parametro_02    := c_param.valor;
                    WHEN c_param.orden = 3 THEN
                        v_parametro_03    := c_param.valor;
                    WHEN c_param.orden = 4 THEN
                        v_parametro_04    := c_param.valor;
                    WHEN c_param.orden = 5 THEN
                        v_parametro_05    := c_param.valor;
                    WHEN c_param.orden = 6 THEN
                        v_parametro_06    := c_param.valor;
                    WHEN c_param.orden = 7 THEN
                        v_parametro_07    := c_param.valor;
                    WHEN c_param.orden = 8 THEN
                        v_parametro_08    := c_param.valor;
                    WHEN c_param.orden = 9 THEN
                        v_parametro_09    := c_param.valor;
                    WHEN c_param.orden = 10 THEN
                        v_parametro_10    := c_param.valor;
                    ELSE
                        NULL;
                END CASE;
            END LOOP;
        END IF;

        IF v_parametro_10 IS NULL THEN
            v_parametro_10    := pi_tipo_procedencia;
        ELSE
            v_parametro_10    := v_parametro_10 || ',' || pi_tipo_procedencia;
        END IF;

        po_cod_err := 'PVT-3172';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al obtener la linea de negocio de la cuenta.

        SELECT c.cod_linea_negocio
          INTO v_cod_linea_negocio
          FROM cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        po_cod_err := 'PVT-3173';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al determinar el periodo de facturacion.

        SELECT p.cod_periodo
          INTO v_cod_periodo_vigente
          FROM tr_periodo_facturacion p, cl_comunidad c
         WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
           AND c.cod_ciclo_facturacion = p.cod_ciclo_facturacion
           AND p.vigente = c_verdadero
           AND p.estado <> c_estado_inactivo;

        -- Calculando el costo por el servicio.
        v_precio_venta_sin_imp     := NULL;
        v_precio_venta_con_imp     := NULL;

        -- Verificando configuracion extra por Servicio.
        IF v_reg_servicio.cod_servicio = 'IMDEFA' THEN
            IF pi_tipo_procedencia NOT IN ('VTPPVT') THEN
                po_cod_err := 'PVT-3174';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El presente servicio no puede ser activado por este medio.
                RAISE err_app;
            END IF;

            IF    pi_parametros IS NULL
               OR v_parametro_01 IS NULL
               OR v_parametro_02 IS NULL
               OR v_parametro_03 IS NULL THEN
                po_cod_err := 'PVT-3175';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El servicio requiere de parametros extras que no estan siendo enviados.
                RAISE err_app;
            END IF;

            SELECT COUNT (1)
              INTO v_dummy
              FROM tr_periodo_facturacion p, cl_comunidad c
             WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
               AND c.cod_ciclo_facturacion = p.cod_ciclo_facturacion
               AND p.cod_periodo = v_parametro_02
               AND p.estado <> c_estado_inactivo;

            IF v_dummy = 0 THEN
                po_cod_err := 'PVT-3176';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El periodo ingresado o seleccionado no es valido.
                RAISE err_app;
            END IF;

            -- Verificamos si tiene el feature de DETALLE DE LLAMADAS
            IF v_cod_linea_negocio NOT IN (c_linea_negocio_prepago, 'EXTERN', 'CCARD') THEN   --INTPRE
                IF v_cod_periodo_vigente = v_parametro_02 THEN
                    SELECT COUNT (1)
                      INTO v_tiene_costo
                      FROM cl_comunidad c,
                           tr_periodo_facturacion pf,
                           cl_servicio_entidad_consumo sec
                     WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                       AND pf.cod_ciclo_facturacion = c.cod_ciclo_facturacion
                       AND pf.cod_periodo = v_parametro_02
                       AND sec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                       AND sec.cod_servicio = 'DETL'
                       AND sec.estado = c_estado_activo
                       AND sec.ultimo_registro = c_registro_ultimo
                       AND sec.fch_fin = c_fecha_fin;
                ELSE
                    SELECT COUNT (1)
                      INTO v_tiene_costo
                      FROM cl_comunidad c,
                           tr_periodo_facturacion pf,
                           cl_servicio_entidad_consumo sec
                     WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                       AND pf.cod_ciclo_facturacion = c.cod_ciclo_facturacion
                       AND pf.cod_periodo = v_parametro_02
                       AND sec.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
                       AND sec.cod_servicio = 'DETL'
                       AND pf.fch_fin BETWEEN sec.fch_inicio AND sec.fch_fin;
                END IF;
            ELSE
                v_tiene_costo    := 0;
            END IF;

            -- Verificamos si el suscriptor ya imprimio el detalle de llamadas de un periodo.
            SELECT v_tiene_costo + COUNT (1)
              INTO v_tiene_costo
              FROM vta_venta_servicio vs, vta_otros_servicios vos
             WHERE vs.id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
               AND vs.cod_servicio = pi_cod_servicio
               AND vs.estado = c_estado_pagado
               AND vs.id_prospecto = vos.id_prospecto
               AND vs.id_prospecto = vos.id_prospecto_ec
               AND vs.cod_servicio = vos.cod_servicio
               AND vos.p2 = v_parametro_02;

            -- La primera vez, este servicio no tiene costo.
            IF v_tiene_costo = 0 THEN
                v_precio_venta_sin_imp    := 0;
            ELSE
                po_cod_err := 'PVT-3177';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error durante el calculo del costo del servicio.
                v_precio_venta_sin_imp    :=   TO_NUMBER (c_precio_x_hoja_det_llamadas)
                                             * TO_NUMBER (v_parametro_01);
            END IF;
        ELSIF v_reg_servicio.cod_servicio = 'SEIMCE' THEN
            IF pi_tipo_procedencia NOT IN ('VTPPVT') THEN
                po_cod_err := 'PVT-3178';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El presente servicio no puede ser activado por este medio.
                RAISE err_app;
            END IF;


            IF tx_pvt_utils.aplica_cobro_certificacion_pre(pi_id_entidad_consumo) = c_verdadero THEN
                po_cod_err := 'PVT-3179';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al obtener el precio del articulo.
                SELECT p.precio
                  INTO v_precio_venta_sin_imp
                  FROM bl_cargo_precio p
                 WHERE p.id_cargo = v_reg_servicio.id_cargo;
            ELSE
                v_precio_venta_sin_imp  := 0;
            END IF;

        ELSE
            po_cod_err := 'PVT-3180';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: El servicio actualmente no esta configurado.
            RAISE err_app;
        END IF;

        BEGIN
            SAVEPOINT prospectos;

            -- Crear cargo diferido a la factura.
            IF pi_es_pago_diferido = c_verdadero THEN
                IF     v_cod_linea_negocio NOT IN ('POSCOR', 'FIJCOR')
                   AND v_reg_servicio.cod_servicio NOT IN ('IMDEFA') THEN
                    po_cod_err := 'PVT-3181';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Solo lineas corporativas pueden diferir a su factura.
                    RAISE err_app;
                ELSIF     v_reg_entidad_consumo.cod_forma_consumo = c_forma_consumo_prepago
                      AND v_reg_servicio.cod_servicio NOT IN ('IMDEFA') THEN
                    IF v_cod_linea_negocio IN (c_linea_negocio_prepago, 'EXTERN', 'CCARD') THEN
                        po_cod_err := 'PVT-3182';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: No se pueden realizar cargos diferidos a la factura de lineas prepago.
                        RAISE err_app;
                    END IF;
                -- si es linea prepago no aplica
                ELSIF     v_cod_linea_negocio IN ('EXTERN', 'PREPAG', 'INTPRE')
                      AND v_reg_servicio.cod_servicio IN ('IMDEFA') THEN
                    po_cod_err := 'PVT-3183';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Planes prepago no tienen opcion a diferir a su factura.
                    RAISE err_app;
                END IF;

                po_cod_err := 'PVT-3184';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al invocar al procedimiento de registro del cargo del cargo.
                cc_bl_cargo_adicional.alta
                       (pi_cod_periodo_inicio          => v_cod_periodo_vigente,
                        pi_cod_periodo_fin             => v_cod_periodo_vigente,
                        pi_id_cliente                  => get_id_cl
                                                              (v_reg_entidad_consumo.id_comunidad_facturante),
                        pi_id_comunidad_facturante     => v_reg_entidad_consumo.id_comunidad_facturante,
                        pi_id_entidad_consumo          => pi_id_entidad_consumo,
                        pi_id_cargo                    => v_reg_servicio.id_cargo,
                        pi_valor                       => v_precio_venta_sin_imp,   -- <- Valor Sin Impuestos
                        pi_cod_usuario                 => pi_cod_usuario,
                        pi_id_tran                     => v_id_tran,
                        pi_cod_gestion_tran            => v_cod_gestion_tran,
                        pi_fch_tran                    => v_fch_tran,
                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                        po_id_registro                 => v_id_reg_cargo_adicional,
                        po_cod_err                     => po_cod_err,
                        po_msj_err                     => po_msj_err
                       );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;

                v_precio_venta_sin_imp    := 0;
            END IF;

            -- Insercion en la tabla VTA_VENTA_SERVICIO
            po_cod_err := 'PVT-3185';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al invocar al procedimiento CC_VTA_VENTA_SERVICIO.ALTA.
            cc_vta_venta_servicio.alta
                                 (pi_id_prospecto_cli            => NULL,
                                  pi_id_prospecto_ec             => NULL,
                                  pi_cod_servicio                => pi_cod_servicio,
                                  pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                  pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                  pi_precio_venta                => v_precio_venta_sin_imp,
                                  pi_es_pago_diferido            => pi_es_pago_diferido,
                                  pi_estado                      => c_estado_activo,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  pi_es_asignar                  => c_verdadero,
                                  pi_id_prospecto_ceq            => NULL,
                                  po_id_prospecto                => po_id_prospecto,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            -- Insercion en la tabla de vta_otros_servicios
            po_cod_err := 'PVT-3186';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al invocar al procedimiento CC_VTA_OTROS_SERVICIOS.ALTA.
            cc_vta_otros_servicios.alta (pi_id_prospecto                => po_id_prospecto,
                                         pi_id_prospecto_ec             => po_id_prospecto,
                                         pi_id_servicio                 => pi_cod_servicio,
                                         pi_1                           => v_parametro_01,
                                         pi_2                           => v_parametro_02,
                                         pi_3                           => v_parametro_03,
                                         pi_4                           => v_parametro_04,
                                         pi_5                           => v_parametro_05,
                                         pi_6                           => v_parametro_06,
                                         pi_7                           => v_parametro_07,
                                         pi_8                           => v_parametro_08,
                                         pi_9                           => v_parametro_09,
                                         pi_10                          => v_parametro_10,
                                         pi_cod_usuario                 => pi_cod_usuario,
                                         pi_id_tran                     => v_id_tran,
                                         pi_cod_gestion_tran            => v_cod_gestion_tran,
                                         pi_fch_tran                    => v_fch_tran,
                                         pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                         po_cod_err                     => po_cod_err,
                                         po_msj_err                     => po_msj_err
                                        );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            -- REGISTRO DE LA ENTIDAD VENTA
            po_cod_err := 'PVT-3187';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al invocar al procedimiento CC_VTA_VENTA_ENTIDAD.ALTA.
            cc_vta_venta_entidad.alta (pio_id_prospecto               => po_id_prospecto,
                                       pi_cod_tipo_venta              => c_tipo_transaccion,   --pi_cod_servicio,
                                       pi_id_entidad_venta            => pi_id_entidad_venta,
                                       pi_cod_usuario_asignado        => pi_cod_usuario,
                                       pi_cod_usuario_digitador       => pi_cod_usuario,
                                       pi_fch_venta                   => v_fch_tran,
                                       pi_cod_usuario                 => pi_cod_usuario,
                                       pi_id_tran                     => v_id_tran,
                                       pi_cod_gestion_tran            => v_cod_gestion_tran,
                                       pi_fch_tran                    => v_fch_tran,
                                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                       po_id_venta_entidad            => v_id_venta_entidad,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            BEGIN
                po_cod_err := 'PVT-3188';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al recuperar el RNC y nombre a facturar.

                SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                       p.nit
                  INTO v_nombre_factura,
                       v_rnc_factura
                  FROM cl_persona p, cl_datos_facturacion df
                 WHERE df.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante
                   AND df.id_persona = p.id_persona
                   AND df.estado <> c_estado_inactivo
                   AND df.fch_fin = c_fecha_fin;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    po_cod_err := 'PVT-3189';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al recuperar el RNC y nombre a facturar.

                    SELECT p.nombre || ' ' || p.apellido_paterno || ' ' || p.apellido_materno,
                           p.nit
                      INTO v_nombre_factura,
                           v_rnc_factura
                      FROM cl_persona p, cl_cliente c
                     WHERE c.id_cliente = get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante)
                       AND p.id_persona = c.id_persona;
            END;

            IF pi_es_pago_diferido = c_verdadero THEN
                v_cod_categoria_documento    := NULL;
            ELSE
                po_cod_err := 'PVT-3190';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al invocar al procedimiento TX_BL_DOSIFICACION.GET_COD_CATEGORIA_DOCUMENTO.
                tx_bl_dosificacion.get_cod_categoria_documento
                                 (pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                  po_cod_categoria_documento     => v_cod_categoria_documento,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err);

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            END IF;

            po_cod_err := 'PVT-3191';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al invocar a TX_PVT_CCS.ALTA_VENTA_DETALLE.
            tx_pvt_ccs.alta_venta_detalle
                (pio_id_venta                   => v_id_venta,
                 pi_id_prospecto                => po_id_prospecto,
                 pi_id_cargo                    => v_reg_servicio.id_cargo,   -- v_id_cargo_documento,
                 pi_cod_tipo_documento          => v_cod_tipo_documento,
                 pi_valor_venta                 => v_precio_venta_sin_imp,
                 pi_solo_simular                => pi_solo_simular,   -- Si es 1 es solo para hacer el calculo del costo.
                 pi_cod_tipo                    => 'E',
                 pi_estado                      => c_estado_activo,
                 pi_cod_usuario                 => pi_cod_usuario,
                 pi_master                      => c_falso,
                 pi_id_tran                     => v_id_tran,
                 pi_cod_gestion_tran            => v_cod_gestion_tran,
                 pi_fch_tran                    => v_fch_tran,
                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                 po_valor                       => v_precio_venta_con_imp,
                 po_id_prospecto_detalle        => v_id_prospecto_detalle,
                 po_cod_err                     => po_cod_err,
                 po_msj_err                     => po_msj_err
                );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            IF pi_solo_simular = c_falso THEN
                po_cod_err := 'PVT-3192';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al invocar al procedimiento de registro del prospecto de venta.
                tx_pvt_ccs.alta_venta (pi_id_prospecto                => po_id_prospecto,
                                       pi_nombre_factura              => v_nombre_factura,
                                       pi_nit                         => v_rnc_factura,
                                       pi_cod_categoria_documento     => v_cod_categoria_documento,
                                       pi_estado                      => c_estado_activo,
                                       pi_cod_usuario                 => pi_cod_usuario,
                                       pi_master                      => c_falso,
                                       pi_id_tran                     => v_id_tran,
                                       pi_cod_gestion_tran            => v_cod_gestion_tran,
                                       pi_fch_tran                    => v_fch_tran,
                                       pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                       po_valor                       => v_precio_venta_con_imp,
                                       po_cod_err                     => po_cod_err,
                                       po_msj_err                     => po_msj_err
                                      );

                IF po_cod_err != 'OK' THEN
                    RAISE err_app;
                END IF;
            ELSE
                ROLLBACK TO prospectos;
            END IF;
        END;

        IF     pi_solo_simular = c_falso
           AND (pi_es_pago_diferido = c_verdadero OR v_precio_venta_con_imp = 0) THEN
            po_cod_err := 'PVT-3193';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO: Error al invocar al procedimiento TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION.
            tx_pvt_entidad_consumo.venta_servicio_consolidacion
                                                   (pi_id_prospecto                => po_id_prospecto,
                                                    pi_master                      => c_falso,
                                                    pi_cod_usuario                 => pi_cod_usuario,
                                                    pi_id_tran                     => v_id_tran,
                                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                    pi_fch_tran                    => v_fch_tran,
                                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                    po_cod_err                     => po_cod_err,
                                                    po_msj_err                     => po_msj_err
                                                   );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        po_precio_venta_sin_imp    := v_precio_venta_sin_imp;
        po_precio_venta_con_imp    := v_precio_venta_con_imp;
--------------------------------- FIN LOGICA ------------------------------
-- Formar el PK del registro
        v_pk_registro              :=    'po_id_prospecto:'
                                      || po_id_prospecto
                                      || '|'
                                      || 'id_tran:'
                                      || po_id_tran;
        po_cod_err                 := 'OK';
        po_msj_err                 := NULL;
        -- Inicializar variables para logs, trama de salida
        v_trama_out                :=    'po_precio_venta_sin_imp:'
                                      || po_precio_venta_sin_imp
                                      || '|'
                                      || 'po_precio_venta_con_imp:'
                                      || po_precio_venta_con_imp
                                      || '|'
                                      || 'po_id_prospecto:'
                                      || po_id_prospecto
                                      || '|'
                                      || 'po_id_tran:'
                                      || po_id_tran
                                      || '|'
                                      || 'po_cod_gestion_tran:'
                                      || po_cod_gestion_tran
                                      || '|'
                                      ||
                                         ---------- parametros obligatorios ---------------
                                         'po_cod_err:'
                                      || po_cod_err
                                      || '|'
                                      || 'po_msj_err:'
                                      || po_msj_err;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (pi_id_tran                     => v_id_tran,
                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            pi_cod_transaccion             => v_cod_tran,
                                            pi_fch_tran                    => v_fch_tran,
                                            pi_cod_usuario                 => pi_cod_usuario,
                                            pi_param_in                    => v_trama_in,
                                            pi_param_out                   => v_trama_out,
                                            pi_master                      => c_verdadero,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- Registrar el log
        tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                             pi_cod_gestion_tran            => pi_cod_gestion_tran,
                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                             pi_nombre_tabla                => v_nombre_tabla,
                             pi_pk_registro                 => v_pk_registro,
                             pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                             pi_cod_usuario                 => pi_cod_usuario,
                             pi_trama_in                    => v_trama_in,
                             pi_trama_out                   => v_trama_out,
                             pi_cod_err                     => po_cod_err,
                             pi_msj_err                     => po_msj_err,
                             pi_log_file                    => v_reg_entidad.log_file,
                             pi_log_tabla                   => v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    := NULL;
            -- Registro de log
            tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                                 pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 pi_nombre_tabla                => v_nombre_tabla,
                                 pi_pk_registro                 => v_pk_registro,
                                 pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_trama_in                    => v_trama_in,
                                 pi_trama_out                   => v_trama_out,
                                 pi_cod_err                     => po_cod_err,
                                 pi_msj_err                     => po_msj_err,
                                 pi_log_file                    => v_reg_entidad.log_file,
                                 pi_log_tabla                   => v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    := NULL;
            -- Registro de log
            tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                                 pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 pi_nombre_tabla                => v_nombre_tabla,
                                 pi_pk_registro                 => v_pk_registro,
                                 pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_trama_in                    => v_trama_in,
                                 pi_trama_out                   => v_trama_out,
                                 pi_cod_err                     => po_cod_err,
                                 pi_msj_err                     => po_msj_err,
                                 pi_log_file                    => v_reg_entidad.log_file,
                                 pi_log_tabla                   => v_reg_entidad.log_table
                                );
    END venta_servicio;

    /***********************************************************************************************
    Purpose : [Procedimiento para la consolidacion de la venta de un servicio (como la impresion del detalle de llamadas)]
    Date    : [2012-11-26 14:10:00]
    Author  : [Erick Choque Navia]

    #param pi_id_prospecto, Identificador del prospecto de venta del servicio (parametro de entrada)
    #param pi_master, 1 Si la transaccion es maestra, de lo contrario 0 (parametro de entrada)
    #param pi_cod_usuario, Codigo del usuario que ejecuta la transaccion (parametro de entrada)
    #param pi_id_tran, Identificador de la transaccion (parametro de entrada)
    #param pi_cod_gestion_tran, Codigo de gestion de la transaccion (parametro de entrada)
    #param pi_fch_tran, Fecha de la transaccion (parametro de entrada)
    #param pi_cod_unidad_negocio, Codigo de la unidad de negocio de la transaccion (parametro de entrada)

    #param po_cod_err, En caso de existir error devuelve el codigo de error, sino OK (parametro de salida)
    #param po_msj_err, En caso de existir error devuelve el mensaje de error, sino '' (parametro de salida)

    #Changes:
    <hr>
    Date    :
    Author  :
    Note    :
    <hr>
    ***********************************************************************************************/
    PROCEDURE venta_servicio_consolidacion (
        -- Input parameters
        pi_id_prospecto           IN       vta_venta_servicio.id_prospecto%TYPE,
        pi_master                 IN       VARCHAR2,
        pi_cod_usuario            IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        -- Output parameters
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes locales
        c_tipo_transaccion   CONSTANT cnf_constante.valor%TYPE
                                   := tx_cnf_constante.get_constante ('TRANSACCION_VENTA_SERVICIO');
        c_tipo_servicio_especial CONSTANT cnf_constante.valor%TYPE
                                 := tx_cnf_constante.get_constante ('TIPO_SERVICIO_ESPECIAL_VENTA');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;   -- v_cod_ent || '.VENTA_SERVICIO_CONSOLIDACION';
        v_nombre_tabla                VARCHAR2 (50) := 'VTA_VENTA_SERVICIO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables locales
        v_reg_servicio                bm_servicio%ROWTYPE;
        v_reg_venta_servicio          vta_venta_servicio%ROWTYPE;
        v_reg_otros_servicios         vta_otros_servicios%ROWTYPE;
        v_reg_venta_prospecto         vta_venta_prospecto%ROWTYPE;
        v_procedencia                 cnf_catalogo.descripcion%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (pi_cod_entidad                 => v_cod_tran,
                                    po_reg_entidad                 => v_reg_entidad,
                                    po_rowid                       => v_rowid_entidad,
                                    po_cod_err                     => po_cod_err,
                                    po_msj_err                     => po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=
                                     ---------- parametros variables ------------------
                                     'pi_id_prospecto:'
                                  || pi_id_prospecto
                                  || '|'
                                  ||
                                     ---------- parametros obligatorios ---------------
                                     'pi_master:'
                                  || pi_master
                                  || '|'
                                  || 'pi_cod_usuario:'
                                  || pi_cod_usuario
                                  || '|'
                                  || 'pi_id_tran:'
                                  || pi_id_tran
                                  || '|'
                                  || 'pi_cod_gestion_tran:'
                                  || pi_cod_gestion_tran
                                  || '|'
                                  || 'pi_fch_tran:'
                                  || pi_fch_tran
                                  || '|'
                                  || 'pi_cod_unidad_negocio:'
                                  || pi_cod_unidad_negocio
                                  || '|'
                                  || 'usuario:'
                                  || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_prospecto IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_master IS NULL
           OR pi_cod_unidad_negocio IS NULL THEN
            po_cod_err := 'PVT-3194';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-3195';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-3196';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            po_id_tran                     => v_id_tran,
                                            po_cod_gestion_tran            => v_cod_gestion_tran,
                                            po_fch_tran                    => v_fch_tran,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -------------------------------- INICIO LOGICA ----------------------------
        po_cod_err := 'PVT-3197';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Error al obtener informacion del prospecto.

        SELECT *
          INTO v_reg_venta_servicio
          FROM vta_venta_servicio
         WHERE id_prospecto = pi_id_prospecto AND estado = c_estado_activo AND fch_fin = c_fecha_fin;

        po_cod_err := 'PVT-3198';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Error al obtener informacion adicional del prospecto.

        SELECT *
          INTO v_reg_otros_servicios
          FROM vta_otros_servicios
         WHERE id_prospecto = pi_id_prospecto AND cod_servicio = v_reg_venta_servicio.cod_servicio;

        po_cod_err := 'PVT-3199';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Error al recuperar informacion del servicio.

        SELECT *
          INTO v_reg_servicio
          FROM bm_servicio
         WHERE cod_servicio = v_reg_venta_servicio.cod_servicio
           AND cod_tipo_servicio = c_tipo_servicio_especial
           AND estado = c_estado_activo;

        BEGIN
            po_cod_err := 'PVT-3200';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Error al obtener id_venta del prospecto.

            SELECT *
              INTO v_reg_venta_prospecto
              FROM vta_venta_prospecto
             WHERE id_prospecto = pi_id_prospecto;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                RAISE err_app;
        END;

        -- Cambiar estado al prospecto
        po_cod_err := 'PVT-3201';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Error al invocar a CC_VTA_VENTA_PROSPECTO.CAMBIAR_ESTADO.
        cc_vta_venta_prospecto.cambia_estado (pi_id_venta                    => v_reg_venta_prospecto.id_venta,
                                              pi_estado                      => c_estado_pagado,
                                              pi_cod_usuario                 => pi_cod_usuario,
                                              pi_id_tran                     => v_id_tran,
                                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                                              pi_fch_tran                    => v_fch_tran,
                                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                              po_cod_err                     => po_cod_err,
                                              po_msj_err                     => po_msj_err
                                             );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        -- Cambiar estado a los detalles del prospecto
        po_cod_err := 'PVT-3202';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Error al invocar a CC_VTA_VENTA_PROSPECTO_DETALLE.CAMBIAR_ESTADO.
        cc_vta_venta_prospecto_detalle.cambia_estado
                                                    (pi_id_venta                    => v_reg_venta_prospecto.id_venta,
                                                     pi_id_prospecto                => pi_id_prospecto,
                                                     pi_id_cargo                    => v_reg_servicio.id_cargo,
                                                     pi_id_prospecto_ec             => NULL,
                                                     pi_id_prospecto_art            => NULL,
                                                     pi_id_prospecto_car            => NULL,
                                                     pi_estado                      => c_estado_pagado,
                                                     pi_cod_usuario                 => pi_cod_usuario,
                                                     pi_id_tran                     => v_id_tran,
                                                     pi_cod_gestion_tran            => v_cod_gestion_tran,
                                                     pi_fch_tran                    => v_fch_tran,
                                                     pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                     po_cod_err                     => po_cod_err,
                                                     po_msj_err                     => po_msj_err
                                                    );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3203';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Error al invocar al procedimiento CC_VTA_ARTICULO_PROSPECTO.CAMBIA_ESTADO.
        cc_vta_venta_servicio.cambia_estado (pi_id_prospecto                => pi_id_prospecto,
                                             pi_estado                      => c_estado_pagado,
                                             pi_cod_usuario                 => pi_cod_usuario,
                                             pi_id_tran                     => v_id_tran,
                                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                                             pi_fch_tran                    => v_fch_tran,
                                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                             po_cod_err                     => po_cod_err,
                                             po_msj_err                     => po_msj_err
                                            );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --REGISTRO TRANSACCIONAL POSTVENTA
        v_trama_nuevo_pv       :=    'Cod. Servicio:'
                                  || v_reg_servicio.cod_servicio
                                  || '|'
                                  || 'Servicio:'
                                  || v_reg_servicio.descripcion
                                  || '|'
                                  || 'Precio:'
                                  || v_reg_venta_prospecto.valor_venta
                                  || '|'
                                  || 'Precio Venta:'
                                  || v_reg_venta_prospecto.valor
                                  || '|'
                                  || 'Pago Diferido:'
                                  || CASE
                                         WHEN v_reg_venta_servicio.es_pago_diferido = c_verdadero THEN 'SI'
                                         ELSE 'NO'
                                     END;
        v_trama_anterior_pv    :=    'Cod. Servicio:-'
                                  || '|'
                                  || 'Servicio:-'
                                  || '|'
                                  || 'Precio:-'
                                  || '|'
                                  || 'Precio Venta:-'
                                  || '|'
                                  || 'Pago Diferido:-';

        IF v_reg_otros_servicios.p10 IS NOT NULL THEN
            po_cod_err := 'PVT-3204';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Error al determinar la procedencia de la transaccion.

            SELECT descripcion
              INTO v_procedencia
              FROM cnf_catalogo
             WHERE cod_catalogo = SUBSTR (v_reg_otros_servicios.p10,
                                          INSTR (v_reg_otros_servicios.p10, ',', -1, 1) + 1)
               AND cod_entidad = 'VTA_TIPO_PROCEDENCIA'
               AND estado = c_estado_activo
               AND fch_fin = c_fecha_fin;

            v_trama_nuevo_pv       := v_trama_nuevo_pv || '|' || 'Procedencia:' || v_procedencia;
            v_trama_anterior_pv    := v_trama_anterior_pv || '|' || 'Procedencia:-';
        END IF;

        IF v_reg_servicio.cod_servicio = 'IMDEFA' THEN
            v_trama_nuevo_pv       :=    v_trama_nuevo_pv
                                      || '|'
                                      || 'Nro. Paginas:'
                                      || v_reg_otros_servicios.p1
                                      || '|'
                                      || 'Cod. Periodo:'
                                      || v_reg_otros_servicios.p2;
            v_trama_anterior_pv    :=    v_trama_anterior_pv
                                      || '|'
                                      || 'Nro. Paginas:-'
                                      || '|'
                                      || 'Cod. Periodo:-';
        END IF;

        po_cod_err := 'PVT-3205';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_SERVICIO_CONSOLIDACION: Error al invocar al procedimiento de registro del log de transacciones Postvena.
        cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => get_id_cl
                                                                         (v_reg_venta_servicio.id_comunidad),
                                   pi_id_comunidad                => v_reg_venta_servicio.id_comunidad,
                                   pi_id_entidad_consumo          => v_reg_venta_servicio.id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => NULL,
                                   pi_descripcion_observacion     => NULL,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

--------------------------------- FIN LOGICA ------------------------------
-- Formar el PK del registro
        v_pk_registro          := NULL;
        po_cod_err             := 'OK';
        po_msj_err             := NULL;
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                                   'po_cod_err:' || po_cod_err || '|' || 'po_msj_err:' || po_msj_err;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (pi_id_tran                     => v_id_tran,
                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            pi_cod_transaccion             => v_cod_tran,
                                            pi_fch_tran                    => v_fch_tran,
                                            pi_cod_usuario                 => pi_cod_usuario,
                                            pi_param_in                    => v_trama_in,
                                            pi_param_out                   => v_trama_out,
                                            pi_master                      => c_verdadero,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- Registrar el log
        tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                             pi_cod_gestion_tran            => pi_cod_gestion_tran,
                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                             pi_nombre_tabla                => v_nombre_tabla,
                             pi_pk_registro                 => v_pk_registro,
                             pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                             pi_cod_usuario                 => pi_cod_usuario,
                             pi_trama_in                    => v_trama_in,
                             pi_trama_out                   => v_trama_out,
                             pi_cod_err                     => po_cod_err,
                             pi_msj_err                     => po_msj_err,
                             pi_log_file                    => v_reg_entidad.log_file,
                             pi_log_tabla                   => v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    := NULL;
            -- Registro de log
            tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                                 pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 pi_nombre_tabla                => v_nombre_tabla,
                                 pi_pk_registro                 => v_pk_registro,
                                 pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_trama_in                    => v_trama_in,
                                 pi_trama_out                   => v_trama_out,
                                 pi_cod_err                     => po_cod_err,
                                 pi_msj_err                     => po_msj_err,
                                 pi_log_file                    => v_reg_entidad.log_file,
                                 pi_log_tabla                   => v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    := NULL;
            -- Registro de log
            tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                                 pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 pi_nombre_tabla                => v_nombre_tabla,
                                 pi_pk_registro                 => v_pk_registro,
                                 pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_trama_in                    => v_trama_in,
                                 pi_trama_out                   => v_trama_out,
                                 pi_cod_err                     => po_cod_err,
                                 pi_msj_err                     => po_msj_err,
                                 pi_log_file                    => v_reg_entidad.log_file,
                                 pi_log_tabla                   => v_reg_entidad.log_table
                                );
    END venta_servicio_consolidacion;

    PROCEDURE renueva_contrato (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_origen             IN       cl_contrato_entidad_consumo.cod_origen%TYPE,
        pi_vigencia               IN       cl_contrato_entidad_consumo.vigencia%TYPE,
        pi_fch_inicio             IN       cl_contrato_entidad_consumo.fch_inicio%TYPE,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        -- Output parameters
        po_id_contrato            OUT      cl_contrato_entidad_consumo.id_contrato%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes locales
        c_tipo_transaccion   CONSTANT cnf_constante.valor%TYPE
                                   := tx_cnf_constante.get_constante ('TRANSACCION_VENTA_SERVICIO');
        c_tipo_servicio_especial CONSTANT cnf_constante.valor%TYPE
                                 := tx_cnf_constante.get_constante ('TIPO_SERVICIO_ESPECIAL_VENTA');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_CONTRATO_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables locales
        v_max_fch_inicio              cl_contrato_entidad_consumo.fch_inicio%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (pi_cod_entidad                 => v_cod_tran,
                                    po_reg_entidad                 => v_reg_entidad,
                                    po_rowid                       => v_rowid_entidad,
                                    po_cod_err                     => po_cod_err,
                                    po_msj_err                     => po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=
                                     ---------- parametros variables ------------------
                                     'pi_id_entidad_consumo:'
                                  || pi_id_entidad_consumo
                                  || '|'
                                  || 'pi_cod_origen:'
                                  || pi_cod_origen
                                  || '|'
                                  || 'pi_vigencia:'
                                  || pi_vigencia
                                  || '|'
                                  ||
                                     ---------- parametros obligatorios ---------------
                                     'pi_master:'
                                  || pi_master
                                  || '|'
                                  || 'pi_cod_usuario:'
                                  || pi_cod_usuario
                                  || '|'
                                  || 'pi_id_tran:'
                                  || pi_id_tran
                                  || '|'
                                  || 'pi_cod_gestion_tran:'
                                  || pi_cod_gestion_tran
                                  || '|'
                                  || 'pi_fch_tran:'
                                  || pi_fch_tran
                                  || '|'
                                  || 'pi_cod_unidad_negocio:'
                                  || pi_cod_unidad_negocio
                                  || '|'
                                  || 'usuario:'
                                  || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cod_origen IS NULL
           OR pi_vigencia IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_master IS NULL
           OR pi_cod_unidad_negocio IS NULL THEN
            po_cod_err := 'PVT-3206';   --TX_PVT_ENTIDAD_CONSUMO.RENUEVA_CONTRATO: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-3207';   --TX_PVT_ENTIDAD_CONSUMO.RENUEVA_CONTRATO: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-3208';   --TX_PVT_ENTIDAD_CONSUMO.RENUEVA_CONTRATO: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            po_id_tran                     => v_id_tran,
                                            po_cod_gestion_tran            => v_cod_gestion_tran,
                                            po_fch_tran                    => v_fch_tran,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -------------------------------- INICIO LOGICA ----------------------------
        po_cod_err := 'PVT-3209';   --TX_PVT_ENTIDAD_CONSUMO.RENUEVA_CONTRATO: El cliente no se encuentra en estado activo.

        SELECT *
          INTO v_reg_entidad_consumo
          FROM cl_entidad_consumo
         WHERE id_entidad_consumo = pi_id_entidad_consumo AND estado NOT IN ('I', 'TER', 'POST');

        SELECT fch_inicio
          INTO v_max_fch_inicio
          FROM cl_contrato_entidad_consumo
         WHERE id_entidad_consumo = pi_id_entidad_consumo order by fch_fin desc fetch first row only;

        IF pi_fch_inicio < v_max_fch_inicio THEN
            po_cod_err := 'PVT-3210';   --TX_PVT_ENTIDAD_CONSUMO.RENUEVA_CONTRATO: La fecha de inicio del contrato es menor al contrato vigente.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3211';   --TX_PVT_ENTIDAD_CONSUMO.RENUEVA_CONTRATO: Error al renovar el contrato.
        cc_cl_contrato_entidad_consumo.alta (pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                             pi_id_prospecto                => NULL,
                                             pi_cod_origen                  => pi_cod_origen,
                                             pi_vigencia                    => pi_vigencia,
                                             pi_cod_usuario                 => pi_cod_usuario,
                                             pi_id_tran                     => v_id_tran,
                                             pi_cod_gestion_tran            => v_cod_gestion_tran,
                                             pi_fch_tran                    => pi_fch_inicio,
                                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                             po_id_contrato                 => po_id_contrato,
                                             po_cod_err                     => po_cod_err,
                                             po_msj_err                     => po_msj_err
                                            );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --REGISTRO TRANSACCIONAL POSTVENTA
        v_trama_nuevo_pv       :=    'Entidad Consumo:'
                                  || v_reg_entidad_consumo.id_entidad_consumo
                                  || '|'
                                  || 'Origen:'
                                  || pi_cod_origen
                                  || '|'
                                  || 'Vigencia:'
                                  || pi_vigencia
                                  || '|'
                                  || 'Fecha Inicio:'
                                  || pi_fch_inicio;
        v_trama_anterior_pv    :=    'Entidad Consumo:-'
                                  || '|'
                                  || 'Origen:-'
                                  || '|'
                                  || 'Vigencia:-'
                                  || '|'
                                  || 'Fecha Inicio:-';
        po_cod_err := 'PVT-3212';   --TX_PVT_ENTIDAD_CONSUMO.RENUEVA_CONTRATO: Error al invocar al procedimiento de registro del log de transacciones Postvena.
        cc_tx_transaccion_postventa.alta
                         (pi_id_tran                     => v_id_tran,
                          pi_cod_gestion_tran            => v_cod_gestion_tran,
                          pi_cod_tipo                    => c_tipo_transaccion,
                          pi_id_cliente                  => get_id_cl
                                                                (v_reg_entidad_consumo.id_comunidad_facturante),
                          pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                          pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                          pi_cod_motivo_transaccion      => NULL,
                          pi_cod_observacion             => NULL,
                          pi_descripcion_observacion     => NULL,
                          pi_valor_anterior              => v_trama_anterior_pv,
                          pi_valor_nuevo                 => v_trama_nuevo_pv,
                          pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                          pi_fch_tran                    => v_fch_tran,
                          pi_cod_usuario                 => pi_cod_usuario,
                          po_cod_err                     => po_cod_err,
                          po_msj_err                     => po_msj_err
                         );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

--------------------------------- FIN LOGICA ------------------------------
-- Formar el PK del registro
        v_pk_registro          := NULL;
        po_cod_err             := 'OK';
        po_msj_err             := NULL;
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                                   'po_cod_err:' || po_cod_err || '|' || 'po_msj_err:' || po_msj_err;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (pi_id_tran                     => v_id_tran,
                                            pi_cod_gestion_tran            => v_cod_gestion_tran,
                                            pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                            pi_cod_transaccion             => v_cod_tran,
                                            pi_fch_tran                    => v_fch_tran,
                                            pi_cod_usuario                 => pi_cod_usuario,
                                            pi_param_in                    => v_trama_in,
                                            pi_param_out                   => v_trama_out,
                                            pi_master                      => c_verdadero,
                                            po_cod_err                     => po_cod_err,
                                            po_msj_err                     => po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        END IF;

        -- Registrar el log
        tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                             pi_cod_gestion_tran            => pi_cod_gestion_tran,
                             pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                             pi_nombre_tabla                => v_nombre_tabla,
                             pi_pk_registro                 => v_pk_registro,
                             pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                             pi_cod_usuario                 => pi_cod_usuario,
                             pi_trama_in                    => v_trama_in,
                             pi_trama_out                   => v_trama_out,
                             pi_cod_err                     => po_cod_err,
                             pi_msj_err                     => po_msj_err,
                             pi_log_file                    => v_reg_entidad.log_file,
                             pi_log_tabla                   => v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    := NULL;
            -- Registro de log
            tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                                 pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 pi_nombre_tabla                => v_nombre_tabla,
                                 pi_pk_registro                 => v_pk_registro,
                                 pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_trama_in                    => v_trama_in,
                                 pi_trama_out                   => v_trama_out,
                                 pi_cod_err                     => po_cod_err,
                                 pi_msj_err                     => po_msj_err,
                                 pi_log_file                    => v_reg_entidad.log_file,
                                 pi_log_tabla                   => v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    := NULL;
            -- Registro de log
            tx_log.registra_log (pi_id_tran                     => pi_id_tran,
                                 pi_cod_gestion_tran            => pi_cod_gestion_tran,
                                 pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                 pi_nombre_tabla                => v_nombre_tabla,
                                 pi_pk_registro                 => v_pk_registro,
                                 pi_cod_entidad                 => v_reg_entidad.cod_entidad,
                                 pi_cod_usuario                 => pi_cod_usuario,
                                 pi_trama_in                    => v_trama_in,
                                 pi_trama_out                   => v_trama_out,
                                 pi_cod_err                     => po_cod_err,
                                 pi_msj_err                     => po_msj_err,
                                 pi_log_file                    => v_reg_entidad.log_file,
                                 pi_log_tabla                   => v_reg_entidad.log_table
                                );
    END renueva_contrato;

    /***********************************************************************************************
    Purpose : [Procedimiento para adelantar un cambio de plan que esta agendado al proximo ciclo de facturacion]
    Date    : [2014-11-04 10:00:00]
    Author  : [Erick Choque Navia]

    #param pi_id_entidad_consumo, Identificador de la entidad consumo (parametro de entrada)
    #param pi_cod_usuario, Codigo del usuario que ejecuta la transaccion (parametro de entrada)
    #param pi_master, 1 Si la transaccion es maestra, de lo contrario 0 (parametro de entrada)
    #param pi_id_tran, Identificador de la transaccion (parametro de entrada)
    #param pi_cod_gestion_tran, Codigo de gestion de la transaccion (parametro de entrada)
    #param pi_fch_tran, Fecha de la transaccion (parametro de entrada)
    #param pi_cod_unidad_negocio, Codigo de la unidad de negocio de la transaccion (parametro de entrada)

    #param po_cod_err, En caso de existir error devuelve el codigo de error, sino OK (parametro de salida)
    #param po_msj_err, En caso de existir error devuelve el mensaje de error, sino '' (parametro de salida)

    #Changes:
    <hr>
    Date    :
    Author  :
    Note    :
    <hr>
    ***********************************************************************************************/
    PROCEDURE cambio_plan_adelantar
    (
    -- Input parameters
        pi_id_entidad_consumo           IN          cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_usuario                  IN          VARCHAR2,
        pi_master                       IN          VARCHAR2,
        pi_id_tran                      IN          TX_HISTORICO_TRANSACCION.id_tran%TYPE,
        pi_cod_gestion_tran             IN          TX_HISTORICO_TRANSACCION.cod_gestion_tran%TYPE,
        pi_fch_tran                     IN          TX_HISTORICO_TRANSACCION.fch_tran%TYPE,
        pi_cod_unidad_negocio           IN          TX_HISTORICO_TRANSACCION.cod_unidad_negocio%TYPE,
    -- Output parameters
        po_cod_err                      OUT         VARCHAR2,
        po_msj_err                      OUT         VARCHAR2
    )
    IS
        -- Constantes locales
        c_cod_transaccion               CONSTANT cnf_constante.valor%TYPE := tx_cnf_constante.get_constante ('TRANSACCION_CAMBIO_PLAN_ADELANTAR');

        -- Variables obligatorias de seguridad y logs
        v_cod_tran                      VARCHAR2(100) := c_cod_transaccion;
        v_nombre_tabla                  VARCHAR2(50) := NULL;
        v_pk_registro                   VARCHAR2(250);
        v_trama_in                      VARCHAR2(4000);
        v_trama_out                     VARCHAR2(2000);
        v_reg_entidad                   CNF_ENTIDAD%ROWTYPE;
        v_rowid_entidad                 ROWID;
        v_id_tran                       TX_HISTORICO_TRANSACCION.id_tran%TYPE;
        v_cod_gestion_tran              TX_HISTORICO_TRANSACCION.cod_gestion_tran%TYPE;
        v_fch_tran                      TX_HISTORICO_TRANSACCION.fch_tran%TYPE;

        -- Variables locales
        v_dummy                         NUMBER;
        v_id_tran_ordenes               cl_orden_prv.id_tran_inicio%TYPE;
        v_reg_entidad_consumo           cl_entidad_consumo%ROWTYPE;

        -- Excepciones
        ERR_APP                        EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        TX_CNF_ENTIDAD.GET_ENTIDAD
        (
            pi_cod_entidad          =>  v_cod_tran,
            po_reg_entidad          =>  v_reg_entidad,
            po_rowid                =>  v_rowid_entidad,
            po_cod_err              =>  po_cod_err,
            po_msj_err              =>  po_msj_err
        );
        IF po_cod_err != 'OK' THEN
            RAISE ERR_APP;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in  :=
                      ---------- parametros variables ------------------
                      'pi_id_entidad_consumo:'      || pi_id_entidad_consumo    || '|' ||

                      ---------- parametros obligatorios ---------------
                      'pi_cod_usuario:'             || pi_cod_usuario           || '|' ||
                      'pi_master:'                  || pi_master                || '|' ||
                      'pi_id_tran:'                 || pi_id_tran               || '|' ||
                      'pi_cod_gestion_tran:'        || pi_cod_gestion_tran      || '|' ||
                      'pi_fch_tran:'                || pi_fch_tran              || '|' ||
                      'pi_cod_unidad_negocio:'      || pi_cod_unidad_negocio    || '|' ||
                      'usuario:'                    || USER;

        -- Validar parametros de entrada obligatorios
        IF  pi_id_entidad_consumo       IS NULL OR
            pi_cod_usuario              IS NULL OR
            pi_master                   IS NULL OR
            pi_cod_unidad_negocio       IS NULL
        THEN
            po_cod_err := 'PVT-3213';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: Algun parametro de entrada requerido es nulo.
            RAISE ERR_APP;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) = c_falso THEN
                po_cod_err := 'PVT-3214';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: No tiene permiso para realizar la operacion.
                RAISE ERR_APP;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF pi_master = c_falso AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-3215';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: Algun parametro transaccional es nulo.
            RAISE ERR_APP;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            TX_TRANSACCION.GET_TRANSACCION
            (
                pi_cod_unidad_negocio   =>  pi_cod_unidad_negocio,
                po_id_tran              =>  v_id_tran,
                po_cod_gestion_tran     =>  v_cod_gestion_tran,
                po_fch_tran             =>  v_fch_tran,
                po_cod_err              =>  po_cod_err,
                po_msj_err              =>  po_msj_err
            );
            IF po_cod_err != 'OK' THEN
                RAISE ERR_APP;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -------------------------------- INICIO LOGICA ----------------------------

        --EL SUSCRIPTOR NO DEBE ESTAR INACTIVO
        validar_entidad_consumo
        (
            pi_id_entidad_consumo   =>  pi_id_entidad_consumo,
            po_reg_entidad_consumo  =>  v_reg_entidad_consumo,
            po_cod_err              =>  po_cod_err,
            po_msj_err              =>  po_msj_err
        );
        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        SELECT COUNT(1)
        INTO v_dummy
        FROM tr_cambio_plan_historico
        WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
        AND fch_inicio > v_fch_tran
        AND fch_fin = c_fecha_fin
        ;

        IF v_dummy = 0 THEN
            po_cod_err := 'PVT-3216';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: El suscriptor no tiene cambio de plan diferido al proximo ciclo.
            RAISE err_app;
        END IF;

        SELECT COUNT(1)
        INTO v_dummy
        FROM v_plan_segmento
        WHERE cod_plan = v_reg_entidad_consumo.cod_plan
        AND cod_linea_negocio = 'POSPAG' -- POSTPAGO ESPECIAL
        ;

        IF v_dummy = 0 THEN
            po_cod_err := 'PVT-3217';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: El nuevo plan del suscriptor no es un plan empleado.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3218';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: Error al actualizar el registro historico del cambio de plan.
        UPDATE tr_cambio_plan_historico
        SET fch_fin = v_fch_tran - INTERVAL '1' SECOND
        WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
        AND fch_fin > v_fch_tran
        AND fch_fin < c_fecha_fin
        ;

        IF SQL%NOTFOUND THEN
            po_cod_err := 'PVT-3219';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: No se logro actualizar el registro historico del cambio de plan.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3220';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: Error al actualizar el ultimo registro historico del cambio de plan.
        UPDATE tr_cambio_plan_historico
        SET fch_inicio = v_fch_tran
        WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
        AND fch_inicio > v_fch_tran
        AND fch_fin = c_fecha_fin
        ;

        IF SQL%NOTFOUND THEN
            po_cod_err := 'PVT-3221';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: No se logro actualizar el ultimo registro historico del cambio de plan.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3222';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: Error al modificar el ultimo registro en el historico de la entidad de consumo.
        UPDATE cl_entidad_consumo_historico
        SET fch_fin = v_fch_tran - INTERVAL '1' SECOND
        WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
        AND fch_fin > v_fch_tran
        AND fch_fin < c_fecha_fin
        ;

        IF SQL%NOTFOUND THEN
            po_cod_err := 'PVT-3223';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: No se logro actualizar el ultimo registro en el historico de la entidad de consumo.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3224';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: Error al actualizar el historico de la entidad de consumo.
        UPDATE cl_entidad_consumo_historico
        SET fch_inicio = v_fch_tran
        WHERE id_entidad_consumo = v_reg_entidad_consumo.id_entidad_consumo
        AND fch_inicio > v_fch_tran
        AND fch_fin = c_fecha_fin
        ;

        IF SQL%NOTFOUND THEN
            po_cod_err := 'PVT-3225';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: No se logro actualizar el historico de la entidad de consumo.
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3227';   --TX_PVT_ENTIDAD_CONSUMO.CAMBIO_PLAN_ADELANTAR: Error al actualizar la informacion en la tabla de ordenes.
        UPDATE vpg_app.sys_order_list
            SET scheduled_date = v_fch_tran,
                order_status_code = 'PEN'
        WHERE consumer_entity_id = v_reg_entidad_consumo.id_entidad_consumo
         AND order_status_code = 'D'
         AND scheduled_date > v_fch_tran
         AND tran_user <> 'OMEGA';


        --------------------------------- FIN LOGICA ------------------------------
        -- Formar el PK del registro
        v_pk_registro := NULL;

        po_cod_err := 'OK';
        po_msj_err := NULL;

        -- Inicializar variables para logs, trama de salida
        v_trama_out := NULL;
        v_trama_out :=
                      ---------- parametros obligatorios ---------------
                      'po_cod_err:' || po_cod_err  || '|' ||
                      'po_msj_err:' || po_msj_err;

        IF pi_master = c_verdadero THEN
            TX_TRANSACCION.SET_TRANSACCION
            (
                pi_id_tran              =>  v_id_tran,
                pi_cod_gestion_tran     =>  v_cod_gestion_tran,
                pi_cod_unidad_negocio   =>  pi_cod_unidad_negocio,
                pi_cod_transaccion      =>  v_cod_tran,
                pi_fch_tran             =>  v_fch_tran,
                pi_cod_usuario          =>  pi_cod_usuario,
                pi_param_in             =>  v_trama_in,
                pi_param_out            =>  v_trama_out,
                pi_master               =>  c_verdadero,
                po_cod_err              =>  po_cod_err,
                po_msj_err              =>  po_msj_err
            );
            IF po_cod_err != 'OK' THEN
                RAISE ERR_APP;
            END IF;
        END IF;

        -- Registrar el log
        TX_LOG.REGISTRA_LOG
        (
            pi_id_tran              =>  pi_id_tran,
            pi_cod_gestion_tran     =>  pi_cod_gestion_tran,
            pi_cod_unidad_negocio   =>  pi_cod_unidad_negocio,
            pi_nombre_tabla         =>  v_nombre_tabla,
            pi_pk_registro          =>  v_pk_registro,
            pi_cod_entidad          =>  v_reg_entidad.cod_entidad,
            pi_cod_usuario          =>  pi_cod_usuario,
            pi_trama_in             =>  v_trama_in,
            pi_trama_out            =>  v_trama_out,
            pi_cod_err              =>  po_cod_err,
            pi_msj_err              =>  po_msj_err,
            pi_log_file             =>  v_reg_entidad.log_file,
            pi_log_tabla            =>  v_reg_entidad.log_table
        );

    EXCEPTION
        WHEN ERR_APP THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err := GET_ERROR(po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out := NULL;

            -- Registro de log
            TX_LOG.REGISTRA_LOG
            (
                pi_id_tran              =>  pi_id_tran,
                pi_cod_gestion_tran     =>  pi_cod_gestion_tran,
                pi_cod_unidad_negocio   =>  pi_cod_unidad_negocio,
                pi_nombre_tabla         =>  v_nombre_tabla,
                pi_pk_registro          =>  v_pk_registro,
                pi_cod_entidad          =>  v_reg_entidad.cod_entidad,
                pi_cod_usuario          =>  pi_cod_usuario,
                pi_trama_in             =>  v_trama_in,
                pi_trama_out            =>  v_trama_out,
                pi_cod_err              =>  po_cod_err,
                pi_msj_err              =>  po_msj_err,
                pi_log_file             =>  v_reg_entidad.log_file,
                pi_log_tabla            =>  v_reg_entidad.log_table
            );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err := GET_SYS_ERROR(po_cod_err, SQLERRM);

            -- Inicializar variables para logs, trama de salida
            v_trama_out := NULL;

            -- Registro de log
            TX_LOG.REGISTRA_LOG
            (
                pi_id_tran              =>  pi_id_tran,
                pi_cod_gestion_tran     =>  pi_cod_gestion_tran,
                pi_cod_unidad_negocio   =>  pi_cod_unidad_negocio,
                pi_nombre_tabla         =>  v_nombre_tabla,
                pi_pk_registro          =>  v_pk_registro,
                pi_cod_entidad          =>  v_reg_entidad.cod_entidad,
                pi_cod_usuario          =>  pi_cod_usuario,
                pi_trama_in             =>  v_trama_in,
                pi_trama_out            =>  v_trama_out,
                pi_cod_err              =>  po_cod_err,
                pi_msj_err              =>  po_msj_err,
                pi_log_file             =>  v_reg_entidad.log_file,
                pi_log_tabla            =>  v_reg_entidad.log_table
            );

    END cambio_plan_adelantar;

    FUNCTION aplica_impresion_certificacion (pi_id_entidad_consumo IN VARCHAR2)
        RETURN VARCHAR2
    IS
        v_dummy                       NUMBER;
    BEGIN

        SELECT COUNT(1)
          INTO v_dummy
          FROM cl_entidad_consumo ec, v_plan_segmento seg
         WHERE ec.id_entidad_consumo = pi_id_entidad_consumo
           AND seg.cod_plan = ec.cod_plan
           AND seg.cod_segmento IN ('CASNEGPRE','CASPRE','PREPAGO');

        RETURN v_dummy;

    EXCEPTION
        WHEN OTHERS THEN
            RETURN NULL;
    END aplica_impresion_certificacion;

    PROCEDURE asignar_favoritos_mochileros (
        -- Input parameters
        pi_id_entidad_consumo_act IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_servicio_act       IN       cl_servicio_entidad_consumo.cod_servicio%TYPE,
        pi_complemento_act        IN       VARCHAR2,
        pi_id_entidad_consumo_moc IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_servicio_moc       IN       cl_servicio_entidad_consumo.cod_servicio%TYPE,
        pi_complemento_moc        IN       VARCHAR2,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        c_tipo_transaccion   CONSTANT VARCHAR2 (50)
                                         := tx_cnf_constante.get_constante ('TRANS_SERVICIO_ASIGNAR_MOCHILERO');
        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := c_tipo_transaccion;
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'CL_SERVICIO_ENTIDAD_CONSUMO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_id_accion_prv_ext           bm_enlace_oas.id_accion_prv_ext%TYPE;
        v_identificador_entidad       cl_entidad_consumo.identificador_entidad%TYPE;
        -- Excepciones
        err_app                       EXCEPTION;
        v_cod_observacion             cnf_nota_transaccion.cod_observacion%TYPE;
        v_descripcion_observacion     cnf_nota_transaccion.descripcion%TYPE;
        v_cod_servicio                bm_servicio.cod_servicio%TYPE;
        v_descripcion                 bm_servicio.descripcion%TYPE;
        v_favorito_vmcp               cl_entidad_consumo.identificador_entidad%TYPE;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo_act:'
            || pi_id_entidad_consumo_act
            || '|'
            || 'pi_cod_servicio_act:'
            || pi_cod_servicio_act
            || '|'
            || 'pi_complemento_act:'
            || pi_complemento_act
            || '|'
            || 'pi_id_entidad_consumo_moc:'
            || pi_id_entidad_consumo_moc
            || '|'
            || 'pi_cod_servicio_moc:'
            || pi_cod_servicio_moc
            || '|'
            || 'pi_complemento_moc:'
            || pi_complemento_moc
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo_act IS NULL
           OR pi_id_entidad_consumo_moc IS null
           OR pi_cod_servicio_act IS NULL
           OR pi_cod_servicio_moc IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-3229';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_FAVORITOS_MOCHILEROS: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) =
                                                                                            c_falso THEN
                po_cod_err := 'PVT-3230';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_FAVORITOS_MOCHILEROS: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-3231';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_FAVORITOS_MOCHILEROS: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------

        po_cod_err := 'PVT-3232';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_FAVORITOS_MOCHILEROS: Error al invocar procedimiento para asignar favoritos.
        asignar_servicio(pi_id_entidad_consumo      => pi_id_entidad_consumo_act,
                         pi_cod_servicio            => pi_cod_servicio_act,
                         pi_complemento             => pi_complemento_act,
                         pi_cod_usuario             => pi_cod_usuario,
                         pi_master                  => c_falso,
                         pi_id_tran                 => v_id_tran,
                         pi_cod_gestion_tran        => v_cod_gestion_tran,
                         pi_fch_tran                => v_fch_tran,
                         pi_cod_unidad_negocio      => pi_cod_unidad_negocio,
                         po_id_tran                 => po_id_tran,
                         po_cod_gestion_tran        => po_cod_gestion_tran,
                         po_cod_err                 => po_cod_err,
                         po_msj_err                 => po_msj_err
                         );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-3233';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_FAVORITOS_MOCHILEROS: Error al invocar procedimiento para asignar favoritos.
        asignar_servicio(pi_id_entidad_consumo      => pi_id_entidad_consumo_moc,
                         pi_cod_servicio            => pi_cod_servicio_moc,
                         pi_complemento             => pi_complemento_moc,
                         pi_cod_usuario             => pi_cod_usuario,
                         pi_master                  => c_falso,
                         pi_id_tran                 => v_id_tran,
                         pi_cod_gestion_tran        => v_cod_gestion_tran,
                         pi_fch_tran                => v_fch_tran,
                         pi_cod_unidad_negocio      => pi_cod_unidad_negocio,
                         po_id_tran                 => po_id_tran,
                         po_cod_gestion_tran        => po_cod_gestion_tran,
                         po_cod_err                 => po_cod_err,
                         po_msj_err                 => po_msj_err
                         );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        FOR v_reg_entidad_consumo IN (SELECT *
                                        FROM cl_entidad_consumo ec
                                       WHERE ec.id_entidad_consumo IN (pi_id_entidad_consumo_act, pi_id_entidad_consumo_moc)
                                         AND get_segmento(ec.cod_plan) = 'PREPAGO'
                                     )
        LOOP

            po_cod_err := 'PVT-3234';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_FAVORITOS_MOCHILEROS: Error al obtener descripcion del servicio
            SELECT pl.cod_servicio, ser.descripcion
              INTO v_cod_servicio, v_descripcion
              FROM bm_plan_servicio pl,
                   bm_servicio ser
             WHERE pl.cod_servicio IN (pi_cod_servicio_act, pi_cod_servicio_moc)
               AND pl.cod_plan = v_reg_entidad_consumo.cod_plan
               AND pl.cod_servicio = ser.cod_servicio
               AND pl.estado = 'A'
               AND ser.estado = 'A';

            po_cod_err := 'PVT-3235';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_FAVORITOS_MOCHILEROS: Error al obtener numero favorito mochilero VMCP
            SELECT identificador_entidad
              INTO v_favorito_vmcp
              FROM cl_entidad_consumo ec
             WHERE ec.id_entidad_consumo IN (pi_id_entidad_consumo_act, pi_id_entidad_consumo_moc)
               AND (get_segmento(ec.cod_plan) IN ('CASPRE') OR ec.cod_plan IN ('VMCCON600','VMCPOS600'));

            po_cod_err := 'PVT-3236';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_FAVORITOS_MOCHILEROS: Error al obtener ID_CLIENTE de la cuenta
            v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

            v_trama_nuevo_pv             :=    'Codigo:'
                                            || v_cod_servicio
                                            || '|'
                                            || 'Descripcion:'
                                            || v_descripcion
                                            || '|'
                                            || 'Favoritos:'
                                            || v_favorito_vmcp;

            po_cod_err := 'PVT-3237';   --TX_PVT_ENTIDAD_CONSUMO.ASIGNAR_FAVORITOS_MOCHILEROS: Error al invocar procedimiento para registrar la transaccion.
            cc_tx_transaccion_postventa.alta
                                  (pi_id_tran                     => v_id_tran,
                                   pi_cod_gestion_tran            => v_cod_gestion_tran,
                                   pi_cod_tipo                    => c_tipo_transaccion,
                                   pi_id_cliente                  => v_id_cliente,
                                   pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                   pi_id_entidad_consumo          => v_reg_entidad_consumo.id_entidad_consumo,
                                   pi_cod_motivo_transaccion      => NULL,
                                   pi_cod_observacion             => v_cod_observacion,
                                   pi_descripcion_observacion     => v_descripcion_observacion,
                                   pi_valor_anterior              => v_trama_anterior_pv,
                                   pi_valor_nuevo                 => v_trama_nuevo_pv,
                                   pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                   pi_fch_tran                    => v_fch_tran,
                                   pi_cod_usuario                 => pi_cod_usuario,
                                   po_cod_err                     => po_cod_err,
                                   po_msj_err                     => po_msj_err
                                  );

            IF (po_cod_err <> 'OK') THEN
                RAISE err_app;
            END IF;
        END LOOP;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';
        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE get_faf_id (
        pi_id_entidad_consumo     IN       cl_entidad_consumo_afin.id_entidad_consumo%TYPE,
        pi_tipo_afinidad          IN       cl_entidad_consumo_afin.cod_tipo_afinidad%TYPE,
        pi_numero                 IN       cl_entidad_consumo_afin.identificador_entidad_afin%TYPE,
        po_favorito               OUT      tx_pvt_entidad_consumo.Favorito,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        v_dummy                     NUMBER(15,0);
        v_numero_favorito           cl_entidad_consumo_afin.identificador_entidad_afin%TYPE;
        v_identificador_entidad     cl_entidad_consumo.identificador_entidad%TYPE;
        v_cod_plan                  cl_entidad_consumo.cod_plan%TYPE;
        v_tipo_red_main             VARCHAR2(6);
        v_tipo_llamada              VARCHAR2(6);
        v_tipo_red                  VARCHAR2(6);
        v_operador                  VARCHAR2(6);
        v_operador_prt              VARCHAR2(6);
        v_faf_id                    NUMBER(15,0);
        ERR_APP                     EXCEPTION;
    BEGIN

        v_numero_favorito := pi_numero;

        po_cod_err := 'PVT-5097';   --TX_PVT_ENTIDAD_CONSUMO.GET_FAF_ID: No se pudo obtener el identificador de la entidad.
        SELECT identificador_entidad, cod_plan
          INTO v_identificador_entidad, v_cod_plan
          FROM cl_entidad_consumo
         WHERE id_entidad_consumo = pi_id_entidad_consumo;

        po_cod_err := 'PVT-5098';   --TX_PVT_ENTIDAD_CONSUMO.GET_FAF_ID: No se pudo obtener el tipo de red de la entidad.
        SELECT CASE
                WHEN b.cod_tipo_operador='O' AND b.cod_operador='1' THEN 'M'
                WHEN b.cod_tipo_operador='O' AND b.cod_operador='12' THEN 'F'
                ELSE b.cod_tipo_operador
               END tipo_red
          INTO v_tipo_red_main
          FROM tr_rangos a, tr_operador b
         WHERE v_identificador_entidad >= a.rango_inicial
           AND v_identificador_entidad <= a.rango_final
           AND a.cod_operador=b.cod_operador(+);

        IF pi_numero LIKE '809%' OR pi_numero LIKE '829%' OR pi_numero LIKE '849%' THEN

            v_numero_favorito := '1'||v_numero_favorito;

            po_cod_err := 'PVT-5099';   --TX_PVT_ENTIDAD_CONSUMO.GET_FAF_ID: No se pudo identificar el NXX del numero ingresado.
            BEGIN
               SELECT CASE
                        WHEN x.tipo_red='F' AND x.id_departamento='438' THEN 'LOC'
                        WHEN x.tipo_red='F' AND x.id_departamento<>'438' THEN 'LDN'
                        ELSE 'MOB'
                       END tipo_llamada,
                       x.tipo_red,
                       x.cod_operador as operador
                  INTO v_tipo_llamada
                     , v_tipo_red
                     , v_operador
                FROM (
                        SELECT CASE
                                WHEN b.cod_tipo_operador='O' AND b.cod_operador='1' THEN 'M'
                                WHEN b.cod_tipo_operador='O' AND b.cod_operador='12' THEN 'F'
                                ELSE b.cod_tipo_operador
                               END tipo_red
                              , b.cod_tipo_operador
                              , case
                                   WHEN b.cod_operador in ('12','1') THEN 'ONNET'
                                    ELSE 'OFFNET'
                                END cod_operador
                              , c.id_departamento
                          FROM tr_rangos a, tr_operador b, tr_departamento c
                         WHERE pi_numero >= a.rango_inicial
                           AND pi_numero <= a.rango_final
                           AND a.cod_operador=b.cod_operador(+)
                           AND a.id_departamento=c.id_departamento(+)
                ) x;
            EXCEPTION
                WHEN OTHERS THEN
                    RAISE ERR_APP;
            END;

            BEGIN
                SELECT CASE
                        WHEN b.descripcion_breve like '%VIVA%' THEN 'ONNET'
                        ELSE 'OFFNET'
                       END operador_prt
                  INTO v_operador_prt
                  FROM prt_numeracion_portada a, prt_cnf_prestador b
                 WHERE a.numero=pi_numero
                   AND a.cod_estado_numeracion='01'
                   AND a.cod_receptor=b.cod_prestador;

                IF v_operador <> v_operador_prt THEN
                    v_operador := v_operador_prt;
                END IF;
            EXCEPTION
                WHEN OTHERS then
                    NULL;
            END;

            IF v_tipo_red_main = 'M' THEN
                IF v_tipo_red in ('M','F') AND v_operador = 'ONNET' THEN
                    v_faf_id := 3;
                ELSIF v_tipo_red = 'M' AND v_operador = 'OFFNET' THEN
                    v_faf_id := 4;
                ELSIF v_tipo_red = 'F' AND v_operador = 'OFFNET' AND v_tipo_llamada = 'LOC' THEN
                    v_faf_id := 2;
                ELSIF v_tipo_red = 'F' AND v_operador = 'OFFNET' AND v_tipo_llamada = 'LDN' THEN
                    v_faf_id := 1;
                END IF;
                IF pi_tipo_afinidad = 'TANNW1' THEN
                    v_faf_id := 22;
                END IF;
                IF pi_tipo_afinidad = 'TAFIL1' THEN
                    v_faf_id := 61;
                END IF;

            ELSE
                IF v_tipo_red = 'M' AND v_operador = 'ONNET' THEN
                    v_faf_id := 42;
                ELSIF v_tipo_red = 'M' AND v_operador = 'OFFNET' THEN
                    v_faf_id := 43;
                ELSIF v_tipo_red = 'F' AND v_operador = 'ONNET' THEN
                    v_faf_id := 21;
                END IF;
                IF pi_tipo_afinidad = 'TANMOC' AND v_tipo_red = 'M' AND v_operador = 'ONNET' THEN
                    v_faf_id := 22;
                END IF;
            END IF;

        ELSE
            IF v_tipo_red_main = 'M' THEN
                v_faf_id := 5;
                IF pi_tipo_afinidad = 'TANNW1' THEN
                    v_faf_id := 22;
                END IF;
            END IF;

        END IF;

        SELECT count(1)
          INTO v_dummy
          FROM cnf_configuracion_especial
         WHERE nombre_tabla = 'BM_SERVICIO'
           AND tipo = 'TIPO_AFINIDAD_FAF'
           AND parametro_1 = pi_tipo_afinidad
           AND parametro_2 = v_faf_id;

        IF v_dummy = 0 THEN
            po_cod_err := 'PVT-5100';   --TX_PVT_ENTIDAD_CONSUMO.GET_FAF_ID: No se pudo obtener el FAF_ID para el numero favorito.
            RAISE ERR_APP;
        END IF;

        po_favorito.num := pi_numero;
        po_favorito.numero_favorito := v_numero_favorito;
        po_favorito.faf_id := v_faf_id;

        po_cod_err    := 'OK';
        po_msj_err    := NULL;
    EXCEPTION
        WHEN ERR_APP THEN
            po_msj_err    := get_sys_error (po_cod_err, SQLERRM);
        WHEN OTHERS THEN
            po_msj_err    := get_sys_error (po_cod_err, SQLERRM);
    END;

    PROCEDURE venta_otros (
        -- Input parameters
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_local              IN       vta_venta_prospecto.cod_local%TYPE,
        pi_cantidad               IN       vta_venta_otros.cantidad%TYPE,
        pi_cod_tipo_venta         IN       vta_venta_otros.cod_tipo_venta%TYPE,
        pi_cod_tipo_pago          IN       vta_venta_otros.cod_tipo_pago%TYPE,
        pi_es_pago_diferido       IN       vta_venta_otros.es_pago_diferido%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_prospecto           OUT      vta_venta_prospecto.id_prospecto%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes
        --c_tipo_transaccion   CONSTANT VARCHAR2 (50) := tx_cnf_constante.get_constante ('TRANSACCION_VENTA_MINUTOS');
        c_tipo_doc_venta_rec CONSTANT VARCHAR2 (50) := tx_cnf_constante.get_constante ('DOC_VENTA_MINUTOS_RECURRENTE');

        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := 'TX_TRAN_OTRAS_VENTAS';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := 'VTA_VENTA_PROSPECTO';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;
        -- Variables propias del procedimiento
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_id_cliente                  cl_cliente.id_cliente%TYPE;
        v_id_prospecto                vta_articulo_prospecto.id_prospecto%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_cod_tipo_documento          cnf_cta_tipo_documento.cod_tipo_documento%TYPE;
        v_id_cargo                    tr_cargo.id_cargo%TYPE;
        v_cod_linea_negocio           bm_linea_negocio.cod_linea_negocio%TYPE;
        v_impuestos                   NUMBER;
        v_monto                       NUMBER;
        v_es_estafeta                 VARCHAR2(1);
        po_id_venta                   vta_venta_prospecto.id_venta%TYPE;
        v_precio                      bl_cargo_precio.precio%TYPE;
        v_dummy                       PLS_INTEGER;
        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_local:'
            || pi_cod_local
            || '|'
            || 'pi_cantidad:'
            || pi_cantidad
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_entidad_consumo IS NULL
           OR pi_cantidad IS NULL
           OR pi_cod_tipo_venta IS NULL
           OR pi_cod_tipo_pago IS NULL
           OR pi_es_pago_diferido IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-6112';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) = c_falso THEN
                po_cod_err := 'PVT-6113'; --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-6114';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;

        ------------------------------ Logica del procedimiento -------------------------
        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (pi_id_entidad_consumo, v_reg_entidad_consumo, po_cod_err,
                                 po_msj_err);

        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-6115';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS: Error al recuperar la linea de negocio
        SELECT cod_linea_negocio
        INTO v_cod_linea_negocio
        FROM cl_comunidad c
        WHERE c.id_comunidad = v_reg_entidad_consumo.id_comunidad_facturante;

        IF v_cod_linea_negocio in ('POSCOR','FIJCOR','POSPAG') THEN
          po_cod_err := 'PVT-6116';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS:  La linea de negocio no puede tener esta venta
          RAISE err_app;
        END IF;

        SELECT COUNT(1) INTO v_dummy
        FROM cnf_cta_tipo_documento
        WHERE cod_tipo_documento=pi_cod_tipo_venta
        AND estado='A';
        IF v_dummy=0 THEN
          po_cod_err := 'PVT-6117';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS:  Tipo de venta inactivo o inexistente
          RAISE err_app;
        END IF;

        po_cod_err := 'PVT-6118';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS: Error al obtener parametros del documento
        SELECT b.id_cargo, b.precio, (b.precio*pi_cantidad) as monto
        INTO v_id_cargo, v_precio, v_monto
        FROM cnf_cta_tipo_documento a, bl_cargo_precio b
        WHERE a.cod_tipo_documento=pi_cod_tipo_venta
        AND a.estado='A'
        and a.id_cargo=b.id_cargo
        and b.estado='A';

        BEGIN
            SELECT to_number(PARAMETRO_4), (to_number(PARAMETRO_4) * pi_cantidad) as monto
            INTO v_precio, v_monto
            FROM omega.cnf_configuracion_especial
            where nombre_tabla = 'BL_CARGO_PRECIO'
              AND tipo = 'CAMBIO_PRECIO_POR_PROMOCION'
              AND PARAMETRO_1 = pi_cod_tipo_venta
              AND pi_cantidad
                BETWEEN to_number(PARAMETRO_2) and TO_NUMBER(PARAMETRO_3);
        EXCEPTION
            WHEN OTHERS THEN
                NULL;
        END;

        --CREAR EL CARGO POR LA VENTA
        po_cod_err := 'PVT-6119';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS: Error al obtener el id del cliente.
        v_id_cliente           := get_id_cl (v_reg_entidad_consumo.id_comunidad_facturante);

        po_cod_err := 'PVT-6120';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS: Error al invocar al proc. de creacion de cargo por venta.
        tx_pvt_ccs.asignar_cargo
                               (
                                  pi_id_cliente                  => v_id_cliente,
                                  pi_id_comunidad                => v_reg_entidad_consumo.id_comunidad_facturante,
                                  pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                  pi_cod_local                   => pi_cod_local,
                                  pi_cod_tipo_documento          => pi_cod_tipo_venta,
                                  pi_id_cargo                    => v_id_cargo,
                                  pi_monto                       => v_monto,
                                  pi_monto_antes_imp             => c_falso,
                                  pi_cod_tipo_venta              => 'TV_OTRAS_VENTAS',
                                  pi_es_diferido                 => pi_es_pago_diferido,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  pi_master                      => c_falso,
                                  pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  po_id_documento                => po_id_venta,
                                  po_id_tran                     => v_id_tran,
                                  po_cod_gestion_tran            => v_cod_gestion_tran,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );
        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-6121';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS: Error al recuperar el identificador de prospecto de la venta
        SELECT id_prospecto
          INTO v_id_prospecto
          FROM vta_venta_prospecto
         WHERE id_venta = po_id_venta;

        po_id_prospecto:=v_id_prospecto;

        --- ALTA VENTA
        po_cod_err := 'PVT-6122';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS: Error al invocar al proc. de creacion de prospecto de venta
        tx_vta_venta_otros.alta (   pi_id_prospecto                => v_id_prospecto,
                                    pi_id_venta                    => po_id_venta,
                                    pi_id_entidad_consumo          => pi_id_entidad_consumo,
                                    pi_cod_tipo_venta              => pi_cod_tipo_venta,
                                    pi_cod_tipo_pago               => pi_cod_tipo_pago,
                                    pi_cantidad                    => pi_cantidad,
                                    pi_precio_venta                => v_monto,
                                    pi_es_pago_diferido            => pi_es_pago_diferido,
                                    pi_cod_usuario                 => pi_cod_usuario,
                                    pi_master                      => c_falso,
                                    pi_id_tran                     => v_id_tran,
                                    pi_cod_gestion_tran            => v_cod_gestion_tran,
                                    pi_fch_tran                    => v_fch_tran,
                                    pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                    po_cod_err                     => po_cod_err,
                                    po_msj_err                     => po_msj_err
                                    );
        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';

        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    PROCEDURE venta_otros_consolidacion (
        -- Input parameters
        pi_id_prospecto           IN       vta_articulo_prospecto.id_prospecto%TYPE,
        pi_cod_usuario            IN       VARCHAR2,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        po_id_tran                OUT      tx_historico_transaccion.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_historico_transaccion.cod_gestion_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2
    )
    IS
        -- Constantes

        -- Variables obligatorias de seguridad y logs
        v_cod_tran                    VARCHAR2 (100) := 'TX_TRAN_OTRAS_VENTAS';
        v_reg_entidad                 cnf_entidad%ROWTYPE;
        v_rowid_entidad               ROWID;
        v_nombre_tabla                VARCHAR2 (50) := '';
        v_pk_registro                 VARCHAR2 (250);
        v_trama_in                    VARCHAR2 (4000);
        v_trama_out                   VARCHAR2 (2000);
        v_id_tran                     tx_historico_transaccion.id_tran%TYPE;
        v_cod_gestion_tran            tx_historico_transaccion.cod_gestion_tran%TYPE;
        v_fch_tran                    tx_historico_transaccion.fch_tran%TYPE;

        -- Variables propias del procedimiento
        v_cod_grupo_plan              bm_plan.cod_grupo_plan%TYPE;
        v_reg_entidad_consumo         cl_entidad_consumo%ROWTYPE;
        v_reg_cargo_prospecto         vta_cargo_prospecto%ROWTYPE;
        v_cod_local                   vta_venta_prospecto.cod_local%TYPE;
        v_monto                       bm_plan.tarifa_basica%TYPE;
        v_trama_anterior_pv           VARCHAR2 (4000);
        v_trama_nuevo_pv              VARCHAR2 (4000);
        v_reg_vta_venta_otros         vta_venta_otros%ROWTYPE;
        v_cod_grupo_grupo_plan        bm_grupo_plan.cod_grupo_plan%TYPE;
        v_id_sms                      NUMBER (15, 2);

        -- Excepciones
        err_app                       EXCEPTION;
    BEGIN
        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err
                                   );

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Inicializar variables para logs, trama inicial
        v_trama_in             :=   ---------- parametros variables ------------------
               'pi_id_prospecto:'
            || pi_id_prospecto
            || '|'
            ---------- parametros obligatorios ---------------
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_master:'
            || pi_master
            || '|'
            || 'pi_id_tran:'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran:'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran:'
            || pi_fch_tran
            || '|'
            || 'pi_cod_unidad_negocio:'
            || pi_cod_unidad_negocio
            || '|'
            || 'usuario:'
            || USER;

        -- Validar parametros de entrada obligatorios
        IF    pi_id_prospecto IS NULL
           OR pi_cod_usuario IS NULL
           OR pi_cod_unidad_negocio IS NULL
           OR pi_master IS NULL THEN
            po_cod_err := 'PVT-6123';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: Algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso (v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) = c_falso THEN
                po_cod_err := 'PVT-6124';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: No tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;
        END IF;

        -- Validar parametros transaccionales para transacciones no maestras
        IF     pi_master = c_falso
           AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL) THEN
            po_cod_err := 'PVT-6125';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: Algun parametro transaccional es nulo.
            RAISE err_app;
        END IF;

        -- Obtener atributos transaccionales
        IF pi_master = c_verdadero THEN
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            v_id_tran,
                                            v_cod_gestion_tran,
                                            v_fch_tran,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;
        ELSE
            v_id_tran             := pi_id_tran;
            v_cod_gestion_tran    := pi_cod_gestion_tran;
            v_fch_tran            := pi_fch_tran;
        END IF;

        -- Asignar valores transaccionales a los parametros de salida
        po_id_tran             := v_id_tran;
        po_cod_gestion_tran    := v_cod_gestion_tran;
        ------------------------------ Logica del procedimiento -------------------------
        --OBTENCION DEL PROSPECTO DE VENTA DE OTROS
        po_cod_err := 'PVT-6131';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: Error al recuperar el prospecto de la venta de otros.
        SELECT *
          INTO v_reg_cargo_prospecto
          FROM vta_cargo_prospecto p
         WHERE p.id_prospecto = pi_id_prospecto AND p.estado = c_estado_activo;

        --OBTENCION DEL PROSPECTO DE VENTA
        po_cod_err := 'PVT-6126';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: Error al recuperar el prospecto de la venta de otros
        SELECT *
          INTO v_reg_vta_venta_otros
          FROM vta_venta_otros p
         WHERE p.id_prospecto = pi_id_prospecto;

        --LA ENTIDAD DE CONSUMO NO DEBE ESTAR TERMINADA
        validar_entidad_consumo (v_reg_cargo_prospecto.id_entidad_consumo, v_reg_entidad_consumo,
                                 po_cod_err, po_msj_err);
        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        SELECT cod_grupo_plan
        INTO v_cod_grupo_plan
        FROM bm_plan
        WHERE cod_plan = v_reg_entidad_consumo.cod_plan;

        IF v_reg_vta_venta_otros.cod_tipo_venta = 'FAOVRM' THEN --RIFA MOTOR

            po_cod_err := 'PVT-6127';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: Error en la ejecucion tx_sms.alta
            tx_sms.alta (pi_origen               => 'VIVA',
                     pi_destino              => v_reg_entidad_consumo.identificador_entidad,
                     pi_texto                => 'Tu compra de '||v_reg_vta_venta_otros.cantidad||' boleto(s) electrónicos fué exitosa, en unos minutos recibiras los números generados. Transaccion No. '||v_id_tran,
                     pi_prioridad            => '1',
                     pi_id_tran              => v_id_tran,
                     pi_fch_tran             => v_fch_tran,
                     pi_cod_gestion_tran     => v_cod_gestion_tran,
                     pi_cod_usuario          => pi_cod_usuario,
                     pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                     pi_master               => c_falso,
                     po_id_sms               => v_id_sms,
                     po_cod_err              => po_cod_err,
                     po_msj_err              => po_msj_err
                     );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

        ELSIF v_reg_vta_venta_otros.cod_tipo_venta = 'FAOVRB' THEN -- RIFA BONOS 4547751-PROMO-RIFA-BONOS

            po_cod_err := 'PVT-6176';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: Error en la ejecucion tx_sms.alta
            tx_sms.alta (pi_origen               => 'VIVA',
                     pi_destino              => v_reg_entidad_consumo.identificador_entidad,
                     pi_texto                => 'Tu compra de '||v_reg_vta_venta_otros.cantidad||' boleto(s) electronicos fue exitosa, en unos minutos recibiras los numeros generados. Transaccion No. '||v_id_tran,
                     pi_prioridad            => '1',
                     pi_id_tran              => v_id_tran,
                     pi_fch_tran             => v_fch_tran,
                     pi_cod_gestion_tran     => v_cod_gestion_tran,
                     pi_cod_usuario          => pi_cod_usuario,
                     pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                     pi_master               => c_falso,
                     po_id_sms               => v_id_sms,
                     po_cod_err              => po_cod_err,
                     po_msj_err              => po_msj_err
                     );
            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

        ELSIF v_reg_vta_venta_otros.cod_tipo_venta = 'XXXXXX' THEN
            -- Otra venta con un comportamiento diferente
            NULL;
        END IF;

        --ESTABLECEMOS EL PROSPECTO COMO PAGADO
        po_cod_err := 'PVT-6128';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: Error al invocar al procedimiento de finalizacion del prospectro.
        cc_vta_cargo_prospecto.cambia_estado (pi_id_prospecto                => pi_id_prospecto,
                                              pi_estado                      => c_estado_pagado,
                                              pi_cod_usuario                 => pi_cod_usuario,
                                              pi_id_tran                     => v_id_tran,
                                              pi_cod_gestion_tran            => v_cod_gestion_tran,
                                              pi_fch_tran                    => v_fch_tran,
                                              pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                              po_cod_err                     => po_cod_err,
                                              po_msj_err                     => po_msj_err
                                             );
        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        --REGISTRO TRANSACCIONAL POSTVENTA
        po_cod_err := 'PVT-6129';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: Error al determinar el local de la venta.
        SELECT cod_local
          INTO v_cod_local
          FROM vta_venta_prospecto v
         WHERE v.id_venta = v_reg_cargo_prospecto.id_venta;

        v_trama_nuevo_pv       :=    'Local:'
                                  || v_cod_local
                                  || '|'
                                  || 'Monto:'
                                  || v_reg_cargo_prospecto.monto
                                  || '|'
                                  || 'Cantidad:'
                                  || v_reg_vta_venta_otros.cantidad
                                  ;
        v_trama_anterior_pv    := '';

        po_cod_err := 'PVT-6130';   --TX_PVT_ENTIDAD_CONSUMO.VENTA_OTROS_CONSOLIDACION: Error al invocar al proc. de registro del log de transacciones PostVena.
        cc_tx_transaccion_postventa.alta
                                 (pi_id_tran                     => v_id_tran,
                                  pi_cod_gestion_tran            => v_cod_gestion_tran,
                                  pi_cod_tipo                    => v_cod_tran,
                                  pi_id_cliente                  => v_reg_cargo_prospecto.id_cliente,
                                  pi_id_comunidad                => v_reg_cargo_prospecto.id_comunidad_facturante,
                                  pi_id_entidad_consumo          => v_reg_cargo_prospecto.id_entidad_consumo,
                                  pi_cod_motivo_transaccion      => NULL,
                                  pi_cod_observacion             => NULL,
                                  pi_descripcion_observacion     => NULL,
                                  pi_valor_anterior              => v_trama_anterior_pv,
                                  pi_valor_nuevo                 => v_trama_nuevo_pv,
                                  pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                  pi_fch_tran                    => v_fch_tran,
                                  pi_cod_usuario                 => pi_cod_usuario,
                                  po_cod_err                     => po_cod_err,
                                  po_msj_err                     => po_msj_err
                                 );
        IF (po_cod_err <> 'OK') THEN
            RAISE err_app;
        END IF;

        ------------------------------ Fin Logica del procedimiento ---------------------
        po_cod_err             := 'OK';
        po_msj_err             := '';

        -- Inicializar variables para logs, trama de salida
        v_trama_out            :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (v_id_tran,
                                            v_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            v_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_falso,
                                            po_cod_err,
                                            po_msj_err
                                           );

            IF po_cod_err != 'OK' THEN
                RAISE err_app;
            END IF;

            COMMIT;
        END IF;

        -- Registrar el log
        tx_log.registra_log (v_id_tran,
                             v_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             v_pk_registro,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table
                            );
    EXCEPTION
        WHEN err_app THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            IF po_msj_err IS NULL THEN
                po_msj_err    := get_error (po_cod_err);
            END IF;

            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
        WHEN OTHERS THEN
            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            po_msj_err     := get_sys_error (po_cod_err, SQLERRM);
            -- Inicializar variables para logs, trama de salida
            v_trama_out    :=   ---------- parametros obligatorios ---------------
                 'po_id_tran:' || po_id_tran || '|' || 'po_cod_gestion_tran:' || po_cod_gestion_tran;
            -- Registrar el log
            tx_log.registra_log (v_id_tran,
                                 v_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 v_pk_registro,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table
                                );
    END;

    /*
      Date : 2024-02-28
      Author : Edwin Maldonado
      Note : Realizar la venta de boletos desde WC, APP, USSD con cobro en TC o MA
    */
    PROCEDURE venta_boletos (
        pi_id_entidad_consumo     IN       cl_entidad_consumo.id_entidad_consumo%TYPE,
        pi_cod_procedencia        IN       cnf_catalogo.cod_catalogo%TYPE, --VTPUSD, VTPPVT, VTPWCH, VTPAPP
        pi_cantidad               IN       NUMBER,
        pi_cod_tipo_pago          IN       VARCHAR2, --(TPCAJA, TPTC, TPMA)
        pi_cod_tipo_venta         IN       VARCHAR2, --(ejmplo:  FAOVRM o FAOVRB)
        pi_id_cuenta              IN       cl_cuenta.id_cuenta%TYPE,--En caso de pago con TC

        pi_cod_usuario            IN       VARCHAR2,
        pi_cod_unidad_negocio     IN       tx_historico_transaccion.cod_unidad_negocio%TYPE,
        pi_master                 IN       VARCHAR2,
        pi_id_tran                IN       tx_historico_transaccion.id_tran%TYPE,
        pi_cod_gestion_tran       IN       tx_historico_transaccion.cod_gestion_tran%TYPE,
        pi_fch_tran               IN       tx_historico_transaccion.fch_tran%TYPE,

        po_id_prospecto           OUT      vta_venta_otros.id_prospecto%TYPE,
        po_id_tran                OUT      tx_transaccion_hist.id_tran%TYPE,
        po_cod_gestion_tran       OUT      tx_transaccion_hist.cod_gestion_tran%TYPE,
        po_fch_tran               OUT      tx_transaccion_hist.fch_tran%TYPE,
        po_cod_err                OUT      VARCHAR2,
        po_msj_err                OUT      VARCHAR2)

    IS
        --
        c_prioridad_sms         CONSTANT   VARCHAR2(2)  := tx_cnf_constante.get_constante ('PRIORIDAD_SMS_IVR');
        c_origen_sms            CONSTANT   VARCHAR2(10) := tx_cnf_constante.get_constante ('ORIGEN_SMS_IVR');
        c_id_cargo              CONSTANT   tr_cargo.id_cargo%TYPE := 5656;
        c_tipo_transaccion_pgw  CONSTANT   VARCHAR2(10) := 'VTABOL';

        err_app                     EXCEPTION;
        v_trama_in                  VARCHAR2 (4000);
        v_trama_out                 VARCHAR2 (4000);
        --
        v_cod_tran                  VARCHAR2 (100) := v_cod_ent || '.VENTA_BOLETOS';
        v_nombre_tabla              VARCHAR2 (50)  := '';
        v_reg_entidad               cnf_entidad%ROWTYPE;
        v_rowid_entidad             ROWID;


        v_monto_bruto               pgw_transaccion.monto%TYPE;
        v_monto_impuestos           pgw_transaccion.tax%TYPE;
        v_monto_neto                pgw_transaccion.monto_neto%TYPE;

        v_cod_procedencia_pgw       pgw_transaccion.cod_origen%TYPE;
        v_id_venta                  vta_venta_prospecto.id_venta%TYPE;
        v_id_transaccion_tc         pgw_transaccion.id_transaccion%TYPE;
        v_num_authorization         pgw_transaccion.noauthorization%TYPE;
        v_identificador_entidad     pgw_transaccion.nro_telefono%TYPE;
        v_respuesta_cobro_tc        pgw_transaccion.responsecode%TYPE;
        v_sms_mensaje               sms_dispatcher.text%TYPE;
        v_id_sms                    NUMBER;

    BEGIN
               v_trama_in :=
               'Usuario:'
            || USER
            || '|'
            || 'pi_id_entidad_consumo:'
            || pi_id_entidad_consumo
            || '|'
            || 'pi_cod_procedencia:'
            || pi_cod_procedencia
            || '|'
            || 'pi_cantidad:'
            || pi_cantidad
            || '|'
            || 'pi_cod_tipo_pago:'
            || pi_cod_tipo_pago
            || '|'
            || 'pi_cod_tipo_venta:'
            || pi_cod_tipo_venta
            || '|'
            || 'pi_id_cuenta:'
            || pi_id_cuenta
            || '|'
            || 'pi_cod_usuario:'
            || pi_cod_usuario
            || '|'
            || 'pi_cod_unidad_negocio'
            || pi_cod_unidad_negocio
            || '|'
            || 'pi_master'
            || pi_master
            || '|'
            || 'pi_id_tran'
            || pi_id_tran
            || '|'
            || 'pi_cod_gestion_tran'
            || pi_cod_gestion_tran
            || '|'
            || 'pi_fch_tran'
            || pi_fch_tran;

        -- Obtener registro de la entidad
        tx_cnf_entidad.get_entidad (v_cod_tran,
                                    v_reg_entidad,
                                    v_rowid_entidad,
                                    po_cod_err,
                                    po_msj_err);

        IF po_cod_err != 'OK' THEN
            RAISE err_app;
        END IF;

        -- Validar parametros de entrada obligatorios
        IF  pi_id_entidad_consumo IS NULL OR pi_cod_procedencia IS NULL OR pi_cantidad IS NULL OR pi_cod_tipo_pago IS NULL
            OR pi_master IS NULL OR pi_cod_usuario IS NULL OR pi_cod_unidad_negocio IS NULL
            OR (pi_master = c_falso AND (pi_id_tran IS NULL OR pi_cod_gestion_tran IS NULL OR pi_fch_tran IS NULL))
        THEN
            po_cod_err := 'PVT-6163';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: algun parametro de entrada requerido es nulo.
            RAISE err_app;
        END IF;

        -- Verificar permisos de ejecucion y obtener atributos transaccionales si es una transaccion maestra
        IF pi_master = c_verdadero THEN
            IF tiene_permiso(v_cod_tran, v_reg_entidad.validar_seguridad, pi_cod_usuario) = c_falso THEN
                po_cod_err := 'PVT-6164';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: no tiene permiso para realizar la operacion.
                RAISE err_app;
            END IF;

            -- Obtener atributos transaccionales
            tx_transaccion.get_transaccion (pi_cod_unidad_negocio,
                                            po_id_tran,
                                            po_cod_gestion_tran,
                                            po_fch_tran,
                                            po_cod_err,
                                            po_msj_err);
        ELSE
            po_id_tran          := pi_id_tran;
            po_cod_gestion_tran := pi_cod_gestion_tran;
            po_fch_tran         := pi_fch_tran;
        END IF;

        ------------------------------ Logica del procedimiento -------------------------

        --LA ENTIDAD DE CONSUMO NO DEBE TENER NINGUNA SUSPENSION NI DESCONEXION
        IF tx_pvt_entidad_consumo.suscriptor_tiene_suspension (pi_id_entidad_consumo) = c_verdadero THEN
            po_cod_err    := 'PVT-6165';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: El suscriptor no está Activo.
            RAISE err_app;
        END IF;

        --INVOCACIÓN PARA LA CREACIÓN DEL PROSPECTO DE VENTA DE BOLETOS
        po_cod_err    := 'PVT-6166';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Error al crear el prospecto de venta de boletos.
        tx_pvt_entidad_consumo.venta_otros(pi_id_entidad_consumo    => pi_id_entidad_consumo,
                                           pi_cod_local             => NULL,
                                           pi_cantidad              => pi_cantidad,
                                           pi_cod_tipo_venta        => pi_cod_tipo_venta,
                                           pi_cod_tipo_pago         => pi_cod_tipo_pago,
                                           pi_es_pago_diferido      => c_falso,
                                           pi_cod_usuario           => pi_cod_usuario,
                                           pi_master                => c_falso,
                                           pi_id_tran               => po_id_tran,
                                           pi_cod_gestion_tran      => po_cod_gestion_tran,
                                           pi_fch_tran              => po_fch_tran,
                                           pi_cod_unidad_negocio    => pi_cod_unidad_negocio,
                                           po_id_prospecto          => po_id_prospecto,
                                           po_id_tran               => po_id_tran,
                                           po_cod_gestion_tran      => po_cod_gestion_tran,
                                           po_cod_err               => po_cod_err,
                                           po_msj_err               => po_msj_err);

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;

        po_cod_err := 'PVT-6167';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Error al determinar la venta a consolidar.
        SELECT id_venta, valor, valor_venta, ROUND(valor - valor_venta, 2)
          INTO v_id_venta, v_monto_neto, v_monto_bruto, v_monto_impuestos
          FROM vta_venta_prospecto
         WHERE id_prospecto = po_id_prospecto;

        --CONSOLIDACIÓN DEL PROSPECTO DE VENTA DE BOLETOS
        --(ESTA SECCIÓN LÓGICAMENTE DEBERÍA INVOCARSE POSTERIORMENTE AL COBRO DEL MA O COBRO DE TC PERO COMO ESAS TRANSACCIONES NO SON REVERSIBLES
        --ENTONCES PRIMERO CONSOLIDAMOS LO QUE ES REVERSIBLE CON ROLLBACK Y LUEGO RECIÉN LO QUE NO LO ES PARA MINIMIZAR PROBLEMAS DE INCONSISTENCIA)
        po_cod_err := 'PVT-6168';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Error al invocar la consolidación de la venta.
        tx_int_cliente_caja.consolidar_venta_prospecto (pi_id_venta                    => v_id_venta,
                                                        pi_ncf                         => NULL,
                                                        pi_nro_pag_ext                 => NULL,
                                                        pi_cod_usuario                 => pi_cod_usuario,
                                                        pi_master                      => c_falso,
                                                        pi_id_tran                     => po_id_tran,
                                                        pi_cod_gestion_tran            => po_cod_gestion_tran,
                                                        pi_fch_tran                    => po_fch_tran,
                                                        pi_cod_unidad_negocio          => pi_cod_unidad_negocio,
                                                        po_id_tran                     => po_id_tran,
                                                        po_cod_gestion_tran            => po_cod_gestion_tran,
                                                        po_cod_err                     => po_cod_err,
                                                        po_msj_err                     => po_msj_err
                                                       );

        IF po_cod_err <> 'OK' THEN
            RAISE err_app;
        END IF;
        --CONSOLIDACIÓN DEL PROSPECTO DE VENTA DE BOLETOS

        IF pi_cod_tipo_pago = 'TPMA' THEN
            po_cod_err := 'PVT-6169';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Error al realizar el cobro del core balance del suscriptor.
            tx_air.mainBalanceAdjustment(pi_id_entidad_consumo     => pi_id_entidad_consumo,
                                         pi_comentario             => pi_cod_tipo_venta,
                                         pi_comentario2            => po_id_prospecto,
                                         pi_id_transaccion         => po_id_tran,
                                         pi_fecha_transaccion      => po_fch_tran,
                                         pi_monto                  => v_monto_neto,
                                         pi_proposito              => tx_ecms.c_balance_purpose_debit,
                                         po_cod_err                => po_cod_err,
                                         po_msj_err                => po_msj_err
                                        );

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;
        ELSIF pi_cod_tipo_pago = 'TPTC' THEN
            SELECT CASE WHEN pi_cod_procedencia = 'VTPWCH' THEN 'PGWWC'
                        WHEN pi_cod_procedencia = 'VTPAPP' THEN 'PGWAPP'
                   ELSE 'NA' END
              INTO v_cod_procedencia_pgw
              FROM dual;

            IF v_cod_procedencia_pgw = 'NA' THEN
                po_cod_err := 'PVT-6170';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Procedencia no aplica para cargo a tarjeta de crédito.
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-6171';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Error al procesar el cargo a la tarjeta.
            tx_pgw_transaccion.procesar_cargo_tarjeta
                            (pi_id_entidad_consumo     => pi_id_entidad_consumo,
                            pi_id_cuenta              => pi_id_cuenta,
                            pi_cod_tipo_transaccion   => c_tipo_transaccion_pgw,
                            pi_id_documento_externo   => po_id_prospecto,
                            pi_cod_procedencia        => v_cod_procedencia_pgw,
                            pi_monto_bruto            => v_monto_bruto,
                            pi_impuestos              => v_monto_impuestos,
                            pi_monto_neto             => v_monto_neto,

                            pi_cod_usuario            => pi_cod_usuario,
                            pi_cod_unidad_negocio     => pi_cod_unidad_negocio,

                            pi_id_tran                => po_id_tran,
                            pi_cod_gestion_tran       => po_cod_gestion_tran,
                            pi_fch_tran               => po_fch_tran,

                            po_id_transaccion_cargo   => v_id_transaccion_tc,
                            po_cod_err                => po_cod_err,
                            po_msj_err                => po_msj_err);

            IF po_cod_err <> 'OK' THEN
                RAISE err_app;
            END IF;

            po_cod_err := 'PVT-6172';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Error al obtener los datos de la transacción con tarjeta.
            SELECT noauthorization, nro_telefono, responsecode
              INTO v_num_authorization, v_identificador_entidad, v_respuesta_cobro_tc
              FROM pgw_transaccion t
             WHERE t.id_transaccion = v_id_transaccion_tc;
            IF v_respuesta_cobro_tc <> '00' THEN
                po_cod_err := 'PVT-6176';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Cobro a tarjeta no satisfactorio.
                RAISE err_app;
            END IF;

            BEGIN

                po_cod_err := 'PVT-6173';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Error al determinar el mensaje a enviar.
                v_sms_mensaje := 'Su transaccion por $' || v_monto_neto || ' ha sido cargada a su tarjeta de credito, su numero de aprobacion es ' || v_num_authorization || '. VIVA, Estamos de tu lado.';

                po_cod_err := 'PVT-6174';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Error al enviar el mensaje.
                tx_sms.alta(pi_origen               => c_origen_sms,
                            pi_destino              => v_identificador_entidad,
                            pi_texto                => v_sms_mensaje,
                            pi_prioridad            => c_prioridad_sms,
                            pi_id_tran              => po_id_tran,
                            pi_fch_tran             => po_fch_tran,
                            pi_cod_gestion_tran     => po_cod_gestion_tran,
                            pi_cod_usuario          => pi_cod_usuario,
                            pi_cod_unidad_negocio   => pi_cod_unidad_negocio,
                            pi_master               => c_falso,
                            po_id_sms               => v_id_sms,
                            po_cod_err              => po_cod_err,
                            po_msj_err              => po_msj_err );

                IF po_cod_err <> 'OK' THEN
                    RAISE err_app;
                END IF;
            EXCEPTION
                WHEN OTHERS THEN
                    NULL;
            END;
        ELSE --PROCEDIMIENTO NO SOPORTA PAGO EN CAJA.
            po_cod_err := 'PVT-6175';  --TX_PVT_ENTIDAD_CONSUMO.VENTA_BOLETOS: Tipo de pago no soportado.
            RAISE err_app;
        END IF;

        ------------------------------ END LOGIC ---------------------

        po_cod_err := 'OK';
        po_msj_err := '';

        v_trama_out :=
             'po_id_prospecto:'
            || po_id_prospecto
            || '|'
            || 'po_id_tran:'
            || po_id_tran
            || '|'
            || 'po_cod_gestion_tran:'
            || po_cod_gestion_tran
            || '|'
            || 'po_fch_tran:'
            || po_fch_tran
            || '|'
            || 'po_cod_err:'
            || po_cod_err
            || '|'
            || 'po_msj_err:'
            || po_msj_err;

        IF pi_master = c_verdadero THEN
            tx_transaccion.set_transaccion (po_id_tran,
                                            po_cod_gestion_tran,
                                            pi_cod_unidad_negocio,
                                            v_cod_tran,
                                            po_fch_tran,
                                            pi_cod_usuario,
                                            v_trama_in,
                                            v_trama_out,
                                            c_verdadero,
                                            po_cod_err,
                                            po_msj_err);

            IF po_cod_err != 'OK'
            THEN
                RAISE err_app;
            END IF;
        END IF;

        tx_log.registra_log (pi_id_tran,
                             pi_cod_gestion_tran,
                             pi_cod_unidad_negocio,
                             v_nombre_tabla,
                             NULL,
                             v_reg_entidad.cod_entidad,
                             pi_cod_usuario,
                             v_trama_in,
                             v_trama_out,
                             po_cod_err,
                             po_msj_err,
                             v_reg_entidad.log_file,
                             v_reg_entidad.log_table);

    EXCEPTION
        WHEN err_app
        THEN
            IF po_msj_err IS NULL
            THEN
                po_msj_err := get_error (po_cod_err);
            END IF;

            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            v_trama_out :=
                 'po_id_prospecto:'
                || po_id_prospecto
                || '|'
                || 'po_id_tran:'
                || po_id_tran
                || '|'
                || 'po_cod_gestion_tran:'
                || po_cod_gestion_tran
                || '|'
                || 'po_fch_tran:'
                || po_fch_tran
                || '|'
                || 'po_cod_err:'
                || po_cod_err
                || '|'
                || 'po_msj_err:'
                || po_msj_err;


            tx_log.registra_log (pi_id_tran,
                                 pi_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 NULL,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table);
        WHEN OTHERS
        THEN
            po_msj_err := get_sys_error (po_cod_err, po_msj_err);

            IF pi_master = c_verdadero THEN
                ROLLBACK;
            END IF;

            v_trama_out :=
                 'po_id_prospecto:'
                || po_id_prospecto
                || '|'
                || 'po_id_tran:'
                || po_id_tran
                || '|'
                || 'po_cod_gestion_tran:'
                || po_cod_gestion_tran
                || '|'
                || 'po_fch_tran:'
                || po_fch_tran
                || '|'
                || 'po_cod_err:'
                || po_cod_err
                || '|'
                || 'po_msj_err:'
                || po_msj_err
                || '|'
                || 'sqlerrm:'
                || SQLERRM;

            tx_log.registra_log (pi_id_tran,
                                 pi_cod_gestion_tran,
                                 pi_cod_unidad_negocio,
                                 v_nombre_tabla,
                                 NULL,
                                 v_reg_entidad.cod_entidad,
                                 pi_cod_usuario,
                                 v_trama_in,
                                 v_trama_out,
                                 po_cod_err,
                                 po_msj_err,
                                 v_reg_entidad.log_file,
                                 v_reg_entidad.log_table);

    END;

END tx_pvt_entidad_consumo;
